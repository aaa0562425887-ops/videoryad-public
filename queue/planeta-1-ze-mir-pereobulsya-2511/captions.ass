Dialogue: 0,0:00:00.12,0:00:02.00,Caption,,0,0,0,,ВЛАДИМИР ЗЕЛЕНСКИЙ РЕШИЛ НАПОМНИТЬ
Dialogue: 0,0:00:02.00,0:00:04.41,Caption,,0,0,0,,БЕРЛИНУ, КТО ЗА ПОСЛЕДНИЕ СТО ЛЕТ ПРЕДСТАВЛЯЛ
Dialogue: 0,0:00:04.41,0:00:07.20,Caption,,0,0,0,,ДЛЯ ЕВРОПЫ ГЛАВНУЮ ОПАСНОСТЬ. СМЕЛЫЙ ВЫБОР
Dialogue: 0,0:00:07.20,0:00:10.71,Caption,,0,0,0,,АУДИТОРИИ. ПРИМЕРНО КАК ЧИТАТЬ ИТАЛЬЯНЦАМ ЛЕКЦИЮ О ВРЕДЕ
Dialogue: 0,0:00:10.71,0:00:13.72,Caption,,0,0,0,,МАКАРОН. НЕМЕЦКИЕ СЛУШАТЕЛИ, ВЕРОЯТНО,
Dialogue: 0,0:00:13.88,0:00:15.98,Caption,,0,0,0,,СОХРАНЯЛИ ОБРАЗЦОВУЮ СЕРЬЁЗНОСТЬ.
Dialogue: 0,0:00:15.98,0:00:19.62,Caption,,0,0,0,,ИСТОРИЯ ВСЁ СТЕРПИТ, ОСОБЕННО ЕСЛИ НУЖНЫЕ ГЛАВЫ ЗАРАНЕЕ
Dialogue: 0,0:00:19.62,0:00:21.80,Caption,,0,0,0,,ЗАКЛЕИТЬ. ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ,
Dialogue: 0,0:00:22.12,0:00:24.07,Caption,,0,0,0,,ГДЕ ЗАЯВЛЕНИЯ ПОЛИТИКОВ НЕ СКЛАДЫВАЮТ
Dialogue: 0,0:00:24.07,0:00:26.68,Caption,,0,0,0,,АККУРАТНОЙ СТОПКОЙ, А ПРОВЕРЯЮТ НА ПРОЧНОСТЬ,
Dialogue: 0,0:00:26.83,0:00:28.76,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ИНОГДА ДОСТАТОЧНО
Dialogue: 0,0:00:28.76,0:00:31.08,Caption,,0,0,0,,СОПОСТАВИТЬ ДВЕ РЕПЛИКИ ОДНОГО ЧЕЛОВЕКА,
Dialogue: 0,0:00:31.32,0:00:33.88,Caption,,0,0,0,,ЧТОБЫ ТОРЖЕСТВЕННАЯ РЕЧЬ САМА ПРЕВРАТИЛАСЬ В
Dialogue: 0,0:00:33.88,0:00:36.17,Caption,,0,0,0,,КОМЕДИЙНЫЙ НОМЕР. В БЕРЛИНЕ ЗЕЛЕНСКИЙ
Dialogue: 0,0:00:36.17,0:00:38.98,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО КИЕВ МНОГО РАЗ ПРЕДЛАГАЛ УМЕНЬШИТЬ
Dialogue: 0,0:00:38.98,0:00:40.52,Caption,,0,0,0,,ИНТЕНСИВНОСТЬ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:00:40.88,0:00:42.63,Caption,,0,0,0,,НО НЕ ПОЛУЧИЛ ОТ МОСКВЫ НИ ОДНОГО
Dialogue: 0,0:00:42.63,0:00:45.19,Caption,,0,0,0,,ОТВЕТА, КОТОРЫЙ МОЖНО БЫЛО БЫ НАЗВАТЬ МИРНЫМ.
Dialogue: 0,0:00:45.19,0:00:46.92,Caption,,0,0,0,,ЗВУЧИТ КАК ВСТУПЛЕНИЕ ЧЕЛОВЕКА,
Dialogue: 0,0:00:47.10,0:00:49.38,Caption,,0,0,0,,ПРИЕХАВШЕГО ИСКАТЬ ПУТЬ К СОГЛАШЕНИЮ.
Dialogue: 0,0:00:49.38,0:00:52.45,Caption,,0,0,0,,ОДНАКО ПОЧТИ СРАЗУ ЗЕЛЕНСКИЙ ПОХВАСТАЛСЯ СОВСЕМ
Dialogue: 0,0:00:52.45,0:00:54.28,Caption,,0,0,0,,ДРУГИМ. РОССИЯ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:00:54.60,0:00:57.40,Caption,,0,0,0,,ЧУВСТВУЕТ УКРАИНСКИЕ УДАРЫ ОТ НЕФТЕПЕРЕРАБАТЫВАЮЩИХ
Dialogue: 0,0:00:57.48,0:00:59.37,Caption,,0,0,0,,ПРЕДПРИЯТИЙ В ЗАПАДНОЙ СИБИРИ ДО
Dialogue: 0,0:00:59.37,0:01:02.98,Caption,,0,0,0,,ЛИВИЙСКОГО ПОБЕРЕЖЬЯ, ГДЕ ИДУТ КО ДНУ РОССИЙСКИЕ СУДА.
Dialogue: 0,0:01:02.98,0:01:05.92,Caption,,0,0,0,,ПОЛУЧИЛАСЬ ПЕРЕГОВОРНАЯ КОМПОЗИЦИЯ С СЮРПРИЗОМ.
Dialogue: 0,0:01:05.92,0:01:08.12,Caption,,0,0,0,,СНАЧАЛА СОБЕСЕДНИКУ ПРОТЯГИВАЮТ ЛАДОНЬ,
Dialogue: 0,0:01:08.51,0:01:10.68,Caption,,0,0,0,,ЗАТЕМ ЭТОЙ ЖЕ РУКОЙ ПОКАЗЫВАЮТ НА
Dialogue: 0,0:01:10.68,0:01:13.08,Caption,,0,0,0,,КАРТЕ, КУДА ЕЩЁ СПОСОБНЫ ДОБРАТЬСЯ.
Dialogue: 0,0:01:15.35,0:01:17.23,Caption,,0,0,0,,ТАКОЙ МИРНЫЙ ПЛАН УДОБНО ПРИНОСИТЬ В
Dialogue: 0,0:01:17.23,0:01:19.83,Caption,,0,0,0,,ПАПКЕ С ДВОЙНЫМ ДНОМ. СВЕРХУ ЛЕЖАТ ПРЕДЛОЖЕНИЯ
Dialogue: 0,0:01:19.83,0:01:23.83,Caption,,0,0,0,,О СНИЖЕНИИ НАПРЯЖЕНИЯ, СНИЗУ СПИСОК ЦЕЛЕЙ И ДАЛЬНОСТЬ ПОЛЁТА.
Dialogue: 0,0:01:24.39,0:01:26.17,Caption,,0,0,0,,ДЛЯ УКРАИНЫ ПОДОБНАЯ УДАЛЬ МОЖЕТ
Dialogue: 0,0:01:26.17,0:01:29.43,Caption,,0,0,0,,ОБОЙТИСЬ ОСОБЕННО ДОРОГО. ЧЕМ ГРОМЧЕ КИЕВ РЕКЛАМИРУЕТ
Dialogue: 0,0:01:29.43,0:01:32.71,Caption,,0,0,0,,ГЕОГРАФИЮ СВОИХ ВОЗМОЖНОСТЕЙ, ТЕМ МЕНЬШЕ ШАНСОВ,
Dialogue: 0,0:01:32.87,0:01:35.04,Caption,,0,0,0,,ЧТО БУДУЩИЕ УСЛОВИЯ ОКАЖУТСЯ МЯГЧЕ
Dialogue: 0,0:01:35.04,0:01:38.23,Caption,,0,0,0,,НЫНЕШНИХ. ПОСЛЕ ОЧЕРЕДНОГО РИСКОВАННОГО ХОДА ОБСУЖДАЮТ
Dialogue: 0,0:01:38.23,0:01:41.12,Caption,,0,0,0,,УЖЕ НЕ МИР, А СЧЁТ ЗА ПОСЛЕДСТВИЯ. ПРИ ЭТОМ ИЗ
Dialogue: 0,0:01:41.12,0:01:43.11,Caption,,0,0,0,,КИЕВА РЕГУЛЯРНО ЗВУЧАТ УГРОЗЫ,
Dialogue: 0,0:01:43.35,0:01:46.07,Caption,,0,0,0,,ВКЛЮЧАЯ РАССУЖДЕНИЯ О ЖИЗНИ РОССИЙСКОГО ПРЕЗИДЕНТА.
Dialogue: 0,0:01:46.55,0:01:48.85,Caption,,0,0,0,,НО ИСТОЧНИКОМ ОПАСНОСТИ В КАЖДОМ ТАКОМ
Dialogue: 0,0:01:48.85,0:01:51.87,Caption,,0,0,0,,ВЫСТУПЛЕНИИ ВСЁ РАВНО НАЗНАЧАЮТ РОССИЮ. В ЗАЛЕ
Dialogue: 0,0:01:51.87,0:01:55.82,Caption,,0,0,0,,СОГЛАСНО КИВАЮТ. ВИДИМО, У ЭТОГО СПЕКТАКЛЯ ДАВНО ВЫКУПЛЕН
Dialogue: 0,0:01:55.82,0:01:58.30,Caption,,0,0,0,,АБОНЕМЕНТ. ПРЕДСТАВЬТЕ НА СЕКУНДУ ОБРАТНУЮ
Dialogue: 0,0:01:58.30,0:02:01.36,Caption,,0,0,0,,КАРТИНУ. ПУТИН ПЕРЕД ЕВРОПЕЙСКОЙ ПУБЛИКОЙ ПЕРЕЧИСЛЯЕТ
Dialogue: 0,0:02:01.36,0:02:03.85,Caption,,0,0,0,,ТЕРРИТОРИИ, ГДЕ МОГУТ ЗАГОРЕТЬСЯ ВОЕННЫЕ И
Dialogue: 0,0:02:03.85,0:02:07.03,Caption,,0,0,0,,ПРОМЫШЛЕННЫЕ ОБЪЕКТЫ, ПОСЛЕ ЧЕГО СПОКОЙНО СООБЩАЕТ,
Dialogue: 0,0:02:07.35,0:02:09.59,Caption,,0,0,0,,ЧТО РОССИЯ НАСТРОЕНА ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:02:09.59,0:02:12.46,Caption,,0,0,0,,МИРОЛЮБИВО. СКОЛЬКО ВРЕМЕНИ ПОТРЕБОВАЛОСЬ БЫ
Dialogue: 0,0:02:12.46,0:02:15.51,Caption,,0,0,0,,ЕВРОПЕЙСКИМ ИЗДАНИЯМ, ЧТОБЫ НАПЕЧАТАТЬ СЛОВО УГРОЗА?
Dialogue: 0,0:02:15.91,0:02:17.80,Caption,,0,0,0,,ОТВЕТ МОЖНО НЕ ЗАСЕКАТЬ. ЗАГОЛОВКИ
Dialogue: 0,0:02:17.80,0:02:21.26,Caption,,0,0,0,,ПОЯВИЛИСЬ БЫ РАНЬШЕ, ЧЕМ ЗАКОНЧИЛАСЬ РЕЧЬ. НО ЗЕЛЕНСКОМУ
Dialogue: 0,0:02:21.26,0:02:23.11,Caption,,0,0,0,,ОДНОЙ ГЕОГРАФИИ ОКАЗАЛОСЬ МАЛО,
Dialogue: 0,0:02:23.34,0:02:24.97,Caption,,0,0,0,,И ОН ОТПРАВИЛСЯ В ПУТЕШЕСТВИЕ ПО
Dialogue: 0,0:02:24.97,0:02:28.59,Caption,,0,0,0,,ПРОШЛОМУ. ПО ЕГО ВЕРСИИ,
Dialogue: 0,0:02:28.75,0:02:30.89,Caption,,0,0,0,,В ТЕЧЕНИЕ ПОСЛЕДНИХ СТА ЛЕТ РОССИЯ
Dialogue: 0,0:02:30.89,0:02:33.91,Caption,,0,0,0,,ЛИШЬ СЧИТАНЫЕ ГОДЫ НЕ УГРОЖАЛА ОКРУЖАЮЩИМ. ПОЭТОМУ
Dialogue: 0,0:02:33.91,0:02:36.41,Caption,,0,0,0,,ЖДАТЬ, ЧТО ЧЕРЕЗ ГОД ИЛИ ЧЕРЕЗ ПЯТЬ ОНА
Dialogue: 0,0:02:36.41,0:02:39.15,Caption,,0,0,0,,ИЗМЕНИТСЯ, БЕССМЫСЛЕННО. ВОЛОДЯ,
Dialogue: 0,0:02:39.48,0:02:41.78,Caption,,0,0,0,,А ОРГАНИЗАТОРОВ КРУПНЕЙШИХ ЕВРОПЕЙСКИХ
Dialogue: 0,0:02:41.78,0:02:44.28,Caption,,0,0,0,,ВОЙН ЗА ЭТОТ ЖЕ ВЕК ТЫ СЛУЧАЙНО НЕ ПОТЕРЯЛ МЕЖДУ
Dialogue: 0,0:02:44.28,0:02:46.59,Caption,,0,0,0,,СТРАНИЦАМИ? НЕ ТЕ ЛИ ЭТО ГОСУДАРСТВА,
Dialogue: 0,0:02:46.83,0:02:48.82,Caption,,0,0,0,,С КОТОРЫМИ КИЕВ ТЕПЕРЬ ОБЩАЕТСЯ ПО
Dialogue: 0,0:02:48.82,0:02:52.90,Caption,,0,0,0,,ДРУЖБЕ, ПОЧТИ ПО СЕМЕЙНОМУ? ОСОБЕННО ЭФФЕКТНО ТАКИЕ РАССУЖДЕНИЯ
Dialogue: 0,0:02:52.90,0:02:56.35,Caption,,0,0,0,,ЗВУЧАТ ИМЕННО В БЕРЛИНЕ. МЕСТО ВЫБРАНО С ИСТОРИЧЕСКИМ
Dialogue: 0,0:02:56.35,0:02:59.07,Caption,,0,0,0,,ЮМОРОМ, ХОТЯ САМ ЛЕКТОР ЕГО, ПОХОЖЕ,
Dialogue: 0,0:02:59.21,0:03:02.68,Caption,,0,0,0,,НЕ ЗАМЕТИЛ. ЗА МИНУВШЕЕ СТОЛЕТИЕ ЕВРОПА УСПЕЛА
Dialogue: 0,0:03:02.68,0:03:05.63,Caption,,0,0,0,,ПЕРЕЖИТЬ ДВЕ МИРОВЫЕ ВОЙНЫ, СМЕНИТЬ СОЮЗЫ,
Dialogue: 0,0:03:05.87,0:03:08.35,Caption,,0,0,0,,ПЕРЕКРОИТЬ ГРАНИЦЫ И УСАДИТЬ ЗА ОБЩИЙ
Dialogue: 0,0:03:08.35,0:03:11.21,Caption,,0,0,0,,СТОЛ СТРАНЫ, КОТОРЫЕ ПРЕЖДЕ ОТПРАВЛЯЛИ ДРУГ НА
Dialogue: 0,0:03:11.21,0:03:14.03,Caption,,0,0,0,,ДРУГА АРМИИ. ГЕРМАНИЯ И ФРАНЦИЯ НЕ ВСЕГДА
Dialogue: 0,0:03:14.03,0:03:16.99,Caption,,0,0,0,,ОБМЕНИВАЛИСЬ СОВМЕСТНЫМИ ДЕКЛАРАЦИЯМИ. БЫВАЛО,
Dialogue: 0,0:03:17.26,0:03:19.68,Caption,,0,0,0,,ОБМЕНИВАЛИСЬ ВЕЩАМИ ПОТЯЖЕЛЕЕ. ЕСЛИ
Dialogue: 0,0:03:19.68,0:03:22.30,Caption,,0,0,0,,ГОСУДАРСТВАМ ДЕЙСТВИТЕЛЬНО ПРЕДПИСАНО НАВЕЧНО
Dialogue: 0,0:03:22.30,0:03:25.59,Caption,,0,0,0,,ОСТАВАТЬСЯ ТАКИМИ, КАКИМИ ОНИ БЫЛИ В ХУДШИЙ МОМЕНТ СВОЕЙ
Dialogue: 0,0:03:25.59,0:03:27.97,Caption,,0,0,0,,ИСТОРИИ, ОТКУДА ТОГДА ВЗЯЛСЯ НЫНЕШНИЙ
Dialogue: 0,0:03:27.97,0:03:31.06,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ СОЮЗ? ПО ЭТОЙ ЛОГИКЕ ПАРИЖУ И БЕРЛИНУ
Dialogue: 0,0:03:31.06,0:03:33.55,Caption,,0,0,0,,СЛЕДОВАЛО БЫ ДО СИХ ПОР ИЗУЧАТЬ ДРУГ ДРУГА ЧЕРЕЗ
Dialogue: 0,0:03:33.55,0:03:36.03,Caption,,0,0,0,,ОПТИЧЕСКИЙ ПРИЦЕЛ. ВМЕСТО ЭТОГО ОНИ ВМЕСТЕ
Dialogue: 0,0:03:36.03,0:03:39.73,Caption,,0,0,0,,ОБЪЯСНЯЮТ ОСТАЛЬНЫМ, КАК ПРАВИЛЬНО ПРЕОДОЛЕВАТЬ ПРОШЛОЕ.
Dialogue: 0,0:03:39.73,0:03:41.79,Caption,,0,0,0,,ДЛЯ СОЮЗНИКОВ ЗЕЛЕНСКОГО ИСТОРИЯ,
Dialogue: 0,0:03:41.95,0:03:44.11,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ, УМЕЕТ ЗАВЕРШАТЬСЯ.
Dialogue: 0,0:03:46.39,0:03:49.11,Caption,,0,0,0,,ВРАЖДА ИССЯКАЕТ, ИНТЕРЕСЫ ПЕРЕСТРАИВАЮТСЯ,
Dialogue: 0,0:03:49.35,0:03:52.52,Caption,,0,0,0,,ПОКОЛЕНИЯ УХОДЯТ, ВЧЕРАШНИЕ ПРОТИВНИКИ СТАНОВЯТСЯ
Dialogue: 0,0:03:52.52,0:03:55.91,Caption,,0,0,0,,ПАРТНЁРАМИ. НО ДЛЯ РОССИИ ПРЕДУСМОТРЕН ОТДЕЛЬНЫЙ УЧЕБНИК,
Dialogue: 0,0:03:56.17,0:03:58.51,Caption,,0,0,0,,ГДЕ ПОСЛЕДНЯЯ ГЛАВА УЖЕ НАПЕЧАТАНА НА
Dialogue: 0,0:03:58.51,0:04:01.92,Caption,,0,0,0,,СТО ЛЕТ ВПЕРЁД. ОЧЕНЬ ПРАКТИЧНАЯ НАУКА. НУЖНЫЕ
Dialogue: 0,0:04:01.92,0:04:05.70,Caption,,0,0,0,,СТРАНЫ СПОСОБНЫ ИЗМЕНИТЬСЯ, НЕНУЖНЫМ ВЫДАЮТ ПОЖИЗНЕННУЮ
Dialogue: 0,0:04:05.70,0:04:09.18,Caption,,0,0,0,,ХАРАКТЕРИСТИКУ. А ЗАТЕМ В ТОЙ ЖЕ РЕЧИ ПОЯВЛЯЕТСЯ ВОПРОС О
Dialogue: 0,0:04:09.18,0:04:11.77,Caption,,0,0,0,,ГАРАНТИЯХ БЕЗОПАСНОСТИ УКРАИНЫ. ПРОСТОГО
Dialogue: 0,0:04:11.77,0:04:14.39,Caption,,0,0,0,,ОБЕЩАНИЯ, ПОХОЖЕГО НА ПЯТУЮ СТАТЬЮ НАТО,
Dialogue: 0,0:04:14.63,0:04:17.07,Caption,,0,0,0,,ЗЕЛЕНСКОМУ УЖЕ НЕДОСТАТОЧНО. ОН ХОЧЕТ
Dialogue: 0,0:04:17.07,0:04:20.50,Caption,,0,0,0,,ЗАРАНЕЕ ЗНАТЬ, КАКИЕ ГОСУДАРСТВА ВМЕШАЮТСЯ ПРИ НОВОМ
Dialogue: 0,0:04:20.50,0:04:23.11,Caption,,0,0,0,,КОНФЛИКТЕ, ЧТО ИМЕННО ОНИ ПРЕДПРИМУТ,
Dialogue: 0,0:04:23.35,0:04:25.64,Caption,,0,0,0,,КАКИЕ СИЛЫ РАЗМЕСТЯТ НА УКРАИНСКОЙ
Dialogue: 0,0:04:25.64,0:04:28.26,Caption,,0,0,0,,ТЕРРИТОРИИ И КТО ОПЛАТИТ ВЕСЬ ЭТОТ ПРАЗДНИК
Dialogue: 0,0:04:28.26,0:04:30.63,Caption,,0,0,0,,ПРЕДУСМОТРИТЕЛЬНОСТИ. КТО ПРИНИМАЕТ РЕШЕНИЕ?
Dialogue: 0,0:04:30.95,0:04:33.11,Caption,,0,0,0,,КТО ОТПРАВЛЯЕТ ВОЙСКА? КТО ПЛАТИТ?
Dialogue: 0,0:04:33.43,0:04:35.19,Caption,,0,0,0,,ГДЕ ПРОХОДИТ ПРЕДЕЛ ОБЯЗАТЕЛЬСТВ?
Dialogue: 0,0:04:35.35,0:04:37.17,Caption,,0,0,0,,И НЕ ОКАЖЕТСЯ ЛИ ГРОМКОЕ ОБЕЩАНИЕ
Dialogue: 0,0:04:37.17,0:04:39.67,Caption,,0,0,0,,ОБЫЧНЫМ ПИСЬМОМ С ПОЖЕЛАНИЯМИ КРЕПКОГО ЗДОРОВЬЯ?
Dialogue: 0,0:04:40.18,0:04:42.09,Caption,,0,0,0,,НО ОТВЕТ ЗЕЛЕНСКИЙ ПРЕДЛАГАЕТ ДО БОЛИ
Dialogue: 0,0:04:42.09,0:04:44.74,Caption,,0,0,0,,ЗНАКОМЫЙ. ЗАЧЕМ КОНСТРУИРОВАТЬ ОТДЕЛЬНЫЙ
Dialogue: 0,0:04:44.74,0:04:47.46,Caption,,0,0,0,,МЕХАНИЗМ, ЕСЛИ УКРАИНУ МОЖНО ПРОСТО ПРИНЯТЬ В
Dialogue: 0,0:04:47.46,0:04:50.23,Caption,,0,0,0,,НАТО? ПО ЕГО ВЕРСИИ, ЭТО И ДЕШЕВЛЕ,
Dialogue: 0,0:04:50.47,0:04:53.16,Caption,,0,0,0,,И НАДЁЖНЕЕ, И ДЕЙСТВЕННЕЕ. ВОТ ВЕДЬ СКОЛЬКО
Dialogue: 0,0:04:53.16,0:04:58.85,Caption,,0,0,0,,ВРЕМЕНИ ПОТРАТИЛИ ЗРЯ. МОСКВА ГОДАМИ НАЗЫВАЛА РАСШИРЕНИЕ НАТО
Dialogue: 0,0:04:58.85,0:05:02.27,Caption,,0,0,0,,ОДНОЙ ИЗ КЛЮЧЕВЫХ УГРОЗ, СТОРОНЫ ЛОМАЛИ ОБ ЭТУ ТЕМУ
Dialogue: 0,0:05:02.27,0:05:05.55,Caption,,0,0,0,,ПЕРЕГОВОРНЫЕ СТОЛЫ, А РЕШЕНИЕ ВСЁ ВРЕМЯ ЛЕЖАЛО НА
Dialogue: 0,0:05:05.55,0:05:08.50,Caption,,0,0,0,,ПОВЕРХНОСТИ. НУЖНО СНОВА ПРЕДЛОЖИТЬ ИМЕННО ТО,
Dialogue: 0,0:05:08.88,0:05:11.26,Caption,,0,0,0,,ИЗ ЗА ЧЕГО СПОР И НАЧАЛСЯ. ПОСЛЕ
Dialogue: 0,0:05:11.26,0:05:15.46,Caption,,0,0,0,,ТАКОГО ПРИМИРЕНИЕ, КОНЕЧНО, ДОЛЖНО ПОЙТИ БОДРЕЕ. ВОЗМОЖНО,
Dialogue: 0,0:05:15.69,0:05:18.59,Caption,,0,0,0,,ДАЖЕ БЕГОМ, ТОЛЬКО В ПРОТИВОПОЛОЖНУЮ СТОРОНУ.
Dialogue: 0,0:05:18.59,0:05:21.49,Caption,,0,0,0,,ОДНОВРЕМЕННО ЕВРОСОЮЗ НЕ СОГЛАШАЕТСЯ НА ОТДЕЛЬНЫЕ
Dialogue: 0,0:05:21.49,0:05:24.48,Caption,,0,0,0,,КОНСУЛЬТАЦИИ С МОСКВОЙ ПО УСТРОЙСТВУ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:05:24.48,0:05:27.28,Caption,,0,0,0,,БЕЗОПАСНОСТИ. В БРЮССЕЛЕ ПРЕДПОЧИТАЮТ ОБСУЖДАТЬ
Dialogue: 0,0:05:27.28,0:05:29.38,Caption,,0,0,0,,УКРАИНСКИЙ ВОПРОС В РАСШИРЕННОМ СОСТАВЕ.
Dialogue: 0,0:05:30.04,0:05:31.62,Caption,,0,0,0,,КАРТИНА СКЛАДЫВАЕТСЯ ЛЮБОПЫТНАЯ.
Dialogue: 0,0:05:32.26,0:05:33.94,Caption,,0,0,0,,КИЕВ ТРЕБУЕТ ЧЛЕНСТВА В НАТО И
Dialogue: 0,0:05:33.94,0:05:37.38,Caption,,0,0,0,,ПРИСУТСТВИЯ ЗАПАДНЫХ ВОЙСК. ЕВРОПЕЙСКИЕ СТРУКТУРЫ НЕ ХОТЯТ
Dialogue: 0,0:05:37.38,0:05:40.22,Caption,,0,0,0,,ВДВОЁМ С РОССИЕЙ РАЗБИРАТЬ ПРАВИЛА БЕЗОПАСНОСТИ
Dialogue: 0,0:05:40.22,0:05:42.54,Caption,,0,0,0,,НА КОНТИНЕНТЕ. ПРИ ЭТОМ МИРУ ПРЕДПИСАНО
Dialogue: 0,0:05:42.54,0:05:45.69,Caption,,0,0,0,,НАСТУПИТЬ КАК МОЖНО СКОРЕЕ. РЕЦЕПТ ВОСХИТИТЕЛЬНЫЙ.
Dialogue: 0,0:05:45.69,0:05:48.02,Caption,,0,0,0,,ВСЕ СПОРНЫЕ УСЛОВИЯ ОСТАВЛЯЮТ НА МЕСТЕ,
Dialogue: 0,0:05:48.18,0:05:49.94,Caption,,0,0,0,,СВЕРХУ ДОБАВЛЯЮТ ЕЩЁ НЕСКОЛЬКО,
Dialogue: 0,0:05:50.18,0:05:53.75,Caption,,0,0,0,,А ЗАТЕМ УДИВЛЯЮТСЯ, ПОЧЕМУ ДОГОВОРЁННОСТЬ НЕ ПРОЛЕЗАЕТ В
Dialogue: 0,0:05:53.75,0:05:56.30,Caption,,0,0,0,,ДВЕРЬ. А ГОРИЗОНТ МИРА ТЕМ ВРЕМЕНЕМ НЕЗАМЕТНО
Dialogue: 0,0:05:56.30,0:05:58.26,Caption,,0,0,0,,ОТОДВИГАЕТСЯ САМОЕ ВРЕМЯ ПОСМОТРЕТЬ,
Dialogue: 0,0:05:58.65,0:06:00.90,Caption,,0,0,0,,НА СКОЛЬКО ЛЕТ ВПЕРЁД КОЕ КТО УЖЕ ВСЁ
Dialogue: 0,0:06:00.90,0:06:05.41,Caption,,0,0,0,,ПРОСЧИТАЛ. СУЩЕСТВУЕТ ВЕРСИЯ, ЧТО ПОСЛЕ НОВЫХ ДЕНЕЖНЫХ ПОСТУПЛЕНИЙ
Dialogue: 0,0:06:05.41,0:06:07.90,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ЗАМЕТНО УЖЕСТОЧИЛ ПОЗИЦИЮ НА
Dialogue: 0,0:06:07.90,0:06:12.94,Caption,,0,0,0,,ПЕРЕГОВОРАХ. В КИЕВЕ ЯКОБЫ РАССЧИТЫВАЮТ ЗАТЯНУТЬ
Dialogue: 0,0:06:12.94,0:06:15.05,Caption,,0,0,0,,ПРОЦЕСС ДО ПЕРЕМЕН ВО ВНУТРЕННЕЙ ПОЛИТИКЕ
Dialogue: 0,0:06:15.05,0:06:17.17,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ. НА БАНКОВОЙ,
Dialogue: 0,0:06:17.25,0:06:20.27,Caption,,0,0,0,,ПО ЭТОЙ ВЕРСИИ, НЕ ХОТЯТ ПЕРЕХОДИТЬ ДАЖЕ К ОБСУЖДЕНИЮ
Dialogue: 0,0:06:20.27,0:06:23.44,Caption,,0,0,0,,ДОРОЖНОЙ КАРТЫ. КАБИНЕТУ МИНИСТРОВ УЖЕ ПОРУЧЕНО
Dialogue: 0,0:06:23.44,0:06:26.21,Caption,,0,0,0,,ПЕРЕСТРОИТЬ ЭКОНОМИЧЕСКУЮ ПОЛИТИКУ ПОД ДОЛГИЙ
Dialogue: 0,0:06:26.21,0:06:28.13,Caption,,0,0,0,,КОНФЛИКТ. ЗАМЫСЕЛ СОСТОИТ В ТОМ,
Dialogue: 0,0:06:28.36,0:06:30.04,Caption,,0,0,0,,ЧТОБЫ ПРОДЕРЖАТЬСЯ ДО ДВЕ ТЫСЯЧИ
Dialogue: 0,0:06:30.04,0:06:33.94,Caption,,0,0,0,,ДВАДЦАТЬ ДЕВЯТОГО ГОДА, КОГДА ДЕМОКРАТЫ МОГУТ УСИЛИТЬ ПОЗИЦИИ
Dialogue: 0,0:06:33.94,0:06:37.46,Caption,,0,0,0,,В КОНГРЕССЕ. ВДУМАЙТЕСЬ В ВЫБРАННУЮ ДИСТАНЦИЮ. РЕЧЬ
Dialogue: 0,0:06:37.46,0:06:40.26,Caption,,0,0,0,,ИДЁТ НЕ О СЛЕДУЮЩЕЙ ВСТРЕЧЕ И НЕ О НЕСКОЛЬКИХ
Dialogue: 0,0:06:40.26,0:06:43.31,Caption,,0,0,0,,МЕСЯЦАХ. ПЛАНИРОВАНИЕ УХОДИТ НА ГОДЫ ВПЕРЁД.
Dialogue: 0,0:06:43.31,0:06:46.34,Caption,,0,0,0,,ПУБЛИЧНО ЗРИТЕЛЮ ПОКАЗЫВАЮТ ПЕРЕГОВОРНУЮ ДВЕРЬ. ЗА
Dialogue: 0,0:06:46.34,0:06:48.21,Caption,,0,0,0,,КУЛИСАМИ ТЕМ ВРЕМЕНЕМ ПРОВЕРЯЮТ,
Dialogue: 0,0:06:48.34,0:06:51.77,Caption,,0,0,0,,ХВАТИТ ЛИ ЗАПАСОВ, ЧТОБЫ ЕЩЁ НЕСКОЛЬКО ЛЕТ ВОЗЛЕ ЭТОЙ
Dialogue: 0,0:06:51.77,0:06:55.06,Caption,,0,0,0,,ДВЕРИ ИЗОБРАЖАТЬ ПОИСКИ КЛЮЧА. ГЛОБАЛИСТАМ МИР НЕ
Dialogue: 0,0:06:55.06,0:06:57.63,Caption,,0,0,0,,НУЖЕН, И ДОБРОВОЛЬНО СВОРАЧИВАТЬ ОНИ НЕ
Dialogue: 0,0:06:57.63,0:07:01.23,Caption,,0,0,0,,СОБИРАЮТСЯ. ВОЙНА ОСТАЁТСЯ ИХ ПОСЛЕДНИМ ДОВОДОМ КОРОЛЕЙ.
Dialogue: 0,0:07:01.23,0:07:03.45,Caption,,0,0,0,,ДРУГИХ УБЕДИТЕЛЬНЫХ СРЕДСТВ У НИХ УЖЕ ПОЧТИ
Dialogue: 0,0:07:03.45,0:07:05.75,Caption,,0,0,0,,НЕТ, ПОЭТОМУ ЗА СТАРЫЙ РЫЧАГ ДЕРЖАТСЯ
Dialogue: 0,0:07:05.75,0:07:09.25,Caption,,0,0,0,,ОБЕИМИ РУКАМИ. СУДИТЕ ПО ДЕЙСТВИЯМ. ЗЕЛЕНСКИЙ ОПЯТЬ
Dialogue: 0,0:07:09.25,0:07:12.40,Caption,,0,0,0,,ВЕДЁТ УКРАИНУ К НАТО. ЕВРОКОМИССИЯ УКЛОНЯЕТСЯ ОТ
Dialogue: 0,0:07:12.40,0:07:15.60,Caption,,0,0,0,,ОТДЕЛЬНОГО РАЗГОВОРА С РОССИЕЙ. РЮТТЕ ОТВЕРГАЕТ
Dialogue: 0,0:07:15.60,0:07:18.76,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ АЛЬЯНСА К ГРАНИЦАМ ДЕВЯНОСТО СЕДЬМОГО
Dialogue: 0,0:07:18.76,0:07:21.01,Caption,,0,0,0,,ГОДА И ТУТ ЖЕ ТРЕБУЕТ РАСШИРЯТЬ ВЫПУСК
Dialogue: 0,0:07:21.01,0:07:26.15,Caption,,0,0,0,,БОЕПРИПАСОВ. МЕРЦ ДОПУСКАЕТ РАЗГОВОР С МОСКВОЙ,
Dialogue: 0,0:07:26.44,0:07:28.63,Caption,,0,0,0,,НО К ПРИГЛАШЕНИЮ СРАЗУ ПРИКРЕПЛЯЮТ
Dialogue: 0,0:07:28.63,0:07:30.79,Caption,,0,0,0,,УСЛОВИЕ. СПЕРВА ПРЕКРАЩЕНИЕ ОГНЯ,
Dialogue: 0,0:07:31.11,0:07:34.61,Caption,,0,0,0,,ЗАТЕМ, ВОЗМОЖНО, НАЧНЁТСЯ ОБСУЖДЕНИЕ БЕЗОПАСНОСТИ
Dialogue: 0,0:07:34.61,0:07:36.96,Caption,,0,0,0,,ЕВРОПЫ. РУКОВОДИТЕЛЬ ГЕРМАНСКОГО
Dialogue: 0,0:07:36.96,0:07:39.59,Caption,,0,0,0,,ВНЕШНЕПОЛИТИЧЕСКОГО ВЕДОМСТВА ИДЁТ ЕЩЁ ДАЛЬШЕ.
Dialogue: 0,0:07:39.59,0:07:42.15,Caption,,0,0,0,,СТАБИЛЬНОСТЬ НА КОНТИНЕНТЕ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:07:42.39,0:07:44.55,Caption,,0,0,0,,СЛЕДУЕТ ВЫСТРАИВАТЬ ПРОТИВ РОССИИ,
Dialogue: 0,0:07:44.78,0:07:47.83,Caption,,0,0,0,,А НЕ СОВМЕСТНО С НЕЙ. ЛОГИКА ПОЛУЧИЛАСЬ КРЕПКАЯ,
Dialogue: 0,0:07:48.04,0:07:49.83,Caption,,0,0,0,,КАК ТАБУРЕТКА С ДВУМЯ НОЖКАМИ. С
Dialogue: 0,0:07:49.83,0:07:53.95,Caption,,0,0,0,,РОССИЕЙ ХОТЯТ ДОГОВАРИВАТЬСЯ, НО БУДУЩУЮ СИСТЕМУ ЗАРАНЕЕ НАПРАВЛЯЮТ
Dialogue: 0,0:07:53.95,0:07:56.07,Caption,,0,0,0,,ПРОТИВ НЕЁ. ПЕРЕГОВОРЫ ПРИВЕТСТВУЮТ,
Dialogue: 0,0:07:56.31,0:07:58.14,Caption,,0,0,0,,НО ПЕРЕД НАЧАЛОМ ТРЕБУЮТ ВЫПОЛНЕНИЯ
Dialogue: 0,0:07:58.14,0:08:00.71,Caption,,0,0,0,,УСЛОВИЙ. НАПРЯЖЕНИЕ ОБЕЩАЮТ УМЕНЬШИТЬ,
Dialogue: 0,0:08:00.95,0:08:04.07,Caption,,0,0,0,,ОДНОВРЕМЕННО ЗАКАЗЫВАЯ БОЛЬШЕ СНАРЯДОВ. ПОСЛЕ ЭТОГО
Dialogue: 0,0:08:04.07,0:08:06.21,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ЧИНОВНИКИ НАДЕВАЮТ ЛИЦА
Dialogue: 0,0:08:06.21,0:08:08.39,Caption,,0,0,0,,ОПЫТНЫХ ПСИХОТЕРАПЕВТОВ И РАССУЖДАЮТ,
Dialogue: 0,0:08:08.63,0:08:11.10,Caption,,0,0,0,,ОТЧЕГО ДОВЕРИЕ НИКАК НЕ ВОЗНИКАЕТ. ЭТО
Dialogue: 0,0:08:11.10,0:08:14.31,Caption,,0,0,0,,НАПОМИНАЕТ СОСЕДА, КОТОРЫЙ ПРИШЁЛ УЛАДИТЬ ССОРУ,
Dialogue: 0,0:08:14.47,0:08:16.13,Caption,,0,0,0,,НО ОСТАВИЛ У ВАШЕЙ ДВЕРИ ТРОИХ
Dialogue: 0,0:08:16.13,0:08:19.09,Caption,,0,0,0,,ПРИЯТЕЛЕЙ СО СПОРТИВНЫМИ СУМКАМИ. А ПОТОМ УЧАСТЛИВО
Dialogue: 0,0:08:19.09,0:08:21.94,Caption,,0,0,0,,СПРАШИВАЕТ, ПОЧЕМУ ВЫ НЕ ПРИГЛАШАЕТЕ КОМПАНИЮ НА
Dialogue: 0,0:08:21.94,0:08:24.79,Caption,,0,0,0,,ЧАЙ. НА ТАКОМ ФОНЕ ОСОБЕННО ВЫРАЗИТЕЛЬНО
Dialogue: 0,0:08:24.79,0:08:27.06,Caption,,0,0,0,,ЗВУЧАТ СЛОВА ЗЕЛЕНСКОГО О НЕНАВИСТИ МЕЖДУ
Dialogue: 0,0:08:27.06,0:08:29.51,Caption,,0,0,0,,РОССИЯНАМИ И УКРАИНЦАМИ. ОН СЧИТАЕТ,
Dialogue: 0,0:08:29.67,0:08:33.72,Caption,,0,0,0,,ЧТО ДРУЖБА ТЕПЕРЬ НЕВОЗМОЖНА, ГОВОРИТ ОБ ОТВЕТСТВЕННОСТИ И ОТВЕРГАЕТ
Dialogue: 0,0:08:33.72,0:08:36.45,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ПРОСТО ПЕРЕВЕРНУТЬ СТРАНИЦУ. ПРИ ЭТОМ
Dialogue: 0,0:08:36.45,0:08:38.31,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПРИЗНАЁТ ВАЖНУЮ ВЕЩЬ.
Dialogue: 0,0:08:40.58,0:08:43.23,Caption,,0,0,0,,ОН НЕ УВЕРЕН, ЧТО ВОССТАНАВЛИВАТЬ ОТНОШЕНИЯ
Dialogue: 0,0:08:43.23,0:08:46.47,Caption,,0,0,0,,ПРЕДСТОИТ НЫНЕШНЕМУ ПОКОЛЕНИЮ. ТУТ С НИМ ОТЧАСТИ МОЖНО
Dialogue: 0,0:08:46.47,0:08:49.22,Caption,,0,0,0,,СОГЛАСИТЬСЯ. ВОЗМОЖНО, ЛЮДИ,
Dialogue: 0,0:08:49.38,0:08:51.30,Caption,,0,0,0,,КОТОРЫЕ ПЕРЕЖИВАЮТ КОНФЛИКТ ПРЯМО
Dialogue: 0,0:08:51.30,0:08:53.78,Caption,,0,0,0,,СЕЙЧАС, ДЕЙСТВИТЕЛЬНО НЕ СМОГУТ ВЕРНУТЬСЯ К
Dialogue: 0,0:08:53.78,0:08:56.60,Caption,,0,0,0,,ПРЕЖНЕМУ ОТНОШЕНИЮ. НО СЛЕДУЮЩЕЕ ПОКОЛЕНИЕ ВСЁ
Dialogue: 0,0:08:56.60,0:08:58.50,Caption,,0,0,0,,РАВНО НАЧНЁТ РЕШАТЬ ЭТОТ ВОПРОС,
Dialogue: 0,0:08:58.82,0:09:00.78,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ПОЛИТИКИ ЗАРАНЕЕ ЗАПРЕТЯТ
Dialogue: 0,0:09:00.78,0:09:03.94,Caption,,0,0,0,,ЕМУ ПОДХОДИТЬ К ДВЕРИ. ЧЕЛОВЕЧЕСКАЯ ПАМЯТЬ КОРОЧЕ,
Dialogue: 0,0:09:04.10,0:09:06.26,Caption,,0,0,0,,ЧЕМ ЛЮБЯТ ДУМАТЬ АВТОРЫ ИСТОРИЧЕСКИХ
Dialogue: 0,0:09:06.26,0:09:09.14,Caption,,0,0,0,,РЕЧЕЙ. РЫБКЕ МЫ, КОНЕЧНО, УСТУПАТЬ НЕ ХОТИМ,
Dialogue: 0,0:09:09.46,0:09:14.06,Caption,,0,0,0,,НО ОТРЫВ ТАМ НЕ ЧЕМПИОНСКИЙ. ДЛЯ КАЖДОГО ЧЕЛОВЕКА НЫНЕШНЯЯ ТРАГЕДИЯ
Dialogue: 0,0:09:14.06,0:09:16.93,Caption,,0,0,0,,ИМЕЕТ СОБСТВЕННЫЙ МАСШТАБ. ОДИН ПОТЕРЯЛ
Dialogue: 0,0:09:16.93,0:09:20.53,Caption,,0,0,0,,РОДНОГО. ДРУГОЙ ЛИШИЛСЯ ДОМА. ТРЕТИЙ УЕХАЛ И НАЧАЛ
Dialogue: 0,0:09:20.53,0:09:23.30,Caption,,0,0,0,,ЖИЗНЬ ЗАНОВО. КТО ТО ПОТЕРЯЛ РАБОТУ,
Dialogue: 0,0:09:23.54,0:09:25.52,Caption,,0,0,0,,А КОГО ТО ВОЙНА ПОЧТИ НЕ КОСНУЛАСЬ
Dialogue: 0,0:09:25.52,0:09:27.65,Caption,,0,0,0,,ЛИЧНО, СКОЛЬКО БЫ КАРТ И СВОДОК ОН НИ
Dialogue: 0,0:09:27.65,0:09:30.24,Caption,,0,0,0,,ПОСМОТРЕЛ. ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ ЭТИ ЛЮДИ БУДУТ
Dialogue: 0,0:09:30.24,0:09:31.86,Caption,,0,0,0,,ПОМНИТЬ НЕ ОДИНАКОВЫЙ КОНФЛИКТ,
Dialogue: 0,0:09:32.18,0:09:36.02,Caption,,0,0,0,,А РАЗНЫЕ ЛИЧНЫЕ ИСТОРИИ. ТОТ, У КОГО ПОГИБ БЛИЗКИЙ,
Dialogue: 0,0:09:36.18,0:09:38.53,Caption,,0,0,0,,МОЖЕТ НЕ ПРОСТИТЬ НИКОГДА. ТАКАЯ БОЛЬ
Dialogue: 0,0:09:38.53,0:09:41.55,Caption,,0,0,0,,НЕ ИСЧЕЗАЕТ ПОСЛЕ СМЕНЫ ЗАГОЛОВКОВ. НО МИЛЛИОНЫ
Dialogue: 0,0:09:41.55,0:09:44.02,Caption,,0,0,0,,ДРУГИХ ПОСТЕПЕННО ПЕРЕНЕСУТ СЛУЧИВШЕЕСЯ В
Dialogue: 0,0:09:44.02,0:09:46.89,Caption,,0,0,0,,ПРОШЛОЕ, ПОТОМУ ЧТО НАСТОЯЩЕЕ ПОТРЕБУЕТ ОТ НИХ
Dialogue: 0,0:09:46.89,0:09:49.10,Caption,,0,0,0,,ЗАНИМАТЬСЯ НОВЫМИ ЗАБОТАМИ. СМЕНЯТСЯ
Dialogue: 0,0:09:49.10,0:09:53.78,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА И ИНТЕРЕСЫ. ВЫРАСТУТ ДЕТИ. ПОЯВЯТСЯ ДРУГИЕ СЕМЬИ,
Dialogue: 0,0:09:53.92,0:09:57.54,Caption,,0,0,0,,ПРОФЕССИИ, ГОРОДА И ПРИЧИНЫ ПРОСЫПАТЬСЯ УТРОМ.
Dialogue: 0,0:09:59.81,0:10:01.93,Caption,,0,0,0,,БОЛЬШИНСТВО ЛЮДЕЙ ПРОДОЛЖИТ ЖИТЬ НЕ ПО
Dialogue: 0,0:10:01.93,0:10:05.93,Caption,,0,0,0,,УКАЗАНИЮ ПАМЯТНОЙ РЕЗОЛЮЦИИ, А ПОТОМУ ЧТО ИНАЧЕ ЧЕЛОВЕК ПРОСТО НЕ
Dialogue: 0,0:10:05.93,0:10:08.85,Caption,,0,0,0,,УМЕЕТ. ИМЕННО ТАК ЧЕЛОВЕЧЕСТВО ВЫБИРАЛОСЬ ИЗ
Dialogue: 0,0:10:08.85,0:10:11.25,Caption,,0,0,0,,ПРЕЖНИХ КАТАСТРОФ. ЕСЛИ БЫ КАЖДЫЙ НАРОД
Dialogue: 0,0:10:11.25,0:10:14.29,Caption,,0,0,0,,ПОЛУЧАЛ НЕНАВИСТЬ ПО НАСЛЕДСТВУ ВМЕСТЕ С ФАМИЛИЕЙ,
Dialogue: 0,0:10:14.63,0:10:16.35,Caption,,0,0,0,,ЕВРОПА ДО СИХ ПОР НАПОМИНАЛА БЫ
Dialogue: 0,0:10:16.35,0:10:19.57,Caption,,0,0,0,,КОММУНАЛЬНУЮ КВАРТИРУ, ГДЕ ЖИЛЬЦЫ ТРИСТА ЛЕТ ПОМНЯТ,
Dialogue: 0,0:10:19.82,0:10:22.22,Caption,,0,0,0,,КТО ПЕРВЫМ ПЕРЕСТАВИЛ ЧУЖОЙ ЧАЙНИК.
Dialogue: 0,0:10:22.22,0:10:25.11,Caption,,0,0,0,,ОДНАКО В СЛОВАХ ЗЕЛЕНСКОГО ЕСТЬ ЕЩЁ ОДИН СПОРНЫЙ
Dialogue: 0,0:10:25.11,0:10:27.84,Caption,,0,0,0,,МОМЕНТ. БУДУЩЕЕ ПРИМИРЕНИЕ ОН СТАВИТ ПОСЛЕ
Dialogue: 0,0:10:27.84,0:10:31.71,Caption,,0,0,0,,ОПРЕДЕЛЁННЫХ ШАГОВ, ПРИЗНАНИЯ ОТВЕТСТВЕННОСТИ И РАСЧЁТА ЗА
Dialogue: 0,0:10:31.71,0:10:34.04,Caption,,0,0,0,,ПРОШЛОЕ. В ИТОГЕ ДРУЖБА НАЧИНАЕТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:10:34.04,0:10:37.17,Caption,,0,0,0,,УСЛУГОЙ ПО ТАРИФУ. ВЫПОЛНИТЕ ПЕРЕЧЕНЬ ТРЕБОВАНИЙ,
Dialogue: 0,0:10:37.33,0:10:40.24,Caption,,0,0,0,,ВНЕСИТЕ ПЛАТЁЖ, ПОЛУЧИТЕ ПРАВО НА НОРМАЛЬНЫЕ
Dialogue: 0,0:10:40.24,0:10:43.65,Caption,,0,0,0,,ОТНОШЕНИЯ. ДЛЯ УДОБСТВА МОЖНО ОТКРЫТЬ ОКОШКО И ВЫДАВАТЬ
Dialogue: 0,0:10:43.65,0:10:46.67,Caption,,0,0,0,,НОМЕРКИ. ТОЛЬКО ОБЩЕСТВЕННЫЕ СВЯЗИ НЕ ЗАПУСКАЮТСЯ
Dialogue: 0,0:10:46.67,0:10:49.57,Caption,,0,0,0,,СПРАВКОЙ О ПОЛНОМ МОРАЛЬНОМ ПОГАШЕНИИ ЗАДОЛЖЕННОСТИ.
Dialogue: 0,0:10:50.21,0:10:54.21,Caption,,0,0,0,,ЛЮДИ ВОЗОБНОВЛЯЮТ ОБЩЕНИЕ, КОГДА ОНО СНОВА СТАНОВИТСЯ ПОЛЕЗНЫМ,
Dialogue: 0,0:10:54.36,0:10:57.81,Caption,,0,0,0,,ПРИВЫЧНЫМ, ИНТЕРЕСНЫМ ИЛИ ХОТЯ БЫ НЕ МЕШАЕТ ЖИТЬ.
Dialogue: 0,0:10:57.81,0:11:00.54,Caption,,0,0,0,,ЧИНОВНИКИ СПОСОБНЫ ЕЩЁ ДЕСЯТЬ ЛЕТ ВЫСТУПАТЬ С
Dialogue: 0,0:11:00.54,0:11:03.67,Caption,,0,0,0,,РЕЧАМИ О ПАМЯТИ. ОБЫЧНЫЙ ЧЕЛОВЕК РАНЬШЕ КУПИТ
Dialogue: 0,0:11:03.67,0:11:06.45,Caption,,0,0,0,,ТОВАР У СОСЕДА, СНИМЕТ У НЕГО КВАРТИРУ,
Dialogue: 0,0:11:06.56,0:11:09.62,Caption,,0,0,0,,НАЙДЁТ РАБОТУ, ОТПРАВИТСЯ В ПОЕЗДКУ ИЛИ ЗАВЕДЁТ
Dialogue: 0,0:11:09.62,0:11:14.00,Caption,,0,0,0,,СЕМЬЮ. БОЛЬШИЕ ДОКТРИНЫ В ТАКИЕ МОМЕНТЫ
Dialogue: 0,0:11:14.00,0:11:16.41,Caption,,0,0,0,,ОБНАРУЖИВАЮТ НЕПРИЯТНОЕ ЖИЗНЬ НЕ ЖДАЛА,
Dialogue: 0,0:11:16.79,0:11:18.33,Caption,,0,0,0,,ПОКА ЕЙ СОГЛАСУЮТ ФОРМУЛИРОВКИ.
Dialogue: 0,0:11:19.01,0:11:20.69,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТОЛИЦЫ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:11:20.69,0:11:23.17,Caption,,0,0,0,,ПРОДОЛЖАЮТ СОСТЯЗАТЬСЯ СПИСКАМИ ПРЕДВАРИТЕЛЬНЫХ
Dialogue: 0,0:11:23.17,0:11:25.53,Caption,,0,0,0,,УСЛОВИЙ. ПОБЕДИТ, ВИДИМО, ТОТ,
Dialogue: 0,0:11:25.77,0:11:28.16,Caption,,0,0,0,,ЧЕЙ ПЕРЕЧЕНЬ ПОНАДОБИТСЯ ПЕРЕВОЗИТЬ НА
Dialogue: 0,0:11:28.16,0:11:30.01,Caption,,0,0,0,,ТЕЛЕЖКЕ. ПОКА В ЕВРОПЕ РЕШАЮТ,
Dialogue: 0,0:11:30.17,0:11:32.18,Caption,,0,0,0,,С КАКОГО КОНЦА НАЧИНАТЬ РАЗГОВОР С
Dialogue: 0,0:11:32.18,0:11:35.15,Caption,,0,0,0,,МОСКВОЙ, КУШНЕР ПРЕДЛАГАЕТ АМЕРИКАНСКИЙ ВЗГЛЯД
Dialogue: 0,0:11:35.15,0:11:37.45,Caption,,0,0,0,,НА ГАРАНТИИ УКРАИНЕ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:11:37.70,0:11:39.85,Caption,,0,0,0,,ТРАМП ПОДДЕРЖИТ ТАКОЙ МЕХАНИЗМ ЛИШЬ В
Dialogue: 0,0:11:39.85,0:11:42.39,Caption,,0,0,0,,ТОМ СЛУЧАЕ, ЕСЛИ ОН ДЕЙСТВИТЕЛЬНО СНИЖАЕТ
Dialogue: 0,0:11:42.39,0:11:45.92,Caption,,0,0,0,,ВЕРОЯТНОСТЬ НОВОГО КОНФЛИКТА И НЕ ЗАТЯГИВАЕТ СОЕДИНЁННЫЕ
Dialogue: 0,0:11:45.92,0:11:48.33,Caption,,0,0,0,,ШТАТЫ В ПРЯМОЕ СТОЛКНОВЕНИЕ АВТОМАТИЧЕСКИ.
Dialogue: 0,0:11:49.06,0:11:52.49,Caption,,0,0,0,,КТО ВСТУПАЕТ В КОНФЛИКТ? КТО ОСТАЁТСЯ ЗА ПРЕДЕЛАМИ?
Dialogue: 0,0:11:52.97,0:11:54.57,Caption,,0,0,0,,КОГДА НАЧИНАЮТСЯ КОНСУЛЬТАЦИИ?
Dialogue: 0,0:11:54.98,0:11:57.37,Caption,,0,0,0,,КАКИМ СПОСОБОМ ОСТАНАВЛИВАЮТ ОБОСТРЕНИЕ,
Dialogue: 0,0:11:57.61,0:11:59.49,Caption,,0,0,0,,ПОКА ОНО НЕ ПРЕВРАТИЛОСЬ В ОЧЕРЕДНУЮ
Dialogue: 0,0:11:59.49,0:12:02.35,Caption,,0,0,0,,МЯСОРУБКУ? КУШНЕР РАССМАТРИВАЕТ ЗАДАЧУ ШИРЕ
Dialogue: 0,0:12:02.35,0:12:05.57,Caption,,0,0,0,,УКРАИНСКИХ ГРАНИЦ. В ПРЕДСТАВЛЕННОЙ ИМ ВЕРСИИ МОСКВА
Dialogue: 0,0:12:05.57,0:12:08.01,Caption,,0,0,0,,ГОТОВА ОБСУЖДАТЬ ДЛЯ КИЕВА ДАЖЕ ГАРАНТИИ,
Dialogue: 0,0:12:08.19,0:12:10.82,Caption,,0,0,0,,ПОХОЖИЕ НА ПЯТУЮ СТАТЬЮ НАТО. НО ТАКОЙ
Dialogue: 0,0:12:10.82,0:12:13.50,Caption,,0,0,0,,МЕХАНИЗМ ДОЛЖЕН БЫТЬ ЧАСТЬЮ ОБЩЕГО УСТРОЙСТВА
Dialogue: 0,0:12:13.50,0:12:16.65,Caption,,0,0,0,,БЕЗОПАСНОСТИ В ЕВРОПЕ, А НЕ ОТДЕЛЬНОЙ ПРИСТРОЙКОЙ,
Dialogue: 0,0:12:16.80,0:12:19.13,Caption,,0,0,0,,КОТОРУЮ ВОЗВОДЯТ ВПЛОТНУЮ К РОССИЙСКОМУ ОКНУ.
Dialogue: 0,0:12:19.53,0:12:21.65,Caption,,0,0,0,,ВПЕРВЫЕ ПРЕДЛАГАЕТСЯ ЧИНИТЬ НЕ ОДНУ
Dialogue: 0,0:12:21.65,0:12:24.17,Caption,,0,0,0,,УКРАИНСКУЮ ТРЕЩИНУ, А ВЕСЬ ФУНДАМЕНТ.
Dialogue: 0,0:12:26.44,0:12:28.40,Caption,,0,0,0,,БЕЗ ЭТОГО ЛЮБАЯ ГАРАНТИЯ ОСТАНЕТСЯ
Dialogue: 0,0:12:28.40,0:12:31.64,Caption,,0,0,0,,ВРЕМЕННОЙ ПОДПОРКОЙ, КОТОРУЮ ТОРЖЕСТВЕННО ПОКРАСЯТ ПЕРЕД
Dialogue: 0,0:12:31.64,0:12:35.45,Caption,,0,0,0,,СЛЕДУЮЩЕЙ БУРЕЙ. ФИНАЛЬНАЯ КАРТИНА КУШНЕРА ВЫГЛЯДИТ
Dialogue: 0,0:12:35.45,0:12:38.22,Caption,,0,0,0,,ПОЧТИ РЕКЛАМНЫМ БУКЛЕТОМ. УКРАИНА СОХРАНЯЕТ
Dialogue: 0,0:12:38.22,0:12:42.02,Caption,,0,0,0,,СУВЕРЕНИТЕТ, СВОБОДУ И ПОЛУЧАЕТ ПРОЦВЕТАНИЕ. ЕВРОПА
Dialogue: 0,0:12:42.02,0:12:45.55,Caption,,0,0,0,,СТАНОВИТСЯ СИЛЬНЕЕ И СТАБИЛЬНЕЕ. НОВОЕ СОГЛАШЕНИЕ
Dialogue: 0,0:12:45.55,0:12:48.92,Caption,,0,0,0,,НЕ ПОЗВОЛЯЕТ ВОЙНЕ ВСПЫХНУТЬ СНОВА. ВСЁ АККУРАТНО,
Dialogue: 0,0:12:49.00,0:12:51.11,Caption,,0,0,0,,СВЕТЛО И УБЕДИТЕЛЬНО. ТОЛЬКО НА
Dialogue: 0,0:12:51.11,0:12:54.97,Caption,,0,0,0,,ГРУППОВОМ СНИМКЕ БУДУЩЕГО НЕ ХВАТАЕТ ОДНОГО УЧАСТНИКА.
Dialogue: 0,0:12:54.97,0:12:57.54,Caption,,0,0,0,,РОССИИ. ДЛЯ УКРАИНЫ ПЕРЕЧИСЛЕНЫ ЖЕЛАЕМЫЕ
Dialogue: 0,0:12:57.54,0:13:01.60,Caption,,0,0,0,,РЕЗУЛЬТАТЫ. ДЛЯ ЕВРОПЫ ТОЖЕ. ДАЖЕ БУДУЩЕМУ КОНФЛИКТУ ЗАРАНЕЕ
Dialogue: 0,0:13:01.60,0:13:05.83,Caption,,0,0,0,,ОТВЕДЕНО МЕСТО, ТОЧНЕЕ, ПРЕДПИСАНО НЕ ПОЯВЛЯТЬСЯ. А ЧТО В ЭТОЙ
Dialogue: 0,0:13:05.83,0:13:09.75,Caption,,0,0,0,,СИСТЕМЕ ПОЛУЧАЕТ РОССИЯ, НЕ СФОРМУЛИРОВАНО. ИМЕННО ЗДЕСЬ
Dialogue: 0,0:13:09.75,0:13:13.01,Caption,,0,0,0,,НАХОДИТСЯ СЛАБОЕ МЕСТО ВСЕЙ КОНСТРУКЦИИ. ЕСЛИ ОДНОЙ
Dialogue: 0,0:13:13.01,0:13:15.72,Caption,,0,0,0,,СТОРОНЕ ПОДРОБНО ОБЕЩАЮТ ХОРОШЕЕ БУДУЩЕЕ,
Dialogue: 0,0:13:16.12,0:13:17.72,Caption,,0,0,0,,А ВТОРОЙ ПРЕДЛАГАЮТ ЛИШЬ ПОВЕРИТЬ,
Dialogue: 0,0:13:17.88,0:13:19.80,Caption,,0,0,0,,ЧТО ПРОТИВ НЕЁ НИЧЕГО НЕ ЗАМЫШЛЯЮТ,
Dialogue: 0,0:13:20.20,0:13:22.33,Caption,,0,0,0,,УСТОЙЧИВОГО СОГЛАШЕНИЯ НЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:13:22.33,0:13:25.24,Caption,,0,0,0,,НАЗВАТЬ ПРОЕКТ МОЖНО КАК УГОДНО. НО ДОМ,
Dialogue: 0,0:13:25.47,0:13:27.16,Caption,,0,0,0,,ГДЕ РАСПИСАЛИ УДОБСТВА ДЛЯ ВСЕХ
Dialogue: 0,0:13:27.16,0:13:30.69,Caption,,0,0,0,,ЖИЛЬЦОВ И ЗАБЫЛИ УКАЗАТЬ, ЗАЧЕМ В НЁМ ЖИТЬ ОДНОМУ ИЗ ГЛАВНЫХ
Dialogue: 0,0:13:30.69,0:13:33.22,Caption,,0,0,0,,ВЛАДЕЛЬЦЕВ, ДОЛГО НЕ ПРОСТОИТ. НАПИШИТЕ В
Dialogue: 0,0:13:33.22,0:13:35.96,Caption,,0,0,0,,КОММЕНТАРИЯХ, ЧТО, ПО ВАШЕМУ МНЕНИЮ,
Dialogue: 0,0:13:36.23,0:13:40.39,Caption,,0,0,0,,ДОЛЖНА ПОЛУЧИТЬ РОССИЯ, ЧТОБЫ НОВАЯ СИСТЕМА БЕЗОПАСНОСТИ БЫЛА
Dialogue: 0,0:13:40.39,0:13:43.12,Caption,,0,0,0,,СОГЛАШЕНИЕМ, А НЕ ОЧЕРЕДНЫМ ПЕРЕЧНЕМ ЧУЖИХ
Dialogue: 0,0:13:43.12,0:13:46.89,Caption,,0,0,0,,ПОЖЕЛАНИЙ. И ПОДПИШИТЕСЬ,
Dialogue: 0,0:13:46.99,0:13:49.05,Caption,,0,0,0,,ПОТОМУ ЧТО НАСТОЯЩИЕ ПЕРЕГОВОРЫ
Dialogue: 0,0:13:49.05,0:13:52.54,Caption,,0,0,0,,НАЧИНАЮТСЯ КАК РАЗ ТАМ, ГДЕ ЗАКАНЧИВАЮТСЯ КРАСИВЫЕ
Dialogue: 0,0:13:52.54,0:13:53.37,Caption,,0,0,0,,ФОРМУЛИРОВКИ.
