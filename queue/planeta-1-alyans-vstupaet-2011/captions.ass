Dialogue: 0,0:00:00.04,0:00:02.28,Caption,,0,0,0,,У НЕКОТОРЫХ РУКОВОДИТЕЛЕЙ ХРАБРОСТЬ РАСТЁТ В
Dialogue: 0,0:00:02.28,0:00:05.24,Caption,,0,0,0,,ОБРАТНОЙ ЗАВИСИМОСТИ ОТ РАЗМЕРА СТРАНЫ. ТЕРРИТОРИЯ
Dialogue: 0,0:00:05.24,0:00:08.60,Caption,,0,0,0,,ПОМЕЩАЕТСЯ НА ЛАДОНИ, ЗАТО ЗАЯВЛЕНИЯ ЗВУЧАТ ТАК,
Dialogue: 0,0:00:08.86,0:00:12.04,Caption,,0,0,0,,СЛОВНО ЗА СПИНОЙ ЛЕЖИТ ЕЩЁ ОДИН ЗАПАСНОЙ КОНТИНЕНТ.
Dialogue: 0,0:00:12.65,0:00:15.16,Caption,,0,0,0,,ТОЛЬКО БОЛЬШАЯ ВОЙНА НЕ ЗАКОНЧИТСЯ ДЛЯ НИХ ПОТЕРЕЙ
Dialogue: 0,0:00:15.16,0:00:18.36,Caption,,0,0,0,,КРЕСЛА ИЛИ НЕУДАЧНЫМ ВЫСТУПЛЕНИЕМ НА ВЫБОРАХ. ОНА
Dialogue: 0,0:00:18.44,0:00:21.24,Caption,,0,0,0,,МОЖЕТ ЗАКОНЧИТЬСЯ ИСЧЕЗНОВЕНИЕМ САМОГО ГОСУДАРСТВА.
Dialogue: 0,0:00:21.46,0:00:24.20,Caption,,0,0,0,,ОНИ ЭТО ЗНАЮТ. И ВСЁ РАВНО ПОДНИМАЮТ СТАВКИ.
Dialogue: 0,0:00:24.50,0:00:28.28,Caption,,0,0,0,,ЗНАЧИТ, КТО ТО УБЕДИЛ ИХ, ЧТО СЧЁТ В КОНЦЕ ПРИНЕСУТ НЕ ИМ.
Dialogue: 0,0:00:29.30,0:00:32.04,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ ОТДЕЛЬНЫЕ ВЫКРИКИ У МИКРОФОНА,
Dialogue: 0,0:00:32.35,0:00:34.12,Caption,,0,0,0,,А ОБЩАЯ КАРТИНА ПРОИСХОДЯЩЕГО,
Dialogue: 0,0:00:34.36,0:00:37.32,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ ДЕТАЛИ НАЧИНАЮТ ГОВОРИТЬ
Dialogue: 0,0:00:37.40,0:00:40.44,Caption,,0,0,0,,НАМНОГО ГРОМЧЕ ЧИНОВНИКОВ. ПЕРВОЙ В ЭТОЙ КАРТИНЕ
Dialogue: 0,0:00:40.44,0:00:43.72,Caption,,0,0,0,,СТОИТ ФРАНЦИЯ. МИНИСТР ИНОСТРАННЫХ ДЕЛ ЖАН НОЭЛЬ
Dialogue: 0,0:00:43.80,0:00:49.00,Caption,,0,0,0,,БАРРО ПУБЛИЧНО ПРИЗНАЛ, ЧТО ФРАНЦУЗСКИЕ ВОЕННЫЕ СПЕЦИАЛИСТЫ УЖЕ РАБОТАЮТ НА
Dialogue: 0,0:00:49.00,0:00:51.32,Caption,,0,0,0,,УКРАИНЕ. ИНСТРУКТОРЫ ОБУЧАЮТ УКРАИНСКИХ
Dialogue: 0,0:00:51.32,0:00:54.76,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ, ТЕХНИЧЕСКИЙ ПЕРСОНАЛ ПОМОГАЕТ С ОБСЛУЖИВАНИЕМ
Dialogue: 0,0:00:54.76,0:00:57.24,Caption,,0,0,0,,ТЕХНИКИ. ЭТО НЕ СЛУХ ИЗ КОРИДОРА И НЕ
Dialogue: 0,0:00:57.24,0:01:00.20,Caption,,0,0,0,,ПЕРЕСКАЗ АНОНИМНОГО СОБЕСЕДНИКА. О ПРИСУТСТВИИ
Dialogue: 0,0:01:00.20,0:01:02.28,Caption,,0,0,0,,ФРАНЦУЗОВ СООБЩИЛ ГЛАВА ФРАНЦУЗСКОГО
Dialogue: 0,0:01:02.28,0:01:04.76,Caption,,0,0,0,,ВНЕШНЕПОЛИТИЧЕСКОГО ВЕДОМСТВА. ПАРИЖ ПРИ ЭТОМ
Dialogue: 0,0:01:04.76,0:01:08.76,Caption,,0,0,0,,УВЕРЯЕТ, ЧТО УЧАСТНИКОМ КОНФЛИКТА ФРАНЦИЯ НЕ СТАЛА. ВОЕННЫХ
Dialogue: 0,0:01:08.76,0:01:11.72,Caption,,0,0,0,,ТАМ НЕМНОГО, ОТ ПЕРЕДОВОЙ ОНИ НАХОДЯТСЯ ДАЛЕКО,
Dialogue: 0,0:01:11.88,0:01:13.88,Caption,,0,0,0,,НЕПОСРЕДСТВЕННО В БОЯХ НЕ УЧАСТВУЮТ.
Dialogue: 0,0:01:16.16,0:01:18.88,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ КОНСТРУКЦИЯ. ФРАНЦУЗСКИЙ
Dialogue: 0,0:01:18.88,0:01:21.60,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИЙ ПРИЕЗЖАЕТ В ВОЮЮЩУЮ СТРАНУ,
Dialogue: 0,0:01:21.81,0:01:25.04,Caption,,0,0,0,,ГОТОВИТ ЕЁ АРМИЮ И ОБСЛУЖИВАЕТ ЕЁ ВООРУЖЕНИЕ,
Dialogue: 0,0:01:25.36,0:01:27.84,Caption,,0,0,0,,НО ЕГО ГОСУДАРСТВО К ВОЙНЕ ОТНОШЕНИЯ НЕ ИМЕЕТ.
Dialogue: 0,0:01:28.16,0:01:30.88,Caption,,0,0,0,,ВИДИМО, УЧАСТИЕ НАЧИНАЕТСЯ ТОЛЬКО ПОСЛЕ ТОГО,
Dialogue: 0,0:01:31.04,0:01:34.24,Caption,,0,0,0,,КАК ИНСТРУКТОРУ ВЫДАДУТ СПРАВКУ С ПЕЧАТЬЮ И ПОПРОСЯТ
Dialogue: 0,0:01:34.24,0:01:37.20,Caption,,0,0,0,,РАСПИСАТЬСЯ В ТРЁХ ЭКЗЕМПЛЯРАХ. САМО НАЛИЧИЕ
Dialogue: 0,0:01:37.20,0:01:40.08,Caption,,0,0,0,,ФРАНЦУЗСКИХ СПЕЦИАЛИСТОВ ДАВНО НИКОГО НЕ УДИВЛЯЛО.
Dialogue: 0,0:01:40.38,0:01:43.68,Caption,,0,0,0,,СВЕДЕНИЯ ОБ ИНСТРУКТОРАХ ПОЯВЛЯЛИСЬ И РАНЬШЕ. РАДИО
Dialogue: 0,0:01:43.68,0:01:46.08,Caption,,0,0,0,,RFI РАССКАЗЫВАЛО О МИССИИ VOLIA,
Dialogue: 0,0:01:46.24,0:01:48.64,Caption,,0,0,0,,ДЕЙСТВУЮЩЕЙ С ЛЕТА, И О НЕБОЛЬШИХ ГРУППАХ,
Dialogue: 0,0:01:48.87,0:01:51.60,Caption,,0,0,0,,ПРИЕЗЖАВШИХ ДЛЯ КОРОТКИХ ЗАДАНИЙ. ФРАНЦУЗСКИЕ
Dialogue: 0,0:01:51.60,0:01:56.32,Caption,,0,0,0,,ДЕПУТАТЫ, КАК СООБЩАЛОСЬ, О РАЗВЁРТЫВАНИИ ЭТОЙ РАБОТЫ ДАЖЕ НЕ ЗНАЛИ. ОЧЕНЬ
Dialogue: 0,0:01:56.32,0:01:59.36,Caption,,0,0,0,,УДОБНАЯ МОДЕЛЬ УПРАВЛЕНИЯ. ВОЕННЫЕ УЖЕ ОТПРАВЛЕНЫ,
Dialogue: 0,0:01:59.60,0:02:04.00,Caption,,0,0,0,,А ПАРЛАМЕНТУ НОВОСТЬ СООБЩАТ, КОГДА ОН СЛУЧАЙНО СПРОСИТ. В ЭТОЙ ЖЕ СХЕМЕ
Dialogue: 0,0:02:04.00,0:02:08.48,Caption,,0,0,0,,ФИГУРИРОВАЛА МИССИЯ GERFAUT, ОФИЦИАЛЬНО РАЗМЕЩЁННАЯ В ПОЛЬШЕ. ЧЕРЕЗ НЕЁ
Dialogue: 0,0:02:08.48,0:02:11.04,Caption,,0,0,0,,ОБЕСПЕЧИВАЛОСЬ ФРАНЦУЗСКОЕ ПРИСУТСТВИЕ НА УКРАИНСКОЙ
Dialogue: 0,0:02:11.04,0:02:16.08,Caption,,0,0,0,,ТЕРРИТОРИИ. ЗНАЧИТ, МЕХАНИЗМ ПОЯВИЛСЯ НЕ ПОСЛЕ СЛОВ БАРРО И РАБОТАЛ
Dialogue: 0,0:02:16.08,0:02:18.96,Caption,,0,0,0,,НЕ ПЕРВЫЙ ДЕНЬ. ИЗМЕНИЛОСЬ ОТНОШЕНИЕ К ОГЛАСКЕ.
Dialogue: 0,0:02:19.33,0:02:21.84,Caption,,0,0,0,,РАНЬШЕ ВОКРУГ ЭТОЙ ТЕМЫ СТАРАЛИСЬ СТУПАТЬ ТИХО,
Dialogue: 0,0:02:22.01,0:02:24.48,Caption,,0,0,0,,СЛОВНО НОЧЬЮ МИМО КОМНАТЫ СТРОГОГО ОТЦА.
Dialogue: 0,0:02:26.77,0:02:29.33,Caption,,0,0,0,,ТЕПЕРЬ МИНИСТР ПОДТВЕРЖДАЕТ ВСЁ ОТКРЫТО И СРАЗУ
Dialogue: 0,0:02:29.33,0:02:33.01,Caption,,0,0,0,,ОБЪЯСНЯЕТ, ПОЧЕМУ ФРАНЦУЗСКИЕ ВОЕННЫЕ НА УКРАИНЕ ВСЁ РАВНО НЕ
Dialogue: 0,0:02:33.01,0:02:36.21,Caption,,0,0,0,,ОЗНАЧАЮТ УЧАСТИЯ ФРАНЦИИ В ВОЙНЕ. СПОР,
Dialogue: 0,0:02:36.29,0:02:40.53,Caption,,0,0,0,,ТАКИМ ОБРАЗОМ, ПЕРЕЕХАЛ. УЖЕ ОБСУЖДАЮТ НЕ НАЛИЧИЕ СПЕЦИАЛИСТОВ,
Dialogue: 0,0:02:40.77,0:02:44.05,Caption,,0,0,0,,А ПОДХОДЯЩЕЕ НАЗВАНИЕ ДЛЯ ИХ РАБОТЫ. КОГДА ФАКТ
Dialogue: 0,0:02:44.13,0:02:48.53,Caption,,0,0,0,,ОТРИЦАТЬ НЕУДОБНО, НАЧИНАЕТСЯ СОРЕВНОВАНИЕ ТЕРМИНОВ. ФОРМА НА ЧЕЛОВЕКЕ
Dialogue: 0,0:02:48.53,0:02:53.09,Caption,,0,0,0,,ТА ЖЕ, ТЕХНИКА ТА ЖЕ, ТЕРРИТОРИЯ ТА ЖЕ. МЕНЯЕТСЯ ТОЛЬКО СЛОВАРЬ,
Dialogue: 0,0:02:53.25,0:02:56.45,Caption,,0,0,0,,КОТОРЫМ ВСЁ ЭТО ПРИКРЫВАЮТ. ЕВРОПЕЙСКАЯ ПОДГОТОВКА К
Dialogue: 0,0:02:56.45,0:02:59.81,Caption,,0,0,0,,СТОЛКНОВЕНИЮ С РОССИЕЙ ИДЁТ ДАВНО. ЗАЯВЛЕНИЕ БАРРО
Dialogue: 0,0:02:59.89,0:03:02.45,Caption,,0,0,0,,ЛИШЬ ДОБАВИЛО ЕЩЁ ОДИН ОБОРОТ УЖЕ РАСКРУЧЕННОЙ
Dialogue: 0,0:03:02.53,0:03:05.01,Caption,,0,0,0,,ПРУЖИНЕ. УЧЕНИЯ СТАНОВЯТСЯ КРУПНЕЕ,
Dialogue: 0,0:03:05.25,0:03:08.13,Caption,,0,0,0,,СИЛЫ ПЕРЕМЕЩАЮТСЯ БЛИЖЕ К ВОСТОЧНОМУ НАПРАВЛЕНИЮ,
Dialogue: 0,0:03:08.37,0:03:11.73,Caption,,0,0,0,,ОБСУЖДАЮТСЯ КОНТИНГЕНТЫ, ЗВУЧИТ ЯДЕРНАЯ ТЕМА,
Dialogue: 0,0:03:11.97,0:03:16.45,Caption,,0,0,0,,ПОЛЬША УКРЕПЛЯЕТ СВОИ РУБЕЖИ, ФРАНЦИЯ РАСШИРЯЕТ ПРИСУТСТВИЕ. ТО,
Dialogue: 0,0:03:16.61,0:03:18.45,Caption,,0,0,0,,О ЧЁМ РАНЬШЕ ГОВОРИЛИ ВПОЛГОЛОСА,
Dialogue: 0,0:03:18.61,0:03:21.41,Caption,,0,0,0,,ТЕПЕРЬ ПРОИЗНОСЯТ С ТРИБУНЫ И СЧИТАЮТ ОБЫЧНЫМ ДЕЛОМ.
Dialogue: 0,0:03:21.70,0:03:23.73,Caption,,0,0,0,,СЛЕДОМ ПОЯВЛЯЕТСЯ ЭСТОНИЯ С ПЛАНОМ,
Dialogue: 0,0:03:24.05,0:03:26.61,Caption,,0,0,0,,КОТОРЫЙ ЗВУЧИТ ГОРАЗДО ЧЕСТНЕЕ БОДРЫХ ВЫСТУПЛЕНИЙ.
Dialogue: 0,0:03:27.09,0:03:29.73,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ ЦИФРОВЫЕ СИСТЕМЫ ГОТОВЯТ К РАБОТЕ ЗА
Dialogue: 0,0:03:29.73,0:03:32.85,Caption,,0,0,0,,ПРЕДЕЛАМИ СТРАНЫ. РЕЧЬ ИДЁТ НЕ О ЗАПАСНОЙ СТРАНИЦЕ
Dialogue: 0,0:03:32.85,0:03:35.81,Caption,,0,0,0,,МИНИСТЕРСТВА И НЕ О ПОЧТЕ ДЛЯ ЧИНОВНИКОВ. ЗА
Dialogue: 0,0:03:35.81,0:03:38.93,Caption,,0,0,0,,РУБЕЖОМ СОБИРАЮТСЯ ПОДДЕРЖИВАТЬ РЕЕСТРЫ НАСЕЛЕНИЯ,
Dialogue: 0,0:03:39.09,0:03:42.45,Caption,,0,0,0,,ЗЕМЛИ, НЕДВИЖИМОСТИ И ДРУГИЕ КЛЮЧЕВЫЕ БАЗЫ.
Dialogue: 0,0:03:44.72,0:03:49.52,Caption,,0,0,0,,ОНИ ДОЛЖНЫ СОХРАНИТЬСЯ, ЕСЛИ ЦЕНТРЫ ОБРАБОТКИ ДАННЫХ ВНУТРИ ЭСТОНИИ БУДУТ
Dialogue: 0,0:03:49.52,0:03:52.08,Caption,,0,0,0,,УНИЧТОЖЕНЫ ЛИБО ВЛАСТИ ПОТЕРЯЮТ КОНТРОЛЬ НАД
Dialogue: 0,0:03:52.08,0:03:55.44,Caption,,0,0,0,,ТЕРРИТОРИЕЙ. ТАЛЛИН ГОТОВИТ НЕ ТОЛЬКО ОБОРОНУ. ОН
Dialogue: 0,0:03:55.44,0:03:59.36,Caption,,0,0,0,,ЗАРАНЕЕ ПРОДУМЫВАЕТ, КАК ПРОДОЛЖИТЬ ГОСУДАРСТВЕННОЕ УПРАВЛЕНИЕ ПОСЛЕ
Dialogue: 0,0:03:59.36,0:04:02.56,Caption,,0,0,0,,ТОГО, КАК НОРМАЛЬНО УПРАВЛЯТЬ СОБСТВЕННОЙ СТРАНОЙ УЖЕ НЕ
Dialogue: 0,0:04:02.56,0:04:06.40,Caption,,0,0,0,,ПОЛУЧИТСЯ. ВОТ ВАМ И НАСТОЯЩАЯ ЦЕНА УВЕРЕННЫХ РЕЧЕЙ.
Dialogue: 0,0:04:06.80,0:04:08.88,Caption,,0,0,0,,ПОКА МИНИСТРЫ ИЗОБРАЖАЮТ НЕСГИБАЕМОСТЬ,
Dialogue: 0,0:04:09.18,0:04:11.76,Caption,,0,0,0,,СПЕЦИАЛИСТЫ ИЩУТ ДЛЯ ГОСУДАРСТВА РОЗЕТКУ В СОСЕДНЕМ
Dialogue: 0,0:04:11.76,0:04:16.16,Caption,,0,0,0,,ПОМЕЩЕНИИ. ПОДПИШИТЕСЬ, ЕСЛИ ВАМ НУЖЕН ИМЕННО ТАКОЙ ВЗГЛЯД. ПОТОМУ ЧТО
Dialogue: 0,0:04:16.16,0:04:19.36,Caption,,0,0,0,,ДАЛЬШЕ ГЕОГРАФИЯ ВЫХОДИТ К ДОСКЕ И БЕЗ ВСЯКОЙ
Dialogue: 0,0:04:19.36,0:04:22.24,Caption,,0,0,0,,ВЕЖЛИВОСТИ ПРОВЕРЯЕТ ДОМАШНЕЕ ЗАДАНИЕ ПРИБАЛТИЙСКИХ
Dialogue: 0,0:04:22.24,0:04:27.52,Caption,,0,0,0,,РУКОВОДИТЕЛЕЙ. ЭСТОНИЯ, ЛАТВИЯ И ЛИТВА НЕВЕЛИКИ И НАХОДЯТСЯ НЕПОСРЕДСТВЕННО
Dialogue: 0,0:04:27.60,0:04:30.64,Caption,,0,0,0,,У ЗОНЫ ВОЗМОЖНОГО СТОЛКНОВЕНИЯ РОССИИ С НАТО. В
Dialogue: 0,0:04:30.72,0:04:33.36,Caption,,0,0,0,,СЛУЧАЕ БОЛЬШОЙ ВОЙНЫ ОНИ НЕ СМОГУТ ПОСМОТРЕТЬ ПЕРВЫЕ
Dialogue: 0,0:04:33.36,0:04:36.40,Caption,,0,0,0,,СЕРИИ ПО ТЕЛЕВИЗОРУ, ОЦЕНИТЬ ОБСТАНОВКУ И РЕШИТЬ,
Dialogue: 0,0:04:36.52,0:04:39.36,Caption,,0,0,0,,УЧАСТВОВАТЬ ИМ ИЛИ НЕТ. ДЛЯ НИХ ВСЁ НАЧНЁТСЯ
Dialogue: 0,0:04:39.36,0:04:42.48,Caption,,0,0,0,,СРАЗУ И РЯДОМ. НИ ОДИН РУКОВОДИТЕЛЬ ЭТИХ СТРАН
Dialogue: 0,0:04:42.64,0:04:45.60,Caption,,0,0,0,,НЕ СПОСОБЕН ЭТОГО НЕ ПОНИМАТЬ. ЭСТОНСКИЙ ПЛАН
Dialogue: 0,0:04:45.60,0:04:48.08,Caption,,0,0,0,,ВЫНЕСТИ ЧАСТЬ УПРАВЛЕНИЯ ЗА ГРАНИЦУ ДОКАЗЫВАЕТ,
Dialogue: 0,0:04:48.40,0:04:51.68,Caption,,0,0,0,,ЧТО МАСШТАБ УГРОЗЫ ТАМ ОСОЗНАЮТ ПРЕКРАСНО. ОНИ УЖЕ
Dialogue: 0,0:04:51.68,0:04:54.72,Caption,,0,0,0,,РАССЧИТЫВАЮТ, ГДЕ БУДУТ ЛЕЖАТЬ ГОСУДАРСТВЕННЫЕ БАЗЫ,
Dialogue: 0,0:04:54.96,0:04:57.68,Caption,,0,0,0,,ЕСЛИ СОБСТВЕННАЯ ИНФРАСТРУКТУРА ПЕРЕСТАНЕТ РАБОТАТЬ.
Dialogue: 0,0:04:59.95,0:05:04.43,Caption,,0,0,0,,НО ВЕДУТ СЕБЯ ПРИ ЭТОМ ТАК, БУДТО В КЛАДОВОЙ ДЕЙСТВИТЕЛЬНО СТОЯТ ЕЩЁ ДВЕ
Dialogue: 0,0:05:04.43,0:05:08.19,Caption,,0,0,0,,ЭСТОНИИ, АККУРАТНО УПАКОВАННЫЕ НА СЛУЧАЙ ПОВРЕЖДЕНИЯ ПЕРВОЙ.
Dialogue: 0,0:05:08.76,0:05:12.75,Caption,,0,0,0,,ОТСЮДА ВОЗНИКАЕТ ВОПРОС, ОТ КОТОРОГО НЕ СПРЯЧЕШЬСЯ ЗА ОЧЕРЕДНОЙ РЕЧЬЮ О
Dialogue: 0,0:05:12.75,0:05:16.51,Caption,,0,0,0,,ЕДИНСТВЕ. ОНИ РЕШИЛИ СОВЕРШИТЬ КОЛЛЕКТИВНОЕ САМОУБИЙСТВО ОБ
Dialogue: 0,0:05:16.51,0:05:20.27,Caption,,0,0,0,,РОССИЮ? ПРИ ПРЯМОЙ ВОЙНЕ РАЗГОВОР ПОЙДЁТ НЕ О СНИЖЕНИИ
Dialogue: 0,0:05:20.27,0:05:25.15,Caption,,0,0,0,,ЭКОНОМИКИ НА ПАРУ ПРОЦЕНТОВ, СМЕНЕ ПРАВИТЕЛЬСТВА ИЛИ РЕМОНТЕ ЭЛЕКТРОСТАНЦИИ. ВСЁ
Dialogue: 0,0:05:25.23,0:05:27.71,Caption,,0,0,0,,БУДЕТ НАМНОГО ГРУБЕЕ. СТРАНЫ МОЖЕТ ПРОСТО НЕ
Dialogue: 0,0:05:27.71,0:05:30.75,Caption,,0,0,0,,ОСТАТЬСЯ. А ВМЕСТО НЕЁ НА КАРТЕ ОКАЖЕТСЯ БОЛЬШАЯ
Dialogue: 0,0:05:30.75,0:05:34.35,Caption,,0,0,0,,ДЫРКА, КОТОРУЮ УЖЕ НЕКОМУ БУДЕТ ЗАНОСИТЬ В ЗАРУБЕЖНЫЙ
Dialogue: 0,0:05:34.35,0:05:37.31,Caption,,0,0,0,,РЕЕСТР НЕДВИЖИМОСТИ. ИМЕННО С ТАКИМ УРОВНЕМ
Dialogue: 0,0:05:37.39,0:05:39.95,Caption,,0,0,0,,ПОСЛЕДСТВИЙ ОНИ ИГРАЮТ. СОБСТВЕННАЯ СИЛА
Dialogue: 0,0:05:39.95,0:05:42.91,Caption,,0,0,0,,ПРИБАЛТИЙСКИХ ГОСУДАРСТВ НЕСОИЗМЕРИМА С ВЕЛИЧИНОЙ
Dialogue: 0,0:05:42.91,0:05:45.47,Caption,,0,0,0,,СТАВОК. ИХ НАПОР ДЕРЖИТСЯ НА УБЕЖДЕНИИ,
Dialogue: 0,0:05:45.62,0:05:48.27,Caption,,0,0,0,,ЧТО В РЕШАЮЩИЙ МОМЕНТ ЗА НИХ ПОЛЕЗУТ ОСТАЛЬНЫЕ
Dialogue: 0,0:05:48.27,0:05:52.11,Caption,,0,0,0,,СОЮЗНИКИ. НО ПЯТАЯ СТАТЬЯ НАТО НЕ СНАБЖЕНА КОЛЁСАМИ.
Dialogue: 0,0:05:52.35,0:05:54.59,Caption,,0,0,0,,ОНА НЕ ОТВЕЗЁТ ТАЛЛИН ПОДАЛЬШЕ ОТ РОССИЙСКОЙ
Dialogue: 0,0:05:54.59,0:05:58.35,Caption,,0,0,0,,ГРАНИЦЫ, НЕ ПОСТАВИТ ГЕРМАНИЮ ПЕРЕД ВИЛЬНЮСОМ И НЕ ПЕРЕНЕСЁТ
Dialogue: 0,0:05:58.35,0:06:01.47,Caption,,0,0,0,,РИГУ НА БЕРЕГ ОКЕАНА. САММИТ МОЖЕТ ПРИНЯТЬ ЛЮБОЕ
Dialogue: 0,0:06:01.47,0:06:04.11,Caption,,0,0,0,,РЕШЕНИЕ. КАРТА ПОД НИМ НЕ СДВИНЕТСЯ НИ НА
Dialogue: 0,0:06:04.11,0:06:07.07,Caption,,0,0,0,,САНТИМЕТР. НА ЭТОМ ФОНЕ ИСТОРИЯ С ПРЕДПРИЯТИЕМ
Dialogue: 0,0:06:07.15,0:06:10.03,Caption,,0,0,0,,THREOD SYSTEMS ВЫГЛЯДИТ ОСОБЕННО ПОКАЗАТЕЛЬНО. НА
Dialogue: 0,0:06:10.03,0:06:12.35,Caption,,0,0,0,,ЗАВОДЕ, ВЫПУСКАЮЩЕМ БЕСПИЛОТНИКИ,
Dialogue: 0,0:06:12.59,0:06:14.59,Caption,,0,0,0,,ПОПЫТАЛИСЬ УСТРОИТЬ ВЗРЫВ И ПОДЖОГ.
Dialogue: 0,0:06:16.88,0:06:19.28,Caption,,0,0,0,,ПОДОЗРЕВАЕМЫХ ЗАДЕРЖАЛИ. ЭСТОНСКАЯ СЛУЖБА
Dialogue: 0,0:06:19.28,0:06:22.64,Caption,,0,0,0,,БЕЗОПАСНОСТИ ЗАЯВИЛА О СВЯЗИ НАПАДЕНИЯ С РОССИЙСКИМИ
Dialogue: 0,0:06:22.64,0:06:27.68,Caption,,0,0,0,,СПЕЦСЛУЖБАМИ И ПРЕДУПРЕДИЛА, ЧТО ИНТЕРЕС НЕ ОГРАНИЧИВАЕТСЯ ОДНОЙ КОМПАНИЕЙ. ПО
Dialogue: 0,0:06:27.68,0:06:31.28,Caption,,0,0,0,,ОЦЕНКЕ КОНТРРАЗВЕДКИ, ВНИМАНИЕ МОГУТ ПРИВЛЕКАТЬ ПРИМЕРНО ДЕСЯТЬ
Dialogue: 0,0:06:31.28,0:06:34.16,Caption,,0,0,0,,ПРЕДПРИЯТИЙ ОБОРОННОЙ ОТРАСЛИ. ПОЛУЧАЕТСЯ УЖЕ НЕ
Dialogue: 0,0:06:34.16,0:06:36.16,Caption,,0,0,0,,ОДИНОЧНЫЙ ЭПИЗОД У ОДНОГО ЗАБОРА,
Dialogue: 0,0:06:36.48,0:06:39.28,Caption,,0,0,0,,А ЦЕЛАЯ ГРУППА ПОТЕНЦИАЛЬНЫХ ЦЕЛЕЙ. ПОСЛЕ ЭТОГО
Dialogue: 0,0:06:39.36,0:06:42.08,Caption,,0,0,0,,ПРЕМЬЕР КРИСТЕН МИХАЛ ПОРУЧИЛ ГОТОВИТЬСЯ К ЗАКРЫТИЮ
Dialogue: 0,0:06:42.08,0:06:43.76,Caption,,0,0,0,,СУХОПУТНЫХ ПЕРЕХОДОВ С РОССИЕЙ.
Dialogue: 0,0:06:44.32,0:06:47.04,Caption,,0,0,0,,ОТВЕТ ВЫГЛЯДИТ ВНУШИТЕЛЬНО И ДЛЯ ЗАГОЛОВКА ПОДХОДИТ
Dialogue: 0,0:06:47.04,0:06:50.16,Caption,,0,0,0,,ПРЕКРАСНО. ЕСТЬ НАПАДЕНИЕ, ЕСТЬ ГРАНИЦА,
Dialogue: 0,0:06:50.41,0:06:53.12,Caption,,0,0,0,,ГРАНИЦУ ЗАКРЫВАЕМ. ОСТАЛОСЬ ТОЛЬКО ОБЪЯСНИТЬ,
Dialogue: 0,0:06:53.36,0:06:56.16,Caption,,0,0,0,,КАКИМ ОБРАЗОМ ШЛАГБАУМ ОСТАНОВИТ ЧЕЛОВЕКА,
Dialogue: 0,0:06:56.34,0:06:59.60,Caption,,0,0,0,,КОТОРЫЙ УЖЕ НАХОДИТСЯ ВНУТРИ СТРАНЫ. ЭТУ НЕУДОБНУЮ
Dialogue: 0,0:06:59.68,0:07:03.04,Caption,,0,0,0,,ЧАСТЬ ПРОИЗНЕСЛА ПРЕЗИДЕНТ ЮЛЛЕ МАДИЗЕ. ОНА ЗАЯВИЛА,
Dialogue: 0,0:07:03.24,0:07:06.16,Caption,,0,0,0,,ЧТО ЗАКРЫТИЕ ГРАНИЦЫ НЕ ПРЕДОТВРАТИЛО БЫ НАПАДЕНИЯ
Dialogue: 0,0:07:06.24,0:07:10.64,Caption,,0,0,0,,НИ НА THREOD SYSTEMS, НИ НА ДРУГИЕ ОБОРОННЫЕ ПРЕДПРИЯТИЯ. ТО ЕСТЬ ВЛАСТИ
Dialogue: 0,0:07:10.64,0:07:14.08,Caption,,0,0,0,,ПРЕДЛАГАЮТ МЕРУ, А ГЛАВА ГОСУДАРСТВА СРАЗУ СООБЩАЕТ,
Dialogue: 0,0:07:14.31,0:07:17.60,Caption,,0,0,0,,ЧТО ПРОТИВ ОПИСАННОЙ УГРОЗЫ ОНА НЕ СРАБОТАЕТ. РЕДКИЙ
Dialogue: 0,0:07:17.60,0:07:21.12,Caption,,0,0,0,,СЛУЧАЙ, КОГДА ИНСТРУКЦИЯ ПО ПРИМЕНЕНИЮ ЧЕСТНО ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:07:21.29,0:07:23.76,Caption,,0,0,0,,ЧТО ЛЕКАРСТВО ПРЕДНАЗНАЧЕНО СОВСЕМ НЕ ОТ ЭТОЙ
Dialogue: 0,0:07:23.76,0:07:26.96,Caption,,0,0,0,,БОЛЕЗНИ. ЗАТО ПОСЛЕДСТВИЯ ДЛЯ ОБЫЧНЫХ ЛЮДЕЙ БУДУТ
Dialogue: 0,0:07:26.96,0:07:31.89,Caption,,0,0,0,,ВПОЛНЕ НАСТОЯЩИМИ. ЧЕРЕЗ ПЕРЕХОДЫ ЕЗДЯТ ТЕ,
Dialogue: 0,0:07:32.03,0:07:34.21,Caption,,0,0,0,,У КОГО НА ДРУГОЙ СТОРОНЕ ЖИВУТ РОДИТЕЛИ,
Dialogue: 0,0:07:34.29,0:07:37.73,Caption,,0,0,0,,ДЕТИ И ДРУГИЕ РОДСТВЕННИКИ. ИХ ПОЕЗДКИ ПРЕКРАТЯТСЯ
Dialogue: 0,0:07:37.73,0:07:41.33,Caption,,0,0,0,,СРАЗУ. УГРОЗА ОБОРОННЫМ ПРЕДПРИЯТИЯМ ПРИ ЭТОМ НИКУДА НЕ
Dialogue: 0,0:07:41.33,0:07:44.21,Caption,,0,0,0,,ДЕНЕТСЯ. ДЛЯ ПУБЛИКИ ПОЛУЧИТСЯ ГРОМКИЙ ХЛОПОК
Dialogue: 0,0:07:44.29,0:07:46.93,Caption,,0,0,0,,ДВЕРЬЮ. ДЛЯ БЕЗОПАСНОСТИ ОСТАНЕТСЯ ВОПРОС,
Dialogue: 0,0:07:47.25,0:07:50.53,Caption,,0,0,0,,НА КОТОРЫЙ ЗАКРЫТАЯ ДВЕРЬ ОТВЕТА НЕ ДАЁТ. ЛИТВА
Dialogue: 0,0:07:50.63,0:07:53.33,Caption,,0,0,0,,УЖЕ ПРИСМАТРИВАЕТСЯ К ТОМУ ЖЕ РЕШЕНИЮ. ГИТАНАС
Dialogue: 0,0:07:53.33,0:07:56.61,Caption,,0,0,0,,НАУСЕДА ДОПУСТИЛ ЗАКРЫТИЕ ГРАНИЦЫ С РОССИЕЙ ВСЛЕД ЗА
Dialogue: 0,0:07:56.61,0:07:59.81,Caption,,0,0,0,,ЭСТОНИЕЙ. НО У ВИЛЬНЮСА ИМЕЕТСЯ КАЛИНИНГРАДСКИЙ
Dialogue: 0,0:07:59.81,0:08:03.81,Caption,,0,0,0,,ТРАНЗИТ, И ОН МГНОВЕННО ПРЕВРАЩАЕТ ЭФФЕКТНУЮ ФРАЗУ В ПАЧКУ
Dialogue: 0,0:08:03.81,0:08:07.01,Caption,,0,0,0,,НЕПРИЯТНЫХ ЗАДАЧ. НЕЛЬЗЯ ПРОСТО ПОВЕРНУТЬ КЛЮЧ И
Dialogue: 0,0:08:07.01,0:08:10.85,Caption,,0,0,0,,СЧИТАТЬ, ЧТО ВСЁ ЗА СТЕНОЙ ИСЧЕЗЛО. ОСТАЮТСЯ МАРШРУТЫ,
Dialogue: 0,0:08:11.01,0:08:13.25,Caption,,0,0,0,,СОГЛАШЕНИЯ И РОССИЙСКИЙ РЕГИОН,
Dialogue: 0,0:08:13.40,0:08:15.57,Caption,,0,0,0,,СООБЩЕНИЕ С КОТОРЫМ ПРОХОДИТ ЧЕРЕЗ ЛИТОВСКУЮ
Dialogue: 0,0:08:15.65,0:08:18.21,Caption,,0,0,0,,ТЕРРИТОРИЮ. КАЛИНИНГРАД ВООБЩЕ СТАНОВИТСЯ ОДНИМ ИЗ
Dialogue: 0,0:08:18.21,0:08:21.25,Caption,,0,0,0,,САМЫХ ЧУВСТВИТЕЛЬНЫХ УЧАСТКОВ ЭТОЙ ИСТОРИИ. ПОЛЬША
Dialogue: 0,0:08:21.25,0:08:24.53,Caption,,0,0,0,,УСИЛИВАЕТ МЕРЫ НА ЭТОМ НАПРАВЛЕНИИ. ГАЗЕТА
Dialogue: 0,0:08:24.53,0:08:27.41,Caption,,0,0,0,,RZECZPOSPOLITA СООБЩИЛА О ЯКОБЫ ГОТОВИВШЕЙСЯ
Dialogue: 0,0:08:27.41,0:08:30.53,Caption,,0,0,0,,РОССИЙСКОЙ ОПЕРАЦИИ ПОД ЧУЖИМ ФЛАГОМ. ПО ИЗЛОЖЕННОЙ
Dialogue: 0,0:08:30.61,0:08:33.81,Caption,,0,0,0,,ВЕРСИИ, УЧАСТНИКИ ДОЛЖНЫ БЫЛИ ВЫДАТЬ СЕБЯ ЗА УКРАИНСКИХ
Dialogue: 0,0:08:33.81,0:08:37.97,Caption,,0,0,0,,ДИВЕРСАНТОВ, ПЕРЕСЕЧЬ ГРАНИЦУ И СПРОВОЦИРОВАТЬ КРУПНУЮ ЭСКАЛАЦИЮ.
Dialogue: 0,0:08:38.25,0:08:40.85,Caption,,0,0,0,,ИСТОЧНИКИ ГОВОРИЛИ О РАСЧЁТЕ НА МНОГОЧИСЛЕННЫЕ
Dialogue: 0,0:08:40.85,0:08:43.81,Caption,,0,0,0,,ЖЕРТВЫ И О ПОПЫТКЕ УДАРИТЬ ПО ПОЛЬСКОЙ ПОДДЕРЖКЕ
Dialogue: 0,0:08:43.81,0:08:48.81,Caption,,0,0,0,,УКРАИНЫ. ПОЛЬСКОЕ УСИЛЕНИЕ У КАЛИНИНГРАДА ОТ ЭТОГО НЕ
Dialogue: 0,0:08:48.81,0:08:51.53,Caption,,0,0,0,,ИСЧЕЗАЕТ. ОНО СУЩЕСТВУЕТ В ОДНОЙ РЕАЛЬНОСТИ С
Dialogue: 0,0:08:51.53,0:08:55.77,Caption,,0,0,0,,ПОДДЕРЖКОЙ УКРАИНЫ, РАЗГОВОРАМИ О ЗАКРЫТИИ ПРИБАЛТИЙСКИХ ГРАНИЦ И
Dialogue: 0,0:08:55.85,0:08:58.81,Caption,,0,0,0,,ПРИЗНАНИЕМ ФРАНЦУЗСКОГО ВОЕННОГО ПРИСУТСТВИЯ. ЭТО НЕ
Dialogue: 0,0:08:58.89,0:09:03.77,Caption,,0,0,0,,НАБОР СЛУЧАЙНЫХ ЭПИЗОДОВ, РАССЫПАННЫХ ПО РАЗНЫМ СТРАНАМ. ПЕРЕД НАМИ ОЧЕРЕДНЫЕ
Dialogue: 0,0:09:03.85,0:09:08.33,Caption,,0,0,0,,ШАГИ ПРОЦЕССА, КОТОРЫЙ ДАВНО НАБИРАЕТ СКОРОСТЬ. ПРОСТО КАЖДОЕ
Dialogue: 0,0:09:08.33,0:09:10.65,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО КРУТИТ СВОЮ РУЧКУ И НАДЕЕТСЯ,
Dialogue: 0,0:09:10.80,0:09:13.53,Caption,,0,0,0,,ЧТО ОБЩИЙ МЕХАНИЗМ НЕ РВАНЁТ ИМЕННО ПРИ НЁМ.
Dialogue: 0,0:09:14.14,0:09:17.61,Caption,,0,0,0,,А ТЕПЕРЬ К ДЕНЬГАМ, ПОТОМУ ЧТО ОНИ УМЕЮТ ВОЗВРАЩАТЬ ТОРЖЕСТВЕННЫЕ
Dialogue: 0,0:09:17.69,0:09:20.17,Caption,,0,0,0,,ОБЕЩАНИЯ НА ЗЕМЛЮ БЫСТРЕЕ ЛЮБОГО АНАЛИТИКА.
Dialogue: 0,0:09:20.80,0:09:25.45,Caption,,0,0,0,,МАРК РЮТТЕ ПРИЗНАЛ, ЧТО СОЮЗНИКИ ПОКА НЕ СОБРАЛИ НЕСКОЛЬКО МИЛЛИАРДОВ ДО
Dialogue: 0,0:09:25.45,0:09:28.25,Caption,,0,0,0,,СОГЛАСОВАННОЙ ЦЕЛИ ВОЕННОЙ ПОМОЩИ УКРАИНЕ В
Dialogue: 0,0:09:28.25,0:09:31.69,Caption,,0,0,0,,СЕМЬДЕСЯТ МИЛЛИАРДОВ ДОЛЛАРОВ. ЗАКУПКИ АМЕРИКАНСКОГО
Dialogue: 0,0:09:31.77,0:09:34.89,Caption,,0,0,0,,ОРУЖИЯ НА ЕВРОПЕЙСКИЕ И КАНАДСКИЕ СРЕДСТВА СОСТАВИЛИ
Dialogue: 0,0:09:34.97,0:09:38.65,Caption,,0,0,0,,ОКОЛО ДЕСЯТИ МИЛЛИАРДОВ. РАНЕЕ НАЗЫВАЛСЯ ДИАПАЗОН ОТ
Dialogue: 0,0:09:38.65,0:09:40.65,Caption,,0,0,0,,ДВЕНАДЦАТИ ДО ПЯТНАДЦАТИ МИЛЛИАРДОВ,
Dialogue: 0,0:09:40.83,0:09:43.61,Caption,,0,0,0,,НО ТЕПЕРЬ РЮТТЕ ГОВОРИТ, ЧТО ЭТО БЫЛ ОРИЕНТИР,
Dialogue: 0,0:09:43.84,0:09:45.85,Caption,,0,0,0,,А РЕАЛЬНАЯ ПОТРЕБНОСТЬ ОКАЗАЛАСЬ НИЖЕ.
Dialogue: 0,0:09:46.40,0:09:49.13,Caption,,0,0,0,,С СЕМЬЮДЕСЯТЬЮ МИЛЛИАРДАМИ ТАКОЙ ФОКУС НЕ ПРОХОДИТ.
Dialogue: 0,0:09:49.37,0:09:54.01,Caption,,0,0,0,,ЭТА СУММА УЖЕ СОГЛАСОВАНА, А ДО НЕЁ ВСЁ ЕЩЁ НЕ ДОТЯНУЛИСЬ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:09:54.01,0:09:56.81,Caption,,0,0,0,,ЗНАКОМАЯ ЕВРОПЕЙСКАЯ КОНСТРУКЦИЯ. ИНСТРУКТОРОВ
Dialogue: 0,0:09:56.81,0:09:59.77,Caption,,0,0,0,,ОТПРАВИЛИ. ВОЗМОЖНОЕ ЗАКРЫТИЕ ГРАНИЦ ОБСУЖДАЮТ.
Dialogue: 0,0:10:02.03,0:10:04.35,Caption,,0,0,0,,СИСТЕМЫ УПРАВЛЕНИЯ НА СЛУЧАЙ ПОТЕРИ ТЕРРИТОРИИ
Dialogue: 0,0:10:04.35,0:10:08.11,Caption,,0,0,0,,ГОТОВЯТ. А У КАССЫ ВНЕЗАПНО НАЧИНАЕТСЯ ПОИСК МЕЛОЧИ
Dialogue: 0,0:10:08.19,0:10:10.67,Caption,,0,0,0,,ПО КАРМАНАМ. РЕШИТЕЛЬНОСТЬ ПРИБЫЛА ПЕРВОЙ,
Dialogue: 0,0:10:10.83,0:10:13.87,Caption,,0,0,0,,БУХГАЛТЕРИЯ ЗАДЕРЖИВАЕТСЯ. В ЭТОМ И СОСТОИТ ГЛАВНАЯ
Dialogue: 0,0:10:13.87,0:10:18.91,Caption,,0,0,0,,СТРАННОСТЬ ВЫБРАННОГО КУРСА. ПОДГОТОВКА СТАНОВИТСЯ ВСЁ МАТЕРИАЛЬНЕЕ. ЭТО УЖЕ
Dialogue: 0,0:10:18.91,0:10:21.95,Caption,,0,0,0,,ВОЕННЫЕ СПЕЦИАЛИСТЫ, ОБОРОННЫЕ ПРЕДПРИЯТИЯ,
Dialogue: 0,0:10:22.09,0:10:27.71,Caption,,0,0,0,,ЗАКРЫВАЕМЫЕ ПЕРЕХОДЫ, ЗАРУБЕЖНЫЕ СЕРВЕРЫ И МИЛЛИАРДЫ НА ОРУЖИЕ. САМЫЕ
Dialogue: 0,0:10:27.71,0:10:30.03,Caption,,0,0,0,,УЯЗВИМЫЕ СТРАНЫ ПРИ ЭТОМ ДЕРЖАТСЯ ТАК,
Dialogue: 0,0:10:30.27,0:10:33.23,Caption,,0,0,0,,СЛОВНО ИМ ВЫДАЛИ БЕЗЛИМИТНУЮ СТРАХОВКУ ОТ ИСТОРИИ.
Dialogue: 0,0:10:33.69,0:10:36.75,Caption,,0,0,0,,ХОТЯ ИХ СОБСТВЕННЫЕ ПЛАНЫ ПОКАЗЫВАЮТ ОБРАТНОЕ. ОНИ
Dialogue: 0,0:10:36.75,0:10:39.95,Caption,,0,0,0,,ЗАРАНЕЕ ДОПУСКАЮТ ПОТЕРЮ КОНТРОЛЯ НАД ТЕРРИТОРИЕЙ И
Dialogue: 0,0:10:39.95,0:10:42.75,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРОДОЛЖАЮТ ПОДТАЛКИВАТЬ СИТУАЦИЮ К
Dialogue: 0,0:10:42.75,0:10:46.19,Caption,,0,0,0,,ЧЕРТЕ, ЗА КОТОРОЙ ЭТОТ СЦЕНАРИЙ МОЖЕТ СТАТЬ РЕАЛЬНОСТЬЮ.
Dialogue: 0,0:10:46.48,0:10:49.63,Caption,,0,0,0,,ПОЭТОМУ К РУКОВОДИТЕЛЯМ СТРАН БАЛТИИ ОСТАЁТСЯ ПРЯМОЙ
Dialogue: 0,0:10:49.63,0:10:52.75,Caption,,0,0,0,,ВОПРОС. ЕСЛИ ВЫ ГОТОВИТЕ ГОСУДАРСТВЕННЫЕ СИСТЕМЫ К
Dialogue: 0,0:10:52.83,0:10:57.95,Caption,,0,0,0,,БЕГСТВУ ЗА ГРАНИЦУ, ЗНАЧИТ, ВЫ ОТЛИЧНО ПРЕДСТАВЛЯЕТЕ ВОЗМОЖНЫЙ ИТОГ. ЗАЧЕМ ТОГДА
Dialogue: 0,0:10:57.95,0:11:01.47,Caption,,0,0,0,,ПРОДОЛЖАТЬ ДЕЙСТВОВАТЬ ТАК, СЛОВНО ЦЕНУ ЗАПЛАТИТ КТО УГОДНО,
Dialogue: 0,0:11:01.70,0:11:03.87,Caption,,0,0,0,,ТОЛЬКО НЕ ВЫ? НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:11:04.04,0:11:07.23,Caption,,0,0,0,,НА ЧТО РАССЧИТАНА ЭТА УВЕРЕННОСТЬ. СОЮЗНИКИ МОГУТ
Dialogue: 0,0:11:07.23,0:11:10.67,Caption,,0,0,0,,ОБЕЩАТЬ ПОМОЩЬ, МИНИСТРЫ МОГУТ ПРОИЗНОСИТЬ ГРОЗНЫЕ РЕЧИ,
Dialogue: 0,0:11:10.91,0:11:13.95,Caption,,0,0,0,,А ЧИНОВНИКИ МОГУТ ЗАРАНЕЕ КОПИРОВАТЬ РЕЕСТРЫ. НО
Dialogue: 0,0:11:14.03,0:11:16.75,Caption,,0,0,0,,ПЕРВОЙ УДАР ПРИНИМАЕТ НЕ РЕЧЬ И НЕ СЕРВЕР.
Dialogue: 0,0:11:19.04,0:11:22.56,Caption,,0,0,0,,ПЕРВОЙ ЕГО ПРИНИМАЕТ СТРАНА, КОТОРАЯ СТОИТ БЛИЖЕ ВСЕХ.
