Dialogue: 0,0:00:00.04,0:00:03.16,Caption,,0,0,0,,О ВЕЛИКОМ БУДУЩЕМ ОБЫЧНО ГОВОРЯТ СО СЦЕНЫ. О
Dialogue: 0,0:00:03.24,0:00:06.52,Caption,,0,0,0,,ЦЕНЕ ЭТОГО БУДУЩЕГО ЧАЩЕ МОЛЧАТ. ВИДИМО,
Dialogue: 0,0:00:06.82,0:00:09.24,Caption,,0,0,0,,КАЛЬКУЛЯТОР ПЛОХО СОЧЕТАЕТСЯ С ТОРЖЕСТВЕННОЙ
Dialogue: 0,0:00:09.32,0:00:13.00,Caption,,0,0,0,,МУЗЫКОЙ. НО СТОИТ ОТКРЫТЬ ЕГО И ВВЕСТИ НЕСКОЛЬКО ЧИСЕЛ,
Dialogue: 0,0:00:13.32,0:00:15.56,Caption,,0,0,0,,КАК ВЕЛИЧИЕ ВНЕЗАПНО НАЧИНАЕТ ВЫГЛЯДЕТЬ НЕ
Dialogue: 0,0:00:15.56,0:00:19.56,Caption,,0,0,0,,ОБЕЩАНИЕМ, А СЧЁТОМ. ПРИЧЁМ ОПЛАЧИВАТЬ ЕГО БУДУТ НЕ ТЕ,
Dialogue: 0,0:00:19.72,0:00:22.44,Caption,,0,0,0,,КТО ПРОИЗНОСИТ РЕЧИ. УКРАИНСКИЙ ВОЛОНТЁР ГЕННАДИЙ
Dialogue: 0,0:00:22.44,0:00:25.48,Caption,,0,0,0,,ДРУЗЕНКО РЕШИЛ ОЦЕНИТЬ БЕЗВОЗВРАТНЫЕ ПОТЕРИ УКРАИНЫ
Dialogue: 0,0:00:25.48,0:00:28.44,Caption,,0,0,0,,ЧЕРЕЗ ДАННЫЕ ОДНОГО ГОРОДА. НЕ ЧЕРЕЗ ДОКЛАД
Dialogue: 0,0:00:28.44,0:00:31.40,Caption,,0,0,0,,МИНИСТЕРСТВА, НЕ ЧЕРЕЗ ТЕЛЕВИЗИОННУЮ ТАБЛИЦУ,
Dialogue: 0,0:00:31.64,0:00:34.76,Caption,,0,0,0,,А ЧЕРЕЗ ЛОЗОВУЮ В ХАРЬКОВСКОЙ ОБЛАСТИ. ДО НАЧАЛА
Dialogue: 0,0:00:34.76,0:00:37.40,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ В ЛОЗОВОЙ ПРОЖИВАЛИ ОКОЛО ПЯТИДЕСЯТИ
Dialogue: 0,0:00:37.40,0:00:40.28,Caption,,0,0,0,,ЧЕТЫРЁХ ТЫСЯЧ ЧЕЛОВЕК. НА ГОРОДСКОЙ АЛЛЕЕ ГЕРОЕВ
Dialogue: 0,0:00:40.28,0:00:43.00,Caption,,0,0,0,,ДРУЗЕНКО НАСЧИТАЛ ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ ФАМИЛИЙ
Dialogue: 0,0:00:43.00,0:00:46.60,Caption,,0,0,0,,ПОГИБШИХ ВОЕННОСЛУЖАЩИХ. ЕСЛИ ВАМ ИНТЕРЕСНЫ РАЗБОРЫ,
Dialogue: 0,0:00:46.68,0:00:49.64,Caption,,0,0,0,,ГДЕ ГРОМКИЕ ЗАЯВЛЕНИЯ ПРОВЕРЯЮТ ОБЫЧНОЙ АРИФМЕТИКОЙ,
Dialogue: 0,0:00:49.80,0:00:52.92,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ИНОГДА ОДИН ГОРОДСКОЙ СПИСОК СООБЩАЕТ О
Dialogue: 0,0:00:52.92,0:00:56.52,Caption,,0,0,0,,ПРОИСХОДЯЩЕМ БОЛЬШЕ, ЧЕМ ЦЕЛЫЙ ПАРАД ОФИЦИАЛЬНЫХ ВЫСТУПЛЕНИЙ.
Dialogue: 0,0:00:57.32,0:01:01.16,Caption,,0,0,0,,ПО СЛОВАМ ДРУЗЕНКО, НА АЛЛЕЕ ЕЩЁ НЕ УКАЗАНА ЧАСТЬ ПОГИБШИХ В
Dialogue: 0,0:01:01.24,0:01:03.72,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОМ ГОДУ. ТУДА ЖЕ НЕ
Dialogue: 0,0:01:03.72,0:01:06.76,Caption,,0,0,0,,ВХОДЯТ ПРОПАВШИЕ БЕЗ ВЕСТИ. ПОЭТОМУ ОКОНЧАТЕЛЬНОЕ
Dialogue: 0,0:01:06.76,0:01:09.24,Caption,,0,0,0,,ЧИСЛО ПО ЛОЗОВОЙ ОН ОЦЕНИВАЕТ КАК МИНИМУМ В
Dialogue: 0,0:01:09.24,0:01:15.28,Caption,,0,0,0,,ТРИСТА ЧЕЛОВЕК. ДЛЯ ГОРОДА С ДОВОЕННЫМ НАСЕЛЕНИЕМ В ПЯТЬДЕСЯТ ЧЕТЫРЕ
Dialogue: 0,0:01:15.28,0:01:18.32,Caption,,0,0,0,,ТЫСЯЧИ ЭТО БОЛЕЕ ПОЛОВИНЫ ПРОЦЕНТА ЖИТЕЛЕЙ.
Dialogue: 0,0:01:19.02,0:01:21.44,Caption,,0,0,0,,ЗАТЕМ ДРУЗЕНКО ПРИМЕНЯЕТ ТУ ЖЕ ДОЛЮ КО ВСЕЙ
Dialogue: 0,0:01:21.52,0:01:25.44,Caption,,0,0,0,,УКРАИНЕ, ГДЕ ДО БОЕВЫХ ДЕЙСТВИЙ ЖИЛИ ПРИМЕРНО СОРОК ОДИН
Dialogue: 0,0:01:25.52,0:01:28.48,Caption,,0,0,0,,С ПОЛОВИНОЙ МИЛЛИОН ЧЕЛОВЕК. ЕГО РАСЧЁТ ДАЁТ ОКОЛО
Dialogue: 0,0:01:28.48,0:01:31.44,Caption,,0,0,0,,ДВУХСОТ ТЫСЯЧ ПОГИБШИХ ВОЕННОСЛУЖАЩИХ. С УЧЁТОМ
Dialogue: 0,0:01:31.44,0:01:34.56,Caption,,0,0,0,,ПРОПАВШИХ БЕЗ ВЕСТИ ВОЗМОЖНАЯ ВЕЛИЧИНА БЕЗВОЗВРАТНЫХ
Dialogue: 0,0:01:34.56,0:01:39.20,Caption,,0,0,0,,ПОТЕРЬ, ПО ЕГО ОЦЕНКЕ, НАХОДИТСЯ МЕЖДУ ДВУМЯСТАМИ И ТРЕМЯСТАМИ ТЫСЯЧАМИ
Dialogue: 0,0:01:39.20,0:01:42.40,Caption,,0,0,0,,ЧЕЛОВЕК. ДРУЗЕНКО НЕ ВЫДАЁТ ЭТУ ЭКСТРАПОЛЯЦИЮ ЗА
Dialogue: 0,0:01:42.40,0:01:45.44,Caption,,0,0,0,,АКАДЕМИЧЕСКУЮ РАБОТУ. ОН ПРЯМО НАЗЫВАЕТ ЕЁ РАСЧЁТОМ
Dialogue: 0,0:01:45.52,0:01:48.72,Caption,,0,0,0,,С ДОПУЩЕНИЯМИ. ТОЛЬКО ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ ИМЁН В
Dialogue: 0,0:01:48.72,0:01:51.20,Caption,,0,0,0,,ОДНОМ НЕБОЛЬШОМ ГОРОДЕ ОТ ТАКОГО УТОЧНЕНИЯ НЕ
Dialogue: 0,0:01:51.20,0:01:54.24,Caption,,0,0,0,,РАСТВОРЯЮТСЯ. ТАБЛИЧКАМ НА АЛЛЕЕ ГЕРОЕВ ВСЁ РАВНО,
Dialogue: 0,0:01:54.36,0:01:57.44,Caption,,0,0,0,,НАСКОЛЬКО НАУЧНО ИХ ПЕРЕСЧИТАЛИ. СОТНИ ТЫСЯЧ ЛЕГКО
Dialogue: 0,0:01:57.44,0:02:00.40,Caption,,0,0,0,,ПРЕВРАЩАЮТСЯ В ШУМ. ЧЕЛОВЕК СЛЫШИТ ДВЕСТИ ТЫСЯЧ,
Dialogue: 0,0:02:00.64,0:02:03.04,Caption,,0,0,0,,МОРЩИТСЯ И ЧЕРЕЗ МИНУТУ УЖЕ ДУМАЕТ О ДРУГОМ.
Dialogue: 0,0:02:03.58,0:02:06.16,Caption,,0,0,0,,А ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ ФАМИЛИЙ В ЛОЗОВОЙ ЗВУЧАТ
Dialogue: 0,0:02:06.16,0:02:10.16,Caption,,0,0,0,,ИНАЧЕ, ПОТОМУ ЧТО У ЭТОГО ЧИСЛА ПОЯВЛЯЕТСЯ АДРЕС. ОДИН
Dialogue: 0,0:02:10.16,0:02:12.72,Caption,,0,0,0,,ГОРОД НЕ МОЖЕТ СЛУЖИТЬ ИДЕАЛЬНОЙ МОДЕЛЬЮ ДЛЯ ВСЕЙ
Dialogue: 0,0:02:12.72,0:02:16.00,Caption,,0,0,0,,СТРАНЫ. ЗАТО ОН ПОКАЗЫВАЕТ ЦЕНУ ПРОИСХОДЯЩЕГО БЕЗ
Dialogue: 0,0:02:16.00,0:02:18.96,Caption,,0,0,0,,УДОБНОЙ ДИСТАНЦИИ. ПЕРЕД ГЛАЗАМИ УЖЕ НЕ ПРОЦЕНТ ИЗ
Dialogue: 0,0:02:18.96,0:02:23.76,Caption,,0,0,0,,ОТЧЁТА, А КОНКРЕТНЫЕ ЛЮДИ, КОТОРЫХ В ГОРОДЕ БОЛЬШЕ НЕ ВСТРЕТЯТ. И ВОПРОС
Dialogue: 0,0:02:23.76,0:02:29.72,Caption,,0,0,0,,ЗДЕСЬ ПРЕДЕЛЬНО ЗЕМНОЙ. СКОЛЬКО ЕЩЁ ФАМИЛИЙ ДОЛЖНО ПОЯВИТЬСЯ НА ТАКИХ
Dialogue: 0,0:02:29.80,0:02:33.64,Caption,,0,0,0,,АЛЛЕЯХ, ПРЕЖДЕ ЧЕМ РЯДОМ СО СЛОВОМ "ПОБЕДА" НАЧНУТ НАЗЫВАТЬ
Dialogue: 0,0:02:33.72,0:02:37.24,Caption,,0,0,0,,ЕЁ СТОИМОСТЬ? СЛЕДУЮЩИЙ РАСЧЁТ КАСАЕТСЯ УЖЕ НЕ АРМИИ,
Dialogue: 0,0:02:37.39,0:02:41.16,Caption,,0,0,0,,А ВСЕЙ СТРАНЫ. ЖУРНАЛИСТ ДМИТРИЙ ГНАП ОБРАЩАЕТ ВНИМАНИЕ НА
Dialogue: 0,0:02:41.16,0:02:43.16,Caption,,0,0,0,,ДЕМОГРАФИЧЕСКИЕ ПОКАЗАТЕЛИ УКРАИНЫ.
Dialogue: 0,0:02:43.72,0:02:46.20,Caption,,0,0,0,,В ПЕРВОЙ ПОЛОВИНЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОГО ГОДА
Dialogue: 0,0:02:46.45,0:02:49.08,Caption,,0,0,0,,УМЕРШИХ БЫЛО БОЛЕЕ ЧЕМ ВТРОЕ БОЛЬШЕ,
Dialogue: 0,0:02:49.25,0:02:52.28,Caption,,0,0,0,,ЧЕМ РОДИВШИХСЯ. НЕ НА НЕСКОЛЬКО ПРОЦЕНТОВ. БОЛЕЕ ЧЕМ
Dialogue: 0,0:02:52.28,0:02:55.56,Caption,,0,0,0,,В ТРИ РАЗА. ОДНОВРЕМЕННО МИЛЛИОНЫ УКРАИНЦЕВ ОСТАЮТСЯ
Dialogue: 0,0:02:55.64,0:02:58.36,Caption,,0,0,0,,ЗА ГРАНИЦЕЙ. ЗА ГОДЫ ТАМ ПОЯВИЛИСЬ РАБОТА,
Dialogue: 0,0:02:58.51,0:03:02.44,Caption,,0,0,0,,ЖИЛЬЁ, ШКОЛЫ ДЛЯ ДЕТЕЙ И ПОНЯТНЫЙ ЗАВТРАШНИЙ ДЕНЬ. ЧЕМ
Dialogue: 0,0:03:02.44,0:03:07.64,Caption,,0,0,0,,ПРОЧНЕЕ СТАНОВИТСЯ ЭТА ЖИЗНЬ, ТЕМ СЛАБЕЕ ДЕЙСТВУЕТ ПРИЗЫВ ОДНАЖДЫ СОБРАТЬ ЧЕМОДАНЫ
Dialogue: 0,0:03:07.85,0:03:12.52,Caption,,0,0,0,,И НАЧАТЬ ВСЁ СНАЧАЛА. КИЕВСКИЙ ИНСТИТУТ ДЕМОГРАФИИ НАЗЫВАЕТ ПРОИСХОДЯЩЕЕ
Dialogue: 0,0:03:12.61,0:03:15.48,Caption,,0,0,0,,ЭКЗИСТЕНЦИАЛЬНОЙ УГРОЗОЙ ДЛЯ БУДУЩЕГО УКРАИНЫ.
Dialogue: 0,0:03:15.87,0:03:20.28,Caption,,0,0,0,,ФОРМУЛИРОВКА ТЯЖЁЛАЯ, НО ЦИФРЫ ПОД НЕЙ ЕЩЁ ТЯЖЕЛЕЕ. НА ЭТОМ
Dialogue: 0,0:03:20.36,0:03:22.36,Caption,,0,0,0,,ФОНЕ УКРАИНСКОЕ ПРАВИТЕЛЬСТВО УЧРЕЖДАЕТ
Dialogue: 0,0:03:22.36,0:03:26.36,Caption,,0,0,0,,КООРДИНАЦИОННЫЙ ШТАБ, КОТОРЫЙ ДОЛЖЕН РЕАГИРОВАТЬ НА МАССОВОЕ ПРИБЫТИЕ
Dialogue: 0,0:03:26.36,0:03:29.80,Caption,,0,0,0,,ИНОСТРАНЦЕВ. ГНАП ВИДИТ ЗА ЭТИМ ДРУГОЙ РАСЧЁТ. ПО
Dialogue: 0,0:03:29.88,0:03:32.76,Caption,,0,0,0,,ЕГО МНЕНИЮ, ВЛАСТИ ЗАРАНЕЕ ГОТОВЯТ МЕХАНИЗМ,
Dialogue: 0,0:03:33.08,0:03:35.80,Caption,,0,0,0,,КОТОРЫЙ ПОЗВОЛИТ ЗАКРЫВАТЬ ИНОСТРАННЫМИ РАБОТНИКАМИ
Dialogue: 0,0:03:35.80,0:03:39.40,Caption,,0,0,0,,БУДУЩИЙ ДЕФИЦИТ НАСЕЛЕНИЯ И КАДРОВ. НА ИСЧЕЗНОВЕНИЕ
Dialogue: 0,0:03:39.40,0:03:42.20,Caption,,0,0,0,,СОБСТВЕННОГО НАСЕЛЕНИЯ ГОСУДАРСТВО ОТВЕЧАЕТ ШТАБОМ.
Dialogue: 0,0:03:42.41,0:03:46.89,Caption,,0,0,0,,ВСЁ ПОД КОНТРОЛЕМ. ГРАЖДАН НЕ ХВАТАЕТ,
Dialogue: 0,0:03:47.12,0:03:49.85,Caption,,0,0,0,,ЗАТО ПРОТОКОЛ ПЕРВОГО ЗАСЕДАНИЯ НАВЕРНЯКА БУДЕТ
Dialogue: 0,0:03:49.93,0:03:52.81,Caption,,0,0,0,,СОСТАВЛЕН ВОВРЕМЯ. ОДНАКО ПРИГЛАСИТЬ ИНОСТРАНЦЕВ
Dialogue: 0,0:03:52.81,0:03:57.05,Caption,,0,0,0,,ПРОЩЕ, ЧЕМ ВЕРНУТЬ УКРАИНЦЕВ, КОТОРЫЕ УЖЕ ЗАКРЕПИЛИСЬ В ДРУГИХ СТРАНАХ.
Dialogue: 0,0:03:57.68,0:04:00.49,Caption,,0,0,0,,КРАСИВЫЙ ПЛАН МОЖЕТ ОБЕЩАТЬ ВОЗВРАЩЕНИЕ МИЛЛИОНОВ,
Dialogue: 0,0:04:00.73,0:04:03.93,Caption,,0,0,0,,НО РЕШЕНИЕ ПРИНИМАЕТ НЕ ПЛАН, А КОНКРЕТНАЯ СЕМЬЯ.
Dialogue: 0,0:04:04.64,0:04:06.97,Caption,,0,0,0,,ЛЮДИ ЗА РУБЕЖОМ НЕ ЗАМЕРЛИ У ПЛАТФОРМЫ,
Dialogue: 0,0:04:07.13,0:04:10.17,Caption,,0,0,0,,СОХРАНЯЯ БИЛЕТ НА ОБРАТНУЮ ДОРОГУ. ОНИ ПОЛУЧАЮТ
Dialogue: 0,0:04:10.17,0:04:13.37,Caption,,0,0,0,,НОВЫЕ ПРОФЕССИИ, ПОДПИСЫВАЮТ ДОГОВОРЫ АРЕНДЫ,
Dialogue: 0,0:04:13.60,0:04:15.85,Caption,,0,0,0,,ОТПРАВЛЯЮТ ДЕТЕЙ В ШКОЛЫ И СТРОЯТ КАРЬЕРУ.
Dialogue: 0,0:04:16.40,0:04:18.89,Caption,,0,0,0,,ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ СЛОВО "ВРЕМЕННО" НАЧИНАЕТ
Dialogue: 0,0:04:18.89,0:04:23.13,Caption,,0,0,0,,ЗВУЧАТЬ КАК СТАРАЯ ШУТКА. КАЖДЫЙ ДОПОЛНИТЕЛЬНЫЙ ГОД КОНФЛИКТА ДЕЛАЕТ
Dialogue: 0,0:04:23.13,0:04:26.49,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ МЕНЕЕ ВЕРОЯТНЫМ. ОДНОГО ОБРАЩЕНИЯ ИЗ
Dialogue: 0,0:04:26.49,0:04:30.41,Caption,,0,0,0,,КИЕВА БУДЕТ МАЛО, ПОТОМУ ЧТО ЧЕЛОВЕКУ ПРИДЁТСЯ СРАВНИВАТЬ ДВЕ ЖИЗНИ,
Dialogue: 0,0:04:30.64,0:04:34.73,Caption,,0,0,0,,А НЕ ДВЕ РЕЧИ. САМО ПОЯВЛЕНИЕ МИГРАНТОВ НЕ ЯВЛЯЕТСЯ СЕНСАЦИЕЙ.
Dialogue: 0,0:04:34.90,0:04:37.93,Caption,,0,0,0,,ИНОСТРАННЫЕ РАБОТНИКИ ЖИВУТ ВО МНОЖЕСТВЕ ГОСУДАРСТВ.
Dialogue: 0,0:04:38.16,0:04:42.01,Caption,,0,0,0,,ВАЖЕН МОМЕНТ, КОГДА УКРАИНА НАЧАЛА СОЗДАВАТЬ ДЛЯ ЭТОГО ОТДЕЛЬНЫЙ
Dialogue: 0,0:04:42.01,0:04:45.05,Caption,,0,0,0,,МЕХАНИЗМ. ЗАТЕМ ИРИНА ВЕРЕЩУК ДОБАВИЛА К ЭТОЙ
Dialogue: 0,0:04:45.05,0:04:48.33,Caption,,0,0,0,,КАРТИНЕ ПРОГНОЗ БЛИЖАЙШИХ МЕСЯЦЕВ. ЗАМЕСТИТЕЛЬ ГЛАВЫ
Dialogue: 0,0:04:48.33,0:04:50.73,Caption,,0,0,0,,ОФИСА ПРЕЗИДЕНТА ПРЕДУПРЕДИЛА УКРАИНЦЕВ,
Dialogue: 0,0:04:51.04,0:04:54.01,Caption,,0,0,0,,ЧТО РАССЧИТЫВАТЬ НА СКОРОЕ ЗАВЕРШЕНИЕ КОНФЛИКТА НЕ
Dialogue: 0,0:04:54.01,0:04:59.49,Caption,,0,0,0,,СЛЕДУЕТ. РОССИЯ НАРАЩИВАЕТ ВЫПУСК РАКЕТ И БЕСПИЛОТНИКОВ,
Dialogue: 0,0:04:59.71,0:05:02.21,Caption,,0,0,0,,ПОЭТОМУ ПРИЗНАКОВ ПОДГОТОВКИ МОСКВЫ К БЫСТРОМУ
Dialogue: 0,0:05:02.21,0:05:04.53,Caption,,0,0,0,,ОКОНЧАНИЮ БОЕВЫХ ДЕЙСТВИЙ ОНА НЕ ВИДИТ.
Dialogue: 0,0:05:05.48,0:05:08.05,Caption,,0,0,0,,ВЕРЕЩУК ОЖИДАЕТ ТЯЖЁЛУЮ ЗИМУ. ПОВРЕЖДЕНИЯ
Dialogue: 0,0:05:08.05,0:05:10.61,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЙ ИНФРАСТРУКТУРЫ СТАЛИ СЕРЬЁЗНЕЕ,
Dialogue: 0,0:05:10.85,0:05:13.17,Caption,,0,0,0,,А ВОССТАНОВИТЕЛЬНЫЕ РАБОТЫ ТЕПЕРЬ СЛОЖНЕЕ,
Dialogue: 0,0:05:13.29,0:05:17.89,Caption,,0,0,0,,ЧЕМ ГОД НАЗАД. НАСЕЛЕНИЮ РЕКОМЕНДУЮТ ЗАРАНЕЕ СОБРАТЬ ЗАПАС ВОДЫ И
Dialogue: 0,0:05:17.97,0:05:21.73,Caption,,0,0,0,,НЕОБХОДИМЫХ ВЕЩЕЙ. ПОТЕРИ ПРОДОЛЖАЮТ РАСТИ. РОЖДЕНИЙ
Dialogue: 0,0:05:21.81,0:05:25.97,Caption,,0,0,0,,ВТРОЕ МЕНЬШЕ, ЧЕМ СМЕРТЕЙ. МИЛЛИОНЫ ГРАЖДАН НАХОДЯТСЯ ЗА ГРАНИЦЕЙ.
Dialogue: 0,0:05:26.13,0:05:28.69,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ВЕРНУТЬ ИХ УМЕНЬШАЕТСЯ С КАЖДЫМ ГОДОМ.
Dialogue: 0,0:05:29.08,0:05:30.93,Caption,,0,0,0,,ОДНОВРЕМЕННО ВЛАСТИ ПРЕДУПРЕЖДАЮТ,
Dialogue: 0,0:05:31.24,0:05:33.73,Caption,,0,0,0,,ЧТО КОНФЛИКТ БЫСТРО НЕ ЗАКОНЧИТСЯ. ПРИ ЭТОМ ИЗ
Dialogue: 0,0:05:33.73,0:05:35.97,Caption,,0,0,0,,ПУБЛИЧНОЙ РЕЧИ НЕ ИСЧЕЗАЮТ ПОБЕДА,
Dialogue: 0,0:05:36.18,0:05:40.85,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ, ЕВРОПЕЙСКОЕ БУДУЩЕЕ И НАЦИОНАЛЬНОЕ ВЕЛИЧИЕ. ВСЕ
Dialogue: 0,0:05:40.93,0:05:43.73,Caption,,0,0,0,,СЛОВА НА СВОИХ МЕСТАХ. НЕ ХВАТАЕТ ЛИШЬ СВОЙСТВА
Dialogue: 0,0:05:43.73,0:05:47.01,Caption,,0,0,0,,СЛОВ УВЕЛИЧИВАТЬ НАСЕЛЕНИЕ. ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ
Dialogue: 0,0:05:47.01,0:05:49.01,Caption,,0,0,0,,РАЗГОВОР БЕЗ МНОГОЭТАЖНЫХ ЛЕКЦИЙ,
Dialogue: 0,0:05:49.11,0:05:51.41,Caption,,0,0,0,,ПОДПИШИТЕСЬ. И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:05:51.63,0:05:54.69,Caption,,0,0,0,,ЧТО В ЭТОЙ ИСТОРИИ КАЖЕТСЯ ВАМ ГЛАВНЫМ ВОЕННЫЕ
Dialogue: 0,0:05:54.69,0:05:58.37,Caption,,0,0,0,,ПОТЕРИ, ДЕМОГРАФИЧЕСКИЙ ПРОВАЛ ИЛИ ЦЕНА УПРАВЛЕНЧЕСКИХ
Dialogue: 0,0:05:58.45,0:06:01.65,Caption,,0,0,0,,РЕШЕНИЙ. ДАЛЬШЕ НАЧИНАЕТСЯ ХОЗЯЙСТВЕННАЯ ЧАСТЬ,
Dialogue: 0,0:06:01.89,0:06:04.53,Caption,,0,0,0,,ГДЕ ЧИСЛА УМЕЮТ ШУТИТЬ ЕЩЁ ЗЛЕЕ ЛЮДЕЙ.
Dialogue: 0,0:06:05.31,0:06:07.49,Caption,,0,0,0,,МЕЖДУНАРОДНОЕ ЭНЕРГЕТИЧЕСКОЕ АГЕНТСТВО ОЦЕНИЛО
Dialogue: 0,0:06:07.49,0:06:09.65,Caption,,0,0,0,,ГОТОВНОСТЬ УКРАИНЫ К ЗИМНЕМУ ПЕРИОДУ.
Dialogue: 0,0:06:11.92,0:06:14.40,Caption,,0,0,0,,В АВГУСТЕ ПРОМЫШЛЕННОСТЬ УКРАИНЫ ИСПОЛЬЗОВАЛА НА
Dialogue: 0,0:06:14.48,0:06:17.04,Caption,,0,0,0,,ДВАДЦАТЬ ТРИ ПРОЦЕНТА МЕНЬШЕ ЭЛЕКТРИЧЕСТВА,
Dialogue: 0,0:06:17.15,0:06:20.56,Caption,,0,0,0,,ЧЕМ ГОДОМ РАНЕЕ. К СЕНТЯБРЮ ДЕВЯНОСТО ПРОЦЕНТОВ
Dialogue: 0,0:06:20.56,0:06:23.76,Caption,,0,0,0,,МЕТАЛЛУРГИЧЕСКИХ МОЩНОСТЕЙ ОКАЗАЛИСЬ ПОВРЕЖДЕНЫ ИЛИ
Dialogue: 0,0:06:23.76,0:06:26.32,Caption,,0,0,0,,ОСТАНОВЛЕНЫ. ИЗ ЗА ЭТОГО СПРОС СО СТОРОНЫ
Dialogue: 0,0:06:26.32,0:06:29.36,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ УМЕНЬШИЛСЯ ПРИБЛИЗИТЕЛЬНО НА ПОЛТОРА
Dialogue: 0,0:06:29.36,0:06:32.96,Caption,,0,0,0,,ГИГАВАТТА. НА ПЕРВЫЙ ВЗГЛЯД ЭНЕРГОСИСТЕМЕ СТАЛО ЛЕГЧЕ.
Dialogue: 0,0:06:33.12,0:06:37.68,Caption,,0,0,0,,ПОТРЕБЛЕНИЕ СНИЗИЛОСЬ, ЗНАЧИТ ДЕФИЦИТ БУДТО БЫ СОКРАТИЛСЯ. МОЖНО ДАЖЕ
Dialogue: 0,0:06:37.76,0:06:42.72,Caption,,0,0,0,,ПОЗДРАВИТЬ ОТВЕТСТВЕННЫХ ЛИЦ, ЕСЛИ НЕ УТОЧНЯТЬ ПРИЧИНУ. ЭЛЕКТРИЧЕСТВО СТАЛО МЕНЕЕ
Dialogue: 0,0:06:42.72,0:06:45.12,Caption,,0,0,0,,ВОСТРЕБОВАННЫМ НЕ БЛАГОДАРЯ НОВЫМ СТАНЦИЯМ И
Dialogue: 0,0:06:45.12,0:06:47.76,Caption,,0,0,0,,РАСТУЩЕЙ ЭФФЕКТИВНОСТИ. ОНО ПРОСТО ПЕРЕСТАЛО
Dialogue: 0,0:06:47.84,0:06:52.08,Caption,,0,0,0,,ТРЕБОВАТЬСЯ ПРЕДПРИЯТИЯМ, КОТОРЫЕ БОЛЬШЕ НЕ РАБОТАЮТ. С ГАЗОМ НАБЛЮДАЕТСЯ
Dialogue: 0,0:06:52.08,0:06:55.44,Caption,,0,0,0,,ПОХОЖАЯ КАРТИНА. ЗАПАСЫ ОЦЕНИВАЮТСЯ КАК ХОРОШИЕ,
Dialogue: 0,0:06:55.65,0:07:00.72,Caption,,0,0,0,,ОБЪЁМ ИМПОРТА УМЕНЬШИЛСЯ, НО ЗАМЕТНУЮ РОЛЬ СНОВА ИГРАЕТ ПАДЕНИЕ ПРОМЫШЛЕННОГО
Dialogue: 0,0:07:00.72,0:07:03.04,Caption,,0,0,0,,ПОТРЕБЛЕНИЯ. ПРОИЗВОДСТВО СЖАЛОСЬ,
Dialogue: 0,0:07:03.20,0:07:07.84,Caption,,0,0,0,,РЕСУРСОВ ТРЕБУЕТСЯ МЕНЬШЕ, ПОКАЗАТЕЛИ ВЫГЛЯДЯТ СПОКОЙНЕЕ. НЕ ЭКОНОМИКА,
Dialogue: 0,0:07:08.08,0:07:11.04,Caption,,0,0,0,,А МАСТЕР КЛАСС ПО СНИЖЕНИЮ АППЕТИТА МЕТОДОМ УДАЛЕНИЯ
Dialogue: 0,0:07:11.04,0:07:14.40,Caption,,0,0,0,,ЖЕЛУДКА. ДАЛЬШЕ НАЧИНАЕТСЯ СТРОИТЕЛЬСТВО ЗАЩИТЫ ДЛЯ
Dialogue: 0,0:07:14.40,0:07:17.44,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИХ ОБЪЕКТОВ КИЕВСКОЙ ОБЛАСТИ. ПРОЕКТ
Dialogue: 0,0:07:17.52,0:07:20.48,Caption,,0,0,0,,ОХВАТЫВАЕТ ДВАДЦАТЬ ШЕСТЬ ОБЪЕКТОВ. НАРОДНЫЙ ДЕПУТАТ
Dialogue: 0,0:07:20.56,0:07:25.20,Caption,,0,0,0,,АЛЕКСЕЙ КУЧЕРЕНКО УТВЕРЖДАЕТ, ЧТО ПОЛНОСТЬЮ НЕ ЗАВЕРШИЛИ НИ ОДНОГО СООРУЖЕНИЯ.
Dialogue: 0,0:07:27.47,0:07:30.35,Caption,,0,0,0,,НЕ ОСТАЛОСЬ ЗАКОНЧИТЬ ОДИН ОБЪЕКТ. НЕ ВЫПОЛНЕНА
Dialogue: 0,0:07:30.35,0:07:33.15,Caption,,0,0,0,,ПОЛОВИНА ПРОГРАММЫ. ИТОГ ПРОЩЕ И ПОТОМУ
Dialogue: 0,0:07:33.31,0:07:36.83,Caption,,0,0,0,,ВЫРАЗИТЕЛЬНЕЕ ГОТОВЫХ ОБЪЕКТОВ НЕТ ВООБЩЕ. НА РАБОТЫ
Dialogue: 0,0:07:36.83,0:07:39.95,Caption,,0,0,0,,ПРЕДУСМОТРЕН МИЛЛИАРД ВОСЕМЬСОТ МИЛЛИОНОВ ГРИВЕН.
Dialogue: 0,0:07:40.42,0:07:43.15,Caption,,0,0,0,,ПОДРЯДЧИКИ УЖЕ ПОЛУЧИЛИ СЕМЬСОТ ПЯТЬДЕСЯТ МИЛЛИОНОВ
Dialogue: 0,0:07:43.15,0:07:46.11,Caption,,0,0,0,,ГРИВЕН АВАНСОМ. ТЕПЕРЬ, ПО СЛОВАМ КУЧЕРЕНКО,
Dialogue: 0,0:07:46.42,0:07:48.67,Caption,,0,0,0,,ИСПОЛНИТЕЛЬ ПРОСИТ ДОПОЛНИТЕЛЬНО ЧЕТЫРЕСТА
Dialogue: 0,0:07:48.67,0:07:51.31,Caption,,0,0,0,,МИЛЛИОНОВ. ДЛЯ ТАКОГО РЕЗУЛЬТАТА ПРОТИВНИКУ ДАЖЕ
Dialogue: 0,0:07:51.31,0:07:53.95,Caption,,0,0,0,,НЕОБЯЗАТЕЛЬНО РАСХОДОВАТЬ РАКЕТУ. ДОСТАТОЧНО
Dialogue: 0,0:07:53.95,0:07:57.71,Caption,,0,0,0,,ПОСМОТРЕТЬ, КАК ЗАЩИТА САМОСТОЯТЕЛЬНО ПРЕВРАЩАЕТСЯ В ДЕНЕЖНУЮ
Dialogue: 0,0:07:57.79,0:08:01.31,Caption,,0,0,0,,ВОРОНКУ. ДВАДЦАТЬ ШЕСТЬ ПЛОЩАДОК ДАЛИ НОЛЬ ГОТОВЫХ
Dialogue: 0,0:08:01.31,0:08:03.95,Caption,,0,0,0,,СООРУЖЕНИЙ. СЕМЬСОТ ПЯТЬДЕСЯТ МИЛЛИОНОВ УЖЕ
Dialogue: 0,0:08:03.95,0:08:07.07,Caption,,0,0,0,,ПЕРЕЧИСЛЕНЫ. СЛЕДУЮЩИМ ПУНКТОМ ВОЗНИКАЕТ ПРОСЬБА
Dialogue: 0,0:08:07.07,0:08:10.59,Caption,,0,0,0,,ДОБАВИТЬ ЕЩЁ ЧЕТЫРЕСТА МИЛЛИОНОВ. СЕРВИС ПОЧТИ КАК В
Dialogue: 0,0:08:10.59,0:08:15.15,Caption,,0,0,0,,РЕСТОРАНЕ БЛЮДО НЕ ПРИНЕСЛИ, ЗАТО СЧЁТ ОБНОВИЛИ. НО У СТРОИТЕЛЬСТВА ЕСТЬ
Dialogue: 0,0:08:15.15,0:08:18.03,Caption,,0,0,0,,НЕПРИЯТНАЯ ПРИВЫЧКА ЕГО РЕЗУЛЬТАТ МОЖНО УВИДЕТЬ.
Dialogue: 0,0:08:18.19,0:08:22.19,Caption,,0,0,0,,ЛИБО ЗАЩИТА ГОТОВА, ЛИБО ЕЁ НЕТ. В ДАННОМ СЛУЧАЕ ЕСТЬ ДВАДЦАТЬ
Dialogue: 0,0:08:22.19,0:08:26.35,Caption,,0,0,0,,ШЕСТЬ ОБЪЕКТОВ, НОЛЬ ЗАВЕРШЁННЫХ СООРУЖЕНИЙ И ТРИ ЧЕТВЕРТИ МИЛЛИАРДА
Dialogue: 0,0:08:26.35,0:08:29.71,Caption,,0,0,0,,ГРИВЕН, УЖЕ ПОКИНУВШИЕ ГОСУДАРСТВЕННЫЙ СЧЁТ. ПОСЛЕ ЭТОГО
Dialogue: 0,0:08:29.79,0:08:32.59,Caption,,0,0,0,,ЕСТЕСТВЕННЫЙ ВОПРОС ЗВУЧИТ СОВСЕМ НЕ СЛОЖНО. КУДА
Dialogue: 0,0:08:32.59,0:08:35.07,Caption,,0,0,0,,УШЛИ ДЕНЬГИ И ЧТО ИМЕННО ЗА НИХ УСПЕЛИ
Dialogue: 0,0:08:35.07,0:08:40.48,Caption,,0,0,0,,ПОСТРОИТЬ? ЕСЛИ ПОВРЕЖДЕНИЕ ЭНЕРГЕТИКИ СТАНУТ ОБЪЯСНЯТЬ
Dialogue: 0,0:08:40.49,0:08:42.72,Caption,,0,0,0,,ИСКЛЮЧИТЕЛЬНО СИЛОЙ РОССИЙСКИХ УДАРОВ,
Dialogue: 0,0:08:43.18,0:08:46.48,Caption,,0,0,0,,У КУЧЕРЕНКО ИМЕЕТСЯ НЕУДОБНОЕ ДОПОЛНЕНИЕ. ПРЕЖДЕ ЧЕМ
Dialogue: 0,0:08:46.48,0:08:50.72,Caption,,0,0,0,,ССЫЛАТЬСЯ НА ПРОТИВНИКА, МОЖНО БЫЛО ДОВЕСТИ ДО КОНЦА ХОТЯ БЫ ОДНО
Dialogue: 0,0:08:50.72,0:08:53.84,Caption,,0,0,0,,ЗАЩИТНОЕ СООРУЖЕНИЕ. ИНОГДА ВНЕШНЕМУ ПРОТИВНИКУ
Dialogue: 0,0:08:53.92,0:08:56.40,Caption,,0,0,0,,ОСТАЁТСЯ ТОЛЬКО НЕ МЕШАТЬ. ВНУТРЕННИЕ МАСТЕРА
Dialogue: 0,0:08:56.40,0:09:01.52,Caption,,0,0,0,,ОСВОЕНИЯ АВАНСА И САМИ ЗНАЮТ, КАК ОСТАВИТЬ ОБЪЕКТ БЕЗ ЗАЩИТЫ. ПОКА ПОДРЯДЧИКИ
Dialogue: 0,0:09:01.52,0:09:03.52,Caption,,0,0,0,,ОБСУЖДАЮТ СЛЕДУЮЩУЮ ПОРЦИЮ ДЕНЕГ,
Dialogue: 0,0:09:03.79,0:09:07.04,Caption,,0,0,0,,КИЕВ СОКРАЩАЕТ УЛИЧНОЕ ОСВЕЩЕНИЕ. ИЗ ЗА ОСТРОГО
Dialogue: 0,0:09:07.04,0:09:09.76,Caption,,0,0,0,,НЕДОСТАТКА ЭЛЕКТРОЭНЕРГИИ НАРУЖНЫЙ СВЕТ В СТОЛИЦЕ
Dialogue: 0,0:09:09.76,0:09:13.12,Caption,,0,0,0,,ПОЛНОСТЬЮ ОТКЛЮЧАЮТ. ДОСТУПНУЮ МОЩНОСТЬ НАПРАВЛЯЮТ
Dialogue: 0,0:09:13.12,0:09:16.00,Caption,,0,0,0,,ПРЕЖДЕ ВСЕГО НА КРИТИЧЕСКИ ВАЖНЫЕ ОБЪЕКТЫ ГОРОДА.
Dialogue: 0,0:09:16.32,0:09:19.36,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ЛИНИИ, СВЯЗАННЫЕ С СИСТЕМАМИ ОПОВЕЩЕНИЯ,
Dialogue: 0,0:09:19.52,0:09:22.64,Caption,,0,0,0,,ОСТАЮТСЯ ИСКЛЮЧЕНИЕМ. ЕСЛИ ЭЛЕКТРИЧЕСТВО ИМЕЕТСЯ,
Dialogue: 0,0:09:22.88,0:09:26.08,Caption,,0,0,0,,ОНИ РАБОТАЮТ ДО ДЕСЯТИ ЧАСОВ ВЕЧЕРА. АВТОМОБИЛИСТОВ
Dialogue: 0,0:09:26.08,0:09:29.12,Caption,,0,0,0,,ПРИЗЫВАЮТ ЕХАТЬ МЕДЛЕННЕЕ. ПЕШЕХОДАМ СОВЕТУЮТ
Dialogue: 0,0:09:29.12,0:09:31.84,Caption,,0,0,0,,ПОЛЬЗОВАТЬСЯ ФОНАРЯМИ И СВЕТОВОЗВРАЩАЮЩИМИ
Dialogue: 0,0:09:31.84,0:09:35.36,Caption,,0,0,0,,ЭЛЕМЕНТАМИ. ПОЯСНЯТЬ, ЧТО БЕЗ ФОНАРЕЙ НОЧЬЮ ТЕМНО,
Dialogue: 0,0:09:35.49,0:09:38.80,Caption,,0,0,0,,НЕ ТРЕБУЕТСЯ. ГОРАЗДО ПОЛЕЗНЕЕ СОБРАТЬ В ОДНОМ МЕСТЕ
Dialogue: 0,0:09:38.88,0:09:43.12,Caption,,0,0,0,,ВСЕ ПОКАЗАТЕЛИ, КОТОРЫЕ ПРИВЕЛИ СТРАНУ К ЭТОЙ ТЕМНОТЕ. НА АЛЛЕЕ
Dialogue: 0,0:09:43.12,0:09:45.76,Caption,,0,0,0,,ГЕРОЕВ ЛОЗОВОЙ НАХОДЯТСЯ ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ
Dialogue: 0,0:09:45.76,0:09:49.60,Caption,,0,0,0,,ФАМИЛИЙ. РАСЧЁТ ДРУЗЕНКО ДАЁТ ОТ ДВУХСОТ ДО ТРЁХСОТ
Dialogue: 0,0:09:49.60,0:09:52.88,Caption,,0,0,0,,ТЫСЯЧ БЕЗВОЗВРАТНЫХ ПОТЕРЬ. СМЕРТНОСТЬ ПРЕВЫШАЕТ
Dialogue: 0,0:09:52.88,0:09:59.32,Caption,,0,0,0,,РОЖДАЕМОСТЬ БОЛЕЕ ЧЕМ ВТРОЕ. ПРОМЫШЛЕННОЕ ПОТРЕБЛЕНИЕ ЭЛЕКТРИЧЕСТВА УМЕНЬШИЛОСЬ
Dialogue: 0,0:09:59.40,0:10:01.96,Caption,,0,0,0,,НА ДВАДЦАТЬ ТРИ ПРОЦЕНТА. ДЕВЯНОСТО ПРОЦЕНТОВ
Dialogue: 0,0:10:01.96,0:10:04.52,Caption,,0,0,0,,МЕТАЛЛУРГИЧЕСКИХ МОЩНОСТЕЙ ОСТАНОВЛЕНЫ ЛИБО
Dialogue: 0,0:10:04.52,0:10:07.32,Caption,,0,0,0,,ПОВРЕЖДЕНЫ. К ЭТОМУ СПИСКУ ДОБАВЛЯЮТСЯ ДВАДЦАТЬ
Dialogue: 0,0:10:07.40,0:10:09.16,Caption,,0,0,0,,ШЕСТЬ ЭНЕРГЕТИЧЕСКИХ ОБЪЕКТОВ,
Dialogue: 0,0:10:09.48,0:10:11.72,Caption,,0,0,0,,НОЛЬ ЗАКОНЧЕННЫХ ЗАЩИТНЫХ СООРУЖЕНИЙ,
Dialogue: 0,0:10:12.11,0:10:14.52,Caption,,0,0,0,,СЕМЬСОТ ПЯТЬДЕСЯТ МИЛЛИОНОВ ГРИВЕН ВЫПЛАЧЕННОГО
Dialogue: 0,0:10:14.52,0:10:18.20,Caption,,0,0,0,,АВАНСА И ТЁМНЫЕ УЛИЦЫ КИЕВА. ПОСЛЕ ТАКОГО НАБОРА
Dialogue: 0,0:10:18.28,0:10:20.67,Caption,,0,0,0,,ЛЮБОЙ ТОРЖЕСТВЕННЫЙ ДОКЛАД НАЧИНАЕТ ПРОИГРЫВАТЬ
Dialogue: 0,0:10:20.67,0:10:23.64,Caption,,0,0,0,,ТАБЛИЦЕ. ТАБЛИЦА ХОТЯ БЫ НЕ ПЫТАЕТСЯ СДЕЛАТЬ ВИД,
Dialogue: 0,0:10:23.87,0:10:26.67,Caption,,0,0,0,,ЧТО НОЛЬ ЗАВЕРШЁННЫХ ОБЪЕКТОВ ЯВЛЯЕТСЯ ЭТАПОМ
Dialogue: 0,0:10:26.67,0:10:31.32,Caption,,0,0,0,,БОЛЬШОГО УСПЕХА. ОДНАКО САМАЯ ТЯЖЁЛАЯ ЧАСТЬ ЭТОЙ ИСТОРИИ ИЗМЕРЯЕТСЯ
Dialogue: 0,0:10:31.40,0:10:34.20,Caption,,0,0,0,,НЕ ГИГАВАТТАМИ И НЕ ГРИВНАМИ. ПОВРЕЖДЁННЫЙ
Dialogue: 0,0:10:34.20,0:10:37.32,Caption,,0,0,0,,ТРАНСФОРМАТОР МОЖНО ЗАМЕНИТЬ. ОСВЕЩЕНИЕ ВЕРНУТЬ.
Dialogue: 0,0:10:37.64,0:10:41.00,Caption,,0,0,0,,ДОРОГУ ОТРЕМОНТИРОВАТЬ. ДАЖЕ ЗАЩИТНОЕ СООРУЖЕНИЕ
Dialogue: 0,0:10:41.08,0:10:45.79,Caption,,0,0,0,,ОДНАЖДЫ СПОСОБНЫ ЗАКОНЧИТЬ, ЕСЛИ ДЕНЬГИ НАКОНЕЦ ВСТРЕТЯТСЯ С БЕТОНОМ. ПОГИБШЕГО
Dialogue: 0,0:10:45.79,0:10:48.28,Caption,,0,0,0,,ЧЕЛОВЕКА НЕ ВОССТАНОВИТ НИ ОДИН ПОДРЯДЧИК.
Dialogue: 0,0:10:48.85,0:10:51.72,Caption,,0,0,0,,ВЕРНУТЬ УЕХАВШУЮ СЕМЬЮ ТОЖЕ НАМНОГО ТРУДНЕЕ,
Dialogue: 0,0:10:51.86,0:10:55.08,Caption,,0,0,0,,ЧЕМ ЗАПУСТИТЬ НОВУЮ ГОСУДАРСТВЕННУЮ ПРОГРАММУ. ЕСЛИ
Dialogue: 0,0:10:55.16,0:10:58.76,Caption,,0,0,0,,ЛЮДИ НАШЛИ БЕЗОПАСНОСТЬ, РАБОТУ И БУДУЩЕЕ В ДРУГОЙ СТРАНЕ,
Dialogue: 0,0:10:59.15,0:11:02.28,Caption,,0,0,0,,ОДНОГО ПРИЗЫВА К ПАТРИОТИЗМУ НЕДОСТАТОЧНО. ДОМ
Dialogue: 0,0:11:02.28,0:11:06.68,Caption,,0,0,0,,ДОЛЖЕН ПРЕДЛАГАТЬ ИМ ЖИЗНЬ, А НЕ ОЧЕРЕДНУЮ ПРОВЕРКУ НА ВЫНОСЛИВОСТЬ. ПОЭТОМУ
Dialogue: 0,0:11:06.76,0:11:09.64,Caption,,0,0,0,,РАЗГОВОР О ВЕЛИЧИИ ХОРОШО ЗВУЧИТ ЛИШЬ ДО ПОЯВЛЕНИЯ
Dialogue: 0,0:11:09.64,0:11:14.00,Caption,,0,0,0,,НАСТОЯЩЕГО СЧЁТА. ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:11:14.24,0:11:16.72,Caption,,0,0,0,,ЧТО СТРАНЕ ТРЕБУЕТСЯ НЕ ТОЛЬКО ПЕРЕЖИТЬ КОНФЛИКТ,
Dialogue: 0,0:11:16.95,0:11:19.84,Caption,,0,0,0,,ПОЛУЧИТЬ ПОМОЩЬ И ДОЖДАТЬСЯ ОЧЕРЕДНОЙ ПОБЕДНОЙ РЕЧИ.
Dialogue: 0,0:11:20.32,0:11:24.16,Caption,,0,0,0,,ЕЙ ЕЩЁ НУЖНЫ ЛЮДИ, КОТОРЫЕ СМОГУТ ЭТУ РЕЧЬ УСЛЫШАТЬ НЕ ИЗ ДРУГОЙ
Dialogue: 0,0:11:24.16,0:11:26.64,Caption,,0,0,0,,СТРАНЫ И НЕ С МЕМОРИАЛЬНОЙ ФОТОГРАФИИ.
