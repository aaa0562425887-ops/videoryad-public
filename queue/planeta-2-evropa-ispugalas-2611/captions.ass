Dialogue: 0,0:00:00.12,0:00:02.34,Caption,,0,0,0,,ЕВРОПА ДОЛГО ТАСКАЛА КАНИСТРЫ К
Dialogue: 0,0:00:02.34,0:00:05.96,Caption,,0,0,0,,КОСТРУ, ПОДЛИВАЛА, СОВЕТОВАЛА НЕ ЖАЛЕТЬ ТОПЛИВА,
Dialogue: 0,0:00:06.28,0:00:08.08,Caption,,0,0,0,,А ТЕПЕРЬ БЕГАЕТ ВОКРУГ С ВЕДРОМ И
Dialogue: 0,0:00:08.08,0:00:10.81,Caption,,0,0,0,,ТРЕБУЕТ, ЧТОБЫ НИ ОДНА ИСКРА НЕ ПЕРЕЛЕТЕЛА
Dialogue: 0,0:00:10.81,0:00:13.98,Caption,,0,0,0,,ЧЕРЕЗ ЗАБОР. ИСКРЫ УЖЕ ЛЕТЯТ. И НЕКОТОРЫЕ
Dialogue: 0,0:00:13.98,0:00:16.52,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ ВДРУГ ЗАГОВОРИЛИ ТАК,
Dialogue: 0,0:00:16.84,0:00:18.52,Caption,,0,0,0,,БУДТО ТОЛЬКО ЧТО ЗАМЕТИЛИ ОГОНЬ.
Dialogue: 0,0:00:19.22,0:00:22.36,Caption,,0,0,0,,ГОСПОДА, А ЧЕМ, ПО ВАШЕМУ РАСЧЁТУ,
Dialogue: 0,0:00:22.72,0:00:24.44,Caption,,0,0,0,,ВСЁ ЭТО ДОЛЖНО БЫЛО ЗАКОНЧИТЬСЯ?
Dialogue: 0,0:00:24.72,0:00:28.82,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ, В КОТОРЫХ ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ ИЩУТ
Dialogue: 0,0:00:28.82,0:00:30.68,Caption,,0,0,0,,РЕАЛЬНЫЕ ИНТЕРЕСЫ И ПОСЛЕДСТВИЯ,
Dialogue: 0,0:00:30.90,0:00:33.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ОТДЕЛЬНО ЭТИ СОБЫТИЯ
Dialogue: 0,0:00:33.24,0:00:36.17,Caption,,0,0,0,,ПОХОЖИ НА СЛУЧАЙНЫЙ НАБОР ТРЕВОЖНЫХ НОВОСТЕЙ.
Dialogue: 0,0:00:36.17,0:00:39.85,Caption,,0,0,0,,ЕСЛИ ПОСТАВИТЬ ИХ РЯДОМ, СЛУЧАЙНОСТЬ НАЧИНАЕТ ВЫГЛЯДЕТЬ СЛИШКОМ
Dialogue: 0,0:00:39.85,0:00:42.60,Caption,,0,0,0,,СТАРАТЕЛЬНОЙ. ПЕРВАЯ ТОЧКА НА КАРТЕ,
Dialogue: 0,0:00:42.90,0:00:44.97,Caption,,0,0,0,,КАЛИНИНГРАД. НА СТРОИТЕЛЬСТВО ДВУХ
Dialogue: 0,0:00:44.97,0:00:48.09,Caption,,0,0,0,,ЖЕЛЕЗНОДОРОЖНЫХ ПАРОМОВ РОССИЙСКИЕ ВЛАСТИ НАПРАВЛЯЮТ
Dialogue: 0,0:00:48.09,0:00:50.96,Caption,,0,0,0,,ПОЧТИ СОРОК СЕМЬ МИЛЛИАРДОВ РУБЛЕЙ. ЧАСТЬ СУММЫ
Dialogue: 0,0:00:50.96,0:00:54.69,Caption,,0,0,0,,ДОЛЖНА ПОСТУПИТЬ ИЗ ФОНДА НАЦИОНАЛЬНОГО БЛАГОСОСТОЯНИЯ.
Dialogue: 0,0:00:54.69,0:00:57.00,Caption,,0,0,0,,СУДА СВЯЖУТ УСТЬ ЛУГУ И БАЛТИЙСК,
Dialogue: 0,0:00:57.16,0:00:58.98,Caption,,0,0,0,,ЧТОБЫ РЕГИОН МОЖНО БЫЛО СНАБЖАТЬ
Dialogue: 0,0:00:58.98,0:01:01.56,Caption,,0,0,0,,МОРЕМ, НЕ ПОЛАГАЯСЬ НА СУХОПУТНЫЙ ТРАНЗИТ.
Dialogue: 0,0:01:01.56,0:01:04.28,Caption,,0,0,0,,РЕШЕНИЕ ВПОЛНЕ ЗДРАВОЕ. ВОКРУГ ГРАНИЦ,
Dialogue: 0,0:01:04.49,0:01:06.34,Caption,,0,0,0,,ПЕРЕВОЗОК И БАЛТИКИ УЖЕ СТОЛЬКО
Dialogue: 0,0:01:06.34,0:01:09.03,Caption,,0,0,0,,НЕРВНЫХ РАЗГОВОРОВ, ЧТО НАДЕЯТЬСЯ НА ВЕЧНУЮ
Dialogue: 0,0:01:09.03,0:01:12.04,Caption,,0,0,0,,ДОБРОЖЕЛАТЕЛЬНОСТЬ СОСЕДЕЙ БЫЛО БЫ НЕОБЫЧАЙНО СМЕЛО.
Dialogue: 0,0:01:14.31,0:01:16.45,Caption,,0,0,0,,МОРСКАЯ ДОЛЯ КАЛИНИНГРАДСКИХ ГРУЗОВ
Dialogue: 0,0:01:16.45,0:01:19.52,Caption,,0,0,0,,ВЫРОСЛА С ВОСЬМИ ПРОЦЕНТОВ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ
Dialogue: 0,0:01:19.52,0:01:21.95,Caption,,0,0,0,,ГОДУ ДО БОЛЕЕ ЧЕМ ПЯТИДЕСЯТИ ПРОЦЕНТОВ.
Dialogue: 0,0:01:21.95,0:01:24.31,Caption,,0,0,0,,НАПРАВЛЕНИЕ ДАВНО ПЕРЕСТАЛО БЫТЬ ЗАПАСНЫМ.
Dialogue: 0,0:01:24.95,0:01:26.89,Caption,,0,0,0,,ОДНАКО В ОПИСАНИИ ЭТОГО ПРОЕКТА
Dialogue: 0,0:01:26.89,0:01:30.74,Caption,,0,0,0,,МЕЛЬКАЕТ ФРАЗА, ОТ КОТОРОЙ СТАНОВИТСЯ НЕУЮТНО. РОССИЯ
Dialogue: 0,0:01:30.74,0:01:33.73,Caption,,0,0,0,,ГОТОВИТСЯ К ВОЗМОЖНОЙ БЛОКАДЕ КАЛИНИНГРАДА. В
Dialogue: 0,0:01:33.73,0:01:36.35,Caption,,0,0,0,,ОБЛАСТИ УЖЕ ЗВУЧАЛА ВОЗДУШНАЯ ТРЕВОГА ИЗ ЗА
Dialogue: 0,0:01:36.35,0:01:40.65,Caption,,0,0,0,,ПОДОЗРИТЕЛЬНОГО ОБЪЕКТА, ПРИЛЕТЕВШЕГО СО СТОРОНЫ ЛИТВЫ. ПУТИН И
Dialogue: 0,0:01:40.65,0:01:42.39,Caption,,0,0,0,,ПАТРУШЕВ ПРЕЖДЕ ПРЕДУПРЕЖДАЛИ,
Dialogue: 0,0:01:42.63,0:01:45.33,Caption,,0,0,0,,ЧТО ВОЕННАЯ ЛИБО ТРАНСПОРТНАЯ ИЗОЛЯЦИЯ
Dialogue: 0,0:01:45.33,0:01:48.00,Caption,,0,0,0,,РЕГИОНА ВЫЗОВЕТ НЕМЕДЛЕННЫЙ ОТВЕТ ВСЕМИ
Dialogue: 0,0:01:48.00,0:01:50.92,Caption,,0,0,0,,ДОСТУПНЫМИ СРЕДСТВАМИ. ОБРАТИТЕ ВНИМАНИЕ НА САМУ
Dialogue: 0,0:01:50.92,0:01:53.43,Caption,,0,0,0,,КОНСТРУКЦИЮ. РЕЧЬ УЖЕ НЕ ТОЛЬКО О ТОМ,
Dialogue: 0,0:01:53.60,0:01:55.78,Caption,,0,0,0,,КАК НЕ ПОЗВОЛИТЬ ОТРЕЗАТЬ ОБЛАСТЬ.
Dialogue: 0,0:01:55.78,0:01:58.15,Caption,,0,0,0,,СОЗДАЁТСЯ СИСТЕМА СНАБЖЕНИЯ НА СЛУЧАЙ,
Dialogue: 0,0:01:58.31,0:02:00.43,Caption,,0,0,0,,ЕСЛИ ЕЁ ВСЁ ТАКИ ОТРЕЖУТ. СНАЧАЛА
Dialogue: 0,0:02:00.43,0:02:04.24,Caption,,0,0,0,,СОСЕДИ ЗАХЛОПЫВАЮТ ДВЕРЬ, ЗАТЕМ РОССИЯ ПОДАЁТ ПРОДУКТЫ ЧЕРЕЗ
Dialogue: 0,0:02:04.24,0:02:07.35,Caption,,0,0,0,,ОКНО. ПРАКТИЧНО, КОНЕЧНО. ТОЛЬКО ПЛАНИРОВКА ДОМА
Dialogue: 0,0:02:07.35,0:02:10.52,Caption,,0,0,0,,ВЫЗЫВАЕТ ВОПРОСЫ. И ГОТОВЫМИ НОВЫЕ ПАРОМЫ ДОЛЖНЫ СТАТЬ
Dialogue: 0,0:02:10.52,0:02:13.67,Caption,,0,0,0,,ПРИМЕРНО К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ ГОДУ. ЭТОТ СРОК
Dialogue: 0,0:02:13.67,0:02:16.02,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ НАЧАЛЬНИКИ ПОВТОРЯЮТ С ТАКИМ
Dialogue: 0,0:02:16.02,0:02:18.60,Caption,,0,0,0,,ПОСТОЯНСТВОМ, БУДТО ПОЛУЧИЛИ ПРИГЛАШЕНИЕ НА
Dialogue: 0,0:02:18.60,0:02:20.63,Caption,,0,0,0,,МЕРОПРИЯТИЕ И БОЯТСЯ ПЕРЕПУТАТЬ ВРЕМЯ.
Dialogue: 0,0:02:22.82,0:02:25.15,Caption,,0,0,0,,К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ ГОДУ ОБЕЩАЮТ
Dialogue: 0,0:02:25.15,0:02:28.02,Caption,,0,0,0,,ПЕРЕСТРОИТЬ АРМИИ, РАСШИРИТЬ ПРОИЗВОДСТВО,
Dialogue: 0,0:02:28.15,0:02:30.26,Caption,,0,0,0,,УКРЕПИТЬ ОБОРОНУ И ЗАКОНЧИТЬ КРУПНЫЕ
Dialogue: 0,0:02:30.26,0:02:32.40,Caption,,0,0,0,,ИНФРАСТРУКТУРНЫЕ ПРОЕКТЫ. ОСТАЛОСЬ
Dialogue: 0,0:02:32.40,0:02:35.86,Caption,,0,0,0,,НАПЕЧАТАТЬ БИЛЕТЫ И РАССАДИТЬ ГОСТЕЙ. ПОХОЖЕ,
Dialogue: 0,0:02:36.10,0:02:38.32,Caption,,0,0,0,,ИМЕННО ЭТОТ РУБЕЖ ВСЁ ЧАЩЕ ПРИНИМАЮТ
Dialogue: 0,0:02:38.32,0:02:41.40,Caption,,0,0,0,,ЗА ВОЗМОЖНОЕ НАЧАЛО БОЛЬШОЙ ВОЙНЫ В ЕВРОПЕ. ПРИЧЁМ
Dialogue: 0,0:02:41.40,0:02:43.74,Caption,,0,0,0,,ПО РАЗМАХУ ОНА СПОСОБНА ОСТАВИТЬ УКРАИНСКИЙ
Dialogue: 0,0:02:43.74,0:02:46.74,Caption,,0,0,0,,КОНФЛИКТ ДАЛЕКО ПОЗАДИ. ТЕПЕРЬ И РОССИЙСКИЙ ПРОЕКТ,
Dialogue: 0,0:02:47.00,0:02:48.90,Caption,,0,0,0,,КРИТИЧЕСКИ ВАЖНЫЙ ДЛЯ КАЛИНИНГРАДА,
Dialogue: 0,0:02:49.19,0:02:51.22,Caption,,0,0,0,,ПРИВЯЗАН К ТОМУ ЖЕ СРОКУ. СЛИШКОМ
Dialogue: 0,0:02:51.22,0:02:54.74,Caption,,0,0,0,,МНОГИЕ БУДИЛЬНИКИ ЗАВЕДЕНЫ НА ОДИН ЧАС. СОСЕДИ ОБЛАСТИ
Dialogue: 0,0:02:54.74,0:02:57.57,Caption,,0,0,0,,ТОЖЕ НЕ ПРОВОДЯТ ВРЕМЯ ЗА ВЯЗАНИЕМ. ЛАТВИЙСКИЕ
Dialogue: 0,0:02:57.57,0:02:59.97,Caption,,0,0,0,,ВЛАСТИ ОБСУЖДАЮТ ПОЛНОЕ ПРЕКРАЩЕНИЕ РАБОТЫ
Dialogue: 0,0:02:59.97,0:03:03.08,Caption,,0,0,0,,ПЕРЕХОДОВ НА РОССИЙСКОЙ ГРАНИЦЕ. ФИНЛЯНДИЯ ЗАКРЫЛА
Dialogue: 0,0:03:03.08,0:03:05.68,Caption,,0,0,0,,СВОЮ ГРАНИЦУ ДЛЯ ЛЮДЕЙ ЕЩЁ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:03:05.68,0:03:08.11,Caption,,0,0,0,,ТРЕТЬЕМ ГОДУ. ЭСТОНИЯ СООБЩИЛА О ЗАКРЫТИИ
Dialogue: 0,0:03:08.11,0:03:11.23,Caption,,0,0,0,,АВТОМОБИЛЬНЫХ ПУНКТОВ. ЛИТВА ОГРАНИЧИВАЛА ТРАНЗИТ В
Dialogue: 0,0:03:11.23,0:03:14.12,Caption,,0,0,0,,КАЛИНИНГРАД И УСТРАИВАЛА ПРИГРАНИЧНЫЕ УЧЕНИЯ.
Dialogue: 0,0:03:14.12,0:03:16.10,Caption,,0,0,0,,ОСОБЕННО БОДРО ВЫСТУПАЕТ ЛАТВИЯ,
Dialogue: 0,0:03:16.34,0:03:18.13,Caption,,0,0,0,,ХОТЯ ОБЩЕЙ ГРАНИЦЫ С КАЛИНИНГРАДСКОЙ
Dialogue: 0,0:03:18.13,0:03:21.22,Caption,,0,0,0,,ОБЛАСТЬЮ У НЕЁ НЕТ. КОГДА СОБСТВЕННЫЙ ДВОР В СТОРОНЕ,
Dialogue: 0,0:03:21.54,0:03:25.56,Caption,,0,0,0,,ОЧЕНЬ ЛЕГКО ОБЪЯСНЯТЬ СОСЕДУ, ГДЕ ЕМУ ПОСТАВИТЬ ЗАБОР И НАСКОЛЬКО
Dialogue: 0,0:03:25.56,0:03:28.37,Caption,,0,0,0,,ВЫСОКО ЕГО ПОДНЯТЬ. ВОИНСТВЕННЫЕ ПЛАНЫ РИГИ
Dialogue: 0,0:03:28.37,0:03:32.52,Caption,,0,0,0,,ЗАТРАГИВАЮТ ДАЖЕ ТЕХ ГРАЖДАН, КОТОРЫЕ ПОСТОЯННО ЖИВУТ ЗА ПРЕДЕЛАМИ
Dialogue: 0,0:03:32.52,0:03:37.20,Caption,,0,0,0,,СТРАНЫ. В ОБЯЗАТЕЛЬНУЮ ЖЕРЕБЬЁВКУ ДЛЯ ПРИЗЫВА
Dialogue: 0,0:03:37.20,0:03:39.67,Caption,,0,0,0,,ВПЕРВЫЕ ВКЛЮЧАЮТ МОЛОДЫХ ЛАТВИЙЦЕВ ИЗ ДРУГИХ
Dialogue: 0,0:03:39.67,0:03:42.15,Caption,,0,0,0,,ГОСУДАРСТВ. СРЕДИ НИХ МОГУТ ОКАЗАТЬСЯ ЛЮДИ,
Dialogue: 0,0:03:42.39,0:03:46.54,Caption,,0,0,0,,РОДИВШИЕСЯ ЗА ГРАНИЦЕЙ, ВЫРОСШИЕ ТАМ И ПОЧТИ НЕ ВЛАДЕЮЩИЕ
Dialogue: 0,0:03:46.54,0:03:50.08,Caption,,0,0,0,,ЛАТЫШСКИМ ЯЗЫКОМ. ПРЕДСТАВЬТЕ СЮРПРИЗ. ЧЕЛОВЕК ЗНАЕТ
Dialogue: 0,0:03:50.08,0:03:51.83,Caption,,0,0,0,,ЛАТВИЮ ПО СЕМЕЙНЫМ ФОТОГРАФИЯМ,
Dialogue: 0,0:03:52.22,0:03:54.26,Caption,,0,0,0,,А ЛАТВИЯ ВНЕЗАПНО ЗНАЕТ ЕГО РАЗМЕР
Dialogue: 0,0:03:54.26,0:03:56.81,Caption,,0,0,0,,ФОРМЫ. ГОСУДАРСТВЕННАЯ ПАМЯТЬ ИНОГДА РАБОТАЕТ
Dialogue: 0,0:03:56.81,0:03:59.75,Caption,,0,0,0,,ИЗБИРАТЕЛЬНО, НО ПЕРЕД ПРИЗЫВОМ ЧУДЕСНЫМ ОБРАЗОМ
Dialogue: 0,0:03:59.75,0:04:01.50,Caption,,0,0,0,,ВОССТАНАВЛИВАЕТСЯ. ЭТО ЕЩЁ ОДИН
Dialogue: 0,0:04:01.50,0:04:04.07,Caption,,0,0,0,,ПРИЗНАК ПОДГОТОВКИ К СЕРЬЁЗНОМУ СТОЛКНОВЕНИЮ,
Dialogue: 0,0:04:04.31,0:04:05.93,Caption,,0,0,0,,КОТОРОЕ В ЕВРОПЕЙСКИХ КАБИНЕТАХ
Dialogue: 0,0:04:05.93,0:04:09.03,Caption,,0,0,0,,ПОМЕЩАЮТ КУДА ТО В БУДУЩЕЕ. ТОЛЬКО ВОЙНА НЕ СТАЛА ЖДАТЬ,
Dialogue: 0,0:04:09.23,0:04:11.37,Caption,,0,0,0,,ПОКА ЧИНОВНИКИ ЗАКОНЧАТ ТАБЛИЦЫ. ОНА
Dialogue: 0,0:04:11.37,0:04:14.48,Caption,,0,0,0,,УЖЕ ДОБРАЛАСЬ ДО ИХ МОРСКИХ ВОРОТ. В ФИНСКОМ ЗАЛИВЕ
Dialogue: 0,0:04:14.48,0:04:17.14,Caption,,0,0,0,,АТАКОВАЛИ РОССИЙСКОЕ СУДНО. ПОЗДНЕЕ ЗЕЛЕНСКИЙ
Dialogue: 0,0:04:17.14,0:04:19.92,Caption,,0,0,0,,ПОДТВЕРДИЛ УЧАСТИЕ УКРАИНЫ И ИЗЛОЖИЛ ЛОГИКУ
Dialogue: 0,0:04:19.92,0:04:22.55,Caption,,0,0,0,,ВЫБОРА ЦЕЛЕЙ. В НЕЙ ФИГУРИРУЮТ РОССИЙСКИЙ ФЛАГ,
Dialogue: 0,0:04:22.86,0:04:25.94,Caption,,0,0,0,,ПЕРЕВОЗКА ОРУЖИЯ, САНКЦИОННЫЕ ГРУЗЫ И ВОЗМОЖНОСТЬ
Dialogue: 0,0:04:25.94,0:04:28.32,Caption,,0,0,0,,ДЕЙСТВИЙ В НЕЙТРАЛЬНЫХ ВОДАХ. ПОСЛЕ ЭТОГО
Dialogue: 0,0:04:28.32,0:04:31.58,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ БОДРОСТЬ ЗАМЕТНО СБАВИЛА ОБОРОТЫ. ФИНСКИЙ
Dialogue: 0,0:04:31.58,0:04:34.52,Caption,,0,0,0,,ПРЕМЬЕР ПЕТТЕРИ ОРПО ПРИЗНАЁТ ПРАВО УКРАИНЫ
Dialogue: 0,0:04:34.52,0:04:37.71,Caption,,0,0,0,,ЗАЩИЩАТЬСЯ. МИНИСТР ОБОРОНЫ ГЕРМАНИИ БОРИС ПИСТОРИУС
Dialogue: 0,0:04:37.71,0:04:40.25,Caption,,0,0,0,,ОДНОВРЕМЕННО ТРЕБУЕТ НЕ ПЕРЕНОСИТЬ ВОЙНУ В
Dialogue: 0,0:04:40.25,0:04:43.53,Caption,,0,0,0,,БАЛТИЙСКОЕ МОРЕ И ПОДЧЁРКИВАЕТ ОСОБУЮ ОТВЕТСТВЕННОСТЬ
Dialogue: 0,0:04:43.53,0:04:48.03,Caption,,0,0,0,,КИЕВА. НОРВЕЖСКИЙ МИНИСТР ОБОРОНЫ ТОРЕ
Dialogue: 0,0:04:48.03,0:04:51.46,Caption,,0,0,0,,САНДВИК НАПОМИНАЕТ О РЕГИОНАЛЬНОЙ СТАБИЛЬНОСТИ. ВОТ И ВЕСЬ
Dialogue: 0,0:04:51.46,0:04:54.43,Caption,,0,0,0,,ОБЩИЙ СТРОЙ. ПОКА РЕЧЬ ИДЁТ О ПОМОЩИ УКРАИНЕ,
Dialogue: 0,0:04:54.62,0:04:57.15,Caption,,0,0,0,,ПЛЕЧИ РАСПРАВЛЕНЫ. КОГДА У ЕВРОПЕЙСКОГО БЕРЕГА
Dialogue: 0,0:04:57.15,0:05:00.51,Caption,,0,0,0,,ВСПЫХИВАЕТ ТОРГОВОЕ СУДНО, КАЖДЫЙ НАЧИНАЕТ ПРОВЕРЯТЬ,
Dialogue: 0,0:05:00.83,0:05:02.51,Caption,,0,0,0,,НЕ ЛЕЖИТ ЛИ ЕГО КОШЕЛЁК В ТОМ ЖЕ
Dialogue: 0,0:05:02.51,0:05:04.53,Caption,,0,0,0,,КАРМАНЕ. ЭСТОНСКИЙ ПРЕМЬЕР КРИСТЕН
Dialogue: 0,0:05:04.53,0:05:07.76,Caption,,0,0,0,,МИХАЛ СНАЧАЛА ЗАЯВИЛ, ЧТО ПОДОБНЫЕ НАПАДЕНИЯ ПРИДЁТСЯ
Dialogue: 0,0:05:07.76,0:05:10.80,Caption,,0,0,0,,УЧИТЫВАТЬ И К НИМ НУЖНО ГОТОВИТЬСЯ. СЛУЖБЫ ЭСТОНИИ УЖЕ
Dialogue: 0,0:05:10.80,0:05:12.83,Caption,,0,0,0,,ТРЕНИРОВАЛИСЬ НА ПОХОЖИХ СЦЕНАРИЯХ,
Dialogue: 0,0:05:13.07,0:05:15.13,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЙ ФЛОТ ЗАРАНЕЕ РАЗБИРАЛ
Dialogue: 0,0:05:15.13,0:05:17.47,Caption,,0,0,0,,ВОЗМОЖНЫЕ ПРОИСШЕСТВИЯ. ПОДГОТОВКА,
Dialogue: 0,0:05:17.58,0:05:20.69,Caption,,0,0,0,,СТАЛО БЫТЬ, ШЛА НЕ ПОСЛЕ СИГНАЛА ТРЕВОГИ. СИГНАЛ
Dialogue: 0,0:05:20.69,0:05:24.35,Caption,,0,0,0,,ПРОСТО ПОДТВЕРДИЛ, ЧТО ПАПКУ НА СТОЛ ПОЛОЖИЛИ НЕ ЗРЯ. НО
Dialogue: 0,0:05:24.35,0:05:27.94,Caption,,0,0,0,,ЗАТЕМ ТАЛЛИН СООБЩИЛ, ЧТО НЕ ДАСТ ИСПОЛЬЗОВАТЬ ЭСТОНСКУЮ
Dialogue: 0,0:05:27.94,0:05:30.11,Caption,,0,0,0,,ТЕРРИТОРИЮ, ВОЗДУШНОЕ ПРОСТРАНСТВО И
Dialogue: 0,0:05:30.11,0:05:33.27,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ ВОДЫ ДЛЯ НАПАДЕНИЙ НА РОССИЮ. ПОЛУЧИЛАСЬ
Dialogue: 0,0:05:33.27,0:05:36.03,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ ИНСТРУКЦИЯ К АТАКАМ ПРИВЫКАЙТЕ,
Dialogue: 0,0:05:36.21,0:05:38.07,Caption,,0,0,0,,НО МАРШРУТ ЧЕРЕЗ НАШ ПОДЪЕЗД НЕ
Dialogue: 0,0:05:38.07,0:05:41.71,Caption,,0,0,0,,ПРОКЛАДЫВАЙТЕ. ФИНСКИЕ СЛУЖБЫ УЧАСТВУЮТ В ТУШЕНИИ.
Dialogue: 0,0:05:41.71,0:05:44.17,Caption,,0,0,0,,ЭСТОНСКИЙ КОРАБЛЬ НАПРАВЛЯЕТСЯ НА ПОМОЩЬ.
Dialogue: 0,0:05:44.17,0:05:46.11,Caption,,0,0,0,,НАЧИНАЕТСЯ ПОДСЧЁТ МОРСКИХ МИЛЬ,
Dialogue: 0,0:05:46.35,0:05:48.61,Caption,,0,0,0,,ПРОВЕРКА ГРАНИЦ ТЕРРИТОРИАЛЬНЫХ ВОД И
Dialogue: 0,0:05:48.61,0:05:51.41,Caption,,0,0,0,,ВЫЯСНЕНИЕ, КОМУ ОТВЕЧАТЬ ЗА ПОСЛЕДСТВИЯ.
Dialogue: 0,0:05:51.41,0:05:54.21,Caption,,0,0,0,,ОКАЗАЛОСЬ, ЧТО БАЛТИКА СУЩЕСТВУЕТ НЕ ТОЛЬКО НА
Dialogue: 0,0:05:54.21,0:05:59.11,Caption,,0,0,0,,ШТАБНОЙ КАРТЕ. В НЕЙ ХОДЯТ ГРАЖДАНСКИЕ СУДА,
Dialogue: 0,0:05:59.34,0:06:03.03,Caption,,0,0,0,,РАБОТАЮТ ПОРТЫ, СТРАХОВЫЕ КОМПАНИИ ВЫСТАВЛЯЮТ СЧЕТА,
Dialogue: 0,0:06:03.26,0:06:05.48,Caption,,0,0,0,,А ПРИБРЕЖНЫЕ ГОРОДА НЕ ХОТЯТ ПОЛУЧИТЬ
Dialogue: 0,0:06:05.48,0:06:07.59,Caption,,0,0,0,,ЧУЖУЮ ВОЙНУ ВМЕСТЕ С ВЕТРОМ И ТЕЧЕНИЕМ.
Dialogue: 0,0:06:08.29,0:06:10.88,Caption,,0,0,0,,РОССИЯ ВЫЗЫВАЕТ ПОСЛА ЭСТОНИИ. МОСКВА
Dialogue: 0,0:06:10.88,0:06:13.75,Caption,,0,0,0,,ЗАЯВЛЯЕТ, ЧТО ОТНОШЕНИЯ ПРИБЛИЗИЛИСЬ К ОТКРЫТОМУ
Dialogue: 0,0:06:13.75,0:06:16.90,Caption,,0,0,0,,СТОЛКНОВЕНИЮ, ОБВИНЯЕТ ТАЛЛИН В СОДЕЙСТВИИ ПРОЛЁТУ
Dialogue: 0,0:06:16.90,0:06:19.30,Caption,,0,0,0,,УКРАИНСКИХ БЕСПИЛОТНИКОВ И В ОГРАНИЧЕНИИ
Dialogue: 0,0:06:19.30,0:06:22.24,Caption,,0,0,0,,РОССИЙСКОГО СУДОХОДСТВА. ПОКА ОТВЕТ ОСТАЁТСЯ НА
Dialogue: 0,0:06:22.24,0:06:24.94,Caption,,0,0,0,,УРОВНЕ ОФИЦИАЛЬНЫХ МЕР И ДИПЛОМАТИЧЕСКИХ
Dialogue: 0,0:06:24.94,0:06:28.18,Caption,,0,0,0,,КАНАЛОВ. ВНУТРИ РОССИИ ТАКАЯ РЕАКЦИЯ УСТРАИВАЕТ ДАЛЕКО
Dialogue: 0,0:06:28.18,0:06:30.63,Caption,,0,0,0,,НЕ ВСЕХ. КРАСНАЯ ЧЕРТА ИМЕЕТ СМЫСЛ,
Dialogue: 0,0:06:31.10,0:06:32.72,Caption,,0,0,0,,ЕСЛИ ЗА НЕЙ ДЕЙСТВИТЕЛЬНО МЕНЯЮТСЯ
Dialogue: 0,0:06:32.72,0:06:35.88,Caption,,0,0,0,,ПРАВИЛА. КОГДА ПОСЛЕ КАЖДОГО ПЕРЕСЕЧЕНИЯ РИСУЮТ
Dialogue: 0,0:06:35.88,0:06:39.91,Caption,,0,0,0,,СЛЕДУЮЩУЮ, А ЗАТЕМ ЕЩЁ ОДНУ, КАРТА ПОСТЕПЕННО ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:06:39.91,0:06:42.39,Caption,,0,0,0,,ТЕТРАДЬ ПЕРВОКЛАССНИКА. ЦВЕТА МНОГО,
Dialogue: 0,0:06:42.63,0:06:45.04,Caption,,0,0,0,,ПОСЛЕДСТВИЯ НЕ ВИДНЫ. РАЗДРАЖЕНИЕ
Dialogue: 0,0:06:45.04,0:06:47.32,Caption,,0,0,0,,ПОНЯТНО. НО У РОССИЙСКОГО РУКОВОДСТВА
Dialogue: 0,0:06:47.32,0:06:49.43,Caption,,0,0,0,,ОТВЕТСТВЕННОСТЬ СОВСЕМ ИНОГО ВЕСА,
Dialogue: 0,0:06:49.67,0:06:52.89,Caption,,0,0,0,,ЧЕМ У ЧЕЛОВЕКА, КОТОРЫЙ ЗА МИНУТУ НАБИРАЕТ СЕРДИТЫЙ
Dialogue: 0,0:06:52.89,0:06:54.87,Caption,,0,0,0,,КОММЕНТАРИЙ И ОТПРАВЛЯЕТСЯ ПИТЬ ЧАЙ.
Dialogue: 0,0:06:55.56,0:06:58.47,Caption,,0,0,0,,ОДНАКО БЕСКОНЕЧНО ИЗОБРАЖАТЬ СПОКОЙСТВИЕ ТОЖЕ НЕ
Dialogue: 0,0:06:58.47,0:07:01.29,Caption,,0,0,0,,ПОЛУЧИТСЯ. ЕСЛИ ПРЕДУПРЕЖДЕНИЕ НИЧЕМ НЕ
Dialogue: 0,0:07:01.29,0:07:04.21,Caption,,0,0,0,,ПОДКРЕПЛЯЕТСЯ, ЕГО ПЕРЕСТАЮТ ВОСПРИНИМАТЬ КАК
Dialogue: 0,0:07:04.21,0:07:07.03,Caption,,0,0,0,,ОГРАНИЧЕНИЕ. ОНО СТАНОВИТСЯ УКРАШЕНИЕМ СТЕНЫ,
Dialogue: 0,0:07:07.26,0:07:09.66,Caption,,0,0,0,,РЯДОМ С КАЛЕНДАРЁМ И ЧАСАМИ. ПОХОЖАЯ
Dialogue: 0,0:07:09.66,0:07:15.17,Caption,,0,0,0,,НЕРВОЗНОСТЬ ВИДНА В ПОЛЬШЕ. РОССИЙСКИЙ БЕСПИЛОТНИК ОКАЗАЛСЯ В
Dialogue: 0,0:07:15.17,0:07:18.13,Caption,,0,0,0,,ПОЛЬСКОМ ВОЗДУШНОМ ПРОСТРАНСТВЕ НАД ХЕЛМОМ. СИСТЕМА
Dialogue: 0,0:07:18.13,0:07:20.34,Caption,,0,0,0,,ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ БЫЛА ГОТОВА,
Dialogue: 0,0:07:20.59,0:07:22.66,Caption,,0,0,0,,РАЗРЕШЕНИЕ НА УНИЧТОЖЕНИЕ ЦЕЛИ,
Dialogue: 0,0:07:22.74,0:07:26.40,Caption,,0,0,0,,ПО ПОЛЬСКОЙ ВЕРСИИ, ИМЕЛОСЬ. СТРЕЛЯТЬ ВСЁ ЖЕ НЕ СТАЛИ.
Dialogue: 0,0:07:26.40,0:07:29.27,Caption,,0,0,0,,АППАРАТ РАЗВЕРНУЛСЯ В СТОРОНУ УКРАИНЫ. ВОЕННЫЕ
Dialogue: 0,0:07:29.27,0:07:31.74,Caption,,0,0,0,,РЕШИЛИ, ЧТО ОБЛОМКИ ПОСЛЕ ПОРАЖЕНИЯ МОГУТ
Dialogue: 0,0:07:31.74,0:07:34.26,Caption,,0,0,0,,СОЗДАТЬ ДЛЯ ЖИТЕЛЕЙ ГОРОДА БОЛЬШУЮ ОПАСНОСТЬ,
Dialogue: 0,0:07:34.43,0:07:36.61,Caption,,0,0,0,,ЧЕМ САМ БЕСПИЛОТНИК. ИМЕННО В ТАКИЕ
Dialogue: 0,0:07:36.61,0:07:39.33,Caption,,0,0,0,,МИНУТЫ ЗАКАНЧИВАЕТСЯ ПАРАД РЕЧЕЙ И НАЧИНАЕТСЯ
Dialogue: 0,0:07:39.33,0:07:42.21,Caption,,0,0,0,,НОРМАЛЬНЫЙ РАСЧЁТ. НАЖАТЬ КНОПКУ НЕСЛОЖНО.
Dialogue: 0,0:07:42.21,0:07:45.36,Caption,,0,0,0,,ТРУДНЕЕ ПОНЯТЬ, НА ЧЕЙ ДОМ ЧЕРЕЗ НЕСКОЛЬКО СЕКУНД
Dialogue: 0,0:07:45.36,0:07:48.26,Caption,,0,0,0,,УПАДУТ ЖЕЛЕЗО И ВЗРЫВЧАТКА. РЕШЕНИЕ НЕ СТРЕЛЯТЬ
Dialogue: 0,0:07:48.26,0:07:51.50,Caption,,0,0,0,,ВЫГЛЯДИТ РАЗУМНЫМ. ЗАОДНО ОНО ПРЕКРАСНО ПОКАЗЫВАЕТ
Dialogue: 0,0:07:51.50,0:07:54.60,Caption,,0,0,0,,РАССТОЯНИЕ МЕЖДУ ВОИНСТВЕННЫМ ВЫСТУПЛЕНИЕМ И РЕАЛЬНОЙ
Dialogue: 0,0:07:54.60,0:07:57.67,Caption,,0,0,0,,ЦЕЛЬЮ НАД НАСЕЛЁННЫМ ГОРОДОМ. НА ТРИБУНЕ НИЧТО
Dialogue: 0,0:07:57.67,0:08:00.30,Caption,,0,0,0,,НЕ ПАДАЕТ ВАМ НА ГОЛОВУ. У ОПЕРАТОРА ТАКОЙ
Dialogue: 0,0:08:00.30,0:08:03.66,Caption,,0,0,0,,ПРИВИЛЕГИИ НЕТ. ПОЛЬСКИЕ СПОРЫ ВОКРУГ РОССИЙСКОГО
Dialogue: 0,0:08:03.66,0:08:06.32,Caption,,0,0,0,,ПОСЛА УСТРОЕНЫ ПОХОЖИМ ОБРАЗОМ. ОДНИ ТРЕБУЮТ
Dialogue: 0,0:08:06.32,0:08:10.02,Caption,,0,0,0,,НЕМЕДЛЕННОЙ ВЫСЫЛКИ. ЗАМЕСТИТЕЛЬ МИНИСТРА ОБОРОНЫ ОТВЕЧАЕТ,
Dialogue: 0,0:08:10.34,0:08:11.94,Caption,,0,0,0,,ЧТО МОСКВА ПОСТУПИТ ЗЕРКАЛЬНО,
Dialogue: 0,0:08:12.26,0:08:14.56,Caption,,0,0,0,,ПОЛЬША ЛИШИТСЯ ПОСОЛЬСТВА В РОССИИ И
Dialogue: 0,0:08:14.56,0:08:17.47,Caption,,0,0,0,,ПОТЕРЯЕТ ОДИН ИЗ КАНАЛОВ НАБЛЮДЕНИЯ ЗА ПРОИСХОДЯЩИМ
Dialogue: 0,0:08:17.47,0:08:19.70,Caption,,0,0,0,,ВНУТРИ СТРАНЫ. ГРОМКИЙ ЖЕСТ ХОРОШ,
Dialogue: 0,0:08:19.94,0:08:21.92,Caption,,0,0,0,,ПОКА К НЕМУ НЕ ПРИЛОЖИЛИ ЦЕННИК. ПОСЛЕ
Dialogue: 0,0:08:21.92,0:08:24.29,Caption,,0,0,0,,ЭТОГО ДАЖЕ САМЫЕ РЕШИТЕЛЬНЫЕ ЛЮДИ ПОЧЕМУ ТО
Dialogue: 0,0:08:24.29,0:08:26.74,Caption,,0,0,0,,НАЧИНАЮТ ВНИМАТЕЛЬНО ЧИТАТЬ МЕЛКИЙ ШРИФТ.
Dialogue: 0,0:08:29.01,0:08:31.33,Caption,,0,0,0,,ЕСЛИ ВАМ НУЖЕН РАЗГОВОР БЕЗ СОРЕВНОВАНИЯ В
Dialogue: 0,0:08:31.33,0:08:34.06,Caption,,0,0,0,,ДЕЦИБЕЛАХ, ПОДПИШИТЕСЬ. СИЛА ГОСУДАРСТВА
Dialogue: 0,0:08:34.06,0:08:37.43,Caption,,0,0,0,,ИЗМЕРЯЕТСЯ НЕ ТЕМ, НАСКОЛЬКО ГРОЗНО ЧИНОВНИК НАХМУРИЛСЯ
Dialogue: 0,0:08:37.43,0:08:40.21,Caption,,0,0,0,,ПЕРЕД КАМЕРОЙ. А ДАЛЬШЕ ГЕОГРАФИЯ РАСШИРЯЕТСЯ,
Dialogue: 0,0:08:40.44,0:08:42.19,Caption,,0,0,0,,И БАЛТИКА ОКАЗЫВАЕТСЯ ЛИШЬ ПЕРВОЙ
Dialogue: 0,0:08:42.19,0:08:45.80,Caption,,0,0,0,,ОСТАНОВКОЙ. ЗЕЛЕНСКИЙ НАЗВАЛ ЗАКОННЫМИ ЦЕЛЯМИ
Dialogue: 0,0:08:45.80,0:08:48.72,Caption,,0,0,0,,РОССИЙСКИЕ СУДА, КОРАБЛИ С ОРУЖИЕМ И ТРАНСПОРТ С
Dialogue: 0,0:08:48.72,0:08:51.94,Caption,,0,0,0,,САНКЦИОННЫМИ ГРУЗАМИ. ЕГО ФОРМУЛА РАСПРОСТРАНЯЕТСЯ
Dialogue: 0,0:08:51.94,0:08:54.41,Caption,,0,0,0,,И НА НЕЙТРАЛЬНЫЕ ВОДЫ. ТРЕВОГУ СОЮЗНИКОВ
Dialogue: 0,0:08:54.41,0:08:57.10,Caption,,0,0,0,,УКРАИНЫ НЕТРУДНО ПОНЯТЬ. ПОД ТАКОЕ ПРАВИЛО МОЖНО
Dialogue: 0,0:08:57.10,0:09:00.39,Caption,,0,0,0,,ПОДВЕСТИ СЛИШКОМ МНОГОЕ. ДОСТАТОЧНО АТАКОВАТЬ СУДНО ПОД
Dialogue: 0,0:09:00.39,0:09:02.37,Caption,,0,0,0,,ФЛАГОМ МАЛЬТЫ, А ЗАТЕМ ОБЪЯВИТЬ,
Dialogue: 0,0:09:02.53,0:09:04.65,Caption,,0,0,0,,ЧТО ВЛАДЕЛЬЦЫ У НЕГО УКРАИНСКИЕ ЛИБО В
Dialogue: 0,0:09:04.65,0:09:06.77,Caption,,0,0,0,,ТРЮМЕ НАХОДИЛОСЬ ОРУЖИЕ. ПОКА ЮРИСТЫ
Dialogue: 0,0:09:06.77,0:09:08.53,Caption,,0,0,0,,УСТАНОВЯТ ЦЕПОЧКУ СОБСТВЕННОСТИ,
Dialogue: 0,0:09:08.86,0:09:10.89,Caption,,0,0,0,,ОТ КОРАБЛЯ МОЖЕТ ОСТАТЬСЯ ТОЛЬКО СЧЁТ
Dialogue: 0,0:09:10.89,0:09:13.17,Caption,,0,0,0,,ЗА ТУШЕНИЕ. УКРАИНСКИЕ КОМПАНИИ,
Dialogue: 0,0:09:13.26,0:09:16.68,Caption,,0,0,0,,ИМУЩЕСТВО, СУДА И ОБСЛУЖИВАЮЩИЕ ОБЪЕКТЫ ТОЖЕ
Dialogue: 0,0:09:16.68,0:09:20.39,Caption,,0,0,0,,НАХОДЯТСЯ ЗА РУБЕЖОМ. ЕСЛИ РОССИЙСКУЮ СОБСТВЕННОСТЬ В
Dialogue: 0,0:09:20.39,0:09:23.17,Caption,,0,0,0,,ТРЕТЬЕЙ СТРАНЕ РАЗРЕШЕНО АТАКОВАТЬ ПО ОДНОМУ ПРИЗНАКУ
Dialogue: 0,0:09:23.17,0:09:26.87,Caption,,0,0,0,,ПРОИСХОЖДЕНИЯ, ВОЗНИКАЕТ ОЧЕВИДНЫЙ ЗЕРКАЛЬНЫЙ ВОПРОС.
Dialogue: 0,0:09:26.87,0:09:29.33,Caption,,0,0,0,,ПОЧЕМУ УКРАИНСКОЕ ИМУЩЕСТВО ЗА ГРАНИЦЕЙ
Dialogue: 0,0:09:29.33,0:09:31.25,Caption,,0,0,0,,ДОЛЖНО СЧИТАТЬСЯ НЕПРИКОСНОВЕННЫМ?
Dialogue: 0,0:09:32.04,0:09:33.70,Caption,,0,0,0,,СЛЕДУЮЩАЯ ТОЧКА НАХОДИТСЯ УЖЕ В
Dialogue: 0,0:09:33.70,0:09:36.53,Caption,,0,0,0,,СРЕДИЗЕМНОМ МОРЕ. ЗЕЛЕНСКИЙ ПОДТВЕРДИЛ УКРАИНСКОЕ
Dialogue: 0,0:09:36.53,0:09:39.53,Caption,,0,0,0,,НАПАДЕНИЕ НА РОССИЙСКИЕ СУДА ВОЗЛЕ БЕНГАЗИ И НАЗВАЛ
Dialogue: 0,0:09:39.53,0:09:41.49,Caption,,0,0,0,,ПРОВЕДЁННУЮ ОПЕРАЦИЮ ОБРАЗЦОВОЙ.
Dialogue: 0,0:09:43.69,0:09:46.79,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, В НЕЙ УЧАСТВОВАЛИ СЕМЬ МОРСКИХ
Dialogue: 0,0:09:46.79,0:09:49.99,Caption,,0,0,0,,БЕСПИЛОТНИКОВ. КИЕВ ЗАЯВИЛ ОБ УНИЧТОЖЕНИИ КОРВЕТА
Dialogue: 0,0:09:49.99,0:09:52.69,Caption,,0,0,0,,МЕРКУРИЙ, ВЕРТОЛЁТА КА ДВАДЦАТЬ СЕМЬ И О
Dialogue: 0,0:09:52.69,0:09:56.52,Caption,,0,0,0,,ПОВРЕЖДЕНИИ СУХОГРУЗА АНГАРА. МЕСТО ЗАПУСКА ДРОНОВ НАЗВАНО
Dialogue: 0,0:09:56.52,0:09:59.60,Caption,,0,0,0,,НЕ БЫЛО. ОБСУЖДАЮТСЯ ДВЕ ВЕРСИИ АЛБАНСКАЯ
Dialogue: 0,0:09:59.60,0:10:03.16,Caption,,0,0,0,,ТЕРРИТОРИЯ ЛИБО СКРЫТАЯ БАЗА В ЗАПАДНОЙ ЧАСТИ ЛИВИИ.
Dialogue: 0,0:10:03.16,0:10:06.55,Caption,,0,0,0,,ОБЕ ВЕРСИИ ПОДВОДЯТ К ОДНОМУ ВОПРОСУ. КТО ОТКРЫЛ
Dialogue: 0,0:10:06.55,0:10:09.03,Caption,,0,0,0,,ВОРОТА И ПОЗВОЛИЛ ПРОВЕСТИ ЗАПУСК СО СВОЕЙ
Dialogue: 0,0:10:09.03,0:10:11.46,Caption,,0,0,0,,ЗЕМЛИ? МОРСКОЙ БЕСПИЛОТНИК НЕ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:10:11.46,0:10:14.32,Caption,,0,0,0,,ВОЗЛЕ БЕНГАЗИ ПОСЛЕ ДОБРОГО ПОЖЕЛАНИЯ. ЕГО НАДО
Dialogue: 0,0:10:14.32,0:10:16.57,Caption,,0,0,0,,ДОСТАВИТЬ, ПОДГОТОВИТЬ И ОТПРАВИТЬ.
Dialogue: 0,0:10:17.14,0:10:19.46,Caption,,0,0,0,,О РЕЗУЛЬТАТАХ УДАРА ЕЩЁ МОГУТ СПОРИТЬ.
Dialogue: 0,0:10:19.46,0:10:21.85,Caption,,0,0,0,,ГЕОГРАФИЮ СПОРОМ НЕ УБЕРЁШЬ. ЛИВИЯ,
Dialogue: 0,0:10:22.01,0:10:25.13,Caption,,0,0,0,,СРЕДИЗЕМНОЕ МОРЕ, АФРИКАНСКИЕ МАРШРУТЫ РОССИИ,
Dialogue: 0,0:10:25.31,0:10:27.98,Caption,,0,0,0,,ПОРТЫ И СНАБЖЕНИЕ УЖЕ ОКАЗАЛИСЬ ВНУТРИ
Dialogue: 0,0:10:27.98,0:10:30.88,Caption,,0,0,0,,КОНФЛИКТА. НА СХЕМЕ ВЫГЛЯДИТ УБЕДИТЕЛЬНО. ЕСТЬ
Dialogue: 0,0:10:30.88,0:10:33.72,Caption,,0,0,0,,ТОЛЬКО ОДНА НЕУДОБНАЯ МЕЛОЧЬ. БЕНГАЗИ ВОЙНУ
Dialogue: 0,0:10:33.72,0:10:37.57,Caption,,0,0,0,,УКРАИНЕ НЕ ОБЪЯВЛЯЛ. ЛИВИЙЦЫ ПОЭТОМУ ЗАДАЮТ ВПОЛНЕ РЕЗОННЫЙ
Dialogue: 0,0:10:37.57,0:10:40.90,Caption,,0,0,0,,ВОПРОС ВЫ ВООБЩЕ ПОНИМАЕТЕ, В ЧЬЕЙ СТРАНЕ ПРОВОДИТЕ СВОЮ
Dialogue: 0,0:10:40.90,0:10:44.63,Caption,,0,0,0,,ОБРАЗЦОВУЮ ОПЕРАЦИЮ? ЗАМЕСТИТЕЛЬ ГЛАВЫ ПРЕЗИДЕНТСКОГО
Dialogue: 0,0:10:44.63,0:10:47.57,Caption,,0,0,0,,СОВЕТА ЛИВИИ МУСА АЛЬ КУНИ ПРИРАВНЯЛ СЛУЧИВШЕЕСЯ К
Dialogue: 0,0:10:47.57,0:10:50.53,Caption,,0,0,0,,ОБЪЯВЛЕНИЮ ВОЙНЫ. ПРЕДСТАВИТЕЛИ СТРАНЫ ЗАЯВИЛИ О
Dialogue: 0,0:10:50.53,0:10:54.41,Caption,,0,0,0,,НАРУШЕНИИ СУВЕРЕНИТЕТА, МАТЕРИАЛЬНОМ УЩЕРБЕ И РАНЕНЫХ МИРНЫХ
Dialogue: 0,0:10:54.41,0:10:58.96,Caption,,0,0,0,,ЖИТЕЛЯХ. В ЧИСЛЕ ВОЗМОЖНЫХ ШАГОВ ПРОЗВУЧАЛИ
Dialogue: 0,0:10:58.96,0:11:01.10,Caption,,0,0,0,,ОБРАЩЕНИЯ В СОВЕТ БЕЗОПАСНОСТИ ООН,
Dialogue: 0,0:11:01.38,0:11:03.52,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ СУД И ДРУГИЕ ОРГАНЫ.
Dialogue: 0,0:11:03.52,0:11:06.30,Caption,,0,0,0,,ТАКЖЕ ПОСТУПИЛО ТРЕБОВАНИЕ ПРОВЕСТИ ЭКСТРЕННОЕ
Dialogue: 0,0:11:06.30,0:11:09.61,Caption,,0,0,0,,ЗАСЕДАНИЕ СОВБЕЗА ООН, ВНЕСТИ ЗЕЛЕНСКОГО В СПИСОК
Dialogue: 0,0:11:09.61,0:11:12.68,Caption,,0,0,0,,ПОДОЗРЕВАЕМЫХ В ТЕРРОРИЗМЕ И ПРИНЯТЬ МЕРЫ ПРОТИВ
Dialogue: 0,0:11:12.68,0:11:16.52,Caption,,0,0,0,,ПОДОБНЫХ АТАК. ВОЕННЫМ КОМИТЕТАМ ЛИВИИ ПРЕДЛОЖИЛИ
Dialogue: 0,0:11:16.52,0:11:19.81,Caption,,0,0,0,,СОБРАТЬСЯ И ОПРЕДЕЛИТЬ ДАЛЬНЕЙШУЮ РЕАКЦИЮ. КИЕВ
Dialogue: 0,0:11:19.81,0:11:23.26,Caption,,0,0,0,,ВРУЧАЕТ ОПЕРАЦИИ МЕДАЛЬ ЗА ОБРАЗЦОВОСТЬ. СТРАНА,
Dialogue: 0,0:11:23.48,0:11:25.18,Caption,,0,0,0,,НА ТЕРРИТОРИИ КОТОРОЙ ВСЁ ПРОИЗОШЛО,
Dialogue: 0,0:11:25.44,0:11:27.98,Caption,,0,0,0,,ДОСТАЁТ ПАПКУ С ОБВИНЕНИЯМИ. ВИДИМО,
Dialogue: 0,0:11:28.13,0:11:30.54,Caption,,0,0,0,,ОБРАЗЕЦ ПОПАЛСЯ НЕ ТОГО РАЗМЕРА. РЯДОМ
Dialogue: 0,0:11:30.54,0:11:33.26,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ СООБЩЕНИЕ О НАПАДЕНИИ НА ИРАНСКОЕ
Dialogue: 0,0:11:33.26,0:11:36.82,Caption,,0,0,0,,ТОРГОВОЕ СУДНО ALVAN. ЕСЛИ КРУГ ЦЕЛЕЙ РАСШИРЯЕТСЯ ОТ
Dialogue: 0,0:11:36.82,0:11:39.85,Caption,,0,0,0,,РОССИЙСКИХ ВОЕННЫХ ОБЪЕКТОВ И ГРУЗОВ ДО КОРАБЛЕЙ ТРЕТЬИХ
Dialogue: 0,0:11:39.85,0:11:43.26,Caption,,0,0,0,,ГОСУДАРСТВ, МЕНЯЕТСЯ УЖЕ ВЕСЬ МАСШТАБ РИСКА. ЕСЛИ
Dialogue: 0,0:11:43.26,0:11:45.72,Caption,,0,0,0,,НА МАРШРУТЕ ВВОДИТСЯ ЛОТЕРЕЯ С ВОПРОСАМИ О
Dialogue: 0,0:11:45.72,0:11:48.64,Caption,,0,0,0,,НАСТОЯЩЕМ ВЛАДЕЛЬЦЕ СУХОГРУЗА И ВОЗМОЖНОМ СОДЕРЖИМОМ
Dialogue: 0,0:11:48.64,0:11:51.84,Caption,,0,0,0,,КОНТЕЙНЕРОВ, ПЕРВЫМИ ПРОСЫПАЮТСЯ СТРАХОВЩИКИ. А ЭТИ
Dialogue: 0,0:11:51.84,0:11:54.45,Caption,,0,0,0,,ЛЮДИ УМЕЮТ ПРЕВРАЩАТЬ ЧУЖУЮ ТРЕВОГУ В ОЧЕНЬ
Dialogue: 0,0:11:54.45,0:11:57.76,Caption,,0,0,0,,ТОЧНУЮ СУММУ. ЛОНДОН ЗАНИМАЕТ В МОРСКОМ СТРАХОВАНИИ
Dialogue: 0,0:11:57.76,0:12:00.47,Caption,,0,0,0,,ДАЛЕКО НЕ ПОСЛЕДНЕЕ МЕСТО. ПОЭТОМУ ВОЗНИКАЕТ
Dialogue: 0,0:12:00.47,0:12:03.06,Caption,,0,0,0,,ВЕРСИЯ, ЧТО НЕСТАБИЛЬНОСТЬ НА ТОРГОВЫХ ПУТЯХ
Dialogue: 0,0:12:03.06,0:12:05.55,Caption,,0,0,0,,КОМУ ТО СПОСОБНА ПРИНОСИТЬ НЕ ТОЛЬКО УБЫТКИ.
Dialogue: 0,0:12:05.55,0:12:07.66,Caption,,0,0,0,,НЕКОТОРЫЕ ГОСУДАРСТВА ЗАВИСЯТ ОТ МОРСКИХ
Dialogue: 0,0:12:07.66,0:12:09.82,Caption,,0,0,0,,ПЕРЕВОЗОК ПРИМЕРНО НА СЕМЬДЕСЯТ ПРОЦЕНТОВ.
Dialogue: 0,0:12:12.02,0:12:14.13,Caption,,0,0,0,,БРИТАНИЯ ОТ МОРЯ ТОЖЕ ЗАВИСИТ ВЕСЬМА
Dialogue: 0,0:12:14.13,0:12:17.71,Caption,,0,0,0,,СЕРЬЁЗНО. СЛЕДОВАТЕЛЬНО, ЗАРАБАТЫВАТЬ НА БЕСПОРЯДКЕ МОЖНО ЛИШЬ
Dialogue: 0,0:12:17.71,0:12:21.01,Caption,,0,0,0,,ПРИ УВЕРЕННОСТИ, ЧТО СОБСТВЕННЫЕ МАРШРУТЫ ЗАЩИЩЕНЫ
Dialogue: 0,0:12:21.01,0:12:24.82,Caption,,0,0,0,,ЛУЧШЕ СОСЕДСКИХ. ЗА ВОЕННОЙ ГЕОГРАФИЕЙ СРАЗУ ТЯНЕТСЯ
Dialogue: 0,0:12:24.82,0:12:27.25,Caption,,0,0,0,,ДЕНЕЖНАЯ. НА БЛИЖАЙШЕЙ ВСТРЕЧЕ РУКОВОДИТЕЛИ
Dialogue: 0,0:12:27.25,0:12:30.12,Caption,,0,0,0,,ЕВРОСОЮЗА СОБИРАЮТСЯ ОБСУЖДАТЬ ДОПОЛНИТЕЛЬНУЮ ПОМОЩЬ
Dialogue: 0,0:12:30.12,0:12:33.43,Caption,,0,0,0,,УКРАИНЕ. РАЗМЕР НОВОГО КРЕДИТА МОЖЕТ ДОСТИГНУТЬ
Dialogue: 0,0:12:33.43,0:12:36.00,Caption,,0,0,0,,СОРОКА ПЯТИ МИЛЛИАРДОВ ЕВРО. ПОЯВЛЯЕТСЯ
Dialogue: 0,0:12:36.00,0:12:38.87,Caption,,0,0,0,,ПРЕДПОЛОЖЕНИЕ, ЧТО ПЕРЕД ТАКИМ РАЗГОВОРОМ КИЕВУ
Dialogue: 0,0:12:38.87,0:12:40.66,Caption,,0,0,0,,ПОНАДОБИЛСЯ ЗАМЕТНЫЙ РЕЗУЛЬТАТ.
Dialogue: 0,0:12:41.38,0:12:43.99,Caption,,0,0,0,,ПРОСЬБУ О НОВОЙ ОГРОМНОЙ СУММЕ УДОБНЕЕ
Dialogue: 0,0:12:43.99,0:12:46.18,Caption,,0,0,0,,СОПРОВОЖДАТЬ НЕ СЛОВАМИ О СТОЙКОСТИ,
Dialogue: 0,0:12:46.41,0:12:50.09,Caption,,0,0,0,,А ПЕРЕЧНЕМ ОПЕРАЦИЙ, КОТОРЫЕ МОЖНО ПОКАЗАТЬ СПОНСОРАМ.
Dialogue: 0,0:12:50.09,0:12:53.30,Caption,,0,0,0,,БАЛТИЙСКОЕ МОРЕ, БЕНГАЗИ, РОССИЙСКИЕ КОРАБЛИ,
Dialogue: 0,0:12:53.53,0:12:55.58,Caption,,0,0,0,,УВЕЛИЧЕНИЕ ДАЛЬНОСТИ И РАСШИРЕНИЕ
Dialogue: 0,0:12:55.58,0:12:59.03,Caption,,0,0,0,,РАЙОНА ДЕЙСТВИЙ. ПОСЫЛ ПОЛУЧАЕТСЯ ПОНЯТНЫМ ВЛОЖЕНИЯ
Dialogue: 0,0:12:59.03,0:13:01.54,Caption,,0,0,0,,РАБОТАЮТ, ИНСТРУМЕНТ ДОСТАЁТ ВСЁ ДАЛЬШЕ,
Dialogue: 0,0:13:01.70,0:13:04.26,Caption,,0,0,0,,КАССУ МОЖНО НЕ ЗАКРЫВАТЬ. ТЕПЕРЬ
Dialogue: 0,0:13:04.26,0:13:07.14,Caption,,0,0,0,,БРИТАНИЯ. ЕЁ КОНТРРАЗВЕДКА И ОБОРОННОЕ ВЕДОМСТВО
Dialogue: 0,0:13:07.14,0:13:10.73,Caption,,0,0,0,,ПРЕДУПРЕЖДАЮТ ПРЕДПРИЯТИЯ, СВЯЗАННЫЕ С ВОЕННЫМИ ПОСТАВКАМИ
Dialogue: 0,0:13:10.73,0:13:13.55,Caption,,0,0,0,,УКРАИНЕ, О ВОЗМОЖНЫХ РОССИЙСКИХ ДИВЕРСИЯХ.
Dialogue: 0,0:13:13.55,0:13:15.38,Caption,,0,0,0,,РОССИЙСКОЕ ПОСОЛЬСТВО ОТВЕЧАЕТ,
Dialogue: 0,0:13:15.62,0:13:17.54,Caption,,0,0,0,,ЧТО МОСКВА НЕ НАМЕРЕНА НАПАДАТЬ НА
Dialogue: 0,0:13:17.54,0:13:20.43,Caption,,0,0,0,,БРИТАНСКИЕ ЗАВОДЫ. ОДНОВРЕМЕННО БОРИС ДЖОНСОН
Dialogue: 0,0:13:20.43,0:13:23.35,Caption,,0,0,0,,ОТКРЫТО ГОВОРИТ ОБ ОПОСРЕДОВАННОЙ ВОЙНЕ БРИТАНИИ С
Dialogue: 0,0:13:23.35,0:13:27.81,Caption,,0,0,0,,РОССИЕЙ. ОН НАПОМИНАЕТ О МИЛЛИАРДАХ,
Dialogue: 0,0:13:27.91,0:13:32.75,Caption,,0,0,0,,БОЕПРИПАСАХ, ПОМОЩИ КИЕВУ, ВОЗМОЖНОМ ПОЯВЛЕНИИ ИНОСТРАННЫХ ВОЙСК
Dialogue: 0,0:13:32.75,0:13:37.07,Caption,,0,0,0,,И ВОЗМОЖНОСТЯХ НАТО. ФОРМУЛА ВЫХОДИТ ВОСХИТИТЕЛЬНАЯ. МЫ
Dialogue: 0,0:13:37.07,0:13:40.68,Caption,,0,0,0,,ДАЁМ ДЕНЬГИ, ОРУЖИЕ И СНАРЯДЫ. МЫ УЧАСТВУЕМ ЧЕРЕЗ
Dialogue: 0,0:13:40.68,0:13:44.20,Caption,,0,0,0,,ПОСРЕДНИКА. МЫ ОБСУЖДАЕМ ОТПРАВКУ СИЛ. НО ОТВЕТНЫЙ
Dialogue: 0,0:13:44.20,0:13:48.21,Caption,,0,0,0,,КУРЬЕР, ПОЖАЛУЙСТА, ПУСТЬ НАШ АДРЕС НЕ ЗАПИСЫВАЕТ. ИТАЛИЯ
Dialogue: 0,0:13:48.21,0:13:50.71,Caption,,0,0,0,,УЖЕ СМОТРИТ НА ПРОИСХОДЯЩЕЕ БЕЗ ПРЕЖНЕГО
Dialogue: 0,0:13:50.71,0:13:53.64,Caption,,0,0,0,,СПОКОЙСТВИЯ. ПОСЛЕ НАПАДЕНИЯ ВОЗЛЕ БЕНГАЗИ МИНИСТР
Dialogue: 0,0:13:53.64,0:13:56.51,Caption,,0,0,0,,ИНОСТРАННЫХ ДЕЛ АНТОНИО ТАЯНИ ЗАГОВОРИЛ ОБ УГРОЗЕ
Dialogue: 0,0:13:56.51,0:13:59.01,Caption,,0,0,0,,РАСПРОСТРАНЕНИЯ КОНФЛИКТА НА СРЕДИЗЕМНОМОРЬЕ.
Dialogue: 0,0:13:59.57,0:14:01.37,Caption,,0,0,0,,ОТ ИТАЛИИ ДО МЕСТА СОБЫТИЙ ВСЕГО
Dialogue: 0,0:14:01.37,0:14:04.84,Caption,,0,0,0,,НЕСКОЛЬКО СОТЕН КИЛОМЕТРОВ, А НЕСТАБИЛЬНОСТЬ В ЛИВИИ БЬЁТ ПО
Dialogue: 0,0:14:04.84,0:14:08.37,Caption,,0,0,0,,ИНТЕРЕСАМ РИМА НАПРЯМУЮ. ПОКА ВОЙНА НАХОДИТСЯ ДАЛЕКО,
Dialogue: 0,0:14:08.61,0:14:10.34,Caption,,0,0,0,,ЛЕГКО ОПЕРИРОВАТЬ ПРИНЦИПАМИ И
Dialogue: 0,0:14:10.34,0:14:13.38,Caption,,0,0,0,,ИСТОРИЧЕСКИМИ ЗАДАЧАМИ. КОГДА РАССТОЯНИЕ СОКРАЩАЕТСЯ
Dialogue: 0,0:14:13.38,0:14:15.09,Caption,,0,0,0,,ДО НЕСКОЛЬКИХ СОТЕН КИЛОМЕТРОВ,
Dialogue: 0,0:14:15.41,0:14:17.49,Caption,,0,0,0,,В КАБИНЕТАХ ВСПОМИНАЮТ О СВОИХ ПОРТАХ,
Dialogue: 0,0:14:17.65,0:14:19.97,Caption,,0,0,0,,ТОРГОВЫХ ПУТЯХ, КУРОРТНЫХ БЕРЕГАХ,
Dialogue: 0,0:14:20.28,0:14:22.57,Caption,,0,0,0,,ЭКОЛОГИЧЕСКОЙ БЕЗОПАСНОСТИ И СТОИМОСТИ
Dialogue: 0,0:14:22.57,0:14:25.68,Caption,,0,0,0,,ПЕРЕВОЗОК. СООБЩАЛОСЬ И О ПОПЫТКЕ НАПАДЕНИЯ НА
Dialogue: 0,0:14:25.68,0:14:29.39,Caption,,0,0,0,,ТАНКЕР В ИТАЛЬЯНСКОЙ САВОНЕ. ЕСЛИ БЫ ОНА ЗАКОНЧИЛАСЬ КРУПНОЙ
Dialogue: 0,0:14:29.39,0:14:32.81,Caption,,0,0,0,,ЭКОЛОГИЧЕСКОЙ АВАРИЕЙ, ИТАЛЬЯНЦАМ ПРИШЛОСЬ БЫ ОБСУЖДАТЬ УЖЕ
Dialogue: 0,0:14:32.81,0:14:36.01,Caption,,0,0,0,,НЕ АБСТРАКТНОЕ ПРАВО НА СОПРОТИВЛЕНИЕ. ОНИ СЧИТАЛИ БЫ
Dialogue: 0,0:14:36.01,0:14:38.68,Caption,,0,0,0,,УЩЕРБ У СОБСТВЕННОГО ПРИЧАЛА. ЕВРОПЕЙСКИЕ
Dialogue: 0,0:14:38.68,0:14:41.65,Caption,,0,0,0,,ВЛАСТИ ДОЛГО ПОМОГАЛИ РАЗНОСИТЬ СПИЧКИ ПО КОМНАТЕ.
Dialogue: 0,0:14:43.92,0:14:45.81,Caption,,0,0,0,,ТЕПЕРЬ ОДНА ИЗ НИХ ЧИРКНУЛА РЯДОМ С
Dialogue: 0,0:14:45.81,0:14:48.95,Caption,,0,0,0,,ЗАНАВЕСКОЙ, И ХОЗЯЕВА ТРЕБУЮТ НЕМЕДЛЕННО СОБЛЮДАТЬ
Dialogue: 0,0:14:48.95,0:14:51.34,Caption,,0,0,0,,ПРАВИЛА ПОЖАРНОЙ БЕЗОПАСНОСТИ. ПОЗДНОВАТО
Dialogue: 0,0:14:51.34,0:14:55.58,Caption,,0,0,0,,ЗАМЕТИЛИ ТКАНЬ. ГЛАВНОЕ ПРОТИВОРЕЧИЕ УЖЕ НЕ СПРЯЧЕШЬ.
Dialogue: 0,0:14:55.58,0:14:58.17,Caption,,0,0,0,,ЕВРОПА СТРОИТ ПЛАНЫ БОЛЬШОЙ ВОЙНЫ НА РУБЕЖЕ ДВЕ
Dialogue: 0,0:14:58.17,0:15:00.96,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТОГО ГОДА, ПЕРЕВООРУЖАЕТСЯ,
Dialogue: 0,0:15:01.20,0:15:04.49,Caption,,0,0,0,,ПЕРЕКРЫВАЕТ ГРАНИЦЫ, РАСШИРЯЕТ ПРИЗЫВ И УКРЕПЛЯЕТ
Dialogue: 0,0:15:04.49,0:15:08.22,Caption,,0,0,0,,ТРАНСПОРТНУЮ СИСТЕМУ. НО ВОЙНА НЕ ОБЯЗАНА ЯВЛЯТЬСЯ ПО
Dialogue: 0,0:15:08.22,0:15:11.96,Caption,,0,0,0,,ЗАПИСИ. ЕЙ БЕЗРАЗЛИЧНО, ЗАКОНЧИЛИ ЛИ МИНИСТРЫ ПОДГОТОВКУ
Dialogue: 0,0:15:11.96,0:15:15.29,Caption,,0,0,0,,ДОКЛАДОВ И УСПЕЛИ ЛИ ПАРЛАМЕНТЫ РАСПРЕДЕЛИТЬ ДЕНЬГИ. ОНА
Dialogue: 0,0:15:15.29,0:15:17.84,Caption,,0,0,0,,УЖЕ ВЫХОДИТ ЗА ПРЕДЕЛЫ УКРАИНЫ. СНАЧАЛА ЕЁ
Dialogue: 0,0:15:17.84,0:15:21.25,Caption,,0,0,0,,ПОСЛЕДСТВИЯ ПОЯВИЛИСЬ В БАЛТИЙСКОМ МОРЕ. ЗАТЕМ ОПЕРАЦИЯ
Dialogue: 0,0:15:21.25,0:15:24.29,Caption,,0,0,0,,ДОБРАЛАСЬ ДО СРЕДИЗЕМНОГО. ТЕПЕРЬ ТРЕТЬИ СТРАНЫ
Dialogue: 0,0:15:24.29,0:15:27.44,Caption,,0,0,0,,ОЦЕНИВАЮТ УЩЕРБ, ПРОВЕРЯЮТ СВОЙ СУВЕРЕНИТЕТ НА
Dialogue: 0,0:15:27.44,0:15:30.76,Caption,,0,0,0,,ПРОЧНОСТЬ И СПРАШИВАЮТ, КТО СОБИРАЕТСЯ ОПЛАЧИВАТЬ ЭТО
Dialogue: 0,0:15:30.76,0:15:33.55,Caption,,0,0,0,,ПРЕДСТАВЛЕНИЕ. МОЖНО ДОЛГО РАЗБРАСЫВАТЬ ПОРОХ ПО
Dialogue: 0,0:15:33.55,0:15:35.68,Caption,,0,0,0,,СОБСТВЕННОМУ ДВОРУ И УВЕРЯТЬ СОСЕДЕЙ,
Dialogue: 0,0:15:35.92,0:15:38.40,Caption,,0,0,0,,ЧТО ВСЁ ПОД КОНТРОЛЕМ. НО КОГДА ИСКРА
Dialogue: 0,0:15:38.40,0:15:40.96,Caption,,0,0,0,,ПАДАЕТ У ПОРОГА, ПОЗДНО ВОЗМУЩАТЬСЯ,
Dialogue: 0,0:15:41.20,0:15:43.03,Caption,,0,0,0,,ЧТО ОГОНЬ НЕ УВАЖАЕТ ЕВРОПЕЙСКИЙ
Dialogue: 0,0:15:43.03,0:15:43.60,Caption,,0,0,0,,КАЛЕНДАРЬ.
