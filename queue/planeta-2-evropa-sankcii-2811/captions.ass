Dialogue: 0,0:00:00.12,0:00:02.35,Caption,,0,0,0,,ЕВРОПА УЖЕ ПЯТЫЙ ГОД ХОДИТ НА РУССКОГО
Dialogue: 0,0:00:02.35,0:00:04.64,Caption,,0,0,0,,МЕДВЕДЯ С ОДНИМ ПАТРОНОМ В КАРМАНЕ.
Dialogue: 0,0:00:04.64,0:00:07.16,Caption,,0,0,0,,ВЫСТРЕЛИЛА, ВЕРНУЛАСЬ ЗА НОВЫМ ПАТРОНОМ,
Dialogue: 0,0:00:07.40,0:00:09.48,Caption,,0,0,0,,И ТАК ПО КРУГУ УЖЕ ДВАДЦАТЬ ДВА РАЗА.
Dialogue: 0,0:00:09.82,0:00:12.76,Caption,,0,0,0,,ВИДИМО, ВЕСЬ ЯЩИК СРАЗУ ВЫДАВАТЬ БОЯЛИСЬ ВДРУГ
Dialogue: 0,0:00:12.76,0:00:16.03,Caption,,0,0,0,,МЕДВЕДЬ ИСПУГАЕТСЯ РАНЬШЕ, ЧЕМ ЕВРОПЕЙЦЫ УСПЕЮТ ПРОВЕСТИ
Dialogue: 0,0:00:16.03,0:00:18.83,Caption,,0,0,0,,СОВЕЩАНИЕ. ТОЛЬКО ТЕПЕРЬ ТРЕВОЖИТЬСЯ ПРИХОДИТСЯ
Dialogue: 0,0:00:18.83,0:00:22.45,Caption,,0,0,0,,УЖЕ НЕ СТОЛЬКО ЗА ОХОТУ, СКОЛЬКО ЗА САМИХ ОХОТНИКОВ. ПРЕМЬЕР
Dialogue: 0,0:00:22.45,0:00:25.56,Caption,,0,0,0,,ЧЕХИИ АНДРЕЙ БАБИШ ВЗЯЛ ЕВРОПЕЙСКИЙ КАЛЬКУЛЯТОР И
Dialogue: 0,0:00:25.56,0:00:28.42,Caption,,0,0,0,,ОБНАРУЖИЛ НА НЁМ ОДНУ ПОДОЗРИТЕЛЬНУЮ КНОПКУ.
Dialogue: 0,0:00:28.42,0:00:31.55,Caption,,0,0,0,,УКРАИНА С НАЧАЛА КОНФЛИКТА ПОЛУЧИЛА ПЯТЬСОТ ДВАДЦАТЬ
Dialogue: 0,0:00:31.55,0:00:34.36,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ПРЯМОЙ И КОСВЕННОЙ ПОМОЩИ. НА ДВЕ
Dialogue: 0,0:00:34.36,0:00:36.97,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОЙ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ
Dialogue: 0,0:00:36.97,0:00:39.74,Caption,,0,0,0,,ГОДЫ ПРИГОТОВИЛИ ЕЩЁ ДЕВЯНОСТО МИЛЛИАРДОВ.
Dialogue: 0,0:00:39.74,0:00:42.09,Caption,,0,0,0,,СЛЕДОМ ПОНАДОБИЛИСЬ ДОПОЛНИТЕЛЬНЫЕ СЕМЬДЕСЯТ
Dialogue: 0,0:00:42.09,0:00:45.22,Caption,,0,0,0,,МИЛЛИАРДОВ. БАБИШ ПОСМОТРЕЛ НА ЭТУ КОЛОНКУ СУММ И
Dialogue: 0,0:00:45.22,0:00:49.23,Caption,,0,0,0,,СПРОСИЛ ГДЕ ФИНИШ? ЧЕШСКИЙ ПРЕМЬЕР ВЫСТУПИЛ И ПРОТИВ
Dialogue: 0,0:00:49.23,0:00:51.73,Caption,,0,0,0,,ТОГО, ЧТОБЫ ЕЩЁ СТО МИЛЛИАРДОВ ЕВРО ДЛЯ
Dialogue: 0,0:00:51.73,0:00:54.36,Caption,,0,0,0,,УКРАИНЫ БРАЛИ ИЗ ОБЩЕГО СЕМИЛЕТНЕГО БЮДЖЕТА
Dialogue: 0,0:00:54.36,0:00:57.48,Caption,,0,0,0,,ЕВРОСОЮЗА. ЧЕХИЯ ПЕРЕЧИСЛЯЕТ ТУДА ВСЁ БОЛЬШЕ,
Dialogue: 0,0:00:57.72,0:01:00.41,Caption,,0,0,0,,А ПОЛУЧАЕТ ОБРАТНО ВСЁ МЕНЬШЕ. ПОЭТОМУ
Dialogue: 0,0:01:00.41,0:01:02.32,Caption,,0,0,0,,БАБИШ ПРЕДЛАГАЕТ ВЫНЕСТИ УКРАИНСКОЕ
Dialogue: 0,0:01:02.32,0:01:05.79,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ ЗА РАМКИ ОБЩЕГО КОШЕЛЬКА. ИНАЧЕ ВЫХОДИТ
Dialogue: 0,0:01:05.79,0:01:08.92,Caption,,0,0,0,,ЗНАКОМАЯ РЕСТОРАННАЯ СЦЕНА ЗАКАЗ ДЕЛАЛИ ДРУГИЕ,
Dialogue: 0,0:01:09.09,0:01:13.16,Caption,,0,0,0,,БЛЮДА ПРОДОЛЖАЮТ ПРИНОСИТЬ, А СЧЁТ АККУРАТНО ДВИГАЮТ К ПРАГЕ.
Dialogue: 0,0:01:15.43,0:01:17.44,Caption,,0,0,0,,ЕЖЕГОДНО РЕЧЬ ИДЁТ ПРИМЕРНО О СТА
Dialogue: 0,0:01:17.44,0:01:20.49,Caption,,0,0,0,,ТРИДЦАТИ ПЯТИ МИЛЛИАРДАХ ЕВРО. ЕСЛИ ТАКАЯ МОДЕЛЬ
Dialogue: 0,0:01:20.49,0:01:24.66,Caption,,0,0,0,,РАССЧИТАНА НА ДЕСЯТЬ ЛЕТ, ЭТО ОДНА СУММА. ЕСЛИ НА ДВАДЦАТЬ ИЛИ
Dialogue: 0,0:01:24.66,0:01:28.31,Caption,,0,0,0,,ТРИДЦАТЬ, СОВСЕМ ДРУГАЯ. НО СРОК НИКТО НЕ НАЗЫВАЕТ,
Dialogue: 0,0:01:28.55,0:01:30.71,Caption,,0,0,0,,БУДТО СТРАТЕГИЯ СТАНЕТ УБЕДИТЕЛЬНЕЕ,
Dialogue: 0,0:01:30.87,0:01:32.87,Caption,,0,0,0,,ЕСЛИ НЕ ПОКАЗЫВАТЬ ПОСЛЕДНЮЮ СТРАНИЦУ.
Dialogue: 0,0:01:33.65,0:01:36.99,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ НОВОСТИ, ПОСЛЕ КОТОРЫХ ЧИНОВНИКАМ ХОЧЕТСЯ
Dialogue: 0,0:01:36.99,0:01:39.11,Caption,,0,0,0,,НЕЗАМЕТНО СПРЯТАТЬ КАЛЬКУЛЯТОР ПОД СТОЛ,
Dialogue: 0,0:01:39.35,0:01:41.46,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ДАЛЬШЕ СУММЫ
Dialogue: 0,0:01:41.46,0:01:43.43,Caption,,0,0,0,,НАЧИНАЮТ СПОРИТЬ УЖЕ НЕ С БАБИШЕМ,
Dialogue: 0,0:01:43.58,0:01:46.15,Caption,,0,0,0,,А С САМОЙ ГЕРМАНИЕЙ. ФРИДРИХ МЕРЦ ТОЖЕ
Dialogue: 0,0:01:46.15,0:01:48.25,Caption,,0,0,0,,ПРИШЁЛ В ПАРЛАМЕНТ ГОВОРИТЬ О ДЕНЬГАХ.
Dialogue: 0,0:01:48.25,0:01:50.39,Caption,,0,0,0,,ПРАВДА, ПРИНЁС ОН НЕ НОВЫЕ ДЕНЬГИ,
Dialogue: 0,0:01:50.55,0:01:53.65,Caption,,0,0,0,,А ОБЪЯСНЕНИЕ, ПОЧЕМУ ПРЕЖНИХ БОЛЬШЕ НЕ ХВАТАЕТ НА
Dialogue: 0,0:01:53.65,0:01:57.27,Caption,,0,0,0,,ВСЕ ОБЕЩАНИЯ. КАНЦЛЕР НАЗВАЛ ПОЛОЖЕНИЕ ГЕРМАНИИ
Dialogue: 0,0:01:57.27,0:02:00.38,Caption,,0,0,0,,ГЛУБОКИМ КРИЗИСОМ АДАПТАЦИИ. В ОДНОМ УЗЛЕ СОШЛИСЬ
Dialogue: 0,0:02:00.38,0:02:04.10,Caption,,0,0,0,,ВОЗРОСШИЕ ВОЕННЫЕ УГРОЗЫ, ТЕХНОЛОГИЧЕСКОЕ ОТСТАВАНИЕ И
Dialogue: 0,0:02:04.10,0:02:06.71,Caption,,0,0,0,,ДЕМОГРАФИЧЕСКИЕ ПРОБЛЕМЫ. БЮДЖЕТ НА ДВЕ ТЫСЯЧИ
Dialogue: 0,0:02:06.71,0:02:09.83,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОЙ ГОД ПРОСТО ВЫСТАВИЛ ЭТОТ УЗЕЛ НА СТОЛ,
Dialogue: 0,0:02:09.99,0:02:11.96,Caption,,0,0,0,,ЧТОБЫ ЕГО НАКОНЕЦ ПЕРЕСТАЛИ ПРИНИМАТЬ
Dialogue: 0,0:02:11.96,0:02:14.39,Caption,,0,0,0,,ЗА ДЕКОРАТИВНЫЙ БАНТИК. ПОСЛЕ ЭТОГО МЕРЦ
Dialogue: 0,0:02:14.39,0:02:17.43,Caption,,0,0,0,,СООБЩИЛ НЕМЦАМ НЕПРИЯТНУЮ ВЕЩЬ. ОТ ЧАСТИ ПРИВЫЧНЫХ
Dialogue: 0,0:02:17.43,0:02:20.50,Caption,,0,0,0,,ПРЕДСТАВЛЕНИЙ ПРИДЁТСЯ ОТКАЗАТЬСЯ. ГОСУДАРСТВО УЖЕ
Dialogue: 0,0:02:20.50,0:02:22.71,Caption,,0,0,0,,НЕ СПОСОБНО ОПЛАЧИВАТЬ ИЗ НАЛОГОВ ВСЁ,
Dialogue: 0,0:02:22.95,0:02:24.89,Caption,,0,0,0,,ЧТО ДЕСЯТИЛЕТИЯМИ ВОСПРИНИМАЛОСЬ КАК
Dialogue: 0,0:02:24.89,0:02:26.63,Caption,,0,0,0,,НЕЧТО САМО СОБОЙ РАЗУМЕЮЩЕЕСЯ.
Dialogue: 0,0:02:28.91,0:02:31.34,Caption,,0,0,0,,ДЕПУТАТ АДГ МАРКУС ФРОНМАЙЕР ТУТ ЖЕ
Dialogue: 0,0:02:31.34,0:02:34.19,Caption,,0,0,0,,ПОДСКАЗАЛ, КУДА МОЖНО ПОСМОТРЕТЬ ДЕНЬГИ БЫЛИ,
Dialogue: 0,0:02:34.38,0:02:38.97,Caption,,0,0,0,,НО ИХ ОТПРАВИЛИ УКРАИНЕ. У МЕРЦА ОТВЕТ ГОТОВ. ГЕРМАНИЯ СЛИШКОМ
Dialogue: 0,0:02:38.97,0:02:41.71,Caption,,0,0,0,,ДОЛГО БЕРЕГЛА СРЕДСТВА НА ВНЕШНЕЙ БЕЗОПАСНОСТИ,
Dialogue: 0,0:02:41.87,0:02:43.55,Caption,,0,0,0,,А ТЕПЕРЬ ИСПРАВЛЯЕТ ЭТУ ОШИБКУ.
Dialogue: 0,0:02:44.11,0:02:47.23,Caption,,0,0,0,,КАНЦЛЕР ДАЖЕ ЗАЯВИЛ, ЧТО СТРАНА СТАЛА СИЛЬНЕЕ,
Dialogue: 0,0:02:47.39,0:02:50.35,Caption,,0,0,0,,ЧЕМ КОГДА ЛИБО ЗА ПОСЛЕДНИЕ ДЕСЯТИЛЕТИЯ. СИЛА
Dialogue: 0,0:02:50.35,0:02:52.44,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ПОЯВИЛАСЬ. ТОЛЬКО ПРИШЛА
Dialogue: 0,0:02:52.44,0:02:55.60,Caption,,0,0,0,,ОНА ВМЕСТЕ СО СВЕЖИМИ ДОЛГАМИ. РАСХОДЫ НА УКРАИНУ
Dialogue: 0,0:02:55.60,0:02:58.11,Caption,,0,0,0,,МЕРЦ ЗАЩИЩАЕТ ОТДЕЛЬНО. ПО ЕГО ЛОГИКЕ,
Dialogue: 0,0:02:58.35,0:03:00.56,Caption,,0,0,0,,РОССИЯ ЯСНО ПОНИМАЕТ СВОИ ЦЕЛИ И
Dialogue: 0,0:03:00.56,0:03:03.54,Caption,,0,0,0,,УКРАИНОЙ НЕ ОГРАНИЧИВАЕТСЯ. НАПРЯЖЕНИЕ ВИДНО В
Dialogue: 0,0:03:03.54,0:03:07.48,Caption,,0,0,0,,БАЛТИЙСКОМ РЕГИОНЕ, ПОЛЬШЕ, ЧЁРНОМ МОРЕ И ДАЖЕ КОСМОСЕ.
Dialogue: 0,0:03:07.48,0:03:10.69,Caption,,0,0,0,,СЛЕДОВАТЕЛЬНО, ПОМОЩЬ КИЕВУ ОДНОВРЕМЕННО СЛУЖИТ
Dialogue: 0,0:03:10.69,0:03:13.82,Caption,,0,0,0,,ОБОРОНОЙ САМОЙ ГЕРМАНИИ. К ЭТОМУ КАНЦЛЕР ДОБАВЛЯЕТ
Dialogue: 0,0:03:13.82,0:03:16.60,Caption,,0,0,0,,ПРАКТИЧЕСКУЮ ПОЛЬЗУ. НЕМЕЦКАЯ СТОРОНА ПОЛУЧАЕТ
Dialogue: 0,0:03:16.60,0:03:19.71,Caption,,0,0,0,,УКРАИНСКИЙ ОПЫТ В ОБОРОННЫХ И ГРАЖДАНСКИХ ТЕХНОЛОГИЯХ,
Dialogue: 0,0:03:19.95,0:03:21.79,Caption,,0,0,0,,РАСШИРЯЕТ ЭКОНОМИЧЕСКИЕ СВЯЗИ,
Dialogue: 0,0:03:22.03,0:03:26.41,Caption,,0,0,0,,ОСВАИВАЕТ НОВЫЕ РЕШЕНИЯ. ТУТ ВОПРОС БАБИША ПЕРЕСТАЁТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:03:26.41,0:03:29.71,Caption,,0,0,0,,ЧЕШСКОЙ ПРИЧУДОЙ. ЕСЛИ ОБЩИЙ КОШЕЛЁК ХУДЕЕТ,
Dialogue: 0,0:03:29.90,0:03:32.27,Caption,,0,0,0,,СОЦИАЛЬНЫЕ ОБЕЩАНИЯ ПЕРЕСМАТРИВАЮТСЯ,
Dialogue: 0,0:03:32.44,0:03:35.79,Caption,,0,0,0,,А МОЩЬ ДЕРЖИТСЯ НА ЗАЙМАХ, НЕПЛОХО БЫЛО БЫ УЗНАТЬ,
Dialogue: 0,0:03:35.98,0:03:38.03,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ ЛЕТ ДЕСЯТКИ МИЛЛИАРДОВ
Dialogue: 0,0:03:38.03,0:03:41.05,Caption,,0,0,0,,БУДУТ НАХОДИТЬСЯ БЕЗ ТРУДА. ОСОБЕННО КОГДА КОНЕЧНУЮ
Dialogue: 0,0:03:41.05,0:03:43.88,Caption,,0,0,0,,ЦЕЛЬ КАЖДЫЙ РАЗ ОБЕЩАЮТ ОБСУДИТЬ ПОСЛЕ СЛЕДУЮЩЕГО
Dialogue: 0,0:03:43.88,0:03:48.64,Caption,,0,0,0,,ПЛАТЕЖА. ВМЕСТО ОТВЕТА ЕВРОПА ГОТОВИТ РОССИИ
Dialogue: 0,0:03:48.64,0:03:51.91,Caption,,0,0,0,,ДВАДЦАТЬ ВТОРОЙ ПАКЕТ САНКЦИЙ. ИМЕННО ДВАДЦАТЬ ВТОРОЙ.
Dialogue: 0,0:03:52.63,0:03:54.49,Caption,,0,0,0,,ЗА ПЯТЬ ЛЕТ МОЖНО БЫЛО ВЫДАТЬ ВСЕ
Dialogue: 0,0:03:54.49,0:03:56.94,Caption,,0,0,0,,ОГРАНИЧЕНИЯ ОДНИМ УДАРОМ. НО БРЮССЕЛЬ ВЫБРАЛ
Dialogue: 0,0:03:56.94,0:03:58.87,Caption,,0,0,0,,СЕРИАЛ С ТАКИМ КОЛИЧЕСТВОМ СЕЗОНОВ,
Dialogue: 0,0:03:59.11,0:04:01.80,Caption,,0,0,0,,ЧТО АКТЁРЫ УЖЕ СТАРЕЮТ БЫСТРЕЕ СЮЖЕТА.
Dialogue: 0,0:04:01.80,0:04:04.64,Caption,,0,0,0,,ЕВРОПА ПОСТУПИЛА ИНАЧЕ. ОГРАНИЧЕНИЯ ВЫДАВАЛИ
Dialogue: 0,0:04:04.64,0:04:07.99,Caption,,0,0,0,,ДОЗИРОВАННО, СЛОВНО ВРАЧ БОЯЛСЯ ПРЕВЫСИТЬ СУТОЧНУЮ
Dialogue: 0,0:04:07.99,0:04:10.47,Caption,,0,0,0,,НОРМУ САНКЦИЙ. СНАЧАЛА ОДИН ПАКЕТ,
Dialogue: 0,0:04:10.70,0:04:15.19,Caption,,0,0,0,,ЗАТЕМ ВТОРОЙ, ПОТОМ ПЯТЫЙ, ДЕСЯТЫЙ И ДВАДЦАТЫЙ. ТЕПЕРЬ НА СТОЙКУ
Dialogue: 0,0:04:15.19,0:04:17.93,Caption,,0,0,0,,КЛАДУТ ДВАДЦАТЬ ВТОРОЙ. ПОСЛЕ КАЖДОГО РАУНДА
Dialogue: 0,0:04:17.93,0:04:20.21,Caption,,0,0,0,,РОССИЯ ПОЛУЧАЕТ ВРЕМЯ РАЗОБРАТЬСЯ С НОВЫМ
Dialogue: 0,0:04:20.21,0:04:22.55,Caption,,0,0,0,,ЗАПРЕТОМ, ОТЫСКАТЬ ОБХОДНЫЕ МАРШРУТЫ,
Dialogue: 0,0:04:22.79,0:04:24.78,Caption,,0,0,0,,ЗАМЕНИТЬ ПОСТАВЩИКОВ И ПЕРЕДЕЛАТЬ
Dialogue: 0,0:04:24.78,0:04:27.11,Caption,,0,0,0,,РАСЧЁТЫ. КАК ТОЛЬКО ПРИСПОСОБЛЕНИЕ
Dialogue: 0,0:04:27.11,0:04:30.36,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ, БРЮССЕЛЬ ПРИНОСИТ СЛЕДУЮЩУЮ ПОРЦИЮ.
Dialogue: 0,0:04:30.36,0:04:33.11,Caption,,0,0,0,,ТАК КОГО НА САМОМ ДЕЛЕ ТРЕНИРОВАЛИ ВСЕ ЭТИ ГОДЫ?
Dialogue: 0,0:04:33.40,0:04:35.51,Caption,,0,0,0,,МЕДВЕДЯ ИЛИ ЕВРОПЕЙСКИХ ЧИНОВНИКОВ,
Dialogue: 0,0:04:35.75,0:04:37.60,Caption,,0,0,0,,КОТОРЫЕ НАУЧИЛИСЬ ОЧЕНЬ ТОРЖЕСТВЕННО
Dialogue: 0,0:04:37.60,0:04:41.60,Caption,,0,0,0,,ОБЪЯВЛЯТЬ ОЧЕРЕДНОЙ НОМЕР? ПРИ ЭТОМ НОВЫЙ ПАКЕТ ДАЛЕКО НЕ
Dialogue: 0,0:04:41.60,0:04:44.75,Caption,,0,0,0,,СИМВОЛИЧЕСКИЙ. ЕЩЁ ШЕСТЬДЕСЯТ РОССИЙСКИХ БАНКОВ ХОТЯТ
Dialogue: 0,0:04:44.75,0:04:46.47,Caption,,0,0,0,,ЛИШИТЬ ДОСТУПА К СИСТЕМЕ СВИФТ.
Dialogue: 0,0:04:47.03,0:04:49.43,Caption,,0,0,0,,ОГРАНИЧЕНИЯ ДОЛЖНЫ ЗАТРОНУТЬ КРИПТОВАЛЮТНЫЕ И
Dialogue: 0,0:04:49.43,0:04:51.72,Caption,,0,0,0,,ПЛАТЁЖНЫЕ СЕТИ. ПОД УДАР ПОПАДУТ И
Dialogue: 0,0:04:51.72,0:04:55.84,Caption,,0,0,0,,КОМПАНИИ ИЗ ТРЕТЬИХ СТРАН, УЧАСТВУЮЩИЕ В ОБХОДЕ ПРЕЖНИХ ЗАПРЕТОВ.
Dialogue: 0,0:04:55.84,0:04:58.44,Caption,,0,0,0,,СПИСОК ТАК НАЗЫВАЕМОГО ТЕНЕВОГО ФЛОТА ПЛАНИРУЮТ
Dialogue: 0,0:04:58.44,0:05:00.63,Caption,,0,0,0,,УВЕЛИЧИТЬ БОЛЕЕ ЧЕМ НА СЕМЬДЕСЯТ СУДОВ.
Dialogue: 0,0:05:02.90,0:05:04.85,Caption,,0,0,0,,ТАНКЕРНЫЕ ПЕРЕВОЗКИ ПОД РОССИЙСКОЙ
Dialogue: 0,0:05:04.85,0:05:07.83,Caption,,0,0,0,,СТРАХОВКОЙ ТОЖЕ СОБИРАЮТСЯ ОГРАНИЧИВАТЬ. ГРАЖДАН
Dialogue: 0,0:05:07.83,0:05:10.80,Caption,,0,0,0,,ЕВРОСОЮЗА ХОТЯТ ОТСТРАНИТЬ ОТ РУКОВОДЯЩИХ ПОСТОВ В
Dialogue: 0,0:05:10.80,0:05:13.19,Caption,,0,0,0,,РОССИЙСКИХ КОМПАНИЯХ. БЫВШИМ РОССИЙСКИМ
Dialogue: 0,0:05:13.19,0:05:16.67,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИМ НАМЕРЕНЫ ЗАКРЫТЬ ВЪЕЗД В СТРАНЫ ОБЪЕДИНЕНИЯ.
Dialogue: 0,0:05:17.30,0:05:19.48,Caption,,0,0,0,,ОТДЕЛЬНЫЙ РАЗДЕЛ ПОСВЯЩЁН СПОРТУ.
Dialogue: 0,0:05:19.48,0:05:22.77,Caption,,0,0,0,,РОССИЙСКИЕ КОМАНДЫ И СПОРТСМЕНЫ ПОД НАЦИОНАЛЬНЫМ ФЛАГОМ
Dialogue: 0,0:05:22.77,0:05:25.64,Caption,,0,0,0,,ХОТЯТ НЕ ДОПУСКАТЬ К СОРЕВНОВАНИЯМ В ЕВРОСОЮЗЕ.
Dialogue: 0,0:05:25.64,0:05:28.39,Caption,,0,0,0,,ОФИЦИАЛЬНУЮ СИМВОЛИКУ СОБИРАЮТСЯ ОГРАНИЧИТЬ.
Dialogue: 0,0:05:28.39,0:05:31.28,Caption,,0,0,0,,ПЛАТЕЖИ РОССИЙСКИХ СПОНСОРОВ ЕВРОПЕЙСКИМ СПОРТИВНЫМ И
Dialogue: 0,0:05:31.28,0:05:34.11,Caption,,0,0,0,,КУЛЬТУРНЫМ ОРГАНИЗАЦИЯМ ПЕРЕКРЫТЬ. РОССИЯНАМ
Dialogue: 0,0:05:34.11,0:05:36.69,Caption,,0,0,0,,ЗАПРЕТИТЬ РУКОВОДЯЩИЕ ДОЛЖНОСТИ В ЕВРОПЕЙСКИХ
Dialogue: 0,0:05:36.69,0:05:39.62,Caption,,0,0,0,,ФЕДЕРАЦИЯХ. НАЧИНАЛИ С ФИНАНСОВОЙ СИСТЕМЫ,
Dialogue: 0,0:05:39.73,0:05:42.54,Caption,,0,0,0,,НЕФТИ И СЛОЖНЫХ ТЕХНОЛОГИЙ. ЗАКОНЧИЛИ
Dialogue: 0,0:05:42.54,0:05:45.22,Caption,,0,0,0,,КРЕСЛОМ В СПОРТИВНОМ КОМИТЕТЕ. ВИДИМО,
Dialogue: 0,0:05:45.38,0:05:48.77,Caption,,0,0,0,,ГДЕ ТО В БРЮССЕЛЕ РЕШИЛИ, ЧТО РУССКИЙ МЕДВЕДЬ ПЕРЕЖИВЁТ
Dialogue: 0,0:05:48.77,0:05:51.62,Caption,,0,0,0,,ОТКЛЮЧЕНИЕ БАНКОВ, НО ОКОНЧАТЕЛЬНО СДАСТСЯ,
Dialogue: 0,0:05:51.86,0:05:53.68,Caption,,0,0,0,,КОГДА ЕГО НЕ ПУСТЯТ НА ЗАСЕДАНИЕ
Dialogue: 0,0:05:53.68,0:05:55.22,Caption,,0,0,0,,ФЕДЕРАЦИИ НАСТОЛЬНОГО ТЕННИСА.
Dialogue: 0,0:05:55.97,0:05:57.81,Caption,,0,0,0,,УРСУЛА ФОН ДЕР ЛЯЙЕН ОБЪЯСНЯЕТ
Dialogue: 0,0:05:57.81,0:06:01.14,Caption,,0,0,0,,СПОРТИВНЫЕ ОГРАНИЧЕНИЯ БОРЬБОЙ С ПРОПАГАНДОЙ. ВСЁ
Dialogue: 0,0:06:01.14,0:06:04.10,Caption,,0,0,0,,ДАВЛЕНИЕ, ПО ЕЁ СЛОВАМ, БУДЕТ ПРОДОЛЖАТЬСЯ,
Dialogue: 0,0:06:04.34,0:06:06.40,Caption,,0,0,0,,ПОКА РОССИЯ НЕ ПРОЯВИТ ИСКРЕННЕГО
Dialogue: 0,0:06:06.40,0:06:09.58,Caption,,0,0,0,,СТРЕМЛЕНИЯ К ПРОЧНОМУ МИРУ. УДОБНАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:06:09.58,0:06:13.45,Caption,,0,0,0,,ИСКРЕННОСТЬ ИЗМЕРИТЬ НЕЛЬЗЯ, ЗАТО НОВЫЙ ПАКЕТ ПОД НЕЁ ВЫПУСКАТЬ
Dialogue: 0,0:06:13.45,0:06:18.79,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО. НОМЕР ДВАДЦАТЬ ТРЕТИЙ УЖЕ ДАЖЕ НЕ
Dialogue: 0,0:06:18.79,0:06:21.66,Caption,,0,0,0,,ПРИДЁТСЯ ДОЛГО ПРИДУМЫВАТЬ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:06:21.91,0:06:24.42,Caption,,0,0,0,,КАКУЮ ЛОГИКУ ВЫ ВИДИТЕ В ДВАДЦАТИ ДВУХ
Dialogue: 0,0:06:24.42,0:06:27.26,Caption,,0,0,0,,ОТДЕЛЬНЫХ ПАКЕТАХ. И ПОДПИСЫВАЙТЕСЬ НА КАНАЛ,
Dialogue: 0,0:06:27.42,0:06:31.58,Caption,,0,0,0,,ЕСЛИ ЕЩЁ ЭТОГО НЕ СДЕЛАЛИ. СЕЙЧАС К ЕВРОПЕЙСКОЙ ИГРЕ ПОДХОДЯТ
Dialogue: 0,0:06:31.58,0:06:34.46,Caption,,0,0,0,,НОВЫЕ УЧАСТНИКИ, КОТОРЫЕ СНАЧАЛА ХОТЯТ ВОЙТИ,
Dialogue: 0,0:06:34.68,0:06:36.97,Caption,,0,0,0,,А ЗАТЕМ УЗНАТЬ ЦЕНУ БИЛЕТА. МОЛДАВИЯ
Dialogue: 0,0:06:36.97,0:06:39.36,Caption,,0,0,0,,ГОТОВИТ СОБСТВЕННЫЙ ПЛАН ПРИСОЕДИНЕНИЯ К
Dialogue: 0,0:06:39.36,0:06:42.70,Caption,,0,0,0,,САНКЦИЯМ ЕВРОСОЮЗА ПРОТИВ РОССИИ И БЕЛОРУССИИ. ВЛАСТИ
Dialogue: 0,0:06:42.70,0:06:46.07,Caption,,0,0,0,,ДОЛЖНЫ ОПРЕДЕЛИТЬ, КАКИЕ ИМЕННО ОГРАНИЧЕНИЯ СТРАНА
Dialogue: 0,0:06:46.07,0:06:49.15,Caption,,0,0,0,,ВВЕДЁТ. НО ПЕРЕД ЭТИМ ОНИ НАМЕРЕНЫ ОЦЕНИТЬ ПОСЛЕДСТВИЯ
Dialogue: 0,0:06:49.15,0:06:52.07,Caption,,0,0,0,,ДЛЯ МОЛДАВСКОЙ ЭКОНОМИКИ. РУКОВОДИТЕЛЬ ИТАЛЬЯНСКОЙ
Dialogue: 0,0:06:52.07,0:06:54.99,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЙ КОМПАНИИ ЭНИ КЛАУДИО ДЕСКАЛЬЦИ
Dialogue: 0,0:06:54.99,0:06:58.31,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ ПОСЛЕ ПОЛНОГО ОТКАЗА ОТ РОССИЙСКОГО ГАЗА
Dialogue: 0,0:06:58.31,0:07:01.33,Caption,,0,0,0,,ЕВРОПА БУДЕТ ЕЖЕГОДНО НЕДОПОЛУЧАТЬ ОКОЛО ДВАДЦАТИ
Dialogue: 0,0:07:01.33,0:07:03.99,Caption,,0,0,0,,МИЛЛИАРДОВ КУБОМЕТРОВ. ТАКОЙ ОБЪЁМ НЕЛЬЗЯ
Dialogue: 0,0:07:03.99,0:07:07.38,Caption,,0,0,0,,ЗАМЕНИТЬ ОДНИМ ПОВОРОТОМ ВЕНТИЛЯ НА СОСЕДНЕЙ ТРУБЕ.
Dialogue: 0,0:07:07.38,0:07:09.85,Caption,,0,0,0,,ДАЖЕ ВОССТАНОВЛЕНИЕ ПОСТАВОК ИЗ КАТАРА НА
Dialogue: 0,0:07:09.85,0:07:12.22,Caption,,0,0,0,,ПОЛНУЮ МОЩНОСТЬ, ПО ОЦЕНКЕ ДЕСКАЛЬЦИ,
Dialogue: 0,0:07:12.38,0:07:14.52,Caption,,0,0,0,,НЕ ПЕРЕКРОЕТ НЕХВАТКУ. ПРИ ХОЛОДНОЙ
Dialogue: 0,0:07:14.52,0:07:17.34,Caption,,0,0,0,,ЗИМЕ И НЕБОЛЬШИХ ЗАПАСАХ ПРЕДЛОЖЕНИЕ СОКРАТИТСЯ,
Dialogue: 0,0:07:17.58,0:07:21.26,Caption,,0,0,0,,А ЦЕНЫ ПОЙДУТ ВВЕРХ. ДВАДЦАТЬ МИЛЛИАРДОВ КУБОМЕТРОВ
Dialogue: 0,0:07:21.44,0:07:23.58,Caption,,0,0,0,,ИСЧЕЗАЮТ ИЗ БАЛАНСА КАЖДЫЙ ГОД,
Dialogue: 0,0:07:23.82,0:07:25.94,Caption,,0,0,0,,ТОГДА КАК РАВНОГО ИСТОЧНИКА НА ЗАМЕНУ
Dialogue: 0,0:07:25.94,0:07:28.79,Caption,,0,0,0,,ПОКА НЕТ. ОДНОВРЕМЕННО ДЕСКАЛЬЦИ ГОВОРИТ О
Dialogue: 0,0:07:28.79,0:07:31.51,Caption,,0,0,0,,НЕОБХОДИМОСТИ ДОЛЬШЕ СОХРАНЯТЬ ПОТОЛОК ЦЕН НА
Dialogue: 0,0:07:31.51,0:07:36.33,Caption,,0,0,0,,ТОПЛИВО. СХЕМА ПОЛУЧАЕТСЯ ИЗЯЩНАЯ. СНАЧАЛА
Dialogue: 0,0:07:36.33,0:07:39.84,Caption,,0,0,0,,ЕВРОПА ДОБРОВОЛЬНО УМЕНЬШАЕТ КОЛИЧЕСТВО ДОСТУПНОГО ГАЗА.
Dialogue: 0,0:07:39.84,0:07:41.78,Caption,,0,0,0,,ЗАТЕМ НАЧИНАЕТ СПОРИТЬ С ЦЕНОЙ,
Dialogue: 0,0:07:41.94,0:07:44.66,Caption,,0,0,0,,СЛОВНО ТА ОБЯЗАНА ПРОЯВИТЬ СОЛИДАРНОСТЬ И ТОЖЕ
Dialogue: 0,0:07:44.66,0:07:48.06,Caption,,0,0,0,,СОКРАТИТЬСЯ. ЛИТВА НА ЭТОМ ФОНЕ СНОВА СМОТРИТ В
Dialogue: 0,0:07:48.06,0:07:50.91,Caption,,0,0,0,,СТОРОНУ АТОМНОЙ ЭНЕРГЕТИКИ. ИГНАЛИНСКУЮ
Dialogue: 0,0:07:50.91,0:07:53.44,Caption,,0,0,0,,АТОМНУЮ ЭЛЕКТРОСТАНЦИЮ ЗАКРЫЛИ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:53.44,0:07:56.61,Caption,,0,0,0,,ДЕВЯТОМ ГОДУ. СПУСТЯ ПОЧТИ ДВА ДЕСЯТИЛЕТИЯ МИНИСТР
Dialogue: 0,0:07:56.61,0:07:59.24,Caption,,0,0,0,,ЭНЕРГЕТИКИ ЛУКАС САВИЦКАС ПРЕДЛАГАЕТ ВЕРНУТЬ
Dialogue: 0,0:07:59.24,0:08:02.83,Caption,,0,0,0,,СТРАНЕ АТОМНУЮ ГЕНЕРАЦИЮ, НО УЖЕ НА ОСНОВЕ МАЛЫХ МОДУЛЬНЫХ
Dialogue: 0,0:08:02.83,0:08:05.85,Caption,,0,0,0,,РЕАКТОРОВ. ЛИТВЕ НУЖНА СТАБИЛЬНАЯ БАЗОВАЯ
Dialogue: 0,0:08:05.85,0:08:08.64,Caption,,0,0,0,,ВЫРАБОТКА. ПРОЕКТ СОБИРАЮТСЯ ПРЕДСТАВИТЬ ПАРЛАМЕНТУ В
Dialogue: 0,0:08:08.64,0:08:11.32,Caption,,0,0,0,,ПЕРВОЙ ПОЛОВИНЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА.
Dialogue: 0,0:08:11.32,0:08:15.46,Caption,,0,0,0,,ЕСТЬ ПОДХОДЯЩАЯ ПЛОЩАДКА, РЕЗУЛЬТАТЫ ГЕОЛОГИЧЕСКИХ ИССЛЕДОВАНИЙ,
Dialogue: 0,0:08:15.54,0:08:18.85,Caption,,0,0,0,,СПЕЦИАЛИСТЫ, ЗАКОНОДАТЕЛЬНАЯ БАЗА И ПОДДЕРЖКА
Dialogue: 0,0:08:18.85,0:08:22.27,Caption,,0,0,0,,МЕСТНЫХ ЖИТЕЛЕЙ. НЕ ХВАТАЕТ ТОЛЬКО СУЩЕЙ МЕЛОЧИ САМОЙ
Dialogue: 0,0:08:22.27,0:08:25.28,Caption,,0,0,0,,ОТРАБОТАННОЙ КОММЕРЧЕСКОЙ ТЕХНОЛОГИИ. ДЕЙСТВУЮЩИЕ
Dialogue: 0,0:08:25.28,0:08:28.13,Caption,,0,0,0,,КОММЕРЧЕСКИЕ МАЛЫЕ МОДУЛЬНЫЕ РЕАКТОРЫ ИМЕЮТСЯ В
Dialogue: 0,0:08:28.13,0:08:31.34,Caption,,0,0,0,,РОССИИ И КИТАЕ. МИНИСТР ЭКОНОМИКИ УКРАИНЫ АЛЕКСАНДР
Dialogue: 0,0:08:31.34,0:08:34.19,Caption,,0,0,0,,КРАВЧЕНКО В РАЗГОВОРЕ С ВОВАНОМ И ЛЕКСУСОМ СООБЩИЛ
Dialogue: 0,0:08:34.19,0:08:36.25,Caption,,0,0,0,,О ЛЕТНИХ УДАРАХ ПО СКЛАДАМ КОМПАНИИ
Dialogue: 0,0:08:36.25,0:08:39.32,Caption,,0,0,0,,WILDBERRIES. ЗНАЧИТЕЛЬНОГО УЩЕРБА РОССИЙСКОЙ
Dialogue: 0,0:08:39.32,0:08:42.90,Caption,,0,0,0,,ЭКОНОМИКЕ ЭТИ АТАКИ НЕ ПРИЧИНИЛИ. ЗАМЫСЕЛ БЫЛ ДРУГИМ.
Dialogue: 0,0:08:42.90,0:08:46.17,Caption,,0,0,0,,ПЕРЕБОИ В РАБОТЕ МАРКЕТПЛЕЙСА ДОЛЖНЫ БЫЛИ РАЗДРАЖАТЬ
Dialogue: 0,0:08:46.17,0:08:50.29,Caption,,0,0,0,,ОБЫЧНЫХ ПОКУПАТЕЛЕЙ. КРОМЕ ТОГО,
Dialogue: 0,0:08:50.37,0:08:53.66,Caption,,0,0,0,,В КИЕВЕ ОЖИДАЛИ, ЧТО ПРОБЛЕМЫ КОМПАНИИ ЗАДЕНУТ
Dialogue: 0,0:08:53.66,0:08:57.05,Caption,,0,0,0,,БАНКОВСКИЙ СЕКТОР. САМ КРАВЧЕНКО ПРИЗНАЛ РАСЧЁТ СИЛЬНО
Dialogue: 0,0:08:57.05,0:09:00.21,Caption,,0,0,0,,ПРЕУВЕЛИЧЕННЫМ. ПЛАН НЕ СРАБОТАЛ. ЗАКАЗ ЗАДЕРЖАЛСЯ,
Dialogue: 0,0:09:00.45,0:09:04.13,Caption,,0,0,0,,ПРИЛОЖЕНИЕ РАБОТАЕТ ХУЖЕ, ПОКУПАТЕЛЬ ЗЛИТСЯ. ПОТОМ ОСТАЁТСЯ
Dialogue: 0,0:09:04.13,0:09:07.30,Caption,,0,0,0,,ТОЛЬКО НАДЕЯТЬСЯ, ЧТО РАЗДРАЖЕНИЕ ПОЙДЁТ ПО ЗАРАНЕЕ
Dialogue: 0,0:09:07.30,0:09:10.12,Caption,,0,0,0,,НАРИСОВАННОМУ МАРШРУТУ И ПРЕВРАТИТСЯ В НУЖНОЕ
Dialogue: 0,0:09:10.12,0:09:12.87,Caption,,0,0,0,,ОТНОШЕНИЕ К ГОСУДАРСТВУ. НЕ ПРЕВРАТИЛОСЬ.
Dialogue: 0,0:09:12.87,0:09:15.41,Caption,,0,0,0,,ГРАЖДАНИН, КОТОРОМУ ПОЗДНО ПРИВЕЗЛИ ЧАЙНИК,
Dialogue: 0,0:09:15.73,0:09:19.86,Caption,,0,0,0,,ОБЫЧНО СЕРДИТСЯ НА ДОСТАВКУ, А НЕ СПЕШИТ МЕНЯТЬ УСТРОЙСТВО СТРАНЫ.
Dialogue: 0,0:09:19.86,0:09:22.08,Caption,,0,0,0,,НА МОРЕ ПОДОБНАЯ ИГРА СТАНОВИТСЯ ГОРАЗДО
Dialogue: 0,0:09:22.08,0:09:25.60,Caption,,0,0,0,,ОПАСНЕЕ. СОЕДИНЁННЫЕ ШТАТЫ ПОДОЗРЕВАЮТ РОССИЮ И
Dialogue: 0,0:09:25.60,0:09:28.65,Caption,,0,0,0,,ИРАН В СЕРИИ КИБЕРАТАК ПРОТИВ ТАНКЕРОВ В РАЗНЫХ
Dialogue: 0,0:09:28.65,0:09:31.25,Caption,,0,0,0,,РАЙОНАХ МИРА. ПО СВЕДЕНИЯМ УОЛЛ СТРИТ ДЖОРНАЛ,
Dialogue: 0,0:09:31.57,0:09:33.36,Caption,,0,0,0,,ПОД УГРОЗОЙ МОГЛИ ОКАЗАТЬСЯ ДО
Dialogue: 0,0:09:33.36,0:09:35.73,Caption,,0,0,0,,ПЯТИДЕСЯТИ СУДОВ, ПЕРЕВОЗЯЩИХ НЕФТЬ,
Dialogue: 0,0:09:35.81,0:09:38.39,Caption,,0,0,0,,ГАЗ И ХИМИЧЕСКУЮ ПРОДУКЦИЮ. НА СУДА
Dialogue: 0,0:09:38.39,0:09:42.71,Caption,,0,0,0,,ПОСТУПАЛИ УГРОЗЫ ВЗРЫВА, ТРЕБОВАНИЯ ВЫКУПА И ПРЕДУПРЕЖДЕНИЯ НЕ
Dialogue: 0,0:09:42.71,0:09:45.20,Caption,,0,0,0,,ВОЗИТЬ АМЕРИКАНСКИЕ ЭНЕРГОРЕСУРСЫ. ТАКИЕ
Dialogue: 0,0:09:45.20,0:09:47.17,Caption,,0,0,0,,ПОСЛАНИЯ ПОЛУЧИЛИ ДВА ТАНКЕРА,
Dialogue: 0,0:09:47.33,0:09:52.12,Caption,,0,0,0,,КОТОРЫЕ НАПРАВЛЯЛИСЬ В ТЕХАС. В ЭТОЙ ЖЕ ИСТОРИИ УПОМИНАЕТСЯ ГАЗОВОЗ
Dialogue: 0,0:09:52.12,0:09:55.41,Caption,,0,0,0,,VIVIT AFRICA. ОН ШЁЛ ИЗ СОЕДИНЁННЫХ ШТАТОВ В ИТАЛИЮ,
Dialogue: 0,0:09:55.65,0:09:57.63,Caption,,0,0,0,,А ПОСЛЕ ПРЕДПОЛАГАЕМОГО ВЗЛОМА НАЧАЛ
Dialogue: 0,0:09:57.63,0:10:00.77,Caption,,0,0,0,,ДВИГАТЬСЯ ПО СТРАННОЙ ТРАЕКТОРИИ. КАК ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:10:01.01,0:10:03.09,Caption,,0,0,0,,ЗА СТОЛОМ ДЕЙСТВИТЕЛЬНО СИДЯТ ДВОЕ.
Dialogue: 0,0:10:05.38,0:10:07.86,Caption,,0,0,0,,И ПРАВИЛА, ПРИДУМАННЫЕ ДЛЯ ЧУЖИХ СУДОВ,
Dialogue: 0,0:10:08.12,0:10:10.10,Caption,,0,0,0,,ПРЕКРАСНО ЧИТАЮТСЯ С ОБЕИХ СТОРОН.
Dialogue: 0,0:10:10.80,0:10:12.83,Caption,,0,0,0,,ЕСЛИ АТАКИ НА ТАНКЕРЫ РОССИЙСКОГО
Dialogue: 0,0:10:12.83,0:10:15.71,Caption,,0,0,0,,ТЕНЕВОГО ФЛОТА ОБЪЯВЛЯЮТ ДОПУСТИМЫМ ИНСТРУМЕНТОМ
Dialogue: 0,0:10:15.71,0:10:18.82,Caption,,0,0,0,,ДАВЛЕНИЯ, ПОЧЕМУ ПРОТИВОПОЛОЖНАЯ СТОРОНА ДОЛЖНА
Dialogue: 0,0:10:18.82,0:10:21.06,Caption,,0,0,0,,ОСТАВИТЬ ЭТОТ ИНСТРУМЕНТ ЛЕЖАТЬ НЕТРОНУТЫМ?
Dialogue: 0,0:10:21.64,0:10:23.39,Caption,,0,0,0,,МОРСКАЯ ЛОГИКА БЫСТРО СТАНОВИТСЯ
Dialogue: 0,0:10:23.39,0:10:26.02,Caption,,0,0,0,,РЕЗИНОВОЙ, ОСОБЕННО КОГДА ТРЕБУЕТСЯ ОБЪЯСНИТЬ,
Dialogue: 0,0:10:26.30,0:10:28.57,Caption,,0,0,0,,ПОЧЕМУ ГРАЖДАНСКОЕ СУДНО ВНЕЗАПНО
Dialogue: 0,0:10:28.57,0:10:31.35,Caption,,0,0,0,,ПРЕВРАТИЛОСЬ В ВОЕННУЮ ЦЕЛЬ. ЭЛЕКТРОДВИГАТЕЛЬ
Dialogue: 0,0:10:31.35,0:10:34.03,Caption,,0,0,0,,ОТНОСИТСЯ К ГРАЖДАНСКОЙ ПРОДУКЦИИ. НО ТОТ ЖЕ
Dialogue: 0,0:10:34.03,0:10:36.76,Caption,,0,0,0,,ДВИГАТЕЛЬ МОЖНО УСТАНОВИТЬ НА ВОЕННУЮ МАШИНУ. ПРИ
Dialogue: 0,0:10:36.76,0:10:39.20,Caption,,0,0,0,,ТАКОМ ПОДХОДЕ ГРАНИЦА ИСЧЕЗАЕТ ЗА НЕСКОЛЬКО
Dialogue: 0,0:10:39.20,0:10:42.82,Caption,,0,0,0,,ФОРМУЛИРОВОК. ЛЮБОЕ СУДНО ПОД ЛЮБЫМ ФЛАГОМ МОЖНО ОБЪЯВИТЬ
Dialogue: 0,0:10:42.82,0:10:46.24,Caption,,0,0,0,,ЧАСТЬЮ ВОЕННОГО СНАБЖЕНИЯ, ЕСЛИ ДОСТАТОЧНО ШИРОКО ОПИСАТЬ
Dialogue: 0,0:10:46.24,0:10:48.90,Caption,,0,0,0,,НАЗНАЧЕНИЕ ГРУЗА. ПОКА ЭКСПЕРТЫ БУДУТ ВЫЯСНЯТЬ,
Dialogue: 0,0:10:49.13,0:10:51.12,Caption,,0,0,0,,ПРЕДНАЗНАЧАЛИСЬ ЛИ МОТОРЫ ДЛЯ ЗАВОДА
Dialogue: 0,0:10:51.12,0:10:54.36,Caption,,0,0,0,,ИЛИ ТЕХНИКИ, СЛЕДУЮЩЕМУ ЭКИПАЖУ УЖЕ ПРИШЛЮТ УГРОЗУ.
Dialogue: 0,0:10:54.36,0:10:57.25,Caption,,0,0,0,,ПРИ БОЛЬШОМ ЖЕЛАНИИ ДАЖЕ СУДНО С ЖИВОТНЫМИ МОЖНО
Dialogue: 0,0:10:57.25,0:10:59.91,Caption,,0,0,0,,ЗАПИСАТЬ В ВОЕННУЮ ЛОГИСТИКУ. КОРОВАМ ОСТАНЕТСЯ
Dialogue: 0,0:10:59.91,0:11:02.55,Caption,,0,0,0,,ТОЛЬКО ПОТРЕБОВАТЬ АДВОКАТА. ПОЛИТИКИ МОГУТ
Dialogue: 0,0:11:02.55,0:11:04.66,Caption,,0,0,0,,НЕДЕЛЯМИ ОБСУЖДАТЬ ВЛАДЕЛЬЦА СУДНА,
Dialogue: 0,0:11:04.88,0:11:07.85,Caption,,0,0,0,,ЕГО ФЛАГ, ПРОИСХОЖДЕНИЕ ГРУЗА И КОНЕЧНОГО
Dialogue: 0,0:11:07.85,0:11:10.91,Caption,,0,0,0,,ПОЛУЧАТЕЛЯ. СТРАХОВЩИКИ И КАПИТАНЫ ЖДАТЬ НЕ
Dialogue: 0,0:11:10.91,0:11:15.18,Caption,,0,0,0,,СТАНУТ. ОНИ ПОДНИМУТ ТАРИФЫ, ИЗМЕНЯТ МАРШРУТЫ ИЛИ ВООБЩЕ ОТКАЖУТСЯ
Dialogue: 0,0:11:15.18,0:11:20.24,Caption,,0,0,0,,ОТ РЕЙСА. ДЛЯ ЕВРОПЫ ТАКАЯ ПЕРСПЕКТИВА ОСОБЕННО
Dialogue: 0,0:11:20.24,0:11:23.05,Caption,,0,0,0,,НЕПРИЯТНА, ПОТОМУ ЧТО ЕЁ ЗАВИСИМОСТЬ ОТ МОРСКИХ
Dialogue: 0,0:11:23.05,0:11:26.88,Caption,,0,0,0,,ЭНЕРГОПОСТАВОК РАСТЁТ. РОССИЙСКОГО ТРУБОПРОВОДНОГО ГАЗА
Dialogue: 0,0:11:26.88,0:11:30.22,Caption,,0,0,0,,СТАНОВИТСЯ МЕНЬШЕ. ЧАСТЬ НЕХВАТКИ РАССЧИТЫВАЮТ ЗАКРЫТЬ
Dialogue: 0,0:11:30.22,0:11:33.71,Caption,,0,0,0,,ПОСТАВКАМИ ИЗ КАТАРА. ЗНАЧЕНИЕ ГАЗОВОЗОВ И ТАНКЕРОВ
Dialogue: 0,0:11:33.71,0:11:36.99,Caption,,0,0,0,,УВЕЛИЧИВАЕТСЯ ВМЕСТЕ С КАЖДЫМ НОВЫМ ОГРАНИЧЕНИЕМ.
Dialogue: 0,0:11:36.99,0:11:39.46,Caption,,0,0,0,,ПЛАН ЗАМЕЧАТЕЛЬНЫЙ. ПРИМЕРНО КАК РАЗРЕШИТЬ
Dialogue: 0,0:11:39.46,0:11:42.02,Caption,,0,0,0,,ДРАКУ ТОЛЬКО ВОЗЛЕ ЧУЖОГО ДОМА И ИСКРЕННЕ
Dialogue: 0,0:11:42.02,0:11:45.27,Caption,,0,0,0,,УДИВИТЬСЯ, КОГДА СОПЕРНИК ЗАПОМНИТ ВАШ АДРЕС.
Dialogue: 0,0:11:45.27,0:11:48.23,Caption,,0,0,0,,ПЕРВЫЙ ЖЕ УЧАСТНИК, КОТОРЫЙ ПРИМЕНИТ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:11:48.23,0:11:49.89,Caption,,0,0,0,,ТОЛКОВАНИЕ В ОБРАТНУЮ СТОРОНУ,
Dialogue: 0,0:11:50.22,0:11:52.36,Caption,,0,0,0,,ПРЕВРАТИТ УДОБНЫЙ ИНСТРУМЕНТ ДАВЛЕНИЯ
Dialogue: 0,0:11:52.36,0:11:55.43,Caption,,0,0,0,,В ПРОБЛЕМУ ДЛЯ ВСЕЙ МИРОВОЙ ТОРГОВЛИ. ПРИЧЁМ ИСТОЧНИК
Dialogue: 0,0:11:55.43,0:11:58.06,Caption,,0,0,0,,РИСКА ДЛЯ ЕВРОПЫ НАХОДИТСЯ НЕ ТОЛЬКО НА ВОСТОКЕ.
Dialogue: 0,0:11:58.06,0:12:02.13,Caption,,0,0,0,,БРИТАНСКИЕ ВЛАСТИ ОПАСАЮТСЯ, ЧТО ДОНАЛЬД ТРАМП НАНЕСЁТ НОВЫЕ
Dialogue: 0,0:12:02.13,0:12:04.93,Caption,,0,0,0,,КРУПНЫЕ УДАРЫ ПО ИРАНУ. ПО ОЦЕНКЕ БЛУМБЕРГ,
Dialogue: 0,0:12:05.17,0:12:06.91,Caption,,0,0,0,,ТАКИЕ ДЕЙСТВИЯ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:12:06.91,0:12:09.68,Caption,,0,0,0,,СЕДЬМОМ ГОДУ МОГУТ УДАРИТЬ ПО БРИТАНСКОЙ ЭКОНОМИКЕ
Dialogue: 0,0:12:09.68,0:12:12.39,Caption,,0,0,0,,И БЕЗОПАСНОСТИ. ВОТ И НОВЫЙ ПОВОРОТ.
Dialogue: 0,0:12:12.39,0:12:15.09,Caption,,0,0,0,,ЛОНДОН ГОДАМИ УЧИЛИ СМОТРЕТЬ В ОДНУ СТОРОНУ,
Dialogue: 0,0:12:15.25,0:12:18.21,Caption,,0,0,0,,ОТКУДА ЯКОБЫ ПРИХОДИТ ГЛАВНАЯ ОПАСНОСТЬ. ТЕПЕРЬ
Dialogue: 0,0:12:18.21,0:12:20.29,Caption,,0,0,0,,ПРИХОДИТСЯ СЛЕДИТЬ ЕЩЁ И ЗА БЛИЖАЙШИМ
Dialogue: 0,0:12:20.29,0:12:22.93,Caption,,0,0,0,,СОЮЗНИКОМ, ПОТОМУ ЧТО ЕГО СЛЕДУЮЩИЙ ШАГ СПОСОБЕН
Dialogue: 0,0:12:22.93,0:12:26.07,Caption,,0,0,0,,ПРИНЕСТИ БРИТАНИИ ОЧЕНЬ ДОРОГИЕ ПОСЛЕДСТВИЯ.
Dialogue: 0,0:12:26.07,0:12:28.50,Caption,,0,0,0,,ОБОСТРЕНИЕ ВОКРУГ ИРАНА ОЗНАЧАЕТ УГРОЗЫ
Dialogue: 0,0:12:28.50,0:12:31.89,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИМ МАРШРУТАМ, ТОРГОВЛЕ И БЕЗОПАСНОСТИ.
Dialogue: 0,0:12:34.17,0:12:35.90,Caption,,0,0,0,,ВАШИНГТОН МОЖЕТ ПРИНЯТЬ РЕШЕНИЕ
Dialogue: 0,0:12:35.90,0:12:38.70,Caption,,0,0,0,,САМОСТОЯТЕЛЬНО, НО СЧЁТ РАЗНЕСУТ ПО НЕСКОЛЬКИМ
Dialogue: 0,0:12:38.70,0:12:42.17,Caption,,0,0,0,,ЕВРОПЕЙСКИМ СТОЛИЦАМ. АМЕРИКА ЗАКАЖЕТ ГЛАВНОЕ БЛЮДО,
Dialogue: 0,0:12:42.44,0:12:46.33,Caption,,0,0,0,,А БРИТАНИИ ОСТАВЯТ ЧАЕВЫЕ, ДОСТАВКУ И РАЗБИТУЮ ПОСУДУ.
Dialogue: 0,0:12:47.08,0:12:48.87,Caption,,0,0,0,,В РУМЫНИИ ДОБИВАЮТСЯ ЗАКЛЮЧЕНИЯ
Dialogue: 0,0:12:48.87,0:12:52.75,Caption,,0,0,0,,ВТОРОГО ЗАМЕТНОГО ОППОЗИЦИОННОГО ЛИДЕРА ДЖОРДЖА СИМИОНА.
Dialogue: 0,0:12:52.75,0:12:55.21,Caption,,0,0,0,,ДРУГОЙ ОППОЗИЦИОНЕР, КЭЛИН ДЖОРДЖЕСКУ,
Dialogue: 0,0:12:55.45,0:12:57.13,Caption,,0,0,0,,ПОБЕДИВШИЙ НА ПРЕЗИДЕНТСКИХ ВЫБОРАХ,
Dialogue: 0,0:12:57.45,0:12:59.34,Caption,,0,0,0,,ОКАЗАЛСЯ ПОД ДОМАШНИМ АРЕСТОМ ПОСЛЕ
Dialogue: 0,0:12:59.34,0:13:02.07,Caption,,0,0,0,,СОДЕРЖАНИЯ ПОД СТРАЖЕЙ. СНАЧАЛА ЕМУ ПРИПИСАЛИ
Dialogue: 0,0:13:02.07,0:13:04.37,Caption,,0,0,0,,РОССИЙСКОЕ ФИНАНСИРОВАНИЕ. ЭТА ВЕРСИЯ
Dialogue: 0,0:13:04.37,0:13:07.45,Caption,,0,0,0,,РАССЫПАЛАСЬ, И НА СТОЛ НЕМЕДЛЕННО ЛЕГЛИ НОВЫЕ
Dialogue: 0,0:13:07.45,0:13:10.58,Caption,,0,0,0,,ОБВИНЕНИЯ МОШЕННИЧЕСТВО ДЕСЯТИЛЕТНЕЙ ДАВНОСТИ И
Dialogue: 0,0:13:10.58,0:13:13.73,Caption,,0,0,0,,НЕУДАЧНЫЕ СОВЕТЫ ПРЕДПРИНИМАТЕЛЯМ. ОЧЕНЬ УДОБНО.
Dialogue: 0,0:13:13.73,0:13:15.93,Caption,,0,0,0,,ЕСЛИ ОДНА ДВЕРЬ ОБВИНЕНИЯ НЕ ОТКРЫЛАСЬ,
Dialogue: 0,0:13:16.08,0:13:18.11,Caption,,0,0,0,,РЯДОМ УЖЕ СТОИТ КОРИДОР ЗАПАСНЫХ.
Dialogue: 0,0:13:18.11,0:13:21.41,Caption,,0,0,0,,ПОЧТИ ОДНОВРЕМЕННО ФАЙНЭНШЛ ТАЙМС СООБЩАЕТ О ПЛАНАХ
Dialogue: 0,0:13:21.41,0:13:24.87,Caption,,0,0,0,,ЗАРАНЕЕ НАЗНАЧИТЬ ПАБЛО ЭРНАНДЕСА ДЕ КОСА СЛЕДУЮЩИМ
Dialogue: 0,0:13:24.87,0:13:27.56,Caption,,0,0,0,,РУКОВОДИТЕЛЕМ ЕВРОПЕЙСКОГО ЦЕНТРАЛЬНОГО БАНКА.
Dialogue: 0,0:13:27.56,0:13:30.34,Caption,,0,0,0,,ПРИЧИНА ЕЩЁ ПРЕКРАСНЕЕ САМОЙ СПЕШКИ. В ЕВРОПЕ
Dialogue: 0,0:13:30.34,0:13:33.37,Caption,,0,0,0,,ОПАСАЮТСЯ БУДУЩИХ ПОБЕД ПРАВЫХ ПАРТИЙ ВО ФРАНЦИИ,
Dialogue: 0,0:13:33.47,0:13:36.35,Caption,,0,0,0,,ГЕРМАНИИ И ДРУГИХ СТРАНАХ. ПОЭТОМУ ИХ
Dialogue: 0,0:13:36.35,0:13:38.83,Caption,,0,0,0,,ВОЗМОЖНОЕ ВЛИЯНИЕ НА ЕВРОПЕЙСКИЙ ЦЕНТРАЛЬНЫЙ
Dialogue: 0,0:13:38.83,0:13:42.22,Caption,,0,0,0,,БАНК ПРЕДЛАГАЮТ ОГРАНИЧИТЬ ЗАРАНЕЕ. ВЫБОРЫ ПОКА НЕ
Dialogue: 0,0:13:42.22,0:13:45.85,Caption,,0,0,0,,ПРОШЛИ. ГРАЖДАНЕ НЕ ПОЛУЧИЛИ БЮЛЛЕТЕНИ. ПОБЕДИТЕЛЕЙ
Dialogue: 0,0:13:45.85,0:13:51.41,Caption,,0,0,0,,НИКТО НЕ ОБЪЯВЛЯЛ. НО НУЖНОЕ КРЕСЛО УЖЕ ХОТЯТ ЗАНЯТЬ,
Dialogue: 0,0:13:51.56,0:13:53.49,Caption,,0,0,0,,ЧТОБЫ БУДУЩИЙ РЕЗУЛЬТАТ СЛУЧАЙНО НЕ
Dialogue: 0,0:13:53.49,0:13:56.41,Caption,,0,0,0,,ПОВЛИЯЛ НА ВАЖНОЕ УЧРЕЖДЕНИЕ. ЭТО ДЕМОКРАТИЯ С
Dialogue: 0,0:13:56.41,0:13:59.43,Caption,,0,0,0,,ЗАБОТЛИВЫМ ОБСЛУЖИВАНИЕМ. ИЗБИРАТЕЛЮ РАЗРЕШАЮТ
Dialogue: 0,0:13:59.43,0:14:02.36,Caption,,0,0,0,,ВЫБРАТЬ, НО НАИБОЛЕЕ ХРУПКИЕ ПРЕДМЕТЫ ЗАРАНЕЕ
Dialogue: 0,0:14:02.36,0:14:04.96,Caption,,0,0,0,,УБИРАЮТ ПОДАЛЬШЕ. ВДРУГ ОН ПРОГОЛОСУЕТ НЕЛОВКО
Dialogue: 0,0:14:04.96,0:14:07.91,Caption,,0,0,0,,И ЧТО НИБУДЬ РАЗОБЬЁТ. ТАК СКЛАДЫВАЕТСЯ ОБЩИЙ
Dialogue: 0,0:14:07.91,0:14:10.43,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ПОРТРЕТ. ПРОТИВ РОССИИ ГОТОВЯТ
Dialogue: 0,0:14:10.43,0:14:12.37,Caption,,0,0,0,,ДВАДЦАТЬ ВТОРОЙ НАБОР ОГРАНИЧЕНИЙ,
Dialogue: 0,0:14:12.61,0:14:15.97,Caption,,0,0,0,,НЕ ОБЪЯСНИВ, ПОЧЕМУ ПЕРВЫЕ ДВАДЦАТЬ ОДИН НЕ ПРИВЕЛИ
Dialogue: 0,0:14:15.97,0:14:18.78,Caption,,0,0,0,,К ЗАЯВЛЕННОМУ РЕЗУЛЬТАТУ. ПОСЛЕДСТВИЯ ОТКАЗА ОТ
Dialogue: 0,0:14:18.78,0:14:21.56,Caption,,0,0,0,,ПРИВЫЧНЫХ ЭНЕРГОРЕСУРСОВ СЧИТАЮТ ПОСЛЕ ПРИНЯТЫХ
Dialogue: 0,0:14:21.56,0:14:24.62,Caption,,0,0,0,,РЕШЕНИЙ. УКРАИНЕ ОБЕЩАЮТ ДЕСЯТКИ МИЛЛИАРДОВ НА
Dialogue: 0,0:14:24.62,0:14:27.98,Caption,,0,0,0,,ГОДЫ ВПЕРЁД, ПОКА БАБИШ БЕЗУСПЕШНО ИЩЕТ КОНЕЧНУЮ
Dialogue: 0,0:14:27.98,0:14:31.01,Caption,,0,0,0,,ТОЧКУ МАРШРУТА. А ВОЗМОЖНОЕ РЕШЕНИЕ БУДУЩИХ
Dialogue: 0,0:14:31.01,0:14:34.22,Caption,,0,0,0,,ИЗБИРАТЕЛЕЙ СТАРАЮТСЯ ОБЕЗВРЕДИТЬ ЕЩЁ ДО ИХ ПРИХОДА НА
Dialogue: 0,0:14:34.22,0:14:37.01,Caption,,0,0,0,,УЧАСТОК. ЗА ПЯТЬ ЛЕТ РУССКИЙ МЕДВЕДЬ УСПЕЛ
Dialogue: 0,0:14:37.01,0:14:40.15,Caption,,0,0,0,,ПРИСПОСОБИТЬСЯ КО МНОГИМ КАПКАНАМ. ЕВРОПА ЖЕ ТОЛЬКО
Dialogue: 0,0:14:40.15,0:14:42.29,Caption,,0,0,0,,ОТКРЫВАЕТ ИНСТРУКЦИЮ К ТЕМ ЛОВУШКАМ,
Dialogue: 0,0:14:42.46,0:14:44.08,Caption,,0,0,0,,КОТОРЫЕ РАССТАВИЛА СОБСТВЕННЫМИ
Dialogue: 0,0:14:44.08,0:14:44.45,Caption,,0,0,0,,РУКАМИ.
