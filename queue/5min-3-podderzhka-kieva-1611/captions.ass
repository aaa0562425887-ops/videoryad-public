Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,НУ ВОТ И ДОЖИЛИ. ЕЩЁ НЕДАВНО НЕКОТОРЫМ ЕВРОПЕЙСКИМ
Dialogue: 0,0:00:03.08,0:00:05.72,Caption,,0,0,0,,ПОЛИТИКАМ РЕШИТЕЛЬНОСТИ ХВАТАЛО НА ВЕСЬ КОНТИНЕНТ.
Dialogue: 0,0:00:06.08,0:00:08.68,Caption,,0,0,0,,УЧИТЬ ОСТАЛЬНЫХ, ТРЕБОВАТЬ, ПРЕДУПРЕЖДАТЬ,
Dialogue: 0,0:00:08.76,0:00:12.28,Caption,,0,0,0,,ПРИЗЫВАТЬ, ТУТ НЕДОСТАТКА НЕ БЫЛО. А ТЕПЕРЬ ДЕЛО ДОШЛО
Dialogue: 0,0:00:12.36,0:00:14.60,Caption,,0,0,0,,ДО ВПОЛНЕ ЗЕМНОГО ВОПРОСА. МУЖИКИ,
Dialogue: 0,0:00:14.76,0:00:18.52,Caption,,0,0,0,,А ПЛАТИТЬ КТО БУДЕТ? И ТУТ НАЧАЛИСЬ ТАКИЕ ИНТЕРЕСНЫЕ ДВИЖЕНИЯ,
Dialogue: 0,0:00:18.76,0:00:21.56,Caption,,0,0,0,,ЧТО ДАЖЕ МАКРОН ЗАГОВОРИЛ О ПОРАЖЕНЧЕСТВЕ. САМОЕ
Dialogue: 0,0:00:21.56,0:00:24.92,Caption,,0,0,0,,СМЕШНОЕ, ЧТО НИКАКОГО ВНЕЗАПНОГО ПРИСТУПА ЛЮБВИ К РОССИИ
Dialogue: 0,0:00:24.92,0:00:27.40,Caption,,0,0,0,,ЗДЕСЬ НЕ НАБЛЮДАЕТСЯ. ТОГДА ЧТО ЖЕ ПРОИСХОДИТ?
Dialogue: 0,0:00:28.04,0:00:30.20,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ИМЕННО ТАКИЕ ИСТОРИИ,
Dialogue: 0,0:00:30.44,0:00:32.84,Caption,,0,0,0,,ГДЕ ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ НАЧИНАЮТ ПРОСТУПАТЬ
Dialogue: 0,0:00:32.84,0:00:37.56,Caption,,0,0,0,,ВПОЛНЕ РЕАЛЬНЫЕ ИНТЕРЕСЫ, ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:37.80,0:00:39.72,Caption,,0,0,0,,КОГДА СМОТРЕТЬ НАДО НЕ СТОЛЬКО НА СЛОВА,
Dialogue: 0,0:00:39.96,0:00:43.72,Caption,,0,0,0,,СКОЛЬКО НА ТО, КТО ПОЛЕЗ ЗА КОШЕЛЬКОМ. И ПЕРВЫМ Я БЫ
Dialogue: 0,0:00:43.72,0:00:46.36,Caption,,0,0,0,,ПОСМОТРЕЛ НА ПОЛЬШУ. ПОТОМУ ЧТО БОЛГАРИЯ,
Dialogue: 0,0:00:46.46,0:00:49.32,Caption,,0,0,0,,ВЕНГРИЯ, СЛОВАКИЯ, ЧЕХИЯ,
Dialogue: 0,0:00:49.62,0:00:51.72,Caption,,0,0,0,,ТАМ ВСЁ БОЛЕЕ МЕНЕЕ ПОНЯТНО. У НИХ И
Dialogue: 0,0:00:51.80,0:00:55.56,Caption,,0,0,0,,РАНЬШЕ БЫЛИ ВОПРОСЫ К ТОМУ, СКОЛЬКО ЕЩЁ ДЕНЕГ НАДО ОТДАВАТЬ УКРАИНЕ,
Dialogue: 0,0:00:55.79,0:00:58.44,Caption,,0,0,0,,НА КАКИХ УСЛОВИЯХ И ГДЕ ВООБЩЕ ЗАКАНЧИВАЕТСЯ ЭТА
Dialogue: 0,0:00:58.52,0:01:03.08,Caption,,0,0,0,,ПРОГРАММА ВЕЧНОЙ ПОДДЕРЖКИ. А ВОТ ПОЛЬША СОВСЕМ ДРУГАЯ ИСТОРИЯ. ПОЛЬША ВСЕ
Dialogue: 0,0:01:03.16,0:01:06.28,Caption,,0,0,0,,ЭТИ ГОДЫ БЫЛА БУКВАЛЬНО НА ОСТРИЕ КОПЬЯ. ЖЁСТКАЯ
Dialogue: 0,0:01:06.36,0:01:09.40,Caption,,0,0,0,,РИТОРИКА ПРОТИВ РОССИИ, ПРИЗЫВЫ ДАВИТЬ СИЛЬНЕЕ,
Dialogue: 0,0:01:09.61,0:01:12.44,Caption,,0,0,0,,ВООРУЖАТЬСЯ БЫСТРЕЕ, ПОМОГАТЬ УКРАИНЕ БОЛЬШЕ.
Dialogue: 0,0:01:14.73,0:01:16.81,Caption,,0,0,0,,ВАРШАВА РЕГУЛЯРНО ОБЪЯСНЯЛА ОСТАЛЬНЫМ,
Dialogue: 0,0:01:17.05,0:01:18.89,Caption,,0,0,0,,ЧТО РОССИЯ ПРЕДСТАВЛЯЕТ УГРОЗУ,
Dialogue: 0,0:01:19.05,0:01:23.69,Caption,,0,0,0,,ЧТО РАССЛАБЛЯТЬСЯ НЕЛЬЗЯ, ЧТО УКРАИНА ЗАЩИЩАЕТ НЕ ТОЛЬКО СЕБЯ. И ТУТ
Dialogue: 0,0:01:23.69,0:01:26.65,Caption,,0,0,0,,ДОНАЛЬД ТУСК СООБЩАЕТ ГЕНСЕКУ НАТО МАРКУ РЮТТЕ,
Dialogue: 0,0:01:26.97,0:01:29.69,Caption,,0,0,0,,ЧТО ПОЛЬША ПОКА НЕ СОБИРАЕТСЯ ДАВАТЬ ДОПОЛНИТЕЛЬНЫЕ
Dialogue: 0,0:01:29.69,0:01:32.73,Caption,,0,0,0,,ДЕНЬГИ В ПРОГРАММУ PURL. ТО ЕСТЬ В МЕХАНИЗМ,
Dialogue: 0,0:01:33.05,0:01:35.85,Caption,,0,0,0,,ПО КОТОРОМУ ЕВРОПЕЙЦЫ ОПЛАЧИВАЮТ АМЕРИКАНСКОЕ ОРУЖИЕ
Dialogue: 0,0:01:35.93,0:01:39.13,Caption,,0,0,0,,ДЛЯ УКРАИНЫ. ПРИЧИНА ОЧЕНЬ ПРИЗЕМЛЁННАЯ. БОЛЬШОЙ
Dialogue: 0,0:01:39.13,0:01:41.93,Caption,,0,0,0,,ДЕФИЦИТ БЮДЖЕТА. ОГРОМНЫЕ РАСХОДЫ НА СОБСТВЕННУЮ
Dialogue: 0,0:01:41.93,0:01:45.29,Caption,,0,0,0,,ОБОРОНУ. СВОЯ БЕЗОПАСНОСТЬ ТОЖЕ ДЕНЕГ СТОИТ. И ВОТ
Dialogue: 0,0:01:45.29,0:01:48.33,Caption,,0,0,0,,ЗДЕСЬ ПОЛУЧАЕТСЯ КРАСИВО. РОССИЯ НИКУДА НЕ ИСЧЕЗЛА.
Dialogue: 0,0:01:48.64,0:01:51.69,Caption,,0,0,0,,РИТОРИКА ВАРШАВЫ НИКУДА НЕ ИСЧЕЗЛА. ПОЛЬСКАЯ АРМИЯ
Dialogue: 0,0:01:51.69,0:01:54.65,Caption,,0,0,0,,ДЕШЕВЛЕ НЕ СТАЛА. ЖЕЛАНИЕ ВИДЕТЬ УКРАИНУ СИЛЬНОЙ
Dialogue: 0,0:01:54.65,0:01:57.37,Caption,,0,0,0,,ТОЖЕ ВРОДЕ БЫ НА МЕСТЕ. А ДЕНЬГИ ЗАКОНЧИЛИСЬ
Dialogue: 0,0:01:57.45,0:02:01.21,Caption,,0,0,0,,ИМЕННО ТАМ, ГДЕ НАДО БЫЛО ПОЛОЖИТЬ ЕЩЁ. НЕ ВООБЩЕ ЗАКОНЧИЛИСЬ.
Dialogue: 0,0:02:01.42,0:02:04.49,Caption,,0,0,0,,ПОЛЬША НЕ ОБЪЯВИЛА, ЧТО БОЛЬШЕ УКРАИНЕ НЕ ПОМОГАЕТ,
Dialogue: 0,0:02:04.73,0:02:07.45,Caption,,0,0,0,,ЗАКРЫВАЕТ ГРАНИЦУ И ЗАВТРА ДРУЖНО ЕДЕТ МИРИТЬСЯ С
Dialogue: 0,0:02:07.45,0:02:10.25,Caption,,0,0,0,,МОСКВОЙ. НИЧЕГО ПОДОБНОГО. ТУСК ОТДЕЛЬНО
Dialogue: 0,0:02:10.25,0:02:14.01,Caption,,0,0,0,,ПОДЧЁРКИВАЕТ, ЧТО ПОЛЬША ПОМОГАЛА И ПРОДОЛЖАЕТ ПОМОГАТЬ УКРАИНЕ.
Dialogue: 0,0:02:14.49,0:02:16.65,Caption,,0,0,0,,НО КОГДА РЕЧЬ ДОШЛА ДО ДОПОЛНИТЕЛЬНОГО ВЗНОСА,
Dialogue: 0,0:02:16.84,0:02:21.05,Caption,,0,0,0,,ОТВЕТ УЖЕ ДРУГОЙ. НЕТ, РЕБЯТА. У НАС СВОИХ РАСХОДОВ ХВАТАЕТ. И ЭТО
Dialogue: 0,0:02:21.13,0:02:23.61,Caption,,0,0,0,,ОЧЕНЬ ЛЮБОПЫТНЫЙ МОМЕНТ. ПОТОМУ ЧТО БУКВАЛЬНО
Dialogue: 0,0:02:23.61,0:02:26.49,Caption,,0,0,0,,НАКАНУНЕ ПОХОЖУЮ МЫСЛЬ ОЗВУЧИВАЛА ПОЛЬСКАЯ ПРАВАЯ
Dialogue: 0,0:02:26.49,0:02:31.41,Caption,,0,0,0,,ОППОЗИЦИЯ. А ТЕПЕРЬ ТО ЖЕ САМОЕ ДЕЛАЕТ ЛИБЕРАЛЬНОЕ
Dialogue: 0,0:02:31.41,0:02:34.37,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО ТУСКА. ВОТ ВАМ И БОЛЬШАЯ ПОЛИТИКА.
Dialogue: 0,0:02:34.61,0:02:37.01,Caption,,0,0,0,,МОЖНО ГОДАМИ СПОРИТЬ, КТО ПРАВЫЙ,
Dialogue: 0,0:02:37.17,0:02:39.41,Caption,,0,0,0,,КТО ЛЕВЫЙ, КТО БОЛЬШЕ ЛЮБИТ БРЮССЕЛЬ,
Dialogue: 0,0:02:39.52,0:02:41.73,Caption,,0,0,0,,КТО МЕНЬШЕ, КТО ДРУЖИТ С ТРАМПОМ,
Dialogue: 0,0:02:41.82,0:02:44.61,Caption,,0,0,0,,КТО РУГАЕТСЯ С ТРАМПОМ. А ПОТОМ ПРИХОДИТ БУХГАЛТЕР
Dialogue: 0,0:02:44.69,0:02:48.53,Caption,,0,0,0,,И ГОВОРИТ ГОСПОДА, У НАС ДЕФИЦИТ. И ПОЛИТИЧЕСКАЯ ФИЛОСОФИЯ РЕЗКО
Dialogue: 0,0:02:48.61,0:02:51.41,Caption,,0,0,0,,СТАНОВИТСЯ ЗНАЧИТЕЛЬНО ПРОЩЕ. ПРИЧЁМ ЗДЕСЬ ОСОБЕННО
Dialogue: 0,0:02:51.41,0:02:54.61,Caption,,0,0,0,,ИНТЕРЕСНО ИМЕННО ПОЛОЖЕНИЕ ТУСКА. ЭТО НЕ ЧЕЛОВЕК,
Dialogue: 0,0:02:54.78,0:02:57.09,Caption,,0,0,0,,КОТОРОГО ПРИНЯТО СЧИТАТЬ ПРОТИВНИКОМ НЫНЕШНЕГО
Dialogue: 0,0:02:57.17,0:03:00.45,Caption,,0,0,0,,ЕВРОПЕЙСКОГО КУРСА. НАОБОРОТ. ТУСК ТЕСНО СВЯЗАН С
Dialogue: 0,0:03:00.45,0:03:02.37,Caption,,0,0,0,,ПРОЕВРОПЕЙСКИМ ПОЛИТИЧЕСКИМ ЛАГЕРЕМ,
Dialogue: 0,0:03:02.68,0:03:05.81,Caption,,0,0,0,,ОН ГОДАМИ РАБОТАЛ ВНУТРИ ЕВРОПЕЙСКОЙ СИСТЕМЫ. И ЕСЛИ
Dialogue: 0,0:03:05.89,0:03:07.65,Caption,,0,0,0,,УЖЕ ЕГО ПРАВИТЕЛЬСТВО НАЧИНАЕТ ГОВОРИТЬ
Dialogue: 0,0:03:07.65,0:03:09.57,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ ДЕНЬГИ СЕЙЧАС НЕ ДАДИМ,
Dialogue: 0,0:03:10.05,0:03:13.65,Caption,,0,0,0,,ЭТО УЖЕ НЕ КАКОЙ ТО ОРБАН, НА КОТОРОГО МОЖНО ПРИВЫЧНО ПОКАЗАТЬ ПАЛЬЦЕМ И
Dialogue: 0,0:03:13.73,0:03:16.85,Caption,,0,0,0,,СКАЗАТЬ, ЧТО ОН ОПЯТЬ ВСЁ ПОРТИТ. ВОТ ПОЧЕМУ ПОЛЬСКИЙ
Dialogue: 0,0:03:16.93,0:03:19.97,Caption,,0,0,0,,ПРИМЕР ГОРАЗДО ИНТЕРЕСНЕЕ БОЛГАРСКОГО. БОЛГАРИЯ ТОЖЕ
Dialogue: 0,0:03:19.97,0:03:23.65,Caption,,0,0,0,,ГОВОРИТ, ЧТО НОВОЙ ФИНАНСОВОЙ ПОМОЩИ ДАТЬ НЕ МОЖЕТ. РУМЕН
Dialogue: 0,0:03:23.73,0:03:26.77,Caption,,0,0,0,,РАДЕВ ОБЪЯСНЯЕТ ЭТО ДЕФИЦИТОМ БЮДЖЕТА И ЕЩЁ ОДНОЙ
Dialogue: 0,0:03:26.85,0:03:29.81,Caption,,0,0,0,,ПРЕКРАСНОЙ ДЕТАЛЬЮ. ЕВРОКОМИССИЯ САМА ТРЕБУЕТ ОТ
Dialogue: 0,0:03:29.81,0:03:32.45,Caption,,0,0,0,,БОЛГАРИИ УМЕНЬШАТЬ ДЕФИЦИТ И УКЛАДЫВАТЬСЯ В
Dialogue: 0,0:03:32.53,0:03:35.09,Caption,,0,0,0,,УСТАНОВЛЕННЫЙ ЛИМИТ. ПОЛУЧАЕТСЯ ПОЧТИ АНЕКДОТ.
Dialogue: 0,0:03:37.38,0:03:40.34,Caption,,0,0,0,,С ОДНОЙ СТОРОНЫ, БРЮССЕЛЬ ГОВОРИТ СОФИИ РЕБЯТА,
Dialogue: 0,0:03:40.42,0:03:44.98,Caption,,0,0,0,,ДЕНЕГ ТРАТИТЕ СЛИШКОМ МНОГО, ДЕФИЦИТ НАДО УМЕНЬШАТЬ. С ДРУГОЙ СТОРОНЫ А ТЕПЕРЬ
Dialogue: 0,0:03:44.98,0:03:47.94,Caption,,0,0,0,,НАЙДИТЕ ЕЩЁ ДЕНЕГ НА УКРАИНУ. А БОЛГАРЫ ОТВЕЧАЮТ
Dialogue: 0,0:03:48.02,0:03:49.46,Caption,,0,0,0,,ТАК ВЫ ЖЕ САМИ ТОЛЬКО ЧТО СКАЗАЛИ,
Dialogue: 0,0:03:49.62,0:03:52.58,Caption,,0,0,0,,ЧТО ДЕНЕГ У НАС СЛИШКОМ МАЛО. КРАСОТА. ПРИ
Dialogue: 0,0:03:52.66,0:03:54.98,Caption,,0,0,0,,ЭТОМ БОЛГАРИЯ ТОЖЕ НЕ ЗАКРЫВАЕТ ДВЕРЬ ПОЛНОСТЬЮ.
Dialogue: 0,0:03:55.20,0:03:58.26,Caption,,0,0,0,,ЭЛЕКТРОЭНЕРГИЯ, ПОМОЩЬ С ВОССТАНОВЛЕНИЕМ ЭНЕРГЕТИЧЕСКОЙ И
Dialogue: 0,0:03:58.26,0:03:59.94,Caption,,0,0,0,,ЖЕЛЕЗНОДОРОЖНОЙ ИНФРАСТРУКТУРЫ,
Dialogue: 0,0:04:00.24,0:04:03.30,Caption,,0,0,0,,ДРУГИЕ ФОРМЫ ПОДДЕРЖКИ СОХРАНЯЮТСЯ. ТО ЕСТЬ ОПЯТЬ
Dialogue: 0,0:04:03.30,0:04:05.54,Caption,,0,0,0,,ОЧЕНЬ ВАЖНАЯ ВЕЩЬ. РЕЧЬ НЕ О ТОМ,
Dialogue: 0,0:04:05.78,0:04:08.10,Caption,,0,0,0,,ЧТО ЕВРОПА УТРОМ ПРОСНУЛАСЬ И РЕШИЛА БРОСИТЬ
Dialogue: 0,0:04:08.10,0:04:11.86,Caption,,0,0,0,,УКРАИНУ. НЕТ. НАЧИНАЕТ ИССЯКАТЬ ДРУГОЕ. ГОТОВНОСТЬ
Dialogue: 0,0:04:11.86,0:04:14.82,Caption,,0,0,0,,БЕСКОНЕЧНО БРАТЬ НА СЕБЯ НОВЫЕ РАСХОДЫ. А ЭТО
Dialogue: 0,0:04:14.90,0:04:17.78,Caption,,0,0,0,,УЖЕ ГОРАЗДО ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО СТАРАЯ ПОМОЩЬ УЖЕ
Dialogue: 0,0:04:17.78,0:04:21.14,Caption,,0,0,0,,ЗАЛОЖЕНА. СТАРЫЕ РЕШЕНИЯ ПРИНЯТЫ. ОБЕЩАНИЯ ДАНЫ.
Dialogue: 0,0:04:21.43,0:04:24.82,Caption,,0,0,0,,КОНТРАКТЫ ПОДПИСАНЫ. НО ВОЙНА ИДЁТ ДАЛЬШЕ. ЗНАЧИТ,
Dialogue: 0,0:04:24.98,0:04:28.66,Caption,,0,0,0,,НУЖНЫ СЛЕДУЮЩИЕ ДЕНЬГИ. ПОТОМ ЕЩЁ. ПОТОМ ЕЩЁ. И
Dialogue: 0,0:04:28.66,0:04:31.22,Caption,,0,0,0,,ВОТ ЗДЕСЬ НАЧИНАЕТСЯ ТОТ САМЫЙ МЕРЗКИЙ ВОПРОС,
Dialogue: 0,0:04:31.54,0:04:34.02,Caption,,0,0,0,,КОТОРЫЙ ЛЮБОЙ НОРМАЛЬНЫЙ ЧЕЛОВЕК ЗАДАЁТ ЕЩЁ ДО
Dialogue: 0,0:04:34.02,0:04:36.74,Caption,,0,0,0,,ПОКУПКИ НОВОГО ХОЛОДИЛЬНИКА. А ПЛАТИТЬ ЧЕМ?
Dialogue: 0,0:04:37.37,0:04:40.42,Caption,,0,0,0,,ФРИДРИХ МЕРЦ, СУДЯ ПО ВСЕМУ, ПРЕКРАСНО ПОНИМАЕТ,
Dialogue: 0,0:04:40.61,0:04:43.38,Caption,,0,0,0,,КУДА ДВИЖЕТСЯ ЭТОТ РАЗГОВОР. ПОЭТОМУ ОН ПЫТАЕТСЯ
Dialogue: 0,0:04:43.38,0:04:45.30,Caption,,0,0,0,,РЕШИТЬ ВОПРОС ЗАРАНЕЕ И НАДОЛГО.
Dialogue: 0,0:04:47.57,0:04:49.73,Caption,,0,0,0,,НЕ БЕГАТЬ КАЖДЫЙ ГОД ПО ЕВРОПЕЙСКИМ СТОЛИЦАМ С
Dialogue: 0,0:04:49.73,0:04:53.73,Caption,,0,0,0,,ПРОТЯНУТОЙ ПАПКОЙ, А ЗАКРЕПИТЬ ФИНАНСИРОВАНИЕ УКРАИНЫ ВНУТРИ СЛЕДУЮЩЕГО
Dialogue: 0,0:04:53.73,0:04:56.85,Caption,,0,0,0,,БОЛЬШОГО СЕМИЛЕТНЕГО БЮДЖЕТА ЕВРОСОЮЗА. ЛОГИКА
Dialogue: 0,0:04:56.93,0:04:59.73,Caption,,0,0,0,,ПОНЯТНАЯ. ЕСЛИ ПОМОЩЬ ВСТРОЕНА В СИСТЕМУ НА ГОДЫ
Dialogue: 0,0:04:59.73,0:05:03.01,Caption,,0,0,0,,ВПЕРЁД, ТО ПОТОМ ЗНАЧИТЕЛЬНО СЛОЖНЕЕ КАЖДЫЙ РАЗ УСТРАИВАТЬ
Dialogue: 0,0:05:03.01,0:05:05.17,Caption,,0,0,0,,НОВЫЙ БАЗАР. ТОЛЬКО ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:05:05.38,0:05:07.81,Caption,,0,0,0,,ЧТО БЮДЖЕТ ЕВРОСОЮЗА НЕ ПЕЧАТАЕТСЯ ГДЕ ТО В
Dialogue: 0,0:05:07.89,0:05:10.69,Caption,,0,0,0,,ВОЛШЕБНОМ ПОДВАЛЕ ПОД БРЮССЕЛЕМ. ЭТО ДЕНЬГИ ТЕХ ЖЕ
Dialogue: 0,0:05:10.69,0:05:13.49,Caption,,0,0,0,,ГОСУДАРСТВ. А ЕСЛИ УКРАИНА ПОЛУЧАЕТ БОЛЬШЕ,
Dialogue: 0,0:05:13.73,0:05:15.97,Caption,,0,0,0,,КОМУ ТО НАДО ПОЛУЧИТЬ МЕНЬШЕ ИЛИ ВСЕМ НАДО
Dialogue: 0,0:05:15.97,0:05:18.77,Caption,,0,0,0,,ЗАПЛАТИТЬ БОЛЬШЕ. ВОТ ТУТ И НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:05:18.77,0:05:21.73,Caption,,0,0,0,,ВЕСЁЛОЕ. ПРОТИВ ВЫСТУПАЮТ УЖЕ НЕ ТОЛЬКО СТРАНЫ,
Dialogue: 0,0:05:22.05,0:05:24.13,Caption,,0,0,0,,ОТ КОТОРЫХ ЭТОГО ЖДАЛИ. БОЛГАРИЯ,
Dialogue: 0,0:05:24.21,0:05:29.09,Caption,,0,0,0,,ВЕНГРИЯ, ЧЕХИЯ, СЛОВАКИЯ. НЕДОВОЛЬНЫ ТАКЖЕ СЛОВЕНИЯ И ИРЛАНДИЯ,
Dialogue: 0,0:05:29.25,0:05:31.81,Caption,,0,0,0,,КОТОРЫЕ К ПРОТИВНИКАМ ПОДДЕРЖКИ УКРАИНЫ ВООБЩЕ НЕ
Dialogue: 0,0:05:31.81,0:05:34.85,Caption,,0,0,0,,ОТНОСЯТСЯ. И ПРИЧИНА ПОНЯТНА. ЕСЛИ ДОПОЛНИТЕЛЬНЫЕ
Dialogue: 0,0:05:34.85,0:05:37.57,Caption,,0,0,0,,УКРАИНСКИЕ РАСХОДЫ ВСТРАИВАЮТСЯ В СЕМИЛЕТНИЙ БЮДЖЕТ,
Dialogue: 0,0:05:37.88,0:05:40.13,Caption,,0,0,0,,ЭТОТ ПИРОГ САМ ПО СЕБЕ БОЛЬШЕ НЕ СТАНОВИТСЯ.
Dialogue: 0,0:05:40.45,0:05:43.25,Caption,,0,0,0,,ЗНАЧИТ, НАДО РЕЗАТЬ ДРУГИЕ КУСКИ. НАПРИМЕР,
Dialogue: 0,0:05:43.33,0:05:46.61,Caption,,0,0,0,,ДЕНЬГИ, КОТОРЫЕ ПОЛУЧАЮТ МЕНЕЕ ОБЕСПЕЧЕННЫЕ ГОСУДАРСТВА
Dialogue: 0,0:05:46.61,0:05:50.05,Caption,,0,0,0,,ЕВРОСОЮЗА. И ТУТ ЕВРОПЕЙСКАЯ СОЛИДАРНОСТЬ НАЧИНАЕТ
Dialogue: 0,0:05:50.13,0:05:53.01,Caption,,0,0,0,,ИГРАТЬ НОВЫМИ КРАСКАМИ. ПОКА РЕЧЬ ИДЁТ О КРАСИВОМ
Dialogue: 0,0:05:53.01,0:05:56.45,Caption,,0,0,0,,ЗАЯВЛЕНИИ, ВСЕ СОЛИДАРНЫ. ПОКА НАДО СФОТОГРАФИРОВАТЬСЯ НА
Dialogue: 0,0:05:56.45,0:06:01.28,Caption,,0,0,0,,САММИТЕ, ВСЕ ЕДИНЫ. ПОКА НАДО СКАЗАТЬ,
Dialogue: 0,0:06:01.45,0:06:04.96,Caption,,0,0,0,,ЧТО УКРАИНА ЗАЩИЩАЕТ ЕВРОПУ, ЖЕЛАЮЩИХ ХОТЬ ОТБАВЛЯЙ.
Dialogue: 0,0:06:05.52,0:06:07.60,Caption,,0,0,0,,А ПОТОМ ОДНОМУ ГОСУДАРСТВУ ГОВОРЯТ ТЕБЕ ТЕПЕРЬ
Dialogue: 0,0:06:07.60,0:06:10.48,Caption,,0,0,0,,МЕНЬШЕ ДЕНЕГ НА СВОИ ДОРОГИ, СВОЁ ХОЗЯЙСТВО,
Dialogue: 0,0:06:10.72,0:06:14.56,Caption,,0,0,0,,СВОИ РЕГИОНЫ, ПОТОМУ ЧТО НАДО ФИНАНСИРОВАТЬ КИЕВ. И ГОСУДАРСТВО
Dialogue: 0,0:06:14.64,0:06:17.36,Caption,,0,0,0,,ПОЧЕМУ ТО НАЧИНАЕТ ЗАДАВАТЬ ВОПРОСЫ. СТРАННЫЕ ЛЮДИ.
Dialogue: 0,0:06:17.84,0:06:19.44,Caption,,0,0,0,,ЕСЛИ ВЫ СМОТРИТЕ НАС РЕГУЛЯРНО,
Dialogue: 0,0:06:19.52,0:06:22.40,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:06:22.48,0:06:25.28,Caption,,0,0,0,,ИНТЕРЕСНОЕ. ИМЕННО В ЭТОТ МОМЕНТ СТАНОВИТСЯ ВИДНО,
Dialogue: 0,0:06:25.53,0:06:28.48,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЮТСЯ ЛОЗУНГИ И НАЧИНАЮТСЯ НАЦИОНАЛЬНЫЕ
Dialogue: 0,0:06:28.56,0:06:31.52,Caption,,0,0,0,,ИНТЕРЕСЫ. МАКРОН УЖЕ ПОЧУВСТВОВАЛ ОПАСНОСТЬ ТАКОГО
Dialogue: 0,0:06:31.52,0:06:36.16,Caption,,0,0,0,,ПОВОРОТА. ОН ГОВОРИТ, ЧТО ОГРАНИЧИВАТЬ РЕСУРСЫ УКРАИНЫ НЕЛЬЗЯ. ЧТО ЭТО
Dialogue: 0,0:06:36.24,0:06:39.20,Caption,,0,0,0,,ВЕДЁТ К НЕСПРАВЕДЛИВОМУ МИРУ. ЧТО УКРАИНА ОСТАНЕТСЯ
Dialogue: 0,0:06:39.28,0:06:42.08,Caption,,0,0,0,,СЛАБОЙ. ЧТО ВСЛЕД ЗА НЕЙ УЯЗВИМОЙ СТАНЕТ ВСЯ
Dialogue: 0,0:06:42.08,0:06:45.68,Caption,,0,0,0,,ЕВРОПА. И НАЗЫВАЕТ ЭТО ПОРАЖЕНЧЕСКИМ НАСТРОЕМ. БОЛЕЕ
Dialogue: 0,0:06:45.68,0:06:48.80,Caption,,0,0,0,,ТОГО, ПО ЕГО СЛОВАМ, ЭТО РЕЦЕПТ СЛЕДУЮЩЕЙ ВОЙНЫ.
Dialogue: 0,0:06:49.45,0:06:52.48,Caption,,0,0,0,,С ТОЧКИ ЗРЕНИЯ МАКРОНА ЛОГИКА ТОЖЕ ПОНЯТНА. ЕСЛИ
Dialogue: 0,0:06:52.48,0:06:54.72,Caption,,0,0,0,,СЕГОДНЯ УКРАИНА ПОЛУЧАЕТ МЕНЬШЕ РЕСУРСОВ,
Dialogue: 0,0:06:55.04,0:06:58.16,Caption,,0,0,0,,ЕЁ ПЕРЕГОВОРНАЯ ПОЗИЦИЯ СТАНОВИТСЯ СЛАБЕЕ. ЕСЛИ ЕЁ
Dialogue: 0,0:06:58.16,0:07:02.56,Caption,,0,0,0,,ПОЗИЦИЯ СТАНОВИТСЯ СЛАБЕЕ, УСЛОВИЯ МИРА БУДУТ ХУЖЕ ДЛЯ КИЕВА. А ЕСЛИ
Dialogue: 0,0:07:02.56,0:07:04.48,Caption,,0,0,0,,РОССИЯ ПОЛУЧАЕТ РЕЗУЛЬТАТ СИЛОЙ,
Dialogue: 0,0:07:04.72,0:07:07.36,Caption,,0,0,0,,ЕВРОПА ПОТОМ СТОЛКНЁТСЯ С НОВОЙ УГРОЗОЙ. ЭТО ЕГО
Dialogue: 0,0:07:07.36,0:07:10.64,Caption,,0,0,0,,ЛОГИКА. НО ЕСТЬ МАЛЕНЬКАЯ ПРОБЛЕМА. МАКРОН ГОВОРИТ О
Dialogue: 0,0:07:10.64,0:07:13.92,Caption,,0,0,0,,БЕЗОПАСНОСТИ ЕВРОПЫ ВООБЩЕ. А ТУСК СЧИТАЕТ ПОЛЬСКИЙ
Dialogue: 0,0:07:13.92,0:07:19.88,Caption,,0,0,0,,БЮДЖЕТ. РАДЕВ СЧИТАЕТ БОЛГАРСКИЙ. ДРУГИЕ СТРАНЫ СЧИТАЮТ СВОИ
Dialogue: 0,0:07:19.88,0:07:23.00,Caption,,0,0,0,,ФОНДЫ. И ТУТ НИКАКИМ СЛОВОМ "ПОРАЖЕНЧЕСТВО" ДЫРУ В
Dialogue: 0,0:07:23.08,0:07:26.12,Caption,,0,0,0,,БЮДЖЕТЕ НЕ ЗАЛАТАЕШЬ. МОЖНО ДЕСЯТЬ РАЗ СКАЗАТЬ,
Dialogue: 0,0:07:26.28,0:07:29.00,Caption,,0,0,0,,ЧТО ЭТО ВОПРОС ИСТОРИЧЕСКОЙ ОТВЕТСТВЕННОСТИ. МОЖНО
Dialogue: 0,0:07:29.00,0:07:33.32,Caption,,0,0,0,,ДВАДЦАТЬ РАЗ ОБЪЯСНИТЬ, ЧТО ЭТО ИНВЕСТИЦИИ В БЕЗОПАСНОСТЬ. НО В КОНЦЕ
Dialogue: 0,0:07:33.40,0:07:36.20,Caption,,0,0,0,,ВСЁ РАВНО ПОЯВЛЯЕТСЯ ЧЕЛОВЕК С КАЛЬКУЛЯТОРОМ. МЕРЦ
Dialogue: 0,0:07:36.28,0:07:39.72,Caption,,0,0,0,,ЭТО ПОНИМАЕТ, ПОЭТОМУ И ХОЧЕТ СДЕЛАТЬ ФИНАНСИРОВАНИЕ МАКСИМАЛЬНО
Dialogue: 0,0:07:39.80,0:07:44.36,Caption,,0,0,0,,СИСТЕМНЫМ. МАКРОН ПОНИМАЕТ, ПОЭТОМУ БЬЁТ В НАБАТ. ПОТОМУ ЧТО ЕСЛИ КАЖДЫЙ
Dialogue: 0,0:07:44.44,0:07:46.76,Caption,,0,0,0,,ГОД ЗАНОВО СПРАШИВАТЬ ДВАДЦАТЬ СЕМЬ ГОСУДАРСТВ,
Dialogue: 0,0:07:47.00,0:07:51.96,Caption,,0,0,0,,ГОТОВЫ ЛИ ОНИ СНОВА ПЛАТИТЬ, ОДНАЖДЫ ОТВЕТЫ НАЧНУТ СТАНОВИТЬСЯ ВСЁ ИНТЕРЕСНЕЕ. И
Dialogue: 0,0:07:51.96,0:07:55.40,Caption,,0,0,0,,ПОЛЬША ЗДЕСЬ ПЕРВЫЙ ОЧЕНЬ ЯРКИЙ СИГНАЛ. НЕ ПОТОМУ,
Dialogue: 0,0:07:55.64,0:07:58.12,Caption,,0,0,0,,ЧТО ОНА ВНЕЗАПНО СТАЛА ПРОРОССИЙСКОЙ. КАК РАЗ
Dialogue: 0,0:07:58.20,0:08:01.16,Caption,,0,0,0,,НАОБОРОТ. В ЭТОМ ВСЯ СОЛЬ. ЕСЛИ БЫ ОТКАЗАЛАСЬ
Dialogue: 0,0:08:01.16,0:08:04.44,Caption,,0,0,0,,СТРАНА, КОТОРАЯ ДАВНО ВЫСТУПАЕТ ПРОТИВ НОВЫХ РАСХОДОВ НА
Dialogue: 0,0:08:04.44,0:08:07.64,Caption,,0,0,0,,УКРАИНУ, НИКАКОЙ НОВОСТИ ПРАКТИЧЕСКИ НЕТ. А ЗДЕСЬ
Dialogue: 0,0:08:07.64,0:08:11.56,Caption,,0,0,0,,ГОСУДАРСТВО, КОТОРОЕ САМО ГОДАМИ ВЫСТУПАЛО ЗА МАКСИМАЛЬНО ЖЁСТКУЮ
Dialogue: 0,0:08:11.56,0:08:16.04,Caption,,0,0,0,,ЛИНИЮ В ОТНОШЕНИИ МОСКВЫ, ГОВОРИТ ДОПОЛНИТЕЛЬНОГО ВЗНОСА СЕЙЧАС НЕ БУДЕТ. ТО
Dialogue: 0,0:08:16.12,0:08:17.96,Caption,,0,0,0,,ЕСТЬ ПОЛИТИЧЕСКИЙ КУРС ПОКА ПРЕЖНИЙ,
Dialogue: 0,0:08:18.12,0:08:21.32,Caption,,0,0,0,,А ФИНАНСОВОЕ ПОВЕДЕНИЕ УЖЕ НАЧИНАЕТ МЕНЯТЬСЯ. И ВОТ
Dialogue: 0,0:08:21.32,0:08:23.88,Caption,,0,0,0,,ЭТО КУДА ИНТЕРЕСНЕЕ ЛЮБОГО ГРОМКОГО ЗАЯВЛЕНИЯ.
Dialogue: 0,0:08:24.28,0:08:26.68,Caption,,0,0,0,,ПОТОМУ ЧТО ВОЙНЫ ВООБЩЕ ОЧЕНЬ ЛЮБЯТ БОЛЬШИЕ СЛОВА.
Dialogue: 0,0:08:28.96,0:08:30.80,Caption,,0,0,0,,А ЗАКАНЧИВАЮТСЯ ОНИ ОБЫЧНО ТАМ,
Dialogue: 0,0:08:31.06,0:08:33.84,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЮТСЯ ЛЮДИ, ОРУЖИЕ ИЛИ ДЕНЬГИ.
Dialogue: 0,0:08:34.48,0:08:37.04,Caption,,0,0,0,,С ЛЮДЬМИ У УКРАИНЫ ПРОБЛЕМЫ ДАВНО. С ОРУЖИЕМ
Dialogue: 0,0:08:37.04,0:08:39.60,Caption,,0,0,0,,ЕВРОПА ЗАВИСИТ ОТ ПРОИЗВОДСТВА И В ОГРОМНОЙ СТЕПЕНИ
Dialogue: 0,0:08:39.68,0:08:43.76,Caption,,0,0,0,,ОТ США. ТЕПЕРЬ ВСЁ ГРОМЧЕ ПОЯВЛЯЕТСЯ ТРЕТИЙ ВОПРОС. ДЕНЬГИ.
Dialogue: 0,0:08:44.15,0:08:46.80,Caption,,0,0,0,,ПРИЧЁМ НЕ ПРОСТО ДЕНЬГИ НА СЛЕДУЮЩИЙ МЕСЯЦ. МЕРЦ
Dialogue: 0,0:08:46.88,0:08:49.84,Caption,,0,0,0,,ХОЧЕТ РАЗГОВОР НА ГОДЫ. И ИМЕННО ЗДЕСЬ ВСПЛЫВАЕТ
Dialogue: 0,0:08:49.92,0:08:52.80,Caption,,0,0,0,,АНГЕЛА МЕРКЕЛЬ. ОНА СНОВА ЗАЩИЩАЕТ СВОЮ ПРЕЖНЮЮ
Dialogue: 0,0:08:52.80,0:08:55.52,Caption,,0,0,0,,ЛИНИЮ ПЕРЕГОВОРОВ С ПУТИНЫМ. ПО ЕЁ СЛОВАМ,
Dialogue: 0,0:08:55.84,0:08:58.08,Caption,,0,0,0,,ЕСЛИ БЫ В ДВЕ ТЫСЯЧИ ПЯТНАДЦАТОМ ЗАПАД ПРОСТО
Dialogue: 0,0:08:58.08,0:09:02.24,Caption,,0,0,0,,ОТКАЗАЛСЯ ОТ ПЕРЕГОВОРОВ, УКРАИНА МОГЛА БЫ ВООБЩЕ НЕ СОХРАНИТЬСЯ В НЫНЕШНЕМ
Dialogue: 0,0:09:02.24,0:09:05.68,Caption,,0,0,0,,ВИДЕ. И ТУТ ИСТОРИЯ ДЕЛАЕТ КРАСИВЫЙ КРУГ. ПОТОМУ
Dialogue: 0,0:09:05.76,0:09:08.16,Caption,,0,0,0,,ЧТО САМА МЕРКЕЛЬ ЕЩЁ НЕСКОЛЬКО ЛЕТ НАЗАД УЖЕ
Dialogue: 0,0:09:08.16,0:09:11.76,Caption,,0,0,0,,ОБЪЯСНЯЛА, ЧТО МИНСКИЕ СОГЛАШЕНИЯ ДАЛИ УКРАИНЕ ВРЕМЯ СТАТЬ
Dialogue: 0,0:09:11.76,0:09:14.64,Caption,,0,0,0,,СИЛЬНЕЕ. В МОСКВЕ ЭТИ СЛОВА ВОСПРИНЯЛИ ОЧЕНЬ
Dialogue: 0,0:09:14.64,0:09:19.52,Caption,,0,0,0,,БОЛЕЗНЕННО. ПУТИН ГОВОРИЛ, ЧТО БЫЛ РАЗОЧАРОВАН. РОССИЙСКИЕ ОФИЦИАЛЬНЫЕ ЛИЦА
Dialogue: 0,0:09:19.52,0:09:22.96,Caption,,0,0,0,,МНОГО РАЗ ПОВТОРЯЛИ, ЧТО ЗАПАД ИСПОЛЬЗОВАЛ ДОГОВОРЁННОСТИ,
Dialogue: 0,0:09:23.12,0:09:25.68,Caption,,0,0,0,,ЧТОБЫ ВЫИГРАТЬ ВРЕМЯ, А РОССИЮ ОБМАНУЛИ.
Dialogue: 0,0:09:26.29,0:09:28.88,Caption,,0,0,0,,И ВОТ ТУТ ХОЧЕТСЯ ОСТАНОВИТЬСЯ. ПОТОМУ ЧТО ЕСЛИ
Dialogue: 0,0:09:28.96,0:09:31.60,Caption,,0,0,0,,РОССИЙСКАЯ ДИПЛОМАТИЯ САМА ГОДАМИ РАССКАЗЫВАЕТ,
Dialogue: 0,0:09:31.68,0:09:35.28,Caption,,0,0,0,,КАК ЕЁ ОБМАНЫВАЛИ, ЭТО ВЕДЬ ТОЖЕ НЕ САМЫЙ ЛУЧШИЙ РЕКЛАМНЫЙ РОЛИК
Dialogue: 0,0:09:35.28,0:09:38.64,Caption,,0,0,0,,РОССИЙСКОЙ ДИПЛОМАТИИ. ОДИН РАЗ ОБМАНУЛИ. БЫВАЕТ.
Dialogue: 0,0:09:38.88,0:09:41.20,Caption,,0,0,0,,ВТОРОЙ РАЗ ОБМАНУЛИ. УЖЕ НЕПРИЯТНО.
Dialogue: 0,0:09:43.49,0:09:45.81,Caption,,0,0,0,,НО КОГДА У ВАС ИСТОРИЯ МЕЖДУНАРОДНЫХ ОТНОШЕНИЙ
Dialogue: 0,0:09:45.81,0:09:48.45,Caption,,0,0,0,,НАЧИНАЕТ ВЫГЛЯДЕТЬ КАК КЛУБ ПОСТОЯННЫХ КЛИЕНТОВ
Dialogue: 0,0:09:48.45,0:09:51.97,Caption,,0,0,0,,ОДНОЙ И ТОЙ ЖЕ СХЕМЫ, ВОПРОСЫ ВОЗНИКАЮТ НЕ ТОЛЬКО К ПРОДАВЦУ.
Dialogue: 0,0:09:52.57,0:09:54.29,Caption,,0,0,0,,ЕСЛИ ВАС ТАК ЛЕГКО ОБМАНЫВАТЬ,
Dialogue: 0,0:09:54.42,0:09:56.53,Caption,,0,0,0,,ТО КТО ТОГДА СИДИТ ЗА СТОЛОМ ПЕРЕГОВОРОВ?
Dialogue: 0,0:09:56.68,0:09:59.57,Caption,,0,0,0,,ЭТО ВЕДЬ ПРОФЕССИОНАЛЬНЫЕ ДИПЛОМАТЫ. СПЕЦСЛУЖБЫ.
Dialogue: 0,0:09:59.87,0:10:03.41,Caption,,0,0,0,,СОВЕТНИКИ. ОГРОМНЫЙ ГОСУДАРСТВЕННЫЙ АППАРАТ. ВСЕ
Dialogue: 0,0:10:03.41,0:10:06.93,Caption,,0,0,0,,ЗНАЮТ ИСТОРИЮ. ВСЕ ЗНАЮТ ИНТЕРЕСЫ ДРУГ ДРУГА. ВСЕ
Dialogue: 0,0:10:06.93,0:10:11.09,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЮТ, ЧТО ДОГОВОР ПОДПИСЫВАЕТ НЕ КРУЖОК ДРУЗЕЙ НА ДАЧЕ.
Dialogue: 0,0:10:11.48,0:10:13.09,Caption,,0,0,0,,А ПОТОМ ПРОХОДИТ НЕСКОЛЬКО ЛЕТ,
Dialogue: 0,0:10:13.41,0:10:16.29,Caption,,0,0,0,,И МЫ СНОВА СЛЫШИМ НАС ОБМАНУЛИ. НУ МОЛОДЦЫ.
Dialogue: 0,0:10:16.82,0:10:19.41,Caption,,0,0,0,,ПОЭТОМУ НЫНЕШНИЕ СЛОВА МЕРКЕЛЬ ИНТЕРЕСНЫ НЕ ТОЛЬКО
Dialogue: 0,0:10:19.49,0:10:22.45,Caption,,0,0,0,,КАК ОЧЕРЕДНОЕ ОПРАВДАНИЕ ЕЁ ПРЕЖНЕГО КУРСА. ОНИ
Dialogue: 0,0:10:22.53,0:10:25.41,Caption,,0,0,0,,СТАВЯТ ЗНАЧИТЕЛЬНО БОЛЕЕ НЕПРИЯТНЫЙ ВОПРОС. ЕСЛИ
Dialogue: 0,0:10:25.49,0:10:28.29,Caption,,0,0,0,,ПЕРЕГОВОРЫ СНОВА СТАНУТ ГЛАВНЫМ СПОСОБОМ ЗАВЕРШЕНИЯ
Dialogue: 0,0:10:28.29,0:10:31.17,Caption,,0,0,0,,ВОЙНЫ, КТО И ЧЕМУ НАУЧИЛСЯ ПОСЛЕ МИНСКА?
Dialogue: 0,0:10:31.32,0:10:36.05,Caption,,0,0,0,,ЗАПАД? РОССИЯ? УКРАИНА? ИЛИ ЧЕРЕЗ ПЯТЬ ЛЕТ МЫ ОПЯТЬ УСЛЫШИМ ОТ
Dialogue: 0,0:10:36.13,0:10:38.05,Caption,,0,0,0,,ОДНОЙ СТОРОНЫ МЫ ПРОСТО ВЫИГРАЛИ ВРЕМЯ,
Dialogue: 0,0:10:38.29,0:10:39.97,Caption,,0,0,0,,А ОТ ДРУГОЙ НАС СНОВА ОБМАНУЛИ?
Dialogue: 0,0:10:40.53,0:10:42.69,Caption,,0,0,0,,ВОТ ЗДЕСЬ НЫНЕШНИЙ СПОР О ДЕНЬГАХ ВНЕЗАПНО
Dialogue: 0,0:10:42.77,0:10:45.49,Caption,,0,0,0,,ВСТРЕЧАЕТСЯ С ИСТОРИЕЙ ПЕРЕГОВОРОВ. ПОТОМУ ЧТО ЧЕМ
Dialogue: 0,0:10:45.49,0:10:47.97,Caption,,0,0,0,,МЕНЬШЕ СТАНОВИТСЯ СВОБОДНЫХ ДЕНЕГ НА ПРОДОЛЖЕНИЕ
Dialogue: 0,0:10:47.97,0:10:51.65,Caption,,0,0,0,,КОНФЛИКТА, ТЕМ ГРОМЧЕ БУДУТ РАЗГОВОРЫ О ПОЛИТИЧЕСКОМ РЕШЕНИИ.
Dialogue: 0,0:10:52.08,0:10:55.81,Caption,,0,0,0,,НЕ ПОТОМУ, ЧТО ВСЕ ВНЕЗАПНО ПОЛЮБИЛИ ДРУГ ДРУГА. НЕ ПОТОМУ,
Dialogue: 0,0:10:55.96,0:10:57.89,Caption,,0,0,0,,ЧТО МАКРОН ПРОСНУЛСЯ ПАЦИФИСТОМ.
Dialogue: 0,0:11:00.16,0:11:03.84,Caption,,0,0,0,,НЕ ПОТОМУ, ЧТО ПОЛЬША РЕШИЛА ДРУЖИТЬ С РОССИЕЙ. ПРОСТО ВОЙНА
Dialogue: 0,0:11:03.84,0:11:06.64,Caption,,0,0,0,,КАЖДЫЙ ГОД ВЫСТАВЛЯЕТ НОВЫЙ СЧЁТ. И ПОКА ЭТОТ
Dialogue: 0,0:11:06.64,0:11:08.88,Caption,,0,0,0,,СЧЁТ ОПЛАЧИВАЕТСЯ БЕЗ ОСОБЫХ ВОПРОСОВ,
Dialogue: 0,0:11:09.18,0:11:12.40,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ ЛИНИЯ ОСТАЁТСЯ ОЧЕНЬ ЖЁСТКОЙ. МОЖНО
Dialogue: 0,0:11:12.48,0:11:15.04,Caption,,0,0,0,,ТРЕБОВАТЬ МАКСИМУМА. МОЖНО ГОВОРИТЬ О КРАСНЫХ
Dialogue: 0,0:11:15.12,0:11:19.92,Caption,,0,0,0,,ЛИНИЯХ. МОЖНО ОБЪЯСНЯТЬ, ЧТО УСТУПАТЬ НЕЛЬЗЯ. А КОГДА НАЧИНАЮТСЯ ПРОБЛЕМЫ С
Dialogue: 0,0:11:19.92,0:11:23.84,Caption,,0,0,0,,ОЧЕРЕДНЫМ ПЛАТЕЖОМ, РЯДОМ С КРАСНЫМИ ЛИНИЯМИ НЕОЖИДАННО ПОЯВЛЯЕТСЯ
Dialogue: 0,0:11:23.84,0:11:26.64,Caption,,0,0,0,,КАЛЬКУЛЯТОР. И ТУТ ВСЁ СТАНОВИТСЯ ГОРАЗДО ЧЕСТНЕЕ.
Dialogue: 0,0:11:27.11,0:11:30.16,Caption,,0,0,0,,ПОЛЬША СЕЙЧАС ПОКАЗЫВАЕТ ИМЕННО ЭТО. ЕЁ РИТОРИКА В
Dialogue: 0,0:11:30.16,0:11:33.12,Caption,,0,0,0,,ОТНОШЕНИИ РОССИИ ОСТАЁТСЯ ЖЁСТКОЙ. ЕЁ СОБСТВЕННЫЕ
Dialogue: 0,0:11:33.12,0:11:36.00,Caption,,0,0,0,,ОБОРОННЫЕ РАСХОДЫ ОГРОМНЫ. ОНА ПРОДОЛЖАЕТ СЧИТАТЬ
Dialogue: 0,0:11:36.00,0:11:38.88,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ОДНИМ ИЗ ГЛАВНЫХ ПРИОРИТЕТОВ. НО ИМЕННО
Dialogue: 0,0:11:38.88,0:11:42.08,Caption,,0,0,0,,ПОЭТОМУ ВАРШАВА И ГОВОРИТ СНАЧАЛА НАША АРМИЯ. А
Dialogue: 0,0:11:42.08,0:11:44.64,Caption,,0,0,0,,УКРАИНА УЖЕ ПОСЛЕ. ЭТО НЕ РАЗВОРОТ НА СТО
Dialogue: 0,0:11:44.64,0:11:47.92,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ ГРАДУСОВ. ЭТО СМЕНА ПОРЯДКА РАСХОДОВ. НО
Dialogue: 0,0:11:48.00,0:11:50.56,Caption,,0,0,0,,В ПОЛИТИКЕ ИНОГДА ИМЕННО ТАКИЕ ВЕЩИ ОКАЗЫВАЮТСЯ
Dialogue: 0,0:11:50.56,0:11:53.44,Caption,,0,0,0,,ВАЖНЕЕ ГРОМКИХ ДЕКЛАРАЦИЙ. ПОТОМУ ЧТО ЕСЛИ ЭТОТ
Dialogue: 0,0:11:53.44,0:11:55.68,Caption,,0,0,0,,ПОРЯДОК НАЧНУТ МЕНЯТЬ И ДРУГИЕ ГОСУДАРСТВА,
Dialogue: 0,0:11:56.06,0:11:59.20,Caption,,0,0,0,,У КИЕВА ПОЯВИТСЯ ОЧЕНЬ НЕПРИЯТНАЯ АРИФМЕТИКА. ВСЕ ПО
Dialogue: 0,0:11:59.20,0:12:02.00,Caption,,0,0,0,,ПРЕЖНЕМУ ЗА УКРАИНУ. ВСЕ ПО ПРЕЖНЕМУ ВЫРАЖАЮТ
Dialogue: 0,0:12:02.00,0:12:05.12,Caption,,0,0,0,,ПОДДЕРЖКУ. ВСЕ ПО ПРЕЖНЕМУ ХОТЯТ СПРАВЕДЛИВОГО МИРА.
Dialogue: 0,0:12:05.38,0:12:08.48,Caption,,0,0,0,,ТОЛЬКО ОДИН НЕ ДАЁТ НОВЫЙ ВЗНОС. ВТОРОЙ СОКРАЩАЕТ
Dialogue: 0,0:12:08.48,0:12:11.20,Caption,,0,0,0,,УЧАСТИЕ. ТРЕТИЙ СПОРИТ ИЗ ЗА ОБЩЕГО БЮДЖЕТА.
Dialogue: 0,0:12:11.41,0:12:13.28,Caption,,0,0,0,,ЧЕТВЁРТЫЙ ТРЕБУЕТ КОМПЕНСАЦИЮ.
Dialogue: 0,0:12:15.46,0:12:17.46,Caption,,0,0,0,,И В ИТОГЕ ПОДДЕРЖКА ВРОДЕ БЫ НИКУДА НЕ
Dialogue: 0,0:12:17.46,0:12:20.58,Caption,,0,0,0,,ИСЧЕЗЛА. А ДЕНЕГ ПОЧЕМУ ТО СТАЛО МЕНЬШЕ. ВОТ
Dialogue: 0,0:12:20.66,0:12:23.06,Caption,,0,0,0,,ПОЭТОМУ МАКРОН И МЕРЦ СЕЙЧАС НЕРВНИЧАЮТ НЕ НА
Dialogue: 0,0:12:23.14,0:12:25.78,Caption,,0,0,0,,ПУСТОМ МЕСТЕ. ОНИ ВИДЯТ ПРОБЛЕМУ РАНЬШЕ,
Dialogue: 0,0:12:25.94,0:12:28.50,Caption,,0,0,0,,ЧЕМ ОНА ПРЕВРАТИЛАСЬ В ОТКРЫТУЮ ДЫРУ. И ПЫТАЮТСЯ
Dialogue: 0,0:12:28.50,0:12:31.14,Caption,,0,0,0,,ЗАРАНЕЕ СВЯЗАТЬ ЕВРОПУ ОБЯЗАТЕЛЬСТВАМИ НА ГОДЫ
Dialogue: 0,0:12:31.14,0:12:34.10,Caption,,0,0,0,,ВПЕРЁД. ТОЛЬКО ТУТ СНОВА ПОЯВЛЯЕТСЯ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:12:34.47,0:12:37.78,Caption,,0,0,0,,МОЖНО ПОДПИСАТЬ ЛЮБОЙ ДОКУМЕНТ. МОЖНО ЗАПИСАТЬ ЛЮБЫЕ
Dialogue: 0,0:12:37.78,0:12:40.74,Caption,,0,0,0,,КРАСИВЫЕ ЦИФРЫ. МОЖНО ОБЕЩАТЬ УКРАИНЕ ДЕНЬГИ ДО
Dialogue: 0,0:12:40.82,0:12:43.46,Caption,,0,0,0,,КОНЦА ДЕСЯТИЛЕТИЯ. НО ЕСЛИ ЧЕРЕЗ ГОД В ОДНОЙ
Dialogue: 0,0:12:43.54,0:12:44.98,Caption,,0,0,0,,СТРАНЕ СМЕНИТСЯ ПРАВИТЕЛЬСТВО,
Dialogue: 0,0:12:45.22,0:12:49.22,Caption,,0,0,0,,В ДРУГОЙ ВЫРАСТЕТ ДЕФИЦИТ, В ТРЕТЬЕЙ ПРИДЁТСЯ РЕЗАТЬ СОЦИАЛЬНЫЕ РАСХОДЫ,
Dialogue: 0,0:12:49.54,0:12:50.98,Caption,,0,0,0,,А В ЧЕТВЁРТОЙ ИЗБИРАТЕЛЬ СПРОСИТ,
Dialogue: 0,0:12:51.15,0:12:53.38,Caption,,0,0,0,,ПОЧЕМУ ЕГО НАЛОГИ ОПЯТЬ УХОДЯТ НАРУЖУ,
Dialogue: 0,0:12:53.62,0:12:56.26,Caption,,0,0,0,,БУМАГА САМА ПЛАТИТЬ НЕ НАЧНЁТ. И ВОТ ЭТО
Dialogue: 0,0:12:56.34,0:12:58.74,Caption,,0,0,0,,ГЛАВНЫЙ ПРЕДЕЛ ЛЮБОЙ МНОГОЛЕТНЕЙ КОНСТРУКЦИИ.
Dialogue: 0,0:12:59.16,0:13:02.58,Caption,,0,0,0,,ПОЛИТИКИ УМЕЮТ ОБЕЩАТЬ НА СЕМЬ ЛЕТ ВПЕРЁД. БЮДЖЕТ
Dialogue: 0,0:13:02.66,0:13:05.38,Caption,,0,0,0,,ПРИХОДИТСЯ СОБИРАТЬ КАЖДЫЙ ГОД. ПОЭТОМУ НЫНЕШНЯЯ
Dialogue: 0,0:13:05.38,0:13:09.38,Caption,,0,0,0,,ИСТОРИЯ НЕ ПРО ТО, ЧТО ЕВРОПА ЗАВТРА БРОСИТ УКРАИНУ. И НЕ ПРО
Dialogue: 0,0:13:09.46,0:13:12.74,Caption,,0,0,0,,ТО, ЧТО ПОЛЬША ВДРУГ СМЕНИЛА СТОРОНУ. ОНА ПРО ДРУГОЕ.
Dialogue: 0,0:13:13.14,0:13:15.06,Caption,,0,0,0,,ЧЕМ ДОЛЬШЕ ПРОДОЛЖАЕТСЯ КОНФЛИКТ,
Dialogue: 0,0:13:15.30,0:13:18.18,Caption,,0,0,0,,ТЕМ СИЛЬНЕЕ ВОПРОС ПОДДЕРЖКИ ПРЕВРАЩАЕТСЯ ИЗ ВОПРОСА
Dialogue: 0,0:13:18.18,0:13:21.30,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ ВЕРНОСТИ В ВОПРОС КОНКРЕТНОЙ ЦЕНЫ.
Dialogue: 0,0:13:23.59,0:13:25.99,Caption,,0,0,0,,И КОГДА ЭТОТ ПЕРЕХОД НАЧИНАЕТСЯ ДАЖЕ В ПОЛЬШЕ,
Dialogue: 0,0:13:26.31,0:13:28.71,Caption,,0,0,0,,ЕГО УЖЕ ТРУДНО СПИСАТЬ НА ОЧЕРЕДНЫХ ВЕНГРОВ,
Dialogue: 0,0:13:28.81,0:13:31.35,Caption,,0,0,0,,БОЛГАР ИЛИ ВЕЧНЫХ ЕВРОПЕЙСКИХ СКЕПТИКОВ.
Dialogue: 0,0:13:32.07,0:13:34.87,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО ГОВОРИТЬ О ПОРАЖЕНЧЕСТВЕ. МОЖНО
Dialogue: 0,0:13:34.95,0:13:38.07,Caption,,0,0,0,,ТРЕБОВАТЬ ЕДИНСТВА. МОЖНО ПИСАТЬ СЕМИЛЕТНИЕ ПЛАНЫ.
Dialogue: 0,0:13:38.38,0:13:40.31,Caption,,0,0,0,,НО В КОНЦЕ КОНЦОВ ВСЁ УПИРАЕТСЯ В ТОТ
Dialogue: 0,0:13:40.39,0:13:45.19,Caption,,0,0,0,,САМЫЙ ОЧЕНЬ ПРОСТОЙ ВОПРОС, КОТОРЫЙ СЕЙЧАС НАЧИНАЕТ ЗВУЧАТЬ ВСЁ ГРОМЧЕ. И ДЛЯ
Dialogue: 0,0:13:45.19,0:13:47.91,Caption,,0,0,0,,КИЕВА ЭТО САМЫЙ НЕПРИЯТНЫЙ ВАРИАНТ НИКТО ГРОМКО НЕ
Dialogue: 0,0:13:47.91,0:13:51.83,Caption,,0,0,0,,ОТКАЗЫВАЕТСЯ ОТ ПОДДЕРЖКИ, НО ДОПОЛНИТЕЛЬНЫЕ ДЕНЬГИ ПРИХОДИТСЯ ВЫБИВАТЬ ВСЁ
Dialogue: 0,0:13:51.83,0:13:52.31,Caption,,0,0,0,,ТРУДНЕЕ.
