Dialogue: 0,0:00:00.12,0:00:03.56,Caption,,0,0,0,,НЕМЕЦКАЯ ДЕЛОВАЯ ГАЗЕТА HANDELSBLATT УЖЕ ПРОИЗНЕСЛА
Dialogue: 0,0:00:03.56,0:00:06.68,Caption,,0,0,0,,ТО, ЧТО ЕВРОПЕЙСКИЕ КАБИНЕТЫ ПРЕДПОЧИТАЮТ ОБХОДИТЬ
Dialogue: 0,0:00:06.74,0:00:09.80,Caption,,0,0,0,,АККУРАТНЫМИ ФОРМУЛИРОВКАМИ. ЗАПАДНАЯ ПОМОЩЬ НЕ
Dialogue: 0,0:00:09.80,0:00:13.00,Caption,,0,0,0,,ПОЗВОЛИТ УКРАИНЕ ИЗБЕЖАТЬ ПОРАЖЕНИЯ. ГЕРМАНИЯ ПРИ
Dialogue: 0,0:00:13.08,0:00:15.96,Caption,,0,0,0,,ЭТОМ ВЫГЛЯДИТ ПАРТНЁРОМ, КОТОРЫЙ ИСПРАВНО ПЛАТИТ,
Dialogue: 0,0:00:16.27,0:00:19.08,Caption,,0,0,0,,НО ПОЧТИ НЕ ВЛИЯЕТ НА РЕШЕНИЕ. РАЗГОВОРЫ,
Dialogue: 0,0:00:19.24,0:00:23.88,Caption,,0,0,0,,ОПРЕДЕЛЯЮЩИЕ БУДУЩЕЕ УКРАИНЫ, ИДУТ ПРЕЖДЕ ВСЕГО МЕЖДУ МОСКВОЙ И ВАШИНГТОНОМ.
Dialogue: 0,0:00:24.28,0:00:29.00,Caption,,0,0,0,,БЕРЛИНУ ОСТАВЛЯЮТ ЧЕКИ, ЗАЯВЛЕНИЯ И ПРАВО ВЫГЛЯДЕТЬ ОЧЕНЬ ЗАНЯТЫМ.
Dialogue: 0,0:00:29.55,0:00:32.28,Caption,,0,0,0,,ЕСЛИ ПОРАЖЕНИЕ УЖЕ ПРИЗНАЮТ РЕАЛЬНОЙ ПЕРСПЕКТИВОЙ,
Dialogue: 0,0:00:32.60,0:00:36.12,Caption,,0,0,0,,ТО ПРОДОЛЖЕНИЕ ПРЕЖНЕГО КУРСА ТРЕБУЕТ ЯСНОЙ ЦЕЛИ. НО
Dialogue: 0,0:00:36.20,0:00:39.48,Caption,,0,0,0,,ВМЕСТО ЦЕЛИ ЕВРОПЕ ПРЕДЛАГАЮТ ЕЩЁ ОДИН ПЛАТЁЖ И
Dialogue: 0,0:00:39.48,0:00:42.60,Caption,,0,0,0,,ЕЩЁ ОДНУ РЕЧЬ О ЕДИНСТВЕ. ПОРАЖЕНИЕ УКРАИНЫ
Dialogue: 0,0:00:42.60,0:00:46.36,Caption,,0,0,0,,НЕИЗБЕЖНО, А НЫНЕШНИЕ ЕВРОПЕЙСКИЕ ВЛАСТИ ПРОДОЛЖАЮТ ДЕЛАТЬ ТО
Dialogue: 0,0:00:46.36,0:00:50.12,Caption,,0,0,0,,ЖЕ САМОЕ, ТОЛЬКО ДОРОЖЕ. ЕСЛИ ВАМ НУЖЕН РАЗГОВОР О РЕЗУЛЬТАТЕ
Dialogue: 0,0:00:50.12,0:00:52.36,Caption,,0,0,0,,БЕЗ ЦЕРЕМОНИЙ И СЛАДКИХ ФОРМУЛИРОВОК,
Dialogue: 0,0:00:52.55,0:00:55.16,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ МЫ СЧИТАЕМ НЕ ЗАЯВЛЕНИЯ,
Dialogue: 0,0:00:55.47,0:00:58.84,Caption,,0,0,0,,А ЦЕНУ И ПОСЛЕДСТВИЯ. ГЛАВНАЯ НАДЕЖДА ЭТОГО КУРСА
Dialogue: 0,0:00:58.92,0:01:02.68,Caption,,0,0,0,,ДАВНО СПРЯТАНА НЕ В КИЕВЕ, А В МОСКВЕ. ВОТ УЙДЁТ ПУТИН,
Dialogue: 0,0:01:02.84,0:01:05.88,Caption,,0,0,0,,РОССИЯ ПРОСНЁТСЯ ДРУГОЙ, НОВЫЕ ЛЮДИ ВСЁ ОТМЕНЯТ,
Dialogue: 0,0:01:06.03,0:01:09.08,Caption,,0,0,0,,ПОДПИШУТ И ВЕРНУТ. ТОЛЬКО ЭТО НЕ МЕХАНИЗМ. ЭТО
Dialogue: 0,0:01:09.08,0:01:13.40,Caption,,0,0,0,,ОЖИДАНИЕ ЧУДА, ПРИЧЁМ ЧУДО ОБЯЗАНО ЯВИТЬСЯ ТОЧНО ПО ЕВРОПЕЙСКОМУ
Dialogue: 0,0:01:13.40,0:01:18.72,Caption,,0,0,0,,РАСПИСАНИЮ. ЗА ЧЕТВЕРТЬ ВЕКА ВОКРУГ РОССИЙСКОЙ ВЛАСТИ ВЫРОСЛА
Dialogue: 0,0:01:18.72,0:01:21.52,Caption,,0,0,0,,СИСТЕМА ИЗ СИЛОВЫХ СТРУКТУР, БЮРОКРАТИИ,
Dialogue: 0,0:01:21.64,0:01:25.52,Caption,,0,0,0,,АРМИИ, СПЕЦСЛУЖБ, ГОСУДАРСТВЕННЫХ КОМПАНИЙ И ЛЮДЕЙ,
Dialogue: 0,0:01:25.84,0:01:28.56,Caption,,0,0,0,,КОТОРЫМ НЫНЕШНИЙ ПОРЯДОК ОБЕСПЕЧИВАЕТ ПОЛОЖЕНИЕ И
Dialogue: 0,0:01:28.56,0:01:31.12,Caption,,0,0,0,,СОБСТВЕННОСТЬ. ОДНА ФАМИЛИЯ ИСЧЕЗНЕТ,
Dialogue: 0,0:01:31.51,0:01:34.00,Caption,,0,0,0,,А ВСЯ ЭТА КОНСТРУКЦИЯ НИКУДА НЕ ДЕНЕТСЯ. ПОСЛЕ
Dialogue: 0,0:01:34.08,0:01:35.92,Caption,,0,0,0,,ПУТИНА ПОЯВИТСЯ ПУТИН ДВА НОЛЬ,
Dialogue: 0,0:01:36.24,0:01:38.88,Caption,,0,0,0,,ЗАТЕМ ПУТИН ТРИ НОЛЬ. ИМЯ СМЕНИТСЯ,
Dialogue: 0,0:01:39.04,0:01:42.16,Caption,,0,0,0,,АППАРАТ ОСТАНЕТСЯ. ВЫХОДЦЫ ИЗ КГБ И ДРУГИХ СИЛОВЫХ
Dialogue: 0,0:01:42.16,0:01:44.16,Caption,,0,0,0,,СТРУКТУР БРАЛИ ВЛАСТЬ НЕ ДЛЯ ТОГО,
Dialogue: 0,0:01:44.24,0:01:46.48,Caption,,0,0,0,,ЧТОБЫ ОДНАЖДЫ ВЕЖЛИВО ВРУЧИТЬ КЛЮЧИ ТЕМ,
Dialogue: 0,0:01:46.72,0:01:49.36,Caption,,0,0,0,,КТО ПЕРЕСМОТРИТ ИХ РЕШЕНИЯ И ПРОВЕРИТ ИХ ИМУЩЕСТВО.
Dialogue: 0,0:01:49.76,0:01:52.24,Caption,,0,0,0,,ВЛАСТЬ ВООБЩЕ РЕДКО ПРОСЫПАЕТСЯ УТРОМ С ЖЕЛАНИЕМ
Dialogue: 0,0:01:52.24,0:01:55.20,Caption,,0,0,0,,ДОБРОВОЛЬНО СТАТЬ БЫВШЕЙ. В МОСКВЕ ЭТОТ ЗАКОН ЗНАЮТ
Dialogue: 0,0:01:55.20,0:01:58.40,Caption,,0,0,0,,ДАВНО. ДЛЯ РОССИЙСКОЙ ЭЛИТЫ РАСПАД СОВЕТСКОГО СОЮЗА
Dialogue: 0,0:01:58.40,0:02:03.12,Caption,,0,0,0,,НЕ ПЫЛЬНАЯ ГЛАВА УЧЕБНИКА, А ПРЕДУПРЕЖДЕНИЕ. ИЗ НЕГО СДЕЛАН ЖЁСТКИЙ ВЫВОД
Dialogue: 0,0:02:03.17,0:02:06.00,Caption,,0,0,0,,ГОСУДАРСТВЕННАЯ СИСТЕМА ДОЛЖНА ПЕРЕЖИТЬ ОТДЕЛЬНОГО
Dialogue: 0,0:02:06.00,0:02:08.88,Caption,,0,0,0,,РУКОВОДИТЕЛЯ И НЕ ДОПУСТИТЬ НОВОГО РАСПАДА.
Dialogue: 0,0:02:09.44,0:02:11.36,Caption,,0,0,0,,ПОЭТОМУ СТАВКА НА НОВОГО ЕЛЬЦИНА,
Dialogue: 0,0:02:11.60,0:02:14.40,Caption,,0,0,0,,КОТОРЫЙ ПРИДЁТ И ЗАНОВО ОТКРОЕТ РОССИЮ НА УДОБНЫХ
Dialogue: 0,0:02:14.40,0:02:16.48,Caption,,0,0,0,,ЗАПАДУ УСЛОВИЯХ, ВИСИТ В ВОЗДУХЕ.
Dialogue: 0,0:02:17.04,0:02:19.76,Caption,,0,0,0,,СТРОИТЬ МНОГОЛЕТНИЙ ЕВРОПЕЙСКИЙ КУРС НА ДОБРОВОЛЬНОМ
Dialogue: 0,0:02:19.76,0:02:22.72,Caption,,0,0,0,,ИСЧЕЗНОВЕНИИ ЧУЖОЙ СИСТЕМЫ ВСЁ РАВНО ЧТО НАЗНАЧИТЬ
Dialogue: 0,0:02:22.72,0:02:25.44,Caption,,0,0,0,,ДОЖДЬ НА ВТОРНИК И ЗАРАНЕЕ ПРОДАТЬ ЗОНТЫ. С
Dialogue: 0,0:02:25.44,0:02:27.68,Caption,,0,0,0,,САНКЦИЯМИ РАСЧЁТ БЫЛ ТАКИМ ЖЕ УВЕРЕННЫМ.
Dialogue: 0,0:02:29.96,0:02:32.36,Caption,,0,0,0,,РОССИЙСКАЯ ЭКОНОМИКА ДОЛЖНА БЫЛА ОСЛАБНУТЬ,
Dialogue: 0,0:02:32.50,0:02:34.60,Caption,,0,0,0,,ВНУТРЕННИЕ ПРОТИВОРЕЧИЯ ОБОСТРИТЬСЯ,
Dialogue: 0,0:02:34.77,0:02:37.88,Caption,,0,0,0,,РУКОВОДСТВО ОТСТУПИТЬ. ПРОШЛО ПОЧТИ ПЯТЬ ЛЕТ ВОЙНЫ.
Dialogue: 0,0:02:38.12,0:02:41.72,Caption,,0,0,0,,РОССИЯ НЕ ИСЧЕЗЛА, ГОСУДАРСТВЕННАЯ СИСТЕМА НЕ РАЗВАЛИЛАСЬ,
Dialogue: 0,0:02:41.98,0:02:45.56,Caption,,0,0,0,,КРЕМЛЬ НЕ ПРИНЯЛ ТРЕБУЕМЫЕ УСЛОВИЯ. ОБЕЩАННЫЙ ИТОГ
Dialogue: 0,0:02:45.64,0:02:49.80,Caption,,0,0,0,,НЕ НАСТУПИЛ. НО СРЕДСТВО, КОТОРОЕ НЕ ДАЛО ЗАЯВЛЕННОГО РЕЗУЛЬТАТА,
Dialogue: 0,0:02:49.95,0:02:52.60,Caption,,0,0,0,,РЕШИЛИ НЕ МЕНЯТЬ. ЕГО РЕШИЛИ ПРИМЕНЯТЬ ДОЛЬШЕ.
Dialogue: 0,0:02:52.99,0:02:55.80,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ПРЕДЛАГАЮТ СНОВА УСИЛИВАТЬ ДАВЛЕНИЕ И
Dialogue: 0,0:02:55.88,0:02:58.20,Caption,,0,0,0,,ЖДАТЬ, ЧТО ЗАВТРА СЛУЧИТСЯ ТО,
Dialogue: 0,0:02:58.39,0:03:01.40,Caption,,0,0,0,,ЧЕГО НЕ СЛУЧИЛОСЬ ВЧЕРА. В НОРМАЛЬНОЙ ОРГАНИЗАЦИИ
Dialogue: 0,0:03:01.48,0:03:04.36,Caption,,0,0,0,,ПОСЛЕ ТАКОГО ТРЕБУЮТ ОБЪЯСНИТЬ ОШИБКУ. В БРЮССЕЛЕ
Dialogue: 0,0:03:04.36,0:03:07.08,Caption,,0,0,0,,ЗАКАЗЫВАЮТ НОВУЮ ПАПКУ ДЛЯ СЛЕДУЮЩЕГО ПАКЕТА.
Dialogue: 0,0:03:07.64,0:03:10.68,Caption,,0,0,0,,И ЦЕНА ОШИБКИ ИЗМЕРЯЕТСЯ НЕ ТОЛЬКО ДЕНЬГАМИ. ПРЯМОЕ
Dialogue: 0,0:03:10.68,0:03:14.04,Caption,,0,0,0,,СТОЛКНОВЕНИЕ РОССИИ И НАТО ПЕРЕНЕСЁТ БОЛЬШУЮ ВОЙНУ
Dialogue: 0,0:03:14.04,0:03:17.00,Caption,,0,0,0,,НА ЕВРОПЕЙСКУЮ ЗЕМЛЮ. ТОГДА СПОР О СТОИМОСТИ
Dialogue: 0,0:03:17.00,0:03:21.16,Caption,,0,0,0,,ЭНЕРГИИ, РАЗМЕРЕ ПОСОБИЙ И РОСТЕ ПРОМЫШЛЕННОСТИ ЗАКОНЧИТСЯ ЗА
Dialogue: 0,0:03:21.16,0:03:24.60,Caption,,0,0,0,,ОДИН ВЕЧЕР. ЕГО ЗАМЕНЯТ РАЗРУШЕННАЯ ИНФРАСТРУКТУРА,
Dialogue: 0,0:03:24.76,0:03:27.40,Caption,,0,0,0,,ЭВАКУАЦИЯ, ПОГИБШИЕ И ГОРОДА,
Dialogue: 0,0:03:27.64,0:03:30.60,Caption,,0,0,0,,ГДЕ БЕЗОПАСНОСТЬ ИЗМЕРЯЮТ РАССТОЯНИЕМ ДО БЛИЖАЙШЕГО
Dialogue: 0,0:03:30.60,0:03:34.36,Caption,,0,0,0,,УКРЫТИЯ. УКРАИНА УЖЕ ПОКАЗЫВАЕТ ЕВРОПЕЙЦАМ ЭТОТ ИТОГ
Dialogue: 0,0:03:34.44,0:03:37.24,Caption,,0,0,0,,БЕЗ ПРЕЗЕНТАЦИЙ. ЕСЛИ ПРАВИТЕЛЬСТВА ГОТОВЫ
Dialogue: 0,0:03:37.24,0:03:39.80,Caption,,0,0,0,,ПРИБЛИЗИТЬ СОБСТВЕННЫЕ ГОРОДА К ТАКОЙ РЕАЛЬНОСТИ,
Dialogue: 0,0:03:40.19,0:03:42.44,Caption,,0,0,0,,ОНИ ОБЯЗАНЫ НАЗВАТЬ ДОСТИЖИМУЮ ЦЕЛЬ,
Dialogue: 0,0:03:42.68,0:03:49.43,Caption,,0,0,0,,РАДИ КОТОРОЙ ПРИНИМАЮТ РИСК. ИНАЧЕ ГРАЖДАНАМ ПРЕДЛАГАЮТ ПОСТАВИТЬ НА КОН ДОМ,
Dialogue: 0,0:03:49.54,0:03:53.99,Caption,,0,0,0,,РАБОТУ И ЖИЗНЬ, А ВЗАМЕН ВЫДАЮТ СЛОВО "ПРОДОЛЖАТЬ". ДЛЯ СТОЛЬ
Dialogue: 0,0:03:53.99,0:03:57.11,Caption,,0,0,0,,ДОРОГОЙ СТАВКИ ПРИЗ НА УДИВЛЕНИЕ НЕ УКАЗАН. ПОКА
Dialogue: 0,0:03:57.19,0:04:01.11,Caption,,0,0,0,,РИСК РАСТЁТ, ЭКОНОМИКА ЕВРОПЫ БОДРЕЕ НЕ СТАНОВИТСЯ. В ОКТЯБРЕ
Dialogue: 0,0:04:01.11,0:04:04.23,Caption,,0,0,0,,РОСТ ЕВРОЗОНЫ ЗАМЕДЛИЛСЯ. ГЕРМАНСКАЯ ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:04:04.23,0:04:08.79,Caption,,0,0,0,,ОСТАЁТСЯ НА НИЗКОМ УРОВНЕ, ДАЖЕ ЕСЛИ ОТДЕЛЬНЫЙ МЕСЯЦ ПРИНОСИТ НЕБОЛЬШОЙ ПЛЮС.
Dialogue: 0,0:04:09.02,0:04:11.91,Caption,,0,0,0,,АВТОМОБИЛЬНАЯ ОТРАСЛЬ ПРОХОДИТ ТЯЖЁЛУЮ ПЕРЕСТРОЙКУ И
Dialogue: 0,0:04:11.91,0:04:14.87,Caption,,0,0,0,,ОДНОВРЕМЕННО БОРЕТСЯ С КОНКУРЕНЦИЕЙ КИТАЯ. ДОРОГАЯ
Dialogue: 0,0:04:14.87,0:04:19.67,Caption,,0,0,0,,ЭНЕРГИЯ ПОВЫШАЕТ ИЗДЕРЖКИ, А ПРАВИТЕЛЬСТВА ДРУГИХ ЕВРОПЕЙСКИХ СТРАН УЖЕ ГОВОРЯТ
Dialogue: 0,0:04:19.75,0:04:21.35,Caption,,0,0,0,,О СДЕРЖИВАНИИ СОЦИАЛЬНЫХ ВЫПЛАТ.
Dialogue: 0,0:04:21.98,0:04:24.55,Caption,,0,0,0,,ОБЫЧНЫЙ ЕВРОПЕЕЦ ВИДИТ ОЧЕНЬ ПОНЯТНУЮ ОЧЕРЕДЬ ЗА
Dialogue: 0,0:04:24.55,0:04:27.51,Caption,,0,0,0,,БЮДЖЕТНЫМИ ДЕНЬГАМИ. ДЛЯ УКРАИНЫ СОВМЕСТНЫЙ ДОЛГ
Dialogue: 0,0:04:27.51,0:04:30.31,Caption,,0,0,0,,ОФОРМИТЬ МОЖНО. КОГДА РЕЧЬ ЗАХОДИТ О ПОСОБИЯХ,
Dialogue: 0,0:04:30.39,0:04:33.35,Caption,,0,0,0,,СРАЗУ ОБНАРУЖИВАЕТСЯ СТРОГАЯ ФИНАНСОВАЯ ДИСЦИПЛИНА.
Dialogue: 0,0:04:33.82,0:04:37.99,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ ОБЪЯСНЯЮТ, ЧТО ДОРОГАЯ ЭНЕРГИЯ СТАЛА НОВОЙ РЕАЛЬНОСТЬЮ.
Dialogue: 0,0:04:38.55,0:04:41.35,Caption,,0,0,0,,ДЛЯ ОЧЕРЕДНОГО ПАКЕТА ПОМОЩИ РЕАЛЬНОСТЬ ПО СТРАННОЙ
Dialogue: 0,0:04:41.35,0:04:44.31,Caption,,0,0,0,,ПРИЧИНЕ БЫСТРО СТАНОВИТСЯ ГИБКОЙ. ТАК ВЫГЛЯДИТ
Dialogue: 0,0:04:44.31,0:04:47.35,Caption,,0,0,0,,ПОРЯДОК ПРИОРИТЕТОВ. СНАЧАЛА НОВЫЕ ОБЯЗАТЕЛЬСТВА ПО
Dialogue: 0,0:04:47.35,0:04:50.31,Caption,,0,0,0,,ПРЕЖНЕМУ КУРСУ, ЗАТЕМ РАСХОДЫ НА ОБОРОНУ,
Dialogue: 0,0:04:50.47,0:04:52.55,Caption,,0,0,0,,ЗАТЕМ ПОПЫТКА УДЕРЖАТЬ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:04:52.79,0:04:55.43,Caption,,0,0,0,,А СОЦИАЛЬНЫЕ СТАТЬИ ЖДУТ, ЧТО ОСТАНЕТСЯ.
Dialogue: 0,0:04:57.71,0:05:01.07,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫЙ ОПЛАЧИВАЕТ ЭТУ ЛЕСТНИЦУ НАЛОГАМИ И СЧЕТАМИ,
Dialogue: 0,0:05:01.32,0:05:06.03,Caption,,0,0,0,,ВПРАВЕ СПРОСИТЬ, КАКОЙ ИЗМЕРИМЫЙ РЕЗУЛЬТАТ ОН ПОЛУЧИТ. ОТВЕТ "ЕЩЁ
Dialogue: 0,0:05:06.11,0:05:09.23,Caption,,0,0,0,,ОДИН ПАКЕТ" РЕЗУЛЬТАТОМ НЕ ЯВЛЯЕТСЯ. ТЕПЕРЬ САМИ
Dialogue: 0,0:05:09.23,0:05:11.79,Caption,,0,0,0,,СУММЫ. ПО РАСЧЁТАМ ГАЗЕТЫ WELT,
Dialogue: 0,0:05:12.10,0:05:15.07,Caption,,0,0,0,,ЕВРОПЕЙСКОМУ СОЮЗУ НУЖНЫ БОЛЕЕ СОРОКА МИЛЛИАРДОВ
Dialogue: 0,0:05:15.15,0:05:17.71,Caption,,0,0,0,,ЕВРО НОВЫХ СОВМЕСТНЫХ КРЕДИТОВ ДЛЯ УКРАИНЫ.
Dialogue: 0,0:05:17.96,0:05:21.07,Caption,,0,0,0,,ПУБЛИКАЦИИ WELT AM SONNTAG ОЦЕНИВАЮТ ОБЩИЙ ОБЪЁМ
Dialogue: 0,0:05:21.07,0:05:23.79,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ ПО ТАКОЙ ПОМОЩИ БОЛЕЕ ЧЕМ В ДВЕСТИ
Dialogue: 0,0:05:23.79,0:05:27.07,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. ЭТО УЖЕ НЕ ВРЕМЕННАЯ НЕХВАТКА ДЕНЕГ
Dialogue: 0,0:05:27.15,0:05:29.87,Caption,,0,0,0,,ДО КОНЦА НЕДЕЛИ. ЭТИ ДОЛГИ ПРИДЁТСЯ ОБСЛУЖИВАТЬ И
Dialogue: 0,0:05:29.87,0:05:32.75,Caption,,0,0,0,,ВОЗВРАЩАТЬ. ДОХОД ОТ ЗАМОРОЖЕННЫХ РОССИЙСКИХ АКТИВОВ
Dialogue: 0,0:05:32.83,0:05:35.39,Caption,,0,0,0,,ЗАДАЧУ НЕ РЕШАЕТ. БОЛЕЕ ЧЕМ ЗА ДВА ГОДА
Dialogue: 0,0:05:35.39,0:05:38.35,Caption,,0,0,0,,ОН СОСТАВИЛ ОКОЛО ВОСЬМИ МИЛЛИАРДОВ ЕВРО. НОВЫЙ
Dialogue: 0,0:05:38.43,0:05:40.91,Caption,,0,0,0,,ЗАПРОС ПРЕВЫШАЕТ ЭТУ СУММУ В НЕСКОЛЬКО РАЗ.
Dialogue: 0,0:05:41.18,0:05:45.71,Caption,,0,0,0,,ОСТАЛЬНОЕ НАДО ЗАНЯТЬ, ЗАБРАТЬ ИЗ БЮДЖЕТОВ ИЛИ ПЕРЕНЕСТИ НА БУДУЩИЕ ГОДЫ.
Dialogue: 0,0:05:46.33,0:05:48.83,Caption,,0,0,0,,У ТАКОГО КРЕДИТА УДОБНЫЙ СРОК ОТВЕТСТВЕННОСТИ.
Dialogue: 0,0:05:49.07,0:05:53.71,Caption,,0,0,0,,ПОДПИСЫВАЮТ СЕГОДНЯ, ОБЪЯСНЯЮТ ПОСЛЕ СЛЕДУЮЩИХ ВЫБОРОВ. ДАЖЕ ОБЕЩАННОЕ
Dialogue: 0,0:05:53.71,0:05:56.67,Caption,,0,0,0,,РАНЬШЕ СОБРАНО НЕ ПОЛНОСТЬЮ. ПО ДАННЫМ POLITICO,
Dialogue: 0,0:05:56.90,0:05:59.87,Caption,,0,0,0,,СТРАНАМ НАТО НЕ ХВАТАЕТ ОКОЛО СЕМИ МИЛЛИАРДОВ ЕВРО
Dialogue: 0,0:05:59.95,0:06:04.19,Caption,,0,0,0,,НА ВОЕННУЮ ПОМОЩЬ УКРАИНЕ, ПРЕДУСМОТРЕННУЮ НА ЭТОТ ГОД. РЯДОМ С ДВУМЯСТАМИ
Dialogue: 0,0:06:04.19,0:06:06.99,Caption,,0,0,0,,МИЛЛИАРДАМИ СУММА ВЫГЛЯДИТ ПОЧТИ КАРМАННОЙ. НО
Dialogue: 0,0:06:06.99,0:06:09.47,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ОНА ОСОБЕННО ПОКАЗАТЕЛЬНА.
Dialogue: 0,0:06:11.74,0:06:13.82,Caption,,0,0,0,,ЕСЛИ НЕ НАШЛИ УЖЕ ОБЕЩАННЫЕ СЕМЬ,
Dialogue: 0,0:06:13.97,0:06:16.46,Caption,,0,0,0,,С КАКОЙ ЛЁГКОСТЬЮ РАССУЖДАЮТ О НОВЫХ СОРОКА?
Dialogue: 0,0:06:16.90,0:06:19.50,Caption,,0,0,0,,ОБЪЯВИТЬ ПАКЕТ ПРОЩЕ, ЧЕМ НАЙТИ ДЕНЬГИ,
Dialogue: 0,0:06:19.66,0:06:22.14,Caption,,0,0,0,,ПРОИЗВЕСТИ ОРУЖИЕ И ДОСТАВИТЬ ЕГО ВОВРЕМЯ.
Dialogue: 0,0:06:22.53,0:06:24.94,Caption,,0,0,0,,ФОТОГРАФИЯ ПОСЛЕ ЗАСЕДАНИЯ ГОТОВА ЧЕРЕЗ МИНУТУ.
Dialogue: 0,0:06:25.34,0:06:28.22,Caption,,0,0,0,,ПРОИЗВОДСТВО ПО КОМАНДЕ ФОТОГРАФА НЕ УСКОРЯЕТСЯ. А
Dialogue: 0,0:06:28.30,0:06:30.62,Caption,,0,0,0,,ПЛАТИТ ЗА ЭТОТ РАЗРЫВ НЕ УЧАСТНИК ЦЕРЕМОНИИ,
Dialogue: 0,0:06:30.81,0:06:34.78,Caption,,0,0,0,,А ТОТ САМЫЙ ЕВРОПЕЕЦ, КОТОРОМУ ПОТОМ РАССКАЖУТ О НЕИЗБЕЖНОМ СОКРАЩЕНИИ
Dialogue: 0,0:06:34.78,0:06:38.06,Caption,,0,0,0,,РАСХОДОВ. КРЕДИТ НА МОСТ ИМЕЕТ ПОНЯТНЫЙ ИТОГ. ПОСЛЕ
Dialogue: 0,0:06:38.06,0:06:40.70,Caption,,0,0,0,,СТРОИТЕЛЬСТВА ПО МОСТУ ЕДУТ МАШИНЫ. ЗАЁМ НА
Dialogue: 0,0:06:40.70,0:06:42.94,Caption,,0,0,0,,ОБОРУДОВАНИЕ ТОЖЕ ЗАКАНЧИВАЕТСЯ КОНКРЕТНО
Dialogue: 0,0:06:42.94,0:06:45.18,Caption,,0,0,0,,ПРЕДПРИЯТИЕ ВЫПУСКАЕТ БОЛЬШЕ ПРОДУКЦИИ.
Dialogue: 0,0:06:45.73,0:06:48.30,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ КРЕДИТ НА ПРОДОЛЖЕНИЕ КОНФЛИКТА УСТРОЕН
Dialogue: 0,0:06:48.30,0:06:51.50,Caption,,0,0,0,,ИНАЧЕ. ДЕНЬГИ НАЗВАНЫ, ПРОЦЕНТЫ СУЩЕСТВУЮТ,
Dialogue: 0,0:06:51.66,0:06:56.78,Caption,,0,0,0,,СРОК ВОЗВРАТА ПРИДЁТ, А УСЛОВИЕ ВЫПОЛНЕНИЯ НЕ УКАЗАНО. КОГДА ИМЕННО
Dialogue: 0,0:06:56.86,0:06:59.10,Caption,,0,0,0,,ПЛАТЕЛЬЩИКУ СКАЖУТ, ЧТО ЗАДАЧА РЕШЕНА?
Dialogue: 0,0:06:59.38,0:07:01.98,Caption,,0,0,0,,ПОСЛЕ УХОДА РОССИЙСКИХ ВОЙСК С КАКИХ ПОЗИЦИЙ?
Dialogue: 0,0:07:02.17,0:07:06.46,Caption,,0,0,0,,ПОСЛЕ КАКОГО СОГЛАШЕНИЯ? БЕЗ КРИТЕРИЯ НОВЫЙ ДОЛГ ПРЕВРАЩАЕТСЯ В РЕГУЛЯРНУЮ
Dialogue: 0,0:07:06.46,0:07:09.50,Caption,,0,0,0,,ПЛАТУ ЗА ОТСУТСТВИЕ РЕШЕНИЯ. БАНК ЗА ТАКОЙ ПЛАН
Dialogue: 0,0:07:09.58,0:07:12.54,Caption,,0,0,0,,ПОПРОСИЛ БЫ ХОТЯ БЫ РАСЧЁТ ОКУПАЕМОСТИ. ЕВРОПЕЙСКОМУ
Dialogue: 0,0:07:12.54,0:07:14.70,Caption,,0,0,0,,ГРАЖДАНИНУ ПРЕДЛАГАЮТ ОБОЙТИСЬ ФОТОГРАФИЕЙ С
Dialogue: 0,0:07:14.70,0:07:17.18,Caption,,0,0,0,,САММИТА. НА ЭТОМ ФОНЕ ФРИДРИХ МЕРЦ УЖЕ НЕ
Dialogue: 0,0:07:17.26,0:07:20.78,Caption,,0,0,0,,ГОВОРИТ, ЧТО РАЗГОВОР С МОСКВОЙ НЕВОЗМОЖЕН. ВОТ ЭТО ПОВОРОТ.
Dialogue: 0,0:07:23.05,0:07:25.45,Caption,,0,0,0,,ОН ЗАЯВИЛ, ЧТО ГОТОВ ВСТРЕТИТЬСЯ С ПУТИНЫМ,
Dialogue: 0,0:07:25.64,0:07:27.93,Caption,,0,0,0,,ЕСЛИ РОССИЙСКИЙ ПРЕЗИДЕНТ ПРИЕДЕТ НА САММИТ
Dialogue: 0,0:07:27.93,0:07:31.05,Caption,,0,0,0,,ДВАДЦАТКИ В МАЙАМИ. ЕЩЁ В ОКТЯБРЕ КАНЦЛЕР ГОВОРИЛ
Dialogue: 0,0:07:31.13,0:07:35.21,Caption,,0,0,0,,ОБ УВЕЛИЧЕНИИ ПОМОЩИ КИЕВУ, А ТЕПЕРЬ СПОКОЙНО ДОПУСКАЕТ ЛИЧНЫЙ РАЗГОВОР.
Dialogue: 0,0:07:35.92,0:07:38.33,Caption,,0,0,0,,ОТДЕЛЬНАЯ ВИДЕОПУБЛИКАЦИЯ С ЗАЯВЛЕНИЕМ МЕРЦА
Dialogue: 0,0:07:38.33,0:07:41.93,Caption,,0,0,0,,ПОКАЗЫВАЕТ ИМЕННО ЭТО ИЗМЕНЕНИЕ ТОНА. МЕРЦ НЕ
Dialogue: 0,0:07:41.93,0:07:44.81,Caption,,0,0,0,,ОТКАЗАЛСЯ ОТ ПОДДЕРЖКИ УКРАИНЫ И НЕ ПЕРЕШЁЛ НА
Dialogue: 0,0:07:44.81,0:07:47.61,Caption,,0,0,0,,СТОРОНУ КРЕМЛЯ. ОН ПРИЗНАЛ ПРОСТУЮ ВЕЩЬ ПОЛИТИКА
Dialogue: 0,0:07:47.69,0:07:52.65,Caption,,0,0,0,,ТРЕБУЕТ РАЗГОВОРА С ЛЮДЬМИ, ЧЬИ ВЗГЛЯДЫ ПРОТИВОПОЛОЖНЫ. ЕВРОПА ПОТРАТИЛА ГОДЫ,
Dialogue: 0,0:07:52.89,0:07:55.45,Caption,,0,0,0,,ЧТОБЫ СНОВА ОТКРЫТЬ ТЕЛЕФОН И ВЫДАТЬ ЭТО ЗА
Dialogue: 0,0:07:55.53,0:07:58.41,Caption,,0,0,0,,ВАЖНОЕ ОТКРЫТИЕ. ЗАТО САМ КОНТАКТ С РОССИЙСКИМ
Dialogue: 0,0:07:58.41,0:08:00.65,Caption,,0,0,0,,РУКОВОДСТВОМ ПЕРЕСТАЁТ СЧИТАТЬСЯ НАРУШЕНИЕМ
Dialogue: 0,0:08:00.73,0:08:03.77,Caption,,0,0,0,,ПРИЛИЧИЙ. АДГ ПРЕДЛАГАЕТ ВАРИАНТ НАМНОГО РЕЗЧЕ.
Dialogue: 0,0:08:04.06,0:08:06.65,Caption,,0,0,0,,ВЕСНОЙ СЛЕДУЮЩЕГО ГОДА ПАРТИЯ ХОЧЕТ ПРОВЕСТИ В АБУ
Dialogue: 0,0:08:06.73,0:08:11.61,Caption,,0,0,0,,ДАБИ ВСТРЕЧУ ГЕРМАНИИ, РОССИИ И СОЕДИНЁННЫХ ШТАТОВ БЕЗ УЧАСТИЯ УКРАИНЫ.
Dialogue: 0,0:08:12.25,0:08:14.81,Caption,,0,0,0,,МАРКУС ФРОНМАЙЕР ГОВОРИТ О ВОССТАНОВЛЕНИИ ОТНОШЕНИЙ
Dialogue: 0,0:08:14.89,0:08:20.17,Caption,,0,0,0,,С МОСКВОЙ, СНЯТИИ САНКЦИЙ, СОТРУДНИЧЕСТВЕ В ЭНЕРГЕТИКЕ И ВОЗВРАЩЕНИИ К ВОПРОСУ
Dialogue: 0,0:08:20.17,0:08:22.73,Caption,,0,0,0,,СЕВЕРНОГО ПОТОКА. ТУТ СПОР ИДЁТ УЖЕ НЕ О
Dialogue: 0,0:08:22.73,0:08:27.45,Caption,,0,0,0,,РАЗМЕРЕ ТРАНША, А О НАПРАВЛЕНИИ ВСЕЙ ГЕРМАНСКОЙ ПОЛИТИКИ. ПО ДАННЫМ
Dialogue: 0,0:08:27.53,0:08:31.53,Caption,,0,0,0,,LE MONDE, АДГ ЗАНИМАЕТ ПЕРВОЕ МЕСТО В ОБЩЕНАЦИОНАЛЬНЫХ ОПРОСАХ
Dialogue: 0,0:08:31.61,0:08:34.81,Caption,,0,0,0,,С РЕЗУЛЬТАТОМ ПРИМЕРНО ОТ ДВАДЦАТИ СЕМИ ДО ТРИДЦАТИ
Dialogue: 0,0:08:34.81,0:08:40.14,Caption,,0,0,0,,ПРОЦЕНТОВ. БЛОК ХДС И ХСС МЕРЦА В ТЕХ ЖЕ
Dialogue: 0,0:08:40.22,0:08:43.02,Caption,,0,0,0,,ЗАМЕРАХ ПОЛУЧАЕТ ПРИМЕРНО ОТ ВОСЕМНАДЦАТИ ДО
Dialogue: 0,0:08:43.02,0:08:47.90,Caption,,0,0,0,,ДВАДЦАТИ ТРЁХ ПРОЦЕНТОВ. АДГ УЖЕ НЕ ПОЛУЧАЕТСЯ ВЫСТАВИТЬ МАЛЕНЬКОЙ КОМПАНИЕЙ
Dialogue: 0,0:08:47.90,0:08:51.10,Caption,,0,0,0,,НЕДОВОЛЬНЫХ, КОТОРАЯ СОБРАЛАСЬ В ПОДВАЛЕ И ПОТЕРЯЛА ПАРОЛЬ ОТ
Dialogue: 0,0:08:51.10,0:08:54.70,Caption,,0,0,0,,ИНТЕРНЕТА. ПЕРВОЕ МЕСТО В ОПРОСАХ ПОКА НЕ ОТКРЫВАЕТ АДГ
Dialogue: 0,0:08:54.70,0:08:57.34,Caption,,0,0,0,,ДВЕРЬ В ПРАВИТЕЛЬСТВО. ДРУГИЕ КРУПНЫЕ ПАРТИИ
Dialogue: 0,0:08:57.34,0:08:59.74,Caption,,0,0,0,,СОХРАНЯЮТ ЗАПРЕТ НА СОТРУДНИЧЕСТВО С НЕЙ,
Dialogue: 0,0:08:59.96,0:09:02.86,Caption,,0,0,0,,ТОТ САМЫЙ БРАНДМАУЭР. КОГДА ПАРТИЯ ДАЛЕКО,
Dialogue: 0,0:09:03.16,0:09:06.14,Caption,,0,0,0,,ВСЕ ЛЮБЯТ РАССКАЗЫВАТЬ О ВОЛЕ ИЗБИРАТЕЛЯ. КОГДА ОНА
Dialogue: 0,0:09:06.22,0:09:10.22,Caption,,0,0,0,,ПРИХОДИТ ПЕРВОЙ, ДЛЯ ВОЛИ ИЗБИРАТЕЛЯ ВНЕЗАПНО ИЩУТ ОТДЕЛЬНЫЙ ВХОД,
Dialogue: 0,0:09:10.37,0:09:13.34,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО ЗАКРЫТЫЙ. В ГЕРМАНИИ РЯДОМ СТОЯТ ДВА
Dialogue: 0,0:09:13.34,0:09:16.22,Caption,,0,0,0,,КУРСА. ДЕЙСТВУЮЩИЙ ЦЕНТР НАМЕРЕН ДАЛЬШЕ
Dialogue: 0,0:09:16.22,0:09:21.02,Caption,,0,0,0,,ФИНАНСИРОВАТЬ КИЕВ, ПОСТАВЛЯТЬ ОРУЖИЕ И ДАВИТЬ НА РОССИЮ. АДГ ПРЕДЛАГАЕТ
Dialogue: 0,0:09:21.02,0:09:25.50,Caption,,0,0,0,,СНЯТЬ САНКЦИИ, ВЕРНУТЬ ЭКОНОМИЧЕСКИЕ СВЯЗИ И УСАДИТЬ ЗА ОДИН СТОЛ
Dialogue: 0,0:09:25.50,0:09:28.22,Caption,,0,0,0,,ГЕРМАНИЮ, РОССИЮ И СОЕДИНЁННЫЕ ШТАТЫ.
Dialogue: 0,0:09:28.78,0:09:30.94,Caption,,0,0,0,,ЭТИ ПРЕДЛОЖЕНИЯ ПОДДЕРЖИВАЮТ НЕ ПОТОМУ,
Dialogue: 0,0:09:31.02,0:09:34.14,Caption,,0,0,0,,ЧТО МИЛЛИОНЫ НЕМЦЕВ РАЗОМ ПОЛЮБИЛИ МОСКВУ. ОДИН КУРС
Dialogue: 0,0:09:34.14,0:09:38.78,Caption,,0,0,0,,ПРОДОЛЖАЕТ ПРЕЖНЕЕ, ДРУГОЙ ОБЕЩАЕТ ЕГО ИЗМЕНИТЬ. РАЗНИЦУ ВИДНО БЕЗ ЛУПЫ.
Dialogue: 0,0:09:39.08,0:09:41.34,Caption,,0,0,0,,А ЗАТЕМ В СПОР ВХОДИТ ДОНАЛЬД ТРАМП. В
Dialogue: 0,0:09:41.34,0:09:44.30,Caption,,0,0,0,,ИНТЕРВЬЮ CBS ОН ЗАЯВИЛ ОБ ОГРОМНОМ НЕУВАЖЕНИИ
Dialogue: 0,0:09:44.38,0:09:49.74,Caption,,0,0,0,,ЗЕЛЕНСКОГО К РОССИИ И СКАЗАЛ, ЧТО ЗАПАДНЫЕ ПОСТАВКИ ОРУЖИЯ НЕ ПРИНЕСЛИ ОЖИДАЕМОГО
Dialogue: 0,0:09:49.74,0:09:55.38,Caption,,0,0,0,,РЕЗУЛЬТАТА. В ОТДЕЛЬНОЙ ВИДЕОПУБЛИКАЦИИ ЕГО СЛОВА ЗВУЧАТ ЕЩЁ
Dialogue: 0,0:09:55.38,0:09:58.50,Caption,,0,0,0,,ПРЯМЕЕ ПРЕЖНЕЕ ОТНОШЕНИЕ КИЕВА К МОСКВЕ ПРИВЕЛО К
Dialogue: 0,0:09:58.50,0:10:03.30,Caption,,0,0,0,,ТУПИКУ, СОГЛАШЕНИЕ БЛИЗКО, А УКРАИНА ПОСЛЕ НЕГО БУДЕТ ИМЕТЬ НЕСКОЛЬКО ДРУГУЮ
Dialogue: 0,0:10:03.38,0:10:06.02,Caption,,0,0,0,,ФОРМУ. ТРАМП МЕНЯЕТ ТОН ТАК ЧАСТО,
Dialogue: 0,0:10:06.25,0:10:09.06,Caption,,0,0,0,,ЧТО РЯДОМ С НИМ ФЛЮГЕР ВЫГЛЯДИТ ОБРАЗЦОМ ВЫДЕРЖКИ.
Dialogue: 0,0:10:09.29,0:10:11.70,Caption,,0,0,0,,НО СЕЙЧАС ПРЕЗИДЕНТ СОЕДИНЁННЫХ ШТАТОВ ГОВОРИТ О
Dialogue: 0,0:10:11.70,0:10:13.94,Caption,,0,0,0,,СОГЛАШЕНИИ И ЗАВЕРШЕНИИ КОНФЛИКТА,
Dialogue: 0,0:10:14.17,0:10:16.74,Caption,,0,0,0,,ТОГДА КАК ЕВРОПЕЙСКИЙ ЦЕНТР ГОВОРИТ О СЛЕДУЮЩЕМ
Dialogue: 0,0:10:16.82,0:10:20.66,Caption,,0,0,0,,ПЛАТЕЖЕ. ВАШИНГТОН ВЫБИРАЕТ СОБСТВЕННУЮ ЦЕЛЬ И НЕ
Dialogue: 0,0:10:20.66,0:10:23.62,Caption,,0,0,0,,ПРОСИТ БРЮССЕЛЬ УТВЕРДИТЬ ФОРМУЛИРОВКУ. ОТСЮДА
Dialogue: 0,0:10:23.62,0:10:26.98,Caption,,0,0,0,,ВОПРОС, КОТОРЫЙ УЖЕ НЕЛЬЗЯ СПРЯТАТЬ ЗА ОБЩИМ ЗАЯВЛЕНИЕМ.
Dialogue: 0,0:10:27.36,0:10:30.74,Caption,,0,0,0,,СПОСОБНА ЛИ ЕВРОПА ВЕСТИ ПРЕЖНИЙ КУРС БЕЗ
Dialogue: 0,0:10:30.82,0:10:34.42,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ? ЕСЛИ ВАШИНГТОН ИДЁТ К ДОГОВОРЁННОСТИ,
Dialogue: 0,0:10:34.73,0:10:37.30,Caption,,0,0,0,,ЕВРОПЕЙСКИМ ПРАВИТЕЛЬСТВАМ ПРИДЁТСЯ САМИМ НАХОДИТЬ
Dialogue: 0,0:10:37.30,0:10:41.22,Caption,,0,0,0,,ДЕНЬГИ, ЗАКАЗЫВАТЬ ОРУЖИЕ, ПЕРЕДАВАТЬ КИЕВУ РАЗВЕДДАННЫЕ,
Dialogue: 0,0:10:41.37,0:10:43.94,Caption,,0,0,0,,ВЫСТРАИВАТЬ ДОСТАВКУ И ОТВЕЧАТЬ ПЕРЕД СВОИМИ
Dialogue: 0,0:10:43.94,0:10:47.22,Caption,,0,0,0,,ГРАЖДАНАМИ ЗА ИТОГ. РЕШИМОСТЬ НА САММИТЕ ВСЕГО ЭТОГО
Dialogue: 0,0:10:47.30,0:10:50.18,Caption,,0,0,0,,НЕ ПРОИЗВОДИТ. ЕСЛИ ВАМ ВАЖЕН РАЗБОР ТОГО,
Dialogue: 0,0:10:50.41,0:10:53.70,Caption,,0,0,0,,КТО ПРИНИМАЕТ РЕШЕНИЕ, КТО ПЛАТИТ И ЧТО ПОЛУЧАЕТ,
Dialogue: 0,0:10:53.96,0:10:56.98,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЕВРОПЕЙЦАМ УЖЕ НАЗЫВАЛИ ОДИН СРОК ЗА
Dialogue: 0,0:10:56.98,0:10:59.94,Caption,,0,0,0,,ДРУГИМ. СНАЧАЛА САНКЦИИ ДОЛЖНЫ БЫЛИ ИЗМЕНИТЬ
Dialogue: 0,0:10:59.94,0:11:03.06,Caption,,0,0,0,,ПОВЕДЕНИЕ МОСКВЫ. ЗАТЕМ ОРУЖИЕ ДОЛЖНО БЫЛО
Dialogue: 0,0:11:03.06,0:11:04.90,Caption,,0,0,0,,ПЕРЕЛОМИТЬ ПОЛОЖЕНИЕ НА ПОЛЕ БОЯ.
Dialogue: 0,0:11:07.18,0:11:09.66,Caption,,0,0,0,,ПОТОМ ОСТАВАЛОСЬ ДОЖДАТЬСЯ НОВОГО ПАКЕТА,
Dialogue: 0,0:11:09.82,0:11:14.46,Caption,,0,0,0,,НОВОГО СЕЗОНА, НОВОГО РЕШЕНИЯ СОЮЗНИКОВ. КАЖДЫЙ СРОК ЗАКАНЧИВАЛСЯ
Dialogue: 0,0:11:14.46,0:11:18.30,Caption,,0,0,0,,СЛЕДУЮЩИМ СРОКОМ, СЛОВНО У ОБЕЩАНИЯ БЫЛА АВТОМАТИЧЕСКАЯ ПОДПИСКА.
Dialogue: 0,0:11:18.93,0:11:21.02,Caption,,0,0,0,,ПРОШЕДШЕЕ ВРЕМЯ ВЫДАВАЛИ ЗА ДОКАЗАТЕЛЬСТВО
Dialogue: 0,0:11:21.02,0:11:24.06,Caption,,0,0,0,,ПРИБЛИЖЕНИЯ ПОБЕДЫ. НО КАЛЕНДАРЬ УМЕЕТ ПОДТВЕРЖДАТЬ
Dialogue: 0,0:11:24.14,0:11:27.34,Caption,,0,0,0,,ТОЛЬКО ОДНУ ВЕЩЬ ПРОШЁЛ ЕЩЁ ОДИН МЕСЯЦ. ЕСЛИ
Dialogue: 0,0:11:27.34,0:11:30.38,Caption,,0,0,0,,ПОСЛЕ КАЖДОГО НЕВЫПОЛНЕННОГО ОБЕЩАНИЯ УСЛОВИЕ ПРОСТО
Dialogue: 0,0:11:30.38,0:11:33.82,Caption,,0,0,0,,ПЕРЕНОСЯТ ДАЛЬШЕ, ЭТО НЕ ПЛАН. ЭТО ТАБЛО ОТПРАВЛЕНИЯ,
Dialogue: 0,0:11:34.06,0:11:35.82,Caption,,0,0,0,,НА КОТОРОМ ПОЕЗД СНОВА ЗАДЕРЖАН,
Dialogue: 0,0:11:36.06,0:11:39.02,Caption,,0,0,0,,А КАССА УЖЕ ПРОДАЁТ БИЛЕТ НА СЛЕДУЮЩИЙ. ЕСЛИ
Dialogue: 0,0:11:39.02,0:11:44.14,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ КУРС ПРОДОЛЖАЮТ, ЕГО ЦЕЛЬ ОБЯЗАНА НАКОНЕЦ ПОЛУЧИТЬ АДРЕС. РОССИЙСКИЕ
Dialogue: 0,0:11:44.22,0:11:46.38,Caption,,0,0,0,,ВОЙСКА ДОЛЖНЫ УЙТИ НА КАКИЕ ПОЗИЦИИ?
Dialogue: 0,0:11:46.60,0:11:49.66,Caption,,0,0,0,,ЭТИ ПОЗИЦИИ НАДО НАЗВАТЬ. МОСКВА ДОЛЖНА ПРИНЯТЬ
Dialogue: 0,0:11:49.74,0:11:53.66,Caption,,0,0,0,,КАКИЕ УСЛОВИЯ? ИХ НАДО ПЕРЕЧИСЛИТЬ. ЕСЛИ РАСЧЁТ СТРОИТСЯ НА СМЕНЕ
Dialogue: 0,0:11:53.74,0:11:56.54,Caption,,0,0,0,,ВЛАСТИ В РОССИИ, НУЖЕН НАСТОЯЩИЙ МЕХАНИЗМ,
Dialogue: 0,0:11:56.69,0:11:59.26,Caption,,0,0,0,,А НЕ НАДЕЖДА НА ИСЧЕЗНОВЕНИЕ ПУТИНА. И САМЫЙ
Dialogue: 0,0:11:59.34,0:12:02.54,Caption,,0,0,0,,ПРЯМОЙ ВОПРОС ТОЖЕ НЕЛЬЗЯ УБИРАТЬ. ПОБЕДА ОЗНАЧАЕТ
Dialogue: 0,0:12:02.54,0:12:04.70,Caption,,0,0,0,,ПРОДВИЖЕНИЕ ДО МОСКВЫ? ДО УРАЛА?
Dialogue: 0,0:12:05.26,0:12:07.82,Caption,,0,0,0,,ТОГДА ЕВРОПЕЙЦАМ НАДО СКАЗАТЬ ЭТО ВСЛУХ И СРАЗУ
Dialogue: 0,0:12:07.82,0:12:10.78,Caption,,0,0,0,,НАЗВАТЬ ЦЕНУ И ПОСЛЕДСТВИЯ. ЕСЛИ ЦЕЛЬ СОСТОИТ В
Dialogue: 0,0:12:10.78,0:12:14.94,Caption,,0,0,0,,КОНКРЕТНОМ СОГЛАШЕНИИ, СЛЕДУЕТ НАЗВАТЬ ЕГО УСЛОВИЯ И ОБЪЯСНИТЬ,
Dialogue: 0,0:12:15.20,0:12:18.62,Caption,,0,0,0,,КАК НОВЫЕ СОРОК МИЛЛИАРДОВ ПРИБЛИЖАЮТ ИМЕННО ЭТОТ
Dialogue: 0,0:12:18.62,0:12:24.43,Caption,,0,0,0,,РЕЗУЛЬТАТ. СЛОВА "СКОЛЬКО ПОТРЕБУЕТСЯ" ОТВЕЧАЮТ НА ВОПРОС О
Dialogue: 0,0:12:24.43,0:12:27.47,Caption,,0,0,0,,ДЛИТЕЛЬНОСТИ РАСХОДОВ, НО НИЧЕГО НЕ ГОВОРЯТ О ПОБЕДЕ.
Dialogue: 0,0:12:28.18,0:12:31.47,Caption,,0,0,0,,ЗАНЯТЬ ЕЩЁ ЕВРОПА СПОСОБНА. НАЙТИ НОВЫЕ СОРОК
Dialogue: 0,0:12:31.47,0:12:34.83,Caption,,0,0,0,,МИЛЛИАРДОВ, ПОДНЯТЬ ОБЩИЕ ОБЯЗАТЕЛЬСТВА ВЫШЕ ДВУХСОТ,
Dialogue: 0,0:12:35.02,0:12:38.27,Caption,,0,0,0,,СОБРАТЬ НЕДОСТАЮЩИЕ СЕМЬ И ПРИНЯТЬ НОВЫЙ ПАКЕТ
Dialogue: 0,0:12:38.35,0:12:41.55,Caption,,0,0,0,,САНКЦИЙ ТЕХНИЧЕСКИ РЕАЛЬНО. НАПИСАТЬ ЗАЯВЛЕНИЕ О
Dialogue: 0,0:12:41.55,0:12:44.35,Caption,,0,0,0,,ЕДИНСТВЕ ВООБЩЕ ПРОЩЕ ВСЕГО. ДЛЯ ЭТОГО НЕ НУЖНА
Dialogue: 0,0:12:44.35,0:12:47.63,Caption,,0,0,0,,НИ ПРОИЗВОДСТВЕННАЯ ЛИНИЯ, НИ СОГЛАСИЕ ИЗБИРАТЕЛЯ,
Dialogue: 0,0:12:47.88,0:12:50.99,Caption,,0,0,0,,ДОСТАТОЧНО СВОБОДНОГО МИКРОФОНА. НО ГЛАВНЫЙ ВОПРОС
Dialogue: 0,0:12:51.07,0:12:54.43,Caption,,0,0,0,,ПОСЛЕ ВСЕХ КРЕДИТОВ ОСТАНЕТСЯ НА СТОЛЕ. ГДЕ КОНЕЧНАЯ
Dialogue: 0,0:12:54.43,0:12:57.07,Caption,,0,0,0,,ТОЧКА КУРСА? В МОСКВЕ, У УРАЛА,
Dialogue: 0,0:12:57.31,0:13:01.71,Caption,,0,0,0,,ЗА СТОЛОМ ПЕРЕГОВОРОВ, В СМЕНЕ РОССИЙСКОЙ ВЛАСТИ ИЛИ НА ЗАРАНЕЕ НАЗВАННЫХ
Dialogue: 0,0:13:01.79,0:13:05.95,Caption,,0,0,0,,ГРАНИЦАХ? ПОКА ОТВЕТА НЕТ, ПРОДОЛЖЕНИЕ САМО СТАЛО ЦЕЛЬЮ,
Dialogue: 0,0:13:06.19,0:13:08.83,Caption,,0,0,0,,А КАЖДЫЙ ПРОШЛЫЙ ПЛАТЁЖ СЛУЖИТ ОПРАВДАНИЕМ
Dialogue: 0,0:13:08.83,0:13:12.19,Caption,,0,0,0,,СЛЕДУЮЩЕГО. ВЫБОР У ЕВРОПЫ ПРОСТОЙ И НЕПРИЯТНЫЙ.
Dialogue: 0,0:13:12.65,0:13:15.07,Caption,,0,0,0,,ЛИБО ВЛАСТИ НАЗЫВАЮТ ДОСТИЖИМУЮ ЦЕЛЬ,
Dialogue: 0,0:13:15.23,0:13:19.71,Caption,,0,0,0,,УСЛОВИЯ, СРОК, ЦЕНУ И ПРЕДЕЛ РИСКА. ЛИБО ПРИЗНАЮТ,
Dialogue: 0,0:13:19.87,0:13:21.87,Caption,,0,0,0,,ЧТО ПРЕЖНИЙ КУРС РЕЗУЛЬТАТА НЕ ДАЛ,
Dialogue: 0,0:13:22.08,0:13:25.39,Caption,,0,0,0,,И МЕНЯЮТ ЕГО. ВСЁ ОСТАЛЬНОЕ ОЗНАЧАЕТ НОВЫЙ СЧЁТ
Dialogue: 0,0:13:25.39,0:13:28.11,Caption,,0,0,0,,ЧЕЛОВЕКУ, КОТОРОГО НЕ ПУСТИЛИ К ОБСУЖДЕНИЮ,
Dialogue: 0,0:13:28.35,0:13:30.75,Caption,,0,0,0,,НО НЕ ЗАБЫЛИ ПОЗВАТЬ К ОПЛАТЕ. И КОГДА
Dialogue: 0,0:13:30.83,0:13:34.59,Caption,,0,0,0,,ОН ВСЁ ЖЕ СПРОСИТ, КАКУЮ ИМЕННО ПОБЕДУ ЕМУ ПРОДАЛИ В РАССРОЧКУ,
Dialogue: 0,0:13:34.83,0:13:37.23,Caption,,0,0,0,,ЗАЯВЛЕНИЕМ О ЕДИНСТВЕ ТУТ УЖЕ НЕ ОТГОВОРИШЬСЯ.
