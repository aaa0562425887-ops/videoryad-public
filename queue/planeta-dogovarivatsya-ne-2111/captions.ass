Dialogue: 0,0:00:00.12,0:00:03.32,Caption,,0,0,0,,С МИРНЫМИ ПЕРЕГОВОРАМИ ТВОРИТСЯ ЗАНЯТНЫЙ ФОКУС. ЧЕМ
Dialogue: 0,0:00:03.32,0:00:05.16,Caption,,0,0,0,,НАСТОЙЧИВЕЕ УЧАСТНИКИ УВЕРЯЮТ,
Dialogue: 0,0:00:05.32,0:00:09.00,Caption,,0,0,0,,ЧТО СОГЛАШЕНИЕ БЛИЗКО, ТЕМ ОХОТНЕЕ ДОСТАЮТ ТРЕБОВАНИЯ,
Dialogue: 0,0:00:09.16,0:00:11.96,Caption,,0,0,0,,КОТОРЫЕ ПРОТИВНИК ДАВНО И НЕДВУСМЫСЛЕННО ОТВЕРГ.
Dialogue: 0,0:00:12.51,0:00:15.16,Caption,,0,0,0,,ПОЛУЧАЕТСЯ РАЗГОВОР С ДОМОФОНОМ КНОПКУ НАЖИМАЮТ
Dialogue: 0,0:00:15.16,0:00:18.04,Caption,,0,0,0,,СНОВА И СНОВА, ХОТЯ ИЗ КВАРТИРЫ УЖЕ ОТВЕТИЛИ,
Dialogue: 0,0:00:18.27,0:00:21.48,Caption,,0,0,0,,ЧТО ГОСТЕЙ НЕ ЖДУТ. ПОЭТОМУ ИНТЕРЕСНЕЕ НЕ ОЧЕРЕДНОЕ
Dialogue: 0,0:00:21.48,0:00:23.80,Caption,,0,0,0,,ПРИГЛАШЕНИЕ К МИРУ, А ПРИЧИНА,
Dialogue: 0,0:00:23.96,0:00:27.08,Caption,,0,0,0,,ПО КОТОРОЙ ЗАВЕДОМО НЕПРИЕМЛЕМЫЕ УСЛОВИЯ ОПЯТЬ
Dialogue: 0,0:00:27.08,0:00:29.40,Caption,,0,0,0,,ВОЗВРАЩАЮТ В ПОВЕСТКУ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:00:29.63,0:00:31.72,Caption,,0,0,0,,ЕСЛИ ВАМ НУЖНЫ РАЗБОРЫ РЕАЛЬНЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:00:32.03,0:00:33.88,Caption,,0,0,0,,А НЕ ПЕРЕСКАЗ РЕЧЕЙ ВОЗЛЕ МИКРОФОНА.
Dialogue: 0,0:00:34.67,0:00:38.52,Caption,,0,0,0,,ПУТИН ЗАЯВЛЯЕТ, ЧТО НЕ СЧИТАЕТ РАЗНОГЛАСИЯ НЕПРЕОДОЛИМЫМИ. ПО ЕГО
Dialogue: 0,0:00:38.52,0:00:42.44,Caption,,0,0,0,,СЛОВАМ, ВОЗМОЖНЫЕ УСЛОВИЯ И УСТУПКИ ОБСУЖДАЛИСЬ ЕЩЁ ПЕРЕД
Dialogue: 0,0:00:42.44,0:00:46.20,Caption,,0,0,0,,ВСТРЕЧЕЙ В АНКОРИДЖЕ, А КИЕВУ ДОСТАТОЧНО НАЧАТЬ РАБОТАТЬ С ЭТИМИ
Dialogue: 0,0:00:46.20,0:00:51.24,Caption,,0,0,0,,ПРЕДЛОЖЕНИЯМИ. ЗВУЧИТ ТАК, СЛОВНО ОСТАЛОСЬ ВЫБРАТЬ РУЧКУ И ПОДПИСАТЬ БУМАГИ. НО
Dialogue: 0,0:00:51.24,0:00:54.12,Caption,,0,0,0,,СЛЕДОМ МОСКВА УТОЧНЯЕТ ПОСЛЕ АТАКИ НА КРЫМСКИЙ МОСТ
Dialogue: 0,0:00:54.20,0:00:56.84,Caption,,0,0,0,,НЕКОТОРЫЕ ВАРИАНТЫ ПРЕКРАЩЕНИЯ ОГНЯ БОЛЬШЕ
Dialogue: 0,0:00:56.92,0:00:59.72,Caption,,0,0,0,,РАССМАТРИВАТЬСЯ НЕ БУДУТ. И ЭТО ЗАЯВЛЕНИЕ ЗНАЧИТ
Dialogue: 0,0:00:59.80,0:01:02.92,Caption,,0,0,0,,ГОРАЗДО БОЛЬШЕ, ЧЕМ ОЧЕРЕДНОЕ ОБСУЖДЕНИЕ САМОГО УДАРА.
Dialogue: 0,0:01:03.63,0:01:06.04,Caption,,0,0,0,,АТАКА ПОВЛИЯЛА НЕ ТОЛЬКО НА ОБСТАНОВКУ ВОКРУГ
Dialogue: 0,0:01:06.04,0:01:09.16,Caption,,0,0,0,,КОНФЛИКТА. ОНА УМЕНЬШИЛА НАБОР ПРОМЕЖУТОЧНЫХ
Dialogue: 0,0:01:09.16,0:01:12.28,Caption,,0,0,0,,РЕШЕНИЙ, НА КОТОРЫЕ РОССИЯ ЕЩЁ МОГЛА СОГЛАСИТЬСЯ ДО
Dialogue: 0,0:01:12.36,0:01:18.64,Caption,,0,0,0,,ЗАКЛЮЧЕНИЯ ОБЩЕЙ СДЕЛКИ. БОЛЬШОЙ ДОГОВОР МОСКВА НЕ ВЫБРАСЫВАЕТ. ПУТИН
Dialogue: 0,0:01:18.64,0:01:21.28,Caption,,0,0,0,,ПРОДОЛЖАЕТ ГОВОРИТЬ О СОГЛАШЕНИИ И КОМПРОМИССАХ.
Dialogue: 0,0:01:21.60,0:01:24.16,Caption,,0,0,0,,ЗАТО ОТДЕЛЬНЫЕ ДОГОВОРЁННОСТИ О ПЕРЕДЫШКЕ НАЧАЛИ
Dialogue: 0,0:01:24.16,0:01:26.88,Caption,,0,0,0,,ВЫПАДАТЬ ИЗ ОБСУЖДЕНИЯ. РАЗНИЦА ЗДЕСЬ ВПОЛНЕ
Dialogue: 0,0:01:26.88,0:01:29.76,Caption,,0,0,0,,ПРАКТИЧЕСКАЯ. МОЖНО ТОРГОВАТЬСЯ СРАЗУ ОБО ВСЁМ
Dialogue: 0,0:01:29.76,0:01:35.04,Caption,,0,0,0,,ТЕРРИТОРИЯХ, ГАРАНТИЯХ, БЕЗОПАСНОСТИ И БУДУЩЕМ УСТРОЙСТВЕ ОТНОШЕНИЙ. А МОЖНО
Dialogue: 0,0:01:35.04,0:01:37.92,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ НЕБОЛЬШИМИ ПОРЦИЯМИ ЭТОТ ОБЪЕКТ НЕ
Dialogue: 0,0:01:37.92,0:01:41.76,Caption,,0,0,0,,ТРОГАЕМ, ЗДЕСЬ ВВОДИМ ОГРАНИЧЕНИЕ. ТАКИЕ РЕШЕНИЯ ОСОБЕННО
Dialogue: 0,0:01:41.76,0:01:45.84,Caption,,0,0,0,,ВЫГОДНЫ СТОРОНЕ, КОТОРОЙ ПЕРЕДЫШКА НУЖНА НЕМЕДЛЕННО. НО УЧАСТНИК,
Dialogue: 0,0:01:46.08,0:01:48.16,Caption,,0,0,0,,УВЕРЕННЫЙ В СВОЕЙ ВОЕННОЙ ДИНАМИКЕ,
Dialogue: 0,0:01:48.32,0:01:51.20,Caption,,0,0,0,,НЕ СТАНЕТ РАЗДАВАТЬ ОБЛЕГЧЕНИЕ БЕСПЛАТНО. В МАГАЗИНЕ
Dialogue: 0,0:01:51.20,0:01:53.92,Caption,,0,0,0,,УСТУПОК ВНЕЗАПНО ЗАКОНЧИЛИСЬ СКИДОЧНЫЕ КАРТЫ.
Dialogue: 0,0:01:54.25,0:01:57.12,Caption,,0,0,0,,ПОЭТОМУ ОТКАЗ ОБСУЖДАТЬ ОТДЕЛЬНЫЕ РЕЖИМЫ ПРЕКРАЩЕНИЯ
Dialogue: 0,0:01:57.12,0:02:02.00,Caption,,0,0,0,,ОГНЯ ВЕСИТ БОЛЬШЕ, ЧЕМ ЦЕЛАЯ КОРЗИНА ТОРЖЕСТВЕННЫХ ОБЕЩАНИЙ. МЕНЯЕТСЯ
Dialogue: 0,0:02:02.08,0:02:06.88,Caption,,0,0,0,,НЕ НАСТРОЕНИЕ ПЕРЕГОВОРЩИКОВ, А СТОИМОСТЬ САМОГО РАЗГОВОРА. ЕЩЁ НЕДАВНО ВХОДНЫМ
Dialogue: 0,0:02:06.88,0:02:09.52,Caption,,0,0,0,,БИЛЕТОМ МОГ БЫТЬ ОГРАНИЧЕННЫЙ КОМПРОМИСС. ТЕПЕРЬ
Dialogue: 0,0:02:09.52,0:02:12.32,Caption,,0,0,0,,РОССИЯ ПОДАЁТ ДРУГОЙ СИГНАЛ ЕСЛИ ХОТИТЕ ОБСУЖДЕНИЯ,
Dialogue: 0,0:02:12.62,0:02:15.92,Caption,,0,0,0,,ПРИНОСИТЕ ПРЕДЛОЖЕНИЕ КРУПНЕЕ. МОСТ В ЭТОЙ ЛОГИКЕ
Dialogue: 0,0:02:15.92,0:02:19.28,Caption,,0,0,0,,СТАНОВИТСЯ НЕ ТОЛЬКО ЦЕЛЬЮ АТАКИ. КАЖДЫЙ НОВЫЙ ВИТОК
Dialogue: 0,0:02:19.36,0:02:23.36,Caption,,0,0,0,,ПОВЫШАЕТ ЦЕНУ, КОТОРУЮ ПОТОМ ВЫСТАВЯТ ЗА УСТУПКУ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:02:23.36,0:02:27.60,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО МОСКВА ОТКЛОНИЛА ВСЕ ИНИЦИАТИВЫ ПО ПРЕКРАЩЕНИЮ
Dialogue: 0,0:02:27.60,0:02:31.23,Caption,,0,0,0,,ОГНЯ. РОССИЯ ОТВЕЧАЕТ,
Dialogue: 0,0:02:31.47,0:02:33.47,Caption,,0,0,0,,ЧТО ЗАВЕРШЕНИЕ КОНФЛИКТА ВОЗМОЖНО,
Dialogue: 0,0:02:33.71,0:02:36.51,Caption,,0,0,0,,НО ЛИШЬ ПРИ ПРИНЯТИИ ЕЁ УСЛОВИЙ. ЕСЛИ ДОЛГО
Dialogue: 0,0:02:36.51,0:02:38.91,Caption,,0,0,0,,СЛУШАТЬ ОБЕ СТОРОНЫ, НАЧИНАЕТ КАЗАТЬСЯ,
Dialogue: 0,0:02:39.23,0:02:41.07,Caption,,0,0,0,,ЧТО ПРИСУТСТВУЕШЬ ПРИ РАЗВОДЕ,
Dialogue: 0,0:02:41.40,0:02:43.55,Caption,,0,0,0,,ГДЕ СУПРУГИ ДЕЛЯТ НЕ ДАЧУ И СЕРВИЗ,
Dialogue: 0,0:02:43.70,0:02:48.51,Caption,,0,0,0,,А ТЕРРИТОРИИ, РАКЕТЫ И СОТНИ МИЛЛИАРДОВ ДОЛЛАРОВ. КАЖДЫЙ ПРИШЁЛ ЗА
Dialogue: 0,0:02:48.59,0:02:51.23,Caption,,0,0,0,,МИРОМ, ТОЛЬКО ИМУЩЕСТВО ПОЧЕМУ ТО СНОВА ГОРИТ.
Dialogue: 0,0:02:51.80,0:02:54.59,Caption,,0,0,0,,ПОЭТОМУ РЕШЕНИЯ ГОВОРЯТ ГОРАЗДО ГРОМЧЕ ЗАЯВЛЕНИЙ.
Dialogue: 0,0:02:54.87,0:02:57.55,Caption,,0,0,0,,ВСЛЕД ЗА НОВОЙ АТАКОЙ НА КРЫМСКИЙ МОСТ УДАРЫ
Dialogue: 0,0:02:57.55,0:03:00.43,Caption,,0,0,0,,ПРИШЛИСЬ ПО КИЕВУ. УКРАИНСКИЕ ИЗДАНИЯ ПИСАЛИ О
Dialogue: 0,0:03:00.43,0:03:03.23,Caption,,0,0,0,,ПРИМЕНЕНИИ БАЛЛИСТИЧЕСКИХ РАКЕТ ПРОТИВ НЕСКОЛЬКИХ
Dialogue: 0,0:03:03.23,0:03:07.63,Caption,,0,0,0,,СТОЛИЧНЫХ МОСТОВ. РОССИЙСКОЕ МИНИСТЕРСТВО ОБОРОНЫ СООБЩИЛО О ПОРАЖЕНИИ
Dialogue: 0,0:03:07.63,0:03:10.19,Caption,,0,0,0,,ПРЕДПРИЯТИЙ РАКЕТНОЙ И БЕСПИЛОТНОЙ ОТРАСЛИ,
Dialogue: 0,0:03:10.35,0:03:14.91,Caption,,0,0,0,,СКЛАДСКИХ ПЛОЩАДОК, ТРАНСПОРТНЫХ УЗЛОВ И ПЕРЕПРАВ. КИЕВ ПРЕДСТАВИЛ
Dialogue: 0,0:03:14.91,0:03:17.71,Caption,,0,0,0,,СОБСТВЕННУЮ КАРТИНУ ПОСЛЕДСТВИЙ. И ОДНОВРЕМЕННО С
Dialogue: 0,0:03:17.71,0:03:20.43,Caption,,0,0,0,,РАЗГОВОРАМИ О ЗАВЕРШЕНИИ БОЕВЫХ ДЕЙСТВИЙ УКРАИНА
Dialogue: 0,0:03:20.43,0:03:22.99,Caption,,0,0,0,,РАССЧИТЫВАЕТ ВОЕННЫЕ ПОТРЕБНОСТИ СЛЕДУЮЩЕГО ГОДА.
Dialogue: 0,0:03:23.44,0:03:25.23,Caption,,0,0,0,,УКРАИНСКИЙ МИНИСТР ОБОРОНЫ ОБЪЯВИЛ,
Dialogue: 0,0:03:25.55,0:03:28.43,Caption,,0,0,0,,ЧТО ВЫПУСК ДАЛЬНОБОЙНЫХ БЕСПИЛОТНИКОВ ДОЛЖЕН ВЫРАСТИ
Dialogue: 0,0:03:28.51,0:03:32.51,Caption,,0,0,0,,БОЛЕЕ ЧЕМ ВТРОЕ. НА БЕСПИЛОТНЫЕ СИСТЕМЫ ПРЕДПОЛАГАЕТСЯ ПОТРАТИТЬ
Dialogue: 0,0:03:32.59,0:03:34.75,Caption,,0,0,0,,ШЕСТЬДЕСЯТ ДВА ПРОЦЕНТА СРЕДСТВ,
Dialogue: 0,0:03:34.91,0:03:38.19,Caption,,0,0,0,,ПОСТУПАЮЩИХ ОТ ИНОСТРАННЫХ ПАРТНЁРОВ. НЕ ДЕСЯТЬ И НЕ
Dialogue: 0,0:03:38.19,0:03:40.51,Caption,,0,0,0,,ДВАДЦАТЬ ПРОЦЕНТОВ. ШЕСТЬДЕСЯТ ДВА.
Dialogue: 0,0:03:42.79,0:03:45.59,Caption,,0,0,0,,НА КАЖДЫЕ ДЕСЯТЬ УСЛОВНЫХ ЕВРО ПОМОЩИ ПРИХОДИТСЯ
Dialogue: 0,0:03:45.59,0:03:49.11,Caption,,0,0,0,,БОЛЬШЕ ШЕСТИ ЕВРО НА АППАРАТЫ РАЗНЫХ КЛАССОВ. ПОСЛЕ
Dialogue: 0,0:03:49.11,0:03:51.67,Caption,,0,0,0,,ТАКОЙ ПРОПОРЦИИ РАССУЖДЕНИЯ О ВРЕМЕННОМ ПРОЕКТЕ
Dialogue: 0,0:03:51.75,0:03:54.47,Caption,,0,0,0,,МОЖНО АККУРАТНО УБРАТЬ В ЯЩИК ВМЕСТЕ С ДРУГИМИ
Dialogue: 0,0:03:54.47,0:03:57.11,Caption,,0,0,0,,НЕУДАЧНЫМИ ШУТКАМИ. ТОГДА РОССИЙСКИЕ УДАРЫ ПО
Dialogue: 0,0:03:57.11,0:04:00.95,Caption,,0,0,0,,ПРЕДПРИЯТИЯМ, СКЛАДАМ И ТРАНСПОРТНОЙ ИНФРАСТРУКТУРЕ СКЛАДЫВАЮТСЯ В
Dialogue: 0,0:04:00.95,0:04:03.99,Caption,,0,0,0,,ПОНЯТНУЮ СИСТЕМУ. ИХ ЗАДАЧА СОСТОИТ НЕ ТОЛЬКО В
Dialogue: 0,0:04:03.99,0:04:06.79,Caption,,0,0,0,,УНИЧТОЖЕНИИ ГОТОВЫХ ИЗДЕЛИЙ. ПОД УДАР ПОПАДАЕТ
Dialogue: 0,0:04:06.87,0:04:09.11,Caption,,0,0,0,,СПОСОБНОСТЬ ПРОИЗВЕСТИ БУДУЩИЕ ПАРТИИ,
Dialogue: 0,0:04:09.35,0:04:11.35,Caption,,0,0,0,,КОТОРЫЕ ПОКА СУЩЕСТВУЮТ В СМЕТАХ,
Dialogue: 0,0:04:11.43,0:04:15.03,Caption,,0,0,0,,ЗАКАЗАХ И ГРАФИКАХ. ПОЛУЧАЕТСЯ РЕДКАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:04:15.51,0:04:17.91,Caption,,0,0,0,,ЗА СТОЛОМ ВЫБИРАЮТ ФОРМУЛИРОВКИ ДЛЯ ПРЕКРАЩЕНИЯ
Dialogue: 0,0:04:17.99,0:04:21.75,Caption,,0,0,0,,КОНФЛИКТА, А РЯДОМ ПОДСЧИТЫВАЮТ БЕСПИЛОТНИКИ НА СЛЕДУЮЩИЙ ГОД И
Dialogue: 0,0:04:21.75,0:04:26.15,Caption,,0,0,0,,ПРЕДПРИЯТИЯ, КОТОРЫЕ СЛЕДУЕТ ЗАЩИТИТЬ ИЛИ РАЗРУШИТЬ. МИР ЕЩЁ НЕ
Dialogue: 0,0:04:26.15,0:04:29.03,Caption,,0,0,0,,ОФОРМЛЕН, ЗАТО ПРОИЗВОДСТВЕННЫЙ ПЛАН УЖЕ ЗНАЕТ,
Dialogue: 0,0:04:29.27,0:04:32.23,Caption,,0,0,0,,СКОЛЬКО ЕМУ ПОНАДОБИТСЯ ДВИГАТЕЛЕЙ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:04:32.42,0:04:34.95,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ВИДЕТЬ ИМЕННО ЭТИ НЕСОСТЫКОВКИ.
Dialogue: 0,0:04:35.51,0:04:38.63,Caption,,0,0,0,,ОФИЦИАЛЬНЫЕ РЕЧИ ВСЕГДА ХОРОШО ВЫГЛАЖЕНЫ. НАСТОЯЩИЙ
Dialogue: 0,0:04:38.71,0:04:41.03,Caption,,0,0,0,,СМЫСЛ ПОЯВЛЯЕТСЯ ПОСЛЕ ПРОВЕРКИ БЮДЖЕТОВ,
Dialogue: 0,0:04:41.20,0:04:46.47,Caption,,0,0,0,,КОНТРАКТОВ И ВЫБРАННЫХ ЦЕЛЕЙ. НА ЭТОМ ФОНЕ МАКРОН ПРЕДЛАГАЕТ ВЕРНУТЬСЯ К ВОПРОСУ
Dialogue: 0,0:04:46.47,0:04:49.35,Caption,,0,0,0,,О ВСТУПЛЕНИИ УКРАИНЫ В НАТО. ОТЛИЧНЫЙ СПОСОБ
Dialogue: 0,0:04:49.35,0:04:52.31,Caption,,0,0,0,,СОКРАТИТЬ РАССТОЯНИЕ МЕЖДУ ПОЗИЦИЯМИ. ПРИМЕРНО КАК
Dialogue: 0,0:04:52.39,0:04:55.19,Caption,,0,0,0,,ПРИНЕСТИ БЕНЗИН НА ВСТРЕЧУ ПОЖАРНЫХ И УДИВЛЯТЬСЯ
Dialogue: 0,0:04:55.19,0:05:00.42,Caption,,0,0,0,,НАПРЯЖЕНИЮ. ЕВРОПА СНОВА КЛАДЁТ ПЕРЕД МОСКВОЙ ТЕМУ,
Dialogue: 0,0:05:00.51,0:05:02.74,Caption,,0,0,0,,КОТОРАЯ ГОДАМИ ОСТАВАЛАСЬ ОДНОЙ ИЗ САМЫХ
Dialogue: 0,0:05:02.74,0:05:07.30,Caption,,0,0,0,,НЕПРИЕМЛЕМЫХ. ВИДИМО, РАСЧЁТ ТАКОЙ РОССИЙСКАЯ СТОРОНА УВИДИТ ЗНАКОМОЕ
Dialogue: 0,0:05:07.30,0:05:11.30,Caption,,0,0,0,,ТРЕБОВАНИЕ, РАСТРОГАЕТСЯ ПОСТОЯНСТВОМ И НЕМЕДЛЕННО СОГЛАСИТСЯ.
Dialogue: 0,0:05:11.64,0:05:15.30,Caption,,0,0,0,,ВДРУГ СЛОВО "НЕТ" ЗА НОЧЬ ПОМЕНЯЛО ЗНАЧЕНИЕ. МАКРОН
Dialogue: 0,0:05:15.30,0:05:18.34,Caption,,0,0,0,,ОТЛИЧНО ПОНИМАЕТ ОТНОШЕНИЕ РОССИИ К РАСШИРЕНИЮ НАТО.
Dialogue: 0,0:05:18.74,0:05:21.06,Caption,,0,0,0,,ЕГО СОВЕТНИКАМ ТЕМ БОЛЕЕ НЕ ПРИХОДИТСЯ ОТКРЫВАТЬ
Dialogue: 0,0:05:21.06,0:05:24.26,Caption,,0,0,0,,СПРАВОЧНИК И ИСКАТЬ СООТВЕТСТВУЮЩИЙ РАЗДЕЛ. НО
Dialogue: 0,0:05:24.26,0:05:26.98,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ВСЁ РАВНО ВОЗВРАЩАЕТСЯ. МОСКВА ЕГО,
Dialogue: 0,0:05:27.07,0:05:30.58,Caption,,0,0,0,,КОНЕЧНО, УСЛЫШИТ. НЕДОСТАТКА СЛУХА ЗДЕСЬ НИКОГДА НЕ БЫЛО.
Dialogue: 0,0:05:30.98,0:05:34.82,Caption,,0,0,0,,ГОРАЗДО ИНТЕРЕСНЕЕ, ЗАЧЕМ В НОВЫЙ РАУНД ЗАРАНЕЕ ВНОСИТЬ ПУНКТ,
Dialogue: 0,0:05:35.14,0:05:37.62,Caption,,0,0,0,,КОТОРЫЙ ПОЧТИ НАВЕРНЯКА РАЗДВИНЕТ ПОЗИЦИИ ЕЩЁ
Dialogue: 0,0:05:37.62,0:05:40.50,Caption,,0,0,0,,СИЛЬНЕЕ. ДЛЯ СКОРЕЙШЕГО СОГЛАШЕНИЯ ТАКОЙ ШАГ
Dialogue: 0,0:05:40.50,0:05:43.06,Caption,,0,0,0,,ВЫГЛЯДИТ НЕЛЕПО. НО ЕСЛИ ТРЕБУЕТСЯ ПОВЫСИТЬ
Dialogue: 0,0:05:43.06,0:05:45.94,Caption,,0,0,0,,СТОИМОСТЬ СДЕЛКИ ИЛИ ПОКАЗАТЬ ВЕРНОСТЬ ПРЕЖНЕМУ
Dialogue: 0,0:05:45.94,0:05:49.94,Caption,,0,0,0,,КУРСУ, ДЕЙСТВИЕ СТАНОВИТСЯ ВПОЛНЕ РАСЧЁТЛИВЫМ. МАКРОН ОДНИМ
Dialogue: 0,0:05:49.94,0:05:53.22,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕМ ОТПРАВЛЯЕТ ТРИ СИГНАЛА. КИЕВ ПОЛУЧАЕТ
Dialogue: 0,0:05:53.22,0:05:57.70,Caption,,0,0,0,,ПОДТВЕРЖДЕНИЕ, ЧТО ПЕРСПЕКТИВУ НАТО НЕ ПОХОРОНИЛИ. МОСКВА ВИДИТ,
Dialogue: 0,0:05:57.93,0:06:00.66,Caption,,0,0,0,,ЧТО ОТКАЗ ЕВРОПЫ ОТ ЭТОЙ ПОЗИЦИИ ПРИДЁТСЯ ЧЕМ
Dialogue: 0,0:06:00.66,0:06:04.26,Caption,,0,0,0,,ТО ОПЛАЧИВАТЬ. САМ ЕВРОСОЮЗ СОХРАНЯЕТ КОЗЫРЬ ДЛЯ
Dialogue: 0,0:06:04.26,0:06:07.30,Caption,,0,0,0,,БУДУЩЕГО ОБМЕНА. ПОКА ПУНКТ О НАТО ОСТАЁТСЯ СРЕДИ
Dialogue: 0,0:06:07.38,0:06:11.38,Caption,,0,0,0,,ТРЕБОВАНИЙ, ОН ОБЛАДАЕТ ЦЕНОЙ. УБРАТЬ ЕГО БЕСПЛАТНО ОЗНАЧАЕТ
Dialogue: 0,0:06:11.39,0:06:14.66,Caption,,0,0,0,,ОТКАЗАТЬСЯ ОТ ПРЕДМЕТА ТОРГА ЕЩЁ ДО НАЧАЛА ТОРГА.
Dialogue: 0,0:06:16.94,0:06:18.70,Caption,,0,0,0,,А НИКТО НЕ ПРИХОДИТ НА РЫНОК С ПУСТОЙ
Dialogue: 0,0:06:18.70,0:06:22.78,Caption,,0,0,0,,СУМКОЙ, ОСОБЕННО КОГДА РЫНОК ОХРАНЯЕТСЯ АРМИЯМИ. ПРОБЛЕМА В
Dialogue: 0,0:06:22.86,0:06:25.90,Caption,,0,0,0,,ТОМ, ЧТО ПЕРЕГОВОРЫ ПРИ ТАКОМ ПОДХОДЕ ПРЕВРАЩАЮТСЯ В
Dialogue: 0,0:06:25.90,0:06:28.70,Caption,,0,0,0,,АУКЦИОН ТРЕБОВАНИЙ. УЧАСТНИКИ СЛЕДЯТ,
Dialogue: 0,0:06:28.93,0:06:33.34,Caption,,0,0,0,,КТО ПЕРВЫМ ОТСТУПИТ, КТО СНИЗИТ СТАВКУ И ЧЬЯ УСТУПКА ОКАЖЕТСЯ ДОРОЖЕ.
Dialogue: 0,0:06:33.89,0:06:35.66,Caption,,0,0,0,,ВЕДУЩИЙ ЕЩЁ ГОВОРИТ О СОГЛАСИИ,
Dialogue: 0,0:06:35.98,0:06:40.46,Caption,,0,0,0,,А ПОКУПАТЕЛИ УЖЕ ПРОВЕРЯЮТ, У КОГО ДРОГНУЛА РУКА. КОЛИЧЕСТВО МИРА ОТ ЭТОГО
Dialogue: 0,0:06:40.54,0:06:43.74,Caption,,0,0,0,,НЕ УВЕЛИЧИВАЕТСЯ. НЫНЕШНИЙ ПРОЦЕСС ВООБЩЕ ДЕРЖИТСЯ
Dialogue: 0,0:06:43.74,0:06:46.78,Caption,,0,0,0,,НА ОДНОМ ПРОТИВОРЕЧИИ. ВСЕ ИСПОЛЬЗУЮТ ОДНО СЛОВО,
Dialogue: 0,0:06:47.01,0:06:49.90,Caption,,0,0,0,,НО ВКЛАДЫВАЮТ В НЕГО РАЗНЫЕ РЕЗУЛЬТАТЫ. РОССИЯ
Dialogue: 0,0:06:49.90,0:06:52.62,Caption,,0,0,0,,ССЫЛАЕТСЯ НА РАНЕЕ ПРЕДЛОЖЕННЫЕ КОМПРОМИССЫ И НЕ
Dialogue: 0,0:06:52.62,0:06:55.18,Caption,,0,0,0,,СОБИРАЕТСЯ ПЕРЕСМАТРИВАТЬ ИХ ТОЛЬКО РАДИ КРАСИВОЙ
Dialogue: 0,0:06:55.18,0:06:58.46,Caption,,0,0,0,,ФОТОГРАФИИ ВСТРЕЧИ. УКРАИНА ДОБИВАЕТСЯ ПРЕКРАЩЕНИЯ
Dialogue: 0,0:06:58.54,0:07:02.06,Caption,,0,0,0,,ОГНЯ, ОДНОВРЕМЕННО ГОТОВЯ РЕЗКОЕ НАРАЩИВАНИЕ ДАЛЬНОБОЙНЫХ
Dialogue: 0,0:07:02.06,0:07:05.18,Caption,,0,0,0,,УДАРНЫХ СРЕДСТВ. ФРАНЦИЯ ВОЗВРАЩАЕТ ВОПРОС НАТО,
Dialogue: 0,0:07:05.34,0:07:08.62,Caption,,0,0,0,,ЗАРАНЕЕ ЗНАЯ РОССИЙСКИЙ ОТВЕТ. ПОСЛЕ ЭТОГО УЧАСТНИКИ
Dialogue: 0,0:07:08.62,0:07:13.42,Caption,,0,0,0,,РАЗВОДЯТ РУКАМИ И СООБЩАЮТ, ЧТО ПРОДВИЖЕНИЕ ОПЯТЬ ОКАЗАЛОСЬ ТРУДНЫМ. КАКАЯ
Dialogue: 0,0:07:13.42,0:07:16.38,Caption,,0,0,0,,НЕОЖИДАННОСТЬ. ВСЕ ПРИНЕСЛИ СОБСТВЕННЫЕ ЗАМКИ,
Dialogue: 0,0:07:16.62,0:07:18.94,Caption,,0,0,0,,А КЛЮЧ ПОЧЕМУ ТО ИЩУТ ОДИН НА ВСЕХ.
Dialogue: 0,0:07:19.48,0:07:21.82,Caption,,0,0,0,,НА ТОЙ ЖЕ СЦЕНЕ ПОЯВЛЯЕТСЯ КАЯ КАЛЛАС С
Dialogue: 0,0:07:21.82,0:07:24.46,Caption,,0,0,0,,РАССКАЗОМ О МЕЖДУНАРОДНОЙ ИЗОЛЯЦИИ РОССИИ.
Dialogue: 0,0:07:26.73,0:07:28.50,Caption,,0,0,0,,СУДЯ ПО ОПУБЛИКОВАННЫМ КАДРАМ,
Dialogue: 0,0:07:28.74,0:07:30.58,Caption,,0,0,0,,СЛУШАТЕЛЕЙ В ЗАЛЕ БЫЛО СТОЛЬКО,
Dialogue: 0,0:07:30.81,0:07:33.86,Caption,,0,0,0,,ЧТО КАЖДОМУ МОЖНО БЫЛО ВЫДЕЛИТЬ ОТДЕЛЬНЫЙ СЕКТОР И
Dialogue: 0,0:07:33.86,0:07:35.94,Caption,,0,0,0,,ЕЩЁ ОСТАВИТЬ МЕСТО ДЛЯ ВЕРХНЕЙ ОДЕЖДЫ.
Dialogue: 0,0:07:36.50,0:07:39.78,Caption,,0,0,0,,СЮЖЕТ ВЫШЕЛ ВЫРАЗИТЕЛЬНЫЙ. РАССКАЗЫВАЕШЬ ОБ ИЗОЛЯЦИИ
Dialogue: 0,0:07:39.78,0:07:43.94,Caption,,0,0,0,,ОГРОМНОЙ СТРАНЫ, А ТВОЯ РЕЧЬ ПУТЕШЕСТВУЕТ МЕЖДУ ПУСТЫМИ КРЕСЛАМИ И
Dialogue: 0,0:07:43.94,0:07:46.58,Caption,,0,0,0,,ВОЗВРАЩАЕТСЯ ЭХОМ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:07:46.82,0:07:49.30,Caption,,0,0,0,,И ЭХО ТОЖЕ ПОПРОСЯТ ПОДТВЕРДИТЬ ПРИСУТСТВИЕ.
Dialogue: 0,0:07:49.59,0:07:52.74,Caption,,0,0,0,,ПУСТУЮЩИЕ МЕСТА НЕ ОТМЕНЯЮТ ЕВРОПЕЙСКИХ САНКЦИЙ,
Dialogue: 0,0:07:52.85,0:07:56.58,Caption,,0,0,0,,ДАВЛЕНИЯ И ПОЗИЦИИ БРЮССЕЛЯ. ОНИ ПОКАЗЫВАЮТ ДРУГОЕ
Dialogue: 0,0:07:56.60,0:07:59.94,Caption,,0,0,0,,ТОРЖЕСТВЕННОСТЬ ЗАЯВЛЕНИЯ И ИНТЕРЕС АУДИТОРИИ МОГУТ
Dialogue: 0,0:07:59.94,0:08:03.06,Caption,,0,0,0,,СУЩЕСТВОВАТЬ В СОВЕРШЕННО РАЗНЫХ ПОМЕЩЕНИЯХ. ЭТОТ
Dialogue: 0,0:08:03.14,0:08:06.50,Caption,,0,0,0,,РАЗРЫВ ВСЁ ТОЧНЕЕ ОПИСЫВАЕТ ПРОИСХОДЯЩЕЕ. РОССИЯ
Dialogue: 0,0:08:06.58,0:08:09.78,Caption,,0,0,0,,ПОСЛЕ НОВОГО ОБОСТРЕНИЯ УБИРАЕТ ЧАСТЬ ПРОМЕЖУТОЧНЫХ
Dialogue: 0,0:08:09.78,0:08:12.66,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ. УКРАИНА ВКЛАДЫВАЕТ БОЛЬШУЮ ДОЛЮ
Dialogue: 0,0:08:12.66,0:08:15.30,Caption,,0,0,0,,ИНОСТРАННОГО ФИНАНСИРОВАНИЯ В БЕСПИЛОТНЫЕ СИСТЕМЫ
Dialogue: 0,0:08:15.30,0:08:17.94,Caption,,0,0,0,,БУДУЩЕГО ГОДА. МОСКВА НАНОСИТ УДАРЫ ПО
Dialogue: 0,0:08:17.94,0:08:21.86,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ, НЕОБХОДИМОЙ ДЛЯ ТАКОГО ПРОИЗВОДСТВА. МАКРОН
Dialogue: 0,0:08:22.02,0:08:24.82,Caption,,0,0,0,,ВОЗВРАЩАЕТ В ОБСУЖДЕНИЕ ВСТУПЛЕНИЕ УКРАИНЫ В НАТО.
Dialogue: 0,0:08:25.22,0:08:28.10,Caption,,0,0,0,,ПРИ ЭТОМ КАЖДЫЙ УЧАСТНИК СПОСОБЕН ЧЕСТНО ЗАЯВИТЬ О
Dialogue: 0,0:08:28.10,0:08:31.30,Caption,,0,0,0,,СТРЕМЛЕНИИ К МИРУ. НИКАКОГО ЛОГИЧЕСКОГО ЧУДА ЗДЕСЬ
Dialogue: 0,0:08:31.30,0:08:34.74,Caption,,0,0,0,,НЕТ. МИР ВООБЩЕ И МИР ИСКЛЮЧИТЕЛЬНО НА СОБСТВЕННЫХ
Dialogue: 0,0:08:34.82,0:08:37.70,Caption,,0,0,0,,УСЛОВИЯХ ОТЛИЧАЮТСЯ ПРИМЕРНО КАК БЕСПЛАТНЫЙ ПОДАРОК
Dialogue: 0,0:08:37.78,0:08:41.30,Caption,,0,0,0,,И СЧЁТ, КОТОРЫЙ К НЕМУ ПРИЛАГАЕТСЯ МЕЛКИМ ШРИФТОМ. МОЯ
Dialogue: 0,0:08:41.38,0:08:42.98,Caption,,0,0,0,,ВЕРСИЯ ЗАКЛЮЧАЕТСЯ В СЛЕДУЮЩЕМ.
Dialogue: 0,0:08:45.18,0:08:48.06,Caption,,0,0,0,,ЗНАЧИТЕЛЬНАЯ ЧАСТЬ НЫНЕШНИХ РАЗГОВОРОВ НУЖНА НЕ ДЛЯ
Dialogue: 0,0:08:48.06,0:08:49.98,Caption,,0,0,0,,БЫСТРОГО ЗАВЕРШЕНИЯ КОНФЛИКТА,
Dialogue: 0,0:08:50.29,0:08:53.18,Caption,,0,0,0,,А ДЛЯ ПОДГОТОВКИ БОЛЕЕ ВЫГОДНОЙ ПОЗИЦИИ ПЕРЕД
Dialogue: 0,0:08:53.18,0:08:55.90,Caption,,0,0,0,,ОЧЕРЕДНЫМ ЭТАПОМ. СТОРОНЫ ВЫЯСНЯЮТ,
Dialogue: 0,0:08:56.13,0:08:58.78,Caption,,0,0,0,,С КАКИМИ ВОЕННЫМИ ВОЗМОЖНОСТЯМИ ОНИ ПОДОЙДУТ К
Dialogue: 0,0:08:58.78,0:09:01.74,Caption,,0,0,0,,СЛЕДУЮЩЕЙ ВСТРЕЧЕ. КАКИЕ ТРЕБОВАНИЯ УДАСТСЯ
Dialogue: 0,0:09:01.74,0:09:05.66,Caption,,0,0,0,,СОХРАНИТЬ. КАКИЕ ПУНКТЫ СТАНУТ ПРЕДМЕТОМ ОБМЕНА. КТО
Dialogue: 0,0:09:05.74,0:09:08.86,Caption,,0,0,0,,СМОЖЕТ НАЗВАТЬ СВОИ УСЛОВИЯ ПРИНЦИПИАЛЬНЫМИ. И КОМУ
Dialogue: 0,0:09:08.86,0:09:12.14,Caption,,0,0,0,,ДОСТАНЕТСЯ ПРАВО ПЕРВЫМ ОБВИНИТЬ ПРОТИВНИКА В СРЫВЕ
Dialogue: 0,0:09:12.14,0:09:14.94,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ. ВОЕННОЕ ПРЕИМУЩЕСТВО,
Dialogue: 0,0:09:15.11,0:09:17.90,Caption,,0,0,0,,ПРОИЗВОДСТВЕННЫЕ МОЩНОСТИ И ДОСТУП К ДЕНЬГАМ
Dialogue: 0,0:09:18.10,0:09:21.18,Caption,,0,0,0,,УМЕНЬШАЮТ ЖЕЛАНИЕ ТОРОПИТЬСЯ С УСТУПКАМИ. ПОЭТОМУ
Dialogue: 0,0:09:21.18,0:09:24.06,Caption,,0,0,0,,ПЕРЕГОВОРЫ НЕЛЬЗЯ ОТДЕЛИТЬ ОТ УДАРОВ И ОБОРОННЫХ
Dialogue: 0,0:09:24.06,0:09:27.66,Caption,,0,0,0,,ПРОГРАММ. ВОЗВРАЩЕНИЕ ТЕМЫ НАТО РАСШИРЯЕТ ПЕРЕЧЕНЬ
Dialogue: 0,0:09:27.66,0:09:31.50,Caption,,0,0,0,,ТРЕБОВАНИЙ, КОТОРЫМИ ПОЗЖЕ СТАНУТ ОБМЕНИВАТЬСЯ. ВОТ ПОЧЕМУ РЕЧИ
Dialogue: 0,0:09:31.50,0:09:34.14,Caption,,0,0,0,,О ЗАВЕРШЕНИИ БОЕВЫХ ДЕЙСТВИЙ ЗВУЧАТ ОДНОВРЕМЕННО С
Dialogue: 0,0:09:34.22,0:09:38.86,Caption,,0,0,0,,ПЛАНАМИ ВЫПУСКА ОРУЖИЯ, АТАКАМИ НА ИНФРАСТРУКТУРУ И ПОВЫШЕНИЕМ СТАВОК.
Dialogue: 0,0:09:39.20,0:09:41.98,Caption,,0,0,0,,ПОЛИТИКАМ ДАЖЕ НЕ ОБЯЗАТЕЛЬНО ОБМАНЫВАТЬ СЛУШАТЕЛЕЙ,
Dialogue: 0,0:09:42.22,0:09:45.18,Caption,,0,0,0,,КОГДА ОНИ ГОВОРЯТ О МИРЕ. КАЖДЫЙ ДЕЙСТВИТЕЛЬНО ХОЧЕТ
Dialogue: 0,0:09:45.18,0:09:47.74,Caption,,0,0,0,,ЗАФИКСИРОВАТЬ МИР. ТОЛЬКО СНАЧАЛА ОН НАМЕРЕН
Dialogue: 0,0:09:47.74,0:09:49.82,Caption,,0,0,0,,ПЕРЕДВИНУТЬ РЕАЛЬНОСТЬ В СВОЮ СТОРОНУ,
Dialogue: 0,0:09:50.06,0:09:52.86,Caption,,0,0,0,,А УЖЕ ЗАТЕМ ПРЕДЛОЖИТЬ ОСТАЛЬНЫМ ПОСТАВИТЬ ПОДПИСИ.
Dialogue: 0,0:09:53.17,0:09:55.66,Caption,,0,0,0,,ГЛАВНЫЕ СИГНАЛЫ СЕЙЧАС ПРИХОДЯТ НЕ С ТРИБУН,
Dialogue: 0,0:09:55.82,0:09:58.38,Caption,,0,0,0,,ГДЕ ОЧЕРЕДНОЙ РУКОВОДИТЕЛЬ УВЕРЯЕТ ВСЕХ В ДОБРЫХ
Dialogue: 0,0:09:58.38,0:10:03.30,Caption,,0,0,0,,НАМЕРЕНИЯХ. ОНИ НАХОДЯТСЯ В РАСПРЕДЕЛЕНИИ ДЕНЕГ,
Dialogue: 0,0:10:03.46,0:10:06.26,Caption,,0,0,0,,ЗАВОДСКИХ ЗАКАЗАХ, ДОГОВОРАХ НА ПОСТАВКИ,
Dialogue: 0,0:10:06.54,0:10:11.70,Caption,,0,0,0,,ПЕРЕЧНЯХ ЦЕЛЕЙ И ТРЕБОВАНИЯХ, КОТОРЫЕ СНОВА ДОСТАЮТ ПЕРЕД НОВЫМ РАУНДОМ. РЕЧЬ
Dialogue: 0,0:10:11.70,0:10:14.74,Caption,,0,0,0,,МОЖНО ЗАМЕНИТЬ ДО ВЕЧЕРНЕГО ВЫПУСКА НОВОСТЕЙ. А
Dialogue: 0,0:10:14.74,0:10:16.82,Caption,,0,0,0,,ЗАВОД, РАССЧИТАННЫЙ НА СЛЕДУЮЩИЙ ГОД,
Dialogue: 0,0:10:17.22,0:10:20.82,Caption,,0,0,0,,ЗА ОДИН ВЕЧЕР НИ ПОСТРОИТЬ, НИ ОТМЕНИТЬ НЕ ПОЛУЧИТСЯ.
