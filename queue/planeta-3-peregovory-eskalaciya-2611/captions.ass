Dialogue: 0,0:00:00.12,0:00:01.91,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СНОВА НАЗВАЛ УСЛОВИЕ
Dialogue: 0,0:00:01.91,0:00:05.22,Caption,,0,0,0,,ПОРАЖЕНИЯ УКРАИНЫ ДОБРОВОЛЬНЫЙ УХОД ИЗ ДОНБАССА. С ЭТОЙ
Dialogue: 0,0:00:05.22,0:00:08.28,Caption,,0,0,0,,ЧАСТЬЮ У НЕГО ВСЁ ЧЁТКО. НО У ЛЮБОЙ ЗАДАЧИ ЕСТЬ
Dialogue: 0,0:00:08.28,0:00:10.30,Caption,,0,0,0,,ВТОРАЯ ПОЛОВИНА. ЧТО В ТАКОМ СЛУЧАЕ
Dialogue: 0,0:00:10.30,0:00:13.32,Caption,,0,0,0,,БУДЕТ СЧИТАТЬСЯ ПОБЕДОЙ? ВОЛОДИМИР АЛЕКСАНДРОВИЧ,
Dialogue: 0,0:00:13.46,0:00:15.79,Caption,,0,0,0,,ОГЛАСИТЕ ВЕСЬ СПИСОК. ВОЙНА ИДЁТ ПЯТЫЙ
Dialogue: 0,0:00:15.79,0:00:18.19,Caption,,0,0,0,,ГОД, А ФИНИШНУЮ ЧЕРТУ ДО СИХ ПОР БУДТО
Dialogue: 0,0:00:18.19,0:00:20.95,Caption,,0,0,0,,РИСУЮТ ИСЧЕЗАЮЩИМИ ЧЕРНИЛАМИ. ДАЖЕ АМЕРИКАНЦЫ
Dialogue: 0,0:00:20.95,0:00:24.45,Caption,,0,0,0,,УЖЕ НЕ МОГУТ ПОНЯТЬ, ГДЕ ОНА ПРОХОДИТ И СУЩЕСТВУЕТ ЛИ
Dialogue: 0,0:00:24.45,0:00:27.67,Caption,,0,0,0,,ВООБЩЕ. ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ ОТДЕЛЬНЫЕ
Dialogue: 0,0:00:27.67,0:00:30.92,Caption,,0,0,0,,ГРОМКИЕ РЕПЛИКИ, А ТО, ВО ЧТО ОНИ СКЛАДЫВАЮТСЯ,
Dialogue: 0,0:00:31.08,0:00:33.96,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ ЗАЯВЛЕНИЯ КИЕВА,
Dialogue: 0,0:00:34.05,0:00:37.59,Caption,,0,0,0,,МОСКВЫ, ВАШИНГТОНА И МИНСКА ОБРАЗОВАЛИ ТАКУЮ
Dialogue: 0,0:00:37.59,0:00:40.85,Caption,,0,0,0,,КОМПОЗИЦИЮ, ЧТО ЛЮБОЙ СЕМЕЙНЫЙ СКАНДАЛ РЯДОМ С НЕЙ
Dialogue: 0,0:00:40.85,0:00:43.45,Caption,,0,0,0,,ВЫГЛЯДИТ ОБРАЗЦОМ ВЗАИМОПОНИМАНИЯ. КУШНЕР В
Dialogue: 0,0:00:43.45,0:00:46.51,Caption,,0,0,0,,БЕСЕДЕ С NEW YORK MAGAZINE ОПИСАЛ ЦЕЛЬ ПЕРЕГОВОРОВ
Dialogue: 0,0:00:46.51,0:00:49.26,Caption,,0,0,0,,СОВСЕМ НЕ КАК КОРОТКУЮ ПАУЗУ ПЕРЕД СЛЕДУЮЩИМ
Dialogue: 0,0:00:49.26,0:00:52.26,Caption,,0,0,0,,РАУНДОМ. ЕМУ НЕДОСТАТОЧНО ПРЕКРАЩЕНИЯ ОГНЯ. ОН
Dialogue: 0,0:00:52.26,0:00:54.57,Caption,,0,0,0,,ХОЧЕТ ПЕРЕЗАПУСТИТЬ ОТНОШЕНИЯ РОССИИ И
Dialogue: 0,0:00:54.57,0:00:57.49,Caption,,0,0,0,,ЕВРОПЫ, УБРАТЬ ПОСТОЯННОЕ ПРОТИВОСТОЯНИЕ И
Dialogue: 0,0:00:57.49,0:01:00.04,Caption,,0,0,0,,ВЕРНУТЬ ЛЮДЯМ ВОЗМОЖНОСТЬ НОРМАЛЬНО ЖИТЬ,
Dialogue: 0,0:01:00.20,0:01:02.42,Caption,,0,0,0,,ТОРГОВАТЬ И ЗАНИМАТЬСЯ ДЕЛАМИ БЕЗ
Dialogue: 0,0:01:02.42,0:01:05.48,Caption,,0,0,0,,ЕЖЕДНЕВНОГО ОЖИДАНИЯ НОВОЙ БЕДЫ. ДЛЯ ЗЕЛЕНСКОГО В
Dialogue: 0,0:01:05.48,0:01:08.22,Caption,,0,0,0,,ЭТОМ ЗАМЫСЛЕ ПРЕДУСМОТРЕНА ИНАЯ РАБОТА. ЕМУ
Dialogue: 0,0:01:08.22,0:01:10.12,Caption,,0,0,0,,ПРЕДЛАГАЮТ ЗАКОНЧИТЬ КОНФЛИКТ,
Dialogue: 0,0:01:10.44,0:01:12.36,Caption,,0,0,0,,ДОБИТЬСЯ ГАРАНТИЙ БЕЗОПАСНОСТИ И
Dialogue: 0,0:01:12.36,0:01:14.20,Caption,,0,0,0,,ЗАНЯТЬСЯ ВОССТАНОВЛЕНИЕМ ЭКОНОМИКИ.
Dialogue: 0,0:01:16.47,0:01:19.76,Caption,,0,0,0,,ВМЕСТО ПРЕЗИДЕНТА, КОТОРЫЙ ВСЁ ВРЕМЯ ТРЕБУЕТ НОВЫЕ РАКЕТЫ
Dialogue: 0,0:01:19.76,0:01:22.32,Caption,,0,0,0,,И ПОПОЛНЕНИЕ АРМИИ, СТАТЬ ПРЕЗИДЕНТОМ,
Dialogue: 0,0:01:22.54,0:01:24.48,Caption,,0,0,0,,ПРИ КОТОРОМ СТРАНА ЧИНИТ ГОРОДА,
Dialogue: 0,0:01:24.56,0:01:28.88,Caption,,0,0,0,,ПРЕДПРИЯТИЯ И ЭНЕРГЕТИКУ. РОЛЬ МЕНЕЕ ГЕРОИЧЕСКАЯ НА ПЛАКАТЕ,
Dialogue: 0,0:01:29.19,0:01:31.31,Caption,,0,0,0,,ЗАТО ЗНАЧИТЕЛЬНО ПОЛЕЗНЕЕ ЗА ОКНОМ.
Dialogue: 0,0:01:31.31,0:01:33.68,Caption,,0,0,0,,ТОЛЬКО ЕВРОПЕЙСКИЕ ПАРТНЁРЫ, ПОХОЖЕ,
Dialogue: 0,0:01:33.92,0:01:35.71,Caption,,0,0,0,,ЭТОТ СЦЕНАРИЙ ПОЛУЧИЛИ В ДРУГОМ
Dialogue: 0,0:01:35.71,0:01:38.94,Caption,,0,0,0,,КОНВЕРТЕ. КУШНЕР РАССУЖДАЕТ О НОРМАЛИЗАЦИИ ОТНОШЕНИЙ С
Dialogue: 0,0:01:38.94,0:01:42.21,Caption,,0,0,0,,РОССИЕЙ, А ЕВРОПА ОБСУЖДАЕТ ОЧЕРЕДНЫЕ САНКЦИИ И
Dialogue: 0,0:01:42.21,0:01:45.04,Caption,,0,0,0,,РАСШИРЯЕТ ВОЕННУЮ ПОДДЕРЖКУ КИЕВА. ЗЕЛЕНСКИЙ
Dialogue: 0,0:01:45.04,0:01:48.56,Caption,,0,0,0,,ВДОБАВОК УВЕРЯЕТ, ЧТО РОССИЯ НЕ СТАНЕТ БЕЗОПАСНОЙ НИ
Dialogue: 0,0:01:48.56,0:01:53.16,Caption,,0,0,0,,ЧЕРЕЗ ГОД, НИ ЧЕРЕЗ ПЯТЬ ЛЕТ. В ИТОГЕ ОДИН УЧАСТНИК УЖЕ ЗАКАЗЫВАЕТ
Dialogue: 0,0:01:53.16,0:01:56.00,Caption,,0,0,0,,СТОЛ ДЛЯ РАЗГОВОРА, ДРУГОЙ ЗАКОЛАЧИВАЕТ ДВЕРЬ,
Dialogue: 0,0:01:56.16,0:01:58.70,Caption,,0,0,0,,ТРЕТИЙ ПОДВОЗИТ БОЕПРИПАСЫ. ПОТОМ ВСЕ
Dialogue: 0,0:01:58.70,0:02:02.69,Caption,,0,0,0,,ТРОЕ СЕРЬЁЗНО ЗАЯВЛЯЮТ, ЧТО ТРУДЯТСЯ РАДИ МИРА. РАБОТАЮТ
Dialogue: 0,0:02:02.69,0:02:05.58,Caption,,0,0,0,,ДРУЖНО, ПРОСТО КАЖДЫЙ СТРОИТ СОВЕРШЕННО РАЗНОЕ
Dialogue: 0,0:02:05.58,0:02:08.51,Caption,,0,0,0,,ЗДАНИЕ. КУШНЕРА РАЗДРАЖАЕТ И ПРИВЫЧКА КИЕВА
Dialogue: 0,0:02:08.51,0:02:11.57,Caption,,0,0,0,,ВЕСТИ ПЕРЕГОВОРЫ ЧЕРЕЗ ПУБЛИКУ. ПО ВЕРСИИ NEW YORK
Dialogue: 0,0:02:11.57,0:02:14.57,Caption,,0,0,0,,MAGAZINE, ОН СЧИТАЕТ ТАКУЮ МАНЕРУ ВРЕДНОЙ. ЕЩЁ
Dialogue: 0,0:02:14.57,0:02:16.72,Caption,,0,0,0,,НЕ УСПЕЛИ УЧАСТНИКИ ОБСУДИТЬ УСЛОВИЯ,
Dialogue: 0,0:02:16.95,0:02:18.80,Caption,,0,0,0,,А ПОДРОБНОСТИ УЖЕ ВЫНОСЯТ НАРУЖУ,
Dialogue: 0,0:02:19.05,0:02:23.31,Caption,,0,0,0,,ПОСЛЕ ЧЕГО НАЧИНАЮТСЯ ОБИДЫ, ОБВИНЕНИЯ И СОРЕВНОВАНИЕ ЗА ЗВАНИЕ
Dialogue: 0,0:02:23.31,0:02:25.84,Caption,,0,0,0,,ЕДИНСТВЕННОГО ЧЕСТНОГО ЧЕЛОВЕКА В КОМНАТЕ.
Dialogue: 0,0:02:25.84,0:02:29.36,Caption,,0,0,0,,ДОГОВОРЁННОСТЬ В ТАКОЙ ОБСТАНОВКЕ НАПОМИНАЕТ СЕМЕЙНЫЙ БЮДЖЕТ,
Dialogue: 0,0:02:29.45,0:02:31.31,Caption,,0,0,0,,КОТОРЫЙ РЕШИЛИ СОСТАВЛЯТЬ В ПРЯМОМ
Dialogue: 0,0:02:31.31,0:02:36.76,Caption,,0,0,0,,ЭФИРЕ ПЕРЕД СОСЕДЯМИ. ВО ВРЕМЯ ВСТРЕЧИ В МАЙАМИ КУШНЕР,
Dialogue: 0,0:02:36.92,0:02:40.18,Caption,,0,0,0,,КАК УТВЕРЖДАЕТ ЖУРНАЛ, РАССКАЗАЛ УКРАИНСКОЙ ДЕЛЕГАЦИИ О
Dialogue: 0,0:02:40.18,0:02:43.75,Caption,,0,0,0,,НАМЕРЕНИИ ТРАМПА ПРИНЯТЬ ПРЕДЛОЖЕНИЕ ПУТИНА. РЕЧЬ ШЛА О
Dialogue: 0,0:02:43.75,0:02:46.27,Caption,,0,0,0,,ПОСТАВКАХ РОССИЙСКОГО ДИЗЕЛЬНОГО ТОПЛИВА В
Dialogue: 0,0:02:46.27,0:02:49.08,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ В ОБМЕН НА ОСЛАБЛЕНИЕ САНКЦИЙ.
Dialogue: 0,0:02:49.64,0:02:51.96,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ВОСПРИНЯЛ ЭТО КАК НЕСПРАВЕДЛИВОСТЬ ПО
Dialogue: 0,0:02:51.96,0:02:55.56,Caption,,0,0,0,,ОТНОШЕНИЮ К СЕБЕ. КУШНЕР ЕМУ, СУДЯ ПО ПУБЛИКАЦИИ,
Dialogue: 0,0:02:55.74,0:02:57.46,Caption,,0,0,0,,ПО ЧЕЛОВЕЧЕСКИ СОЧУВСТВУЕТ. НО
Dialogue: 0,0:02:57.46,0:03:00.95,Caption,,0,0,0,,СОЧУВСТВИЕ НЕ ОЗНАЧАЕТ, ЧТО ОСТАЛЬНЫМ ТЕПЕРЬ НАДО ОТМЕНИТЬ
Dialogue: 0,0:03:00.95,0:03:04.28,Caption,,0,0,0,,СВОИ ИНТЕРЕСЫ И ЖДАТЬ, ПОКА КИЕВ ПЕРЕСТАНЕТ ВОЗМУЩАТЬСЯ.
Dialogue: 0,0:03:05.16,0:03:07.64,Caption,,0,0,0,,ВАШИНГТОН ДО ЭТОГО ПЫТАЛСЯ ЗАИНТЕРЕСОВАТЬ МОСКВУ
Dialogue: 0,0:03:07.64,0:03:10.68,Caption,,0,0,0,,ЭКОНОМИЧЕСКИМИ ПРЕДЛОЖЕНИЯМИ. FINANCIAL TIMES ПИШЕТ
Dialogue: 0,0:03:10.76,0:03:12.84,Caption,,0,0,0,,О ПРОЕКТАХ В ЭНЕРГЕТИКЕ И АВИАЦИИ,
Dialogue: 0,0:03:13.00,0:03:14.82,Caption,,0,0,0,,КОТОРЫЕ АМЕРИКАНЦЫ ПОДАВАЛИ КАК
Dialogue: 0,0:03:14.82,0:03:17.92,Caption,,0,0,0,,ВЫГОДНЫЙ ПОВОД ИЗМЕНИТЬ РОССИЙСКУЮ ПОЗИЦИЮ. МОСКВА НЕ
Dialogue: 0,0:03:17.92,0:03:20.49,Caption,,0,0,0,,ВПЕЧАТЛИЛАСЬ. ПОСЛЕ ПЕРЕГОВОРОВ В АБУ ДАБИ
Dialogue: 0,0:03:20.49,0:03:23.65,Caption,,0,0,0,,АМЕРИКАНСКАЯ СТОРОНА ПЕРЕКЛЮЧИЛАСЬ НА ТЕРРИТОРИИ И ГАРАНТИИ
Dialogue: 0,0:03:23.65,0:03:26.71,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ХОТЯ ПЛАНЫ БУДУЩЕГО СОТРУДНИЧЕСТВА С
Dialogue: 0,0:03:26.71,0:03:28.28,Caption,,0,0,0,,РОССИЕЙ ИЗ ПАПКИ НЕ ВЫБРОСИЛА.
Dialogue: 0,0:03:28.84,0:03:31.09,Caption,,0,0,0,,АМЕРИКАНСКИЙ ПОДХОД ПОНЯТЕН. НАЗВАТЬ
Dialogue: 0,0:03:31.09,0:03:34.44,Caption,,0,0,0,,ЦЕНУ, ДОБАВИТЬ РЫНОК, ПРЕДЛОЖИТЬ КОНТРАКТ И ЖДАТЬ,
Dialogue: 0,0:03:34.52,0:03:36.71,Caption,,0,0,0,,КОГДА СОБЕСЕДНИК ПОТЯНЕТСЯ ЗА РУЧКОЙ.
Dialogue: 0,0:03:36.71,0:03:39.38,Caption,,0,0,0,,ТОЛЬКО ДАЛЕКО НЕ ВСЁ ПРОДАЁТСЯ КОМПЛЕКТОМ С
Dialogue: 0,0:03:39.38,0:03:41.32,Caption,,0,0,0,,ГАРАНТИЕЙ И БЕСПЛАТНОЙ ДОСТАВКОЙ.
Dialogue: 0,0:03:43.60,0:03:45.44,Caption,,0,0,0,,РОССИЯ СМОТРИТ НА БЕЗОПАСНОСТЬ,
Dialogue: 0,0:03:45.60,0:03:49.12,Caption,,0,0,0,,ТЕРРИТОРИИ, СОСЕДЕЙ И СВОЁ ПОЛОЖЕНИЕ В МИРЕ НЕ КАК
Dialogue: 0,0:03:49.20,0:03:52.33,Caption,,0,0,0,,НА ВИТРИНУ, ГДЕ ВОПРОС УПИРАЕТСЯ В РАЗМЕР СКИДКИ.
Dialogue: 0,0:03:52.33,0:03:55.87,Caption,,0,0,0,,ОНИ ПРИВЫКЛИ СЧИТАТЬ ДОЛЛАРЫ, А ЗДЕСЬ СЧИТАЮТ ПОСЛЕДСТВИЯ НА
Dialogue: 0,0:03:55.87,0:03:58.76,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯ. В ИНТЕРВЬЮ BLOOMBERG ЗЕЛЕНСКИЙ
Dialogue: 0,0:03:58.76,0:04:01.52,Caption,,0,0,0,,РАССКАЗАЛ, ЧТО ТРАМП ПОДГОНЯЕТ ЕГО С СОГЛАШЕНИЕМ
Dialogue: 0,0:04:01.52,0:04:03.68,Caption,,0,0,0,,И ХОЧЕТ ЗАВЕРШИТЬ КОНФЛИКТ ДО ЯНВАРЯ.
Dialogue: 0,0:04:04.24,0:04:06.43,Caption,,0,0,0,,КИЕВ ОТВЕЧАЕТ ПРИВЫЧНОЙ ФОРМУЛОЙ МИР
Dialogue: 0,0:04:06.43,0:04:08.98,Caption,,0,0,0,,НУЖЕН, НО НЕ ЦЕНОЙ ОДНОЙ УКРАИНЫ. СЛЕДОМ
Dialogue: 0,0:04:08.98,0:04:11.52,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОБВИНЯЕТ СОЕДИНЁННЫЕ ШТАТЫ В ТОМ,
Dialogue: 0,0:04:11.68,0:04:13.82,Caption,,0,0,0,,ЧТО ОНИ ПОСТАВИЛИ СЕБЯ В НЕУДОБНОЕ
Dialogue: 0,0:04:13.82,0:04:17.52,Caption,,0,0,0,,ПОЛОЖЕНИЕ. ПО ЕГО СЛОВАМ, ДЕЙСТВИЯ ВАШИНГТОНА ВЫГЛЯДЯТ ТАК,
Dialogue: 0,0:04:17.84,0:04:19.76,Caption,,0,0,0,,БУДТО ОН ДВИЖЕТСЯ В ОДНУ СТОРОНУ С
Dialogue: 0,0:04:19.76,0:04:22.43,Caption,,0,0,0,,ПУТИНЫМ И ВЫНУЖДАЕТ УКРАИНУ КАПИТУЛИРОВАТЬ.
Dialogue: 0,0:04:22.43,0:04:25.33,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ БЛАГОДАРНОСТЬ. АМЕРИКА
Dialogue: 0,0:04:25.33,0:04:29.49,Caption,,0,0,0,,ГОДАМИ ДАВАЛА ДЕНЬГИ, ОРУЖИЕ, РАЗВЕДДАННЫЕ И ПРИКРЫТИЕ НА
Dialogue: 0,0:04:29.49,0:04:32.72,Caption,,0,0,0,,МЕЖДУНАРОДНОЙ СЦЕНЕ. НО СТОИЛО ЕЙ ПОТРЕБОВАТЬ РЕЗУЛЬТАТ,
Dialogue: 0,0:04:32.87,0:04:36.48,Caption,,0,0,0,,КОТОРЫЙ КИЕВУ НЕ НРАВИТСЯ, КАК ОНА НЕМЕДЛЕННО ОКАЗАЛАСЬ ПОЧТИ В
Dialogue: 0,0:04:36.48,0:04:38.48,Caption,,0,0,0,,ОДНОМ РЯДУ С МОСКВОЙ. НЕ ВРАГ,
Dialogue: 0,0:04:38.56,0:04:41.52,Caption,,0,0,0,,КОНЕЧНО, НО УЖЕ ПОДОЗРИТЕЛЬНО ПЛОХО ВЫПОЛНЯЕТ
Dialogue: 0,0:04:41.52,0:04:44.32,Caption,,0,0,0,,ОБЯЗАННОСТИ ЛУЧШЕГО ДРУГА. ТАКОЙ ДРУГ ХОРОШ,
Dialogue: 0,0:04:44.56,0:04:46.80,Caption,,0,0,0,,ПОКА ОПЛАЧИВАЕТ БАНКЕТ И НЕ СПРАШИВАЕТ,
Dialogue: 0,0:04:47.04,0:04:50.48,Caption,,0,0,0,,КОГДА ПРИНЕСУТ СЧЁТ. РАСЧЁТ КИЕВА ПРИ ЭТОМ ИЗЛОЖЕН БЕЗ
Dialogue: 0,0:04:50.48,0:04:52.96,Caption,,0,0,0,,ОСОБОЙ ЗАГАДКИ. НУЖНО ОБЕСПЕЧИТЬ УКРАИНСКИЕ
Dialogue: 0,0:04:52.96,0:04:54.64,Caption,,0,0,0,,ПОТРЕБНОСТИ ХОТЯ БЫ НА ДЕКАБРЬ,
Dialogue: 0,0:04:54.88,0:04:56.80,Caption,,0,0,0,,А ЗАТЕМ ПОЯВИТСЯ НОВЫЙ КОНГРЕСС.
Dialogue: 0,0:04:59.06,0:05:00.88,Caption,,0,0,0,,С НИМ ЗЕЛЕНСКИЙ РАССЧИТЫВАЕТ НАЙТИ
Dialogue: 0,0:05:00.88,0:05:02.82,Caption,,0,0,0,,ДРУГОЙ ПОДХОД. ЗЕЛЕНСКИЙ СЕТУЕТ,
Dialogue: 0,0:05:03.01,0:05:05.30,Caption,,0,0,0,,ЧТО ПИТ ХЕГСЕТ ДО СИХ ПОР НЕ РАЗРЕШИЛ
Dialogue: 0,0:05:05.30,0:05:07.53,Caption,,0,0,0,,ПЕРЕДАТЬ УКРАИНЕ СОРОК ВОСЕМЬ РАКЕТ
Dialogue: 0,0:05:07.53,0:05:10.93,Caption,,0,0,0,,ДЛЯ КОМПЛЕКСОВ PATRIOT. РАНЕЕ FINANCIAL TIMES И
Dialogue: 0,0:05:10.93,0:05:14.95,Caption,,0,0,0,,REUTERS СООБЩАЛИ О ШЕСТИДЕСЯТИ ЗАВИСШИХ РАКЕТАХ. ДОСТУП К
Dialogue: 0,0:05:14.95,0:05:17.46,Caption,,0,0,0,,STARSHIELD, ПО СЛОВАМ УКРАИНСКОГО ПРЕЗИДЕНТА,
Dialogue: 0,0:05:17.72,0:05:19.80,Caption,,0,0,0,,ТОЖЕ ОСТАЁТСЯ ОГРАНИЧЕННЫМ. ЗАТО
Dialogue: 0,0:05:19.80,0:05:23.26,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ОДОБРИЛИ ПРОДАЖУ КИЕВУ ПЯТИСОТ РАКЕТ
Dialogue: 0,0:05:23.26,0:05:25.79,Caption,,0,0,0,,PAC ТРИ. НОВОСТЬ ЗВУЧИТ СОЛИДНО,
Dialogue: 0,0:05:25.87,0:05:27.75,Caption,,0,0,0,,ПОКА НЕ ДОХОДИШЬ ДО СРОКА ПОСТАВКИ.
Dialogue: 0,0:05:27.75,0:05:30.26,Caption,,0,0,0,,ПОЛУЧИТЬ ИХ ПЛАНИРУЮТ В НАЧАЛЕ ТРИДЦАТЫХ ГОДОВ.
Dialogue: 0,0:05:30.82,0:05:32.67,Caption,,0,0,0,,НОВЫЙ СОСТАВ КОНГРЕССА ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:05:32.67,0:05:36.51,Caption,,0,0,0,,МОЖЕТ ВЫДЕЛЯТЬ СРЕДСТВА, ТРЕБОВАТЬ ЖЁСТКИХ САНКЦИЙ И УСТРАИВАТЬ
Dialogue: 0,0:05:36.51,0:05:39.13,Caption,,0,0,0,,БЕЛОМУ ДОМУ ТЯЖЁЛУЮ ЖИЗНЬ. НО ПРЕЗИДЕНТСКУЮ
Dialogue: 0,0:05:39.13,0:05:42.13,Caption,,0,0,0,,ВНЕШНЮЮ ПОЛИТИКУ ОН НА СЕБЯ НЕ ПЕРЕПИШЕТ. ТЕМ БОЛЕЕ
Dialogue: 0,0:05:42.13,0:05:44.67,Caption,,0,0,0,,СОГЛАШЕНИЕ ДОЛЖНО УСТРАИВАТЬ НЕ ТОЛЬКО КИЕВ С
Dialogue: 0,0:05:44.67,0:05:47.64,Caption,,0,0,0,,ВАШИНГТОНОМ. БЕЗ СОГЛАСИЯ МОСКВЫ ПОЛУЧИТСЯ НЕ МИРНЫЙ
Dialogue: 0,0:05:47.64,0:05:49.62,Caption,,0,0,0,,ДОГОВОР, А ПИСЬМО ДЕДУ МОРОЗУ,
Dialogue: 0,0:05:49.71,0:05:52.10,Caption,,0,0,0,,СОСТАВЛЕННОЕ ЮРИДИЧЕСКИМ ОТДЕЛОМ. ЕСЛИ
Dialogue: 0,0:05:52.10,0:05:55.83,Caption,,0,0,0,,ВЫ ЕЩЁ НЕ ПОДПИСАЛИСЬ, ПОДПИШИТЕСЬ ПРЯМО СЕЙЧАС. ДАЛЬШЕ КИЕВ
Dialogue: 0,0:05:55.83,0:05:58.50,Caption,,0,0,0,,ПРЕДЛАГАЕТ РОССИИ ВЫГОДУ, О КОТОРОЙ ТА,
Dialogue: 0,0:05:58.64,0:06:01.84,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ, ВСЕ ЭТИ ГОДЫ ДАЖЕ НЕ ДОГАДЫВАЛАСЬ.
Dialogue: 0,0:06:01.84,0:06:05.42,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ЗАЯВИЛ, ЧТО ВСТУПЛЕНИЕ УКРАИНЫ В НАТО МОЖЕТ
Dialogue: 0,0:06:05.42,0:06:09.38,Caption,,0,0,0,,БЫТЬ ПОЛЕЗНЕЕ РОССИИ, ЧЕМ САМОЙ УКРАИНЕ. СМЫСЛ СЛЕДУЮЩИЙ.
Dialogue: 0,0:06:11.66,0:06:13.91,Caption,,0,0,0,,ЕСЛИ МОСКВА ОПАСАЕТСЯ БУДУЩЕЙ ПОПЫТКИ
Dialogue: 0,0:06:13.91,0:06:15.82,Caption,,0,0,0,,КИЕВА ВЕРНУТЬ ТЕРРИТОРИИ СИЛОЙ,
Dialogue: 0,0:06:16.13,0:06:19.58,Caption,,0,0,0,,ЧЛЕНСТВО В АЛЬЯНСЕ ДОЛЖНО ЕЁ УСПОКОИТЬ. УКРАИНА,
Dialogue: 0,0:06:19.74,0:06:23.58,Caption,,0,0,0,,НАХОДЯСЬ ВНУТРИ НАТО, ЯКОБЫ НЕ СМОЖЕТ НАЧАТЬ ВОЕННЫЙ РЕВАНШ,
Dialogue: 0,0:06:23.77,0:06:25.74,Caption,,0,0,0,,ПОСКОЛЬКУ В ТАКОМ СЛУЧАЕ ЛИШИТСЯ
Dialogue: 0,0:06:25.74,0:06:29.81,Caption,,0,0,0,,ПОДДЕРЖКИ ПАРТНЁРОВ. РОССИЙСКОЕ НЕПРИЯТИЕ УКРАИНСКОГО
Dialogue: 0,0:06:29.81,0:06:33.10,Caption,,0,0,0,,ЧЛЕНСТВА ЗЕЛЕНСКИЙ ОБЪЯСНЯЕТ ИНАЧЕ. ПО ЕГО ВЕРСИИ,
Dialogue: 0,0:06:33.34,0:06:35.39,Caption,,0,0,0,,ПУТИН ХОЧЕТ СОХРАНИТЬ ВЛИЯНИЕ НА
Dialogue: 0,0:06:35.39,0:06:38.08,Caption,,0,0,0,,УКРАИНУ, НЕ ПОЗВОЛИТЬ ЕЙ ОКОНЧАТЕЛЬНО УЙТИ И
Dialogue: 0,0:06:38.08,0:06:40.14,Caption,,0,0,0,,ПРОДОЛЖИТЬ ОККУПАЦИЮ. ПОЛУЧАЕТСЯ,
Dialogue: 0,0:06:40.39,0:06:42.57,Caption,,0,0,0,,МОСКВА МНОГО ЛЕТ ТРЕБУЕТ ОСТАНОВИТЬ
Dialogue: 0,0:06:42.57,0:06:44.38,Caption,,0,0,0,,РАСШИРЕНИЕ НАТО ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:06:44.56,0:06:46.69,Caption,,0,0,0,,ЧТО ЕЩЁ НИКТО ТОЛКОМ НЕ РАЗЪЯСНИЛ ЕЙ
Dialogue: 0,0:06:46.69,0:06:48.78,Caption,,0,0,0,,ВЫГОДУ. СЕЙЧАС ЗЕЛЕНСКИЙ РАЗЪЯСНИЛ.
Dialogue: 0,0:06:49.39,0:06:52.41,Caption,,0,0,0,,МОЖНО ПРЕДСТАВИТЬ, КАК В КРЕМЛЕ ХВАТАЮТСЯ ЗА ГОЛОВУ
Dialogue: 0,0:06:52.41,0:06:55.35,Caption,,0,0,0,,СТОЛЬКО ВРЕМЕНИ СОПРОТИВЛЯЛИСЬ СОБСТВЕННОМУ СЧАСТЬЮ.
Dialogue: 0,0:06:55.35,0:06:58.04,Caption,,0,0,0,,ПРИ ЭТОМ ПРЕДЛОЖЕНИЕ О ПРЕКРАЩЕНИИ ОГНЯ НА ДВА
Dialogue: 0,0:06:58.04,0:07:01.26,Caption,,0,0,0,,ИЛИ ТРИ МЕСЯЦА КИЕВ ОТВЕРГАЕТ. ПУТИН ГОВОРИТ,
Dialogue: 0,0:07:01.42,0:07:03.50,Caption,,0,0,0,,ЧТО ПАУЗА ПОЗВОЛИТ УКРАИНСКОЙ АРМИИ
Dialogue: 0,0:07:03.50,0:07:07.40,Caption,,0,0,0,,ПРОВЕСТИ РОТАЦИЮ, ПОПОЛНИТЬ ЧАСТИ И ПЕРЕВООРУЖИТЬСЯ.
Dialogue: 0,0:07:07.40,0:07:10.14,Caption,,0,0,0,,ЗЕЛЕНСКИЙ НАЗЫВАЕТ ЭТО ЛОЖЬЮ. ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:07:10.38,0:07:12.14,Caption,,0,0,0,,МОСКВА ХОЧЕТ ИСПОЛЬЗОВАТЬ ЗИМУ,
Dialogue: 0,0:07:12.30,0:07:15.10,Caption,,0,0,0,,ЧТОБЫ СЛОМИТЬ УКРАИНУ, ПРЕЖДЕ ВСЕГО КИЕВ,
Dialogue: 0,0:07:15.18,0:07:18.06,Caption,,0,0,0,,ДНЕПР, ОДЕССУ, ХАРЬКОВ И ЗАПОРОЖЬЕ,
Dialogue: 0,0:07:18.44,0:07:20.28,Caption,,0,0,0,,А ЗАТЕМ ЗАСТАВИТЬ УКРАИНСКИЕ ВОЙСКА
Dialogue: 0,0:07:20.28,0:07:22.42,Caption,,0,0,0,,ПОКИНУТЬ ДОНБАСС. ЗЕЛЕНСКИЙ СЧИТАЕТ
Dialogue: 0,0:07:22.42,0:07:24.38,Caption,,0,0,0,,ДОБРОВОЛЬНЫЙ УХОД ИЗ ДОНБАССА,
Dialogue: 0,0:07:24.52,0:07:26.22,Caption,,0,0,0,,ВКЛЮЧАЯ СЛАВЯНСК И КРАМАТОРСК,
Dialogue: 0,0:07:26.45,0:07:31.60,Caption,,0,0,0,,ПРОИГРЫШЕМ ВОЙНЫ. РЕЧЬ ИМЕННО О СОЗНАТЕЛЬНОМ РЕШЕНИИ
Dialogue: 0,0:07:31.60,0:07:34.78,Caption,,0,0,0,,ОСТАВИТЬ ТЕРРИТОРИИ, А НЕ ОБ ОТСТУПЛЕНИИ ПОД ДАВЛЕНИЕМ НА
Dialogue: 0,0:07:34.78,0:07:36.97,Caption,,0,0,0,,ФРОНТЕ. ОН ОСОБО ПОДЧЁРКИВАЕТ,
Dialogue: 0,0:07:37.29,0:07:39.14,Caption,,0,0,0,,ЧТО ВОПРОС НЕ СВОДИТСЯ К КОЛИЧЕСТВУ
Dialogue: 0,0:07:39.14,0:07:42.17,Caption,,0,0,0,,ГЕКТАРОВ. ДОПУСТИМ. ЧТО ЗНАЧИТ ПРОИГРАТЬ,
Dialogue: 0,0:07:42.38,0:07:45.45,Caption,,0,0,0,,ТЕПЕРЬ ЯСНО. НО ЧТО ТОГДА ОЗНАЧАЕТ ВЫИГРАТЬ?
Dialogue: 0,0:07:46.12,0:07:48.32,Caption,,0,0,0,,КАК ВЫГЛЯДИТ УКРАИНСКАЯ ПОБЕДА НЕ НА
Dialogue: 0,0:07:48.32,0:07:50.25,Caption,,0,0,0,,ПЛАКАТЕ, А В КОНКРЕТНЫХ УСЛОВИЯХ?
Dialogue: 0,0:07:50.62,0:07:52.57,Caption,,0,0,0,,КАКОЕ СОБЫТИЕ ДОЛЖНО ПРОИЗОЙТИ,
Dialogue: 0,0:07:52.80,0:07:54.96,Caption,,0,0,0,,ЧТОБЫ ВЛАСТИ СКАЗАЛИ ЛЮДЯМ ЗАДАЧА
Dialogue: 0,0:07:54.96,0:07:57.05,Caption,,0,0,0,,ВЫПОЛНЕНА, ДАЛЬШЕ ВОЕВАТЬ НЕЗАЧЕМ?
Dialogue: 0,0:07:57.70,0:08:00.81,Caption,,0,0,0,,РАНЬШЕ КИЕВ НАЗЫВАЛ ПОНЯТНЫЕ ОРИЕНТИРЫ. ГРАНИЦЫ
Dialogue: 0,0:08:00.81,0:08:02.48,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО ПЕРВОГО
Dialogue: 0,0:08:02.48,0:08:05.20,Caption,,0,0,0,,ГОДА, ВОЗВРАЩЕНИЕ КРЫМА И БОДРЫЕ ОБЕЩАНИЯ
Dialogue: 0,0:08:05.20,0:08:08.21,Caption,,0,0,0,,ВЫПИТЬ КОФЕ ТАМ, КУДА УКРАИНСКАЯ АРМИЯ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:08:08.21,0:08:10.77,Caption,,0,0,0,,ПРИДЁТ. ТЕПЕРЬ ПРЕЖНЯЯ ОПРЕДЕЛЁННОСТЬ
Dialogue: 0,0:08:10.77,0:08:13.63,Caption,,0,0,0,,РАСТВОРИЛАСЬ. НА ЕЁ МЕСТЕ ОСТАЛАСЬ ОДНА ФОРМУЛА
Dialogue: 0,0:08:13.63,0:08:15.85,Caption,,0,0,0,,ДОБРОВОЛЬНЫЙ ОТХОД РАВЕН ПОРАЖЕНИЮ.
Dialogue: 0,0:08:16.45,0:08:19.69,Caption,,0,0,0,,ТОГДА ГДЕ НАХОДИТСЯ ПОБЕДА? В ВОЗВРАЩЕНИИ ВСЕХ ТЕРРИТОРИЙ?
Dialogue: 0,0:08:20.09,0:08:21.88,Caption,,0,0,0,,В ДОСТИЖЕНИИ ГРАНИЦ ТЫСЯЧА ДЕВЯТЬСОТ
Dialogue: 0,0:08:21.88,0:08:24.57,Caption,,0,0,0,,ДЕВЯНОСТО ПЕРВОГО ГОДА? ВО ВСТУПЛЕНИИ В НАТО?
Dialogue: 0,0:08:25.02,0:08:27.45,Caption,,0,0,0,,В СОХРАНЕНИИ НЫНЕШНЕЙ ЛИНИИ СОПРИКОСНОВЕНИЯ?
Dialogue: 0,0:08:27.92,0:08:29.95,Caption,,0,0,0,,ИЛИ ДОСТАТОЧНО НЕ ПОСТАВИТЬ ПОДПИСЬ
Dialogue: 0,0:08:29.95,0:08:32.89,Caption,,0,0,0,,ПОД БУМАГОЙ, КОТОРУЮ КИЕВ СОЧТЁТ КАПИТУЛЯЦИЕЙ?
Dialogue: 0,0:08:33.17,0:08:36.54,Caption,,0,0,0,,СЛОВО "ПОБЕДА" УДОБНО, ПОКА ЕГО НЕ ПРОСЯТ РАЗЛОЖИТЬ НА
Dialogue: 0,0:08:36.54,0:08:40.41,Caption,,0,0,0,,УСЛОВИЯ. ОНО ГРОМКОЕ, КРАСИВОЕ И ГОДИТСЯ ДЛЯ ЛЮБОЙ ТРИБУНЫ.
Dialogue: 0,0:08:40.97,0:08:44.72,Caption,,0,0,0,,НО ВОЙНА НЕ ФУТБОЛЬНЫЙ МАТЧ, ГДЕ ФИНАЛЬНЫЙ СВИСТОК САМ ОБЪЯСНЯЕТ
Dialogue: 0,0:08:44.72,0:08:49.45,Caption,,0,0,0,,РЕЗУЛЬТАТ. ЗДЕСЬ ФИНИШ ОБЯЗАН БЫТЬ НАЗВАН
Dialogue: 0,0:08:49.45,0:08:52.51,Caption,,0,0,0,,ЗАРАНЕЕ, ИНАЧЕ КАЖДЫЙ НОВЫЙ МЕСЯЦ ОБЪЯВЯТ ЕЩЁ
Dialogue: 0,0:08:52.51,0:08:56.87,Caption,,0,0,0,,ОДНИМ НЕОБХОДИМЫМ КРУГОМ. ЗЕЛЕНСКИЙ ПРИВОДИТ И ДРУГОЙ ДОВОД.
Dialogue: 0,0:08:56.87,0:08:59.72,Caption,,0,0,0,,ЕСЛИ СТРАНА ДОБРОВОЛЬНО ОТДАСТ ЧАСТЬ ТЕРРИТОРИИ,
Dialogue: 0,0:09:00.04,0:09:02.18,Caption,,0,0,0,,НИ ОДНА ГАРАНТИЯ НЕ ПОМЕШАЕТ ПОЗДНЕЕ
Dialogue: 0,0:09:02.18,0:09:05.16,Caption,,0,0,0,,ПОТРЕБОВАТЬ СЛЕДУЮЩУЮ ЧАСТЬ. ТАКОЙ СТРАХ ПОНЯТЕН.
Dialogue: 0,0:09:05.72,0:09:07.87,Caption,,0,0,0,,НО ИЗ НЕГО СЛЕДУЕТ КРАЙНЕ МРАЧНАЯ
Dialogue: 0,0:09:07.87,0:09:11.22,Caption,,0,0,0,,РАЗВИЛКА. МОСКВА ТРЕБУЕТ ТЕРРИТОРИАЛЬНЫХ УСТУПОК. КИЕВ
Dialogue: 0,0:09:11.22,0:09:13.92,Caption,,0,0,0,,СЧИТАЕТ ДОБРОВОЛЬНОЕ ОТСТУПЛЕНИЕ ПОРАЖЕНИЕМ.
Dialogue: 0,0:09:13.92,0:09:16.99,Caption,,0,0,0,,ЗНАЧИТ, ПРИЕМЛЕМЫМ ДЛЯ КИЕВА ОСТАЁТСЯ ЛИШЬ
Dialogue: 0,0:09:16.99,0:09:18.91,Caption,,0,0,0,,УХОД, КОТОРЫЙ ПРОИЗОЙДЁТ НЕ ПО ЕГО
Dialogue: 0,0:09:18.91,0:09:22.68,Caption,,0,0,0,,СОБСТВЕННОЙ ВОЛЕ. ЛУКАШЕНКО ПРЕДЛАГАЕТ РЕШИТЬ ПРОБЛЕМУ С
Dialogue: 0,0:09:22.68,0:09:25.51,Caption,,0,0,0,,ПРИСУЩЕЙ ЕМУ ПРОСТОТОЙ. ОН ГОТОВ ЛИЧНО УСАДИТЬ
Dialogue: 0,0:09:25.51,0:09:29.11,Caption,,0,0,0,,ЗЕЛЕНСКОГО В САМОЛЁТ, ДОСТАВИТЬ В МОСКВУ И ОБЕСПЕЧИТЬ
Dialogue: 0,0:09:29.11,0:09:31.96,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. ПО МНЕНИЮ БЕЛОРУССКОГО ПРЕЗИДЕНТА,
Dialogue: 0,0:09:32.12,0:09:34.87,Caption,,0,0,0,,РОССИИ, УКРАИНЕ И БЕЛОРУССИИ БЫЛО БЫ ЛЕГЧЕ
Dialogue: 0,0:09:34.87,0:09:38.12,Caption,,0,0,0,,ДОГОВОРИТЬСЯ НАПРЯМУЮ, КАК ТРЁМ СЛАВЯНСКИМ НАРОДАМ,
Dialogue: 0,0:09:38.28,0:09:40.44,Caption,,0,0,0,,БЕЗ БЕСКОНЕЧНОЙ ОЧЕРЕДИ ПОСРЕДНИКОВ,
Dialogue: 0,0:09:40.60,0:09:42.95,Caption,,0,0,0,,СОВЕТЧИКОВ И ЛЮДЕЙ С СОБСТВЕННЫМИ
Dialogue: 0,0:09:42.95,0:09:45.83,Caption,,0,0,0,,СЧЕТАМИ. РОЛЬ ЕВРОПЫ ЛУКАШЕНКО ПОЛНОСТЬЮ НЕ
Dialogue: 0,0:09:45.83,0:09:48.65,Caption,,0,0,0,,ОТБРАСЫВАЕТ. ОН ОТДЕЛЬНО ГОВОРИТ О ФРАНЦИИ И ЕЁ
Dialogue: 0,0:09:48.65,0:09:51.91,Caption,,0,0,0,,ЗНАЧЕНИИ ДЛЯ БУДУЩЕЙ СИСТЕМЫ БЕЗОПАСНОСТИ. ОДНАКО
Dialogue: 0,0:09:51.91,0:09:54.97,Caption,,0,0,0,,СУДЬБУ РОССИИ, УКРАИНЫ И БЕЛОРУССИИ ПРЕДЛАГАЕТ
Dialogue: 0,0:09:54.97,0:09:58.74,Caption,,0,0,0,,ОБСУЖДАТЬ ВТРОЁМ. ВИДИМО, ЧТОБЫ ЗА СТОЛОМ ХОТЯ БЫ ХВАТИЛО
Dialogue: 0,0:09:58.74,0:10:02.55,Caption,,0,0,0,,ВРЕМЕНИ УСЛЫШАТЬ СОБЕСЕДНИКА, А НЕ ТОЛЬКО ПЕРЕВОДЧИКА И СЛЕДУЮЩЕГО
Dialogue: 0,0:10:02.55,0:10:07.21,Caption,,0,0,0,,ЖЕЛАЮЩЕГО ВЫСТУПИТЬ. ФОРМУЛИРОВКА У ЛУКАШЕНКО
Dialogue: 0,0:10:07.21,0:10:09.77,Caption,,0,0,0,,СООТВЕТСТВУЮЩАЯ. ЕСЛИ ЗЕЛЕНСКИЙ НЕ СОГЛАСИТСЯ,
Dialogue: 0,0:10:09.93,0:10:13.34,Caption,,0,0,0,,ПУСТЬ БЕРЁТ АВТОМАТ, ИДЁТ НА ФРОНТ И ВОЮЕТ САМ. НИКАКИХ
Dialogue: 0,0:10:13.34,0:10:16.01,Caption,,0,0,0,,МНОГОСТРАНИЧНЫХ ПОЯСНЕНИЙ. ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:10:16.15,0:10:20.13,Caption,,0,0,0,,САМОЛЁТ, МОСКВА, А В СЛУЧАЕ ОТКАЗА АВТОМАТ. СЕРВИС
Dialogue: 0,0:10:20.13,0:10:23.05,Caption,,0,0,0,,ПОЧТИ КАК У АВИАКОМПАНИИ, ТОЛЬКО ТАРИФЫ СУРОВЕЕ.
Dialogue: 0,0:10:23.68,0:10:25.61,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОТВЕТИЛ В ТОМ ЖЕ ЖАНРЕ.
Dialogue: 0,0:10:25.61,0:10:28.57,Caption,,0,0,0,,ПУСТЬ ЛУКАШЕНКО САМ БЕРЁТ ПУТИНА И ПРИЛЕТАЕТ В КИЕВ,
Dialogue: 0,0:10:28.65,0:10:30.82,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ОБОИМ ПООБЕЩАЛИ. А НА
Dialogue: 0,0:10:30.82,0:10:33.47,Caption,,0,0,0,,ИДЕЮ ОТВЕЗТИ ЕГО В МОСКВУ УКРАИНСКИЙ ПРЕЗИДЕНТ
Dialogue: 0,0:10:33.47,0:10:36.89,Caption,,0,0,0,,ОТРЕАГИРОВАЛ СОВСЕМ ПО ДОМАШНЕМУ ОН ЛУКАШЕНКО НЕ ЧЕМОДАН,
Dialogue: 0,0:10:37.12,0:10:40.60,Caption,,0,0,0,,ЧТОБЫ ЕГО КУДА ТО ЗАБИРАТЬ. ТАК ПЕРЕГОВОРЫ ОКОНЧАТЕЛЬНО
Dialogue: 0,0:10:40.60,0:10:43.87,Caption,,0,0,0,,ПРЕВРАТИЛИСЬ В СПОР У СТОЙКИ РЕГИСТРАЦИИ. ОДИН НАЗНАЧАЕТ
Dialogue: 0,0:10:43.87,0:10:46.09,Caption,,0,0,0,,ПАССАЖИРА, ДРУГОЙ МЕНЯЕТ МАРШРУТ,
Dialogue: 0,0:10:46.34,0:10:48.37,Caption,,0,0,0,,ТРЕТИЙ ПОКА НЕ ВЫДАЁТ ПОСАДОЧНЫЙ
Dialogue: 0,0:10:48.37,0:10:51.29,Caption,,0,0,0,,ТАЛОН. САМОЛЁТЫ В РАЗГОВОРЕ УЖЕ ЛЕТАЮТ ВО ВСЕ СТОРОНЫ,
Dialogue: 0,0:10:51.61,0:10:53.44,Caption,,0,0,0,,А СОГЛАШЕНИЕ НЕ СДВИНУЛОСЬ НИ НА
Dialogue: 0,0:10:53.44,0:10:56.17,Caption,,0,0,0,,САНТИМЕТР. ЛУКАШЕНКО ОДНОВРЕМЕННО ЗАЯВЛЯЕТ,
Dialogue: 0,0:10:56.44,0:10:59.44,Caption,,0,0,0,,ЧТО УВЕРЕН В ВОЕННОЙ ПОБЕДЕ РОССИИ. И
Dialogue: 0,0:10:59.44,0:11:02.12,Caption,,0,0,0,,ЭТО ДОБАВЛЯЕТ К ОБЩЕЙ КОНСТРУКЦИИ ЕЩЁ ОДИН
Dialogue: 0,0:11:02.12,0:11:06.92,Caption,,0,0,0,,ЗАМОК. МОСКВА, ПО ЕГО МНЕНИЮ, СПОСОБНА ДОБИТЬСЯ СВОЕГО СИЛОЙ. КИЕВ
Dialogue: 0,0:11:06.92,0:11:09.34,Caption,,0,0,0,,СЧИТАЕТ ДОБРОВОЛЬНУЮ УСТУПКУ ТЕРРИТОРИИ
Dialogue: 0,0:11:09.34,0:11:11.37,Caption,,0,0,0,,ПОРАЖЕНИЕМ. ТОГДА ЗАЧЕМ СТОРОНЕ,
Dialogue: 0,0:11:11.61,0:11:13.69,Caption,,0,0,0,,РАССЧИТЫВАЮЩЕЙ ПОБЕДИТЬ НА ПОЛЕ БОЯ,
Dialogue: 0,0:11:13.93,0:11:17.29,Caption,,0,0,0,,СОГЛАШАТЬСЯ НА УСЛОВИЯ, КОТОРЫЕ ПРОТИВНИК ГОТОВ ПРИНЯТЬ?
Dialogue: 0,0:11:19.56,0:11:21.62,Caption,,0,0,0,,ДЛЯ СДЕЛКИ НУЖНО ПРОСТРАНСТВО МЕЖДУ
Dialogue: 0,0:11:21.62,0:11:24.24,Caption,,0,0,0,,ПОЗИЦИЯМИ, А ЕГО ЗДЕСЬ СТАРАТЕЛЬНО ЗАСТАВИЛИ
Dialogue: 0,0:11:24.24,0:11:27.49,Caption,,0,0,0,,МЕБЕЛЬЮ. НА ЭТОМ ФОНЕ FOREIGN AFFAIRS ВЫПУСКАЕТ
Dialogue: 0,0:11:27.49,0:11:30.60,Caption,,0,0,0,,МАТЕРИАЛ С ПРЕДЕЛЬНО ЯСНЫМ ВЫВОДОМ С РОССИЕЙ ПОРА
Dialogue: 0,0:11:30.60,0:11:32.76,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ. В СТАТЬЕ ГОВОРИТСЯ,
Dialogue: 0,0:11:32.92,0:11:35.58,Caption,,0,0,0,,ЧТО УКРАИНА НЕ ВЫИГРЫВАЕТ ВОЙНУ. АВТОР
Dialogue: 0,0:11:35.58,0:11:37.72,Caption,,0,0,0,,РАЗБИРАЕТ ЗАПАДНУЮ ЛИНИЮ ДАВЛЕНИЯ,
Dialogue: 0,0:11:37.96,0:11:40.20,Caption,,0,0,0,,ДЕЙСТВУЮЩУЮ С ДВЕ ТЫСЯЧИ ЧЕТЫРНАДЦАТОГО ГОДА,
Dialogue: 0,0:11:40.52,0:11:42.65,Caption,,0,0,0,,И НАЗЫВАЕТ ЕЁ ПОЛИТИКОЙ КНУТА БЕЗ
Dialogue: 0,0:11:42.65,0:11:45.48,Caption,,0,0,0,,ПРЯНИКА. ОЖИДАЕМОГО РЕЗУЛЬТАТА ОНА НЕ ДАЛА,
Dialogue: 0,0:11:45.64,0:11:47.57,Caption,,0,0,0,,ПОЭТОМУ НА СТОЛ СЛЕДУЕТ ПОЛОЖИТЬ НЕ
Dialogue: 0,0:11:47.57,0:11:52.12,Caption,,0,0,0,,ТОЛЬКО УГРОЗЫ И ОГРАНИЧЕНИЯ, НО И РЕАЛЬНЫЕ СТИМУЛЫ. ЕСТЬ И ПРИЧИНА,
Dialogue: 0,0:11:52.25,0:11:54.48,Caption,,0,0,0,,ПО КОТОРОЙ ТРАМП СПЕШИТ. ОН ДУМАЕТ О
Dialogue: 0,0:11:54.48,0:11:57.46,Caption,,0,0,0,,СОБСТВЕННОМ МЕСТЕ В ИСТОРИИ. МИРНОЕ СОГЛАШЕНИЕ
Dialogue: 0,0:11:57.46,0:12:00.14,Caption,,0,0,0,,СТАЛО БЫ ОДНИМ ИЗ ГЛАВНЫХ РЕЗУЛЬТАТОВ ЕГО
Dialogue: 0,0:12:00.14,0:12:03.30,Caption,,0,0,0,,ПРЕЗИДЕНТСТВА. FOREIGN AFFAIRS ВСПОМИНАЕТ И ЕГО ДАВНИЙ
Dialogue: 0,0:12:03.30,0:12:05.72,Caption,,0,0,0,,ИНТЕРЕС К НОБЕЛЕВСКОЙ ПРЕМИИ. НАГРАДА,
Dialogue: 0,0:12:05.81,0:12:08.36,Caption,,0,0,0,,КОНЕЧНО, НЕ ДОЛЖНА ОПРЕДЕЛЯТЬ СУДЬБУ ВОЙНЫ.
Dialogue: 0,0:12:08.96,0:12:11.38,Caption,,0,0,0,,НО ТЩЕСЛАВИЕ ИНОГДА ДВИГАЕТ ПЕРЕГОВОРЫ
Dialogue: 0,0:12:11.38,0:12:14.20,Caption,,0,0,0,,БЫСТРЕЕ, ЧЕМ ДЕСЯТОК МЕЖДУНАРОДНЫХ КОНФЕРЕНЦИЙ.
Dialogue: 0,0:12:14.98,0:12:17.72,Caption,,0,0,0,,FOREIGN AFFAIRS ССЫЛАЕТСЯ НА ИССЛЕДОВАНИЕ ВОЕННОГО
Dialogue: 0,0:12:17.72,0:12:19.70,Caption,,0,0,0,,СОЦИОЛОГА КОРОЛЕВСКОГО КОЛЛЕДЖА
Dialogue: 0,0:12:19.70,0:12:23.51,Caption,,0,0,0,,ЛОНДОНА АЛЕКСАНДРА ГРЕЙБЛА. ОН ИЗУЧИЛ ОТКРЫТЫЕ ОЦЕНКИ
Dialogue: 0,0:12:23.51,0:12:28.03,Caption,,0,0,0,,ПОТЕРЬ И ПРИШЁЛ К ВЫВОДУ, ЧТО В АБСОЛЮТНЫХ ЧИСЛАХ УКРАИНА ТЕРЯЕТ
Dialogue: 0,0:12:28.03,0:12:34.16,Caption,,0,0,0,,БОЛЬШЕ ЛЮДЕЙ, ЧЕМ РОССИЯ. ТАКОЙ ВЫВОД МЕНЯЕТ ПРИВЫЧНУЮ КАРТИНУ,
Dialogue: 0,0:12:34.40,0:12:37.20,Caption,,0,0,0,,В КОТОРОЙ МОСКВА ЯКОБЫ МОЖЕТ БЕСКОНЕЧНО РАСХОДОВАТЬ
Dialogue: 0,0:12:37.28,0:12:40.20,Caption,,0,0,0,,ЛИЧНЫЙ СОСТАВ, А КИЕВ СОХРАНЯЕТ ПРЕИМУЩЕСТВО
Dialogue: 0,0:12:40.20,0:12:43.20,Caption,,0,0,0,,БЛАГОДАРЯ БОЛЕЕ БЕРЕЖНОМУ ОТНОШЕНИЮ К ВОЕННОСЛУЖАЩИМ.
Dialogue: 0,0:12:43.82,0:12:48.10,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПОДРОБНО ОБЪЯСНИЛ, ЧТО НАЗОВЁТ ПОРАЖЕНИЕМ. ДОБРОВОЛЬНЫЙ
Dialogue: 0,0:12:48.10,0:12:51.27,Caption,,0,0,0,,ВЫХОД ИЗ ДОНБАССА. ФОРМУЛИРОВКА УСЛЫШАНА. НО
Dialogue: 0,0:12:51.27,0:12:54.51,Caption,,0,0,0,,ЛЮДЯМ ОДНАЖДЫ ПРИДЁТСЯ УСЛЫШАТЬ И ВТОРУЮ ЧАСТЬ. ЧТО
Dialogue: 0,0:12:54.51,0:12:57.53,Caption,,0,0,0,,ИМЕННО ВЛАСТЬ СЧИТАЕТ ПОБЕДОЙ И КАКУЮ ЦЕНУ ОНА
Dialogue: 0,0:12:57.53,0:13:00.32,Caption,,0,0,0,,ГОТОВА ЗА НЕЁ ЗАПЛАТИТЬ? НЕ ОБЩИЙ ЛОЗУНГ,
Dialogue: 0,0:13:00.55,0:13:02.44,Caption,,0,0,0,,НЕ КРАСИВОЕ СЛОВО И НЕ ОБЕЩАНИЕ
Dialogue: 0,0:13:02.44,0:13:04.88,Caption,,0,0,0,,ПРОДОЛЖАТЬ СТОЛЬКО, СКОЛЬКО ПОТРЕБУЕТСЯ,
Dialogue: 0,0:13:05.28,0:13:07.76,Caption,,0,0,0,,А ДОСТИЖИМЫЙ ИТОГ С ПОНЯТНЫМИ УСЛОВИЯМИ.
Dialogue: 0,0:13:08.32,0:13:09.99,Caption,,0,0,0,,ВОЙНА НЕ МОЖЕТ ДЛИТЬСЯ ТОЛЬКО ДЛЯ
Dialogue: 0,0:13:09.99,0:13:12.13,Caption,,0,0,0,,ТОГО, ЧТОБЫ НИКТО НЕ ПРОИЗНЁС СЛОВО
Dialogue: 0,0:13:12.13,0:13:14.88,Caption,,0,0,0,,"ПОРАЖЕНИЕ". У НЕЁ ДОЛЖНА БЫТЬ КОНЕЧНАЯ ТОЧКА,
Dialogue: 0,0:13:15.04,0:13:17.07,Caption,,0,0,0,,ДО КОТОРОЙ РЕАЛЬНО ДОБРАТЬСЯ. ИНАЧЕ
Dialogue: 0,0:13:17.07,0:13:19.76,Caption,,0,0,0,,КАЖДЫЙ СЛЕДУЮЩИЙ МЕСЯЦ СТАНОВИТСЯ ЛИШЬ ОТСРОЧКОЙ
Dialogue: 0,0:13:19.76,0:13:21.92,Caption,,0,0,0,,РАЗГОВОРА, КОТОРЫЙ ВСЁ РАВНО СОСТОИТСЯ,
Dialogue: 0,0:13:22.16,0:13:23.98,Caption,,0,0,0,,ТОЛЬКО СЧЁТ К ТОМУ ВРЕМЕНИ ОКАЖЕТСЯ
Dialogue: 0,0:13:23.98,0:13:26.81,Caption,,0,0,0,,ВЫШЕ. АМЕРИКАНЦЫ ПО ОЧЕРЕДИ ПРЕДЛАГАЮТ
Dialogue: 0,0:13:26.81,0:13:30.22,Caption,,0,0,0,,ДЕНЬГИ, СРОКИ, ГАРАНТИИ И ТЕРРИТОРИИ. ЛУКАШЕНКО
Dialogue: 0,0:13:30.22,0:13:34.05,Caption,,0,0,0,,ПРИГОТОВИЛ САМОЛЁТ. ЗЕЛЕНСКИЙ ЖДЁТ НОВЫЙ КОНГРЕСС. FOREIGN
Dialogue: 0,0:13:34.05,0:13:36.40,Caption,,0,0,0,,AFFAIRS ТРЕБУЕТ ВОЗОБНОВИТЬ РАЗГОВОР С
Dialogue: 0,0:13:36.40,0:13:39.85,Caption,,0,0,0,,МОСКВОЙ. ЕВРОПА ОБЕЩАЕТ БУДУЩИЙ ДИАЛОГ И ОДНОВРЕМЕННО
Dialogue: 0,0:13:39.85,0:13:42.72,Caption,,0,0,0,,ДОСТАЁТ СЛЕДУЮЩИЙ ПАКЕТ САНКЦИЙ. ВСЕ ЗАНЯТЫ,
Dialogue: 0,0:13:42.86,0:13:46.08,Caption,,0,0,0,,ВСЕ ПРИ ДЕЛЕ, НИКТО НЕ СКУЧАЕТ. ТЕПЕРЬ ВОПРОС К ВАМ.
Dialogue: 0,0:13:48.36,0:13:50.49,Caption,,0,0,0,,ЕСЛИ ДОБРОВОЛЬНО ОТОЙТИ ОЗНАЧАЕТ
Dialogue: 0,0:13:50.49,0:13:53.60,Caption,,0,0,0,,ПРОИГРАТЬ, ТО КАКОЙ КОНКРЕТНЫЙ РЕЗУЛЬТАТ ПОЗВОЛИТ
Dialogue: 0,0:13:53.60,0:13:55.48,Caption,,0,0,0,,СКАЗАТЬ, ЧТО УКРАИНА ВЫИГРАЛА?
