Dialogue: 0,0:00:00.11,0:00:04.28,Caption,,0,0,0,,ТРАМП, ПОХОЖЕ, РЕШИЛ ДЕЙСТВОВАТЬ ПО СТАРИНКЕ. ЕСТЬ ПРОБЛЕМА,
Dialogue: 0,0:00:04.49,0:00:07.16,Caption,,0,0,0,,НАДО САДИТЬСЯ И РАЗГОВАРИВАТЬ. СТОЛ ПОСТАВИЛИ,
Dialogue: 0,0:00:07.30,0:00:10.44,Caption,,0,0,0,,СТУЛЬЯ ПРИНЕСЛИ. А ЧАСТЬ ЕВРОПЫ УЖЕ ОБЪЯСНЯЕТ,
Dialogue: 0,0:00:10.63,0:00:13.96,Caption,,0,0,0,,ПОЧЕМУ САДИТЬСЯ ОНА НЕ СОБИРАЕТСЯ. НУ ХОРОШО. ТОГДА
Dialogue: 0,0:00:14.04,0:00:16.84,Caption,,0,0,0,,ВОЗНИКАЕТ СОВСЕМ ПРОСТОЙ ВОПРОС. А ДАЛЬШЕ ТО ЧТО
Dialogue: 0,0:00:16.92,0:00:19.40,Caption,,0,0,0,,У ВАС ПО ПЛАНУ? ЕСЛИ ВАМ НРАВЯТСЯ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:19.55,0:00:21.96,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ТРАМП ЗАГОВОРИЛ О БОЛЬШОЙ
Dialogue: 0,0:00:21.96,0:00:25.24,Caption,,0,0,0,,ДОГОВОРЁННОСТИ, КОТОРАЯ ДОЛЖНА ОХВАТИТЬ НЕ ТОЛЬКО УКРАИНУ,
Dialogue: 0,0:00:25.48,0:00:28.36,Caption,,0,0,0,,НО И ВСЮ СИСТЕМУ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ЕГО
Dialogue: 0,0:00:28.44,0:00:30.68,Caption,,0,0,0,,КОМАНДА УПОМИНАЕТ ПОСТОЯННЫЕ КОНСУЛЬТАЦИИ,
Dialogue: 0,0:00:30.84,0:00:32.60,Caption,,0,0,0,,ПРЯМУЮ СВЯЗЬ НА СЛУЧАЙ КРИЗИСА,
Dialogue: 0,0:00:32.92,0:00:36.20,Caption,,0,0,0,,ВОЕННУЮ ПРОЗРАЧНОСТЬ И ВЗАИМНЫЕ МЕРЫ ДЛЯ СНИЖЕНИЯ
Dialogue: 0,0:00:36.20,0:00:38.76,Caption,,0,0,0,,РИСКА ЭСКАЛАЦИИ. ЕСЛИ ПЕРЕВЕСТИ ЭТО С
Dialogue: 0,0:00:38.76,0:00:40.76,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКОГО ЯЗЫКА НА НОРМАЛЬНЫЙ,
Dialogue: 0,0:00:40.99,0:00:43.48,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ЗВУЧИТ ПРОСТО. ДАВАЙТЕ ОПРЕДЕЛИМ,
Dialogue: 0,0:00:43.74,0:00:47.40,Caption,,0,0,0,,КТО КУДА НЕ ЛЕЗЕТ, КАКИЕ ВООРУЖЕНИЯ И ГДЕ НЕ РАЗМЕЩАЕТ,
Dialogue: 0,0:00:47.72,0:00:50.44,Caption,,0,0,0,,КОМУ ЗВОНИТ, КОГДА НАЧИНАЕТ ПАХНУТЬ ЖАРЕНЫМ,
Dialogue: 0,0:00:50.68,0:00:53.24,Caption,,0,0,0,,И КАК НЕ ДОПУСТИТЬ СЛЕДУЮЩЕГО ОБЩЕЕВРОПЕЙСКОГО
Dialogue: 0,0:00:53.24,0:00:56.68,Caption,,0,0,0,,КРИЗИСА. И ТУТ ОБНАРУЖИЛАСЬ ЗАМЕЧАТЕЛЬНАЯ ДЕТАЛЬ.
Dialogue: 0,0:00:57.24,0:01:00.36,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СОЮЗНИКИ ПО НАТО ОБ АМЕРИКАНСКИХ ПЛАНАХ
Dialogue: 0,0:01:00.36,0:01:02.20,Caption,,0,0,0,,ЗАРАНЕЕ ПОЧТИ НИЧЕГО НЕ ЗНАЛИ.
Dialogue: 0,0:01:02.82,0:01:05.72,Caption,,0,0,0,,ВОТ ЭТО УЖЕ ХОРОШИЙ СЕМЕЙНЫЙ РАЗГОВОР. АМЕРИКА
Dialogue: 0,0:01:05.72,0:01:07.96,Caption,,0,0,0,,СОБИРАЕТСЯ ОБСУЖДАТЬ БЕЗОПАСНОСТЬ ЕВРОПЫ.
Dialogue: 0,0:01:10.23,0:01:13.03,Caption,,0,0,0,,ЕВРОПА УЗНАЁТ ОБ ОБСУЖДЕНИИ СОБСТВЕННОЙ БЕЗОПАСНОСТИ
Dialogue: 0,0:01:13.03,0:01:16.55,Caption,,0,0,0,,ЕДВА ЛИ НЕ ИЗ НОВОСТЕЙ, А ЗАТЕМ СПРАВЕДЛИВО ВОЗМУЩАЕТСЯ,
Dialogue: 0,0:01:16.79,0:01:19.51,Caption,,0,0,0,,ЧТО РЕШАТЬ ПОДОБНЫЕ ВОПРОСЫ БЕЗ НЕЁ НЕЛЬЗЯ. С
Dialogue: 0,0:01:19.51,0:01:22.23,Caption,,0,0,0,,ПРЕТЕНЗИЕЙ НЕ ПОСПОРИШЬ. ЕСЛИ РАЗГОВОР ИДЁТ О
Dialogue: 0,0:01:22.23,0:01:25.99,Caption,,0,0,0,,ЕВРОПЕ, ЕВРОПЕЙЦЫ ДОЛЖНЫ НАХОДИТЬСЯ ЗА СТОЛОМ. НО ДАЛЬШЕ
Dialogue: 0,0:01:25.99,0:01:29.75,Caption,,0,0,0,,НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ. МЕСТО ЗА СТОЛОМ ЧАСТЬ
Dialogue: 0,0:01:29.75,0:01:32.63,Caption,,0,0,0,,ЕВРОПЕЙСКИХ РУКОВОДИТЕЛЕЙ ТРЕБУЕТ. А ОБСУЖДАТЬ
Dialogue: 0,0:01:32.63,0:01:35.11,Caption,,0,0,0,,ПРИЧИНУ, ПО КОТОРОЙ ЭТОТ СТОЛ ПОНАДОБИЛСЯ,
Dialogue: 0,0:01:35.35,0:01:38.55,Caption,,0,0,0,,ОНИ ЗАРАНЕЕ ОТКАЗЫВАЮТСЯ. КАЯ КАЛЛАС ЗАЯВЛЯЕТ,
Dialogue: 0,0:01:38.71,0:01:41.51,Caption,,0,0,0,,ЧТО НОВАЯ АРХИТЕКТУРА БЕЗОПАСНОСТИ ЕВРОПЕ ВРОДЕ БЫ
Dialogue: 0,0:01:41.59,0:01:44.55,Caption,,0,0,0,,НЕ НУЖНА. УЖЕ СУЩЕСТВУЮТ НАТО И ЕВРОСОЮЗ,
Dialogue: 0,0:01:44.71,0:01:49.27,Caption,,0,0,0,,СИСТЕМА ДАВНО ПОСТРОЕНА, А ПРАВА НАКЛАДЫВАТЬ ВЕТО НА ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ
Dialogue: 0,0:01:49.27,0:01:52.95,Caption,,0,0,0,,У ПУТИНА НЕТ. ДОПУСТИМ. НО ЕСЛИ КОНСТРУКЦИЯ ГОТОВА
Dialogue: 0,0:01:53.03,0:01:57.19,Caption,,0,0,0,,И ПРЕКРАСНО ДЕЙСТВУЕТ, ЗАЧЕМ НАЧАЛИСЬ РАЗГОВОРЫ О НОВОЙ ДОГОВОРЁННОСТИ?
Dialogue: 0,0:01:57.59,0:02:00.47,Caption,,0,0,0,,ПЯТЫЙ ГОД ПРОДОЛЖАЕТСЯ ТЯЖЕЛЕЙШИЙ КОНФЛИКТ. ЕЩЁ ДО
Dialogue: 0,0:02:00.55,0:02:03.11,Caption,,0,0,0,,ЕГО НАЧАЛА РОССИЯ ПОДНИМАЛА ВОПРОСЫ О РАСШИРЕНИИ
Dialogue: 0,0:02:03.11,0:02:05.91,Caption,,0,0,0,,НАТО, ВОЕННОЙ ИНФРАСТРУКТУРЕ АЛЬЯНСА,
Dialogue: 0,0:02:06.15,0:02:09.27,Caption,,0,0,0,,РАЗМЕЩЕНИИ ВООРУЖЕНИЙ И ОБЩИХ ПРАВИЛАХ БЕЗОПАСНОСТИ.
Dialogue: 0,0:02:09.72,0:02:12.95,Caption,,0,0,0,,ЗАПАД РОССИЙСКИЕ ТРЕБОВАНИЯ ОТВЕРГ. УКРАИНА И ЕВРОПА
Dialogue: 0,0:02:12.95,0:02:15.83,Caption,,0,0,0,,ФОРМУЛИРУЮТ СВОИ УСЛОВИЯ. ТЕПЕРЬ АМЕРИКА ПЫТАЕТСЯ
Dialogue: 0,0:02:15.83,0:02:18.63,Caption,,0,0,0,,НАЧАТЬ БОЛЕЕ ШИРОКИЙ РАЗГОВОР. НА ЭТО ЧАСТЬ
Dialogue: 0,0:02:18.63,0:02:20.39,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ПОЛИТИКОВ ОТВЕЧАЕТ,
Dialogue: 0,0:02:20.63,0:02:22.79,Caption,,0,0,0,,ЧТО ОБСУЖДАТЬ СИСТЕМУ НЕ СОБИРАЕТСЯ,
Dialogue: 0,0:02:22.95,0:02:25.75,Caption,,0,0,0,,ПОСКОЛЬКУ ОНА УЖЕ СУЩЕСТВУЕТ. ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:02:28.02,0:02:31.54,Caption,,0,0,0,,ДОМ ПОЛЫХАЕТ, А ПРЕДСЕДАТЕЛЬ ТОВАРИЩЕСТВА СОБСТВЕННИКОВ ЖИЛЬЯ
Dialogue: 0,0:02:31.54,0:02:35.46,Caption,,0,0,0,,ДОСТАЁТ ПАПКУ И СООБЩАЕТ, ЧТО ПРОЕКТ ЗДАНИЯ ДАВНО УТВЕРЖДЁН,
Dialogue: 0,0:02:35.70,0:02:40.58,Caption,,0,0,0,,ПОЭТОМУ МЕНЯТЬ НИЧЕГО НЕЛЬЗЯ. ТУ ЖЕ ЛИНИЮ ПРОДВИГАЕТ НЫНЕШНИЙ ЭСТОНСКИЙ ПРЕМЬЕР
Dialogue: 0,0:02:40.58,0:02:43.06,Caption,,0,0,0,,КРИСТЕН МИХАЛ. ПО СЛОВАМ МИХАЛА,
Dialogue: 0,0:02:43.31,0:02:45.94,Caption,,0,0,0,,ЕВРОПЕ НЕ СЛЕДУЕТ СТАНОВИТЬСЯ ПОСРЕДНИКОМ МЕЖДУ
Dialogue: 0,0:02:45.94,0:02:50.10,Caption,,0,0,0,,РОССИЕЙ И УКРАИНОЙ, ИСКАТЬ КАНАЛ ОБЩЕНИЯ С МОСКВОЙ ИЛИ ПЫТАТЬСЯ
Dialogue: 0,0:02:50.10,0:02:52.98,Caption,,0,0,0,,ПОНРАВИТЬСЯ ПУТИНУ. НУЖНО ПРОДОЛЖАТЬ ДАВЛЕНИЕ,
Dialogue: 0,0:02:53.22,0:02:56.26,Caption,,0,0,0,,ВВОДИТЬ САНКЦИИ И УЖЕСТОЧАТЬ ВИЗОВЫЕ ОГРАНИЧЕНИЯ.
Dialogue: 0,0:02:56.48,0:03:01.46,Caption,,0,0,0,,ИНЫМИ СЛОВАМИ, ПОСРЕДНИК ЛИШНИЙ. ПРЯМОЙ РАЗГОВОР ЛИШНИЙ. ДАВЛЕНИЕ
Dialogue: 0,0:03:01.54,0:03:05.38,Caption,,0,0,0,,НЕОБХОДИМО. ХОРОШО. А ЧЕМ ВСЁ ЭТО ДОЛЖНО ЗАВЕРШИТЬСЯ?
Dialogue: 0,0:03:05.86,0:03:10.50,Caption,,0,0,0,,РОССИЯ ОДНАЖДЫ ПРОСЫПАЕТСЯ, ЧИТАЕТ СООБЩЕНИЕ ОБ ОЧЕРЕДНОМ САНКЦИОННОМ ПАКЕТЕ И
Dialogue: 0,0:03:10.58,0:03:15.62,Caption,,0,0,0,,ГОВОРИТ МУЖИКИ, ВСЁ, УБЕДИЛИ? ИЛИ СУЩЕСТВУЕТ МАГИЧЕСКОЕ КОЛИЧЕСТВО ПАКЕТОВ,
Dialogue: 0,0:03:15.86,0:03:18.18,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО МИР ВКЛЮЧАЕТСЯ АВТОМАТИЧЕСКИ?
Dialogue: 0,0:03:18.49,0:03:21.86,Caption,,0,0,0,,САНКЦИИ ВВОДЯТСЯ ГОДАМИ. ТЕПЕРЬ ЕВРОКОМИССИЯ СОЗДАЁТ
Dialogue: 0,0:03:21.86,0:03:25.22,Caption,,0,0,0,,ПОСТОЯННЫЙ ОФИС, КОТОРЫЙ БУДЕТ РАЗРАБАТЫВАТЬ ОГРАНИЧЕНИЯ,
Dialogue: 0,0:03:25.46,0:03:28.10,Caption,,0,0,0,,СЛЕДИТЬ ЗА ИХ ИСПОЛНЕНИЕМ И БОРОТЬСЯ С ОБХОДОМ.
Dialogue: 0,0:03:28.34,0:03:31.22,Caption,,0,0,0,,ЭТО УЖЕ НЕ ВРЕМЕННАЯ ГРУППА. САНКЦИОННАЯ ПОЛИТИКА
Dialogue: 0,0:03:31.22,0:03:34.34,Caption,,0,0,0,,ПОЛУЧАЕТ СОБСТВЕННОЕ ПОСТОЯННОЕ УЧРЕЖДЕНИЕ. У НАС
Dialogue: 0,0:03:34.42,0:03:39.46,Caption,,0,0,0,,ТУТ БИЗНЕС. РАЗУМЕЕТСЯ, ТРАМП НЕ ПРОНИКСЯ ЛЮБОВЬЮ К РОССИИ. ГОСУДАРСТВА
Dialogue: 0,0:03:39.54,0:03:42.10,Caption,,0,0,0,,ВООБЩЕ НЕЧАСТО ПРИНИМАЮТ РЕШЕНИЯ ИЗ БОЛЬШОЙ ЛЮБВИ.
Dialogue: 0,0:03:44.38,0:03:46.78,Caption,,0,0,0,,У ВАШИНГТОНА ЕСТЬ ДЕНЬГИ, РЕСУРСЫ,
Dialogue: 0,0:03:46.86,0:03:52.38,Caption,,0,0,0,,СДЕЛКИ, ВЛИЯНИЕ, КИТАЙ, ЕВРОПЕЙСКИЕ РАСХОДЫ НА ОБОРОНУ И СОБСТВЕННЫЕ
Dialogue: 0,0:03:52.38,0:03:56.38,Caption,,0,0,0,,СТРАТЕГИЧЕСКИЕ ИНТЕРЕСЫ. ТРАМП СЧИТАЕТ ИЗДЕРЖКИ И ПРИХОДИТ К ВЫВОДУ,
Dialogue: 0,0:03:56.62,0:03:59.26,Caption,,0,0,0,,ЧТО ДОГОВОРЁННОСТЬ МОЖЕТ БЫТЬ ВЫГОДНЕЕ БЕСКОНЕЧНОГО
Dialogue: 0,0:03:59.26,0:04:02.78,Caption,,0,0,0,,ПРОЦЕССА. ЕВРОПЕЙСКИЙ ПОЛИТИЧЕСКИЙ ЦЕНТР ДЕРЖИТСЯ ЗА
Dialogue: 0,0:04:02.78,0:04:05.02,Caption,,0,0,0,,ПРЕЖНЮЮ ЛОГИКУ. ДАВИТЬ НА РОССИЮ,
Dialogue: 0,0:04:05.26,0:04:10.46,Caption,,0,0,0,,ОГРАНИЧИВАТЬ ЕЁ ВОЗМОЖНОСТИ, УСИЛИВАТЬ САНКЦИИ И НЕ ПОЗВОЛЯТЬ МОСКВЕ ВЛИЯТЬ НА
Dialogue: 0,0:04:10.46,0:04:13.34,Caption,,0,0,0,,УСТРОЙСТВО ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. СУДЯ ПО ЭТОЙ
Dialogue: 0,0:04:13.42,0:04:16.86,Caption,,0,0,0,,ЛОГИКЕ, РОССИЮ ПРЕДПОЛАГАЛОСЬ ДОВЕСТИ ДО ВОЕННОГО ПОРАЖЕНИЯ,
Dialogue: 0,0:04:17.02,0:04:21.34,Caption,,0,0,0,,А ЗАТЕМ ДИКТОВАТЬ ЕЙ УСЛОВИЯ, В ТОМ ЧИСЛЕ В ВОПРОСАХ РЕСУРСОВ. НО ГЛАВНЫМ
Dialogue: 0,0:04:21.42,0:04:23.98,Caption,,0,0,0,,СИЛОВЫМ И ФИНАНСОВЫМ ЭЛЕМЕНТОМ РАСЧЁТА БЫЛИ
Dialogue: 0,0:04:24.06,0:04:27.42,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ. ПРИ ТРАМПЕ ЭТОТ ЭЛЕМЕНТ НАЧИНАЕТ
Dialogue: 0,0:04:27.42,0:04:30.46,Caption,,0,0,0,,ВЫПАДАТЬ. АМЕРИКАНСКАЯ ПОЗИЦИЯ ВСЁ БОЛЬШЕ НАПОМИНАЕТ
Dialogue: 0,0:04:30.54,0:04:33.50,Caption,,0,0,0,,ПРОСТОЕ ПРЕДЛОЖЕНИЕ. ХОТИТЕ ПРОДОЛЖАТЬ ПРЕЖНИЙ КУРС,
Dialogue: 0,0:04:33.70,0:04:35.82,Caption,,0,0,0,,ПРОДОЛЖАЙТЕ. ТОЛЬКО БЕЗ УВЕРЕННОСТИ,
Dialogue: 0,0:04:36.05,0:04:38.22,Caption,,0,0,0,,ЧТО АМЕРИКА БУДЕТ БЕСКОНЕЧНО ОПЛАЧИВАТЬ,
Dialogue: 0,0:04:38.40,0:04:41.74,Caption,,0,0,0,,ВООРУЖАТЬ И СТРАХОВАТЬ ВЕСЬ ПРОЦЕСС. ОТСЮДА
Dialogue: 0,0:04:41.82,0:04:44.70,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ НЕРВОЗНОСТЬ. ДЕЛО НЕ ТОЛЬКО В ТОМ,
Dialogue: 0,0:04:44.86,0:04:47.74,Caption,,0,0,0,,ЧТО ТРАМП РЕШИЛ РАЗГОВАРИВАТЬ С МОСКВОЙ. ГОРАЗДО
Dialogue: 0,0:04:47.74,0:04:51.10,Caption,,0,0,0,,НЕПРИЯТНЕЕ, ЧТО ОН МОЖЕТ ВЫЙТИ ИЗ СТАРОЙ СХЕМЫ И
Dialogue: 0,0:04:51.18,0:04:54.06,Caption,,0,0,0,,ОСТАВИТЬ ЕЁ АВТОРАМ ПРАВО САМОСТОЯТЕЛЬНО ВЫЯСНИТЬ,
Dialogue: 0,0:04:54.22,0:04:57.50,Caption,,0,0,0,,РАБОТАЕТ ЛИ ОНА БЕЗ ГЛАВНОГО КОМПОНЕНТА. ЭТО ДВЕ
Dialogue: 0,0:04:57.50,0:05:04.59,Caption,,0,0,0,,СОВЕРШЕННО РАЗНЫЕ СТРАТЕГИИ. ЭСТОНИЯ ТРЕБУЕТ СИЛЬНЕЕ ПРИЖИМАТЬ МОСКВУ. ЛИТВА
Dialogue: 0,0:05:04.59,0:05:08.51,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ, ЧТО ДОВЕРЯТЬ РОССИИ НЕЛЬЗЯ. ЛИТОВСКИЙ ПРЕЗИДЕНТ
Dialogue: 0,0:05:08.51,0:05:11.71,Caption,,0,0,0,,ГИТАНАС НАУСЕДА ГОВОРИТ О ПРОВОКАЦИЯХ ПРОТИВ СТРАН
Dialogue: 0,0:05:11.71,0:05:15.07,Caption,,0,0,0,,НАТО И ПРОВЕРКЕ КРАСНЫХ ЛИНИЙ АЛЬЯНСА. И ТУТ
Dialogue: 0,0:05:15.15,0:05:16.67,Caption,,0,0,0,,ВСПОМИНАЕТСЯ ЗНАМЕНИТАЯ ФРАЗА,
Dialogue: 0,0:05:16.91,0:05:19.47,Caption,,0,0,0,,КОТОРУЮ ПРИПИСЫВАЮТ СТАЛИНУ. "А СКОЛЬКО У НИХ
Dialogue: 0,0:05:19.47,0:05:22.03,Caption,,0,0,0,,ДИВИЗИЙ?" ВОТ ДЕЙСТВИТЕЛЬНО. А СКОЛЬКО?
Dialogue: 0,0:05:22.24,0:05:23.95,Caption,,0,0,0,,ПО ТОНУ ЗАЯВЛЕНИЙ МОЖНО ПОДУМАТЬ,
Dialogue: 0,0:05:24.17,0:05:26.91,Caption,,0,0,0,,ЧТО ЭСТОНИЯ РАСПОЛАГАЕТ АРМИЕЙ РАЗМЕРОМ С ПОЛОВИНУ
Dialogue: 0,0:05:26.91,0:05:29.63,Caption,,0,0,0,,ЕВРОПЫ, ЛИТВА КОМАНДУЕТ ВТОРОЙ ПОЛОВИНОЙ,
Dialogue: 0,0:05:29.93,0:05:34.19,Caption,,0,0,0,,А КАЛЛАС ОСТАЛОСЬ ВЫБРАТЬ, С КАКОЙ СТОРОНЫ ПРИНИМАТЬ ПАРАД. В ДЕЙСТВИТЕЛЬНОСТИ
Dialogue: 0,0:05:34.27,0:05:37.07,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ЭТИХ СТРАН ОПИРАЕТСЯ ПРЕЖДЕ ВСЕГО НА
Dialogue: 0,0:05:37.07,0:05:42.59,Caption,,0,0,0,,НАТО, АМЕРИКАНСКИЕ ГАРАНТИИ, СИЛЫ СОЮЗНИКОВ И ОБЩУЮ ВОЕННУЮ ИНФРАСТРУКТУРУ.
Dialogue: 0,0:05:42.81,0:05:45.63,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗНАКОМАЯ КАРТИНА. САМЫЕ МАЛЕНЬКИЕ
Dialogue: 0,0:05:45.71,0:05:48.43,Caption,,0,0,0,,УЧАСТНИКИ СНОВА ГОВОРЯТ ГРОМЧЕ ВСЕХ. ЭТО НЕ
Dialogue: 0,0:05:48.43,0:05:51.79,Caption,,0,0,0,,ОЗНАЧАЕТ, ЧТО ИХ ОПАСЕНИЯ СЛЕДУЕТ ИГНОРИРОВАТЬ. НО КОГДА
Dialogue: 0,0:05:51.79,0:05:55.07,Caption,,0,0,0,,РЕШАЮТ, КАК НЕ ДОВЕСТИ КОНТИНЕНТ ДО БОЛЬШОЙ БЕДЫ,
Dialogue: 0,0:05:55.31,0:05:58.11,Caption,,0,0,0,,ОДНОЙ ГРОМКОСТИ НЕДОСТАТОЧНО. НУЖНО ОТВЕТИТЬ,
Dialogue: 0,0:05:58.26,0:06:00.27,Caption,,0,0,0,,ЧТО ИМЕННО ВЫ ПРЕДЛАГАЕТЕ СДЕЛАТЬ,
Dialogue: 0,0:06:00.43,0:06:03.23,Caption,,0,0,0,,ЧТОБЫ ПОЛОЖЕНИЕ СТАЛО БЕЗОПАСНЕЕ. НЕ В СЛЕДУЮЩЕМ
Dialogue: 0,0:06:03.23,0:06:06.43,Caption,,0,0,0,,ВЫСТУПЛЕНИИ. НЕ В ОЧЕРЕДНОМ САНКЦИОННОМ ПАКЕТЕ. В
Dialogue: 0,0:06:06.43,0:06:10.03,Caption,,0,0,0,,НАСТОЯЩЕЙ ЖИЗНИ. ПОКА АРИФМЕТИКА ВЫГЛЯДИТ СТРАННО.
Dialogue: 0,0:06:10.33,0:06:13.47,Caption,,0,0,0,,РАЗГОВАРИВАТЬ С МОСКВОЙ БЕСПОЛЕЗНО. УСТУПАТЬ НЕЛЬЗЯ.
Dialogue: 0,0:06:13.63,0:06:20.47,Caption,,0,0,0,,ДАВЛЕНИЕ СЛЕДУЕТ УСИЛИВАТЬ. А НАСЕЛЕНИЮ ЕВРОПЫ ЖЕЛАТЕЛЬНО ГОТОВИТЬСЯ К СЕРЬЁЗНЫМ
Dialogue: 0,0:06:20.47,0:06:23.51,Caption,,0,0,0,,КРИЗИСАМ И УЧИТЬСЯ ОБХОДИТЬСЯ СОБСТВЕННЫМИ СИЛАМИ.
Dialogue: 0,0:06:23.95,0:06:26.79,Caption,,0,0,0,,ЕВРОПЕЙЦАМ СОВЕТУЮТ ДЕРЖАТЬ ДОМА ЗАПАС ВОДЫ,
Dialogue: 0,0:06:26.94,0:06:30.87,Caption,,0,0,0,,ЕДЫ, ЛЕКАРСТВ И НАЛИЧНЫХ, ИМЕТЬ ФОНАРИ И РАДИО,
Dialogue: 0,0:06:31.03,0:06:33.43,Caption,,0,0,0,,ЧТОБЫ ПРОЖИТЬ ХОТЯ БЫ ТРОЕ СУТОК БЕЗ ПРИВЫЧНОЙ
Dialogue: 0,0:06:33.43,0:06:36.23,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ. САМА ПО СЕБЕ ТАКАЯ ПОДГОТОВКА
Dialogue: 0,0:06:36.23,0:06:39.27,Caption,,0,0,0,,РАЗУМНА. ГОСУДАРСТВО ОБЯЗАНО УЧИТЫВАТЬ АВАРИИ,
Dialogue: 0,0:06:39.41,0:06:42.55,Caption,,0,0,0,,ОТКЛЮЧЕНИЯ И КИБЕРАТАКИ. НО ПОСТАВИМ ЭТОТ СОВЕТ
Dialogue: 0,0:06:42.63,0:06:45.35,Caption,,0,0,0,,РЯДОМ С ПОЛИТИЧЕСКИМИ ЗАЯВЛЕНИЯМИ. ПЕРЕГОВОРЫ НЕ
Dialogue: 0,0:06:45.43,0:06:48.47,Caption,,0,0,0,,НУЖНЫ. ДАВЛЕНИЕ УВЕЛИЧИВАЕМ. САНКЦИОННУЮ СИСТЕМУ
Dialogue: 0,0:06:48.47,0:06:51.59,Caption,,0,0,0,,ПРЕВРАЩАЕМ В ПОСТОЯННУЮ. ОГРАНИЧЕНИЯ РАСШИРЯЕМ.
Dialogue: 0,0:06:51.83,0:06:54.31,Caption,,0,0,0,,ГРАЖДАН УЧИМ ЖИТЬ БЕЗ НОРМАЛЬНОЙ ИНФРАСТРУКТУРЫ.
Dialogue: 0,0:06:54.60,0:06:57.59,Caption,,0,0,0,,МУЖИКИ, А КУДА ЕДЕМ? ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ,
Dialogue: 0,0:06:57.73,0:07:00.87,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДАЛЬШЕ РЕЧЬ УЖЕ НЕ О КОНКРЕТНОЙ ФРАЗЕ
Dialogue: 0,0:07:00.87,0:07:05.91,Caption,,0,0,0,,КАЛЛАС ИЛИ МИХАЛА, А О КОНЕЧНОЙ СТАНЦИИ ВСЕЙ ЭТОЙ ПОЛИТИКИ. ФИНЛЯНДИЯ
Dialogue: 0,0:07:05.99,0:07:08.95,Caption,,0,0,0,,ГОТОВИТ НОВЫЕ ОГРАНИЧЕНИЯ НА ВЪЕЗД ГРАЖДАН РОССИИ.
Dialogue: 0,0:07:09.19,0:07:11.19,Caption,,0,0,0,,ПОД НИХ МОГУТ ПОПАСТЬ ДАЖЕ ПРОФЕССИОНАЛЬНЫЕ
Dialogue: 0,0:07:11.19,0:07:13.99,Caption,,0,0,0,,СПОРТСМЕНЫ. В ОГРОМНОЙ КОНСТРУКЦИИ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:07:13.99,0:07:17.27,Caption,,0,0,0,,БЕЗОПАСНОСТИ НАШЛОСЬ ВАЖНОЕ МЕСТО И ДЛЯ ХОККЕИСТА.
Dialogue: 0,0:07:17.64,0:07:20.39,Caption,,0,0,0,,ГЕОПОЛИТИКА СЕРЬЁЗНЕЙШАЯ. РОССИЯ,
Dialogue: 0,0:07:20.53,0:07:23.67,Caption,,0,0,0,,НАТО, УКРАИНА, АРМИИ, РАКЕТЫ,
Dialogue: 0,0:07:23.83,0:07:26.71,Caption,,0,0,0,,СТРАТЕГИЧЕСКАЯ СТАБИЛЬНОСТЬ. А В ЦЕНТРЕ КАРТИНЫ
Dialogue: 0,0:07:26.71,0:07:29.11,Caption,,0,0,0,,СТОИТ ЧЕЛОВЕК С КЛЮШКОЙ. ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:07:29.35,0:07:31.99,Caption,,0,0,0,,ЧТО ОН ТОЖЕ ИНСТРУМЕНТ ДАВЛЕНИЯ. ПРЕДПОЛОЖИМ,
Dialogue: 0,0:07:32.15,0:07:34.95,Caption,,0,0,0,,СПОРТСМЕНА НЕ ПУСТИЛИ. ЧТО ИЗМЕНИЛОСЬ ДАЛЬШЕ?
Dialogue: 0,0:07:37.24,0:07:39.88,Caption,,0,0,0,,СЛЕДОМ ПОЯВЛЯЕТСЯ ПОЛЬША. РАДОСЛАВ СИКОРСКИЙ
Dialogue: 0,0:07:39.88,0:07:42.52,Caption,,0,0,0,,ПРЕДЛАГАЕТ ПРЕЗИДЕНТУ КАРОЛЮ НАВРОЦКОМУ ИСПОЛЬЗОВАТЬ
Dialogue: 0,0:07:42.52,0:07:47.16,Caption,,0,0,0,,ХОРОШИЕ ОТНОШЕНИЯ С ТРАМПОМ, ЧТОБЫ ПОВЛИЯТЬ НА ПОЗИЦИЮ СОЕДИНЁННЫХ ШТАТОВ В
Dialogue: 0,0:07:47.16,0:07:50.36,Caption,,0,0,0,,ИНТЕРЕСАХ УКРАИНЫ. ОДНОВРЕМЕННО СИКОРСКИЙ ПРОИЗНОСИТ
Dialogue: 0,0:07:50.36,0:07:53.64,Caption,,0,0,0,,РАЗУМНУЮ ВЕЩЬ. ОБСУЖДАТЬ БЕЗОПАСНОСТЬ ЕВРОПЫ БЕЗ
Dialogue: 0,0:07:53.72,0:07:56.92,Caption,,0,0,0,,ВОСТОЧНОЙ ЕВРОПЫ НЕЛЬЗЯ. СНОВА ПРАВИЛЬНО. ВСЕ
Dialogue: 0,0:07:56.92,0:08:00.04,Caption,,0,0,0,,ТРЕБУЮТ СТУЛ У ПЕРЕГОВОРНОГО СТОЛА. НО СОГЛАСОВАТЬ
Dialogue: 0,0:08:00.04,0:08:02.20,Caption,,0,0,0,,ХОТЯ БЫ ИСХОДНЫЕ ПОЗИЦИИ НИКТО НЕ МОЖЕТ.
Dialogue: 0,0:08:02.76,0:08:05.40,Caption,,0,0,0,,АМЕРИКА ПРЕДЛАГАЕТ ОБСУЖДАТЬ ОБЩУЮ БЕЗОПАСНОСТЬ.
Dialogue: 0,0:08:05.72,0:08:08.12,Caption,,0,0,0,,РУКОВОДСТВО ЕВРОСОЮЗА НЕ ХОЧЕТ ПЕРЕСМАТРИВАТЬ
Dialogue: 0,0:08:08.12,0:08:11.48,Caption,,0,0,0,,СУЩЕСТВУЮЩУЮ КОНСТРУКЦИЮ. ПОЛЬША НАСТАИВАЕТ НА
Dialogue: 0,0:08:11.48,0:08:14.52,Caption,,0,0,0,,УЧАСТИИ ВОСТОЧНОЙ ЕВРОПЫ. ЭСТОНИЯ ОТВЕРГАЕТ
Dialogue: 0,0:08:14.52,0:08:17.88,Caption,,0,0,0,,ПОСРЕДНИЧЕСТВО. ЛИТВА НЕ ВЕРИТ РОССИИ. УКРАИНА
Dialogue: 0,0:08:17.88,0:08:21.80,Caption,,0,0,0,,ОПАСАЕТСЯ, ЧТО НОВАЯ ДОГОВОРЁННОСТЬ ОКАЖЕТСЯ ДЛЯ НЕЁ ОПАСНОЙ. И
Dialogue: 0,0:08:21.88,0:08:25.32,Caption,,0,0,0,,ВСЯ ЭТА КОМПАНИЯ ОДНОВРЕМЕННО ТРЕБУЕТ ПОСАДИТЬ ЕЁ ЗА
Dialogue: 0,0:08:25.32,0:08:27.88,Caption,,0,0,0,,ОДИН СТОЛ. Я ДАЖЕ НЕ ПЫТАЮСЬ ОПРЕДЕЛИТЬ,
Dialogue: 0,0:08:27.96,0:08:31.64,Caption,,0,0,0,,КТО ПРАВ. ВОПРОС ПРОЩЕ. ЧТО ИМЕННО ОНИ СОБИРАЮТСЯ
Dialogue: 0,0:08:31.64,0:08:34.52,Caption,,0,0,0,,ТАМ ПОДПИСЫВАТЬ? ПЕРЕГОВОРЫ НУЖНЫ НЕ ДЛЯ ТОГО,
Dialogue: 0,0:08:34.68,0:08:37.72,Caption,,0,0,0,,ЧТОБЫ КАЖДЫЙ ПРИНЁС ПАПКУ СО СВОИМИ КРАСНЫМИ ЛИНИЯМИ
Dialogue: 0,0:08:37.96,0:08:39.80,Caption,,0,0,0,,И НЕСКОЛЬКО ЧАСОВ ОБЪЯСНЯЛ СОСЕДЯМ,
Dialogue: 0,0:08:39.97,0:08:43.08,Caption,,0,0,0,,ПОЧЕМУ ЕЁ ЗАПРЕЩЕНО ДВИГАТЬ. НАСТОЯЩИЙ РАЗГОВОР
Dialogue: 0,0:08:43.08,0:08:47.00,Caption,,0,0,0,,НАЧИНАЕТСЯ, КОГДА ВОЗНИКАЕТ ПРЕДМЕТ ОБМЕНА. КТО ЧТО
Dialogue: 0,0:08:47.00,0:08:50.60,Caption,,0,0,0,,ОГРАНИЧИВАЕТ. КТО ЧТО ГАРАНТИРУЕТ. ГДЕ ПРОХОДИТ
Dialogue: 0,0:08:50.60,0:08:53.24,Caption,,0,0,0,,ВОЕННАЯ ИНФРАСТРУКТУРА. КАКИЕ ВООРУЖЕНИЯ
Dialogue: 0,0:08:53.24,0:08:59.35,Caption,,0,0,0,,РАЗМЕЩАЮТСЯ. КАК КОНТРОЛИРУЕТСЯ СОБЛЮДЕНИЕ ДОГОВОРЁННОСТЕЙ. ЧТО
Dialogue: 0,0:08:59.35,0:09:02.87,Caption,,0,0,0,,ПРОИСХОДИТ ПРИ НАРУШЕНИИ. КТО ЯВЛЯЕТСЯ ГАРАНТОМ. ВОТ
Dialogue: 0,0:09:02.87,0:09:06.07,Caption,,0,0,0,,ТОГДА ПОЯВЛЯЕТСЯ СОДЕРЖАНИЕ. ПРОБЛЕМА БЕЗОПАСНОСТИ
Dialogue: 0,0:09:06.15,0:09:10.95,Caption,,0,0,0,,НЕ ЗАКАНЧИВАЕТСЯ ДОНБАССОМ, УКРАИНОЙ ИЛИ ЛИНИЕЙ ФРОНТА. ДАЖЕ ЕСЛИ СТРЕЛЬБА
Dialogue: 0,0:09:10.95,0:09:15.11,Caption,,0,0,0,,ОСТАНОВИТСЯ, РОССИЯ ОСТАНЕТСЯ НА МЕСТЕ. НАТО ТОЖЕ НИКУДА НЕ
Dialogue: 0,0:09:15.11,0:09:17.99,Caption,,0,0,0,,ДЕНЕТСЯ. СОХРАНЯТСЯ ПОЛЬША, ЛИТВА,
Dialogue: 0,0:09:18.07,0:09:21.83,Caption,,0,0,0,,ЭСТОНИЯ И УКРАИНА. СОСЕДИ ПРОДОЛЖАТ БЫТЬ СОСЕДЯМИ.
Dialogue: 0,0:09:22.06,0:09:25.59,Caption,,0,0,0,,СЛЕДОВАТЕЛЬНО, ИМ ПРИДЁТСЯ ЛИБО ОПРЕДЕЛИТЬ ПРАВИЛА СОВМЕСТНОГО
Dialogue: 0,0:09:25.59,0:09:29.27,Caption,,0,0,0,,СУЩЕСТВОВАНИЯ, ЛИБО И ДАЛЬШЕ СТРОИТЬ СОБСТВЕННУЮ БЕЗОПАСНОСТЬ
Dialogue: 0,0:09:29.27,0:09:32.23,Caption,,0,0,0,,ПРОТИВ ВСЕХ ОСТАЛЬНЫХ. НО НЕВОЗМОЖНО БЕСКОНЕЧНО
Dialogue: 0,0:09:32.23,0:09:34.79,Caption,,0,0,0,,УКРЕПЛЯТЬ БЕЗОПАСНОСТЬ ОДНОГО СОСЕДА ЧЕРЕЗ
Dialogue: 0,0:09:34.79,0:09:37.99,Caption,,0,0,0,,ПОСТОЯННОЕ ОЩУЩЕНИЕ УГРОЗЫ У ДРУГОГО. МЕХАНИЗМ
Dialogue: 0,0:09:37.99,0:09:40.87,Caption,,0,0,0,,ЭЛЕМЕНТАРНЫЙ. ТЫ СТЯГИВАЕШЬ ВОЙСКА К ГРАНИЦЕ,
Dialogue: 0,0:09:41.13,0:09:44.07,Caption,,0,0,0,,ПОТОМУ ЧТО ОПАСАЕШЬСЯ МЕНЯ. Я ЗАМЕЧАЮ ИХ И
Dialogue: 0,0:09:44.07,0:09:47.83,Caption,,0,0,0,,УСИЛИВАЮ СВОИ, ПОТОМУ ЧТО ОПАСАЮСЬ ТЕБЯ. ТЫ СМОТРИШЬ НА МОЁ
Dialogue: 0,0:09:47.83,0:09:51.91,Caption,,0,0,0,,УСИЛЕНИЕ И УБЕЖДАЕШЬСЯ, ЧТО С САМОГО НАЧАЛА БЫЛ ПРАВ. Я ВИЖУ
Dialogue: 0,0:09:51.99,0:09:53.99,Caption,,0,0,0,,ТВОЮ РЕАКЦИЮ И ПРИХОЖУ К ТОМУ ЖЕ ВЫВОДУ.
Dialogue: 0,0:09:54.22,0:09:58.15,Caption,,0,0,0,,ИДЕАЛЬНАЯ КОНСТРУКЦИЯ. ПРАВЫ АБСОЛЮТНО ВСЕ. ТОЛЬКО
Dialogue: 0,0:09:58.15,0:10:00.63,Caption,,0,0,0,,КОЛИЧЕСТВО РАКЕТ ПОЧЕМУ ТО РАСТЁТ. ПОЭТОМУ
Dialogue: 0,0:10:00.63,0:10:03.67,Caption,,0,0,0,,ОБСУЖДЕНИЕ НОВОЙ АРХИТЕКТУРЫ БЕЗОПАСНОСТИ НЕ
Dialogue: 0,0:10:03.67,0:10:06.71,Caption,,0,0,0,,ЯВЛЯЕТСЯ ПОДАРКОМ МОСКВЕ. ЭТО ПОПЫТКА УСТАНОВИТЬ
Dialogue: 0,0:10:06.71,0:10:10.87,Caption,,0,0,0,,ПРАВИЛА ТАМ, ГДЕ ПРЕЖНИЕ ЯВНО НЕ СМОГЛИ ПРЕДОТВРАТИТЬ КРИЗИС.
Dialogue: 0,0:10:11.03,0:10:13.91,Caption,,0,0,0,,ЕВРОПА НЕ ОБЯЗАНА ПРИНИМАТЬ АМЕРИКАНСКИЙ ПРОЕКТ.
Dialogue: 0,0:10:16.19,0:10:19.79,Caption,,0,0,0,,НЕ УСТРАИВАЕТ, ПРЕДЛОЖИТЕ ДРУГОЙ. НО ОН НЕ МОЖЕТ СОСТОЯТЬ ИЗ
Dialogue: 0,0:10:19.79,0:10:23.31,Caption,,0,0,0,,ОДНОЙ ФРАЗЫ ДАВАЙТЕ НАДАВИМ ЕЩЁ СИЛЬНЕЕ. САНКЦИИ,
Dialogue: 0,0:10:23.47,0:10:27.07,Caption,,0,0,0,,ДАВЛЕНИЕ, ОГРАНИЧЕНИЯ И ВОЕННОЕ СДЕРЖИВАНИЕ ЯВЛЯЮТСЯ
Dialogue: 0,0:10:27.07,0:10:29.79,Caption,,0,0,0,,ИНСТРУМЕНТАМИ. ИНСТРУМЕНТ БЕЗ ОБОЗНАЧЕННОГО
Dialogue: 0,0:10:29.79,0:10:32.27,Caption,,0,0,0,,РЕЗУЛЬТАТА ПРЕВРАЩАЕТСЯ В ПРИВЫЧНОЕ ДВИЖЕНИЕ,
Dialogue: 0,0:10:32.51,0:10:34.99,Caption,,0,0,0,,КОТОРОЕ ПРОДОЛЖАЮТ ПОТОМУ, ЧТО УЖЕ НАЧАЛИ.
Dialogue: 0,0:10:35.62,0:10:38.11,Caption,,0,0,0,,И ЗДЕСЬ ХОЧЕТСЯ ЗАДАТЬ СТОРОННИКАМ ЖЁСТКОЙ ЛИНИИ
Dialogue: 0,0:10:38.19,0:10:41.55,Caption,,0,0,0,,ПРЯМОЙ ВОПРОС. КАКОГО РЕЗУЛЬТАТА ВЫ ХОТИТЕ ДОБИТЬСЯ?
Dialogue: 0,0:10:41.78,0:10:44.51,Caption,,0,0,0,,РОССИЯ ДОЛЖНА КАПИТУЛИРОВАТЬ? СМЕНИТЬ РУКОВОДСТВО?
Dialogue: 0,0:10:44.80,0:10:47.15,Caption,,0,0,0,,ОТКАЗАТЬСЯ ОТ ТРЕБОВАНИЙ В СФЕРЕ БЕЗОПАСНОСТИ?
Dialogue: 0,0:10:47.45,0:10:49.55,Caption,,0,0,0,,ПОЛНОСТЬЮ ВЫЙТИ ИЗ КОНФЛИКТА НА ЕВРОПЕЙСКИХ
Dialogue: 0,0:10:49.55,0:10:52.27,Caption,,0,0,0,,УСЛОВИЯХ? ЕСЛИ НИЧЕГО ЭТОГО НЕ ПРОИСХОДИТ,
Dialogue: 0,0:10:52.59,0:10:54.27,Caption,,0,0,0,,КАКОЙ ШАГ ПОСЛЕДУЕТ ЧЕРЕЗ ГОД?
Dialogue: 0,0:10:54.57,0:10:57.71,Caption,,0,0,0,,НОВЫЙ ПАКЕТ САНКЦИЙ? ДОПОЛНИТЕЛЬНЫЕ ПОСТАВКИ ОРУЖИЯ?
Dialogue: 0,0:10:57.96,0:10:59.79,Caption,,0,0,0,,ЕЩЁ БОЛЕЕ ШИРОКИЕ ОГРАНИЧЕНИЯ?
Dialogue: 0,0:11:00.09,0:11:02.51,Caption,,0,0,0,,ВТОРОЙ ПОСТОЯННЫЙ ОФИС РЯДОМ С ПЕРВЫМ,
Dialogue: 0,0:11:02.65,0:11:04.27,Caption,,0,0,0,,ЧТОБЫ ПЕРВОМУ НЕ БЫЛО ОДИНОКО?
Dialogue: 0,0:11:04.50,0:11:07.15,Caption,,0,0,0,,ГДЕ ТОЧКА, В КОТОРОЙ МОЖНО БУДЕТ СКАЗАТЬ,
Dialogue: 0,0:11:07.30,0:11:10.27,Caption,,0,0,0,,ЧТО ЦЕЛИ ВЫПОЛНЕНЫ? ЕСЛИ ЕЁ НЕ СУЩЕСТВУЕТ,
Dialogue: 0,0:11:10.61,0:11:13.15,Caption,,0,0,0,,ПЕРЕД НАМИ НЕ СТРАТЕГИЯ ВЫХОДА. ПЕРЕД НАМИ ПРОСТО
Dialogue: 0,0:11:13.15,0:11:17.63,Caption,,0,0,0,,ДОРОГА. ПРИЧЁМ ДОРОГА, НА КОТОРОЙ КАЖДЫЙ ПОВЫШАЕТ СТАВКИ И НАДЕЕТСЯ,
Dialogue: 0,0:11:17.87,0:11:21.23,Caption,,0,0,0,,ЧТО ПЕРВЫМ ОСТАНОВИТСЯ КТО НИБУДЬ ДРУГОЙ. ВОТ ЗДЕСЬ
Dialogue: 0,0:11:21.30,0:11:24.03,Caption,,0,0,0,,СТАНОВИТСЯ НЕ ДО ШУТОК. ПОЗИЦИЯ БАЛТИЙСКИХ
Dialogue: 0,0:11:24.03,0:11:26.59,Caption,,0,0,0,,ГОСУДАРСТВ ПОНЯТНА. ОНИ ВОСПРИНИМАЮТ РОССИЮ КАК
Dialogue: 0,0:11:26.59,0:11:29.55,Caption,,0,0,0,,УГРОЗУ. ПОЛЬША ОЦЕНИВАЕТ ЕЁ ЧЕРЕЗ СВОЮ ИСТОРИЮ.
Dialogue: 0,0:11:31.84,0:11:34.72,Caption,,0,0,0,,УКРАИНА НЕПОСРЕДСТВЕННО УЧАСТВУЕТ В КОНФЛИКТЕ. У
Dialogue: 0,0:11:34.72,0:11:37.60,Caption,,0,0,0,,КАЖДОЙ СТОРОНЫ ЕСТЬ СЕРЬЁЗНЫЕ ПРИЧИНЫ ДЛЯ НЕДОВЕРИЯ.
Dialogue: 0,0:11:38.06,0:11:40.72,Caption,,0,0,0,,НО СТОЛ ПЕРЕГОВОРОВ ИМЕННО ДЛЯ ЭТОГО И ПРИДУМАЛИ.
Dialogue: 0,0:11:41.16,0:11:43.76,Caption,,0,0,0,,ОН НЕ ОСОБЕННО НУЖЕН ДРУЗЬЯМ. ДРУЗЬЯ МОГУТ
Dialogue: 0,0:11:43.84,0:11:45.68,Caption,,0,0,0,,ДОГОВОРИТЬСЯ БЕЗ ДЛИННОГО СТОЛА,
Dialogue: 0,0:11:45.76,0:11:49.12,Caption,,0,0,0,,ПЕРЕВОДЧИКОВ И ПАПОК. ЗА НЕГО САДЯТСЯ ГОСУДАРСТВА,
Dialogue: 0,0:11:49.35,0:11:52.32,Caption,,0,0,0,,КОТОРЫЕ ДРУГ ДРУГУ НЕ ВЕРЯТ. ЕСЛИ СЧИТАТЬ НЕДОВЕРИЕ
Dialogue: 0,0:11:52.32,0:11:54.88,Caption,,0,0,0,,ДОСТАТОЧНОЙ ПРИЧИНОЙ ДЛЯ ОТКАЗА ОТ РАЗГОВОРА,
Dialogue: 0,0:11:55.17,0:11:57.76,Caption,,0,0,0,,ЧЕЛОВЕЧЕСТВУ МОЖНО ЗАКРЫВАТЬ ПЕРЕГОВОРЫ КАК ЖАНР.
Dialogue: 0,0:11:58.14,0:12:00.80,Caption,,0,0,0,,ДОГОВОРИТЬСЯ С ТЕМИ, КОМУ ПОЛНОСТЬЮ ДОВЕРЯЕШЬ,
Dialogue: 0,0:12:01.18,0:12:03.36,Caption,,0,0,0,,ОБЫЧНО И БЕЗ ТОГО НЕ САМАЯ СЛОЖНАЯ ЗАДАЧА.
Dialogue: 0,0:12:03.84,0:12:06.72,Caption,,0,0,0,,ЕВРОПА ВПРАВЕ ОТКЛОНИТЬ ПРЕДЛОЖЕНИЕ АМЕРИКИ. НО
Dialogue: 0,0:12:06.80,0:12:09.84,Caption,,0,0,0,,ТОГДА ПОКАЖИТЕ СВОЙ ВАРИАНТ. С ТОЧНЫМИ УСЛОВИЯМИ,
Dialogue: 0,0:12:10.08,0:12:13.60,Caption,,0,0,0,,МЕХАНИЗМОМ ПРОВЕРКИ, СИСТЕМОЙ ГАРАНТИЙ И ТОЧКОЙ,
Dialogue: 0,0:12:13.84,0:12:16.56,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ДАВЛЕНИЕ ПРЕКРАЩАЕТСЯ. ИНАЧЕ ВСЁ
Dialogue: 0,0:12:16.56,0:12:21.44,Caption,,0,0,0,,СВОДИТСЯ К СТАРОМУ ПЛАНУ, ИЗ КОТОРОГО ИСЧЕЗАЕТ ГЛАВНЫЙ УЧАСТНИК. АМЕРИКА
Dialogue: 0,0:12:21.52,0:12:24.88,Caption,,0,0,0,,ОТХОДИТ В СТОРОНУ, А ЕВРОПЕЙЦАМ ПРЕДЛАГАЮТ ПРОДОЛЖАТЬ ТАК,
Dialogue: 0,0:12:25.10,0:12:27.76,Caption,,0,0,0,,БУДТО НИЧЕГО ПРИНЦИПИАЛЬНО НЕ ИЗМЕНИЛОСЬ. ТОЛЬКО
Dialogue: 0,0:12:27.76,0:12:30.88,Caption,,0,0,0,,ИЗМЕНИЛОСЬ. РАНЬШЕ МОЖНО БЫЛО ГОВОРИТЬ О ВОЕННОМ
Dialogue: 0,0:12:30.88,0:12:34.88,Caption,,0,0,0,,ПОРАЖЕНИИ РОССИИ, БЕСКОНЕЧНОМ ДАВЛЕНИИ И ДОСТУПЕ К РЕСУРСАМ,
Dialogue: 0,0:12:35.04,0:12:37.84,Caption,,0,0,0,,ПРЕДПОЛАГАЯ, ЧТО ЗА ЭТОЙ ЛИНИЕЙ СТОЯТ ДЕНЬГИ,
Dialogue: 0,0:12:38.01,0:12:41.36,Caption,,0,0,0,,ОРУЖИЕ И ГАРАНТИИ СОЕДИНЁННЫХ ШТАТОВ. ТЕПЕРЬ ТРАМП
Dialogue: 0,0:12:41.36,0:12:43.76,Caption,,0,0,0,,ПРЕДЛАГАЕТ ПОСЧИТАТЬ ЦЕНУ И ОПРЕДЕЛИТЬ,
Dialogue: 0,0:12:43.92,0:12:50.37,Caption,,0,0,0,,КАКОЙ РЕЗУЛЬТАТ ДОСТИЖИМ. ИМЕННО ЭТОТ ВОПРОС ВЫЗЫВАЕТ БОЛЬШЕ НЕРВОЗНОСТИ,
Dialogue: 0,0:12:50.53,0:12:53.33,Caption,,0,0,0,,ЧЕМ ДИПЛОМАТИЧЕСКИЕ ФОРМУЛИРОВКИ. ПОКА АМЕРИКА
Dialogue: 0,0:12:53.33,0:12:56.77,Caption,,0,0,0,,ПРЕДЛАГАЕТ РАЗГОВОР, ЧАСТЬ ЕВРОПЫ ПЕРЕЧИСЛЯЕТ ПРИЧИНЫ,
Dialogue: 0,0:12:56.85,0:12:59.65,Caption,,0,0,0,,ПО КОТОРЫМ ОН НЕВОЗМОЖЕН. НО ОТКАЗ ОТ ПЕРЕГОВОРОВ
Dialogue: 0,0:12:59.65,0:13:02.37,Caption,,0,0,0,,ТОЖЕ ЯВЛЯЕТСЯ РЕШЕНИЕМ. И У НЕГО ДОЛЖНЫ БЫТЬ
Dialogue: 0,0:13:02.37,0:13:05.41,Caption,,0,0,0,,ЦЕЛЬ, ЦЕНА И ПОНЯТНЫЙ КОНЕЦ. ВОТ,
Dialogue: 0,0:13:05.49,0:13:10.13,Caption,,0,0,0,,СОБСТВЕННО, И ВСЁ. СТОЛ НА МЕСТЕ. СТУЛЬЯ ПРИНЕСЛИ. ЖЕЛАЮЩИХ
Dialogue: 0,0:13:10.13,0:13:12.37,Caption,,0,0,0,,ОБЪЯСНИТЬ, ПОЧЕМУ САДИТЬСЯ НЕЛЬЗЯ,
Dialogue: 0,0:13:12.53,0:13:16.21,Caption,,0,0,0,,БОЛЕЕ ЧЕМ ДОСТАТОЧНО. ОСТАЛАСЬ САМАЯ ТРУДНАЯ ЧАСТЬ.
Dialogue: 0,0:13:16.74,0:13:19.49,Caption,,0,0,0,,ОБЪЯСНИТЬ, ЧЕМ ВЫ СОБИРАЕТЕСЬ ЗАКОНЧИТЬ ПУТЬ,
Dialogue: 0,0:13:19.88,0:13:21.49,Caption,,0,0,0,,ЕСЛИ К СТОЛУ ТАК И НЕ СЯДЕТЕ?
