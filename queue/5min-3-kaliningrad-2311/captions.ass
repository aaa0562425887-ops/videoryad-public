Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,ВОТ ИНТЕРЕСНО ПОЛУЧАЕТСЯ. КАЛИНИНГРАД НИКТО
Dialogue: 0,0:00:02.84,0:00:05.56,Caption,,0,0,0,,ОФИЦИАЛЬНО НЕ БЛОКИРУЕТ. МОРСКИЕ ПУТИ НИКТО НЕ
Dialogue: 0,0:00:05.56,0:00:08.36,Caption,,0,0,0,,ЗАКРЫВАЕТ. ВСЁ РАБОТАЕТ, ВСЁ СПОКОЙНО,
Dialogue: 0,0:00:08.44,0:00:11.24,Caption,,0,0,0,,МОЖЕТЕ ПЛАВАТЬ. ТОЛЬКО ПО СУДАМ ТЕПЕРЬ БЕСПИЛОТНИКИ
Dialogue: 0,0:00:11.24,0:00:14.44,Caption,,0,0,0,,ПРИЛЕТАЮТ. УДОБНО, ПРАВДА? И САМОЕ ЗАНЯТНОЕ,
Dialogue: 0,0:00:14.60,0:00:16.92,Caption,,0,0,0,,ЧТО НА ЭТОМ ФОНЕ ПОЯВЛЯЮТСЯ ВЕСЬМА ИНТЕРЕСНЫЕ
Dialogue: 0,0:00:16.92,0:00:20.68,Caption,,0,0,0,,РАССУЖДЕНИЯ О ТОМ, ЧЕГО ТЕПЕРЬ ЖДУТ ОТ МОСКВЫ. ВОТ С ЭТОГО
Dialogue: 0,0:00:20.76,0:00:23.72,Caption,,0,0,0,,МЕСТА И НАЧИНАЕТСЯ СОВСЕМ ДРУГОЙ РАЗГОВОР. ЕСЛИ ВАМ
Dialogue: 0,0:00:23.72,0:00:27.48,Caption,,0,0,0,,ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ, ПОДПИШИТЕСЬ. ПОТОМУ ЧТО НА БАЛТИКЕ,
Dialogue: 0,0:00:27.56,0:00:31.80,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, НАЧИНАЕТСЯ ОТДЕЛЬНАЯ БОЛЬШАЯ ИСТОРИЯ. ДВА
Dialogue: 0,0:00:31.80,0:00:34.04,Caption,,0,0,0,,БЕСПИЛОТНИКА АТАКОВАЛИ ГРУЗОВОЕ СУДНО,
Dialogue: 0,0:00:34.20,0:00:36.68,Caption,,0,0,0,,КОТОРОЕ ШЛО В КАЛИНИНГРАД. ПРИЧЁМ НЕ В КАКОМ
Dialogue: 0,0:00:36.68,0:00:40.84,Caption,,0,0,0,,НИБУДЬ ПОРТУ И НЕ У ПРИЧАЛА, А В НЕЙТРАЛЬНЫХ ВОДАХ ФИНСКОГО ЗАЛИВА,
Dialogue: 0,0:00:41.16,0:00:43.32,Caption,,0,0,0,,ВСЕГО В НЕСКОЛЬКИХ МОРСКИХ МИЛЯХ ОТ РОССИЙСКОЙ
Dialogue: 0,0:00:43.40,0:00:46.92,Caption,,0,0,0,,ГРАНИЦЫ. И ВОТ ЭТО УЖЕ ДЕЙСТВИТЕЛЬНО ВАЖНО. БАЛТИКА
Dialogue: 0,0:00:47.00,0:00:50.20,Caption,,0,0,0,,СТАЛА НОВОЙ ТОЧКОЙ ЭСКАЛАЦИИ. ПРИЧЁМ МЕСТО ДЛЯ ЭТОГО
Dialogue: 0,0:00:50.28,0:00:53.64,Caption,,0,0,0,,ВЫБРАНО ОЧЕНЬ УДОБНОЕ. С СЕВЕРА ФИНЛЯНДИЯ. С ЮГА
Dialogue: 0,0:00:53.72,0:00:56.68,Caption,,0,0,0,,ЭСТОНИЯ. ОБЕ СТРАНЫ ВХОДЯТ В НАТО. МЕЖДУ НИМИ
Dialogue: 0,0:00:56.76,0:00:59.40,Caption,,0,0,0,,ПРОХОДИТ МОРСКОЕ СООБЩЕНИЕ С КАЛИНИНГРАДОМ. ПО
Dialogue: 0,0:00:59.48,0:01:03.32,Caption,,0,0,0,,НЕКОТОРЫМ ОЦЕНКАМ, МОРЕМ В ОБЛАСТЬ ИДЁТ ОКОЛО ДВАДЦАТИ ДВУХ ПРОЦЕНТОВ
Dialogue: 0,0:01:03.32,0:01:06.28,Caption,,0,0,0,,ВСЕХ ГРУЗОВ. ТО ЕСТЬ ПРИМЕРНО КАЖДЫЙ ПЯТЫЙ ГРУЗ.
Dialogue: 0,0:01:06.60,0:01:09.56,Caption,,0,0,0,,А СУХОПУТНЫЙ МАРШРУТ ПРОХОДИТ ЧЕРЕЗ ЛИТВУ. ВОЗДУШНОЕ
Dialogue: 0,0:01:09.56,0:01:12.44,Caption,,0,0,0,,СООБЩЕНИЕ ТОЖЕ ИДЁТ ПО ДОВОЛЬНО УЗКОМУ КОРИДОРУ НАД
Dialogue: 0,0:01:12.52,0:01:18.15,Caption,,0,0,0,,БАЛТИКОЙ. ВОТ ВАМ И ВСЯ ГЕОГРАФИЯ. ЧТОБЫ СОЗДАТЬ ПРОБЛЕМЫ
Dialogue: 0,0:01:18.15,0:01:21.91,Caption,,0,0,0,,КАЛИНИНГРАДУ, СОВЕРШЕННО НЕОБЯЗАТЕЛЬНО ЗАВТРА ВЫХОДИТЬ К МИКРОФОНУ
Dialogue: 0,0:01:21.99,0:01:24.79,Caption,,0,0,0,,И ТОРЖЕСТВЕННО ОБЪЯВЛЯТЬ БЛОКАДУ. ЭТО ВООБЩЕ СЛИШКОМ
Dialogue: 0,0:01:24.87,0:01:28.23,Caption,,0,0,0,,ГРУБО. МОЖНО ДЕЙСТВОВАТЬ КУДА АККУРАТНЕЕ. ОДНО СУДНО
Dialogue: 0,0:01:28.31,0:01:31.59,Caption,,0,0,0,,ПОЛУЧИЛО УДАР. ПОТОМ ЕЩЁ ОДНО. ПОТОМ ПЕРЕВОЗЧИКИ
Dialogue: 0,0:01:31.67,0:01:34.71,Caption,,0,0,0,,НАЧИНАЮТ ЗАДАВАТЬ ВОПРОСЫ. ПОТОМ СТРАХОВЫЕ КОМПАНИИ
Dialogue: 0,0:01:34.71,0:01:37.59,Caption,,0,0,0,,НАЧИНАЮТ СЧИТАТЬ РИСКИ. ПОТОМ КТО ТО НЕ ХОЧЕТ
Dialogue: 0,0:01:37.67,0:01:40.47,Caption,,0,0,0,,ИДТИ ЭТИМ МАРШРУТОМ. ПОТОМ ПРИХОДИТСЯ УСИЛИВАТЬ
Dialogue: 0,0:01:40.47,0:01:43.27,Caption,,0,0,0,,ОХРАНУ. НИКТО НИЧЕГО ОФИЦИАЛЬНО НЕ БЛОКИРОВАЛ.
Dialogue: 0,0:01:43.51,0:01:46.39,Caption,,0,0,0,,ПРОСТО ПЛАВАТЬ СТАЛО КАК ТО НЕУЮТНО. ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:01:46.39,0:01:48.95,Caption,,0,0,0,,КОНСТРУКЦИЯ. ОСОБЕННО ЕСЛИ ПОТОМ КАЖДЫЙ РАЗ
Dialogue: 0,0:01:48.95,0:01:50.95,Caption,,0,0,0,,РАЗВОДИТЬ РУКАМИ И ГОВОРИТЬ А МЫ ТУТ ВООБЩЕ
Dialogue: 0,0:01:50.95,0:01:53.51,Caption,,0,0,0,,ПРИ ЧЁМ? ФИНСКИЕ ВОЕННЫЕ ЗАЯВИЛИ,
Dialogue: 0,0:01:53.69,0:01:57.11,Caption,,0,0,0,,ЧТО АТАКУ ВИДЕЛИ. ИНФОРМАЦИЮ ПЕРЕДАЛИ НАТО. РАЙОН
Dialogue: 0,0:01:57.11,0:01:59.75,Caption,,0,0,0,,КОНТРОЛИРОВАЛСЯ. НЕЗАДОЛГО ДО ПРОИСШЕСТВИЯ ТАМ
Dialogue: 0,0:01:59.75,0:02:02.63,Caption,,0,0,0,,ОТМЕЧАЛАСЬ АКТИВНОСТЬ ЗАПАДНОЙ АВИАЦИИ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:02:02.63,0:02:06.23,Caption,,0,0,0,,НАЧИНАЕТСЯ ОСОБЕННО ЗАНЯТНАЯ ЧАСТЬ. ВСЁ УВИДЕЛИ. ВСЁ
Dialogue: 0,0:02:06.23,0:02:09.59,Caption,,0,0,0,,ЗАФИКСИРОВАЛИ. В НАТО СООБЩИЛИ. А БЕСПИЛОТНИКИ ВСЁ
Dialogue: 0,0:02:09.67,0:02:14.63,Caption,,0,0,0,,РАВНО ДОЛЕТЕЛИ. КРАСОТА. ПРЕМЬЕР ФИНЛЯНДИИ ПЕТТЕРИ ОРПО ПОСЛЕ ЭТОГО НАПОМНИЛ,
Dialogue: 0,0:02:14.79,0:02:17.75,Caption,,0,0,0,,ЧТО УКРАИНА ИМЕЕТ ПРАВО ДАВАТЬ ОТПОР РОССИИ. ТОЖЕ
Dialogue: 0,0:02:17.83,0:02:20.55,Caption,,0,0,0,,ОЧЕНЬ СВОЕВРЕМЕННОЕ ЗАМЕЧАНИЕ. РОССИЙСКОЕ СУДНО
Dialogue: 0,0:02:20.55,0:02:22.87,Caption,,0,0,0,,АТАКУЮТ В НЕЙТРАЛЬНЫХ ВОДАХ ВОЗЛЕ ФИНЛЯНДИИ,
Dialogue: 0,0:02:23.14,0:02:25.35,Caption,,0,0,0,,А ПЕРВЫМ ДЕЛОМ ВСПОМИНАЮТ ПРАВО УКРАИНЫ НА
Dialogue: 0,0:02:25.35,0:02:30.12,Caption,,0,0,0,,САМООБОРОНУ. НА ЗАПАДЕ ОТДЕЛЬНО НАПОМНИЛИ,
Dialogue: 0,0:02:30.33,0:02:33.08,Caption,,0,0,0,,ЧТО СУДНО НАХОДИТСЯ ПОД АМЕРИКАНСКИМИ САНКЦИЯМИ И
Dialogue: 0,0:02:33.16,0:02:35.72,Caption,,0,0,0,,СВЯЗАНО С "ОБОРОНЛОГИСТИКОЙ". И ТУТ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:02:35.72,0:02:38.76,Caption,,0,0,0,,ПРЕКРАСНЫЙ ВОПРОС. С КАКИХ ПОР САНКЦИОННЫЙ СПИСОК
Dialogue: 0,0:02:38.76,0:02:43.16,Caption,,0,0,0,,СТАЛ ЛИЦЕНЗИЕЙ НА ОТСТРЕЛ? ВРОДЕ БЫ САНКЦИИ РАНЬШЕ ОЗНАЧАЛИ ОГРАНИЧЕНИЯ НА
Dialogue: 0,0:02:43.16,0:02:45.72,Caption,,0,0,0,,СДЕЛКИ, РАСЧЁТЫ, ОБСЛУЖИВАНИЕ,
Dialogue: 0,0:02:45.95,0:02:47.96,Caption,,0,0,0,,ДОСТУП К ПОРТАМ. А ТЕПЕРЬ ЧТО?
Dialogue: 0,0:02:48.26,0:02:50.52,Caption,,0,0,0,,УВИДЕЛ САНКЦИОННОЕ СУДНО И МОЖНО ЗАПУСКАТЬ
Dialogue: 0,0:02:50.52,0:02:53.48,Caption,,0,0,0,,БЕСПИЛОТНИК? ЕСЛИ ТАКАЯ ЛОГИКА НАЧИНАЕТ РАБОТАТЬ,
Dialogue: 0,0:02:53.80,0:02:56.12,Caption,,0,0,0,,ПРАВИЛА МОРСКОГО СООБЩЕНИЯ СТАНОВЯТСЯ ОЧЕНЬ
Dialogue: 0,0:02:56.12,0:02:58.92,Caption,,0,0,0,,ИНТЕРЕСНЫМИ. ПРИЧЁМ ИСТОРИЯ С ФИНЛЯНДИЕЙ ВАЖНА НЕ
Dialogue: 0,0:02:58.92,0:03:01.40,Caption,,0,0,0,,ПОТОМУ, ЧТО ЕЁ САМОЛЁТ ГДЕ ТО ЛЕТАЛ И ЧТО
Dialogue: 0,0:03:01.40,0:03:03.88,Caption,,0,0,0,,ТО НАБЛЮДАЛ. САМО ПО СЕБЕ НАБЛЮДЕНИЕ ЕЩЁ НИ
Dialogue: 0,0:03:03.96,0:03:07.16,Caption,,0,0,0,,О ЧЁМ НЕ ГОВОРИТ. ВАЖНО ДРУГОЕ. АТАКА ПРОИСХОДИТ
Dialogue: 0,0:03:07.16,0:03:10.52,Caption,,0,0,0,,В РАЙОНЕ, ГДЕ СТРАНЫ НАТО ИМЕЮТ ОГРОМНЫЕ ВОЗМОЖНОСТИ
Dialogue: 0,0:03:10.52,0:03:14.20,Caption,,0,0,0,,НАБЛЮДЕНИЯ. ОНИ ВИДЯТ МОРЕ. ОНИ КОНТРОЛИРУЮТ ВОЗДУХ.
Dialogue: 0,0:03:14.44,0:03:16.84,Caption,,0,0,0,,ОНИ СЛЕДЯТ ЗА ДВИЖЕНИЕМ СУДОВ. И ПРИ ЭТОМ
Dialogue: 0,0:03:16.84,0:03:19.80,Caption,,0,0,0,,РОССИЙСКОЕ СУДНО ПОЛУЧАЕТ УДАР. ВОТ ЭТО УЖЕ СОЗДАЁТ
Dialogue: 0,0:03:19.80,0:03:22.60,Caption,,0,0,0,,НОВУЮ РЕАЛЬНОСТЬ. А ДАЛЬШЕ ПОЯВЛЯЕТСЯ ВЕРСИЯ,
Dialogue: 0,0:03:22.92,0:03:26.04,Caption,,0,0,0,,КОТОРАЯ ГОРАЗДО ИНТЕРЕСНЕЕ САМОГО НАПАДЕНИЯ. ЦЕЛЬЮ
Dialogue: 0,0:03:26.04,0:03:28.60,Caption,,0,0,0,,МОГЛО БЫТЬ НЕ СУДНО. ЦЕЛЬЮ МОГЛА БЫТЬ РЕАКЦИЯ
Dialogue: 0,0:03:28.60,0:03:32.52,Caption,,0,0,0,,МОСКВЫ. ПРОЩЕ ГОВОРЯ, ВОПРОС ЗВУЧИТ ТАК А ЧТО ВЫ НАМ СДЕЛАЕТЕ?
Dialogue: 0,0:03:32.52,0:03:35.88,Caption,,0,0,0,,УДАРИЛИ ОДИН РАЗ. ПОСМОТРЕЛИ. РОССИЯ УСИЛИЛА ОХРАНУ?
Dialogue: 0,0:03:35.95,0:03:38.84,Caption,,0,0,0,,НИЧЕГО НЕ СДЕЛАЛА? ОТВЕТИЛА ГДЕ ТО В ДРУГОМ МЕСТЕ?
Dialogue: 0,0:03:39.16,0:03:41.48,Caption,,0,0,0,,НАЧАЛА СОПРОВОЖДАТЬ СУДА ВОЕННЫМИ КОРАБЛЯМИ?
Dialogue: 0,0:03:43.75,0:03:46.71,Caption,,0,0,0,,КАЖДЫЙ ВАРИАНТ ДАЁТ НОВУЮ ИНФОРМАЦИЮ. И ВОТ ЭТО
Dialogue: 0,0:03:46.79,0:03:49.19,Caption,,0,0,0,,УЖЕ ДЕЙСТВИТЕЛЬНО ПОХОЖЕ НЕ ПРОСТО НА НАПАДЕНИЕ,
Dialogue: 0,0:03:49.35,0:03:52.31,Caption,,0,0,0,,А НА ПРОВЕРКУ. ПРОВЕРКУ ГРАНИЦЫ ДОПУСТИМОГО.
Dialogue: 0,0:03:52.55,0:03:55.67,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО МОЖНО ЗАЙТИ. ЧТО МОСКВА СЧИТАЕТ
Dialogue: 0,0:03:55.67,0:03:59.99,Caption,,0,0,0,,КРАСНОЙ ЛИНИЕЙ НЕ НА СЛОВАХ, А НА ДЕЛЕ. И СКОЛЬКО НУЖНО СДЕЛАТЬ ШАГОВ,
Dialogue: 0,0:04:00.22,0:04:02.95,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ ОНА ОТВЕТИТ. ЗДЕСЬ У РОССИИ ОЧЕНЬ
Dialogue: 0,0:04:02.95,0:04:05.91,Caption,,0,0,0,,НЕПРИЯТНАЯ РАЗВИЛКА. ЕСЛИ НИКАК НЕ РЕАГИРОВАТЬ,
Dialogue: 0,0:04:06.00,0:04:09.03,Caption,,0,0,0,,СЛЕДУЮЩИЙ УДАР СТАНОВИТСЯ ПРОЩЕ. ПЕРВЫЙ РАЗ ВСЕГДА
Dialogue: 0,0:04:09.03,0:04:11.11,Caption,,0,0,0,,САМЫЙ СЛОЖНЫЙ. ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:04:11.36,0:04:13.43,Caption,,0,0,0,,ЧТО МИР НЕ РУХНУЛ, ОТВЕТА НЕТ,
Dialogue: 0,0:04:13.59,0:04:16.39,Caption,,0,0,0,,КОРАБЛИ ВСЁ РАВНО ХОДЯТ. ЧЕРЕЗ МЕСЯЦ ЕЩЁ ОДИН
Dialogue: 0,0:04:16.39,0:04:19.27,Caption,,0,0,0,,УДАР УЖЕ ВОСПРИНИМАЕТСЯ СПОКОЙНЕЕ. ЧЕРЕЗ НЕСКОЛЬКО
Dialogue: 0,0:04:19.35,0:04:21.99,Caption,,0,0,0,,МЕСЯЦЕВ ЭТО ВООБЩЕ РИСКУЕТ ПРЕВРАТИТЬСЯ В ФОН. НО
Dialogue: 0,0:04:22.07,0:04:25.27,Caption,,0,0,0,,ЕСТЬ И ВТОРАЯ СТОРОНА. ЕСЛИ РОССИЯ ОТВЕЧАЕТ ЖЁСТКО,
Dialogue: 0,0:04:25.51,0:04:27.91,Caption,,0,0,0,,ДАЛЬШЕ ПОЯВЛЯЕТСЯ СОВЕРШЕННО ДРУГАЯ КАРТИНКА.
Dialogue: 0,0:04:28.23,0:04:32.23,Caption,,0,0,0,,СМОТРИТЕ, РОССИЯ АТАКОВАЛА СТРАНУ НАТО. РОССИЯ РАСШИРЯЕТ
Dialogue: 0,0:04:32.23,0:04:35.75,Caption,,0,0,0,,КОНФЛИКТ. РОССИЯ УГРОЖАЕТ ЕВРОПЕ. И НИКОГО УЖЕ
Dialogue: 0,0:04:35.75,0:04:39.59,Caption,,0,0,0,,ОСОБЕННО НЕ ИНТЕРЕСУЕТ, ЧТО ПРОИСХОДИЛО ДО ЭТОГО. ОЧЕНЬ УДОБНЫЙ ФОКУС.
Dialogue: 0,0:04:39.83,0:04:42.63,Caption,,0,0,0,,СНАЧАЛА ТОЛКАТЬ ЧЕЛОВЕКА В СПИНУ. ПОТОМ ЕЩЁ РАЗ.
Dialogue: 0,0:04:42.87,0:04:45.27,Caption,,0,0,0,,ПОТОМ ЕЩЁ. А КОГДА ОН РАЗВЕРНУЛСЯ И ДАЛ
Dialogue: 0,0:04:45.35,0:04:47.59,Caption,,0,0,0,,СДАЧИ, ГРОМКО ЗАКРИЧАТЬ СМОТРИТЕ,
Dialogue: 0,0:04:47.77,0:04:52.39,Caption,,0,0,0,,КАКОЙ АГРЕССИВНЫЙ ЧЕЛОВЕК. И ВОТ ИМЕННО ЗДЕСЬ ИСТОРИЯ СТАНОВИТСЯ НАМНОГО ШИРЕ
Dialogue: 0,0:04:52.47,0:04:55.19,Caption,,0,0,0,,ОДНОГО СУХОГРУЗА. ПОТОМУ ЧТО ПОЯВИЛАСЬ ЕЩЁ ОДНА
Dialogue: 0,0:04:55.19,0:05:00.42,Caption,,0,0,0,,ВЕРСИЯ. ОПРЕДЕЛЁННЫМ ПОЛИТИЧЕСКИМ СИЛАМ В ЕВРОПЕ КАК РАЗ И
Dialogue: 0,0:05:00.42,0:05:02.90,Caption,,0,0,0,,НУЖЕН ОГРАНИЧЕННЫЙ РОССИЙСКИЙ УДАР ПО ЕВРОПЕЙСКОЙ
Dialogue: 0,0:05:02.90,0:05:05.30,Caption,,0,0,0,,ТЕРРИТОРИИ. НЕ БОЛЬШОЙ. НЕ ТАКОЙ,
Dialogue: 0,0:05:05.54,0:05:08.02,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО ВСЕМ СТАНЕТ СОВСЕМ НЕ ДО ПОЛИТИЧЕСКИХ
Dialogue: 0,0:05:08.02,0:05:11.46,Caption,,0,0,0,,РЕЙТИНГОВ. А АККУРАТНЫЙ. ЧТОБЫ УЩЕРБ БЫЛ НЕБОЛЬШИМ,
Dialogue: 0,0:05:11.54,0:05:16.66,Caption,,0,0,0,,А ШУМА БЫЛО МНОГО. И ВОТ ЭТО УЖЕ ОЧЕНЬ ИНТЕРЕСНАЯ КОНСТРУКЦИЯ. ФРАНЦИЯ.
Dialogue: 0,0:05:16.96,0:05:20.26,Caption,,0,0,0,,ГЕРМАНИЯ. ИТАЛИЯ. У ВЛАСТЕЙ ХВАТАЕТ ВНУТРЕННИХ
Dialogue: 0,0:05:20.34,0:05:23.30,Caption,,0,0,0,,ПРОБЛЕМ. РЕЙТИНГИ ПРАВЫХ РАСТУТ. ЛЮДИ ЗАДАЮТ
Dialogue: 0,0:05:23.38,0:05:26.74,Caption,,0,0,0,,ВОПРОСЫ. ЭКОНОМИКА ДАЛЕКО НЕ В ЛУЧШЕЙ ФОРМЕ. РАСХОДЫ
Dialogue: 0,0:05:26.74,0:05:30.26,Caption,,0,0,0,,УВЕЛИЧИВАЮТСЯ. И ТУТ ПОЯВЛЯЕТСЯ ВНЕШНИЙ ВРАГ. НЕ ГДЕ
Dialogue: 0,0:05:30.34,0:05:32.58,Caption,,0,0,0,,ТО ДАЛЕКО. А ПРЯМО ЗДЕСЬ. СМОТРИТЕ,
Dialogue: 0,0:05:32.90,0:05:36.02,Caption,,0,0,0,,РОССИЯ УДАРИЛА ПО ЕВРОПЕ. НАДО СПЛОТИТЬСЯ. НАДО
Dialogue: 0,0:05:36.02,0:05:38.58,Caption,,0,0,0,,УВЕЛИЧИТЬ РАСХОДЫ. НАДО ОТЛОЖИТЬ ВНУТРЕННИЕ
Dialogue: 0,0:05:38.58,0:05:41.94,Caption,,0,0,0,,РАЗБОРКИ. НАДО ПОТЕРПЕТЬ. ПОЛИТИЧЕСКАЯ КЛАССИКА.
Dialogue: 0,0:05:42.18,0:05:44.58,Caption,,0,0,0,,СТАРЫЙ ДОБРЫЙ СПОСОБ ОБЪЯСНИТЬ НАСЕЛЕНИЮ,
Dialogue: 0,0:05:44.82,0:05:47.46,Caption,,0,0,0,,ПОЧЕМУ ИМЕННО СЕЙЧАС НЕ ВРЕМЯ ЗАДАВАТЬ НЕУДОБНЫЕ
Dialogue: 0,0:05:47.46,0:05:50.10,Caption,,0,0,0,,ВОПРОСЫ. НО В ЭТОЙ ВЕРСИИ ЕСТЬ ОДНА ОЧЕНЬ
Dialogue: 0,0:05:50.10,0:05:53.30,Caption,,0,0,0,,ВАЖНАЯ ДЕТАЛЬ. НУЖЕН ИМЕННО ОГРАНИЧЕННЫЙ ОТВЕТ.
Dialogue: 0,0:05:53.64,0:05:56.18,Caption,,0,0,0,,ПОТОМУ ЧТО БОЛЬШОЙ ОТВЕТ МОЖЕТ ДАТЬ ПРОТИВОПОЛОЖНЫЙ
Dialogue: 0,0:05:56.18,0:05:58.98,Caption,,0,0,0,,РЕЗУЛЬТАТ. ЕСЛИ ЕВРОПЕЙЦАМ ВДРУГ ОБЪЯСНЯТ,
Dialogue: 0,0:05:59.14,0:06:01.70,Caption,,0,0,0,,ЧТО ИХ СОБСТВЕННЫЕ ПРАВИТЕЛЬСТВА ДОВЕЛИ СИТУАЦИЮ ДО
Dialogue: 0,0:06:01.78,0:06:03.46,Caption,,0,0,0,,ПРЯМОГО СТОЛКНОВЕНИЯ С РОССИЕЙ,
Dialogue: 0,0:06:03.70,0:06:06.10,Caption,,0,0,0,,ГДЕ УЖЕ ЗВУЧАТ РАЗГОВОРЫ О ЯДЕРНОМ ОРУЖИИ,
Dialogue: 0,0:06:06.35,0:06:09.30,Caption,,0,0,0,,ЛЮДИ МОГУТ НАЧАТЬ ЗАДАВАТЬ СОВСЕМ ДРУГИЕ ВОПРОСЫ. И
Dialogue: 0,0:06:09.30,0:06:12.02,Caption,,0,0,0,,ТОГДА ЛОЗУНГ БУДЕТ УЖЕ НЕ "ЗАЩИТИМ ЕВРОПУ".
Dialogue: 0,0:06:14.30,0:06:15.74,Caption,,0,0,0,,А "ВЫ КУДА НАС ВООБЩЕ ЗАТАЩИЛИ?"
Dialogue: 0,0:06:16.30,0:06:18.62,Caption,,0,0,0,,ТАК ЧТО УРОВЕНЬ ЭСКАЛАЦИИ ЗДЕСЬ ИМЕЕТ ОГРОМНОЕ
Dialogue: 0,0:06:18.70,0:06:21.90,Caption,,0,0,0,,ЗНАЧЕНИЕ. СЛИШКОМ СЛАБАЯ РЕАКЦИЯ МОСКВЫ ПОКАЗЫВАЕТ,
Dialogue: 0,0:06:22.14,0:06:25.02,Caption,,0,0,0,,ЧТО ДАВИТЬ МОЖНО ДАЛЬШЕ. СЛИШКОМ СИЛЬНАЯ РЕАКЦИЯ
Dialogue: 0,0:06:25.10,0:06:27.50,Caption,,0,0,0,,СОЗДАЁТ СОВЕРШЕННО ДРУГИЕ РИСКИ УЖЕ ДЛЯ ТЕХ,
Dialogue: 0,0:06:27.72,0:06:29.82,Caption,,0,0,0,,КТО ЭТУ ИГРУ НАЧАЛ. И ГДЕ ТО МЕЖДУ
Dialogue: 0,0:06:29.82,0:06:31.98,Caption,,0,0,0,,ЭТИМИ ДВУМЯ КРАЙНОСТЯМИ ИДЁТ ПОИСК НУЖНОЙ
Dialogue: 0,0:06:31.98,0:06:35.66,Caption,,0,0,0,,ТЕМПЕРАТУРЫ. НЕ ХОЛОДНО. НЕ КИПИТ. А ЧТОБЫ ПОСТОЯННО
Dialogue: 0,0:06:35.74,0:06:39.02,Caption,,0,0,0,,БЫЛО ГОРЯЧО. КСТАТИ, ЕСЛИ ВЫ ДОСМОТРЕЛИ ДО ЭТОГО МЕСТА,
Dialogue: 0,0:06:39.16,0:06:43.02,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, КАК ВЫ СЧИТАЕТЕ РОССИЯ ДОЛЖНА СОПРОВОЖДАТЬ СУДА В
Dialogue: 0,0:06:43.02,0:06:45.98,Caption,,0,0,0,,КАЛИНИНГРАД ВОЕННЫМИ КОРАБЛЯМИ ИЛИ ЭТО КАК РАЗ ТОТ
Dialogue: 0,0:06:45.98,0:06:48.62,Caption,,0,0,0,,ШАГ, КОТОРОГО ОТ НЕЁ ЖДУТ? И ПОДПИШИТЕСЬ,
Dialogue: 0,0:06:48.70,0:06:51.34,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ДАЛЬШЕ ЗДЕСЬ
Dialogue: 0,0:06:51.34,0:06:53.74,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЕЩЁ ОДИН ОЧЕНЬ ИНТЕРЕСНЫЙ ИГРОК.
Dialogue: 0,0:06:53.83,0:06:56.78,Caption,,0,0,0,,БРИТАНИЯ. В ТОЙ ЖЕ ВЕРСИИ ИМЕННО БРИТАНЦАМ
Dialogue: 0,0:06:56.78,0:06:59.82,Caption,,0,0,0,,ПРИПИСЫВАЮТ УЧАСТИЕ В АТАКЕ НА СУДНО. САМО ЭТО
Dialogue: 0,0:06:59.82,0:07:02.94,Caption,,0,0,0,,УТВЕРЖДЕНИЕ ОСТАЁТСЯ ВЕРСИЕЙ. НО ПОЧТИ ОДНОВРЕМЕННО
Dialogue: 0,0:07:02.94,0:07:05.58,Caption,,0,0,0,,ЛОНДОН СОВЕРШЕННО ОТКРЫТО РАССКАЗЫВАЕТ О ДРУГОЙ
Dialogue: 0,0:07:05.58,0:07:09.42,Caption,,0,0,0,,ВЕЩИ. ВЕЛИКОБРИТАНИЯ ПРИЗНАЛА ПРОВЕДЕНИЕ НАСТУПАТЕЛЬНЫХ
Dialogue: 0,0:07:09.42,0:07:11.90,Caption,,0,0,0,,КИБЕРОПЕРАЦИЙ ПРОТИВ РОССИИ, КИТАЯ,
Dialogue: 0,0:07:11.98,0:07:15.50,Caption,,0,0,0,,ИРАНА И КНДР. ОБРАТИТЕ ВНИМАНИЕ НА СЛОВО. НЕ
Dialogue: 0,0:07:15.50,0:07:19.02,Caption,,0,0,0,,ЗАЩИТНЫХ. НАСТУПАТЕЛЬНЫХ. КОМАНДУЮЩИЙ БРИТАНСКИМ
Dialogue: 0,0:07:19.02,0:07:21.10,Caption,,0,0,0,,КИБЕРНЕТИЧЕСКИМ И СПЕЦИАЛЬНЫМ ОПЕРАТИВНЫМ
Dialogue: 0,0:07:21.10,0:07:24.22,Caption,,0,0,0,,КОМАНДОВАНИЕМ ГЕНЕРАЛ РОБЕРТ МАГОВАН ФОРМУЛИРУЕТ ЭТО
Dialogue: 0,0:07:24.30,0:07:29.68,Caption,,0,0,0,,ДОВОЛЬНО ПРОСТО. ПРОТИВНИК ДОЛЖЕН ЧУВСТВОВАТЬ ПОСЛЕДСТВИЯ СВОИХ
Dialogue: 0,0:07:29.68,0:07:32.64,Caption,,0,0,0,,ДЕЙСТВИЙ. ВОТ ЭТО УЖЕ ПОНЯТНЫЙ ЯЗЫК. И ГЛАВА
Dialogue: 0,0:07:32.72,0:07:35.28,Caption,,0,0,0,,МИ ШЕСТЬ БЛЕЗ МЕТРЕВЕЛИ ТОЖЕ ГОВОРИТ О ВОЗВРАЩЕНИИ
Dialogue: 0,0:07:35.36,0:07:38.16,Caption,,0,0,0,,СЛУЖБЫ К СПЕЦИАЛЬНЫМ ОПЕРАЦИЯМ И СКРЫТЫМ ДЕЙСТВИЯМ.
Dialogue: 0,0:07:38.64,0:07:40.72,Caption,,0,0,0,,ТО ЕСТЬ БРИТАНИЯ ДАЖЕ НЕ ОСОБЕННО ПРЯЧЕТ САМ
Dialogue: 0,0:07:40.72,0:07:42.88,Caption,,0,0,0,,ПОДХОД. МЫ БУДЕМ ДЕЙСТВОВАТЬ ТАМ,
Dialogue: 0,0:07:43.04,0:07:45.52,Caption,,0,0,0,,ГДЕ ПРОТИВНИКУ БОЛЬНО. КИБЕРПРОСТРАНСТВО,
Dialogue: 0,0:07:45.60,0:07:48.08,Caption,,0,0,0,,СПЕЦИАЛЬНЫЕ ОПЕРАЦИИ, СКРЫТЫЕ ДЕЙСТВИЯ.
Dialogue: 0,0:07:48.64,0:07:51.04,Caption,,0,0,0,,И ВОТ ТУТ ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. ПОЧЕМУ МЫ
Dialogue: 0,0:07:51.04,0:07:53.36,Caption,,0,0,0,,ВООБЩЕ ДОЛЖНЫ СМОТРЕТЬ НА БАЛТИКУ ТОЛЬКО КАК НА
Dialogue: 0,0:07:53.36,0:07:56.64,Caption,,0,0,0,,МОРЕ? СОВРЕМЕННОЕ ПРОТИВОСТОЯНИЕ ДАВНО ИДЁТ СРАЗУ В
Dialogue: 0,0:07:56.64,0:07:59.44,Caption,,0,0,0,,НЕСКОЛЬКИХ ПРОСТРАНСТВАХ. НА МОРЕ ПРОИСХОДИТ ОДИН
Dialogue: 0,0:07:59.44,0:08:02.88,Caption,,0,0,0,,ЭПИЗОД. В ИНТЕРНЕТЕ ДРУГОЙ. В РАЗВЕДКЕ ТРЕТИЙ. В
Dialogue: 0,0:08:02.96,0:08:06.08,Caption,,0,0,0,,ПОЛИТИКЕ ЧЕТВЁРТЫЙ. И КАЖДЫЙ ОТДЕЛЬНЫЙ СЛУЧАЙ МОЖНО
Dialogue: 0,0:08:06.08,0:08:10.16,Caption,,0,0,0,,ОБЪЯСНИТЬ СЛУЧАЙНОСТЬЮ, ОШИБКОЙ ИЛИ ДЕЙСТВИЯМИ КАКОГО ТО НЕИЗВЕСТНОГО
Dialogue: 0,0:08:10.16,0:08:13.20,Caption,,0,0,0,,ИСПОЛНИТЕЛЯ. А ОБЩАЯ КАРТИНА ПРИ ЭТОМ СТАНОВИТСЯ ВСЁ
Dialogue: 0,0:08:13.20,0:08:16.08,Caption,,0,0,0,,ВЕСЕЛЕЕ. ПРИ ЭТОМ БРИТАНСКИЕ ЦИФРЫ САМИ ПО СЕБЕ
Dialogue: 0,0:08:16.08,0:08:19.36,Caption,,0,0,0,,ВЫГЛЯДЯТ ЗАБАВНО. ПРИМЕРНО ДВЕ ТЫСЯЧИ СПЕЦИАЛИСТОВ С
Dialogue: 0,0:08:19.36,0:08:22.32,Caption,,0,0,0,,БРИТАНСКОЙ СТОРОНЫ ПРОТИВ БОЛЕЕ ЧЕМ ТРИДЦАТИ ТЫСЯЧ У
Dialogue: 0,0:08:22.32,0:08:27.28,Caption,,0,0,0,,РОССИИ, КИТАЯ, ИРАНА И КНДР ВМЕСТЕ. ПРИМЕРНО ОДИН К ПЯТНАДЦАТИ.
Dialogue: 0,0:08:27.68,0:08:30.32,Caption,,0,0,0,,НО КИБЕРОПЕРАЦИИ ВЕДЬ НЕ ФУТБОЛЬНЫЙ МАТЧ. ТАМ НЕ
Dialogue: 0,0:08:30.32,0:08:34.24,Caption,,0,0,0,,ВЫИГРЫВАЕТ ТОТ, У КОГО ПЯТНАДЦАТЬ ЧЕЛОВЕК ПРОТИВ ОДНОГО. ИНОГДА ОДИН
Dialogue: 0,0:08:34.24,0:08:37.28,Caption,,0,0,0,,УДАЧНЫЙ ДОСТУП СТОИТ ЦЕЛОГО ПОДРАЗДЕЛЕНИЯ. ПОЭТОМУ
Dialogue: 0,0:08:37.36,0:08:39.20,Caption,,0,0,0,,ДЕЛО ЗДЕСЬ НЕ В КРАСИВОЙ АРИФМЕТИКЕ.
Dialogue: 0,0:08:41.47,0:08:44.99,Caption,,0,0,0,,ДЕЛО В ТОМ, ЧТО ЛОНДОН ПРЯМО ПРИЗНАЁТ НАСТУПАТЕЛЬНЫЙ ХАРАКТЕР
Dialogue: 0,0:08:44.99,0:08:47.79,Caption,,0,0,0,,СВОИХ ДЕЙСТВИЙ. И ЭТО УЖЕ ОЧЕНЬ ХОРОШО ЛОЖИТСЯ
Dialogue: 0,0:08:47.87,0:08:50.03,Caption,,0,0,0,,В ОБЩУЮ КАРТИНУ РОСТА ЧИСЛА СЕРЫХ ЗОН,
Dialogue: 0,0:08:50.35,0:08:52.11,Caption,,0,0,0,,ГДЕ ФОРМАЛЬНОЙ БОЛЬШОЙ ВОЙНЫ НЕТ,
Dialogue: 0,0:08:52.46,0:08:54.67,Caption,,0,0,0,,А УДАРЫ ДРУГ ДРУГУ НАНОСЯТ ВПОЛНЕ РЕАЛЬНЫЕ.
Dialogue: 0,0:08:55.23,0:08:57.87,Caption,,0,0,0,,ТЕПЕРЬ ДОБАВИМ СЮДА ПОЛЬШУ. ПОСЛЕ РАКЕТНОГО
Dialogue: 0,0:08:57.87,0:09:00.75,Caption,,0,0,0,,ИНЦИДЕНТА МАРК РЮТТЕ ПООБЕЩАЛ ЗАЩИЩАТЬ КАЖДЫЙ
Dialogue: 0,0:09:00.75,0:09:04.19,Caption,,0,0,0,,САНТИМЕТР ПОЛЬСКОЙ ТЕРРИТОРИИ. ЗВУЧИТ МОЩНО. КАЖДЫЙ
Dialogue: 0,0:09:04.19,0:09:07.23,Caption,,0,0,0,,САНТИМЕТР. НЕ ДЕВЯНОСТО ДЕВЯТЬ ПРОЦЕНТОВ. ВСЕ СТО.
Dialogue: 0,0:09:07.77,0:09:10.11,Caption,,0,0,0,,ПОЛЬША ПРИВЕЛА В ГОТОВНОСТЬ КОМПЛЕКСЫ ПЭТРИОТ,
Dialogue: 0,0:09:10.35,0:09:12.75,Caption,,0,0,0,,ЗАДЕЙСТВОВАЛА ДРУГИЕ СИСТЕМЫ ПРОТИВОВОЗДУШНОЙ
Dialogue: 0,0:09:12.83,0:09:16.19,Caption,,0,0,0,,ОБОРОНЫ, ВЕРТОЛЁТЫ И ПОДРАЗДЕЛЕНИЯ ТЕРРИТОРИАЛЬНОЙ ОБОРОНЫ.
Dialogue: 0,0:09:16.44,0:09:19.31,Caption,,0,0,0,,ТО ЕСТЬ НЕРВОЗНОСТЬ ВПОЛНЕ НАСТОЯЩАЯ. ПРЕЗИДЕНТ
Dialogue: 0,0:09:19.39,0:09:21.63,Caption,,0,0,0,,ЧЕХИИ ПЕТР ПАВЕЛ СРАЗУ ЗАГОВОРИЛ О ТОМ,
Dialogue: 0,0:09:21.95,0:09:24.43,Caption,,0,0,0,,ЧТО ПОДОБНЫЙ ИНЦИДЕНТ МОЖЕТ ПРОИЗОЙТИ И В ЧЕХИИ.
Dialogue: 0,0:09:24.65,0:09:27.07,Caption,,0,0,0,,ЧЕШСКИЕ ВОЕННЫЕ УЖЕ НАХОДЯТСЯ В СИЛАХ НАТО В
Dialogue: 0,0:09:27.07,0:09:30.99,Caption,,0,0,0,,ПРИБАЛТИКЕ, ЧЕШСКИЕ ВЕРТОЛЁТЫ ПОМОГАЮТ ОХРАНЯТЬ ПОЛЬСКОЕ НЕБО.
Dialogue: 0,0:09:31.39,0:09:33.63,Caption,,0,0,0,,ТО ЕСТЬ ЕВРОПЕЙСКАЯ ВОЕННАЯ МАШИНА ПОСТЕПЕННО
Dialogue: 0,0:09:33.71,0:09:36.59,Caption,,0,0,0,,НАЧИНАЕТ ШЕВЕЛИТЬСЯ ВСЁ АКТИВНЕЕ. НО ТУТ ИЗ САМОЙ
Dialogue: 0,0:09:36.59,0:09:39.07,Caption,,0,0,0,,ПОЛЬШИ ПРИЛЕТАЕТ ДОВОЛЬНО НЕПРИЯТНЫЙ ВОПРОС УЖЕ В
Dialogue: 0,0:09:39.15,0:09:42.35,Caption,,0,0,0,,СТОРОНУ КИЕВА. ПУБЛИЦИСТ РЫШАРД РЫБИЦКИЙ ОБВИНИЛ
Dialogue: 0,0:09:42.35,0:09:46.27,Caption,,0,0,0,,УКРАИНУ В ТОМ, ЧТО РАКЕТЫ, ЛЕТЯЩИЕ В СТОРОНУ ПОЛЬСКОЙ ГРАНИЦЫ,
Dialogue: 0,0:09:46.51,0:09:49.31,Caption,,0,0,0,,ЯКОБЫ СОЗНАТЕЛЬНО НЕ ПЕРЕХВАТЫВАЮТ. ПРИЧЁМ ОН
Dialogue: 0,0:09:49.31,0:09:52.83,Caption,,0,0,0,,ОТДЕЛЬНО УТВЕРЖДАЕТ, ЧТО ДЕЛО НЕ В НЕХВАТКЕ СРЕДСТВ ПВО.
Dialogue: 0,0:09:55.11,0:09:58.07,Caption,,0,0,0,,И ВОТ ЭТО ОЧЕНЬ НЕПРИЯТНЫЙ ПОВОРОТ. ПОТОМУ ЧТО
Dialogue: 0,0:09:58.15,0:10:00.95,Caption,,0,0,0,,ЕСЛИ ПОДОБНЫЕ ОБВИНЕНИЯ НАЧИНАЮТ ЗВУЧАТЬ УЖЕ ВНУТРИ
Dialogue: 0,0:10:00.95,0:10:04.87,Caption,,0,0,0,,ПОЛЬШИ, ТО ВСЯ КРАСИВАЯ КОНСТРУКЦИЯ "РОССИЯ ПРОТИВ ЕДИНОГО
Dialogue: 0,0:10:04.87,0:10:06.71,Caption,,0,0,0,,ЗАПАДА" СТАНОВИТСЯ НЕМНОГО СЛОЖНЕЕ.
Dialogue: 0,0:10:07.27,0:10:10.39,Caption,,0,0,0,,ОДНИ ОБЕЩАЮТ ЗАЩИЩАТЬ КАЖДЫЙ САНТИМЕТР. ДРУГИЕ
Dialogue: 0,0:10:10.39,0:10:13.03,Caption,,0,0,0,,ТРЕБУЮТ БОЛЬШЕ ВОЕННОЙ ПОМОЩИ. ТРЕТЬИ УЖЕ
Dialogue: 0,0:10:13.03,0:10:16.39,Caption,,0,0,0,,СПРАШИВАЮТ, НЕ ИСПОЛЬЗУЮТ ЛИ СОЮЗНИКИ ТЕРРИТОРИЮ ПОЛЬШИ КАК
Dialogue: 0,0:10:16.47,0:10:19.27,Caption,,0,0,0,,ЭЛЕМЕНТ СВОЕЙ СОБСТВЕННОЙ ИГРЫ. И ВСЁ ЭТО ПРОИСХОДИТ
Dialogue: 0,0:10:19.35,0:10:22.23,Caption,,0,0,0,,НА ФОНЕ УЧЕНИЙ ТАК НАЗЫВАЕМОЙ КОАЛИЦИИ ЖЕЛАЮЩИХ.
Dialogue: 0,0:10:22.62,0:10:25.83,Caption,,0,0,0,,ХОРОШАЯ КОМПАНИЯ СОБРАЛАСЬ. ВСЕ ДРУГ ДРУГА ЗАЩИЩАЮТ.
Dialogue: 0,0:10:26.08,0:10:28.87,Caption,,0,0,0,,ВСЕ ДРУГ ДРУГУ ПОМОГАЮТ. И ОДНОВРЕМЕННО НАЧИНАЮТ
Dialogue: 0,0:10:28.87,0:10:31.59,Caption,,0,0,0,,КОСИТЬСЯ ДРУГ НА ДРУГА. А БАЛТИКА ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:10:31.67,0:10:34.15,Caption,,0,0,0,,СТАНОВИТСЯ ИДЕАЛЬНЫМ МЕСТОМ ДЛЯ ПРОДОЛЖЕНИЯ ЭТОЙ
Dialogue: 0,0:10:34.15,0:10:36.39,Caption,,0,0,0,,ИГРЫ. ПОТОМУ ЧТО ЗДЕСЬ ОГРОМНОЕ КОЛИЧЕСТВО
Dialogue: 0,0:10:36.39,0:10:40.71,Caption,,0,0,0,,УЧАСТНИКОВ. РОССИЯ. ФИНЛЯНДИЯ. ЭСТОНИЯ. ЛИТВА.
Dialogue: 0,0:10:40.87,0:10:45.11,Caption,,0,0,0,,ПОЛЬША РЯДОМ. НАТО. БРИТАНЦЫ. УКРАИНА. И МОРЕ,
Dialogue: 0,0:10:45.27,0:10:47.83,Caption,,0,0,0,,ГДЕ ОПРЕДЕЛИТЬ ВИНОВНИКА ОЧЕРЕДНОГО ЭПИЗОДА КУДА
Dialogue: 0,0:10:47.83,0:10:51.19,Caption,,0,0,0,,СЛОЖНЕЕ, ЧЕМ ЕСЛИ ЧЕРЕЗ ГРАНИЦУ ПОШЛИ ТАНКИ С ФЛАГОМ.
Dialogue: 0,0:10:51.83,0:10:54.55,Caption,,0,0,0,,ОТДЕЛЬНО ЕСТЬ ТЕХНИЧЕСКАЯ СТОРОНА. БЕСПИЛОТНИКОМ
Dialogue: 0,0:10:54.55,0:10:56.55,Caption,,0,0,0,,СОВСЕМ НЕ ОБЯЗАТЕЛЬНО УПРАВЛЯТЬ ЧЕЛОВЕКУ,
Dialogue: 0,0:10:56.71,0:10:58.63,Caption,,0,0,0,,КОТОРЫЙ СТОИТ НА БЕРЕГУ С ПУЛЬТОМ В РУКАХ
Dialogue: 0,0:10:58.71,0:11:02.15,Caption,,0,0,0,,И МАШЕТ ВСЕМ ПРИВЕТ. ЕСТЬ СПУТНИКОВАЯ СВЯЗЬ. ЕСТЬ
Dialogue: 0,0:11:02.15,0:11:04.31,Caption,,0,0,0,,РЕТРАНСЛЯТОРЫ. ЕСТЬ ТЕРМИНАЛЫ,
Dialogue: 0,0:11:04.47,0:11:09.72,Caption,,0,0,0,,ОФОРМЛЕННЫЕ НА ТРЕТЬИХ ЛИЦ. ЕСТЬ СПОСОБЫ СДЕЛАТЬ ТАК,
Dialogue: 0,0:11:09.94,0:11:12.60,Caption,,0,0,0,,ЧТОБЫ ПУТЬ ОТ ОПЕРАТОРА ДО АППАРАТА ВЫГЛЯДЕЛ ГОРАЗДО
Dialogue: 0,0:11:12.60,0:11:15.96,Caption,,0,0,0,,ЗАПУТАННЕЕ. И ЭТО СОЗДАЁТ ИДЕАЛЬНУЮ СРЕДУ ДЛЯ НОВОГО
Dialogue: 0,0:11:16.04,0:11:19.48,Caption,,0,0,0,,ТИПА ПРОТИВОСТОЯНИЯ. ВСЕ ВСЁ ПОНИМАЮТ. НО ПОПРОБУЙ
Dialogue: 0,0:11:19.48,0:11:24.28,Caption,,0,0,0,,ПОЙМАЙ ЗА РУКУ. А ПОКА ЛОВЯТ, УЖЕ ПРОИСХОДИТ СЛЕДУЮЩИЙ ЭПИЗОД. ЕСТЬ И ЕЩЁ ОДНО
Dialogue: 0,0:11:24.28,0:11:27.00,Caption,,0,0,0,,ЛЮБОПЫТНОЕ СОВПАДЕНИЕ. АТАКА НА КАЛИНИНГРАДСКОМ
Dialogue: 0,0:11:27.08,0:11:29.40,Caption,,0,0,0,,НАПРАВЛЕНИИ ПРОИЗОШЛА ВСКОРЕ ПОСЛЕ СООБЩЕНИЙ О
Dialogue: 0,0:11:29.40,0:11:32.12,Caption,,0,0,0,,ДЕКЛАРАЦИИ РОССИИ, США И КИТАЯ,
Dialogue: 0,0:11:32.44,0:11:35.56,Caption,,0,0,0,,ГДЕ РЕЧЬ ШЛА О НЕДОПУЩЕНИИ ЯДЕРНОГО СТОЛКНОВЕНИЯ. И
Dialogue: 0,0:11:35.64,0:11:38.04,Caption,,0,0,0,,ПОЧТИ СРАЗУ ПОЯВЛЯЕТСЯ МАЛЕНЬКАЯ ЭСКАЛАЦИЯ НА
Dialogue: 0,0:11:38.04,0:11:41.56,Caption,,0,0,0,,ЕВРОПЕЙСКОМ НАПРАВЛЕНИИ. НЕ ЯДЕРНАЯ. НЕ БОЛЬШАЯ. НО
Dialogue: 0,0:11:41.56,0:11:44.28,Caption,,0,0,0,,ВПОЛНЕ РЕАЛЬНАЯ. ОДНОВРЕМЕННО ЗЕЛЕНСКИЙ ПОСЛЕ
Dialogue: 0,0:11:44.28,0:11:47.00,Caption,,0,0,0,,ПРОДОЛЖИТЕЛЬНОГО ОТСУТСТВИЯ ВОЗВРАЩАЕТСЯ В КИЕВ И
Dialogue: 0,0:11:47.00,0:11:50.04,Caption,,0,0,0,,РЕЗКО УВЕЛИЧИВАЕТ ПУБЛИЧНУЮ АКТИВНОСТЬ. ВОКРУГ ЭТОГО
Dialogue: 0,0:11:50.12,0:11:52.76,Caption,,0,0,0,,УЖЕ ПОЯВИЛАСЬ ВЕРСИЯ О ПОЛУЧЕННЫХ ГАРАНТИЯХ ЛИЧНОЙ
Dialogue: 0,0:11:52.76,0:11:57.88,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ОПЯТЬ ЖЕ, ЗДЕСЬ ВАЖНА НЕ САМА ВЕРСИЯ. ВАЖЕН ПРИНЦИП. ЕСЛИ
Dialogue: 0,0:11:57.96,0:12:00.52,Caption,,0,0,0,,САМЫЕ БОЛЬШИЕ ИГРОКИ ПЫТАЮТСЯ ОЧЕРТИТЬ ВЕРХНЮЮ
Dialogue: 0,0:12:00.60,0:12:04.44,Caption,,0,0,0,,ГРАНИЦУ КОНФЛИКТА, ВСЁ ПРОСТРАНСТВО НИЖЕ ЭТОЙ ГРАНИЦЫ НИКУДА НЕ
Dialogue: 0,0:12:04.52,0:12:08.04,Caption,,0,0,0,,ИСЧЕЗАЕТ. НАОБОРОТ. ТАМ СТАНОВИТСЯ ТЕСНЕЕ. МОЖНО
Dialogue: 0,0:12:08.04,0:12:11.48,Caption,,0,0,0,,БИТЬ ДРОНАМИ. МОЖНО УСТРАИВАТЬ КИБЕРОПЕРАЦИИ. МОЖНО
Dialogue: 0,0:12:11.56,0:12:14.04,Caption,,0,0,0,,ДАВИТЬ НА МОРСКИЕ МАРШРУТЫ. МОЖНО ПРОВОДИТЬ
Dialogue: 0,0:12:14.04,0:12:17.08,Caption,,0,0,0,,СПЕЦИАЛЬНЫЕ ОПЕРАЦИИ. МОЖНО ПРОВЕРЯТЬ ПРОТИВНИКА НА
Dialogue: 0,0:12:17.08,0:12:21.77,Caption,,0,0,0,,РЕАКЦИЮ. ГЛАВНОЕ НЕ ПЕРЕСЕЧЬ ТУ ЛИНИЮ,
Dialogue: 0,0:12:22.02,0:12:25.13,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ УЖЕ НИКТО НИЧЕГО НЕ КОНТРОЛИРУЕТ. И
Dialogue: 0,0:12:25.13,0:12:29.61,Caption,,0,0,0,,ВОТ ЭТО, ПОЖАЛУЙ, ГЛАВНАЯ ПРОБЛЕМА НОВОЙ БАЛТИЙСКОЙ ИСТОРИИ. НЕ САМ
Dialogue: 0,0:12:29.61,0:12:32.97,Caption,,0,0,0,,БЕСПИЛОТНИК. НЕ КОНКРЕТНОЕ СУДНО. ДАЖЕ НЕ ВОПРОС,
Dialogue: 0,0:12:33.21,0:12:36.49,Caption,,0,0,0,,КТО НАЖАЛ КНОПКУ. САМОЕ ОПАСНОЕ НАЧИНАЕТСЯ ТОГДА,
Dialogue: 0,0:12:36.73,0:12:38.97,Caption,,0,0,0,,КОГДА ОДНА СТОРОНА УЖЕ ПРИМЕРНО ЗНАЕТ,
Dialogue: 0,0:12:39.20,0:12:40.97,Caption,,0,0,0,,КАКИЕ ВАРИАНТЫ ОТВЕТА ЕСТЬ У ДРУГОЙ,
Dialogue: 0,0:12:41.22,0:12:43.37,Caption,,0,0,0,,И НАЧИНАЕТ ПОДБИРАТЬ ТАКИЕ ДЕЙСТВИЯ,
Dialogue: 0,0:12:43.58,0:12:46.09,Caption,,0,0,0,,ПРИ КОТОРЫХ ЛЮБОЙ ОТВЕТ ОКАЗЫВАЕТСЯ НЕУДОБНЫМ.
Dialogue: 0,0:12:46.38,0:12:49.77,Caption,,0,0,0,,ПРОМОЛЧАЛ, ЗНАЧИТ МОЖНО ИДТИ ДАЛЬШЕ. ОТВЕТИЛ СЛАБО,
Dialogue: 0,0:12:50.09,0:12:52.65,Caption,,0,0,0,,ЗНАЧИТ ПРЕДЕЛ ЕЩЁ НЕ НАЙДЕН. ОТВЕТИЛ СИЛЬНО,
Dialogue: 0,0:12:52.81,0:12:56.09,Caption,,0,0,0,,ОТЛИЧНО, ВОТ ТЕБЕ ПОЛИТИЧЕСКАЯ КАРТИНКА ДЛЯ ВСЕЙ ЕВРОПЫ.
Dialogue: 0,0:12:56.40,0:12:59.37,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ДОВОЛЬНО МЕРЗКАЯ ШАХМАТНАЯ ПАРТИЯ. ТОЛЬКО
Dialogue: 0,0:12:59.45,0:13:03.05,Caption,,0,0,0,,ФИГУРЫ ЗДЕСЬ НАСТОЯЩИЕ. КОРАБЛИ НАСТОЯЩИЕ. РАКЕТЫ
Dialogue: 0,0:13:03.05,0:13:07.05,Caption,,0,0,0,,НАСТОЯЩИЕ. И СТРАНЫ ВОКРУГ БАЛТИКИ ТОЖЕ НАСТОЯЩИЕ. А
Dialogue: 0,0:13:07.13,0:13:09.05,Caption,,0,0,0,,ЗНАЧИТ ГЛАВНЫЙ ВОПРОС ТЕПЕРЬ НЕ В ТОМ,
Dialogue: 0,0:13:09.14,0:13:12.33,Caption,,0,0,0,,БУДЕТ ЛИ СЛЕДУЮЩИЙ ЭПИЗОД. ГЛАВНЫЙ ВОПРОС В ДРУГОМ.
Dialogue: 0,0:13:12.65,0:13:17.53,Caption,,0,0,0,,СУМЕЕТ ЛИ МОСКВА СДЕЛАТЬ ТАК, ЧТОБЫ СЛЕДУЮЩИЙ ХОД ПЕРЕСТАЛ БЫТЬ ВЫГОДЕН ТОМУ,
Dialogue: 0,0:13:17.71,0:13:18.49,Caption,,0,0,0,,КТО ЕГО ГОТОВИТ?
