Dialogue: 0,0:00:00.12,0:00:04.20,Caption,,0,0,0,,КИЕВ ОПЯТЬ РЕШИЛ ПРОВЕРИТЬ, НАСКОЛЬКО ВЫСОКО МОЖНО ПОДНЯТЬ СТАВКИ,
Dialogue: 0,0:00:04.35,0:00:06.12,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ СЧЁТ ПРЕДЪЯВЯТ ОБРАТНО.
Dialogue: 0,0:00:06.84,0:00:09.24,Caption,,0,0,0,,УДАР ПО КРЫМСКОМУ МОСТУ ДОЛЖЕН БЫЛ ПРОЗВУЧАТЬ
Dialogue: 0,0:00:09.24,0:00:12.36,Caption,,0,0,0,,ОДНОВРЕМЕННО ДЛЯ МОСКВЫ И ВАШИНГТОНА. НА БАНКОВОЙ
Dialogue: 0,0:00:12.44,0:00:15.08,Caption,,0,0,0,,УЖЕ РАЗДАЮТ БЛАГОДАРНОСТИ И ГОТОВЯТСЯ К ПРОДОЛЖЕНИЮ.
Dialogue: 0,0:00:15.34,0:00:17.72,Caption,,0,0,0,,ТОЛЬКО В ПЕНТАГОНЕ ВМЕСТО АПЛОДИСМЕНТОВ ЗАДАЛИ
Dialogue: 0,0:00:17.80,0:00:20.04,Caption,,0,0,0,,ВОПРОС А ЧЕГО ИМЕННО ЭТИМ ДОБИЛИСЬ?
Dialogue: 0,0:00:20.36,0:00:24.12,Caption,,0,0,0,,И ПОХОЖЕ, ОДНИМ НЕУДОБНЫМ ВОПРОСОМ ДЕЛО НЕ ЗАКОНЧИТСЯ. ЕСЛИ
Dialogue: 0,0:00:24.20,0:00:29.32,Caption,,0,0,0,,ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ, ПОДПИШИТЕСЬ. КРЫМСКИЙ МОСТ ВНОВЬ СТАЛ ГЛАВНЫМ ГЕРОЕМ
Dialogue: 0,0:00:29.32,0:00:32.28,Caption,,0,0,0,,НОВОСТЕЙ. УКРАИНСКАЯ СТОРОНА СООБЩИЛА О СЕРЬЁЗНОМ
Dialogue: 0,0:00:32.28,0:00:34.04,Caption,,0,0,0,,ПОВРЕЖДЕНИИ АВТОМОБИЛЬНОЙ ЧАСТИ,
Dialogue: 0,0:00:34.36,0:00:36.20,Caption,,0,0,0,,А ЗЕЛЕНСКИЙ ПОБЛАГОДАРИЛ ВОЕННЫХ,
Dialogue: 0,0:00:36.29,0:00:39.56,Caption,,0,0,0,,СПЕЦСЛУЖБЫ И ОРУЖЕЙНИКОВ. СЛЕДОМ ПУБЛИКЕ ПОКАЗАЛИ
Dialogue: 0,0:00:39.56,0:00:42.20,Caption,,0,0,0,,ПОЧТИ ВСЁ СОДЕРЖИМОЕ ВИТРИНЫ ПАЛЯНИЦУ,
Dialogue: 0,0:00:42.36,0:00:47.80,Caption,,0,0,0,,РУТУ, ЭФ ПИ ПЯТЬ, НЕПТУН И ФЛАМИНГО. ПОСЫЛ ЯСЕН. УКРАИНА ПРОИЗВОДИТ
Dialogue: 0,0:00:47.80,0:00:49.56,Caption,,0,0,0,,СОБСТВЕННЫЕ СРЕДСТВА ПОРАЖЕНИЯ,
Dialogue: 0,0:00:49.78,0:00:52.52,Caption,,0,0,0,,УМЕЕТ ДОСТАВЛЯТЬ ИХ К КРУПНЫМ ОБЪЕКТАМ И СОБИРАЕТСЯ
Dialogue: 0,0:00:52.52,0:00:55.40,Caption,,0,0,0,,ПОЛЬЗОВАТЬСЯ ЭТИМ УМЕНИЕМ ДАЛЬШЕ. НЕ ОПЕРАЦИЯ,
Dialogue: 0,0:00:55.56,0:01:00.12,Caption,,0,0,0,,А ВЫСТАВКА ДОСТИЖЕНИЙ. ОДНАКО ГРОМКОСТЬ СОБЫТИЯ ЕЩЁ НЕ ОТВЕЧАЕТ НА ГЛАВНЫЙ
Dialogue: 0,0:01:00.12,0:01:03.32,Caption,,0,0,0,,ВОПРОС. УДАРИТЬ ПО СТРАТЕГИЧЕСКОМУ ОБЪЕКТУ МОЖНО.
Dialogue: 0,0:01:03.53,0:01:06.28,Caption,,0,0,0,,ГОРАЗДО ТРУДНЕЕ ЗАСТАВИТЬ ТАКОЙ УДАР ИЗМЕНИТЬ
Dialogue: 0,0:01:06.28,0:01:09.96,Caption,,0,0,0,,ПОЛОЖЕНИЕ НА ФРОНТЕ, УСЛОВИЯ ПЕРЕГОВОРОВ ИЛИ РЕШЕНИЯ ТЕХ,
Dialogue: 0,0:01:10.15,0:01:12.12,Caption,,0,0,0,,КТО ОПЛАЧИВАЕТ ПРОДОЛЖЕНИЕ КОНФЛИКТА.
Dialogue: 0,0:01:14.39,0:01:17.03,Caption,,0,0,0,,ПОВРЕЖДЕНИЯ ЕСТЬ, ДВИЖЕНИЕ ОГРАНИЧИВАЛИ,
Dialogue: 0,0:01:17.29,0:01:19.83,Caption,,0,0,0,,КАДРЫ РАЗОШЛИСЬ ПО ВСЕМ ПЛОЩАДКАМ. РОССИЙСКАЯ
Dialogue: 0,0:01:19.83,0:01:23.35,Caption,,0,0,0,,СТОРОНА ОБЪЯВИЛА, ЧТО ДВИЖЕНИЕ ПОЕЗДОВ ПО ОДНОМУ ПУТИ УЖЕ
Dialogue: 0,0:01:23.35,0:01:25.67,Caption,,0,0,0,,ВОССТАНОВЛЕНО, ВТОРОЙ РЕМОНТИРУЮТ,
Dialogue: 0,0:01:25.88,0:01:28.71,Caption,,0,0,0,,А МОСТ СОБИРАЮТСЯ ВЕРНУТЬ В ПОЛНОЦЕННОЕ СОСТОЯНИЕ.
Dialogue: 0,0:01:29.26,0:01:32.55,Caption,,0,0,0,,КИЕВ ОТВЕЧАЕТ ОБЕЩАНИЕМ СЛЕДУЮЩЕЙ СЕРИИ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:01:32.55,0:01:34.95,Caption,,0,0,0,,АНОНСИРОВАЛ НОВЫЕ ОПЕРАЦИИ ПРОТИВ РОССИИ,
Dialogue: 0,0:01:35.23,0:01:38.07,Caption,,0,0,0,,А МИНИСТР ОБОРОНЫ УКРАИНЫ ЕВГЕНИЙ ХМАРА ЗАЯВИЛ ЕЩЁ
Dialogue: 0,0:01:38.07,0:01:41.83,Caption,,0,0,0,,КОРОЧЕ ЭТО ЛИШЬ НАЧАЛО. И ТУТ ТОРЖЕСТВЕННАЯ МУЗЫКА
Dialogue: 0,0:01:41.83,0:01:45.03,Caption,,0,0,0,,СМЕНИЛАСЬ ЗВУКОМ КАЛЬКУЛЯТОРА. ПОЧТИ В ТОТ ЖЕ МОМЕНТ
Dialogue: 0,0:01:45.03,0:01:47.67,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ ГЛАВЫ АМЕРИКАНСКОГО ВОЕННОГО ВЕДОМСТВА
Dialogue: 0,0:01:47.67,0:01:50.95,Caption,,0,0,0,,ЭЛБРИДЖ КОЛБИ ОЦЕНИЛ УКРАИНСКУЮ СТРАТЕГИЮ БЕЗ
Dialogue: 0,0:01:50.95,0:01:53.51,Caption,,0,0,0,,ПРАЗДНИЧНОГО НАСТРОЕНИЯ. ПО СЛОВАМ КОЛБИ,
Dialogue: 0,0:01:53.86,0:01:56.55,Caption,,0,0,0,,УДАРЫ ДАЛЕКО ВНУТРИ РОССИЙСКОЙ ТЕРРИТОРИИ НЕ
Dialogue: 0,0:01:56.55,0:01:59.27,Caption,,0,0,0,,ОСТАНОВИЛИ ПРОДВИЖЕНИЕ РОССИЙСКИХ ВОЙСК И НЕ
Dialogue: 0,0:01:59.27,0:02:02.55,Caption,,0,0,0,,ПРИБЛИЗИЛИ ОКОНЧАНИЕ КОНФЛИКТА. АТАКИ НА ОТДЕЛЬНЫЕ
Dialogue: 0,0:02:02.55,0:02:04.79,Caption,,0,0,0,,ГРАЖДАНСКИЕ ОБЪЕКТЫ, ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:02:05.02,0:02:08.31,Caption,,0,0,0,,МОГУТ ДАТЬ МОСКВЕ ПРОТИВОПОЛОЖНЫЙ РЕЗУЛЬТАТ УКРЕПИТЬ
Dialogue: 0,0:02:08.31,0:02:11.03,Caption,,0,0,0,,ОБЩЕСТВЕННУЮ ПОДДЕРЖКУ ДАЛЬНЕЙШИХ ДЕЙСТВИЙ И
Dialogue: 0,0:02:11.03,0:02:14.07,Caption,,0,0,0,,ПОВЫСИТЬ ГОТОВНОСТЬ К НОВОМУ ОБОСТРЕНИЮ. ЗАТЕМ
Dialogue: 0,0:02:14.07,0:02:18.47,Caption,,0,0,0,,ПРОЗВУЧАЛ ВЫВОД, КОТОРЫЙ КИЕВУ ПОНРАВИТСЯ ЕЩЁ МЕНЬШЕ. В СОСТЯЗАНИИ
Dialogue: 0,0:02:18.55,0:02:21.51,Caption,,0,0,0,,ДАЛЬНИХ УДАРОВ ПЕРЕВЕС МОЖЕТ ОКАЗАТЬСЯ НА РОССИЙСКОЙ
Dialogue: 0,0:02:21.51,0:02:26.99,Caption,,0,0,0,,СТОРОНЕ. ПОСЛЕ ТАКОЙ ОЦЕНКИ ФОТОГРАФИИ ПОВРЕЖДЁННОГО МОСТА
Dialogue: 0,0:02:26.99,0:02:30.82,Caption,,0,0,0,,ВЫГЛЯДЯТ НЕ ФИНАЛОМ ОПЕРАЦИИ, А ПЕРВЫМ КАДРОМ ИСТОРИИ,
Dialogue: 0,0:02:31.06,0:02:32.90,Caption,,0,0,0,,ЦЕНУ КОТОРОЙ ПОКА НИКТО НЕ НАЗВАЛ.
Dialogue: 0,0:02:33.73,0:02:36.10,Caption,,0,0,0,,ПРИ ЭТОМ КОЛБИ НЕ ТРЕБУЕТ ОТ УКРАИНЫ УБРАТЬ
Dialogue: 0,0:02:36.10,0:02:39.38,Caption,,0,0,0,,ОРУЖИЕ В ШКАФ. УДАРЫ ПО РОССИЙСКИМ ВОЕННЫМ ОБЪЕКТАМ,
Dialogue: 0,0:02:39.62,0:02:42.26,Caption,,0,0,0,,КОТОРЫЕ ПОМОГАЮТ УДЕРЖИВАТЬ ФРОНТ И СОКРАЩАЮТ
Dialogue: 0,0:02:42.26,0:02:44.26,Caption,,0,0,0,,ВОЗМОЖНОСТИ РОССИЙСКИХ ВООРУЖЁННЫХ СИЛ,
Dialogue: 0,0:02:44.50,0:02:49.22,Caption,,0,0,0,,ОН ПОДДЕРЖИВАЕТ. ЗНАЧИТ, РАЗГОВОР ИДЁТ НЕ О ПРАВЕ КИЕВА НАНОСИТЬ УДАРЫ.
Dialogue: 0,0:02:49.56,0:02:52.50,Caption,,0,0,0,,ВОПРОС ПРОЩЕ И НЕПРИЯТНЕЕ КАКОЙ РЕЗУЛЬТАТ ПРИНЕСЛА
Dialogue: 0,0:02:52.50,0:02:56.26,Caption,,0,0,0,,КОНКРЕТНАЯ ОПЕРАЦИЯ? НА ЭТОМ МЕСТЕ СОЮЗНИКИ УСТРОИЛИ СПОР,
Dialogue: 0,0:02:56.50,0:02:58.98,Caption,,0,0,0,,В КОТОРОМ КАЖДЫЙ ОТВЕЧАЛ НА СОБСТВЕННЫЙ ВОПРОС.
Dialogue: 0,0:02:59.54,0:03:02.50,Caption,,0,0,0,,БОРИС ПИСТОРИУС НАЗВАЛ АМЕРИКАНСКУЮ КРИТИКУ ГЛУПОЙ И
Dialogue: 0,0:03:02.50,0:03:06.18,Caption,,0,0,0,,НАПОМНИЛ, ЧТО УКРАИНА ВПРАВЕ ПОРАЖАТЬ ВОЕННЫЕ ОБЪЕКТЫ И
Dialogue: 0,0:03:06.18,0:03:10.42,Caption,,0,0,0,,ИНФРАСТРУКТУРУ, РАБОТАЮЩУЮ В ИНТЕРЕСАХ РОССИЙСКОЙ АРМИИ. В ЛОНДОНЕ
Dialogue: 0,0:03:10.42,0:03:13.78,Caption,,0,0,0,,ТОЖЕ ОТВЕРГЛИ ПОДХОД ВАШИНГТОНА. БРИТАНСКАЯ ПОЗИЦИЯ
Dialogue: 0,0:03:13.78,0:03:17.94,Caption,,0,0,0,,СВОДИТСЯ К ТОМУ, ЧТО ТАКИЕ АТАКИ СНИЖАЮТ РОССИЙСКИЕ ВОЗМОЖНОСТИ,
Dialogue: 0,0:03:18.10,0:03:21.62,Caption,,0,0,0,,ДАЮТ УКРАИНЕ ВРЕМЯ И СОХРАНЯЮТ ЖИЗНИ. МАРК РЮТТЕ
Dialogue: 0,0:03:21.62,0:03:24.66,Caption,,0,0,0,,ПОДТВЕРДИЛ ПРАВО КИЕВА БИТЬ ПО РОССИЙСКОЙ ЛОГИСТИКЕ,
Dialogue: 0,0:03:24.83,0:03:27.86,Caption,,0,0,0,,ОТДЕЛЬНО УПОМЯНУВ КЕРЧЕНСКИЙ МОСТ. АМЕРИКАНСКАЯ
Dialogue: 0,0:03:27.94,0:03:30.82,Caption,,0,0,0,,СТОРОНА СПРАШИВАЕТ О ПОСЛЕДСТВИЯХ. ГЕРМАНИЯ ГОВОРИТ
Dialogue: 0,0:03:30.90,0:03:33.38,Caption,,0,0,0,,О ПРАВЕ НА ДЕЙСТВИЕ. БРИТАНИЯ ЗАЩИЩАЕТ
Dialogue: 0,0:03:33.38,0:03:36.34,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТЬ УКРАИНСКОГО КОМАНДОВАНИЯ. НАТО
Dialogue: 0,0:03:36.35,0:03:38.82,Caption,,0,0,0,,ПОДТВЕРЖДАЕТ ДОПУСТИМОСТЬ ВЫБРАННЫХ ЦЕЛЕЙ.
Dialogue: 0,0:03:41.12,0:03:43.92,Caption,,0,0,0,,ДАЛЬШЕ УБЕЖДЕНИЯ ВСТРЕЧАЮТСЯ С КОШЕЛЬКОМ. КОЛБИ
Dialogue: 0,0:03:43.92,0:03:48.80,Caption,,0,0,0,,ОДНОВРЕМЕННО НАПОМНИЛ, ЧТО АМЕРИКАНСКИЕ ПОСТАВКИ ПО ПРОГРАММЕ PURL ДОЛЖНА В
Dialogue: 0,0:03:48.88,0:03:51.84,Caption,,0,0,0,,ОСНОВНОМ ФИНАНСИРОВАТЬ ЕВРОПА. СОЕДИНЁННЫЕ ШТАТЫ
Dialogue: 0,0:03:51.84,0:03:53.60,Caption,,0,0,0,,ГОТОВЫ СОХРАНЯТЬ ОРУЖИЕ В СХЕМЕ,
Dialogue: 0,0:03:53.86,0:03:55.68,Caption,,0,0,0,,УКРАИНА ОСТАЁТСЯ ЕГО ПОЛУЧАТЕЛЕМ,
Dialogue: 0,0:03:56.08,0:03:58.64,Caption,,0,0,0,,А ЕВРОПЕЙСКИМ СОЮЗНИКАМ ВСЁ НАСТОЙЧИВЕЕ ПРЕДЛАГАЮТ
Dialogue: 0,0:03:58.64,0:04:01.52,Caption,,0,0,0,,ЗАНЯТЬ МЕСТО У КАССЫ. ЕВРОПЕЙСКИЕ ПРАВИТЕЛЬСТВА
Dialogue: 0,0:04:01.60,0:04:06.24,Caption,,0,0,0,,ДОКАЗЫВАЮТ АМЕРИКАНЦАМ, ЧТО ДАЛЬНИЕ УКРАИНСКИЕ УДАРЫ ПОЛЕЗНЫ. ВАШИНГТОН
Dialogue: 0,0:04:06.24,0:04:08.16,Caption,,0,0,0,,ВЫСЛУШИВАЕТ АРГУМЕНТЫ И СООБЩАЕТ,
Dialogue: 0,0:04:08.40,0:04:11.28,Caption,,0,0,0,,ЧТО ДАЛЬНЕЙШУЮ ПОЛЕЗНОСТЬ ЖЕЛАТЕЛЬНО ОПЛАЧИВАТЬ ТЕМ,
Dialogue: 0,0:04:11.44,0:04:15.92,Caption,,0,0,0,,КТО В НЕЁ ВЕРИТ. РАСПРЕДЕЛЕНИЕ РОЛЕЙ ВЫШЛО ОБРАЗЦОВЫМ. АМЕРИКАНЦЫ
Dialogue: 0,0:04:15.92,0:04:18.24,Caption,,0,0,0,,ПРОДАЮТ, ЕВРОПЕЙЦЫ РАССЧИТЫВАЮТСЯ,
Dialogue: 0,0:04:18.54,0:04:22.08,Caption,,0,0,0,,КИЕВ ОБЕЩАЕТ НОВУЮ ОПЕРАЦИЮ. У КАЖДОГО СВОЯ РАБОТА,
Dialogue: 0,0:04:22.32,0:04:25.20,Caption,,0,0,0,,ТОЛЬКО ИТОГОВЫЙ СЧЁТ РАСТЁТ У ВСЕХ. ОСОБЕННО
Dialogue: 0,0:04:25.20,0:04:29.04,Caption,,0,0,0,,ЛЮБОПЫТНО, ЧТО ЭТОТ ОБМЕН ПРОИСХОДИТ ОДНОВРЕМЕННО С ПОДГОТОВКОЙ
Dialogue: 0,0:04:29.04,0:04:31.68,Caption,,0,0,0,,ПЕРЕГОВОРОВ О ПРЕКРАЩЕНИИ КОНФЛИКТА. УДАР ПО
Dialogue: 0,0:04:31.68,0:04:33.92,Caption,,0,0,0,,КРЫМСКОМУ МОСТУ НЕЛЬЗЯ РАССМАТРИВАТЬ ЛИШЬ КАК
Dialogue: 0,0:04:33.92,0:04:36.72,Caption,,0,0,0,,ВОЕННЫЙ ЭПИЗОД. ЛЮБОЕ КРУПНОЕ ОБОСТРЕНИЕ ПЕРЕД
Dialogue: 0,0:04:36.72,0:04:39.44,Caption,,0,0,0,,ОБСУЖДЕНИЕМ КОМПРОМИССОВ МЕНЯЕТ ПРЕДМЕТ РАЗГОВОРА.
Dialogue: 0,0:04:39.92,0:04:42.40,Caption,,0,0,0,,ВМЕСТО УСЛОВИЙ СОГЛАШЕНИЯ СТОРОНЫ ВЫЯСНЯЮТ,
Dialogue: 0,0:04:42.71,0:04:44.88,Caption,,0,0,0,,КТО ПЕРВЫМ ПОДНЯЛ УРОВЕНЬ НАПРЯЖЕНИЯ,
Dialogue: 0,0:04:45.04,0:04:49.84,Caption,,0,0,0,,ЧЕЙ ОТВЕТ БЫЛ ЧРЕЗМЕРНЫМ, КТО СОРВАЛ ПОПЫТКУ СБЛИЖЕНИЯ И КОМУ ТЕПЕРЬ УСТУПАТЬ.
Dialogue: 0,0:04:50.08,0:04:52.16,Caption,,0,0,0,,САМИ ПЕРЕГОВОРЫ ОСТАЮТСЯ НА МЕСТЕ.
Dialogue: 0,0:04:54.44,0:04:58.60,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ ГОВОРЯТ О МИРЕ, ПОСРЕДНИКИ ПЕРЕМЕЩАЮТСЯ МЕЖДУ СТОЛИЦАМИ,
Dialogue: 0,0:04:58.75,0:05:03.80,Caption,,0,0,0,,ВСТРЕЧИ ГОТОВЯТСЯ, ЗАЯВЛЕНИЯ ПУБЛИКУЮТСЯ. РАБОТА КИПИТ ТАК УБЕДИТЕЛЬНО,
Dialogue: 0,0:05:04.05,0:05:06.44,Caption,,0,0,0,,ЧТО ОТСУТСТВИЕ РЕШЕНИЯ МОЖНО НЕ СРАЗУ ЗАМЕТИТЬ.
Dialogue: 0,0:05:06.78,0:05:09.72,Caption,,0,0,0,,КАЖДЫЙ НОВЫЙ УДАР ПОЗВОЛЯЕТ ОТОДВИНУТЬ НЕПРИЯТНЫЙ
Dialogue: 0,0:05:09.80,0:05:12.44,Caption,,0,0,0,,ВЫБОР ЕЩЁ НА НЕСКОЛЬКО НЕДЕЛЬ. ОТКАЗЫВАТЬСЯ ОТ
Dialogue: 0,0:05:12.44,0:05:15.24,Caption,,0,0,0,,ПЕРЕГОВОРНОГО ПРОЦЕССА НЕ ТРЕБУЕТСЯ. ДОСТАТОЧНО
Dialogue: 0,0:05:15.24,0:05:19.40,Caption,,0,0,0,,ОБЪЯСНИТЬ, ПОЧЕМУ СОГЛАШЕНИЕ СНОВА СТАЛО НЕСВОЕВРЕМЕННЫМ. ДЛЯ
Dialogue: 0,0:05:19.40,0:05:22.84,Caption,,0,0,0,,РУКОВОДИТЕЛЯ, КОТОРОМУ НЕВЫГОДНО ПРИНИМАТЬ ТЯЖЁЛОЕ РЕШЕНИЕ,
Dialogue: 0,0:05:22.99,0:05:25.56,Caption,,0,0,0,,СХЕМА УДОБНАЯ. ДВЕРЬ ВРОДЕ БЫ ОТКРЫТА,
Dialogue: 0,0:05:25.88,0:05:28.28,Caption,,0,0,0,,НО ВОЙТИ ПОСТОЯННО МЕШАЕТ ТО ОБСТРЕЛ,
Dialogue: 0,0:05:28.36,0:05:32.20,Caption,,0,0,0,,ТО ОТВЕТ, ТО НОВАЯ ОПЕРАЦИЯ. ЗАВЕРШЕНИЕ КОНФЛИКТА СЕЙЧАС
Dialogue: 0,0:05:32.20,0:05:34.84,Caption,,0,0,0,,НЕВЫГОДНО ЗЕЛЕНСКОМУ. ВОЗМОЖНАЯ СТАВКА НА
Dialogue: 0,0:05:34.84,0:05:37.24,Caption,,0,0,0,,ЗАТЯГИВАНИЕ МОЖЕТ БЫТЬ СВЯЗАНА С ДВУМЯ РУБЕЖАМИ
Dialogue: 0,0:05:37.24,0:05:40.12,Caption,,0,0,0,,ЯНВАРЁМ И ВЕСНОЙ. ЯНВАРСКИЙ РАСЧЁТ УПИРАЕТСЯ В
Dialogue: 0,0:05:40.12,0:05:42.60,Caption,,0,0,0,,ВАШИНГТОН. В КИЕВЕ МОГУТ НАДЕЯТЬСЯ,
Dialogue: 0,0:05:42.81,0:05:45.72,Caption,,0,0,0,,ЧТО ВНУТРЕННИЙ БАЛАНС В СОЕДИНЁННЫХ ШТАТАХ ИЗМЕНИТСЯ
Dialogue: 0,0:05:45.80,0:05:48.84,Caption,,0,0,0,,И ДАВЛЕНИЕ НА УКРАИНСКОЕ РУКОВОДСТВО ОСЛАБНЕТ. ДАЖЕ
Dialogue: 0,0:05:48.84,0:05:51.48,Caption,,0,0,0,,НЕБОЛЬШОЕ ДВИЖЕНИЕ АМЕРИКАНСКОЙ ПОЗИЦИИ ДАСТ
Dialogue: 0,0:05:51.48,0:05:54.68,Caption,,0,0,0,,БАНКОВОЙ ДОПОЛНИТЕЛЬНЫЙ ЗАПАС ВРЕМЕНИ. ИНОГДА ИМЕННО
Dialogue: 0,0:05:54.68,0:05:57.96,Caption,,0,0,0,,ВРЕМЯ СТАНОВИТСЯ ГЛАВНОЙ ЦЕЛЬЮ. НЕ ПОБЕДА И НЕ
Dialogue: 0,0:05:57.96,0:06:01.24,Caption,,0,0,0,,СОГЛАШЕНИЕ. ПРОСТО ЕЩЁ НЕСКОЛЬКО НЕДЕЛЬ БЕЗ РЕШЕНИЯ.
Dialogue: 0,0:06:01.83,0:06:04.36,Caption,,0,0,0,,ВЕСЕННИЙ РУБЕЖ СВЯЗАН С ВНУТРЕННЕЙ УСТОЙЧИВОСТЬЮ
Dialogue: 0,0:06:04.44,0:06:09.99,Caption,,0,0,0,,УКРАИНЫ. ПОСЛЕ ЗАВЕРШЕНИЯ ОТОПИТЕЛЬНОГО СЕЗОНА ЭНЕРГЕТИЧЕСКИЕ
Dialogue: 0,0:06:09.99,0:06:12.23,Caption,,0,0,0,,ТРУДНОСТИ ОЩУЩАЮТСЯ НЕ ТАК ОСТРО,
Dialogue: 0,0:06:12.31,0:06:15.91,Caption,,0,0,0,,КАК ЗИМОЙ. САМЫЕ ТЯЖЁЛЫЕ МЕСЯЦЫ ОСТАЮТСЯ ПОЗАДИ,
Dialogue: 0,0:06:16.21,0:06:18.71,Caption,,0,0,0,,А У ВЛАСТИ ПОЯВЛЯЕТСЯ ПРОСТРАНСТВО ДЛЯ СЛЕДУЮЩЕЙ
Dialogue: 0,0:06:18.71,0:06:22.31,Caption,,0,0,0,,ОТСРОЧКИ. РАСЧЁТ НЕЗАМЫСЛОВАТЫЙ. ПЕРЕЖИТЬ ЯНВАРЬ,
Dialogue: 0,0:06:22.47,0:06:25.59,Caption,,0,0,0,,ДОЖДАТЬСЯ ВЕСНЫ, А ПОСЛЕ НАЙТИ ОЧЕРЕДНОЙ РУБЕЖ,
Dialogue: 0,0:06:25.83,0:06:28.63,Caption,,0,0,0,,ДО КОТОРОГО НУЖНО ПРОДЕРЖАТЬСЯ. МИР ВСЁ ЭТО ВРЕМЯ
Dialogue: 0,0:06:28.63,0:06:33.27,Caption,,0,0,0,,МОЖНО ПРОДОЛЖАТЬ ОБСУЖДАТЬ, НО ОКОНЧАТЕЛЬНЫЙ ВЫБОР КАЖДЫЙ РАЗ ПЕРЕЕЗЖАЕТ НЕМНОГО
Dialogue: 0,0:06:33.27,0:06:35.91,Caption,,0,0,0,,ДАЛЬШЕ. ЕСЛИ ВАМ ВАЖНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:06:36.06,0:06:39.19,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДЛЯ ГОСУДАРСТВА ТАКАЯ ПОКУПКА ВРЕМЕНИ
Dialogue: 0,0:06:39.19,0:06:44.55,Caption,,0,0,0,,ОБХОДИТСЯ НЕ СИМВОЛИЧЕСКИ. КАЖДЫЙ ДОБАВЛЕННЫЙ МЕСЯЦ ОЗНАЧАЕТ НОВЫЕ РАЗРУШЕНИЯ,
Dialogue: 0,0:06:44.71,0:06:50.31,Caption,,0,0,0,,РАСХОДЫ, ОРУЖЕЙНЫЕ ПОСТАВКИ, ЗАПРОСЫ НА ДЕНЬГИ И ОБМЕН УДАРАМИ. ОТСРОЧКА
Dialogue: 0,0:06:50.31,0:06:55.11,Caption,,0,0,0,,ДОСТАЁТСЯ РУКОВОДСТВУ, А ОПЛАЧИВАЕТ ЕЁ ВСЯ СТРАНА. ГЛАВНАЯ ОПАСНОСТЬ ДЛЯ
Dialogue: 0,0:06:55.11,0:06:59.11,Caption,,0,0,0,,КИЕВА В ТОМ, ЧТО ЗАДУМАННАЯ ПОСЛЕДОВАТЕЛЬНОСТЬ СОБЫТИЙ МОЖЕТ БЫТЬ
Dialogue: 0,0:06:59.19,0:07:03.99,Caption,,0,0,0,,ПРОЧИТАНА ВАШИНГТОНОМ НЕ ТАК, КАК РАССЧИТЫВАЮТ НА БАНКОВОЙ. ЕСЛИ РОССИЙСКИЙ ОТВЕТ
Dialogue: 0,0:07:03.99,0:07:06.31,Caption,,0,0,0,,ХОТЯТ ИСПОЛЬЗОВАТЬ КАК ДОКАЗАТЕЛЬСТВО НЕЖЕЛАНИЯ
Dialogue: 0,0:07:06.31,0:07:10.55,Caption,,0,0,0,,МОСКВЫ ДОГОВАРИВАТЬСЯ, СНАЧАЛА ПРИДЁТСЯ УБЕДИТЬ АМЕРИКАНЦЕВ ПРИНЯТЬ ЭТУ
Dialogue: 0,0:07:10.63,0:07:13.99,Caption,,0,0,0,,ВЕРСИЮ. СОЕДИНЁННЫЕ ШТАТЫ ВОВСЕ НЕ ОБЯЗАНЫ ЗАКРЫВАТЬ
Dialogue: 0,0:07:14.07,0:07:16.63,Caption,,0,0,0,,ГЛАЗА НА ТО, ЧТО ПРОИСХОДИЛО ПЕРЕД ОТВЕТОМ.
Dialogue: 0,0:07:18.92,0:07:21.08,Caption,,0,0,0,,МОСКВА МОЖЕТ ПРИНЕСТИ ТРАМПУ ПРОСТУЮ
Dialogue: 0,0:07:21.08,0:07:23.32,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ ПОВРЕЖДЕНИЕ МОСТА,
Dialogue: 0,0:07:23.46,0:07:25.72,Caption,,0,0,0,,ОБЕЩАНИЕ КИЕВА ПРОДОЛЖИТЬ ОПЕРАЦИИ,
Dialogue: 0,0:07:25.90,0:07:27.72,Caption,,0,0,0,,ПОСЛЕДУЮЩИЕ РОССИЙСКИЕ ДЕЙСТВИЯ.
Dialogue: 0,0:07:28.35,0:07:31.08,Caption,,0,0,0,,УКРАИНСКАЯ СТОРОНА ПРЕДСТАВИТ ПОСЛЕДНИЙ ПУНКТ КАК
Dialogue: 0,0:07:31.08,0:07:34.20,Caption,,0,0,0,,ПОПЫТКУ СОРВАТЬ ПЕРЕГОВОРЫ. ОБЕ ДЕЛЕГАЦИИ БУДУТ
Dialogue: 0,0:07:34.20,0:07:37.48,Caption,,0,0,0,,УВЕРЯТЬ, ЧТО ХРОНОЛОГИЯ РАБОТАЕТ В ИХ ПОЛЬЗУ. НО У
Dialogue: 0,0:07:37.48,0:07:40.84,Caption,,0,0,0,,КИЕВА ПОЯВИЛСЯ ЛИШНИЙ ПРОТИВНИК ВНУТРИ ЭТОГО СПОРА.
Dialogue: 0,0:07:41.24,0:07:46.12,Caption,,0,0,0,,КОЛБИ УЖЕ ПУБЛИЧНО ЗАЯВИЛ, ЧТО ДАЛЬНИЕ УКРАИНСКИЕ УДАРЫ НЕ ДАЮТ ЗАЯВЛЕННОГО
Dialogue: 0,0:07:46.12,0:07:49.08,Caption,,0,0,0,,РЕЗУЛЬТАТА. УБЕЖДАТЬ ПРИДЁТСЯ ПРЕДСТАВИТЕЛЯ СТРАНЫ,
Dialogue: 0,0:07:49.33,0:07:51.08,Caption,,0,0,0,,ОТ КОТОРОЙ ЗАВИСЯТ ВООРУЖЕНИЕ,
Dialogue: 0,0:07:51.18,0:07:54.92,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ И ОБЪЁМ ДАЛЬНЕЙШЕЙ ПОМОЩИ. РОССИЙСКИЙ
Dialogue: 0,0:07:54.92,0:07:57.72,Caption,,0,0,0,,ОТВЕТ ОСТАЁТСЯ ОТДЕЛЬНОЙ НЕИЗВЕСТНОЙ. ПОСЛЕ
Dialogue: 0,0:07:57.72,0:08:00.44,Caption,,0,0,0,,ПОВРЕЖДЕНИЯ МОСТА ОБСУЖДАЮТСЯ ВОЗМОЖНЫЕ АТАКИ ПО
Dialogue: 0,0:08:00.44,0:08:03.16,Caption,,0,0,0,,УКРАИНСКОЙ ТРАНСПОРТНОЙ И ЭНЕРГЕТИЧЕСКОЙ СИСТЕМЕ.
Dialogue: 0,0:08:03.38,0:08:06.12,Caption,,0,0,0,,СРЕДИ УЯЗВИМЫХ НАПРАВЛЕНИЙ НАЗЫВАЮТ ПЕРЕПРАВЫ ЧЕРЕЗ
Dialogue: 0,0:08:06.12,0:08:11.40,Caption,,0,0,0,,ДНЕПР, ГИДРОЭЛЕКТРОСТАНЦИИ, ЖЕЛЕЗНОДОРОЖНЫЕ УЗЛЫ И ДРУГИЕ ЭЛЕМЕНТЫ СНАБЖЕНИЯ.
Dialogue: 0,0:08:11.77,0:08:14.20,Caption,,0,0,0,,МОСКВА НЕ ОБЪЯВЛЯЛА ЭТОТ ПЕРЕЧЕНЬ УТВЕРЖДЁННЫМ
Dialogue: 0,0:08:14.20,0:08:16.52,Caption,,0,0,0,,НАБОРОМ ЦЕЛЕЙ. РЕЧЬ ИДЁТ ОБ ОБЪЕКТАХ,
Dialogue: 0,0:08:16.77,0:08:19.24,Caption,,0,0,0,,ВОКРУГ КОТОРЫХ СТРОЯТСЯ ОЖИДАНИЯ И ПРОГНОЗЫ
Dialogue: 0,0:08:19.24,0:08:22.76,Caption,,0,0,0,,СЛЕДУЮЩЕГО ЭТАПА. НО ТОЧНОЕ НАЗВАНИЕ ЦЕЛИ НЕ МЕНЯЕТ
Dialogue: 0,0:08:22.76,0:08:25.72,Caption,,0,0,0,,МЕХАНИЗМА. КАЖДЫЙ НОВЫЙ РАУНД ДЕЛАЕТ ПОСЛЕДУЮЩИЙ
Dialogue: 0,0:08:25.72,0:08:28.28,Caption,,0,0,0,,ДОРОЖЕ. ПОВЫШАТЬ СТАВКИ ПРИЯТНО ДО ТЕХ ПОР,
Dialogue: 0,0:08:28.59,0:08:30.84,Caption,,0,0,0,,ПОКА КРУПЬЕ НЕ ПРОСИТ ПОЛОЖИТЬ НА СТОЛ ЧТО
Dialogue: 0,0:08:30.84,0:08:32.76,Caption,,0,0,0,,НИБУДЬ КРОМЕ ГРОМКОГО ЗАЯВЛЕНИЯ.
Dialogue: 0,0:08:35.05,0:08:37.37,Caption,,0,0,0,,И ЗДЕСЬ ДЛЯ БАНКОВОЙ ВОЗНИКАЕТ РАЗНИЦА,
Dialogue: 0,0:08:37.60,0:08:40.25,Caption,,0,0,0,,КОТОРУЮ НЕВОЗМОЖНО УБРАТЬ БЛАГОДАРСТВЕННОЙ РЕЧЬЮ.
Dialogue: 0,0:08:40.80,0:08:44.49,Caption,,0,0,0,,ВОЕННЫЙ РЕЗУЛЬТАТ ОТДЕЛЬНОЙ ОПЕРАЦИИ НЕ ГАРАНТИРУЕТ
Dialogue: 0,0:08:44.49,0:08:47.13,Caption,,0,0,0,,ВЫГОДНОГО РЕЗУЛЬТАТА ДЛЯ УКРАИНСКОГО РУКОВОДСТВА.
Dialogue: 0,0:08:47.46,0:08:49.69,Caption,,0,0,0,,СТРАТЕГИЧЕСКИЙ ОБЪЕКТ МОЖНО ПОВРЕДИТЬ,
Dialogue: 0,0:08:49.93,0:08:54.81,Caption,,0,0,0,,ПОКАЗАТЬ ЭФФЕКТНЫЕ КАДРЫ, НАГРАДИТЬ УЧАСТНИКОВ И ПООБЕЩАТЬ ПРОДОЛЖЕНИЕ. НО
Dialogue: 0,0:08:54.81,0:08:56.81,Caption,,0,0,0,,ЕСЛИ МОСКВА НЕ ИДЁТ НА УСТУПКИ,
Dialogue: 0,0:08:57.20,0:08:59.13,Caption,,0,0,0,,ПОЛОЖЕНИЕ НА ФРОНТЕ НЕ МЕНЯЕТСЯ,
Dialogue: 0,0:08:59.36,0:09:01.61,Caption,,0,0,0,,А СОЮЗНИКИ ИЩУТ НОВЫЕ МИЛЛИАРДЫ,
Dialogue: 0,0:09:01.91,0:09:04.81,Caption,,0,0,0,,УСПЕХ ВЫГЛЯДИТ СЛОЖНЕЕ, ЧЕМ В ПЕРВОМ СООБЩЕНИИ.
Dialogue: 0,0:09:05.55,0:09:08.09,Caption,,0,0,0,,ЕСТЬ У ЭТОЙ ИСТОРИИ ЕЩЁ ОДИН УРОВЕНЬ. МИХАИЛ
Dialogue: 0,0:09:08.09,0:09:11.53,Caption,,0,0,0,,ВИНОГРАДОВ ЗАМЕТИЛ, ЧТО В РОССИЙСКОМ ИНФОРМАЦИОННОМ ПРОСТРАНСТВЕ
Dialogue: 0,0:09:11.53,0:09:15.05,Caption,,0,0,0,,ОДНОВРЕМЕННО СУЩЕСТВУЮТ ДВЕ ПОЧТИ НЕ ПЕРЕСЕКАЮЩИЕСЯ
Dialogue: 0,0:09:15.05,0:09:18.17,Caption,,0,0,0,,ВЕРСИИ ПРОИСХОДЯЩЕГО. ПЕРВАЯ РАССКАЗЫВАЕТ ОБ УСПЕХАХ
Dialogue: 0,0:09:18.17,0:09:21.29,Caption,,0,0,0,,НА МЕЖДУНАРОДНОМ НАПРАВЛЕНИИ, СПОРАХ ВНУТРИ НАТО,
Dialogue: 0,0:09:21.52,0:09:24.65,Caption,,0,0,0,,ВОЗМОЖНОЙ БОЛЬШОЙ СДЕЛКЕ И БУДУЩЕМ СОГЛАШЕНИИ ПОЧТИ
Dialogue: 0,0:09:24.65,0:09:29.93,Caption,,0,0,0,,ИСТОРИЧЕСКОГО МАСШТАБА. ВО ВТОРОЙ ПОСТОЯННО ПРИСУТСТВУЮТ УДАРЫ ПО МОСТАМ И
Dialogue: 0,0:09:29.93,0:09:32.01,Caption,,0,0,0,,НЕФТЕПЕРЕРАБАТЫВАЮЩИМ ПРЕДПРИЯТИЯМ,
Dialogue: 0,0:09:32.19,0:09:35.29,Caption,,0,0,0,,ТРУДНОСТИ В ЭНЕРГЕТИКЕ И НАКАПЛИВАЮЩИЕСЯ ВНУТРЕННИЕ
Dialogue: 0,0:09:35.37,0:09:39.05,Caption,,0,0,0,,ПРОБЛЕМЫ. ЛЮДИ ВНУТРИ ЭТИХ КАРТИН РЕДКО СЛЫШАТ ДРУГ ДРУГА.
Dialogue: 0,0:09:39.32,0:09:41.85,Caption,,0,0,0,,ОДНИ УЖЕ МЫСЛЕННО РАССТАВЛЯЮТ КРЕСЛА ДЛЯ БОЛЬШОЙ
Dialogue: 0,0:09:41.85,0:09:45.53,Caption,,0,0,0,,ВСТРЕЧИ ДЕРЖАВ, ДРУГИЕ СЛЕДЯТ ЗА ОЧЕРЕДНЫМИ ПОВРЕЖДЕНИЯМИ И
Dialogue: 0,0:09:45.53,0:09:48.41,Caption,,0,0,0,,ПЕРЕБОЯМИ. ЧЕЛОВЕК СПОСОБЕН ПРИВЫКНУТЬ ПОЧТИ КО
Dialogue: 0,0:09:48.41,0:09:53.65,Caption,,0,0,0,,ВСЕМУ. ГРОМКАЯ НОВОСТЬ СНАЧАЛА ВЫБИВАЕТ ИЗ ПРИВЫЧНОГО
Dialogue: 0,0:09:53.65,0:09:57.17,Caption,,0,0,0,,РИТМА, ЗАТЕМ СТАНОВИТСЯ ПОВОДОМ ПОСМОТРЕТЬ ОБНОВЛЕНИЯ,
Dialogue: 0,0:09:57.48,0:10:00.13,Caption,,0,0,0,,А ПОТОМ ПРЕВРАЩАЕТСЯ В ЕЩЁ ОДНО СООБЩЕНИЕ МЕЖДУ
Dialogue: 0,0:10:00.13,0:10:03.49,Caption,,0,0,0,,ПРОГНОЗОМ ПОГОДЫ И КУРСОМ ВАЛЮТ. ЗЕЛЕНСКИЙ МОЖЕТ
Dialogue: 0,0:10:03.49,0:10:08.37,Caption,,0,0,0,,НАЗВАТЬ ОПЕРАЦИЮ УСПЕШНОЙ, АНОНСИРОВАТЬ СЛЕДУЮЩИЕ УДАРЫ И ЕЩЁ РАЗ ОТЛОЖИТЬ
Dialogue: 0,0:10:08.45,0:10:11.49,Caption,,0,0,0,,РАЗГОВОР О КОМПРОМИССАХ. СЛОВА О ПРОДОЛЖЕНИИ СТОЯТ
Dialogue: 0,0:10:11.49,0:10:14.53,Caption,,0,0,0,,НЕДОРОГО. САМО ПРОДОЛЖЕНИЕ ОПЛАЧИВАЕТСЯ ОРУЖИЕМ,
Dialogue: 0,0:10:14.71,0:10:19.17,Caption,,0,0,0,,ИНФРАСТРУКТУРОЙ, ЖИЗНЯМИ И НОВЫМИ ОБЯЗАТЕЛЬСТВАМИ ПЕРЕД СОЮЗНИКАМИ.
Dialogue: 0,0:10:19.76,0:10:22.69,Caption,,0,0,0,,ВОТ ТУТ И ПРОХОДИТ ГРАНИЦА МЕЖДУ ВЫИГРАННЫМ ВРЕМЕНЕМ
Dialogue: 0,0:10:22.69,0:10:25.41,Caption,,0,0,0,,РУКОВОДИТЕЛЯ И ПОТЕРЯННЫМ ВРЕМЕНЕМ СТРАНЫ.
Dialogue: 0,0:10:25.96,0:10:29.01,Caption,,0,0,0,,ПЕРВЫЙ ПОЛУЧАЕТ ОТСРОЧКУ. ВТОРОЙ ПОЛУЧАЕТ СЧЁТ,
Dialogue: 0,0:10:29.25,0:10:32.13,Caption,,0,0,0,,КОТОРЫЙ НИКТО НЕ СОБИРАЕТСЯ АННУЛИРОВАТЬ. САМОЕ
Dialogue: 0,0:10:32.13,0:10:34.13,Caption,,0,0,0,,НЕУДОБНОЕ ДЛЯ БАНКОВОЙ СОСТОИТ В ТОМ,
Dialogue: 0,0:10:34.37,0:10:37.49,Caption,,0,0,0,,ЧТО СУММУ ТЕПЕРЬ ОБСУЖДАЕТ НЕ ТОЛЬКО МОСКВА. ВНУТРИ
Dialogue: 0,0:10:37.49,0:10:39.49,Caption,,0,0,0,,ЗАПАДНОГО ЛАГЕРЯ УЖЕ СПРАШИВАЮТ,
Dialogue: 0,0:10:39.71,0:10:43.33,Caption,,0,0,0,,ЧТО ДАЛА ВЫБРАННАЯ СТРАТЕГИЯ И КТО ДОЛЖЕН ОПЛАЧИВАТЬ
Dialogue: 0,0:10:43.41,0:10:46.29,Caption,,0,0,0,,ЕЁ СЛЕДУЮЩИЙ ЭТАП. ОДНИ СОЮЗНИКИ СОМНЕВАЮТСЯ В
Dialogue: 0,0:10:46.37,0:10:49.01,Caption,,0,0,0,,РЕЗУЛЬТАТЕ, ДРУГИЕ ГОТОВЯТСЯ ОТКРЫВАТЬ КОШЕЛЁК,
Dialogue: 0,0:10:49.25,0:10:52.21,Caption,,0,0,0,,А КИЕВ ОБЕЩАЕТ ПРОДОЛЖЕНИЕ ПРОГРАММЫ. ЕСЛИ ВСЁ
Dialogue: 0,0:10:52.21,0:10:56.29,Caption,,0,0,0,,ПОЙДЁТ ТЕМ ЖЕ ПУТЁМ, ГРОМКИЙ УСПЕХ СПОСОБЕН ПРИНЕСТИ НЕ ТОТ ИТОГ,
Dialogue: 0,0:10:56.45,0:10:59.49,Caption,,0,0,0,,РАДИ КОТОРОГО ЕГО УСТРАИВАЛИ. ВРЕМЕНИ У ЗЕЛЕНСКОГО
Dialogue: 0,0:10:59.49,0:11:01.17,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО МОЖЕТ СТАТЬ БОЛЬШЕ.
Dialogue: 0,0:11:03.45,0:11:05.93,Caption,,0,0,0,,ТОЛЬКО ВМЕСТЕ С НИМ ПРИБАВЯТСЯ РАЗРУШЕНИЯ,
Dialogue: 0,0:11:06.08,0:11:11.45,Caption,,0,0,0,,РАСХОДЫ И РАЗДРАЖЕНИЕ ТЕХ, КОМУ СНОВА ПРЕДЛАГАЮТ ОПЛАТИТЬ БАНКЕТ. А ОЧЕРЕДЬ
Dialogue: 0,0:11:11.53,0:11:13.93,Caption,,0,0,0,,ЖЕЛАЮЩИХ ВЗЯТЬ СЛЕДУЮЩИЙ СЧЁТ НЕ РАСТЁТ.
