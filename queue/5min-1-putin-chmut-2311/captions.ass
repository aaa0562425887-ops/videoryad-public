Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,ИНОГДА САМОЕ ИНТЕРЕСНОЕ В ПОЛИТИКЕ ГОВОРЯТ ВОВСЕ НЕ
Dialogue: 0,0:00:02.92,0:00:05.56,Caption,,0,0,0,,ТЕ, ОТ КОГО ЖДЁШЬ ОТКРОВЕНИЙ. И ТУТ КАК РАЗ
Dialogue: 0,0:00:05.64,0:00:08.28,Caption,,0,0,0,,ТАКОЙ СЛУЧАЙ. ОДИН ЧЕЛОВЕК ВЫСКАЗАЛ МЫСЛЬ,
Dialogue: 0,0:00:08.52,0:00:10.60,Caption,,0,0,0,,КОТОРУЮ МНОГИЕ НАВЕРНЯКА СОЧЛИ БЫ ПОЛНОЙ
Dialogue: 0,0:00:10.60,0:00:13.64,Caption,,0,0,0,,ФАНТАСТИКОЙ. ПОТОМ С ДРУГОЙ СТОРОНЫ ПРОЗВУЧАЛО НЕЧТО
Dialogue: 0,0:00:13.64,0:00:16.12,Caption,,0,0,0,,НЕОЖИДАННО СОЗВУЧНОЕ. СОВПАДЕНИЕ,
Dialogue: 0,0:00:16.27,0:00:19.24,Caption,,0,0,0,,КОНЕЧНО, ЗАНЯТНОЕ. ОСОБЕННО ЕСЛИ ВСПОМНИТЬ,
Dialogue: 0,0:00:19.48,0:00:21.88,Caption,,0,0,0,,СКОЛЬКО СЕГОДНЯ ЛЮДЕЙ ПРЕДПОЧИТАЮТ ДЕРЖАТЬ СВОИ
Dialogue: 0,0:00:21.88,0:00:24.52,Caption,,0,0,0,,НАСТОЯЩИЕ МЫСЛИ ПРИ СЕБЕ. ТАК ЧТО ВОПРОС ДАЖЕ
Dialogue: 0,0:00:24.60,0:00:27.56,Caption,,0,0,0,,НЕ В ТОМ, КТО ПЕРВЫМ ЗАГОВОРИЛ. ВОПРОС В ТОМ,
Dialogue: 0,0:00:27.81,0:00:30.44,Caption,,0,0,0,,ПОЧЕМУ ПОДОБНЫЕ СЛОВА ВООБЩЕ НАЧАЛИ ЗВУЧАТЬ
Dialogue: 0,0:00:30.44,0:00:33.72,Caption,,0,0,0,,ПУБЛИЧНО. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ НЕОЖИДАННЫЕ СВЯЗИ
Dialogue: 0,0:00:33.80,0:00:35.96,Caption,,0,0,0,,МЕЖДУ СОБЫТИЯМИ, ПОДПИШИТЕСЬ НА КАНАЛ.
Dialogue: 0,0:00:36.76,0:00:39.56,Caption,,0,0,0,,ВЛАДИМИР ПУТИН В ИНТЕРВЬЮ ЭМИРУ КУСТУРИЦЕ ОБРАТИЛСЯ
Dialogue: 0,0:00:39.56,0:00:42.36,Caption,,0,0,0,,НЕПОСРЕДСТВЕННО К ЖИТЕЛЯМ УКРАИНЫ. ОН СКАЗАЛ,
Dialogue: 0,0:00:42.67,0:00:46.12,Caption,,0,0,0,,ЧТО ТЕ СИЛЫ, КОТОРЫЕ ПОДДЕРЖИВАЮТ КИЕВ В ПРОТИВОСТОЯНИИ С
Dialogue: 0,0:00:46.12,0:00:49.80,Caption,,0,0,0,,РОССИЕЙ, ДЕЙСТВУЮТ ПРЕЖДЕ ВСЕГО В СОБСТВЕННЫХ ИНТЕРЕСАХ. ПО
Dialogue: 0,0:00:49.80,0:00:51.88,Caption,,0,0,0,,ЕГО СЛОВАМ, ЦЕЛЬ СОСТОИТ В ТОМ,
Dialogue: 0,0:00:52.04,0:00:57.40,Caption,,0,0,0,,ЧТОБЫ ОСЛАБИТЬ, РАСЧЛЕНИТЬ, РАЗОБРАТЬ ПО ЧАСТЯМ И ПОДЧИНИТЬ СВОЕЙ ВОЛЕ. А
Dialogue: 0,0:00:57.48,0:01:00.28,Caption,,0,0,0,,ДАЛЬШЕ ПРОЗВУЧАЛО КУДА ИНТЕРЕСНЕЕ. ПУТИН ПРИЗВАЛ
Dialogue: 0,0:01:00.28,0:01:05.16,Caption,,0,0,0,,ЛЮДЕЙ, ЖИВУЩИХ НА УКРАИНЕ, СТРЕМИТЬСЯ К ОБЪЕДИНЕНИЮ С РОССИЯНАМИ. И СРАЗУ
Dialogue: 0,0:01:05.16,0:01:08.04,Caption,,0,0,0,,СДЕЛАЛ ОЧЕНЬ ВАЖНУЮ ОГОВОРКУ. НЕ ОБЯЗАТЕЛЬНО В
Dialogue: 0,0:01:08.04,0:01:10.12,Caption,,0,0,0,,РАМКАХ ЕДИНОГО ГОСУДАРСТВА. РЕЧЬ,
Dialogue: 0,0:01:10.26,0:01:13.48,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ОБ ОБЪЕДИНЕНИИ В САМОМ ШИРОКОМ СМЫСЛЕ.
Dialogue: 0,0:01:15.77,0:01:18.25,Caption,,0,0,0,,И ВОТ ТУТ ВСПОМИНАЕТСЯ ТАРАС ЧМУТ. ДА,
Dialogue: 0,0:01:18.41,0:01:20.41,Caption,,0,0,0,,ТОТ САМЫЙ ИЗВЕСТНЫЙ УКРАИНСКИЙ ВОЛОНТЁР,
Dialogue: 0,0:01:20.65,0:01:23.45,Caption,,0,0,0,,КОТОРЫЙ СОВСЕМ НЕДАВНО РАССУЖДАЛ О СОВЕРШЕННО ДИКОМ
Dialogue: 0,0:01:23.53,0:01:28.01,Caption,,0,0,0,,НА ПЕРВЫЙ ВЗГЛЯД СЦЕНАРИИ. ЕСЛИ ЕВРОПА ЗАСТАВИТ УКРАИНУ ПОЙТИ НА ТЯЖЁЛЫЕ
Dialogue: 0,0:01:28.09,0:01:32.17,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ УСТУПКИ, ТО ПОЧЕМУ УКРАИНА В БУДУЩЕМ НЕ МОЖЕТ ПЕРЕСМОТРЕТЬ
Dialogue: 0,0:01:32.17,0:01:36.09,Caption,,0,0,0,,СВОИ СОЮЗЫ? ВПЛОТЬ ДО СБЛИЖЕНИЯ С РОССИЕЙ ПРОТИВ САМОЙ ЕВРОПЫ.
Dialogue: 0,0:01:36.31,0:01:39.21,Caption,,0,0,0,,ЧМУТ ПОДЧЁРКИВАЛ, ЧТО ЭТО ПРОВОКАЦИОННЫЙ ПРИМЕР,
Dialogue: 0,0:01:39.42,0:01:41.93,Caption,,0,0,0,,А НЕ ГОТОВЫЙ ВОЕННЫЙ ПЛАН. С ОДНОЙ СТОРОНЫ
Dialogue: 0,0:01:41.93,0:01:44.73,Caption,,0,0,0,,ЭТУ МЫСЛЬ ОЗВУЧИЛ УКРАИНСКИЙ ВОЛОНТЁР. С ДРУГОЙ
Dialogue: 0,0:01:44.81,0:01:47.13,Caption,,0,0,0,,СТОРОНЫ ТЕПЕРЬ ЗВУЧИТ ПРИЗЫВ ПУТИНА ОБЪЕДИНЯТЬ
Dialogue: 0,0:01:47.13,0:01:51.05,Caption,,0,0,0,,УСИЛИЯ, ПРИЧЁМ БЕЗ ОБЯЗАТЕЛЬНОГО ОБЪЕДИНЕНИЯ ГОСУДАРСТВ. ОНИ
Dialogue: 0,0:01:51.05,0:01:53.53,Caption,,0,0,0,,ГОВОРЯТ НЕ ОДНО И ТО ЖЕ. МОТИВЫ РАЗНЫЕ,
Dialogue: 0,0:01:53.61,0:01:57.93,Caption,,0,0,0,,УСЛОВИЯ РАЗНЫЕ, ПОЛИТИЧЕСКИЕ ПОЗИЦИИ ВООБЩЕ НА РАЗНЫХ ПОЛЮСАХ. НО
Dialogue: 0,0:01:57.93,0:02:00.73,Caption,,0,0,0,,НАПРАВЛЕНИЕ МЫСЛИ СОЗВУЧНОЕ. И УЖЕ ПОЭТОМУ
Dialogue: 0,0:02:00.73,0:02:03.21,Caption,,0,0,0,,ОТМАХНУТЬСЯ ФРАЗОЙ "ДА КТО ВООБЩЕ ОБ ЭТОМ ДУМАЕТ"
Dialogue: 0,0:02:03.26,0:02:05.61,Caption,,0,0,0,,НЕ ПОЛУЧАЕТСЯ. А ВЫ КАК СЧИТАЕТЕ,
Dialogue: 0,0:02:05.83,0:02:08.49,Caption,,0,0,0,,СКОЛЬКО ЛЮДЕЙ С ОБЕИХ СТОРОН ДУМАЮТ ПРИМЕРНО ТАК
Dialogue: 0,0:02:08.57,0:02:11.77,Caption,,0,0,0,,ЖЕ, НО ПОКА ПРОСТО МОЛЧАТ? НЕ ПОЛИТИКИ НА ТРИБУНЕ,
Dialogue: 0,0:02:12.09,0:02:16.17,Caption,,0,0,0,,НЕ БЛОГЕРЫ С МИКРОФОНОМ, А ОБЫЧНЫЕ ЛЮДИ. ИХ НЕ ВИДНО. ОНИ НЕ
Dialogue: 0,0:02:16.17,0:02:19.45,Caption,,0,0,0,,ОТСВЕЧИВАЮТ. ПОТОМУ ЧТО СЕГОДНЯ СКАЗАТЬ ВСЛУХ НЕ ТО,
Dialogue: 0,0:02:19.61,0:02:21.21,Caption,,0,0,0,,ЧТО ПРИНЯТО В ТВОЁМ ОКРУЖЕНИИ,
Dialogue: 0,0:02:21.53,0:02:25.45,Caption,,0,0,0,,ИНОГДА ГОРАЗДО СЛОЖНЕЕ, ЧЕМ ПРОМОЛЧАТЬ. ТАКИХ ЛЮДЕЙ С ОДНОЙ И С
Dialogue: 0,0:02:25.53,0:02:28.89,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ КУДА БОЛЬШЕ, ЧЕМ КАЖЕТСЯ ПО ПУБЛИЧНОЙ КАРТИНКЕ.
Dialogue: 0,0:02:31.16,0:02:35.08,Caption,,0,0,0,,ПРОСТО СЕЙЧАС ВРЕМЯ ТАКОЕ, ЧТО БОЛЬШИНСТВО ИЗ НИХ ТИХОНЕЧКО СИДЯТ И НЕ
Dialogue: 0,0:02:35.08,0:02:37.88,Caption,,0,0,0,,ВЫСОВЫВАЮТСЯ. И ПОКА КОНФЛИКТ ПРОДОЛЖАЕТСЯ,
Dialogue: 0,0:02:38.12,0:02:40.12,Caption,,0,0,0,,ДРУГОГО ПОВЕДЕНИЯ ОТ НИХ ЖДАТЬ ТРУДНО.
Dialogue: 0,0:02:40.81,0:02:43.32,Caption,,0,0,0,,НО ДАВАЙТЕ ЗАДАДИМ ЕЩЁ БОЛЕЕ НЕУДОБНЫЙ ВОПРОС.
Dialogue: 0,0:02:43.64,0:02:48.20,Caption,,0,0,0,,НАСКОЛЬКО ВООБЩЕ РЕАЛИСТИЧНО, ЧТО РУССКИЕ И УКРАИНЦЫ КОГДА НИБУДЬ СНОВА СМОГУТ
Dialogue: 0,0:02:48.28,0:02:50.44,Caption,,0,0,0,,ДЕЙСТВОВАТЬ ВМЕСТЕ ПРОТИВ ОБЩЕГО ПРОТИВНИКА?
Dialogue: 0,0:02:50.74,0:02:53.72,Caption,,0,0,0,,ДЛЯ МНОГИХ ОТВЕТ ОЧЕВИДЕН. НИКОГДА. ПОСЛЕ ВСЕГО
Dialogue: 0,0:02:53.72,0:02:56.92,Caption,,0,0,0,,ПРОИЗОШЕДШЕГО НИКТО НИКОГО НЕ ПРОСТИТ. СЛИШКОМ МНОГО
Dialogue: 0,0:02:57.00,0:02:58.92,Caption,,0,0,0,,КРОВИ, СЛИШКОМ МНОГО ПОГИБШИХ,
Dialogue: 0,0:02:59.00,0:03:03.56,Caption,,0,0,0,,СЛИШКОМ МНОГО НЕНАВИСТИ. ВСЁ, ТОЧКА. ТОЛЬКО ИСТОРИЯ ОЧЕНЬ НЕ ЛЮБИТ СЛОВО
Dialogue: 0,0:03:03.56,0:03:06.92,Caption,,0,0,0,,"НИКОГДА". ВОЗЬМИТЕ ГРАЖДАНСКУЮ ВОЙНУ В РОССИИ. БРАТ
Dialogue: 0,0:03:07.00,0:03:10.76,Caption,,0,0,0,,ШЁЛ НА БРАТА, ОТЕЦ НА СЫНА. СТРАНА БЫЛА РАЗОРВАНА ТАК,
Dialogue: 0,0:03:10.92,0:03:13.24,Caption,,0,0,0,,ЧТО НЫНЕШНЕМУ ЧЕЛОВЕКУ ДАЖЕ ТРУДНО ПРЕДСТАВИТЬ
Dialogue: 0,0:03:13.24,0:03:16.12,Caption,,0,0,0,,МАСШТАБ ЭТОЙ НЕНАВИСТИ. А ЧЕРЕЗ ДВА ДЕСЯТИЛЕТИЯ
Dialogue: 0,0:03:16.20,0:03:17.88,Caption,,0,0,0,,ПЕРЕД ЛЮДЬМИ ВСТАЛА УЖЕ ДРУГАЯ,
Dialogue: 0,0:03:18.04,0:03:20.92,Caption,,0,0,0,,ОБЩАЯ УГРОЗА. НАЦИСТСКАЯ ГЕРМАНИЯ ПРИШЛА НЕ
Dialogue: 0,0:03:20.92,0:03:23.40,Caption,,0,0,0,,ВЫЯСНЯТЬ, КТО В КАКОЙ СЕМЬЕ БЫЛ КРАСНЫМ,
Dialogue: 0,0:03:23.71,0:03:25.96,Caption,,0,0,0,,КТО БЕЛЫМ И КТО С КЕМ СПОРИЛ ДВАДЦАТЬ
Dialogue: 0,0:03:26.04,0:03:30.68,Caption,,0,0,0,,ЛЕТ НАЗАД. ЭТО НЕ ОЗНАЧАЕТ, ЧТО ИСТОРИЯ ОБЯЗАНА ПОВТОРИТЬ ТОТ ЖЕ МАРШРУТ. НО
Dialogue: 0,0:03:30.68,0:03:33.16,Caption,,0,0,0,,ИСТОРИЧЕСКИЙ ОПЫТ ТОЧНО НЕ ПОЗВОЛЯЕТ СКАЗАТЬ,
Dialogue: 0,0:03:33.40,0:03:36.28,Caption,,0,0,0,,ЧТО ВЧЕРАШНИЕ ПРОТИВНИКИ НАВЕЧНО ОБРЕЧЕНЫ ОСТАВАТЬСЯ
Dialogue: 0,0:03:36.28,0:03:39.24,Caption,,0,0,0,,ПРОТИВНИКАМИ. ОБСТОЯТЕЛЬСТВА МЕНЯЮТСЯ. ПОКОЛЕНИЯ
Dialogue: 0,0:03:39.24,0:03:41.80,Caption,,0,0,0,,МЕНЯЮТСЯ. МЕНЯЕТСЯ И ОТВЕТ НА ВОПРОС,
Dialogue: 0,0:03:41.96,0:03:44.36,Caption,,0,0,0,,КТО ДЛЯ ТЕБЯ СЕГОДНЯ СВОЙ, А КТО ЧУЖОЙ.
Dialogue: 0,0:03:46.62,0:03:50.79,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСЕН ИМЕННО ЭТОТ ВТОРОЙ СЛОЙ. ЛОЗУНГИ
Dialogue: 0,0:03:50.79,0:03:55.19,Caption,,0,0,0,,СЛЫШАТ ВСЕ. А ВОТ ТО, КАК РЯДОМ НАЧИНАЮТ СКЛАДЫВАТЬСЯ РАЗНЫЕ СИГНАЛЫ,
Dialogue: 0,0:03:55.45,0:03:57.75,Caption,,0,0,0,,ОБЫЧНО ЗАМЕЧАЮТ ПОЗЖЕ. И ПУТИН,
Dialogue: 0,0:03:57.96,0:04:01.67,Caption,,0,0,0,,КСТАТИ, ПРОДОЛЖИЛ ИМЕННО В ЭТУ СТОРОНУ. В ДРУГОМ ЗАЯВЛЕНИИ
Dialogue: 0,0:04:01.75,0:04:05.11,Caption,,0,0,0,,ОН ПРОТИВОПОСТАВИЛ ПАТРИОТИЗМ НАЦИОНАЛИЗМУ. ПАТРИОТ,
Dialogue: 0,0:04:05.28,0:04:09.51,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ЛЮБИТ СВОЮ СТРАНУ. НАЦИОНАЛИСТ НЕНАВИДИТ ДРУГИЕ
Dialogue: 0,0:04:09.51,0:04:12.63,Caption,,0,0,0,,НАРОДЫ. И НА НЕНАВИСТИ ДАЛЕКО НЕ УЕДЕШЬ. ПОСЛЕ
Dialogue: 0,0:04:12.63,0:04:15.11,Caption,,0,0,0,,ЭТОГО ОН СНОВА ОБРАТИЛСЯ К УКРАИНЦАМ И ПРЕДЛОЖИЛ
Dialogue: 0,0:04:15.19,0:04:17.83,Caption,,0,0,0,,ДУМАТЬ НЕ ТОЛЬКО О ТОМ, ЧТО ПРОИСХОДИТ СЕЙЧАС,
Dialogue: 0,0:04:18.15,0:04:21.83,Caption,,0,0,0,,НО И О БУДУЩЕМ ДЕТЕЙ. ЕСЛИ ЛЮДИ ХОТЯТ БЫТЬ СИЛЬНЫМИ,
Dialogue: 0,0:04:21.94,0:04:25.11,Caption,,0,0,0,,ЗНАЧИМЫМИ И ИМЕТЬ УСЛОВИЯ ДЛЯ НОРМАЛЬНОГО РАЗВИТИЯ,
Dialogue: 0,0:04:25.26,0:04:29.59,Caption,,0,0,0,,СКАЗАЛ ПУТИН, УСИЛИЯ ПРИДЁТСЯ ОБЪЕДИНЯТЬ. ОБРАТИТЕ ВНИМАНИЕ,
Dialogue: 0,0:04:29.72,0:04:32.63,Caption,,0,0,0,,КАК ПОСТРОЕНО ЭТО ОБРАЩЕНИЕ. ЭТО УЖЕ НЕ РАЗГОВОР
Dialogue: 0,0:04:32.71,0:04:36.55,Caption,,0,0,0,,ТОЛЬКО С БАНКОВОЙ, НЕ СПОР МИНИСТРОВ И НЕ ОЧЕРЕДНАЯ ФОРМУЛА ДЛЯ
Dialogue: 0,0:04:36.55,0:04:39.35,Caption,,0,0,0,,ПЕРЕГОВОРЩИКОВ. ЭТО ПОПЫТКА ГОВОРИТЬ ЧЕРЕЗ ГОЛОВУ
Dialogue: 0,0:04:39.35,0:04:42.23,Caption,,0,0,0,,НЫНЕШНЕЙ ВЛАСТИ ПРЯМО С ЛЮДЬМИ. СНАЧАЛА ОБЩИЙ
Dialogue: 0,0:04:42.31,0:04:47.03,Caption,,0,0,0,,ПРОТИВНИК, ПОТОМ ДЕТИ, ПОТОМ СОВМЕСТНОЕ РАЗВИТИЕ. ЛАВРОВ ЗАЯВИЛ,
Dialogue: 0,0:04:47.27,0:04:51.35,Caption,,0,0,0,,ЧТО ЮГО ВОСТОК УКРАИНЫ, ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ЦЕНТРАЛЬНОЙ УКРАИНЫ И КИЕВ
Dialogue: 0,0:04:51.59,0:04:54.47,Caption,,0,0,0,,ЯВЛЯЮТСЯ ИСКОННО РУССКИМИ ЗЕМЛЯМИ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:04:54.47,0:04:57.35,Caption,,0,0,0,,ОТВЕЧАЕТ С ПРОТИВОПОЛОЖНОЙ СТОРОНЫ. ЕСЛИ БЫ УКРАИНА
Dialogue: 0,0:04:57.35,0:04:59.59,Caption,,0,0,0,,ХОТЕЛА ОТДАТЬ СВОИ ТЕРРИТОРИИ РОССИИ,
Dialogue: 0,0:04:59.67,0:05:02.63,Caption,,0,0,0,,ГОВОРИТ ОН, ОНА ПОКАЗАЛА БЫ ЭТО ЕЩЁ В ДВАДЦАТЬ ВТОРОМ
Dialogue: 0,0:05:02.63,0:05:07.79,Caption,,0,0,0,,ГОДУ. ВМЕСТО ЭТОГО КИЕВ ПРОДЕМОНСТРИРОВАЛ ГОТОВНОСТЬ
Dialogue: 0,0:05:07.79,0:05:11.39,Caption,,0,0,0,,ЗАЩИЩАТЬСЯ. ИНТЕРЕСНЕЕ ДРУГОЕ. ОДНОВРЕМЕННО С ЭТИМ
Dialogue: 0,0:05:11.39,0:05:13.87,Caption,,0,0,0,,СПОРОМ ПУТИН ГОВОРИТ НЕ ОБ ОДНОМ ГОСУДАРСТВЕ,
Dialogue: 0,0:05:14.11,0:05:17.31,Caption,,0,0,0,,А ОБ ОБЪЕДИНЕНИИ УСИЛИЙ. ТО ЕСТЬ ПУБЛИЧНЫЙ РАЗГОВОР
Dialogue: 0,0:05:17.39,0:05:19.71,Caption,,0,0,0,,О БУДУЩЕМ УЖЕ НЕ УКЛАДЫВАЕТСЯ В ПРОСТУЮ СХЕМУ
Dialogue: 0,0:05:19.71,0:05:22.75,Caption,,0,0,0,,"КТО ЗАБЕРЁТ КАКУЮ ОБЛАСТЬ". ТАМ ПОЯВЛЯЕТСЯ ВОПРОС,
Dialogue: 0,0:05:23.07,0:05:25.55,Caption,,0,0,0,,КАКИМИ ВООБЩЕ МОГУТ СТАТЬ ОТНОШЕНИЯ МЕЖДУ ДВУМЯ
Dialogue: 0,0:05:25.63,0:05:28.35,Caption,,0,0,0,,НАРОДАМИ ПОСЛЕ ОКОНЧАНИЯ НЫНЕШНЕГО ПРОТИВОСТОЯНИЯ.
Dialogue: 0,0:05:28.62,0:05:31.55,Caption,,0,0,0,,ПУТИН ПАРАЛЛЕЛЬНО ПРЕДЛАГАЕТ И СВОЁ ОБЪЯСНЕНИЕ ТОГО,
Dialogue: 0,0:05:31.71,0:05:34.03,Caption,,0,0,0,,ПОЧЕМУ УКРАИНА ВООБЩЕ ОКАЗАЛАСЬ В НЫНЕШНЕМ
Dialogue: 0,0:05:34.03,0:05:38.35,Caption,,0,0,0,,ПОЛОЖЕНИИ. ПО ЕГО ВЕРСИИ, РАЗРУШЕНИЕ НАЧАЛОСЬ НЕ ОТ ПОСЛЕДНИХ РОССИЙСКИХ
Dialogue: 0,0:05:38.35,0:05:40.51,Caption,,0,0,0,,УДАРОВ. ОНО НАЧАЛОСЬ ГОРАЗДО РАНЬШЕ,
Dialogue: 0,0:05:40.67,0:05:43.55,Caption,,0,0,0,,ПОСЛЕ РАСПАДА СОВЕТСКОГО СОЮЗА. ОН ПЕРЕЧИСЛЯЕТ
Dialogue: 0,0:05:43.55,0:05:47.95,Caption,,0,0,0,,СУДОСТРОЕНИЕ, АВИАСТРОЕНИЕ И РАКЕТНУЮ ПРОМЫШЛЕННОСТЬ. ГОВОРИТ,
Dialogue: 0,0:05:48.27,0:05:50.43,Caption,,0,0,0,,ЧТО НАСЕЛЕНИЕ СОКРАТИЛОСЬ С ПЯТИДЕСЯТИ ДВУХ
Dialogue: 0,0:05:50.51,0:05:53.71,Caption,,0,0,0,,МИЛЛИОНОВ ПРИМЕРНО ДО ДВАДЦАТИ МИЛЛИОНОВ. И ОТДЕЛЬНО
Dialogue: 0,0:05:53.71,0:05:56.51,Caption,,0,0,0,,ПОДЧЁРКИВАЕТ, ЧТО ВСЁ ЭТО, ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:05:56.82,0:05:59.47,Caption,,0,0,0,,РУХНУЛО ЗАДОЛГО ДО НЫНЕШНИХ ОТВЕТНЫХ УДАРОВ
Dialogue: 0,0:05:59.55,0:06:02.03,Caption,,0,0,0,,РОССИЙСКИХ РАКЕТНЫХ ВОЙСК. ОТВЕТСТВЕННОСТЬ ОН
Dialogue: 0,0:06:02.11,0:06:04.19,Caption,,0,0,0,,ВОЗЛАГАЕТ НА УКРАИНСКИХ НАЦИОНАЛИСТОВ.
Dialogue: 0,0:06:04.92,0:06:06.67,Caption,,0,0,0,,МОЖНО СОГЛАШАТЬСЯ С ЭТОЙ КАРТИНОЙ,
Dialogue: 0,0:06:06.84,0:06:09.07,Caption,,0,0,0,,МОЖНО СПОРИТЬ С НЕЙ. НО ДЛЯ НАШЕЙ ТЕМЫ
Dialogue: 0,0:06:09.07,0:06:11.87,Caption,,0,0,0,,ВАЖНЕЕ ДРУГОЕ. ПУТИН ОДНОВРЕМЕННО ДАЁТ УКРАИНЦАМ
Dialogue: 0,0:06:11.87,0:06:14.83,Caption,,0,0,0,,ОБЪЯСНЕНИЕ ПРОШЛОГО И ПРЕДЛАГАЕТ ИМ МОДЕЛЬ БУДУЩЕГО.
Dialogue: 0,0:06:17.12,0:06:19.52,Caption,,0,0,0,,БЫЛО ВОТ ТАК, К ЭТОМУ ПРИВЕЛО ВОТ ЭТО,
Dialogue: 0,0:06:19.81,0:06:24.96,Caption,,0,0,0,,А ДАЛЬШЕ, ПО ЕГО ЛОГИКЕ, НАДО ИСКАТЬ ОБЪЕДИНЕНИЕ УСИЛИЙ. ЗЕЛЕНСКИЙ РИСУЕТ
Dialogue: 0,0:06:25.04,0:06:27.36,Caption,,0,0,0,,СОВЕРШЕННО ДРУГУЮ КАРТИНУ. ОН ЗАЯВИЛ,
Dialogue: 0,0:06:27.52,0:06:30.00,Caption,,0,0,0,,ЧТО РОССИЯ ПРОИГРАЛА ДВАДЦАТЬ ШЕСТОЙ ГОД НА ПОЛЕ
Dialogue: 0,0:06:30.00,0:06:34.32,Caption,,0,0,0,,БОЯ. ПО ЕГО СЛОВАМ, МОСКВА ПЫТАЕТСЯ КОМПЕНСИРОВАТЬ ЭТО БАЛЛИСТИЧЕСКИМИ
Dialogue: 0,0:06:34.32,0:06:37.04,Caption,,0,0,0,,УДАРАМИ ПО ГРАЖДАНСКОМУ НАСЕЛЕНИЮ. ЗАЯВЛЕНИЕ
Dialogue: 0,0:06:37.04,0:06:39.68,Caption,,0,0,0,,ПРОЗВУЧАЛО НА ФОНЕ УДАРОВ ПО МОСТУ И НОВЫХ
Dialogue: 0,0:06:39.68,0:06:42.56,Caption,,0,0,0,,КРУПНЫХ ВЛИВАНИЙ ОТ ПАРТНЁРОВ КИЕВА. ЗЕЛЕНСКИЙ ТАКЖЕ
Dialogue: 0,0:06:42.56,0:06:44.16,Caption,,0,0,0,,ГОВОРИЛ О "НЕЧЕСТНЫХ ПРАВИЛАХ",
Dialogue: 0,0:06:44.44,0:06:47.36,Caption,,0,0,0,,НАЗЫВАЛ САМУ ЭТУ ВОЙНУ БЕСПЕРСПЕКТИВНОЙ ДЛЯ РОССИИ,
Dialogue: 0,0:06:47.60,0:06:50.88,Caption,,0,0,0,,ОБВИНЯЛ МОСКВУ В РАЗДЕЛЕНИИ ЕВРОПЫ И НАЗЫВАЛ ВСТРЕЧУ
Dialogue: 0,0:06:50.96,0:06:53.84,Caption,,0,0,0,,"КОАЛИЦИИ ЖЕЛАЮЩИХ" ДЕМОНСТРАЦИЕЙ ПРОИГРЫША ПУТИНА.
Dialogue: 0,0:06:54.39,0:06:57.12,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ЕСТЬ ЗАНЯТНАЯ ДЕТАЛЬ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:06:57.20,0:06:59.36,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРИЗНАЁТ, ЧТО НЕ ЗНАЕТ,
Dialogue: 0,0:06:59.59,0:07:02.08,Caption,,0,0,0,,О ЧЁМ ИМЕННО ПУТИН ГОВОРИЛ С ТРАМПОМ. ЕГО
Dialogue: 0,0:07:02.08,0:07:04.00,Caption,,0,0,0,,СОБСТВЕННЫЕ СЛОВА "МЫ НЕ ЗНАЕМ,
Dialogue: 0,0:07:04.23,0:07:06.32,Caption,,0,0,0,,О ЧЁМ ОНИ ГОВОРИЛИ". ПРИ ЭТОМ ОН ПЕРЕДАЁТ
Dialogue: 0,0:07:06.32,0:07:09.36,Caption,,0,0,0,,СИГНАЛ ТРАМПА О ЖЕЛАНИИ ЗАКОНЧИТЬ БОЕВЫЕ ДЕЙСТВИЯ И
Dialogue: 0,0:07:09.44,0:07:13.28,Caption,,0,0,0,,ТУТ ЖЕ ПОДЧЁРКИВАЕТ, НАСКОЛЬКО ВАЖНА СИЛЬНАЯ ЕВРОПА. ПОЛУЧАЕТСЯ
Dialogue: 0,0:07:13.28,0:07:16.24,Caption,,0,0,0,,ЛЮБОПЫТНАЯ КОНСТРУКЦИЯ. ПУБЛИЧНО ОБЪЯВЛЯЕТСЯ
Dialogue: 0,0:07:16.32,0:07:19.36,Caption,,0,0,0,,ПРОИГРЫШ РОССИИ. ОДНОВРЕМЕННО СОДЕРЖАНИЕ РАЗГОВОРА
Dialogue: 0,0:07:19.36,0:07:22.40,Caption,,0,0,0,,МЕЖДУ ПУТИНЫМ И ТРАМПОМ КИЕВУ НЕИЗВЕСТНО. ТРАМП
Dialogue: 0,0:07:22.40,0:07:25.68,Caption,,0,0,0,,СИГНАЛИЗИРУЕТ О ЖЕЛАНИИ ЗАКОНЧИТЬ КОНФЛИКТ. ЕВРОПА,
Dialogue: 0,0:07:25.76,0:07:28.88,Caption,,0,0,0,,НАПРОТИВ, ОСТАЁТСЯ ДЛЯ ЗЕЛЕНСКОГО КЛЮЧЕВОЙ ОПОРОЙ.
Dialogue: 0,0:07:31.15,0:07:32.91,Caption,,0,0,0,,И НА ЭТОМ ФОНЕ РАЗГОВОР О ТОМ,
Dialogue: 0,0:07:33.00,0:07:35.63,Caption,,0,0,0,,КТО С КЕМ ВООБЩЕ ОКАЖЕТСЯ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ,
Dialogue: 0,0:07:35.94,0:07:37.71,Caption,,0,0,0,,УЖЕ НЕ ВЫГЛЯДИТ НАСТОЛЬКО СМЕШНЫМ,
Dialogue: 0,0:07:37.91,0:07:40.99,Caption,,0,0,0,,КАК КАЗАЛСЯ ЕЩЁ НЕДАВНО. ТЕМ БОЛЕЕ ЧТО ПОЯВЛЯЕТСЯ
Dialogue: 0,0:07:41.07,0:07:45.15,Caption,,0,0,0,,ЕЩЁ ОДИН СИГНАЛ, НА ЭТОТ РАЗ ИЗ РОССИИ. ПО СООБЩЕНИЯМ СМИ,
Dialogue: 0,0:07:45.39,0:07:47.95,Caption,,0,0,0,,НА ЗАКРЫТОМ СЕМИНАРЕ ДЕПУТАТАМ ГОСДУМЫ ПОРУЧИЛИ
Dialogue: 0,0:07:47.95,0:07:50.75,Caption,,0,0,0,,ГОТОВИТЬСЯ К ОКОНЧАНИЮ СВО И ВОЗВРАЩЕНИЮ
Dialogue: 0,0:07:50.75,0:07:52.83,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. РЕЧЬ ШЛА О ТОМ,
Dialogue: 0,0:07:52.99,0:07:55.55,Caption,,0,0,0,,ЧТОБЫ ЗАРАНЕЕ АКТИВНЕЕ РАБОТАТЬ С ВЕТЕРАНАМИ И
Dialogue: 0,0:07:55.55,0:07:58.67,Caption,,0,0,0,,ОБЫЧНЫМИ ЛЮДЬМИ, ГОТОВИТЬСЯ К ПОБЕДЕ И К МОМЕНТУ,
Dialogue: 0,0:07:58.88,0:08:01.63,Caption,,0,0,0,,КОГДА УЧАСТНИКИ БОЕВЫХ ДЕЙСТВИЙ ОДНОМОМЕНТНО НАЧНУТ
Dialogue: 0,0:08:01.63,0:08:03.55,Caption,,0,0,0,,ВОЗВРАЩАТЬСЯ С ФРОНТА. ПОДЧЕРКНУ,
Dialogue: 0,0:08:03.79,0:08:06.35,Caption,,0,0,0,,РЕЧЬ ИДЁТ ИМЕННО О СООБЩЕНИИ СМИ О ЗАКРЫТОМ
Dialogue: 0,0:08:06.43,0:08:09.23,Caption,,0,0,0,,СЕМИНАРЕ. НО САМА ПОСТАНОВКА ВОПРОСА ИНТЕРЕСНА.
Dialogue: 0,0:08:09.44,0:08:12.11,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ АППАРАТ ПРЕДЛАГАЮТ ЗАРАНЕЕ ГОТОВИТЬ НЕ
Dialogue: 0,0:08:12.11,0:08:13.79,Caption,,0,0,0,,ТОЛЬКО К ПРОДОЛЖЕНИЮ КОНФЛИКТА,
Dialogue: 0,0:08:14.11,0:08:16.03,Caption,,0,0,0,,НО И К ТОМУ, ЧТО БУДЕТ ПОСЛЕ НЕГО.
Dialogue: 0,0:08:16.59,0:08:19.55,Caption,,0,0,0,,И ТУТ ПОЯВЛЯЕТСЯ ОЧЕНЬ РЕЗКАЯ ПАРАЛЛЕЛЬ. РАЗГОВОР О
Dialogue: 0,0:08:19.55,0:08:22.03,Caption,,0,0,0,,МАССОВОМ ВОЗВРАЩЕНИИ ФРОНТОВИКОВ ИДЁТ ПО ОБЕ
Dialogue: 0,0:08:22.03,0:08:25.39,Caption,,0,0,0,,СТОРОНЫ. ТОЛЬКО ВЫГЛЯДИТ ОН ПО РАЗНОМУ. В РОССИИ,
Dialogue: 0,0:08:25.51,0:08:29.95,Caption,,0,0,0,,СУДЯ ПО ЭТОМУ СООБЩЕНИЮ, ДЕПУТАТАМ ГОВОРЯТ ГОТОВЬТЕСЬ РАБОТАТЬ С ВЕТЕРАНАМИ,
Dialogue: 0,0:08:30.19,0:08:34.91,Caption,,0,0,0,,ГОТОВЬТЕСЬ К ИХ ВОЗВРАЩЕНИЮ, ГОТОВЬТЕСЬ К НОВОЙ РЕАЛЬНОСТИ. А НА УКРАИНЕ ЧАСТЬ
Dialogue: 0,0:08:34.99,0:08:37.15,Caption,,0,0,0,,ВЛАСТИ БОИТСЯ НЕ РАСХОДОВ НА ВЕТЕРАНОВ.
Dialogue: 0,0:08:39.43,0:08:43.99,Caption,,0,0,0,,ОНА БОИТСЯ САМИХ ЛЮДЕЙ, КОТОРЫЕ ВЕРНУТСЯ С ФРОНТА УЖЕ СО СВОИМИ ПРЕТЕНЗИЯМИ
Dialogue: 0,0:08:44.07,0:08:46.79,Caption,,0,0,0,,К ТЕМ, КТО ВСЕ ЭТИ ГОДЫ СИДЕЛ ДАЛЕКО ОТ ОКОПОВ.
Dialogue: 0,0:08:47.35,0:08:51.67,Caption,,0,0,0,,ТО ЕСТЬ ОДНИ ГОТОВЯТСЯ ТАК, А ДРУГИМ СТРАШНО ГОТОВИТЬСЯ. И ВОТ ТЕПЕРЬ СЛОЖИТЕ
Dialogue: 0,0:08:51.75,0:08:54.87,Caption,,0,0,0,,ЭТИ ВЕЩИ ВМЕСТЕ. НЕ ДЛЯ ТОГО, ЧТОБЫ ОБЪЯВИТЬ,
Dialogue: 0,0:08:55.19,0:08:57.99,Caption,,0,0,0,,БУДТО ЗАВТРА ВСЕ ОБНИМУТСЯ И ПОЙДУТ БРАТАТЬСЯ. ЭТО
Dialogue: 0,0:08:57.99,0:09:00.31,Caption,,0,0,0,,БЫЛО БЫ ПРОСТО СМЕШНО. А ЧТОБЫ УВИДЕТЬ,
Dialogue: 0,0:09:00.50,0:09:03.59,Caption,,0,0,0,,НАСКОЛЬКО ШИРЕ СТАНОВИТСЯ РАЗГОВОР О БУДУЩЕМ. ПУТИН
Dialogue: 0,0:09:03.59,0:09:06.47,Caption,,0,0,0,,ГОВОРИТ УКРАИНЦАМ ОБ ОБЪЕДИНЕНИИ УСИЛИЙ И СПЕЦИАЛЬНО
Dialogue: 0,0:09:06.47,0:09:10.55,Caption,,0,0,0,,УТОЧНЯЕТ, ЧТО ЕДИНОЕ ГОСУДАРСТВО ДЛЯ ЭТОГО НЕ ТРЕБУЕТСЯ. ЧМУТ
Dialogue: 0,0:09:10.63,0:09:12.71,Caption,,0,0,0,,С УКРАИНСКОЙ СТОРОНЫ УЖЕ ДОПУСКАЛ СЦЕНАРИЙ
Dialogue: 0,0:09:12.71,0:09:15.35,Caption,,0,0,0,,ПЕРЕСМОТРА СОЮЗОВ И ДАЖЕ СБЛИЖЕНИЯ С РОССИЕЙ,
Dialogue: 0,0:09:15.67,0:09:18.07,Caption,,0,0,0,,ЕСЛИ ПРЕЖНИЕ СОЮЗНИКИ НАЧНУТ ДИКТОВАТЬ УКРАИНЕ
Dialogue: 0,0:09:18.07,0:09:21.03,Caption,,0,0,0,,НЕПРИЕМЛЕМЫЕ УСЛОВИЯ. ЛАВРОВ ГОВОРИТ ОБ ОБЩЕЙ
Dialogue: 0,0:09:21.03,0:09:23.51,Caption,,0,0,0,,ИСТОРИЧЕСКОЙ ЗЕМЛЕ. ЗЕЛЕНСКИЙ ОТВЕЧАЕТ,
Dialogue: 0,0:09:23.75,0:09:26.55,Caption,,0,0,0,,ЧТО ТЕРРИТОРИИ ОТДАВАТЬ НЕ СОБИРАЕТСЯ. РОССИЙСКИХ
Dialogue: 0,0:09:26.55,0:09:31.83,Caption,,0,0,0,,ДЕПУТАТОВ, ПО СООБЩЕНИЯМ СМИ, УЖЕ ГОТОВЯТ К МАССОВОМУ ВОЗВРАЩЕНИЮ ЛЮДЕЙ С ФРОНТА.
Dialogue: 0,0:09:32.17,0:09:34.71,Caption,,0,0,0,,А ГДЕ ТО МЕЖДУ ВСЕМИ ЭТИМИ ГРОМКИМИ ЗАЯВЛЕНИЯМИ
Dialogue: 0,0:09:34.71,0:09:38.95,Caption,,0,0,0,,СИДЯТ МИЛЛИОНЫ ОБЫЧНЫХ ЛЮДЕЙ, КОТОРЫМ ПОТОМ И ПРИДЁТСЯ ЖИТЬ В ТОМ МИРЕ,
Dialogue: 0,0:09:39.19,0:09:42.07,Caption,,0,0,0,,КОТОРЫЙ ПОЛИТИКИ СЕЙЧАС ПЫТАЮТСЯ НАРИСОВАТЬ. ВЫ
Dialogue: 0,0:09:42.07,0:09:46.15,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО СЧИТАЕТЕ, ЧТО ПОСЛЕ ВСЕГО ПРОИЗОШЕДШЕГО РУССКИЕ И УКРАИНЦЫ УЖЕ
Dialogue: 0,0:09:46.15,0:09:48.79,Caption,,0,0,0,,НИКОГДА НЕ СМОГУТ ОКАЗАТЬСЯ ПО ОДНУ СТОРОНУ КАКОЙ
Dialogue: 0,0:09:48.87,0:09:53.95,Caption,,0,0,0,,ТО БОЛЬШОЙ ПРОБЛЕМЫ? НИКОГДА НЕ СМОГУТ СНОВА СОТРУДНИЧАТЬ?
Dialogue: 0,0:09:54.33,0:09:56.83,Caption,,0,0,0,,НИКОГДА НЕ НАЙДУТ ОБЩЕГО ПРОТИВНИКА ИЛИ ХОТЯ БЫ
Dialogue: 0,0:09:56.91,0:10:00.75,Caption,,0,0,0,,ОБЩИЙ ИНТЕРЕС? ИЛИ СЛОВО "НИКОГДА" ЗДЕСЬ ПРОСТО ЗВУЧИТ СЛИШКОМ
Dialogue: 0,0:10:00.75,0:10:04.19,Caption,,0,0,0,,УВЕРЕННО ДЛЯ ИСТОРИИ, КОТОРАЯ УЖЕ НЕ РАЗ ПОКАЗЫВАЛА ЛЮДЯМ,
Dialogue: 0,0:10:04.43,0:10:06.99,Caption,,0,0,0,,НАСКОЛЬКО БЫСТРО ОНА УМЕЕТ МЕНЯТЬ ДЕКОРАЦИИ?
Dialogue: 0,0:10:07.45,0:10:10.03,Caption,,0,0,0,,СЕГОДНЯ ТАКОЙ СЦЕНАРИЙ ДЛЯ ОГРОМНОГО ЧИСЛА ЛЮДЕЙ
Dialogue: 0,0:10:10.11,0:10:12.75,Caption,,0,0,0,,ВЫГЛЯДИТ НЕВОЗМОЖНЫМ. НО ЕЩЁ НЕДАВНО НЕВОЗМОЖНЫМ
