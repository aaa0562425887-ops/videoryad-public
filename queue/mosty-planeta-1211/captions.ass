Dialogue: 0,0:00:00.12,0:00:03.24,Caption,,0,0,0,,КИЕВЛЯНАМ ПРЕДЛАГАЮТ СТРАННУЮ УСЛУГУ УЗНАТЬ ЗАРАНЕЕ,
Dialogue: 0,0:00:03.53,0:00:06.28,Caption,,0,0,0,,КАКИЕ МОСТЫ РИСКУЮТ ВСТАТЬ И ПОЧЕМУ ЖИЗНЬ В
Dialogue: 0,0:00:06.28,0:00:09.08,Caption,,0,0,0,,КРУПНЫХ ГОРОДАХ СКОРО СТАНЕТ ПРОВЕРКОЙ НА ПРОЧНОСТЬ.
Dialogue: 0,0:00:09.80,0:00:12.60,Caption,,0,0,0,,ОФИЦЕР УКРАИНСКИХ ШТУРМОВЫХ ВОЙСК ДЕНИС ЯРОСЛАВСКИЙ
Dialogue: 0,0:00:12.60,0:00:16.12,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО РОССИЙСКОЕ КОМАНДОВАНИЕ ЯКОБЫ НАМЕРЕНО РАЗРУШИТЬ
Dialogue: 0,0:00:16.12,0:00:18.68,Caption,,0,0,0,,ПЕРЕПРАВЫ ЧЕРЕЗ ДНЕПР И СДЕЛАТЬ КИЕВ,
Dialogue: 0,0:00:18.76,0:00:22.12,Caption,,0,0,0,,ХАРЬКОВ И ОДЕССУ НЕПРИГОДНЫМИ ДЛЯ НОРМАЛЬНОЙ ЖИЗНИ.
Dialogue: 0,0:00:22.41,0:00:25.24,Caption,,0,0,0,,КАРТИНА ВЫХОДИТ ЛЮБОПЫТНАЯ. ПЛАН ПРОТИВНИКА КАК БЫ
Dialogue: 0,0:00:25.24,0:00:30.36,Caption,,0,0,0,,РАСКРЫТ, ВОЕННЫЕ В КУРСЕ, ГРАЖДАНАМ ВСЁ РАСТОЛКОВАЛИ. ОСТАЛАСЬ МЕЛОЧЬ НЕ ДАТЬ
Dialogue: 0,0:00:30.36,0:00:33.32,Caption,,0,0,0,,ЭТОМУ ПЛАНУ СЛУЧИТЬСЯ. И ВОТ ЗДЕСЬ ГРОМКИЕ СЛОВА
Dialogue: 0,0:00:33.32,0:00:38.04,Caption,,0,0,0,,ОБЫЧНО СТИХАЮТ. ТЕМА МОСТОВ ПОЯВИЛАСЬ НЕ СЕГОДНЯ. УКРАИНСКАЯ СТОРОНА
Dialogue: 0,0:00:38.12,0:00:40.44,Caption,,0,0,0,,И РАНЬШЕ ГОВОРИЛА ОБ УГРОЗЕ УДАРОВ ПО ПЕРЕПРАВАМ
Dialogue: 0,0:00:40.44,0:00:43.48,Caption,,0,0,0,,ЧЕРЕЗ ДНЕПР. РОССИЙСКИЙ ГЕНШТАБ ПУБЛИЧНО СООБЩАЛ ОБ
Dialogue: 0,0:00:43.56,0:00:46.20,Caption,,0,0,0,,УДАРАХ ПО СТРАТЕГИЧЕСКИМ МОСТАМ И ЖЕЛЕЗНОДОРОЖНЫМ
Dialogue: 0,0:00:46.20,0:00:49.80,Caption,,0,0,0,,УЗЛАМ, КОТОРЫЕ ИСПОЛЬЗУЮТСЯ В ИНТЕРЕСАХ ВСУ. ПОЭТОМУ
Dialogue: 0,0:00:49.80,0:00:51.88,Caption,,0,0,0,,СЕНСАЦИЯ ЗДЕСЬ НЕ В ВЫБОРЕ ЦЕЛЕЙ,
Dialogue: 0,0:00:52.12,0:00:55.56,Caption,,0,0,0,,А В ТОМ, КАК НАСТОЙЧИВО УКРАИНЦАМ ОПИСЫВАЮТ БУДУЩИЕ
Dialogue: 0,0:00:55.56,0:00:58.44,Caption,,0,0,0,,ПОСЛЕДСТВИЯ. ЕСЛИ ВАМ ИНТЕРЕСЕН РАЗБОР ТОГО,
Dialogue: 0,0:00:58.60,0:01:00.68,Caption,,0,0,0,,ЧТО СТОИТ ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ,
Dialogue: 0,0:01:00.83,0:01:03.88,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ НОВОСТЬ НАЧИНАЕТСЯ НЕ ТАМ,
Dialogue: 0,0:01:04.03,0:01:05.64,Caption,,0,0,0,,ГДЕ ПРОИЗНЕСЛИ СТРАШНЫЕ СЛОВА,
Dialogue: 0,0:01:06.01,0:01:08.36,Caption,,0,0,0,,А ТАМ, ГДЕ СТАНОВИТСЯ ПОНЯТНО,
Dialogue: 0,0:01:08.57,0:01:11.24,Caption,,0,0,0,,ДЛЯ ЧЕГО ИХ ПРОИЗНЕСЛИ ИМЕННО СЕЙЧАС.
Dialogue: 0,0:01:13.52,0:01:15.68,Caption,,0,0,0,,ПРИЧЁМ ОДНОВРЕМЕННО С РАССКАЗАМИ О ВОЗМОЖНОЙ
Dialogue: 0,0:01:15.68,0:01:18.08,Caption,,0,0,0,,КАТАСТРОФЕ В ГОРОДАХ НА УКРАИНЕ ОБСУЖДАЮТ,
Dialogue: 0,0:01:18.47,0:01:20.56,Caption,,0,0,0,,КАК НЕ ДАТЬ ЛЮДЯМ УЕХАТЬ ИЗ СТРАНЫ.
Dialogue: 0,0:01:21.52,0:01:24.72,Caption,,0,0,0,,ОФИЦЕР ВСУ АНДРЕЙ ОНИСТРАТ ПРЕДЛОЖИЛ ЗАКРЫТЬ ВЫЕЗД
Dialogue: 0,0:01:24.72,0:01:27.36,Caption,,0,0,0,,ЗА ГРАНИЦУ ДЛЯ УКРАИНЦЕВ УЖЕ С ПЯТНАДЦАТИ ЛЕТ.
Dialogue: 0,0:01:27.74,0:01:30.64,Caption,,0,0,0,,НЕ С МОМЕНТА ПОСТАНОВКИ НА ВОИНСКИЙ УЧЁТ. НЕ
Dialogue: 0,0:01:30.72,0:01:34.00,Caption,,0,0,0,,ПОСЛЕ ДОСТИЖЕНИЯ ВОЗРАСТА МОБИЛИЗАЦИИ. ЧЕЛОВЕК ЕЩЁ
Dialogue: 0,0:01:34.00,0:01:36.40,Caption,,0,0,0,,ВЫБИРАЕТ, КУДА ПОСТУПАТЬ ПОСЛЕ ШКОЛЫ,
Dialogue: 0,0:01:36.64,0:01:39.12,Caption,,0,0,0,,А ГОСУДАРСТВО УЖЕ МЫСЛЕННО СТОИТ У ДВЕРИ И
Dialogue: 0,0:01:39.12,0:01:43.04,Caption,,0,0,0,,ПРОВЕРЯЕТ, НЕ СЛИШКОМ ЛИ ДАЛЕКО ТОТ СОБРАЛСЯ. ОНИСТРАТА
Dialogue: 0,0:01:43.04,0:01:45.76,Caption,,0,0,0,,БЕСПОКОИТ, ЧТО МОЛОДЁЖЬ ПОКИДАЕТ УКРАИНУ,
Dialogue: 0,0:01:46.00,0:01:48.32,Caption,,0,0,0,,В СТАРШИХ КЛАССАХ СТАНОВИТСЯ МЕНЬШЕ МАЛЬЧИКОВ,
Dialogue: 0,0:01:48.56,0:01:51.20,Caption,,0,0,0,,А ВМЕСТЕ С НИМИ УЕЗЖАЮТ ОБРАЗОВАННЫЕ СПЕЦИАЛИСТЫ.
Dialogue: 0,0:01:51.59,0:01:54.08,Caption,,0,0,0,,ПРОБЛЕМА ДЕЙСТВИТЕЛЬНО РАССЧИТАНА НА ГОДЫ ВПЕРЁД.
Dialogue: 0,0:01:54.37,0:01:57.68,Caption,,0,0,0,,ПОДРОСТОК, КОТОРЫЙ ЗАКОНЧИТ ШКОЛУ И УНИВЕРСИТЕТ ЗА ГРАНИЦЕЙ,
Dialogue: 0,0:01:58.01,0:02:00.08,Caption,,0,0,0,,НАЙДЁТ ТАМ РАБОТУ И СОЗДАСТ СЕМЬЮ,
Dialogue: 0,0:02:00.40,0:02:03.04,Caption,,0,0,0,,ЧЕРЕЗ ДЕСЯТЬ ЛЕТ БУДЕТ ВОСПРИНИМАТЬ ПРИЗЫВ ВЕРНУТЬСЯ
Dialogue: 0,0:02:03.04,0:02:05.52,Caption,,0,0,0,,СОВСЕМ НЕ ТАК, КАК РАССЧИТЫВАЮТ В КИЕВЕ.
Dialogue: 0,0:02:06.21,0:02:09.28,Caption,,0,0,0,,ОДНАКО РАБОТАТЬ С ПРИЧИНОЙ ОТЪЕЗДА ДОЛГО И ТРУДНО.
Dialogue: 0,0:02:09.76,0:02:13.04,Caption,,0,0,0,,ГОРАЗДО УДОБНЕЕ ЗАНЯТЬСЯ ДВЕРЬЮ. ЕСЛИ ЛЮДИ УХОДЯТ,
Dialogue: 0,0:02:13.43,0:02:17.36,Caption,,0,0,0,,НАДО НЕ МЕНЯТЬ УСЛОВИЯ, А ПОВЕРНУТЬ КЛЮЧ В ЗАМКЕ. МЕТОД СТАРЫЙ,
Dialogue: 0,0:02:17.45,0:02:20.64,Caption,,0,0,0,,ПОНЯТНЫЙ И УДИВИТЕЛЬНО ЛЮБИМЫЙ НАЧАЛЬСТВОМ КОГДА В
Dialogue: 0,0:02:20.64,0:02:25.60,Caption,,0,0,0,,КОМНАТЕ СТАНОВИТСЯ НЕУЮТНО, ПЕРВЫМ ДЕЛОМ ЗАПРЕЩАЮТ ВЫХОДИТЬ В КОРИДОР. СОСЕДСТВО
Dialogue: 0,0:02:25.60,0:02:27.84,Caption,,0,0,0,,ДВУХ ЗАЯВЛЕНИЙ ПОЛУЧАЕТСЯ ВЫРАЗИТЕЛЬНЫМ.
Dialogue: 0,0:02:30.04,0:02:32.76,Caption,,0,0,0,,В ОДНОМ УКРАИНЦАМ СООБЩАЮТ, ЧТО КИЕВ,
Dialogue: 0,0:02:32.88,0:02:36.12,Caption,,0,0,0,,ХАРЬКОВ И ОДЕССА МОГУТ СТОЛКНУТЬСЯ С КРИТИЧЕСКИМИ
Dialogue: 0,0:02:36.12,0:02:39.48,Caption,,0,0,0,,УСЛОВИЯМИ. В ДРУГОМ ПРЕДЛАГАЮТ ЗАРАНЕЕ УДЕРЖИВАТЬ
Dialogue: 0,0:02:39.48,0:02:43.16,Caption,,0,0,0,,ВНУТРИ СТРАНЫ ДАЖЕ ПЯТНАДЦАТИЛЕТНИХ. БУДУЩЕЕ ОБЕЩАЮТ
Dialogue: 0,0:02:43.16,0:02:46.92,Caption,,0,0,0,,СУРОВОЕ, ЗАТО ПУТЬ К ДРУГОМУ БУДУЩЕМУ ХОТЯТ ПРИКРЫТЬ ЗАРАНЕЕ.
Dialogue: 0,0:02:47.58,0:02:49.48,Caption,,0,0,0,,ЕСТЬ И ЕЩЁ ОДНА КАТЕГОРИЯ ЛЮДЕЙ,
Dialogue: 0,0:02:49.72,0:02:52.36,Caption,,0,0,0,,КОТОРУЮ КИЕВ ХОТЕЛ БЫ ВЕРНУТЬ. НАРОДНЫЙ ДЕПУТАТ
Dialogue: 0,0:02:52.44,0:02:54.68,Caption,,0,0,0,,СЕРГЕЙ КОЗЫРЬ ПРЕДЛОЖИЛ ДАВАТЬ МУЖЧИНАМ,
Dialogue: 0,0:02:54.83,0:02:58.44,Caption,,0,0,0,,ПРИЕЗЖАЮЩИМ С ТЕРРИТОРИЙ, НЕ ПОДКОНТРОЛЬНЫХ УКРАИНСКОЙ ВЛАСТИ,
Dialogue: 0,0:02:58.66,0:03:01.16,Caption,,0,0,0,,ДЕВЯНОСТО ДНЕЙ ОТСРОЧКИ ОТ МОБИЛИЗАЦИИ.
Dialogue: 0,0:03:01.71,0:03:04.36,Caption,,0,0,0,,ЗА ЭТИ ТРИ МЕСЯЦА ЧЕЛОВЕК ДОЛЖЕН ОБУСТРОИТЬСЯ,
Dialogue: 0,0:03:04.50,0:03:08.20,Caption,,0,0,0,,НАЙТИ РАБОТУ И ПОЛУЧИТЬ БРОНИРОВАНИЕ. ЕСЛИ НЕ УСПЕЛ,
Dialogue: 0,0:03:08.44,0:03:11.32,Caption,,0,0,0,,ЛЬГОТНОЕ ЗНАКОМСТВО С НОВОЙ ЖИЗНЬЮ ЗАКАНЧИВАЕТСЯ.
Dialogue: 0,0:03:11.61,0:03:13.72,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ЗВУЧИТ КАК РЕКЛАМА КУРОРТА,
Dialogue: 0,0:03:13.88,0:03:16.60,Caption,,0,0,0,,ГДЕ ПЕРВЫЕ ДЕВЯНОСТО ДНЕЙ ПРОЖИВАНИЕ БЕСПЛАТНО,
Dialogue: 0,0:03:16.84,0:03:19.80,Caption,,0,0,0,,А СТОИМОСТЬ ОСТАВШЕГОСЯ СЕЗОНА СООБЩАЮТ УЖЕ ПОСЛЕ
Dialogue: 0,0:03:19.80,0:03:23.40,Caption,,0,0,0,,ЗАСЕЛЕНИЯ. РАСЧЁТ ПОНЯТЕН. МНОГИЕ МУЖЧИНЫ БОЯТСЯ
Dialogue: 0,0:03:23.40,0:03:27.00,Caption,,0,0,0,,ВОЗВРАЩАТЬСЯ ИМЕННО ИЗ ЗА МОБИЛИЗАЦИИ. ИМ ПРЕДЛАГАЮТ
Dialogue: 0,0:03:27.00,0:03:31.80,Caption,,0,0,0,,КОРОТКИЙ ПЕРИОД БЕЗОПАСНОСТИ, ЧТОБЫ ОНИ ПЕРЕСЕКЛИ ГРАНИЦУ В НУЖНУЮ СТОРОНУ И
Dialogue: 0,0:03:31.88,0:03:34.52,Caption,,0,0,0,,УСПЕЛИ ЗАКРЕПИТЬСЯ. ТОЛЬКО ТРИ МЕСЯЦА НЕ ОЧЕНЬ
Dialogue: 0,0:03:34.52,0:03:38.76,Caption,,0,0,0,,ПОХОЖИ НА ГАРАНТИЮ, РАДИ КОТОРОЙ ЧЕЛОВЕК БРОСИТ УСТРОЕННУЮ ЖИЗНЬ И
Dialogue: 0,0:03:38.84,0:03:41.96,Caption,,0,0,0,,ПОБЕЖИТ ПОКУПАТЬ БИЛЕТ ДО КИЕВА. ПОСЛЕ ТАКОЙ НОВОСТИ
Dialogue: 0,0:03:41.96,0:03:44.60,Caption,,0,0,0,,ДАВКИ У ЕВРОПЕЙСКИХ КАСС, СКОРЕЕ ВСЕГО,
Dialogue: 0,0:03:44.68,0:03:50.55,Caption,,0,0,0,,НЕ СЛУЧИТСЯ. ДЕВЯНОСТО ДНЕЙ ВЫГЛЯДЯТ ЩЕДРО ЛИШЬ ДО ТОЙ МИНУТЫ,
Dialogue: 0,0:03:50.76,0:03:53.43,Caption,,0,0,0,,ПОКА НЕ НАЧИНАЕШЬ СЧИТАТЬ ИХ НЕДЕЛЯМИ. ЛЕТО
Dialogue: 0,0:03:53.51,0:03:56.87,Caption,,0,0,0,,ПРОЛЕТАЕТ БЫСТРО, ОСОБЕННО КОГДА В КОНЦЕ АВГУСТА ГОСУДАРСТВО УЖЕ
Dialogue: 0,0:03:56.87,0:03:58.95,Caption,,0,0,0,,ПОГЛЯДЫВАЕТ НА КАЛЕНДАРЬ ВМЕСТЕ С ТОБОЙ.
Dialogue: 0,0:03:59.60,0:04:02.23,Caption,,0,0,0,,ВНУТРИ СТРАНЫ ЛЮДЕЙ ПЫТАЮТСЯ ЗАМАНИТЬ ОТСРОЧКОЙ,
Dialogue: 0,0:04:02.39,0:04:04.87,Caption,,0,0,0,,А НАХОДЯЩИХСЯ В ЕВРОПЕ МОГУТ НАЧАТЬ ПОДТАЛКИВАТЬ
Dialogue: 0,0:04:04.87,0:04:08.15,Caption,,0,0,0,,СОВСЕМ ДРУГИМИ СРЕДСТВАМИ. РОССИЙСКАЯ СВР ЗАЯВИЛА,
Dialogue: 0,0:04:08.39,0:04:10.87,Caption,,0,0,0,,ЧТО В ЕВРОПЕЙСКОМ СОЮЗЕ ОБСУЖДАЮТ МЕРЫ ДЛЯ
Dialogue: 0,0:04:10.87,0:04:13.51,Caption,,0,0,0,,ВОЗВРАЩЕНИЯ УКРАИНСКИХ МУЖЧИН ДОМОЙ. РЕЧЬ,
Dialogue: 0,0:04:13.67,0:04:17.83,Caption,,0,0,0,,ПО ЕЁ ДАННЫМ, ИДЁТ БОЛЕЕ ЧЕМ О МИЛЛИОНЕ ЧЕЛОВЕК. СРЕДИ ВОЗМОЖНЫХ
Dialogue: 0,0:04:17.91,0:04:20.63,Caption,,0,0,0,,СПОСОБОВ ДАВЛЕНИЯ НАЗВАНЫ ТРУДНОСТИ С УСТРОЙСТВОМ НА
Dialogue: 0,0:04:20.71,0:04:24.39,Caption,,0,0,0,,РАБОТУ И АРЕНДОЙ ЖИЛЬЯ. ГОТОВОГО РЕШЕНИЯ ЕВРОСОЮЗА В
Dialogue: 0,0:04:24.39,0:04:28.95,Caption,,0,0,0,,ЭТИХ МАТЕРИАЛАХ НЕТ, НО МЕХАНИЗМ ВЫГЛЯДИТ ВПОЛНЕ УЗНАВАЕМО. СНАЧАЛА
Dialogue: 0,0:04:29.03,0:04:33.27,Caption,,0,0,0,,ЧЕЛОВЕКУ ОБЪЯСНЯЮТ, ЧТО ВЕРНУТЬСЯ БЫЛО БЫ ПРАВИЛЬНО. ЗАТЕМ ПРИВЫЧНАЯ
Dialogue: 0,0:04:33.35,0:04:36.63,Caption,,0,0,0,,ЖИЗНЬ ВНЕЗАПНО СТАНОВИТСЯ ДОРОЖЕ И СЛОЖНЕЕ. ПОСЛЕ
Dialogue: 0,0:04:36.63,0:04:39.03,Caption,,0,0,0,,ЭТОГО ДОБРОВОЛЬНОСТЬ НАЧИНАЕТ НАПОМИНАТЬ ДВЕРЬ,
Dialogue: 0,0:04:39.28,0:04:41.83,Caption,,0,0,0,,КОТОРУЮ ВЕЖЛИВО ОТКРЫЛИ ТОЛЬКО В ОДНУ СТОРОНУ.
Dialogue: 0,0:04:42.31,0:04:44.55,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ГОСУДАРСТВА МОГУТ СКОЛЬКО УГОДНО
Dialogue: 0,0:04:44.55,0:04:48.79,Caption,,0,0,0,,ВЫДЕЛЯТЬ СРЕДСТВА, ПЕРЕДАВАТЬ ВООРУЖЕНИЕ И ЗАКАЗЫВАТЬ БОЕПРИПАСЫ. С
Dialogue: 0,0:04:48.79,0:04:51.59,Caption,,0,0,0,,ЧЕЛОВЕКОМ ТАКОЙ НОМЕР НЕ ПРОХОДИТ. ЕГО НЕЛЬЗЯ
Dialogue: 0,0:04:51.59,0:04:54.39,Caption,,0,0,0,,ВЫПУСТИТЬ ДОПОЛНИТЕЛЬНОЙ ПАРТИЕЙ НА ЗАВОДЕ И
Dialogue: 0,0:04:54.39,0:04:57.03,Caption,,0,0,0,,ДОСТАВИТЬ ЖЕЛЕЗНОДОРОЖНЫМ СОСТАВОМ К НУЖНОЙ ДАТЕ.
Dialogue: 0,0:04:59.30,0:05:01.70,Caption,,0,0,0,,ЕСЛИ ЕВРОПА НАМЕРЕНА И ДАЛЬШЕ ПОДДЕРЖИВАТЬ
Dialogue: 0,0:05:01.70,0:05:03.70,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ БОЕВЫХ ДЕЙСТВИЙ УКРАИНОЙ,
Dialogue: 0,0:05:04.02,0:05:07.06,Caption,,0,0,0,,ВОПРОС ПОПОЛНЕНИЯ УКРАИНСКИХ СИЛ НИКУДА НЕ ДЕНЕТСЯ.
Dialogue: 0,0:05:07.50,0:05:10.10,Caption,,0,0,0,,МУЖЧИНЫ, УЖЕ ЖИВУЩИЕ В ЕВРОПЕЙСКИХ СТРАНАХ,
Dialogue: 0,0:05:10.42,0:05:13.54,Caption,,0,0,0,,СТАНОВЯТСЯ САМЫМ ЗАМЕТНЫМ РЕЗЕРВОМ. ОНИ РЯДОМ,
Dialogue: 0,0:05:13.86,0:05:16.34,Caption,,0,0,0,,ИХ МЕСТОНАХОЖДЕНИЕ ИЗВЕСТНО, А ГЛАВНОЕ,
Dialogue: 0,0:05:16.58,0:05:21.86,Caption,,0,0,0,,ИХ МОЖНО ПОПЫТАТЬСЯ УБЕДИТЬ, ПРИЖАТЬ УСЛОВИЯМИ ИЛИ ЛИШИТЬ ВЫБОРА. ПОНАЧАЛУ БУДУТ
Dialogue: 0,0:05:21.94,0:05:24.50,Caption,,0,0,0,,ЗВАТЬ ДОБРОВОЛЬНО. ЗАТЕМ ДАВЛЕНИЕ УСИЛИТСЯ.
Dialogue: 0,0:05:24.79,0:05:26.98,Caption,,0,0,0,,СЛЕДУЮЩИМ ШАГОМ, ПО МОЕМУ ПРОГНОЗУ,
Dialogue: 0,0:05:27.21,0:05:30.42,Caption,,0,0,0,,СПОСОБНО СТАТЬ ПРИНУДИТЕЛЬНОЕ ВЫДВОРЕНИЕ. НЕ ЗАХОТЕЛ
Dialogue: 0,0:05:30.42,0:05:34.82,Caption,,0,0,0,,ОТПРАВЛЯТЬСЯ САМ, ДОРОГУ ДОМОЙ ОРГАНИЗУЮТ БЕЗ ЛИШНЕГО ОБСУЖДЕНИЯ ТВОИХ
Dialogue: 0,0:05:34.90,0:05:37.70,Caption,,0,0,0,,ПЛАНОВ. ЕВРОПЕЙСКОЕ ГОСТЕПРИИМСТВО ТОГДА ПОЛУЧИТ
Dialogue: 0,0:05:37.70,0:05:41.70,Caption,,0,0,0,,ПРЕВОСХОДНЫЙ ФИНАЛ. СПАСИБО, ЧТО ПРИЕХАЛИ. СПАСИБО,
Dialogue: 0,0:05:41.86,0:05:44.34,Caption,,0,0,0,,ЧТО ПЛАТИЛИ ЗА ЖИЛЬЁ И РАБОТАЛИ. ТЕПЕРЬ ВАШ
Dialogue: 0,0:05:44.42,0:05:48.50,Caption,,0,0,0,,ВИЗИТ ОКОНЧЕН, ПОТОМУ ЧТО КИЕВУ ПОНАДОБИЛИСЬ ЛЮДИ. ЧЕМОДАН МОЖЕТЕ
Dialogue: 0,0:05:48.58,0:05:52.42,Caption,,0,0,0,,СОБРАТЬ САМОСТОЯТЕЛЬНО, ПОКА ЭТА УСЛУГА ЕЩЁ НЕ ВКЛЮЧЕНА В ГОСУДАРСТВЕННЫЙ
Dialogue: 0,0:05:52.42,0:05:55.70,Caption,,0,0,0,,ПАКЕТ. ТАК СКЛАДЫВАЮТСЯ СРАЗУ ТРИ СПОСОБА ОБРАЩЕНИЯ
Dialogue: 0,0:05:55.70,0:05:58.34,Caption,,0,0,0,,С ЧЕЛОВЕЧЕСКИМ РЕСУРСОМ. ПОДРОСТКА ХОТЯТ НЕ
Dialogue: 0,0:05:58.34,0:06:01.38,Caption,,0,0,0,,ВЫПУСТИТЬ. УЕХАВШЕГО МУЖЧИНУ СОБИРАЮТСЯ ВЕРНУТЬ.
Dialogue: 0,0:06:01.70,0:06:03.94,Caption,,0,0,0,,ВЕРНУВШЕМУСЯ ОБЕЩАЮТ ДЕВЯНОСТО ДНЕЙ,
Dialogue: 0,0:06:04.10,0:06:06.58,Caption,,0,0,0,,ЧТОБЫ ОН УСПЕЛ НАЙТИ СПАСИТЕЛЬНОЕ БРОНИРОВАНИЕ.
Dialogue: 0,0:06:06.87,0:06:11.54,Caption,,0,0,0,,ВЫБОР ВРОДЕ БЫ СУЩЕСТВУЕТ, НО ПОЧЕМУ ТО КАЖДЫЙ МАРШРУТ ВЕДЁТ ТУДА,
Dialogue: 0,0:06:11.68,0:06:17.74,Caption,,0,0,0,,КУДА ТРЕБУЕТСЯ ГОСУДАРСТВУ. НА ЭТОМ ФОНЕ УКРАИНЦЕВ ГОТОВЯТ НЕ ТОЛЬКО К
Dialogue: 0,0:06:17.74,0:06:20.70,Caption,,0,0,0,,ПРОБЛЕМАМ С МОСТАМИ. СРЕДСТВА МАССОВОЙ ИНФОРМАЦИИ СО
Dialogue: 0,0:06:20.70,0:06:23.90,Caption,,0,0,0,,ССЫЛКОЙ НА ИСТОЧНИК В ВОЕННОЙ РАЗВЕДКЕ НАЗЫВАЮТ ЕЩЁ
Dialogue: 0,0:06:23.90,0:06:26.78,Caption,,0,0,0,,ОДНО ВОЗМОЖНОЕ НАПРАВЛЕНИЕ РОССИЙСКИХ УДАРОВ ПИЩЕВУЮ
Dialogue: 0,0:06:26.78,0:06:29.90,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬ. УКРАИНСКАЯ ВЕРСИЯ ПРЕДПОЛАГАЕМОГО
Dialogue: 0,0:06:29.90,0:06:32.06,Caption,,0,0,0,,ЗАМЫСЛА ВКЛЮЧАЕТ УЩЕРБ ПРОДОВОЛЬСТВЕННОЙ
Dialogue: 0,0:06:32.06,0:06:36.38,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ЭКОНОМИКЕ И ВАЛЮТНЫМ ПОСТУПЛЕНИЯМ. ДОПОЛНИТЕЛЬНО
Dialogue: 0,0:06:36.38,0:06:38.94,Caption,,0,0,0,,УПОМИНАЕТСЯ КОНКУРЕНЦИЯ РОССИИ С УКРАИНСКИМ
Dialogue: 0,0:06:38.94,0:06:41.66,Caption,,0,0,0,,СЕЛЬСКОХОЗЯЙСТВЕННЫМ ЭКСПОРТОМ НА РЫНКАХ АФРИКИ,
Dialogue: 0,0:06:41.90,0:06:47.42,Caption,,0,0,0,,АЗИИ И БЛИЖНЕГО ВОСТОКА. КАРТИНА ПОЛУЧАЕТСЯ ШИРЕ ОБЫЧНОГО РАЗГОВОРА О ВОЕННЫХ
Dialogue: 0,0:06:47.42,0:06:50.30,Caption,,0,0,0,,ОБЪЕКТАХ. ДАВЛЕНИЕ МОЖЕТ ЗАТРОНУТЬ ТРАНСПОРТ,
Dialogue: 0,0:06:50.45,0:06:54.46,Caption,,0,0,0,,ЭНЕРГЕТИКУ, ПРОИЗВОДСТВО И ПРОДОВОЛЬСТВИЕ. ЭТО УЖЕ ОПИСАНИЕ
Dialogue: 0,0:06:54.46,0:06:58.14,Caption,,0,0,0,,СТРАНЫ, ГДЕ СБОЙ В ОДНОМ МЕСТЕ БЫСТРО ПЕРЕДАЁТСЯ ДАЛЬШЕ
Dialogue: 0,0:06:58.14,0:07:00.94,Caption,,0,0,0,,ОСТАНОВИЛАСЬ ПЕРЕПРАВА, НАРУШИЛАСЬ ДОСТАВКА,
Dialogue: 0,0:07:01.16,0:07:02.94,Caption,,0,0,0,,ПРЕДПРИЯТИЕ НЕ ПОЛУЧИЛО СЫРЬЁ,
Dialogue: 0,0:07:03.26,0:07:06.38,Caption,,0,0,0,,ГОРОД СТОЛКНУЛСЯ С ДЕФИЦИТОМ ПРИВЫЧНЫХ ВЕЩЕЙ. НО
Dialogue: 0,0:07:06.38,0:07:10.30,Caption,,0,0,0,,ГЛАВНОЕ ЗДЕСЬ ДАЖЕ НЕ ДЛИНА ПЕРЕЧНЯ. СТРАШНЫЙ СПИСОК
Dialogue: 0,0:07:10.30,0:07:12.22,Caption,,0,0,0,,СПОСОБЕН СОСТАВИТЬ ЛЮБОЙ ЧЕЛОВЕК,
Dialogue: 0,0:07:12.53,0:07:15.50,Caption,,0,0,0,,У КОТОРОГО ЕСТЬ БЛОКНОТ И СВОБОДНЫЙ ВЕЧЕР. НАМНОГО
Dialogue: 0,0:07:15.50,0:07:17.90,Caption,,0,0,0,,ПОКАЗАТЕЛЬНЕЕ СМЕНА ИНТОНАЦИИ В УКРАИНСКОМ
Dialogue: 0,0:07:17.90,0:07:21.18,Caption,,0,0,0,,ИНФОРМАЦИОННОМ ПОЛЕ. РАНЬШЕ АУДИТОРИИ ЧАЩЕ ОБЕЩАЛИ,
Dialogue: 0,0:07:21.40,0:07:24.46,Caption,,0,0,0,,ЧТО СТРАНА ВЫДЕРЖИТ И СПРАВИТСЯ. ТЕПЕРЬ ВСЁ ЗАМЕТНЕЕ
Dialogue: 0,0:07:24.46,0:07:26.86,Caption,,0,0,0,,ДРУГОЙ МОТИВ ВПЕРЕДИ БУДЕТ КРАЙНЕ ТЯЖЕЛО,
Dialogue: 0,0:07:27.10,0:07:33.14,Caption,,0,0,0,,ЗАТО ВАС ЗАРАНЕЕ ИЗВЕСТИЛИ. ПРЕДУПРЕЖДЕНИЙ НАКОПИЛОСЬ СТОЛЬКО,
Dialogue: 0,0:07:33.38,0:07:36.02,Caption,,0,0,0,,ЧТО СКОРО ИХ ПРИДЁТСЯ ВЫДАВАТЬ ПО РАСПИСАНИЮ ВМЕСТЕ
Dialogue: 0,0:07:36.10,0:07:39.06,Caption,,0,0,0,,С ПРОГНОЗОМ ПОГОДЫ. СЕГОДНЯ ОБСУЖДАЮТ ПЕРЕПРАВЫ.
Dialogue: 0,0:07:39.36,0:07:42.34,Caption,,0,0,0,,ЗАВТРА ГОВОРЯТ ОБ ЭЛЕКТРИЧЕСТВЕ. СЛЕДОМ ПОЯВЛЯЮТСЯ
Dialogue: 0,0:07:42.34,0:07:45.78,Caption,,0,0,0,,КРУПНЫЕ ГОРОДА И ПРОДУКТОВЫЕ ПРЕДПРИЯТИЯ. К КОНЦУ
Dialogue: 0,0:07:45.86,0:07:48.74,Caption,,0,0,0,,НЕДЕЛИ ГРАЖДАНИН УЖЕ ЗНАЕТ ОБО ВСЕХ ВОЗМОЖНЫХ БЕДАХ,
Dialogue: 0,0:07:49.11,0:07:51.54,Caption,,0,0,0,,КРОМЕ ОДНОЙ ДЕТАЛИ КТО И КАК СОБИРАЕТСЯ ИХ
Dialogue: 0,0:07:51.54,0:07:54.50,Caption,,0,0,0,,ПРЕДОТВРАЩАТЬ. ТАКАЯ ОСВЕДОМЛЁННОСТЬ ЧРЕЗВЫЧАЙНО
Dialogue: 0,0:07:54.50,0:07:57.70,Caption,,0,0,0,,УДОБНА ПОСЛЕ ЛЮБОГО ПРОВАЛА. МОЖНО ВЫЙТИ К ЛЮДЯМ,
Dialogue: 0,0:07:57.94,0:08:00.02,Caption,,0,0,0,,СДЕЛАТЬ СЕРЬЁЗНОЕ ЛИЦО И НАПОМНИТЬ,
Dialogue: 0,0:08:00.18,0:08:03.54,Caption,,0,0,0,,ЧТО ОПАСНОСТЬ БЫЛА НАЗВАНА ЗАРАНЕЕ. МЫ СООБЩИЛИ,
Dialogue: 0,0:08:03.71,0:08:07.62,Caption,,0,0,0,,МЫ ОБЪЯСНИЛИ, МЫ НИЧЕГО НЕ СКРЫВАЛИ. ПОЛУЧАЕТСЯ ПОЧТИ ПОБЕДА,
Dialogue: 0,0:08:07.78,0:08:11.86,Caption,,0,0,0,,ТОЛЬКО БЕЗ СВЕТА, ТРАНСПОРТА И РАБОТАЮЩЕГО ПРЕДПРИЯТИЯ. НАРОДНЫЙ
Dialogue: 0,0:08:11.86,0:08:14.10,Caption,,0,0,0,,ДЕПУТАТ ВЛАДИМИР КРЕЙДЕНКО ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:08:14.42,0:08:17.14,Caption,,0,0,0,,ЧТО ПРИ ТЯЖЁЛОМ РАЗВИТИИ СОБЫТИЙ КИЕВ МОЖЕТ
Dialogue: 0,0:08:17.14,0:08:19.22,Caption,,0,0,0,,СТОЛКНУТЬСЯ С ПРОБЛЕМАМИ ЭЛЕКТРИЧЕСТВА,
Dialogue: 0,0:08:19.37,0:08:22.42,Caption,,0,0,0,,МЕТРО И МОСТОВ. СТОЛИЦА РИСКУЕТ ОКАЗАТЬСЯ
Dialogue: 0,0:08:22.42,0:08:27.14,Caption,,0,0,0,,РАЗДЕЛЁННОЙ НА ЧАСТИ. ЖИТЕЛЮ КИЕВА ОТ ПОЛНОТЫ ЭТОГО ПРОГНОЗА ЛЕГЧЕ НЕ
Dialogue: 0,0:08:27.14,0:08:29.70,Caption,,0,0,0,,СТАНЕТ. ЕМУ ТРЕБУЕТСЯ РАБОТАЮЩАЯ СЕТЬ,
Dialogue: 0,0:08:29.94,0:08:33.86,Caption,,0,0,0,,ВОДА В КРАНЕ, ОТОПЛЕНИЕ В КВАРТИРЕ И ВОЗМОЖНОСТЬ ДОБРАТЬСЯ ДО
Dialogue: 0,0:08:33.86,0:08:36.90,Caption,,0,0,0,,ДРУГОГО БЕРЕГА. ДОКЛАД О НАМЕРЕНИЯХ ПРОТИВНИКА НЕ
Dialogue: 0,0:08:36.90,0:08:40.26,Caption,,0,0,0,,ЗАПУСТИТ МЕТРО И НЕ ЗАМЕНИТ ПОВРЕЖДЁННУЮ ПОДСТАНЦИЮ.
Dialogue: 0,0:08:40.60,0:08:43.30,Caption,,0,0,0,,ПОЭТОМУ ПОСЛЕ СЛОВ "НАМ ВСЁ ИЗВЕСТНО" ДОЛЖЕН ЗВУЧАТЬ
Dialogue: 0,0:08:43.30,0:08:45.62,Caption,,0,0,0,,ОТВЕТ НА ПРОСТОЙ ВОПРОС ЧТО СДЕЛАНО?
Dialogue: 0,0:08:47.90,0:08:50.62,Caption,,0,0,0,,И ТУТ РАССКАЗ ОБЫЧНО РЕЗКО ХУДЕЕТ. ПРО НАМЕРЕНИЯ
Dialogue: 0,0:08:50.62,0:08:55.02,Caption,,0,0,0,,ПРОТИВНИКА ГОВОРЯТ ЧАСАМИ, А СОБСТВЕННЫЕ ВОЗМОЖНОСТИ УМЕЩАЮТСЯ МЕЖДУ ДВУМЯ
Dialogue: 0,0:08:55.02,0:08:58.14,Caption,,0,0,0,,РЕКЛАМНЫМИ ПАУЗАМИ. ТУТ НЕ НУЖНА ДОЛГАЯ ЛЕКЦИЯ ЧЕРЕЗ
Dialogue: 0,0:08:58.14,0:09:00.30,Caption,,0,0,0,,ПЕРЕПРАВЫ ИДУТ ТЕХНИКА, ВОЙСКА,
Dialogue: 0,0:09:00.46,0:09:02.78,Caption,,0,0,0,,ТОПЛИВО И ГРУЗЫ. БЬЮТ ПО МОСТУ,
Dialogue: 0,0:09:03.01,0:09:06.14,Caption,,0,0,0,,ЗНАЧИТ РЕЖУТ СНАБЖЕНИЕ. ФОРМУЛА ВОЙНЫ СТАРАЯ
Dialogue: 0,0:09:06.14,0:09:08.94,Caption,,0,0,0,,ПЕРЕРЕЗАТЬ ПУТИ ПОДВОЗА ПРИДУМАЛИ ЗАДОЛГО ДО РАКЕТ.
Dialogue: 0,0:09:09.22,0:09:11.74,Caption,,0,0,0,,НО ЯРОСЛАВСКИЙ ГОВОРИТ НЕ ТОЛЬКО О МОСТАХ. ОН
Dialogue: 0,0:09:11.74,0:09:14.22,Caption,,0,0,0,,НАЗЫВАЕТ КИЕВ, ХАРЬКОВ И ОДЕССУ,
Dialogue: 0,0:09:14.54,0:09:17.74,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ О ВОЗМОЖНЫХ ТЯЖЁЛЫХ УСЛОВИЯХ ЗИМОЙ И
Dialogue: 0,0:09:17.74,0:09:21.26,Caption,,0,0,0,,ПРЕДЛАГАЕТ ДОГОВАРИВАТЬСЯ О ПРЕКРАЩЕНИИ ОГНЯ. ИМЕННО
Dialogue: 0,0:09:21.34,0:09:26.14,Caption,,0,0,0,,О ПРЕКРАЩЕНИИ ОГНЯ, А НЕ О ПОЛНОМ УРЕГУЛИРОВАНИИ ВСЕХ ВОПРОСОВ. СМЫСЛ
Dialogue: 0,0:09:26.14,0:09:28.62,Caption,,0,0,0,,ПОНЯТЕН ОСТАНОВИТЬ ПРОИСХОДЯЩЕЕ СЕЙЧАС,
Dialogue: 0,0:09:28.94,0:09:31.82,Caption,,0,0,0,,А РАЗБИРАТЬСЯ С ОСТАЛЬНЫМ ПОЗДНЕЕ. КОГДА ДОМ УЖЕ
Dialogue: 0,0:09:31.82,0:09:35.50,Caption,,0,0,0,,ТРЕЩИТ, СПОР О ЦВЕТЕ БУДУЩИХ ОБОЕВ ДЕЙСТВИТЕЛЬНО МОЖНО
Dialogue: 0,0:09:35.50,0:09:38.54,Caption,,0,0,0,,ОТЛОЖИТЬ. ПОДОБНЫЕ ЗАЯВЛЕНИЯ РЕШАЮТ СРАЗУ НЕСКОЛЬКО
Dialogue: 0,0:09:38.62,0:09:41.26,Caption,,0,0,0,,ЗАДАЧ. НАСЕЛЕНИЮ ПОКАЗЫВАЮТ МАСШТАБ УГРОЗЫ.
Dialogue: 0,0:09:41.65,0:09:44.54,Caption,,0,0,0,,ОДНОВРЕМЕННО ВЛАСТИ ПОЛУЧАЮТ ЗАГОТОВКУ ДЛЯ ОТВЕТА,
Dialogue: 0,0:09:44.86,0:09:47.82,Caption,,0,0,0,,ЕСЛИ СОБЫТИЯ ПОЙДУТ ПО ХУДШЕМУ СЦЕНАРИЮ. ПОСЛЕ УДАРА
Dialogue: 0,0:09:47.90,0:09:52.54,Caption,,0,0,0,,МОЖНО БУДЕТ НАПОМНИТЬ, ЧТО О НЁМ ПРЕДУПРЕЖДАЛИ. ТОЛЬКО ФРАЗА "МЫ ЗНАЛИ,
Dialogue: 0,0:09:52.62,0:09:55.66,Caption,,0,0,0,,КУДА МОГУТ УДАРИТЬ" ПОСЛЕ РАЗРУШЕНИЯ ОБЪЕКТА ЗВУЧИТ
Dialogue: 0,0:09:55.74,0:09:58.38,Caption,,0,0,0,,НЕ КАК ОТЧЁТ ОБ УСПЕШНОЙ ЗАЩИТЕ. СКОРЕЕ ЭТО
Dialogue: 0,0:09:58.38,0:10:02.22,Caption,,0,0,0,,ПРИЗНАНИЕ, КОТОРОЕ ПО ОШИБКЕ ПРОИЗНЕСЛИ ТОРЖЕСТВЕННЫМ ГОЛОСОМ.
Dialogue: 0,0:10:04.49,0:10:06.89,Caption,,0,0,0,,ОСОБЕННО СТРАННО ВСЁ ВЫГЛЯДИТ РЯДОМ С БОРЬБОЙ ЗА
Dialogue: 0,0:10:06.89,0:10:10.17,Caption,,0,0,0,,ЛЮДЕЙ. НАСЕЛЕНИЮ КРУПНЫХ ГОРОДОВ ОПИСЫВАЮТ ТЯЖЁЛУЮ
Dialogue: 0,0:10:10.17,0:10:14.65,Caption,,0,0,0,,ЗИМУ, ПЕРЕБОИ И РАЗРУШЕНИЕ ПРИВЫЧНОЙ ГОРОДСКОЙ ЖИЗНИ. В ТУ
Dialogue: 0,0:10:14.73,0:10:16.97,Caption,,0,0,0,,ЖЕ МИНУТУ ПОДРОСТКАМ ПРЕДЛАГАЮТ ЗАКРЫТЬ ВЫЕЗД,
Dialogue: 0,0:10:17.30,0:10:19.61,Caption,,0,0,0,,МУЖЧИН ИЗ ЕВРОПЫ ОБСУЖДАЮТ КАК РЕЗЕРВ,
Dialogue: 0,0:10:19.93,0:10:22.33,Caption,,0,0,0,,А ВЕРНУВШИМСЯ ОБЕЩАЮТ КОРОТКУЮ ПЕРЕДЫШКУ ПЕРЕД
Dialogue: 0,0:10:22.33,0:10:25.37,Caption,,0,0,0,,ВОЗМОЖНОЙ МОБИЛИЗАЦИЕЙ. ГОСУДАРСТВУ ТРЕБУЮТСЯ БОЙЦЫ
Dialogue: 0,0:10:25.45,0:10:27.93,Caption,,0,0,0,,ДЛЯ АРМИИ, СПЕЦИАЛИСТЫ ДЛЯ ПРЕДПРИЯТИЙ,
Dialogue: 0,0:10:28.12,0:10:31.29,Caption,,0,0,0,,РАБОТНИКИ ДЛЯ ЭКОНОМИКИ И БУДУЩИЕ НАЛОГОПЛАТЕЛЬЩИКИ.
Dialogue: 0,0:10:31.66,0:10:33.93,Caption,,0,0,0,,У КАЖДОГО ИЗ НИХ СВОЯ ПРИЧИНА НЕ СПЕШИТЬ
Dialogue: 0,0:10:33.93,0:10:37.21,Caption,,0,0,0,,НАВСТРЕЧУ ЭТОЙ ПОТРЕБНОСТИ. ОДИН БОИТСЯ МОБИЛИЗАЦИИ,
Dialogue: 0,0:10:37.45,0:10:39.45,Caption,,0,0,0,,ДРУГОЙ НЕ ВИДИТ БУДУЩЕГО ДЛЯ РЕБЁНКА,
Dialogue: 0,0:10:39.74,0:10:41.69,Caption,,0,0,0,,ТРЕТИЙ УЖЕ УСТРОИЛСЯ В ДРУГОЙ СТРАНЕ,
Dialogue: 0,0:10:41.93,0:10:44.57,Caption,,0,0,0,,ЧЕТВЁРТЫЙ УСЛЫШАЛ ПРОГНОЗ НА ЗИМУ И СДЕЛАЛ ВПОЛНЕ
Dialogue: 0,0:10:44.57,0:10:47.45,Caption,,0,0,0,,ПРАКТИЧЕСКИЙ ВЫВОД. ЗАПРЕТ СПОСОБЕН ЗАДЕРЖАТЬ
Dialogue: 0,0:10:47.53,0:10:50.65,Caption,,0,0,0,,ЧЕЛОВЕКА ФИЗИЧЕСКИ. УБЕДИТЬ ЕГО СВЯЗАТЬ СО СТРАНОЙ
Dialogue: 0,0:10:50.65,0:10:53.85,Caption,,0,0,0,,СЛЕДУЮЩИЕ ДЕСЯТЬ ЛЕТ ТАКОЙ МЕТОД НЕ СПОСОБЕН. ТЕЛО
Dialogue: 0,0:10:53.85,0:10:56.49,Caption,,0,0,0,,ОСТАНЕТСЯ ЗА ЗАКРЫТОЙ ДВЕРЬЮ, А ПЛАНЫ,
Dialogue: 0,0:10:56.65,0:10:59.69,Caption,,0,0,0,,ДОВЕРИЕ И ЖЕЛАНИЕ СТРОИТЬ ЗДЕСЬ ЖИЗНЬ УЙДУТ БЕЗ
Dialogue: 0,0:10:59.69,0:11:02.89,Caption,,0,0,0,,ВСЯКОГО РАЗРЕШЕНИЯ ПОГРАНИЧНИКА. ПОДПИСЫВАЙТЕСЬ И
Dialogue: 0,0:11:02.97,0:11:07.05,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, СРАБОТАЕТ ЛИ ОБЕЩАНИЕ ДЕВЯНОСТА ДНЕЙ ДЛЯ ТЕХ,
Dialogue: 0,0:11:07.37,0:11:09.69,Caption,,0,0,0,,КТО УЖЕ ЖИВЁТ В ЕВРОПЕ. ДЕВЯНОСТО ДНЕЙ,
Dialogue: 0,0:11:10.00,0:11:13.21,Caption,,0,0,0,,ЭТО СРОК, ЗА КОТОРЫЙ В ПОЛЬШЕ НЕ УСПЕВАЕТ ЗАКРЫТЬСЯ ДАЖЕ
Dialogue: 0,0:11:13.21,0:11:16.97,Caption,,0,0,0,,РАБОЧИЙ КОНТРАКТ, А В ГЕРМАНИИ ТОЛЬКО ПОДХОДИТ ОЧЕРЕДЬ НА ПРОДЛЕНИЕ
Dialogue: 0,0:11:16.97,0:11:22.86,Caption,,0,0,0,,ВИДА НА ЖИТЕЛЬСТВО. МОБИЛИЗАЦИОННАЯ ПРОБЛЕМА ДАВНО ВЫШЛА ЗА ПРЕДЕЛЫ
Dialogue: 0,0:11:22.86,0:11:27.66,Caption,,0,0,0,,ОДНОГО ВОЕНКОМАТА, ОДНОЙ ПОВЕСТКИ И ОДНОГО ЗАКОНА. ТЕПЕРЬ ЭТО БОРЬБА
Dialogue: 0,0:11:27.74,0:11:30.22,Caption,,0,0,0,,ЗА ВЕСЬ ЧЕЛОВЕЧЕСКИЙ ЗАПАС СТРАНЫ ЗА ТЕХ,
Dialogue: 0,0:11:30.53,0:11:34.70,Caption,,0,0,0,,КТО ВОЮЕТ СЕГОДНЯ, КТО ПРОИЗВОДИТ НЕОБХОДИМОЕ ЗАВТРА И КТО ЧЕРЕЗ
Dialogue: 0,0:11:34.70,0:11:37.98,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ ВООБЩЕ ЗАХОЧЕТ СЧИТАТЬ УКРАИНУ СВОИМ
Dialogue: 0,0:11:38.06,0:11:41.26,Caption,,0,0,0,,ДОМОМ. ПЯТНАДЦАТИЛЕТНИЕ ПРЕДСТАВЛЯЮТ БУДУЩИЙ РЕСУРС.
Dialogue: 0,0:11:41.46,0:11:44.78,Caption,,0,0,0,,МУЖЧИНЫ В ЕВРОСОЮЗЕ ЯВЛЯЮТСЯ РЕСУРСОМ УЖЕ УЕХАВШИМ.
Dialogue: 0,0:11:45.06,0:11:47.58,Caption,,0,0,0,,ЛЮДИ С НЕПОДКОНТРОЛЬНЫХ КИЕВУ ТЕРРИТОРИЙ ОСТАЮТСЯ
Dialogue: 0,0:11:47.58,0:11:50.78,Caption,,0,0,0,,РЕСУРСОМ, КОТОРЫЙ ЕЩЁ НАДО УГОВОРИТЬ ПЕРЕСЕЧЬ ГРАНИЦУ В
Dialogue: 0,0:11:50.78,0:11:53.98,Caption,,0,0,0,,ПРАВИЛЬНОМ НАПРАВЛЕНИИ. ДАЖЕ СЛОВО "ВОЗВРАЩЕНИЕ" В
Dialogue: 0,0:11:54.06,0:11:56.54,Caption,,0,0,0,,ЭТОЙ СИСТЕМЕ ЗВУЧИТ ТЕПЛО ТОЛЬКО ДО ЗНАКОМСТВА С
Dialogue: 0,0:11:56.54,0:11:58.78,Caption,,0,0,0,,УСЛОВИЯМИ. ЧЕМ СИЛЬНЕЕ ДАВЛЕНИЕ,
Dialogue: 0,0:11:59.04,0:12:01.18,Caption,,0,0,0,,ТЕМ ТРУДНЕЕ СОХРАНИТЬ ВИДИМОСТЬ ДОБРОВОЛЬНОГО
Dialogue: 0,0:12:01.18,0:12:03.98,Caption,,0,0,0,,РЕШЕНИЯ. СЕГОДНЯ ЧЕЛОВЕКУ ПРЕДЛАГАЮТ ПОДУМАТЬ О
Dialogue: 0,0:12:03.98,0:12:06.38,Caption,,0,0,0,,РОДИНЕ. ЗАВТРА ЕМУ ОСЛОЖНЯЮТ АРЕНДУ И
Dialogue: 0,0:12:06.38,0:12:08.86,Caption,,0,0,0,,ТРУДОУСТРОЙСТВО. ПОСЛЕЗАВТРА ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:12:09.12,0:12:12.38,Caption,,0,0,0,,ЧТО БИЛЕТ УЖЕ КУПЛЕН, А ОБСУЖДАЛСЯ ЛИШЬ РАЗМЕР БАГАЖА.
Dialogue: 0,0:12:13.16,0:12:15.82,Caption,,0,0,0,,ГОДАМИ РАССКАЗЫВАТЬ О ТЯЖЁЛОЙ ЗИМЕ И КРИТИЧЕСКИХ
Dialogue: 0,0:12:15.82,0:12:19.58,Caption,,0,0,0,,РИСКАХ, А ЗАТЕМ УДИВЛЯТЬСЯ ОТЪЕЗДУ МОЛОДЁЖИ ДОВОЛЬНО НАИВНО.
Dialogue: 0,0:12:20.14,0:12:22.94,Caption,,0,0,0,,РОДИТЕЛИ СЛЫШАТ ПРЕДУПРЕЖДЕНИЯ И ПРИНИМАЮТ РЕШЕНИЕ
Dialogue: 0,0:12:23.02,0:12:25.74,Caption,,0,0,0,,НЕ ПО ЛОЗУНГУ, А ПО БУДУЩЕМУ СВОЕГО РЕБЁНКА.
Dialogue: 0,0:12:26.38,0:12:28.94,Caption,,0,0,0,,ЕСЛИ БЕЗОПАСНЫЙ ВАРИАНТ НАХОДИТСЯ ЗА ГРАНИЦЕЙ,
Dialogue: 0,0:12:29.18,0:12:31.74,Caption,,0,0,0,,ОДНОЙ РЕЧЬЮ О ДОЛГЕ ЭТОТ РАСЧЁТ НЕ ОТМЕНИТЬ.
Dialogue: 0,0:12:34.01,0:12:38.57,Caption,,0,0,0,,ЕЩЁ ТРУДНЕЕ ВЕРНУТЬ ТЕХ, КТО УЖЕ ПУСТИЛ КОРНИ В ДРУГОМ МЕСТЕ. РАБОТА,
Dialogue: 0,0:12:38.66,0:12:41.45,Caption,,0,0,0,,ОБРАЗОВАНИЕ И СЕМЬЯ ПРЕВРАЩАЮТ ВРЕМЕННЫЙ ОТЪЕЗД В
Dialogue: 0,0:12:41.45,0:12:44.41,Caption,,0,0,0,,НОВУЮ БИОГРАФИЮ. ПОСТАНОВЛЕНИЕ СПОСОБНО ИЗМЕНИТЬ
Dialogue: 0,0:12:44.41,0:12:48.01,Caption,,0,0,0,,СТАТУС ЧЕЛОВЕКА, НО НЕ ЗАСТАВИТ ЕГО ВОСПРИНИМАТЬ ПРИНУДИТЕЛЬНОЕ
Dialogue: 0,0:12:48.01,0:12:50.81,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ КАК СЧАСТЛИВОЕ ВОССОЕДИНЕНИЕ С РОДИНОЙ.
Dialogue: 0,0:12:51.30,0:12:53.77,Caption,,0,0,0,,ПРИКАЗ БИТЬ ПО МОСТАМ СОВПАДАЕТ С ОБСТАНОВКОЙ НА
Dialogue: 0,0:12:53.77,0:12:55.69,Caption,,0,0,0,,ФРОНТЕ СНАБЖЕНИЕ РЕЖУТ ПЕРВЫМ,
Dialogue: 0,0:12:55.92,0:12:58.89,Caption,,0,0,0,,ЭТО СТАРАЯ ФОРМУЛА ВОЙНЫ. ЭЛЕКТРИЧЕСТВО И ЗАВОД
Dialogue: 0,0:12:58.97,0:13:01.77,Caption,,0,0,0,,ПОСЛЕ УДАРА ПОДНИМУТ. А ВОТ УТРАЧЕННОЕ ДОВЕРИЕ
Dialogue: 0,0:13:01.77,0:13:04.17,Caption,,0,0,0,,РЕМОНТОМ НЕ ВОССТАНОВИШЬ. С ПОКОЛЕНИЕМ,
Dialogue: 0,0:13:04.44,0:13:08.49,Caption,,0,0,0,,КОТОРОЕ УЕХАЛО, ВСЁ ИНАЧЕ. ЕГО НЕЛЬЗЯ СОБРАТЬ БРИГАДОЙ,
Dialogue: 0,0:13:08.65,0:13:11.37,Caption,,0,0,0,,ЗАКАЗАТЬ ИЗ БЮДЖЕТА И СДАТЬ К УСТАНОВЛЕННОМУ СРОКУ.
Dialogue: 0,0:13:11.85,0:13:13.93,Caption,,0,0,0,,ЧЕМ ДОЛЬШЕ ЛЮДИ ЖИВУТ В ДРУГИХ СТРАНАХ,
Dialogue: 0,0:13:14.17,0:13:16.65,Caption,,0,0,0,,ТЕМ МЕНЬШЕ НА НИХ ДЕЙСТВУЕТ КОМАНДА ВЕРНУТЬСЯ,
Dialogue: 0,0:13:16.97,0:13:19.53,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ ДОМА ИХ ВСТРЕЧАЮТ ДЕВЯНОСТОДНЕВНОЙ
Dialogue: 0,0:13:19.53,0:13:22.97,Caption,,0,0,0,,ОТСРОЧКОЙ И РАЗГОВОРОМ О НОВЫХ ОГРАНИЧЕНИЯХ. ПОЭТОМУ
Dialogue: 0,0:13:22.97,0:13:25.61,Caption,,0,0,0,,ГЛАВНЫЙ РИСК ИЗМЕРЯЕТСЯ НЕ ТОЛЬКО КОЛИЧЕСТВОМ ЦЕЛЫХ
Dialogue: 0,0:13:25.61,0:13:28.81,Caption,,0,0,0,,МОСТОВ ИЛИ РАБОТАЮЩИХ ПОДСТАНЦИЙ. НАМНОГО ВАЖНЕЕ,
Dialogue: 0,0:13:29.04,0:13:31.93,Caption,,0,0,0,,СКОЛЬКО ЛЮДЕЙ ЕЩЁ ГОТОВЫ СВЯЗЫВАТЬ СВОЁ БУДУЩЕЕ СО
Dialogue: 0,0:13:31.93,0:13:35.53,Caption,,0,0,0,,СТРАНОЙ, КОТОРАЯ СООБЩАЕТ ИМ СРАЗУ ТРИ ВЕЩИ ЖИТЬ СТАНЕТ
Dialogue: 0,0:13:35.53,0:13:38.49,Caption,,0,0,0,,ТЯЖЕЛЕЕ, ВЫЕЗЖАТЬ НЕ СЛЕДУЕТ, А ТЕМ,
Dialogue: 0,0:13:38.67,0:13:42.57,Caption,,0,0,0,,КТО УЖЕ УЕХАЛ, ПОРА СОБИРАТЬСЯ ОБРАТНО. ПРЕДУПРЕДИТЬ ОБ ОПАСНОСТИ
Dialogue: 0,0:13:42.57,0:13:45.69,Caption,,0,0,0,,ЛЕГКО. УДЕРЖАТЬ ЧЕЛОВЕКА ЗНАЧИТЕЛЬНО ТРУДНЕЕ.
Dialogue: 0,0:13:47.97,0:13:51.57,Caption,,0,0,0,,А ВЕРНУТЬ ЕГО ПОСЛЕ ТОГО, КАК ОН ПОСТРОИЛ ЖИЗНЬ В ДРУГОМ МЕСТЕ,
Dialogue: 0,0:13:51.77,0:13:56.29,Caption,,0,0,0,,СЛОЖНЕЕ ВСЕГО. МОСТ ЧИНЯТ ПО СМЕТЕ И СРОКАМ. У ПОТЕРЯННОГО
Dialogue: 0,0:13:56.29,0:13:59.49,Caption,,0,0,0,,ДОВЕРИЯ НИ СМЕТЫ, НИ СРОКА РЕМОНТА ПОКА НЕТ.
