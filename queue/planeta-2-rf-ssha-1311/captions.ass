Dialogue: 0,0:00:00.04,0:00:02.52,Caption,,0,0,0,,В БОЛЬШОЙ КОМПАНИИ К СЕРЬЁЗНОМУ РАЗГОВОРУ ОБЫЧНО
Dialogue: 0,0:00:02.52,0:00:06.44,Caption,,0,0,0,,ПРИХОДИТ ТОТ, КОМУ ДОВЕРИЛИ ПРИНИМАТЬ РЕШЕНИЯ. У ЕВРОПЫ ВСЁ
Dialogue: 0,0:00:06.44,0:00:08.68,Caption,,0,0,0,,ИНТЕРЕСНЕЕ ЖЕЛАЮЩИХ ВЫСТУПИТЬ ДВАДЦАТЬ СЕМЬ,
Dialogue: 0,0:00:09.07,0:00:11.08,Caption,,0,0,0,,А ЧЕЛОВЕКА С ОБЩИМ МАНДАТОМ ДО СИХ ПОР
Dialogue: 0,0:00:11.08,0:00:15.08,Caption,,0,0,0,,НЕТ. ТЕПЕРЬ ЕЙ ВЕЛЕЛИ ВЫБРАТЬ ЕДИНЫЙ ГОЛОС. И ЖЕЛАТЕЛЬНО
Dialogue: 0,0:00:15.08,0:00:18.12,Caption,,0,0,0,,ПОБЫСТРЕЕ, ПОТОМУ ЧТО ПЕРЕГОВОРЫ УЖЕ НАБИРАЮТ ХОД,
Dialogue: 0,0:00:18.57,0:00:21.00,Caption,,0,0,0,,А СВОБОДНОЕ КРЕСЛО НИКТО ВЕЧНО ПРИДЕРЖИВАТЬ НЕ
Dialogue: 0,0:00:21.08,0:00:23.80,Caption,,0,0,0,,СТАНЕТ. САМЫЙ НЕПРИЯТНЫЙ ВОПРОС ДАЖЕ НЕ В ТОМ,
Dialogue: 0,0:00:23.96,0:00:26.12,Caption,,0,0,0,,КОГО ТУДА ПОСАДЯТ. ВОПРОС В ТОМ,
Dialogue: 0,0:00:26.44,0:00:29.64,Caption,,0,0,0,,ЗАМЕТЯТ ЛИ ОСТАЛЬНЫЕ, ЕСЛИ ЕВРОПА ВООБЩЕ НЕ ПРИДЁТ.
Dialogue: 0,0:00:30.33,0:00:32.36,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:32.52,0:00:34.84,Caption,,0,0,0,,ГДЕ МЫ СМОТРИМ НЕ НА ОДНУ ГРОМКУЮ ФРАЗУ,
Dialogue: 0,0:00:35.00,0:00:37.24,Caption,,0,0,0,,А НА ТО, ЧТО ЗА НЕЙ НАЧИНАЕТ ДВИГАТЬСЯ,
Dialogue: 0,0:00:37.44,0:00:40.36,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ. МОСКВА
Dialogue: 0,0:00:40.44,0:00:43.32,Caption,,0,0,0,,ПЕРЕДАЛА СТРАНАМ НАТО ТРИ ВОЗМОЖНЫЕ СХЕМЫ БУДУЩИХ
Dialogue: 0,0:00:43.32,0:00:46.28,Caption,,0,0,0,,СОГЛАШЕНИЙ О БЕЗОПАСНОСТИ. БЕЗ ТОРЖЕСТВЕННОЙ ПАПКИ,
Dialogue: 0,0:00:46.44,0:00:49.40,Caption,,0,0,0,,ХОРА ПРАВИЛЬНЫХ СЛОВ И ОБЩЕГО ОБЕЩАНИЯ КОГДА НИБУДЬ
Dialogue: 0,0:00:49.40,0:00:52.52,Caption,,0,0,0,,ЖИТЬ ДРУЖНО. ПРЕДЛОЖЕНИЯ ВПОЛНЕ ПРЕДМЕТНЫЕ. ПЕРВЫЙ
Dialogue: 0,0:00:52.52,0:00:55.08,Caption,,0,0,0,,ВАРИАНТ ПРЕДУСМАТРИВАЕТ ВЗАИМНУЮ ВОЕННУЮ ПОМОЩЬ.
Dialogue: 0,0:00:55.48,0:00:58.44,Caption,,0,0,0,,ВТОРОЙ ТРЕБУЕТ ПИСЬМЕННО ОБЯЗАТЬСЯ НЕ ПОДДЕРЖИВАТЬ
Dialogue: 0,0:00:58.52,0:01:01.40,Caption,,0,0,0,,ПРОТИВНИКА ДРУГОЙ СТРАНЫ ПРИ НАПАДЕНИИ. ТРЕТИЙ
Dialogue: 0,0:01:01.40,0:01:03.88,Caption,,0,0,0,,ПРЕДЛАГАЕТ РОССИИ ЗАКЛЮЧАТЬ ОТДЕЛЬНЫЕ ПАКТЫ О
Dialogue: 0,0:01:03.88,0:01:07.08,Caption,,0,0,0,,НЕНАПАДЕНИИ С КОНКРЕТНЫМИ ЧЛЕНАМИ НАТО. ПОСЛЕДНИЙ
Dialogue: 0,0:01:07.08,0:01:09.08,Caption,,0,0,0,,ПУНКТ ВЫГЛЯДИТ САМЫМ ЛЮБОПЫТНЫМ.
Dialogue: 0,0:01:11.36,0:01:14.16,Caption,,0,0,0,,АЛЬЯНС МНОГО ЛЕТ ПРОДАВАЛ ИДЕЮ ЕДИНОГО СТРОЯ,
Dialogue: 0,0:01:14.32,0:01:16.64,Caption,,0,0,0,,ГДЕ ВСЕ ДЕРЖАТСЯ ВМЕСТЕ И НИКТО НЕ ВЫХОДИТ
Dialogue: 0,0:01:16.72,0:01:20.80,Caption,,0,0,0,,ИЗ ОБЩЕЙ ШЕРЕНГИ. РОССИЯ ПРЕДЛАГАЕТ ДРУГОЙ ПОРЯДОК ХОТИТЕ ГАРАНТИЙ,
Dialogue: 0,0:01:20.95,0:01:24.16,Caption,,0,0,0,,ПРИХОДИТЕ ПО ОДНОМУ. С ВАРШАВОЙ МОЖНО ОБСУЖДАТЬ ОДИН
Dialogue: 0,0:01:24.16,0:01:28.88,Caption,,0,0,0,,ДОГОВОР, С БЕРЛИНОМ ДРУГОЙ, С ХЕЛЬСИНКИ ТРЕТИЙ. БЕЗ КОЛЛЕКТИВНОГО ХОРА,
Dialogue: 0,0:01:29.10,0:01:31.04,Caption,,0,0,0,,В КОТОРОМ КАЖДЫЙ ПОЁТ СВОЮ МЕЛОДИЮ,
Dialogue: 0,0:01:31.36,0:01:34.16,Caption,,0,0,0,,НО ДИРИЖЁРУ ПРИХОДИТСЯ УЛЫБАТЬСЯ. ОТСЮДА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:01:34.24,0:01:37.44,Caption,,0,0,0,,КРАЙНЕ НЕУДОБНЫЙ ВОПРОС. ЕСЛИ ГОСУДАРСТВО ПОЛУЧАЕТ
Dialogue: 0,0:01:37.44,0:01:40.32,Caption,,0,0,0,,ПРЯМЫЕ ГАРАНТИИ ОТ МОСКВЫ И СТАВИТ ПОДПИСЬ ПОД
Dialogue: 0,0:01:40.32,0:01:44.48,Caption,,0,0,0,,ОТДЕЛЬНЫМ СОГЛАШЕНИЕМ, КАКОЙ ДОКУМЕНТ БУДЕТ ДЛЯ НЕГО ВАЖНЕЕ В МОМЕНТ
Dialogue: 0,0:01:44.48,0:01:48.40,Caption,,0,0,0,,НАСТОЯЩЕГО КРИЗИСА? УСТАВ БОЛЬШОГО ОБЪЕДИНЕНИЯ ИЛИ ДОГОВОР,
Dialogue: 0,0:01:48.64,0:01:51.04,Caption,,0,0,0,,ГДЕ ОБЯЗАТЕЛЬСТВА ПРОПИСАНЫ ИМЕННО ДЛЯ ДВУХ
Dialogue: 0,0:01:51.04,0:01:53.20,Caption,,0,0,0,,ПОДПИСАНТОВ? НИКТО НЕ УТВЕРЖДАЕТ,
Dialogue: 0,0:01:53.50,0:01:56.00,Caption,,0,0,0,,ЧТО ПОСЛЕ ЭТОГО НАТО УТРОМ ПРОСНЁТСЯ И ОБНАРУЖИТ
Dialogue: 0,0:01:56.08,0:01:59.20,Caption,,0,0,0,,СЕБЯ ЗАКРЫТЫМ УЧРЕЖДЕНИЕМ. СМЫСЛ В ДРУГОМ. РОССИИ
Dialogue: 0,0:01:59.20,0:02:01.84,Caption,,0,0,0,,ПРЕДЛАГАЕТСЯ НЕ ПРОСТО СНИЗИТЬ НАПРЯЖЕНИЕ НА СЛОВАХ,
Dialogue: 0,0:02:01.99,0:02:06.32,Caption,,0,0,0,,А СОБРАТЬ НОВУЮ СИСТЕМУ, ГДЕ БЕЗОПАСНОСТЬ ОДНОГО УЧАСТНИКА НЕ ТРЕБУЕТ
Dialogue: 0,0:02:06.32,0:02:10.72,Caption,,0,0,0,,ПОСТОЯННОГО ИСПУГА У ДРУГОГО. НА ЭТОМ МЕСТЕ В РАЗГОВОР ВХОДИТ ВАШИНГТОН.
Dialogue: 0,0:02:11.01,0:02:13.36,Caption,,0,0,0,,ТРЕБОВАНИЯ РОССИИ ВОЗНИКЛИ НЕ НА ПРОШЛОЙ НЕДЕЛЕ.
Dialogue: 0,0:02:15.64,0:02:18.28,Caption,,0,0,0,,В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА МОСКВА
Dialogue: 0,0:02:18.28,0:02:21.40,Caption,,0,0,0,,ПРЕДЛАГАЛА СОЕДИНЁННЫМ ШТАТАМ И НАТО ЗАФИКСИРОВАТЬ
Dialogue: 0,0:02:21.40,0:02:23.48,Caption,,0,0,0,,ОГРАНИЧЕНИЯ НА РАСШИРЕНИЕ АЛЬЯНСА,
Dialogue: 0,0:02:23.64,0:02:26.60,Caption,,0,0,0,,РАЗМЕЩЕНИЕ ВООРУЖЕНИЙ И ПРИБЛИЖЕНИЕ ВОЕННОЙ
Dialogue: 0,0:02:26.60,0:02:29.72,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ. ТОГДА ПРЕДЛОЖЕНИЕ УБРАЛИ В ДАЛЬНИЙ
Dialogue: 0,0:02:29.80,0:02:34.92,Caption,,0,0,0,,ЯЩИК. ВИДИМО, ЯЩИК СЧИТАЛСЯ НАДЁЖНЕЕ ПЕРЕГОВОРОВ. ПОЧТИ ЧЕРЕЗ ПЯТЬ
Dialogue: 0,0:02:34.92,0:02:38.20,Caption,,0,0,0,,ЛЕТ АМЕРИКАНЦЫ САМИ ВОЗВРАЩАЮТСЯ К ТОЙ ЖЕ ДВЕРИ
Dialogue: 0,0:02:38.28,0:02:42.60,Caption,,0,0,0,,И ГОВОРЯТ, ЧТО ПРЕЖНИЙ МЕХАНИЗМ БОЛЬШЕ НЕ ТЯНЕТ. НУЖНА ДРУГАЯ
Dialogue: 0,0:02:42.60,0:02:46.20,Caption,,0,0,0,,КОНСТРУКЦИЯ. ДОБРОЕ УТРО. БУДИЛЬНИК ЗВОНИЛ ДОЛГО,
Dialogue: 0,0:02:46.41,0:02:49.32,Caption,,0,0,0,,НО ВСЁ ТАКИ ДОСТУЧАЛСЯ. ПОКА РОССИЯ И СОЕДИНЁННЫЕ
Dialogue: 0,0:02:49.32,0:02:53.00,Caption,,0,0,0,,ШТАТЫ ВЫЯСНЯЮТ, ИЗ КАКИХ ДЕТАЛЕЙ СОБИРАТЬ НОВУЮ СИСТЕМУ,
Dialogue: 0,0:02:53.32,0:02:56.44,Caption,,0,0,0,,ЕВРОПЕЙСКОМУ СОЮЗУ ДОСТАЛОСЬ ИСПЫТАНИЕ СУРОВЕЕ ЛЮБОЙ
Dialogue: 0,0:02:56.44,0:02:59.56,Caption,,0,0,0,,БРЮССЕЛЬСКОЙ ПРОЦЕДУРЫ. ТРЕБУЕТСЯ НАЗНАЧИТЬ ОДНОГО
Dialogue: 0,0:02:59.56,0:03:02.76,Caption,,0,0,0,,ПЕРЕГОВОРЩИКА. ДЖАРЕД КУШНЕР ПРЯМО ПРЕДЛАГАЕТ
Dialogue: 0,0:03:02.76,0:03:05.80,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ВЫБРАТЬ ЕДИНОГО ПРЕДСТАВИТЕЛЯ ДЛЯ ОБЩЕНИЯ
Dialogue: 0,0:03:05.80,0:03:08.92,Caption,,0,0,0,,С РОССИЕЙ. НЕ СОВЕТ ИЗ НЕСКОЛЬКИХ ДЕСЯТКОВ ЧЕЛОВЕК,
Dialogue: 0,0:03:09.11,0:03:11.72,Caption,,0,0,0,,НЕ КОМИССИЮ ПРИ КОМИССИИ И НЕ ОЧЕРЕДЬ ИЗ
Dialogue: 0,0:03:11.72,0:03:14.68,Caption,,0,0,0,,ЛИДЕРОВ, КАЖДЫЙ ИЗ КОТОРЫХ УПОЛНОМОЧЕН ГОВОРИТЬ ТОЛЬКО ДО
Dialogue: 0,0:03:14.68,0:03:18.04,Caption,,0,0,0,,БЛИЖАЙШЕГО ОБЕДА. НУЖЕН ОДИН ЧЕЛОВЕК С ПОНЯТНЫМ
Dialogue: 0,0:03:18.04,0:03:20.44,Caption,,0,0,0,,МАНДАТОМ. ЭТОТ ПРЕДСТАВИТЕЛЬ ДОЛЖЕН ИМЕТЬ
Dialogue: 0,0:03:20.44,0:03:23.48,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ПОЛОЖИТЬ НА СТОЛ ОБЩУЮ ПОЗИЦИЮ И
Dialogue: 0,0:03:23.48,0:03:26.04,Caption,,0,0,0,,ОТВЕЧАТЬ ЗА СКАЗАННОЕ. ВОТ ЗДЕСЬ ЕВРОПЕЙСКИЙ
Dialogue: 0,0:03:26.04,0:03:29.00,Caption,,0,0,0,,МЕХАНИЗМ НАЧИНАЕТ ИЗДАВАТЬ ЗВУКИ СТАРОГО ШКАФА,
Dialogue: 0,0:03:29.24,0:03:31.56,Caption,,0,0,0,,КОТОРЫЙ ПЫТАЮТСЯ ПРОТАЩИТЬ ЧЕРЕЗ УЗКУЮ ДВЕРЬ.
Dialogue: 0,0:03:33.85,0:03:36.41,Caption,,0,0,0,,МЕДИНСКИЙ ПОСЛЕ ВСТРЕЧИ В АБУ ДАБИ ВЫРАЗИЛСЯ ЕЩЁ
Dialogue: 0,0:03:36.41,0:03:39.45,Caption,,0,0,0,,ПОНЯТНЕЕ. РОССИЙСКАЯ ДЕЛЕГАЦИЯ НЕ СТАЛА ВЕСТИ
Dialogue: 0,0:03:39.45,0:03:41.37,Caption,,0,0,0,,ПЕРЕГОВОРЫ С ПРИБЫВШИМИ ЕВРОПЕЙЦАМИ,
Dialogue: 0,0:03:41.69,0:03:43.61,Caption,,0,0,0,,ПОТОМУ ЧТО НИКТО НЕ СМОГ ТОЛКОМ ОБЪЯСНИТЬ ИХ
Dialogue: 0,0:03:43.69,0:03:47.61,Caption,,0,0,0,,СТАТУС И ПОЛНОМОЧИЯ. ЕСЛИ ЛЮДИ ПРИЕХАЛИ КАК ТУРИСТЫ,
Dialogue: 0,0:03:47.76,0:03:51.21,Caption,,0,0,0,,ЗАМЕТИЛ ОН, ПОГОВОРИТЬ С НИМИ МОЖНО В БАРЕ ПРИ ГОСТИНИЦЕ.
Dialogue: 0,0:03:51.57,0:03:55.77,Caption,,0,0,0,,ФРАЗА КОЛКАЯ, ЗАТО ИНСТРУКЦИЯ ПРЕДЕЛЬНО ЯСНАЯ. ДЛЯ СЕРЬЁЗНОГО
Dialogue: 0,0:03:55.77,0:03:58.41,Caption,,0,0,0,,РАЗГОВОРА МАЛО КУПИТЬ БИЛЕТ И ПОЯВИТЬСЯ В КОРИДОРЕ.
Dialogue: 0,0:03:58.66,0:04:01.61,Caption,,0,0,0,,НУЖЕН ОТВЕТ НА ПРОСТОЙ ВОПРОС КОГО ВЫ ПРЕДСТАВЛЯЕТЕ
Dialogue: 0,0:04:01.83,0:04:05.37,Caption,,0,0,0,,И ЧТО МОЖЕТЕ РЕШИТЬ? ПРИЧИНА НЕ ТОЛЬКО В ЛЮБВИ БРЮССЕЛЯ К СЛОЖНЫМ
Dialogue: 0,0:04:05.37,0:04:09.05,Caption,,0,0,0,,ПРОЦЕДУРАМ. У ГОСУДАРСТВ СОЮЗА РАЗНЫЕ ЦЕЛИ. ОДНИ
Dialogue: 0,0:04:09.13,0:04:11.69,Caption,,0,0,0,,ТРЕБУЮТ СИЛЬНЕЕ ДАВИТЬ НА РОССИЮ. ДРУГИМ НУЖНА
Dialogue: 0,0:04:11.69,0:04:15.21,Caption,,0,0,0,,ТОРГОВЛЯ. ТРЕТЬИ ХОТЯТ НАДЁЖНЫХ ГАРАНТИЙ. ЧЕТВЁРТЫЕ
Dialogue: 0,0:04:15.21,0:04:18.33,Caption,,0,0,0,,ЦЕПЛЯЮТСЯ ЗА АМЕРИКАНСКОЕ ВОЕННОЕ ПРИСУТСТВИЕ. ПЯТЫЕ
Dialogue: 0,0:04:18.34,0:04:21.37,Caption,,0,0,0,,УЖЕ САМОСТОЯТЕЛЬНО НАБИРАЮТ МОСКОВСКИЙ НОМЕР. ЕСЛИ
Dialogue: 0,0:04:21.45,0:04:25.21,Caption,,0,0,0,,ВАМ НРАВИТСЯ ТАКОЙ ФОРМАТ, ГДЕ МЫ НЕ СЧИТАЕМ КОЛИЧЕСТВО РУКОПОЖАТИЙ,
Dialogue: 0,0:04:25.46,0:04:28.81,Caption,,0,0,0,,А СМОТРИМ, КТО РЕАЛЬНО ПОЛУЧАЕТ ПРАВО ПРИНИМАТЬ РЕШЕНИЯ,
Dialogue: 0,0:04:28.96,0:04:31.77,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ МАСШТАБ СТАНОВИТСЯ
Dialogue: 0,0:04:31.77,0:04:34.89,Caption,,0,0,0,,ЕЩЁ ИНТЕРЕСНЕЕ. МИНИСТР ИНОСТРАННЫХ ДЕЛ БЕЛОРУССИИ
Dialogue: 0,0:04:34.97,0:04:38.97,Caption,,0,0,0,,РЫЖЕНКОВ ЗАЯВЛЯЕТ, ЧТО ЕВРАЗИЙСКУЮ БЕЗОПАСНОСТЬ УЖЕ ПРИХОДИТСЯ
Dialogue: 0,0:04:38.97,0:04:41.53,Caption,,0,0,0,,СОЗДАВАТЬ БЕЗ ДЕЯТЕЛЬНОГО УЧАСТИЯ ЕВРОПЕЙСКОГО
Dialogue: 0,0:04:41.53,0:04:44.97,Caption,,0,0,0,,СОЮЗА. САМО СОЧЕТАНИЕ ЗВУЧИТ ДЛЯ БРЮССЕЛЯ ПОЧТИ КАК
Dialogue: 0,0:04:44.97,0:04:50.68,Caption,,0,0,0,,ИЗДЕВАТЕЛЬСТВО. НЕСКОЛЬКО ЛЕТ НАЗАД ПОДОБНОЕ ЗАЯВЛЕНИЕ ВЫЗВАЛО БЫ В
Dialogue: 0,0:04:50.76,0:04:53.56,Caption,,0,0,0,,ЕВРОПЕЙСКИХ КАБИНЕТАХ СНИСХОДИТЕЛЬНЫЙ СМЕХ. ТЕПЕРЬ
Dialogue: 0,0:04:53.64,0:04:56.68,Caption,,0,0,0,,УЛЫБКИ ВЫХОДЯТ НАТЯНУТЫМИ. И ПАМЯТЬ УСЛУЖЛИВО
Dialogue: 0,0:04:56.68,0:05:01.56,Caption,,0,0,0,,ПОДСОВЫВАЕТ ЯЛТУ. В ФЕВРАЛЕ ТЫСЯЧА ДЕВЯТЬСОТ СОРОК ПЯТОГО ГОДА ГЛАВНЫЕ
Dialogue: 0,0:05:01.56,0:05:06.20,Caption,,0,0,0,,РЕШЕНИЯ ПРИНИМАЛИ СТАЛИН, РУЗВЕЛЬТ И ЧЕРЧИЛЛЬ. ЗА ОДНИМ СТОЛОМ СИДЕЛИ
Dialogue: 0,0:05:06.20,0:05:09.64,Caption,,0,0,0,,СОВЕТСКИЙ СОЮЗ, СОЕДИНЁННЫЕ ШТАТЫ И ВЕЛИКОБРИТАНИЯ.
Dialogue: 0,0:05:10.20,0:05:12.44,Caption,,0,0,0,,ФРАНЦУЗСКОГО РУКОВОДИТЕЛЯ ТУДА НЕ ПРИГЛАСИЛИ.
Dialogue: 0,0:05:12.83,0:05:15.48,Caption,,0,0,0,,ИТАЛЬЯНСКОГО МНЕНИЯ НЕ СПРАШИВАЛИ. ГЕРМАНИЯ БЫЛА
Dialogue: 0,0:05:15.48,0:05:19.88,Caption,,0,0,0,,ПРЕДМЕТОМ РЕШЕНИЙ, А НЕ ИХ СОАВТОРОМ. БОЛЬШАЯ ЧАСТЬ ЕВРОПЫ УЗНАЛА
Dialogue: 0,0:05:19.88,0:05:23.96,Caption,,0,0,0,,РЕЗУЛЬТАТ УЖЕ ПОСЛЕ ТОГО, КАК СИЛЬНЕЙШИЕ УЧАСТНИКИ ОБО ВСЁМ ДОГОВОРИЛИСЬ.
Dialogue: 0,0:05:24.44,0:05:26.28,Caption,,0,0,0,,НИКТО НЕ ПРИОСТАНАВЛИВАЛ ВСТРЕЧУ,
Dialogue: 0,0:05:26.44,0:05:29.64,Caption,,0,0,0,,ЧТОБЫ УЗНАТЬ НАСТРОЕНИЕ КАЖДОЙ СТОЛИЦЫ. У ПАРИЖА НЕ
Dialogue: 0,0:05:29.64,0:05:32.44,Caption,,0,0,0,,ПРОСИЛИ ПОСТАВИТЬ СМАЙЛИК ОДОБРЕНИЯ. РИМУ НЕ
Dialogue: 0,0:05:32.44,0:05:34.84,Caption,,0,0,0,,ОТПРАВЛЯЛИ ФОРМУ ДЛЯ ЗАМЕЧАНИЙ. ПОБЕДИТЕЛИ
Dialogue: 0,0:05:34.84,0:05:39.56,Caption,,0,0,0,,ОПРЕДЕЛЯЛИ БУДУЩИЙ ПОРЯДОК, ПОТОМУ ЧТО ОБЛАДАЛИ СИЛОЙ ЕГО ОПРЕДЕЛИТЬ. ТАК
Dialogue: 0,0:05:39.56,0:05:42.52,Caption,,0,0,0,,УСТРОЕНЫ БОЛЬШИЕ СДЕЛКИ. КОГДА КРУПНЕЙШИЕ ДЕРЖАВЫ
Dialogue: 0,0:05:42.52,0:05:47.64,Caption,,0,0,0,,САДЯТСЯ РЕШАТЬ ОБЩИЙ ВОПРОС, ЧИХАТЬ ОНИ ХОТЕЛИ НА ОСТАЛЬНЫХ. ОТСУТСТВИЕ ДЕСЯТКА
Dialogue: 0,0:05:47.64,0:05:50.36,Caption,,0,0,0,,ПРИГЛАШЁННЫХ ПРОЦЕССУ НЕ МЕШАЕТ. КТО НЕ УСПЕЛ
Dialogue: 0,0:05:50.44,0:05:52.60,Caption,,0,0,0,,ПОЛУЧИТЬ МЕСТО, ОСТАЁТСЯ ЗА ДВЕРЬЮ,
Dialogue: 0,0:05:53.00,0:05:55.48,Caption,,0,0,0,,А ПОТОМ ЧИТАЕТ ИТОГОВЫЙ ДОКУМЕНТ С ВЫРАЖЕНИЕМ
Dialogue: 0,0:05:55.48,0:05:58.76,Caption,,0,0,0,,ГЛУБОКОГО УЧАСТИЯ. ВОТ О КАКОМ УРОВНЕ РАЗГОВОРА ИДЁТ
Dialogue: 0,0:05:58.76,0:06:01.88,Caption,,0,0,0,,РЕЧЬ. СРАЗУ ПОСЛЕ ЭТОГО ОСОБЕННО ВЫРАЗИТЕЛЬНО ЗВУЧИТ
Dialogue: 0,0:06:01.96,0:06:06.01,Caption,,0,0,0,,КАЯ КАЛЛАС. ОНА НАПОМИНАЕТ,
Dialogue: 0,0:06:06.22,0:06:08.65,Caption,,0,0,0,,ЧТО МОСКВА ДОБИВАЕТСЯ ОТМЕНЫ САНКЦИЙ И
Dialogue: 0,0:06:08.65,0:06:11.69,Caption,,0,0,0,,РАЗМОРАЖИВАНИЯ РОССИЙСКИХ АКТИВОВ. ЭТИ РЕШЕНИЯ
Dialogue: 0,0:06:11.69,0:06:13.93,Caption,,0,0,0,,ПРИНАДЛЕЖАТ ЕВРОПЕ, ПОДЧЁРКИВАЕТ КАЛЛАС,
Dialogue: 0,0:06:14.17,0:06:16.65,Caption,,0,0,0,,ПОЭТОМУ НИКТО ДРУГОЙ РАСПОРЯДИТЬСЯ ИМИ НЕ МОЖЕТ.
Dialogue: 0,0:06:16.95,0:06:19.61,Caption,,0,0,0,,ДОПУСТИМ. НО ПОЧЕМУ БРЮССЕЛЬ РЕШИЛ,
Dialogue: 0,0:06:19.85,0:06:22.65,Caption,,0,0,0,,ЧТО ИМЕННО ЭТОТ СЕЙФ СТАНЕТ ГЛАВНЫМ ПРИЗОМ ВО
Dialogue: 0,0:06:22.73,0:06:26.49,Caption,,0,0,0,,ВСЕЙ ПАРТИИ? ДВЕСТИ МИЛЛИАРДОВ ЕВРО ПРОИЗВОДЯТ СИЛЬНОЕ
Dialogue: 0,0:06:26.49,0:06:29.37,Caption,,0,0,0,,ВПЕЧАТЛЕНИЕ ВНУТРИ ЕВРОПЕЙСКОГО КАБИНЕТА. ЦИФРА
Dialogue: 0,0:06:29.37,0:06:34.49,Caption,,0,0,0,,ТЯЖЁЛАЯ, ПАПКИ ТОЛСТЫЕ, ЛИЦА СЕРЬЁЗНЫЕ. НО ЕСЛИ СОЕДИНЁННЫЕ ШТАТЫ,
Dialogue: 0,0:06:34.61,0:06:37.37,Caption,,0,0,0,,РОССИЯ И КИТАЙ НАЧНУТ ВЫСТРАИВАТЬ БОЛЕЕ ШИРОКИЙ
Dialogue: 0,0:06:37.37,0:06:40.41,Caption,,0,0,0,,ПОРЯДОК, ЭТА СУММА ОКАЖЕТСЯ НЕ ЦЕНТРОМ МИРА,
Dialogue: 0,0:06:40.57,0:06:44.73,Caption,,0,0,0,,А ДОРОГОЙ КВИТАНЦИЕЙ, ЗАБЫТОЙ ПОД СТОПКОЙ КУДА БОЛЕЕ КРУПНЫХ СОГЛАШЕНИЙ.
Dialogue: 0,0:06:45.58,0:06:48.33,Caption,,0,0,0,,САНКЦИОННЫЙ РЫЧАГ ТОЖЕ НАЧИНАЕТ ВЫГЛЯДЕТЬ СТРАННО.
Dialogue: 0,0:06:48.74,0:06:52.25,Caption,,0,0,0,,РОССИЯ ПРОДОЛЖАЕТ ОБМЕН С ВНЕШНИМИ ПАРТНЁРАМИ. КИТАЙ
Dialogue: 0,0:06:52.33,0:06:55.29,Caption,,0,0,0,,РАСШИРЯЕТ СВОИ НАПРАВЛЕНИЯ. АМЕРИКА ЗАКЛЮЧАЕТ
Dialogue: 0,0:06:55.37,0:06:59.13,Caption,,0,0,0,,ВЫГОДНЫЕ СДЕЛКИ. А ЕВРОСОЮЗ С ГОРДЫМ ВИДОМ ЗАПРЕЩАЕТ
Dialogue: 0,0:06:59.13,0:07:02.89,Caption,,0,0,0,,УЧАСТВОВАТЬ САМОМУ СЕБЕ. ХОД ВЫДАЮЩИЙСЯ. ОСТАЁТСЯ
Dialogue: 0,0:07:02.89,0:07:05.37,Caption,,0,0,0,,ПОСТАВИТЬ У ВЫХОДА ТАБЛИЧКУ МЫ ПОБЕДИЛИ,
Dialogue: 0,0:07:05.55,0:07:10.25,Caption,,0,0,0,,ПРОСЬБА НЕ ПРОВЕРЯТЬ КАССУ. ОСОБЕННО ЗАБАВНО ЭТО ВЫГЛЯДИТ С УЧЁТОМ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:07:10.25,0:07:13.53,Caption,,0,0,0,,ЗАВИСИМОСТИ ОТ ВНЕШНИХ ПОСТАВОК. У ЕВРОСОЮЗА НЕТ
Dialogue: 0,0:07:13.53,0:07:17.61,Caption,,0,0,0,,НЕФТЕГАЗОВОЙ БАЗЫ, СРАВНИМОЙ ПО МАСШТАБУ С РОССИЙСКОЙ ИЛИ АМЕРИКАНСКОЙ.
Dialogue: 0,0:07:17.90,0:07:21.05,Caption,,0,0,0,,ГЕРМАНИЯ ОСТАНОВИЛА ПОСЛЕДНИЕ АТОМНЫЕ СТАНЦИИ.
Dialogue: 0,0:07:23.26,0:07:26.78,Caption,,0,0,0,,ВЕТРОГЕНЕРАТОРЫ ВРАЩАЮТСЯ, СОЛНЕЧНЫЕ ПАНЕЛИ СИЯЮТ,
Dialogue: 0,0:07:26.99,0:07:29.98,Caption,,0,0,0,,ПРЕЗЕНТАЦИИ ПЕРЕЛИСТЫВАЮТСЯ БЕЗУПРЕЧНО. ПРАВДА,
Dialogue: 0,0:07:30.24,0:07:33.10,Caption,,0,0,0,,МЕТАЛЛУРГИЧЕСКАЯ ПЕЧЬ ОТ КРАСИВОЙ ПРЕЗЕНТАЦИИ ТЕПЛЕЕ
Dialogue: 0,0:07:33.18,0:07:36.94,Caption,,0,0,0,,НЕ СТАНОВИТСЯ. ОНА, ЗАРАЗА, ТРЕБУЕТ ЭНЕРГИИ,
Dialogue: 0,0:07:37.02,0:07:39.98,Caption,,0,0,0,,А НЕ ВДОХНОВЕНИЯ. ТЕПЕРЬ ВОЗНИКАЕТ ГЛАВНЫЙ ВОПРОС.
Dialogue: 0,0:07:40.30,0:07:46.30,Caption,,0,0,0,,ЧТО БУДЕТ, ЕСЛИ МОСКВА, ВАШИНГТОН И ПЕКИН СУМЕЮТ НАЙТИ СОВПАДАЮЩИЕ ИНТЕРЕСЫ
Dialogue: 0,0:07:46.30,0:07:49.58,Caption,,0,0,0,,НЕ В ОДНОМ ЭПИЗОДЕ, А СРАЗУ В НЕСКОЛЬКИХ НАПРАВЛЕНИЯХ?
Dialogue: 0,0:07:49.87,0:07:52.78,Caption,,0,0,0,,ИЗДАНИЕ SOUTH CHINA MORNING POST СООБЩАЕТ О
Dialogue: 0,0:07:52.78,0:07:55.18,Caption,,0,0,0,,ВОЗМОЖНОМ ОБСУЖДЕНИИ ПРАВИЛ ПРИМЕНЕНИЯ
Dialogue: 0,0:07:55.18,0:07:57.66,Caption,,0,0,0,,ИСКУССТВЕННОГО ИНТЕЛЛЕКТА В ЯДЕРНЫХ СИСТЕМАХ.
Dialogue: 0,0:07:58.06,0:08:00.46,Caption,,0,0,0,,УЧАСТНИКАМИ ТАКОГО РАЗГОВОРА НАЗЫВАЮТСЯ ЛИДЕРЫ
Dialogue: 0,0:08:00.46,0:08:04.46,Caption,,0,0,0,,РОССИИ, СОЕДИНЁННЫХ ШТАТОВ И КИТАЯ. СОСТАВ УЧАСТНИКОВ
Dialogue: 0,0:08:04.46,0:08:07.90,Caption,,0,0,0,,ГОВОРИТ ГРОМЧЕ ЛЮБОГО ПРЕСС РЕЛИЗА. ТРИ КРУПНЕЙШИЕ
Dialogue: 0,0:08:07.90,0:08:12.78,Caption,,0,0,0,,ЯДЕРНЫЕ ДЕРЖАВЫ ИЩУТ ТЕМУ, ПО КОТОРОЙ МОЖНО ДОГОВАРИВАТЬСЯ НАПРЯМУЮ. УКРАИНСКИЙ
Dialogue: 0,0:08:12.78,0:08:15.98,Caption,,0,0,0,,КОНФЛИКТ ПЕРЕСТАЁТ ЗАНИМАТЬ ВЕСЬ СТОЛ. КОРЕЙСКАЯ
Dialogue: 0,0:08:15.98,0:08:19.26,Caption,,0,0,0,,ПРОБЛЕМА ТОЖЕ НЕ ЗАБИРАЕТ ПОВЕСТКУ ЦЕЛИКОМ. В ЦЕНТРЕ
Dialogue: 0,0:08:19.26,0:08:23.34,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ ВОПРОС, ЗАТРАГИВАЮЩИЙ СТРАТЕГИЧЕСКУЮ УСТОЙЧИВОСТЬ ВСЕЙ
Dialogue: 0,0:08:23.34,0:08:28.14,Caption,,0,0,0,,ПЛАНЕТЫ. ЭТО УЖЕ УРОВЕНЬ, НА КОТОРОМ ЕЖЕДНЕВНЫЕ ЗАГОЛОВКИ ВЫГЛЯДЯТ МЕЛКОЙ
Dialogue: 0,0:08:28.22,0:08:31.82,Caption,,0,0,0,,БЕГУЩЕЙ СТРОКОЙ. УКРАИНА МОЖЕТ ОСТАВАТЬСЯ ГЛАВНОЙ ТЕМОЙ
Dialogue: 0,0:08:31.82,0:08:34.22,Caption,,0,0,0,,ТЕЛЕВИЗИОННОГО ВЕЧЕРА, НО ДЛЯ МОСКВЫ,
Dialogue: 0,0:08:34.38,0:08:37.74,Caption,,0,0,0,,ВАШИНГТОНА И ПЕКИНА ОНА СТАНОВИТСЯ ОДНИМ ИЗ УЗЛОВ
Dialogue: 0,0:08:37.80,0:08:43.31,Caption,,0,0,0,,В ДЛИННОМ ПЕРЕЧНЕ ЗАДАЧ. ЕГО НЕОБХОДИМО РАЗВЯЗАТЬ,
Dialogue: 0,0:08:43.54,0:08:46.19,Caption,,0,0,0,,ЧТОБЫ ПЕРЕЙТИ К СЛЕДУЮЩИМ ДОГОВОРЁННОСТЯМ. ТАК И
Dialogue: 0,0:08:46.19,0:08:49.39,Caption,,0,0,0,,ВОЗНИКАЕТ ЯЛТА ДВА НОЛЬ. НЕ ОБЯЗАТЕЛЬНО ДОСТАВАТЬ
Dialogue: 0,0:08:49.39,0:08:52.19,Caption,,0,0,0,,КАРТУ И ДЕЛИТЬ ЕЁ ЦВЕТНЫМИ КАРАНДАШАМИ. МЕХАНИЗМ
Dialogue: 0,0:08:52.27,0:08:55.71,Caption,,0,0,0,,КУДА ПРОЩЕ. ЕСЛИ ТРИ СИЛЬНЕЙШИХ ИГРОКА ПОНИМАЮТ,
Dialogue: 0,0:08:56.02,0:08:58.43,Caption,,0,0,0,,ЧТО СОГЛАШЕНИЕ ПРИНОСИТ ИМ БОЛЬШЕ ПОЛЬЗЫ,
Dialogue: 0,0:08:58.67,0:09:03.31,Caption,,0,0,0,,ЧЕМ БЕСКОНЕЧНАЯ ДРАКА, РАЗРЕШЕНИЯ У ЗРИТЕЛЬНОГО ЗАЛА ОНИ НЕ СПРАШИВАЮТ. НА
Dialogue: 0,0:09:03.31,0:09:06.35,Caption,,0,0,0,,ВОЗМУЩЕНИЕ ОСТАЛЬНЫХ ИМ БУДЕТ НАЧИХАТЬ. ОНИ ПОДПИШУТ
Dialogue: 0,0:09:06.35,0:09:09.79,Caption,,0,0,0,,НУЖНОЕ И ЗАЙМУТСЯ СЛЕДУЮЩИМ ПУНКТОМ. ДЛЯ ЕВРОПЫ ЭТО
Dialogue: 0,0:09:09.87,0:09:12.83,Caption,,0,0,0,,ОЗНАЧАЕТ ПЕРЕХОД К ОЧЕНЬ НЕПРИЯТНОЙ АРИФМЕТИКЕ. ПОКА
Dialogue: 0,0:09:12.91,0:09:15.55,Caption,,0,0,0,,БЕЗ ТЕБЯ НЕЛЬЗЯ ОБОЙТИСЬ, У ТЕБЯ ЕСТЬ ВЕС.
Dialogue: 0,0:09:16.11,0:09:18.75,Caption,,0,0,0,,КОГДА РЕШЕНИЯ СПОКОЙНО ПРИНИМАЮТ В ТВОЁ ОТСУТСТВИЕ,
Dialogue: 0,0:09:18.99,0:09:21.47,Caption,,0,0,0,,ГРОМКОСТЬ ЗАЯВЛЕНИЙ УЖЕ НИЧЕГО НЕ ПРИБАВЛЯЕТ.
Dialogue: 0,0:09:22.03,0:09:24.59,Caption,,0,0,0,,ДОЛГИЕ ДЕСЯТИЛЕТИЯ ЕВРОПА ОСТАВАЛАСЬ ОГРОМНЫМ
Dialogue: 0,0:09:24.59,0:09:26.83,Caption,,0,0,0,,РЫНКОМ, МОЩНЫМ ПРОМЫШЛЕННЫМ УЗЛОМ,
Dialogue: 0,0:09:26.99,0:09:29.15,Caption,,0,0,0,,ФИНАНСОВЫМ ЦЕНТРОМ И ВЛАДЕЛЬЦЕМ ПЕРЕДОВЫХ
Dialogue: 0,0:09:29.15,0:09:32.11,Caption,,0,0,0,,ТЕХНОЛОГИЙ. ВСЁ ЭТО НЕ ИСЧЕЗЛО ЗА НОЧЬ. ОДНАКО
Dialogue: 0,0:09:32.11,0:09:36.35,Caption,,0,0,0,,ДВИЖЕНИЕ ИДЁТ В СТОРОНУ, ГДЕ ПРЕЖНИЕ ПРЕИМУЩЕСТВА ОДИН ЗА ДРУГИМ СТАНОВЯТСЯ
Dialogue: 0,0:09:36.43,0:09:39.71,Caption,,0,0,0,,СЛАБЕЕ. ЭНЕРГИЯ ОБХОДИТСЯ ДОРОГО. ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:09:39.71,0:09:42.67,Caption,,0,0,0,,СТАЛКИВАЕТСЯ С БОЛЕЕ ЖЁСТКИМИ КОНКУРЕНТАМИ. КЛЮЧЕВОЕ
Dialogue: 0,0:09:42.67,0:09:46.19,Caption,,0,0,0,,СЫРЬЁ ПРИХОДИТСЯ ВВОЗИТЬ. ВОЕННАЯ ЗАЩИТА МНОГО ЛЕТ
Dialogue: 0,0:09:46.19,0:09:49.39,Caption,,0,0,0,,ЗАВИСЕЛА ОТ УЧАСТИЯ СОЕДИНЁННЫХ ШТАТОВ. ДАЖЕ МЕСТО
Dialogue: 0,0:09:49.47,0:09:51.63,Caption,,0,0,0,,НА ПЕРЕГОВОРАХ ЕВРОПЕЙЦАМ СЕЙЧАС ПОМОГАЕТ
Dialogue: 0,0:09:51.71,0:09:57.11,Caption,,0,0,0,,ОРГАНИЗОВАТЬ ВАШИНГТОН. ОН БУКВАЛЬНО ПРОСИТ ИХ ВЫБРАТЬ ЧЕЛОВЕКА,
Dialogue: 0,0:09:57.43,0:09:59.99,Caption,,0,0,0,,КОТОРОГО МОЖНО ПОСАДИТЬ ЗА СТОЛ БЕЗ ОТДЕЛЬНОГО
Dialogue: 0,0:09:59.99,0:10:03.27,Caption,,0,0,0,,СПРАВОЧНИКА ПО ЕГО ПОЛНОМОЧИЯМ. ПОКА ЭТО ПРИГЛАШЕНИЕ
Dialogue: 0,0:10:03.35,0:10:06.63,Caption,,0,0,0,,ЕЩЁ ДЕЙСТВУЕТ. ЕВРОПА РИСКУЕТ ПРОВАЛИТЬСЯ НИЖЕ ДАЖЕ
Dialogue: 0,0:10:06.71,0:10:09.75,Caption,,0,0,0,,ТАКОГО СТАТУСА. ЕСЛИ КРУПНЕЙШИЕ ДЕРЖАВЫ СМОГУТ
Dialogue: 0,0:10:09.83,0:10:14.15,Caption,,0,0,0,,РЕШАТЬ ВОПРОСЫ БЕЗ НЕЁ, ЗАЧЕМ ИМ ВООБЩЕ УЧИТЫВАТЬ ЕВРОПЕЙСКИЕ ТРЕБОВАНИЯ?
Dialogue: 0,0:10:14.71,0:10:17.91,Caption,,0,0,0,,РЕСУРСОВ ГЛОБАЛЬНОГО ЗНАЧЕНИЯ ПОЧТИ НЕТ. ДОСТУПНОЙ
Dialogue: 0,0:10:17.91,0:10:21.43,Caption,,0,0,0,,ЭНЕРГИИ НЕТ. ЗАВОДЫ ТЕРЯЮТ КОНКУРЕНТОСПОСОБНОСТЬ. ЗА
Dialogue: 0,0:10:21.51,0:10:23.59,Caption,,0,0,0,,ОСНОВНЫМ СТОЛОМ УЖЕ УМЕЮТ ОБХОДИТЬСЯ БЕЗ
Dialogue: 0,0:10:23.59,0:10:28.23,Caption,,0,0,0,,БРЮССЕЛЬСКОГО СТУЛА. ЕВРОСОЮЗ САМ ОТКАЗАЛСЯ ОТ ЧАСТИ ДЕШЁВОЙ ЭНЕРГИИ,
Dialogue: 0,0:10:28.48,0:10:30.71,Caption,,0,0,0,,САМ ПЕРЕКРЫЛ ТОРГОВЫЕ ВОЗМОЖНОСТИ,
Dialogue: 0,0:10:30.95,0:10:34.23,Caption,,0,0,0,,САМ СОКРАТИЛ АТОМНУЮ ГЕНЕРАЦИЮ И САМ ОСЛОЖНИЛ
Dialogue: 0,0:10:34.23,0:10:37.67,Caption,,0,0,0,,ОТНОШЕНИЯ С ВЛАДЕЛЬЦАМИ НЕОБХОДИМЫХ РЕСУРСОВ. ПОСЛЕ
Dialogue: 0,0:10:37.75,0:10:40.23,Caption,,0,0,0,,ЭТОГО ОСТАЁТСЯ СУРОВО ПРЕДЪЯВИТЬ МИРУ ПРАВИЛЬНЫЕ
Dialogue: 0,0:10:40.23,0:10:43.27,Caption,,0,0,0,,ПРИНЦИПЫ. ПРЕКРАСНЫЙ КОЗЫРЬ. МОЖНО ПОЛОЖИТЬ ЕГО В
Dialogue: 0,0:10:43.27,0:10:47.43,Caption,,0,0,0,,ДОМЕННУЮ ПЕЧЬ. ВОЗМОЖНО, ХОТЯ БЫ НЕСКОЛЬКО СЕКУНД БУДЕТ ТЕПЛО.
Dialogue: 0,0:10:48.07,0:10:50.55,Caption,,0,0,0,,ПОЭТОМУ РАССУЖДЕНИЯ КАЛЛАС О САНКЦИЯХ ВЫГЛЯДЯТ
Dialogue: 0,0:10:50.63,0:10:53.59,Caption,,0,0,0,,СЛИШКОМ МЕЛКИМИ ДЛЯ ПРОИСХОДЯЩЕГО. ОНА УВЕРЯЕТ,
Dialogue: 0,0:10:53.83,0:10:56.23,Caption,,0,0,0,,ЧТО РОССИЯ НУЖДАЕТСЯ В ЕВРОПЕЙСКОЙ ОТМЕНЕ
Dialogue: 0,0:10:56.23,0:10:59.19,Caption,,0,0,0,,ОГРАНИЧЕНИЙ. НО ПОСЛЕ КРУПНОГО СОГЛАШЕНИЯ МЕЖДУ
Dialogue: 0,0:10:59.27,0:11:01.83,Caption,,0,0,0,,ГЛАВНЫМИ ДЕРЖАВАМИ САМА ПОСТАНОВКА ВОПРОСА
Dialogue: 0,0:11:01.83,0:11:04.47,Caption,,0,0,0,,ИЗМЕНИТСЯ. САНКЦИИ МОГУТ ОСТАТЬСЯ НА БУМАГЕ.
Dialogue: 0,0:11:06.74,0:11:09.14,Caption,,0,0,0,,ТОЛЬКО СОБЛЮДАТЬ ИХ БУДЕТ ПРЕЖДЕ ВСЕГО ЕВРОПА,
Dialogue: 0,0:11:09.30,0:11:11.70,Caption,,0,0,0,,ОГРАНИЧИВАЯ СОБСТВЕННЫЕ КОМПАНИИ И СОБСТВЕННЫЙ
Dialogue: 0,0:11:11.70,0:11:14.74,Caption,,0,0,0,,ДОСТУП К СДЕЛКАМ. РОССИЯ НАЙДЁТ ПОКУПАТЕЛЕЙ,
Dialogue: 0,0:11:15.02,0:11:18.10,Caption,,0,0,0,,КИТАЙ НАЙДЁТ ПОСТАВЩИКОВ, АМЕРИКА НАЙДЁТ ПРИБЫЛЬ.
Dialogue: 0,0:11:18.91,0:11:21.70,Caption,,0,0,0,,ВНЕШНЕ ЕВРОПЕЙСКАЯ КАРЕТА ПОКА ВЫГЛЯДИТ БОГАТО.
Dialogue: 0,0:11:21.98,0:11:24.58,Caption,,0,0,0,,ПОЗОЛОТА ДЕРЖИТСЯ, ДВЕРИ ЗАКРЫВАЮТСЯ,
Dialogue: 0,0:11:24.82,0:11:28.66,Caption,,0,0,0,,КУЧЕР СОХРАНЯЕТ ВАЖНОЕ ЛИЦО. НО ПОЛНОЧЬ ПРИБЛИЖАЕТСЯ,
Dialogue: 0,0:11:28.90,0:11:31.70,Caption,,0,0,0,,И ГДЕ ТО СНИЗУ УЖЕ ПОДОЗРИТЕЛЬНО ПАХНЕТ ТЫКВОЙ.
Dialogue: 0,0:11:31.99,0:11:36.18,Caption,,0,0,0,,ЕСЛИ РОССИЯ, СОЕДИНЁННЫЕ ШТАТЫ И КИТАЙ ДЕЙСТВИТЕЛЬНО ДОГОВОРЯТСЯ
Dialogue: 0,0:11:36.18,0:11:40.50,Caption,,0,0,0,,ПО ОСНОВНЫМ ВОПРОСАМ, ДВЕСТИ МИЛЛИАРДОВ ЕВРО НЕ СПАСУТ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:11:40.50,0:11:43.06,Caption,,0,0,0,,ВЛИЯНИЕ. МОЖНО СИДЕТЬ НА МЕШКЕ ДЕНЕГ И ВСЁ
Dialogue: 0,0:11:43.14,0:11:44.98,Caption,,0,0,0,,РАВНО НЕ ПОЛУЧИТЬ ПРИГЛАШЕНИЯ ТУДА,
Dialogue: 0,0:11:45.17,0:11:48.02,Caption,,0,0,0,,ГДЕ ОПРЕДЕЛЯЮТ ПРАВИЛА. ПОСЛЕДНИМ В ЭТОЙ ИСТОРИИ
Dialogue: 0,0:11:48.02,0:11:51.14,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ФРИДРИХ МЕРЦ. ПОСЛЕ ВСТРЕЧИ В АБУ ДАБИ
Dialogue: 0,0:11:51.14,0:11:54.10,Caption,,0,0,0,,ГЕРМАНИЯ УЖЕ ДОПУСКАЕТ ПРЯМОЙ РАЗГОВОР КАНЦЛЕРА С
Dialogue: 0,0:11:54.10,0:11:57.06,Caption,,0,0,0,,ВЛАДИМИРОМ ПУТИНЫМ. КАКАЯ УДИВИТЕЛЬНАЯ СКОРОСТЬ
Dialogue: 0,0:11:57.06,0:12:00.26,Caption,,0,0,0,,ОБУЧЕНИЯ. СОВСЕМ НЕДАВНО ЕВРОПЕЙЦАМ РАССКАЗЫВАЛИ,
Dialogue: 0,0:12:00.48,0:12:02.82,Caption,,0,0,0,,ЧТО МОСКВА ПОНИМАЕТ ИСКЛЮЧИТЕЛЬНО СИЛУ,
Dialogue: 0,0:12:03.00,0:12:07.86,Caption,,0,0,0,,ДАВЛЕНИЕ СЛЕДУЕТ НАРАЩИВАТЬ, А ЕДИНЫЙ ФРОНТ ОБЯЗАН СТОЯТЬ ДО ПОБЕДНОГО КОНЦА.
Dialogue: 0,0:12:08.25,0:12:11.94,Caption,,0,0,0,,ТЕПЕРЬ ВЫЯСНИЛОСЬ, ЧТО ТЕЛЕФОННАЯ СВЯЗЬ ВСЁ ТАКИ ВХОДИТ В НАБОР
Dialogue: 0,0:12:12.10,0:12:15.30,Caption,,0,0,0,,ВНЕШНЕПОЛИТИЧЕСКИХ ИНСТРУМЕНТОВ. И ЗВОНИТЬ ПРИДЁТСЯ
Dialogue: 0,0:12:15.38,0:12:19.70,Caption,,0,0,0,,НЕ ПОСЛЕ ИДЕАЛЬНОГО ФИНАЛА, КОГДА ВСЁ СЛОЖИТСЯ РОВНО ПО НЕМЕЦКОМУ ПЛАНУ.
Dialogue: 0,0:12:21.97,0:12:24.05,Caption,,0,0,0,,РАЗГОВОР СТАНОВИТСЯ НЕОБХОДИМ СЕЙЧАС,
Dialogue: 0,0:12:24.29,0:12:26.93,Caption,,0,0,0,,ПОСКОЛЬКУ СОЕДИНЁННЫЕ ШТАТЫ УЖЕ ТОЛКАЮТ ПЕРЕГОВОРЫ
Dialogue: 0,0:12:26.93,0:12:30.37,Caption,,0,0,0,,ДАЛЬШЕ И ЖДАТЬ ЕВРОПЕЙСКОГО ДУШЕВНОГО РАВНОВЕСИЯ НЕ
Dialogue: 0,0:12:30.37,0:12:34.37,Caption,,0,0,0,,НАМЕРЕНЫ. МЕРЦ ОДНИМ ВОЗМОЖНЫМ ЗВОНКОМ ОБЪЯСНЯЕТ СИТУАЦИЮ
Dialogue: 0,0:12:34.37,0:12:37.89,Caption,,0,0,0,,ЛУЧШЕ ДЕСЯТКА РЕЧЕЙ. МОЖНО ДОЛГО УВЕРЯТЬ ПУБЛИКУ,
Dialogue: 0,0:12:38.05,0:12:40.45,Caption,,0,0,0,,ЧТО НИ ОДНОГО РЕШЕНИЯ БЕЗ ЕВРОПЫ НЕ ПРИМУТ.
Dialogue: 0,0:12:40.85,0:12:43.25,Caption,,0,0,0,,НО СТОИТ ДРУГИМ НАЧАТЬ ДОГОВАРИВАТЬСЯ БЕЗ НЕЁ,
Dialogue: 0,0:12:43.64,0:12:45.81,Caption,,0,0,0,,И АППАРАТ ВНЕЗАПНО ОКАЗЫВАЕТСЯ ПОД РУКОЙ.
Dialogue: 0,0:12:46.03,0:12:47.97,Caption,,0,0,0,,ПРИНЦИПИАЛЬНОСТЬ ОБХОДИТСЯ НЕДОРОГО,
Dialogue: 0,0:12:48.29,0:12:51.41,Caption,,0,0,0,,ПОКА ВЕСЬ МИР ТЕРПЕЛИВО СТОИТ В ПРИХОЖЕЙ. ГОРАЗДО
Dialogue: 0,0:12:51.41,0:12:53.33,Caption,,0,0,0,,ТРУДНЕЕ СОХРАНЯТЬ ПРЕЖНЮЮ ПОЗУ,
Dialogue: 0,0:12:53.54,0:12:57.41,Caption,,0,0,0,,КОГДА ГОСТИ УЖЕ ВОШЛИ, ЗАКРЫЛИ ДВЕРЬ И НАЧАЛИ СОВЕЩАНИЕ.
