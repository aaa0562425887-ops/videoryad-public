Dialogue: 0,0:00:00.12,0:00:02.44,Caption,,0,0,0,,У МИРНЫХ ПЕРЕГОВОРОВ ОБНАРУЖИЛАСЬ УДИВИТЕЛЬНАЯ
Dialogue: 0,0:00:02.44,0:00:05.40,Caption,,0,0,0,,ОСОБЕННОСТЬ. ОНИ ПРАКТИЧЕСКИ ВСЕГДА ЗАКАНЧИВАЮТСЯ
Dialogue: 0,0:00:05.40,0:00:09.00,Caption,,0,0,0,,УСПЕШНО. УЧАСТНИКИ ДОВОЛЬНЫ, РАЗГОВОР КОНСТРУКТИВНЫЙ,
Dialogue: 0,0:00:09.24,0:00:12.52,Caption,,0,0,0,,ВСЕ ГОТОВЫ ВСТРЕЧАТЬСЯ ДАЛЬШЕ. КРАСОТА. ТОЛЬКО МИР
Dialogue: 0,0:00:12.52,0:00:14.92,Caption,,0,0,0,,ПОЧЕМУ ТО НИКАК НЕ НАСТУПАЕТ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:00:15.00,0:00:17.80,Caption,,0,0,0,,ВОЗНИКАЕТ ВОПРОС. А ЧТО ИМЕННО ОНИ КАЖДЫЙ РАЗ
Dialogue: 0,0:00:17.80,0:00:21.88,Caption,,0,0,0,,СЧИТАЮТ УСПЕХОМ? ЕСЛИ ВАМ ИНТЕРЕСЕН ТАКОЙ РАЗБОР БЕЗ ПЕРЕСКАЗА ПРЕСС
Dialogue: 0,0:00:21.88,0:00:25.40,Caption,,0,0,0,,РЕЛИЗОВ, ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ПЫТАЕМСЯ СМОТРЕТЬ НЕ НА
Dialogue: 0,0:00:25.40,0:00:27.96,Caption,,0,0,0,,КРАСИВЫЕ СЛОВА ПОСЛЕ ВСТРЕЧИ, А НА ТО,
Dialogue: 0,0:00:28.12,0:00:31.32,Caption,,0,0,0,,ЧТО ПОСЛЕ НЕЁ РЕАЛЬНО ИЗМЕНИЛОСЬ. УИТКОФФ ПРИЕХАЛ К
Dialogue: 0,0:00:31.32,0:00:33.80,Caption,,0,0,0,,ПУТИНУ УЖЕ В ДЕСЯТЫЙ РАЗ. ВМЕСТЕ С НИМ
Dialogue: 0,0:00:33.80,0:00:36.52,Caption,,0,0,0,,СНОВА КУШНЕР. ДО МОСКВЫ БЫЛИ ПЕРЕГОВОРЫ В АБУ
Dialogue: 0,0:00:36.52,0:00:39.32,Caption,,0,0,0,,ДАБИ. ПОСЛЕ МОСКВЫ АМЕРИКАНЦЫ ОПЯТЬ ГОВОРЯТ,
Dialogue: 0,0:00:39.48,0:00:41.16,Caption,,0,0,0,,ЧТО РАЗГОВОР ПОЛУЧИЛСЯ ПОЛЕЗНЫМ,
Dialogue: 0,0:00:41.40,0:00:45.64,Caption,,0,0,0,,ЧТО ЕСТЬ ПРОГРЕСС, ЧТО СЛЕДУЮЩИЙ РАУНД УЖЕ ГОТОВЯТ. ВСЁ ВЫГЛЯДИТ БОДРО.
Dialogue: 0,0:00:45.81,0:00:49.40,Caption,,0,0,0,,ТОЛЬКО ЕСЛИ УБРАТЬ УЛЫБКИ, РУКОПОЖАТИЯ И СЛОВА О КОНСТРУКТИВЕ,
Dialogue: 0,0:00:49.67,0:00:52.76,Caption,,0,0,0,,ОСТАЁТСЯ ОДИН ОЧЕНЬ ПРОСТОЙ ВОПРОС. ЧТО СДВИНУЛОСЬ
Dialogue: 0,0:00:52.84,0:00:55.96,Caption,,0,0,0,,ПО ТЕМ ПУНКТАМ, ИЗ ЗА КОТОРЫХ ВООБЩЕ ИДЁТ ЭТА ИСТОРИЯ?
Dialogue: 0,0:00:56.44,0:00:59.32,Caption,,0,0,0,,НАМ СРАЗУ ПОКАЗЫВАЮТ ГУМАНИТАРНЫЙ РЕЗУЛЬТАТ. ОБМЕН
Dialogue: 0,0:00:59.32,0:01:01.48,Caption,,0,0,0,,ПЛЕННЫМИ. И ТУТ НАДО СКАЗАТЬ НОРМАЛЬНО,
Dialogue: 0,0:01:01.64,0:01:05.24,Caption,,0,0,0,,БЕЗ КРИВЛЯНИЯ. ДЛЯ ТЕХ ЛЮДЕЙ, КОТОРЫЕ ВЕРНУТСЯ ДОМОЙ,
Dialogue: 0,0:01:05.45,0:01:10.60,Caption,,0,0,0,,ДЛЯ ИХ СЕМЕЙ, ДЛЯ РОДИТЕЛЕЙ, ЖЁН И ДЕТЕЙ ЭТО ОГРОМНОЕ СОБЫТИЕ. ТАМ НЕТ
Dialogue: 0,0:01:10.68,0:01:16.24,Caption,,0,0,0,,НИЧЕГО МЕЛКОГО. НО В МАСШТАБЕ ПЕРЕГОВОРОВ О ПРЕКРАЩЕНИИ ВОЙНЫ ЭТО
Dialogue: 0,0:01:16.32,0:01:19.36,Caption,,0,0,0,,СОВСЕМ ДРУГОЙ УРОВЕНЬ ЗАДАЧИ. ОБМЕНАМИ ЗАНИМАЛИСЬ И
Dialogue: 0,0:01:19.44,0:01:21.68,Caption,,0,0,0,,РАНЬШЕ. ПО НИМ ДОГОВАРИВАЛИСЬ И ТОГДА,
Dialogue: 0,0:01:21.76,0:01:24.08,Caption,,0,0,0,,КОГДА ПО ВСЕМ ОСТАЛЬНЫМ ВОПРОСАМ СТОРОНЫ СТОЯЛИ
Dialogue: 0,0:01:24.08,0:01:26.80,Caption,,0,0,0,,НАСМЕРТЬ. ДЛЯ ЭТОГО ЕСТЬ ОТДЕЛЬНЫЕ КАНАЛЫ,
Dialogue: 0,0:01:26.92,0:01:31.36,Caption,,0,0,0,,УПОЛНОМОЧЕННЫЕ, ОМБУДСМЕНЫ, РАБОЧИЕ ГРУППЫ. НА ХУДОЙ КОНЕЦ,
Dialogue: 0,0:01:31.52,0:01:33.76,Caption,,0,0,0,,УЖЕ И МЕЛАНИЯ ТРАМП УСПЕЛА ПОУЧАСТВОВАТЬ В
Dialogue: 0,0:01:33.76,0:01:36.72,Caption,,0,0,0,,ГУМАНИТАРНОЙ ТЕМЕ. И ВОТ ТУТ ВОЗНИКАЕТ НЕУДОБНАЯ
Dialogue: 0,0:01:36.72,0:01:39.92,Caption,,0,0,0,,ШТУКА. ЕСЛИ ПОСЛЕ ВСТРЕЧИ ТАКОГО УРОВНЯ ГЛАВНЫМ
Dialogue: 0,0:01:39.92,0:01:42.64,Caption,,0,0,0,,ПРЕДЪЯВЛЯЕМЫМ РЕЗУЛЬТАТОМ СТАНОВИТСЯ ОБМЕН ПЛЕННЫМИ,
Dialogue: 0,0:01:43.04,0:01:46.56,Caption,,0,0,0,,ТО ХОЧЕТСЯ СПРОСИТЬ, А РАДИ ЧЕГО ТОГДА НУЖЕН ВЕСЬ ЭТОТ ТЯЖЁЛЫЙ
Dialogue: 0,0:01:46.56,0:01:49.60,Caption,,0,0,0,,СОСТАВ? ЗАЧЕМ ТУДА ВОЗИТЬ ЛЮДЕЙ ТАКОГО РАНГА,
Dialogue: 0,0:01:49.76,0:01:51.60,Caption,,0,0,0,,ЗАЧЕМ ДЕСЯТАЯ ВСТРЕЧА С ПУТИНЫМ,
Dialogue: 0,0:01:51.76,0:01:53.52,Caption,,0,0,0,,ЕСЛИ НА СТОЛЕ В ИТОГЕ ЛЕЖИТ ТО,
Dialogue: 0,0:01:53.67,0:01:55.76,Caption,,0,0,0,,ЧТО И БЕЗ ЭТОГО РЕГУЛЯРНО СОГЛАСОВЫВАЛИ?
Dialogue: 0,0:01:56.16,0:01:58.88,Caption,,0,0,0,,ОБМЕН ВАЖЕН. НО ВЫДАВАТЬ ЕГО КАК ДОКАЗАТЕЛЬСТВО
Dialogue: 0,0:01:58.96,0:02:02.88,Caption,,0,0,0,,ДВИЖЕНИЯ К МИРУ, ЭТО УЖЕ СОВСЕМ ДРУГАЯ ИСТОРИЯ. ЛЮДИ ЖДУТ ОТВЕТА
Dialogue: 0,0:02:02.88,0:02:07.84,Caption,,0,0,0,,ПО ТЕРРИТОРИЯМ, ПО ВОЙСКАМ, ПО УСЛОВИЯМ ОКОНЧАНИЯ КОНФЛИКТА. А ИМ СНОВА ГОВОРЯТ
Dialogue: 0,0:02:07.84,0:02:10.80,Caption,,0,0,0,,ЗАТО ДОГОВОРИЛИСЬ ОБ ОБМЕНЕ. НУ ОТЛИЧНО. ТОЛЬКО
Dialogue: 0,0:02:10.88,0:02:12.96,Caption,,0,0,0,,ВОЙНА ОТ ЭТОГО НЕ ЗАКОНЧИЛАСЬ. ЕСТЬ ЕЩЁ
Dialogue: 0,0:02:12.96,0:02:15.68,Caption,,0,0,0,,КОНСТАНТИНОВКА. ПУТИН ПРЕДЛОЖИЛ ОРГАНИЗОВАТЬ ТАМ
Dialogue: 0,0:02:15.68,0:02:18.88,Caption,,0,0,0,,ГУМАНИТАРНУЮ МИССИЮ. АМЕРИКАНЦЫ ЭТУ ИДЕЮ ПОДДЕРЖАЛИ.
Dialogue: 0,0:02:19.20,0:02:23.60,Caption,,0,0,0,,НА ПЕРВЫЙ ВЗГЛЯД, ГУМАНИТАРНАЯ ТЕМА И ГУМАНИТАРНАЯ ТЕМА. НО ЗДЕСЬ УЖЕ
Dialogue: 0,0:02:23.68,0:02:29.31,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО САМА ОРГАНИЗАЦИЯ ТАКОЙ МИССИИ НЕИЗБЕЖНО
Dialogue: 0,0:02:29.31,0:02:32.19,Caption,,0,0,0,,УПИРАЕТСЯ В ВОПРОС, КТО КОНТРОЛИРУЕТ ТЕРРИТОРИЮ,
Dialogue: 0,0:02:32.50,0:02:36.35,Caption,,0,0,0,,КТО ОБЕСПЕЧИВАЕТ ДОСТУП, КТО ОТВЕЧАЕТ ЗА БЕЗОПАСНОСТЬ И С КЕМ ВООБЩЕ
Dialogue: 0,0:02:36.35,0:02:39.15,Caption,,0,0,0,,ДОГОВАРИВАЮТСЯ НА МЕСТЕ. ТО ЕСТЬ ДАЖЕ ГУМАНИТАРНЫЙ
Dialogue: 0,0:02:39.23,0:02:41.87,Caption,,0,0,0,,СЮЖЕТ БЫСТРО УПИРАЕТСЯ В ТУ ЖЕ САМУЮ ПРОБЛЕМУ,
Dialogue: 0,0:02:42.19,0:02:45.07,Caption,,0,0,0,,ОТ КОТОРОЙ ВСЕ ПЫТАЮТСЯ УЙТИ КРАСИВЫМИ СЛОВАМИ. А
Dialogue: 0,0:02:45.15,0:02:47.07,Caption,,0,0,0,,ВОТ ПО ТЕРРИТОРИЯМ МОСКВА КАК СТОЯЛА,
Dialogue: 0,0:02:47.28,0:02:52.11,Caption,,0,0,0,,ТАК И СТОИТ. ПУТИН СКАЗАЛ, ЧТО ДЛЯ РОССИИ СУЩЕСТВУЕТ ОДНА ЛИНИЯ РАЗГРАНИЧЕНИЯ,
Dialogue: 0,0:02:52.26,0:02:55.47,Caption,,0,0,0,,ГОСУДАРСТВЕННАЯ ГРАНИЦА. ВОТ И ВСЁ. ВОТ ВАША ЛИНИЯ
Dialogue: 0,0:02:55.47,0:02:58.67,Caption,,0,0,0,,РАЗГРАНИЧЕНИЯ. ПЛЯШЕМ ОТСЮДА. И ЗДЕСЬ НЕ НУЖНО СНОВА
Dialogue: 0,0:02:58.75,0:03:00.27,Caption,,0,0,0,,НА ПОЛТОРЫ СТРАНИЦЫ РАССКАЗЫВАТЬ,
Dialogue: 0,0:03:00.51,0:03:02.59,Caption,,0,0,0,,ЧЕГО РОССИЯ ХОТЕЛА ЧЕТЫРЕ ГОДА НАЗАД,
Dialogue: 0,0:03:02.71,0:03:05.47,Caption,,0,0,0,,ТРИ ГОДА НАЗАД И ВЧЕРА УТРОМ. СЕЙЧАС ВАЖНА
Dialogue: 0,0:03:05.47,0:03:08.27,Caption,,0,0,0,,САМА ФОРМУЛИРОВКА. МОСКВА НЕ ПРЕДЛАГАЕТ ВЗЯТЬ
Dialogue: 0,0:03:08.27,0:03:13.07,Caption,,0,0,0,,НЫНЕШНЮЮ ЛИНИЮ ФРОНТА, ОБВЕСТИ ЕЁ ФЛОМАСТЕРОМ И НАЗВАТЬ КОМПРОМИССОМ. ОНА
Dialogue: 0,0:03:13.07,0:03:17.71,Caption,,0,0,0,,ГОВОРИТ О ГРАНИЦЕ В ТОМ ВИДЕ, В КОТОРОМ САМА ЕЁ ЗАКРЕПИЛА. ДОНЕЦКАЯ,
Dialogue: 0,0:03:17.79,0:03:21.71,Caption,,0,0,0,,ЛУГАНСКАЯ, ЗАПОРОЖСКАЯ И ХЕРСОНСКАЯ ОБЛАСТИ ЗАПИСАНЫ В
Dialogue: 0,0:03:21.71,0:03:24.03,Caption,,0,0,0,,РОССИЙСКОЙ КОНСТИТУЦИИ КАК СУБЪЕКТЫ РОССИЙСКОЙ
Dialogue: 0,0:03:24.03,0:03:27.15,Caption,,0,0,0,,ФЕДЕРАЦИИ. ПРИ ЭТОМ ЛИНИЯ ФРОНТА С ЭТИМИ ГРАНИЦАМИ
Dialogue: 0,0:03:27.15,0:03:30.91,Caption,,0,0,0,,НЕ СОВПАДАЕТ. ЗНАЧИТ, КОГДА КТО ТО ГОВОРИТ ДАВАЙТЕ РЕШИМ ТЕРРИТОРИАЛЬНЫЙ
Dialogue: 0,0:03:30.99,0:03:33.71,Caption,,0,0,0,,ВОПРОС, У СТОРОН УЖЕ НА СТАРТЕ РАЗНЫЕ КАРТЫ НА
Dialogue: 0,0:03:33.71,0:03:37.91,Caption,,0,0,0,,СТОЛЕ. И ВОТ ЭТО КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:03:38.15,0:03:40.63,Caption,,0,0,0,,КОГДА ОДНА КОРОТКАЯ ФРАЗА ГОВОРИТ БОЛЬШЕ,
Dialogue: 0,0:03:40.84,0:03:43.91,Caption,,0,0,0,,ЧЕМ ДЕСЯТЬ ПРЕСС КОНФЕРЕНЦИЙ. ПОТОМУ ЧТО ЕСЛИ МОСКВА
Dialogue: 0,0:03:43.99,0:03:48.07,Caption,,0,0,0,,ГОВОРИТ ГРАНИЦА ВОТ ЗДЕСЬ, ТО ТЕРРИТОРИАЛЬНЫЙ ТОРГ НАЧИНАЕТСЯ НЕ С ЧИСТОГО
Dialogue: 0,0:03:48.07,0:03:50.39,Caption,,0,0,0,,ЛИСТА. ОН НАЧИНАЕТСЯ С ПОЗИЦИИ,
Dialogue: 0,0:03:50.71,0:03:53.51,Caption,,0,0,0,,КОТОРУЮ РОССИЯ УЖЕ ОФОРМИЛА КАК ГОСУДАРСТВЕННУЮ.
Dialogue: 0,0:03:53.83,0:03:58.23,Caption,,0,0,0,,НРАВИТСЯ ЭТО КОМУ ТО ИЛИ НЕТ, НО ОБСУЖДАТЬ ПРИХОДИТСЯ ИМЕННО ОТ ЭТОГО. С
Dialogue: 0,0:03:58.23,0:04:00.95,Caption,,0,0,0,,ИНОСТРАННЫМИ ВОЙСКАМИ ВООБЩЕ ПОЛУЧАЕТСЯ УЖЕ БЕГ ПО
Dialogue: 0,0:04:00.95,0:04:04.23,Caption,,0,0,0,,КРУГУ. МОСКВА СНОВА ГОВОРИТ ИНОСТРАННЫЙ КОНТИНГЕНТ
Dialogue: 0,0:04:04.31,0:04:06.39,Caption,,0,0,0,,НА ТЕРРИТОРИИ УКРАИНЫ ДЛЯ НАС НЕПРИЕМЛЕМ,
Dialogue: 0,0:04:06.70,0:04:09.83,Caption,,0,0,0,,БУДЕМ СЧИТАТЬ ТАКИЕ ВОЙСКА ЗАКОННОЙ ЦЕЛЬЮ. ЕВРОПЕЙЦЫ
Dialogue: 0,0:04:09.91,0:04:13.67,Caption,,0,0,0,,СНОВА ОБСУЖДАЮТ, КАК ЭТИ ВОЙСКА ТУДА ПОСТАВИТЬ В КАЧЕСТВЕ ГАРАНТИИ
Dialogue: 0,0:04:13.67,0:04:16.15,Caption,,0,0,0,,БЕЗОПАСНОСТИ. И ОПЯТЬ ВСЕ ДЕЛАЮТ ВИД,
Dialogue: 0,0:04:16.39,0:04:18.95,Caption,,0,0,0,,БУДТО НАШЛИ КАКОЙ ТО НОВЫЙ ВОПРОС. НУ ХОРОШО.
Dialogue: 0,0:04:19.17,0:04:21.59,Caption,,0,0,0,,ЗАХОДИТЕ. ТОЛЬКО ПОТОМ НЕ НАДО УДИВЛЯТЬСЯ,
Dialogue: 0,0:04:21.74,0:04:26.55,Caption,,0,0,0,,ЧТО ВАМ ЗАРАНЕЕ СКАЗАЛИ, ЧЕМ МОСКВА СЧИТАЕТ ТАКОЕ ПРИСУТСТВИЕ. ТУТ НЕТ НОВОЙ
Dialogue: 0,0:04:26.55,0:04:29.83,Caption,,0,0,0,,ЗАГАДКИ. ЗАГАДКА В ДРУГОМ. ЗАЧЕМ ЭТОТ ПУНКТ РАЗ
Dialogue: 0,0:04:29.83,0:04:31.83,Caption,,0,0,0,,ЗА РАЗОМ ВОЗВРАЩАЮТ НА СТОЛ В ТОМ ЖЕ
Dialogue: 0,0:04:31.91,0:04:34.71,Caption,,0,0,0,,ВИДЕ, ЕСЛИ РОССИЙСКИЙ ОТВЕТ ПО НЕМУ НЕ МЕНЯЕТСЯ?
Dialogue: 0,0:04:35.03,0:04:37.35,Caption,,0,0,0,,И КАК РАЗ ЗДЕСЬ ВСПЛЫВАЕТ ИСТОРИЯ С ПИСЬМОМ
Dialogue: 0,0:04:37.43,0:04:39.59,Caption,,0,0,0,,ПУТИНУ И БАЙДЕНОМ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ
Dialogue: 0,0:04:39.67,0:04:45.23,Caption,,0,0,0,,ГОДУ. РОССИЙСКАЯ ДЕЛЕГАЦИЯ СНОВА ВОЗВРАЩАЕТ РАЗГОВОР ТУДА,
Dialogue: 0,0:04:45.39,0:04:47.15,Caption,,0,0,0,,К ТЕМ ТРЕБОВАНИЯМ БЕЗОПАСНОСТИ,
Dialogue: 0,0:04:47.47,0:04:49.79,Caption,,0,0,0,,КОТОРЫЕ МОСКВА ПОДНИМАЛА ЕЩЁ ДО НАЧАЛА
Dialogue: 0,0:04:49.79,0:04:52.67,Caption,,0,0,0,,ПОЛНОМАСШТАБНЫХ БОЕВЫХ ДЕЙСТВИЙ. ЭТО ИНТЕРЕСНО НЕ
Dialogue: 0,0:04:52.67,0:04:56.11,Caption,,0,0,0,,ПОТОМУ, ЧТО НАМ СРОЧНО ПОНАДОБИЛСЯ ЕЩЁ ОДИН УРОК ИСТОРИИ.
Dialogue: 0,0:04:56.35,0:04:59.95,Caption,,0,0,0,,ИНТЕРЕСНО, ЧТО ЧЕРЕЗ ПЯТЬ ЛЕТ ПЕРЕГОВОРЩИКИ ОПЯТЬ ТАЩАТ НА
Dialogue: 0,0:04:59.95,0:05:02.83,Caption,,0,0,0,,СТОЛ ТОТ ЖЕ УЗЕЛ. ЕСЛИ БЫ НЫНЕШНИЙ РАЗГОВОР
Dialogue: 0,0:05:02.83,0:05:06.75,Caption,,0,0,0,,СВОДИЛСЯ ТОЛЬКО К ТОМУ, ГДЕ ПРОВЕСТИ ЛИНИЮ НА КАРТЕ УКРАИНЫ,
Dialogue: 0,0:05:07.15,0:05:10.03,Caption,,0,0,0,,ПИСЬМО БАЙДЕНУ МОЖНО БЫЛО БЫ ОСТАВИТЬ ИСТОРИКАМ. НО
Dialogue: 0,0:05:10.11,0:05:11.95,Caption,,0,0,0,,ЕГО ВЫТАСКИВАЮТ СЕЙЧАС. ЗНАЧИТ,
Dialogue: 0,0:05:12.32,0:05:14.83,Caption,,0,0,0,,РОССИЙСКАЯ СТОРОНА СНОВА ПРИВЯЗЫВАЕТ НЫНЕШНЕЕ
Dialogue: 0,0:05:14.91,0:05:16.59,Caption,,0,0,0,,СОГЛАШЕНИЕ НЕ ТОЛЬКО К ТЕРРИТОРИИ,
Dialogue: 0,0:05:16.91,0:05:19.87,Caption,,0,0,0,,НО И К БОЛЕЕ ШИРОКОЙ КОНСТРУКЦИИ БЕЗОПАСНОСТИ. И
Dialogue: 0,0:05:19.95,0:05:21.55,Caption,,0,0,0,,ЗДЕСЬ УЖЕ СТАНОВИТСЯ ПОНЯТНЕЕ,
Dialogue: 0,0:05:21.79,0:05:24.67,Caption,,0,0,0,,ПОЧЕМУ ВОПРОС ИНОСТРАННЫХ ВОЙСК ТАК РАЗДРАЖАЕТ
Dialogue: 0,0:05:24.67,0:05:27.71,Caption,,0,0,0,,МОСКВУ. ДЛЯ ОДНОЙ СТОРОНЫ ЭТО ГАРАНТИЯ ПОСЛЕ ВОЙНЫ.
Dialogue: 0,0:05:28.03,0:05:32.43,Caption,,0,0,0,,ДЛЯ ДРУГОЙ ЭТО РОВНО ТО, ПРОТИВ ЧЕГО ОНА И ВЫСТУПАЛА ДО ВОЙНЫ. ПРИ
Dialogue: 0,0:05:32.51,0:05:36.51,Caption,,0,0,0,,ЭТОМ АМЕРИКАНЦЫ ГОВОРЯТ, ЧТО ЕВРОПЕЙЦЕВ СОБИРАЮТСЯ ПОДКЛЮЧАТЬ К СЛЕДУЮЩЕМУ
Dialogue: 0,0:05:36.51,0:05:39.63,Caption,,0,0,0,,РАУНДУ. ХОРОШО. ПОДКЛЮЧАЙТЕ. ТОЛЬКО ВОЗНИКАЕТ
Dialogue: 0,0:05:39.71,0:05:41.23,Caption,,0,0,0,,ПРОСТОЙ ВОПРОС С ЧЕМ ОНИ ПРИДУТ?
Dialogue: 0,0:05:41.62,0:05:44.51,Caption,,0,0,0,,ЕСЛИ ОДИН ИЗ ГЛАВНЫХ ЕВРОПЕЙСКИХ ВАРИАНТОВ ГАРАНТИИ
Dialogue: 0,0:05:44.59,0:05:47.55,Caption,,0,0,0,,ЭТО ИНОСТРАННЫЕ ВОЙСКА, А МОСКВА ЗАРАНЕЕ ГОВОРИТ,
Dialogue: 0,0:05:47.79,0:05:49.63,Caption,,0,0,0,,ЧТО ЭТОТ ВАРИАНТ ДЛЯ НЕЁ НЕПРИЕМЛЕМ,
Dialogue: 0,0:05:49.95,0:05:52.91,Caption,,0,0,0,,ТО САМО ПОЯВЛЕНИЕ ЕЩЁ НЕСКОЛЬКИХ КРЕСЕЛ ЗА СТОЛОМ
Dialogue: 0,0:05:52.91,0:05:55.31,Caption,,0,0,0,,ПРОБЛЕМУ НЕ РЕШИТ. СТУЛЬЕВ СТАНЕТ БОЛЬШЕ.
Dialogue: 0,0:05:57.58,0:06:00.22,Caption,,0,0,0,,ЛЮДЕЙ СТАНЕТ БОЛЬШЕ. ПЕРЕВОДЧИКАМ РАБОТЫ СТАНЕТ
Dialogue: 0,0:06:00.30,0:06:02.94,Caption,,0,0,0,,БОЛЬШЕ. А ТОЧКА СТОЛКНОВЕНИЯ ОСТАНЕТСЯ ТАМ ЖЕ.
Dialogue: 0,0:06:03.26,0:06:05.90,Caption,,0,0,0,,КСТАТИ, ЕСЛИ ВАМ НРАВИТСЯ ИМЕННО ТАКОЙ РАЗБОР,
Dialogue: 0,0:06:06.21,0:06:08.14,Caption,,0,0,0,,ГДЕ СЧИТАЕМ НЕ КОЛИЧЕСТВО УЧАСТНИКОВ,
Dialogue: 0,0:06:08.22,0:06:12.54,Caption,,0,0,0,,А РЕАЛЬНЫЕ ПРОТИВОРЕЧИЯ, ПОДПИШИТЕСЬ. ДАЛЬШЕ КАК РАЗ НАЧИНАЕТСЯ САМАЯ
Dialogue: 0,0:06:12.54,0:06:15.50,Caption,,0,0,0,,ЛЮБОПЫТНАЯ ЧАСТЬ. ПОТОМУ ЧТО НА ЭТОМ ФОНЕ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:06:15.50,0:06:17.82,Caption,,0,0,0,,ИСТОРИЯ СО СТАРШИЛД. ЗЕЛЕНСКИЙ ГОВОРИТ,
Dialogue: 0,0:06:18.03,0:06:20.86,Caption,,0,0,0,,ЧТО СКОРОСТЬ ВОЕННОЙ СПУТНИКОВОЙ СВЯЗИ ОГРАНИЧИЛИ И
Dialogue: 0,0:06:20.94,0:06:23.42,Caption,,0,0,0,,ЭТО МЕШАЕТ УКРАИНСКИМ БЕСПИЛОТНИКАМ ПЕРЕХВАТЫВАТЬ
Dialogue: 0,0:06:23.50,0:06:26.22,Caption,,0,0,0,,РОССИЙСКИЕ РЕАКТИВНЫЕ ДРОНЫ. КОМПАНИЯ СО СВОЕЙ
Dialogue: 0,0:06:26.30,0:06:29.98,Caption,,0,0,0,,СТОРОНЫ ОТРИЦАЕТ, ЧТО МЕНЯЛА УСЛОВИЯ РАБОТЫ. И ЗДЕСЬ НЕ НУЖНО
Dialogue: 0,0:06:29.98,0:06:32.46,Caption,,0,0,0,,ИЗОБРАЖАТЬ ИЗ СЕБЯ ИНЖЕНЕРОВ СПУТНИКОВОЙ СВЯЗИ.
Dialogue: 0,0:06:32.86,0:06:35.98,Caption,,0,0,0,,ВАЖНЕЕ ДРУГОЕ. СТАРЛИНК И СТАРШИЛД ДЛЯ УКРАИНСКОЙ
Dialogue: 0,0:06:35.98,0:06:38.46,Caption,,0,0,0,,АРМИИ ДАВНО УЖЕ НЕ ПРОСТО УДОБНЫЙ ИНТЕРНЕТ В
Dialogue: 0,0:06:38.54,0:06:41.82,Caption,,0,0,0,,ПОЛЕ. СВЯЗЬ, УПРАВЛЕНИЕ, БЕСПИЛОТНИКИ,
Dialogue: 0,0:06:42.06,0:06:46.38,Caption,,0,0,0,,ПЕРЕДАЧА ДАННЫХ, ВСЯ ЭТА ОГРОМНАЯ ВОЕННАЯ МАШИНА СИЛЬНО ЗАВИСИТ ОТ
Dialogue: 0,0:06:46.38,0:06:49.34,Caption,,0,0,0,,АМЕРИКАНСКОЙ СПУТНИКОВОЙ ИНФРАСТРУКТУРЫ. А ЗНАЧИТ,
Dialogue: 0,0:06:49.58,0:06:51.66,Caption,,0,0,0,,САМА ВОЗМОЖНОСТЬ ЧТО ТО ОГРАНИЧИТЬ,
Dialogue: 0,0:06:51.74,0:06:55.90,Caption,,0,0,0,,ЗАМЕДЛИТЬ, ИЗМЕНИТЬ УСЛОВИЯ ДОСТУПА УЖЕ ПРЕВРАЩАЕТСЯ В РЫЧАГ.
Dialogue: 0,0:06:56.37,0:06:58.54,Caption,,0,0,0,,НЕ ОБЯЗАТЕЛЬНО ДАЖЕ НАЖИМАТЬ НА НЕГО ДО КОНЦА.
Dialogue: 0,0:06:58.86,0:07:01.26,Caption,,0,0,0,,ИНОГДА ДОСТАТОЧНО, ЧТОБЫ ВСЕ ПОНИМАЛИ,
Dialogue: 0,0:07:01.41,0:07:03.90,Caption,,0,0,0,,ГДЕ НАХОДИТСЯ КНОПКА. НО И КИЕВ ЗДЕСЬ НЕ
Dialogue: 0,0:07:03.90,0:07:07.02,Caption,,0,0,0,,БЕЗОРУЖЕН. ЗЕЛЕНСКИЙ ВЫНОСИТ ЭТУ ИСТОРИЮ НАРУЖУ И
Dialogue: 0,0:07:07.10,0:07:08.62,Caption,,0,0,0,,ГОВОРИТ УЖЕ НЕ ТОЛЬКО О ТЕХНИКЕ.
Dialogue: 0,0:07:10.90,0:07:12.74,Caption,,0,0,0,,ОН СВЯЗЫВАЕТ ОГРАНИЧЕНИЯ С ТЕМ,
Dialogue: 0,0:07:13.06,0:07:15.62,Caption,,0,0,0,,ЧТО КТО ТО В США ФАКТИЧЕСКИ РАССМАТРИВАЕТ ЧАСТЬ
Dialogue: 0,0:07:15.70,0:07:18.82,Caption,,0,0,0,,УКРАИНСКОЙ ТЕРРИТОРИИ КАК НЕ УКРАИНСКУЮ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:07:18.90,0:07:21.70,Caption,,0,0,0,,НЕ РАЗГОВОР ИНЖЕНЕРОВ. ЭТО ПОЛИТИЧЕСКАЯ ГРАНАТА,
Dialogue: 0,0:07:21.94,0:07:24.98,Caption,,0,0,0,,АККУРАТНО ЗАНЕСЁННАЯ ОБРАТНО В ВАШИНГТОН. ПОТОМУ ЧТО
Dialogue: 0,0:07:25.06,0:07:28.02,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ АМЕРИКАНСКАЯ КУХНЯ. ЕСЛИ ТЕМА
Dialogue: 0,0:07:28.02,0:07:31.78,Caption,,0,0,0,,РАЗГОНЯЕТСЯ, ДЕМОКРАТЫ ПОЛУЧАЮТ ПОВОД СПРАШИВАТЬ АДМИНИСТРАЦИЮ
Dialogue: 0,0:07:31.78,0:07:33.94,Caption,,0,0,0,,ТРАМПА, КТО ОГРАНИЧИВАЛ СВЯЗЬ,
Dialogue: 0,0:07:34.10,0:07:37.22,Caption,,0,0,0,,ЗАЧЕМ, НА КАКОМ ОСНОВАНИИ И НЕ ДАВЯТ ЛИ ТАКИМ
Dialogue: 0,0:07:37.30,0:07:39.70,Caption,,0,0,0,,ОБРАЗОМ НА УКРАИНУ. НАЧИНАЮТСЯ ЗАПРОСЫ,
Dialogue: 0,0:07:39.79,0:07:44.74,Caption,,0,0,0,,КОМИССИИ, ВЫСТУПЛЕНИЯ, ОБВИНЕНИЯ. И УЖЕ НЕ КИЕВ ОПРАВДЫВАЕТСЯ ПЕРЕД
Dialogue: 0,0:07:44.74,0:07:47.94,Caption,,0,0,0,,ВАШИНГТОНОМ, А ВАШИНГТОНУ ПРИХОДИТСЯ ОБЪЯСНЯТЬ СОБСТВЕННЫЕ
Dialogue: 0,0:07:47.94,0:07:50.90,Caption,,0,0,0,,ДЕЙСТВИЯ У СЕБЯ ДОМА. ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:07:51.13,0:07:53.78,Caption,,0,0,0,,ОДИН РЫЧАГ ДАВЛЕНИЯ ВДРУГ НАЧИНАЕТ РАБОТАТЬ В ОБЕ
Dialogue: 0,0:07:53.78,0:07:56.02,Caption,,0,0,0,,СТОРОНЫ. ПРИЧЁМ ДЛЯ ЭТОГО ДАЖЕ НЕ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:07:56.02,0:08:00.66,Caption,,0,0,0,,СНАЧАЛА УСТАНОВИТЬ, КТО ИМЕННО НАЖАЛ КАКУЮ КНОПКУ. ПОЛИТИЧЕСКАЯ ИСТОРИЯ
Dialogue: 0,0:08:00.66,0:08:02.90,Caption,,0,0,0,,УЖЕ СУЩЕСТВУЕТ. ЗЕЛЕНСКИЙ СКАЗАЛ,
Dialogue: 0,0:08:03.06,0:08:05.78,Caption,,0,0,0,,ЧТО ОГРАНИЧЕНИЯ ЕСТЬ. КОМПАНИЯ СКАЗАЛА,
Dialogue: 0,0:08:05.86,0:08:08.90,Caption,,0,0,0,,ЧТО НИЧЕГО НЕ МЕНЯЛА. ДАЛЬШЕ КАЖДЫЙ АМЕРИКАНСКИЙ
Dialogue: 0,0:08:08.90,0:08:11.06,Caption,,0,0,0,,ЛАГЕРЬ МОЖЕТ ВЗЯТЬ ИЗ ЭТОЙ ИСТОРИИ ТО,
Dialogue: 0,0:08:11.24,0:08:13.86,Caption,,0,0,0,,ЧТО ЕМУ НУЖНО. ДЛЯ ОДНИХ ЭТО ВОПРОС ВОЕННОЙ
Dialogue: 0,0:08:13.86,0:08:16.66,Caption,,0,0,0,,ПОМОЩИ УКРАИНЕ. ДЛЯ ДРУГИХ ВОПРОС ПОЛНОМОЧИЙ
Dialogue: 0,0:08:16.66,0:08:19.94,Caption,,0,0,0,,АДМИНИСТРАЦИИ. ДЛЯ ТРЕТЬИХ ЕЩЁ ОДИН ПОВОД УДАРИТЬ ПО
Dialogue: 0,0:08:19.94,0:08:25.17,Caption,,0,0,0,,ТРАМПУ. И ВОТ МАЛЕНЬКАЯ ТЕХНИЧЕСКАЯ НАСТРОЙКА ВНЕЗАПНО
Dialogue: 0,0:08:25.17,0:08:27.65,Caption,,0,0,0,,СТАНОВИТСЯ ЧАСТЬЮ БОЛЬШОЙ ПОЛИТИЧЕСКОЙ ДРАКИ.
Dialogue: 0,0:08:28.21,0:08:30.85,Caption,,0,0,0,,НА ЭТОМ ФОНЕ СЛОВА ОБ УСПЕШНЫХ ПЕРЕГОВОРАХ НАЧИНАЮТ
Dialogue: 0,0:08:30.85,0:08:33.65,Caption,,0,0,0,,ЗВУЧАТЬ ОСОБЕННО ЗАНЯТНО. ПО ОБМЕНУ ПЛЕННЫМИ
Dialogue: 0,0:08:33.65,0:08:36.21,Caption,,0,0,0,,ДОГОВОРИЛИСЬ. ПО ГУМАНИТАРНОЙ МИССИИ ГОТОВЫ
Dialogue: 0,0:08:36.21,0:08:39.25,Caption,,0,0,0,,ГОВОРИТЬ. СЛЕДУЮЩИЙ РАУНД ГОТОВЯТ. ЕВРОПЕЙЦЕВ
Dialogue: 0,0:08:39.25,0:08:41.89,Caption,,0,0,0,,СОБИРАЮТСЯ ПОДКЛЮЧАТЬ. ВСЁ ЭТО ДВИЖЕНИЕ,
Dialogue: 0,0:08:41.97,0:08:45.09,Caption,,0,0,0,,СПОРУ НЕТ. НО ТЕПЕРЬ СМОТРИМ НА ТЯЖЁЛЫЕ ВОПРОСЫ.
Dialogue: 0,0:08:45.36,0:08:48.21,Caption,,0,0,0,,МОСКВА ГОВОРИТ О ГОСУДАРСТВЕННОЙ ГРАНИЦЕ. МОСКВА НЕ
Dialogue: 0,0:08:48.21,0:08:51.25,Caption,,0,0,0,,ПРИНИМАЕТ ИНОСТРАННЫЕ ВОЙСКА. РОССИЙСКАЯ СТОРОНА
Dialogue: 0,0:08:51.25,0:08:53.49,Caption,,0,0,0,,СНОВА ВОЗВРАЩАЕТ РАЗГОВОР К ТРЕБОВАНИЯМ
Dialogue: 0,0:08:53.49,0:08:57.01,Caption,,0,0,0,,БЕЗОПАСНОСТИ, КОТОРЫЕ ПОДНИМАЛИСЬ ЕЩЁ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ
Dialogue: 0,0:08:57.09,0:08:59.73,Caption,,0,0,0,,ГОДУ. ЗЕЛЕНСКИЙ ТЕМ ВРЕМЕНЕМ УЖЕ ВТЯГИВАЕТ В
Dialogue: 0,0:08:59.73,0:09:02.05,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЙ СПОР АМЕРИКАНСКУЮ СПУТНИКОВУЮ
Dialogue: 0,0:09:02.05,0:09:04.21,Caption,,0,0,0,,СИСТЕМУ И ВНУТРЕННЮЮ БОРЬБУ В США.
Dialogue: 0,0:09:04.77,0:09:07.49,Caption,,0,0,0,,ТАК ГДЕ ИМЕННО ПРОИЗОШЁЛ ТОТ САМЫЙ БОЛЬШОЙ ПРОГРЕСС?
Dialogue: 0,0:09:07.74,0:09:10.53,Caption,,0,0,0,,ВОТ ЭТО СЕЙЧАС ГЛАВНЫЙ ВОПРОС. НЕ ПОТОМУ,
Dialogue: 0,0:09:10.77,0:09:13.49,Caption,,0,0,0,,ЧТО ПЕРЕГОВОРЫ БЕССМЫСЛЕННЫ. РАЗГОВАРИВАТЬ ВСЁ РАВНО
Dialogue: 0,0:09:13.49,0:09:16.61,Caption,,0,0,0,,ПРИДЁТСЯ. И ГУМАНИТАРНЫЕ ДОГОВОРЁННОСТИ НУЖНЫ. И
Dialogue: 0,0:09:16.61,0:09:19.49,Caption,,0,0,0,,ПЛЕННЫХ НАДО ВОЗВРАЩАТЬ. И ЕСЛИ МОЖНО ОРГАНИЗОВАТЬ
Dialogue: 0,0:09:19.49,0:09:21.33,Caption,,0,0,0,,МИССИЮ, КОТОРАЯ ПОМОЖЕТ ЛЮДЯМ,
Dialogue: 0,0:09:21.50,0:09:24.37,Caption,,0,0,0,,ЕЁ НАДО ОРГАНИЗОВЫВАТЬ. НО ВСЁ ЭТО НЕЛЬЗЯ ПУТАТЬ
Dialogue: 0,0:09:24.45,0:09:29.33,Caption,,0,0,0,,С РЕШЕНИЕМ ТЕХ ВОПРОСОВ, ИЗ ЗА КОТОРЫХ ВОЙНА ПРОДОЛЖАЕТСЯ. ДЕСЯТЬ ВСТРЕЧ,
Dialogue: 0,0:09:29.46,0:09:32.21,Caption,,0,0,0,,ЭТО УЖЕ НЕ СЛУЧАЙНЫЙ КОНТАКТ. ЭТО ЦЕЛАЯ СЕРИЯ.
Dialogue: 0,0:09:34.50,0:09:37.22,Caption,,0,0,0,,И ПОСЛЕ ДЕСЯТИ ВСТРЕЧ ХОЧЕТСЯ ВИДЕТЬ НЕ ОЧЕРЕДНОЕ
Dialogue: 0,0:09:37.22,0:09:40.74,Caption,,0,0,0,,ПОДТВЕРЖДЕНИЕ, ЧТО СТОРОНЫ ГОТОВЫ ВСТРЕТИТЬСЯ В ОДИННАДЦАТЫЙ РАЗ.
Dialogue: 0,0:09:41.03,0:09:45.06,Caption,,0,0,0,,ХОЧЕТСЯ УВИДЕТЬ, ГДЕ КТО ТО РЕАЛЬНО ИЗМЕНИЛ ПОЗИЦИЮ ПО ТОМУ,
Dialogue: 0,0:09:45.30,0:09:47.94,Caption,,0,0,0,,ЧТО ЕЩЁ ВЧЕРА НАЗЫВАЛ ПРИНЦИПИАЛЬНЫМ. ПОКА ЭТОГО
Dialogue: 0,0:09:48.02,0:09:51.22,Caption,,0,0,0,,ПУБЛИЧНО НЕ ВИДНО. ВИДНО ДРУГОЕ. АМЕРИКАНЦЫ
Dialogue: 0,0:09:51.22,0:09:54.18,Caption,,0,0,0,,ПРОДОЛЖАЮТ ЕЗДИТЬ. МОСКВА ПРОДОЛЖАЕТ ПОВТОРЯТЬ СВОИ
Dialogue: 0,0:09:54.18,0:09:57.22,Caption,,0,0,0,,УСЛОВИЯ. ЕВРОПА ПЫТАЕТСЯ ЗАЙТИ В СЛЕДУЮЩИЙ РАУНД СО
Dialogue: 0,0:09:57.30,0:10:00.02,Caption,,0,0,0,,СВОИМИ ГАРАНТИЯМИ. КИЕВ ИЩЕТ СПОСОБЫ НЕ ТОЛЬКО
Dialogue: 0,0:10:00.10,0:10:04.50,Caption,,0,0,0,,ОТБИВАТЬСЯ ОТ ДАВЛЕНИЯ, НО И ВОЗВРАЩАТЬ ДАВЛЕНИЕ ОБРАТНО В ВАШИНГТОН. ТАК
Dialogue: 0,0:10:04.58,0:10:06.58,Caption,,0,0,0,,ЧТО СЛЕДУЮЩУЮ ВСТРЕЧУ ЛУЧШЕ ОЦЕНИВАТЬ НЕ ПО
Dialogue: 0,0:10:06.58,0:10:09.70,Caption,,0,0,0,,КОЛИЧЕСТВУ УЛЫБОК И СЛОВУ "ПРОГРЕСС". ТУТ ВСЁ ПРОЩЕ.
Dialogue: 0,0:10:10.08,0:10:12.26,Caption,,0,0,0,,ЕСЛИ ПОСЛЕ НЕЁ ИЗМЕНИТСЯ ХОТЯ БЫ ОДИН ИЗ
Dialogue: 0,0:10:12.26,0:10:14.50,Caption,,0,0,0,,ГЛАВНЫХ ПУНКТОВ, ТОГДА МОЖНО ГОВОРИТЬ,
Dialogue: 0,0:10:14.66,0:10:17.54,Caption,,0,0,0,,ЧТО ПОЕЗД ДЕЙСТВИТЕЛЬНО ТРОНУЛСЯ. А ЕСЛИ СНОВА
Dialogue: 0,0:10:17.54,0:10:21.54,Caption,,0,0,0,,ПОЛУЧИТСЯ ОБМЕН, ХОРОШАЯ ВСТРЕЧА И ОБЕЩАНИЕ ВСТРЕТИТЬСЯ ЕЩЁ РАЗ,
Dialogue: 0,0:10:21.93,0:10:24.34,Caption,,0,0,0,,ТО ЭТО УЖЕ НЕ МИРНЫЙ ПРОЦЕСС. ЭТО АБОНЕМЕНТ.
