Dialogue: 0,0:00:00.12,0:00:01.96,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ СОВА ПО МЕЛОЧАМ НЕ
Dialogue: 0,0:00:01.96,0:00:05.12,Caption,,0,0,0,,РАЗМЕНИВАЕТСЯ. ЕЙ ПОДАВАЙ СРАЗУ БОЛЬШУЮ СТРАТЕГИЮ И
Dialogue: 0,0:00:05.12,0:00:08.47,Caption,,0,0,0,,ТОЧНЫЙ СЕЗОН, КОГДА ХОД ВОЙНЫ ОБЯЗАН ИЗМЕНИТЬСЯ.
Dialogue: 0,0:00:08.47,0:00:11.36,Caption,,0,0,0,,СРОК УЖЕ ОБЪЯВИЛИ. ОСТАЛАСЬ СУЩАЯ МЕЛОЧЬ
Dialogue: 0,0:00:11.36,0:00:14.38,Caption,,0,0,0,,ОБЪЯСНИТЬ, ЧТО ИМЕННО К ЭТОМУ МОМЕНТУ ДОЛЖНО
Dialogue: 0,0:00:14.38,0:00:16.52,Caption,,0,0,0,,СЛОМАТЬСЯ. РОССИЙСКАЯ ЭКОНОМИКА,
Dialogue: 0,0:00:16.68,0:00:19.24,Caption,,0,0,0,,ФРОНТ, ВОЕННОЕ ПРОИЗВОДСТВО ИЛИ ЗАКОНЫ
Dialogue: 0,0:00:19.24,0:00:22.52,Caption,,0,0,0,,ФИЗИКИ? МОЖЕТ, АВТОМАТЫ ПОКРОЮТСЯ РЖАВЧИНОЙ,
Dialogue: 0,0:00:22.74,0:00:25.16,Caption,,0,0,0,,А РАКЕТЫ ВНЕЗАПНО РЕШАТ, ЧТО С НИХ ХВАТИТ?
Dialogue: 0,0:00:25.37,0:00:27.40,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН РАЗРЫВ МЕЖДУ ТЕМ,
Dialogue: 0,0:00:27.57,0:00:29.72,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ ОБЕЩАЮТ С
Dialogue: 0,0:00:29.72,0:00:33.16,Caption,,0,0,0,,ТРИБУН, И ТЕМ, К ЧЕМУ ИХ АРМИИ ГОТОВЯТСЯ НА ЗЕМЛЕ,
Dialogue: 0,0:00:33.31,0:00:35.55,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ДАЛЬШЕ ЭТОТ
Dialogue: 0,0:00:35.55,0:00:38.12,Caption,,0,0,0,,РАЗРЫВ СТАНЕТ РАЗМЕРОМ С АВИАЦИОННЫЙ АНГАР.
Dialogue: 0,0:00:38.70,0:00:43.10,Caption,,0,0,0,,У КАИ КАЛЛАС, КАЖЕТСЯ, ПОЯВИЛСЯ СЕРЬЁЗНЫЙ СОПЕРНИК ПО ЧАСТИ
Dialogue: 0,0:00:43.10,0:00:45.70,Caption,,0,0,0,,ЗАЯВЛЕНИЙ, ПОСЛЕ КОТОРЫХ ВОЕННЫМ ПРИХОДИТСЯ
Dialogue: 0,0:00:45.70,0:00:48.95,Caption,,0,0,0,,НЕРВНО ПРОВЕРЯТЬ ЗАПАСЫ БЕТОНА. МИНИСТР ИНОСТРАННЫХ ДЕЛ
Dialogue: 0,0:00:48.95,0:00:50.84,Caption,,0,0,0,,ПОЛЬШИ РАДОСЛАВ СИКОРСКИЙ СООБЩИЛ,
Dialogue: 0,0:00:51.08,0:00:53.56,Caption,,0,0,0,,ЧТО ЕВРОПА В ДЕСЯТЬ РАЗ БОГАЧЕ РОССИИ,
Dialogue: 0,0:00:53.78,0:00:57.16,Caption,,0,0,0,,ОБОРОННЫЕ РАСХОДЫ РАСТУТ, ПОЛЬША ВЕДЁТ ОСТАЛЬНЫХ ЗА СОБОЙ,
Dialogue: 0,0:00:57.32,0:00:59.22,Caption,,0,0,0,,А РОССИЯ НЕ МОЖЕТ ПОБЕДИТЬ ДАЖЕ НА
Dialogue: 0,0:00:59.22,0:01:03.08,Caption,,0,0,0,,ДОНБАССЕ. СЛЕДОВАТЕЛЬНО, ПРОТИВ НАТО У НЕЁ И ВОВСЕ НЕТ ШАНСОВ.
Dialogue: 0,0:01:03.23,0:01:05.40,Caption,,0,0,0,,НУ ТАК ПОКАЖИТЕ. НАПАДАЙТЕ. ЕСЛИ
Dialogue: 0,0:01:05.40,0:01:07.56,Caption,,0,0,0,,ПРЕВОСХОДСТВО НАСТОЛЬКО БЕССПОРНО,
Dialogue: 0,0:01:07.86,0:01:09.80,Caption,,0,0,0,,ОТКУДА ЭТА ВЕЧНАЯ ОСТОРОЖНОСТЬ ПЕРЕД
Dialogue: 0,0:01:09.80,0:01:15.09,Caption,,0,0,0,,ПРЯМЫМ СТОЛКНОВЕНИЕМ? ПОЧЕМУ УВЕРЕННОСТЬ ЗВУЧИТ ГРОМКО
Dialogue: 0,0:01:15.09,0:01:18.65,Caption,,0,0,0,,ТОЛЬКО ДО ТОЙ СЕКУНДЫ, КОГДА ЗА НЕЁ ПРИХОДИТСЯ ПЛАТИТЬ
Dialogue: 0,0:01:18.65,0:01:20.97,Caption,,0,0,0,,САМОЛЁТАМИ, АЭРОДРОМАМИ И ЛЮДЬМИ?
Dialogue: 0,0:01:21.59,0:01:23.60,Caption,,0,0,0,,БОГАТЫЙ ПРОТИВНИК МОЖЕТ ИМЕТЬ БОЛЬШЕ
Dialogue: 0,0:01:23.60,0:01:26.61,Caption,,0,0,0,,ДЕНЕГ, НО ВОЙНА ВСЁ ЖЕ НЕ БАНКОВСКИЙ КОНКУРС.
Dialogue: 0,0:01:26.61,0:01:29.42,Caption,,0,0,0,,ПОБЕДИТЕЛЮ НЕ ВЫДАЮТ КУБОК ЗА КРАСИВЫЙ БАЛАНС И
Dialogue: 0,0:01:29.42,0:01:32.44,Caption,,0,0,0,,ДОРОГОЙ КОСТЮМ. ЕСТЬ И ДРУГОЙ ВОПРОС. ЧТО
Dialogue: 0,0:01:32.44,0:01:35.05,Caption,,0,0,0,,СИКОРСКИЙ НАЗЫВАЕТ ПОБЕДОЙ НА ДОНБАССЕ?
Dialogue: 0,0:01:35.34,0:01:37.69,Caption,,0,0,0,,ЧТОБЫ ОБЪЯВИТЬ ЧУЖОЙ ЗАМЫСЕЛ ПРОВАЛИВШИМСЯ,
Dialogue: 0,0:01:37.93,0:01:40.31,Caption,,0,0,0,,НЕПЛОХО БЫ СНАЧАЛА ТОЧНО НАЗВАТЬ ЭТОТ
Dialogue: 0,0:01:40.31,0:01:43.72,Caption,,0,0,0,,ЗАМЫСЕЛ. ИНАЧЕ ПОЛУЧАЕТСЯ УДОБНАЯ ИГРА САМ НАЗНАЧИЛ
Dialogue: 0,0:01:43.72,0:01:47.29,Caption,,0,0,0,,ПРОТИВНИКУ ЦЕЛЬ, САМ РЕШИЛ, ЧТО ОН ЕЁ НЕ ДОСТИГ,
Dialogue: 0,0:01:47.45,0:01:49.68,Caption,,0,0,0,,САМ ВСТАЛ НА ПЬЕДЕСТАЛ. МЕДАЛЬ ТОЖЕ
Dialogue: 0,0:01:49.68,0:01:52.49,Caption,,0,0,0,,МОЖНО ПРИНЕСТИ ЗАРАНЕЕ, ЧТОБЫ ДВА РАЗА НЕ ХОДИТЬ.
Dialogue: 0,0:01:53.06,0:01:55.05,Caption,,0,0,0,,СЛЕДОМ ПОЛЬСКИЙ МИНИСТР ПЕРЕЧИСЛИЛ
Dialogue: 0,0:01:55.05,0:01:57.37,Caption,,0,0,0,,ПРЕТЕНЗИИ К РОССИИ. ПО ЕГО ВЕРСИИ,
Dialogue: 0,0:01:57.61,0:02:00.25,Caption,,0,0,0,,НАРУШЕНЫ ВСЕ ДЕСЯТЬ ПРИНЦИПОВ ОБСЕ,
Dialogue: 0,0:02:00.41,0:02:02.57,Caption,,0,0,0,,БУДАПЕШТСКИЙ МЕМОРАНДУМ И ДОГОВОР О
Dialogue: 0,0:02:02.57,0:02:05.21,Caption,,0,0,0,,РОССИЙСКО УКРАИНСКОЙ ГРАНИЦЕ. ПОЧТИ В ТОЙ ЖЕ
Dialogue: 0,0:02:05.21,0:02:08.15,Caption,,0,0,0,,РЕЧИ ВОЗНИКЛО ПРЕДЛОЖЕНИЕ СИЛАМИ НАТО ПЕРЕХВАТЫВАТЬ
Dialogue: 0,0:02:08.15,0:02:10.81,Caption,,0,0,0,,РОССИЙСКИЕ РАКЕТЫ И БЕСПИЛОТНИКИ НАД УКРАИНОЙ.
Dialogue: 0,0:02:11.53,0:02:13.59,Caption,,0,0,0,,БОРИС ДЖОНСОН ПРЕДЛАГАЕТ ОТНОСИТЬСЯ К
Dialogue: 0,0:02:13.59,0:02:15.85,Caption,,0,0,0,,РИСКУ ЕЩЁ СПОКОЙНЕЕ. ЕГО СПРОСИЛИ,
Dialogue: 0,0:02:16.09,0:02:18.07,Caption,,0,0,0,,НЕ ПРЕВРАТИТ ЛИ РАЗМЕЩЕНИЕ ИНОСТРАННЫХ
Dialogue: 0,0:02:18.07,0:02:20.55,Caption,,0,0,0,,ВОЙСК НА УКРАИНЕ НЫНЕШНИЙ КОНФЛИКТ В ГОРЯЧУЮ
Dialogue: 0,0:02:20.55,0:02:23.05,Caption,,0,0,0,,ВОЙНУ РОССИИ И НАТО. ДЖОНСОН ОТВЕТИЛ,
Dialogue: 0,0:02:23.20,0:02:26.86,Caption,,0,0,0,,ЧТО НЕ ПРЕВРАТИТ. АЛЬЯНС,
Dialogue: 0,0:02:26.93,0:02:29.42,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, НЕСРАВНИМО СИЛЬНЕЕ,
Dialogue: 0,0:02:29.73,0:02:32.15,Caption,,0,0,0,,А ВСЯ БЕДА ПОСЛЕДНИХ ПОЧТИ ПЯТИ ЛЕТ
Dialogue: 0,0:02:32.15,0:02:34.59,Caption,,0,0,0,,СОСТОЯЛА В ЧРЕЗМЕРНОМ СТРАХЕ СПРОВОЦИРОВАТЬ
Dialogue: 0,0:02:34.59,0:02:37.66,Caption,,0,0,0,,ВЛАДИМИРА ПУТИНА. ЗВУЧИТ ТАК УСПОКАИВАЮЩЕ,
Dialogue: 0,0:02:37.82,0:02:40.16,Caption,,0,0,0,,ЧТО ХОЧЕТСЯ ЗАВАРИТЬ ЧАЙ И ВЫКЛЮЧИТЬ
Dialogue: 0,0:02:40.16,0:02:42.90,Caption,,0,0,0,,ТРЕВОГУ. ВОТ ТОЛЬКО БРИТАНСКИЕ ВОЕННЫЕ ЧАЙ ПОКА
Dialogue: 0,0:02:42.90,0:02:45.60,Caption,,0,0,0,,ОТЛОЖИЛИ. КОРОЛЕВСКИЕ ВВС НАЧАЛИ УБИРАТЬ
Dialogue: 0,0:02:45.60,0:02:49.05,Caption,,0,0,0,,САМОЛЁТЫ НА НОЧЬ В АНГАРЫ И ЗАЩИЩЁННЫЕ УКРЫТИЯ. ДЛЯ
Dialogue: 0,0:02:49.05,0:02:51.10,Caption,,0,0,0,,МАШИН, КОТОРЫМ КРЫШИ НЕ ДОСТАНЕТСЯ,
Dialogue: 0,0:02:51.42,0:02:53.16,Caption,,0,0,0,,ГОТОВЯТ КЕВЛАРОВЫЕ СЕТИ ПРОТИВ
Dialogue: 0,0:02:53.16,0:02:56.51,Caption,,0,0,0,,БЕСПИЛОТНИКОВ. ОБЪЯСНЕНИЕ ПРЕДЕЛЬНО ЯСНОЕ БРИТАНЦЫ
Dialogue: 0,0:02:56.51,0:03:00.06,Caption,,0,0,0,,УЧИТЫВАЮТ УГРОЗУ РОССИЙСКИХ И ИРАНСКИХ ДРОНОВ. САМОЛЁТ,
Dialogue: 0,0:03:00.16,0:03:03.10,Caption,,0,0,0,,КОНЕЧНО, ВЕЩЬ ДОРОГАЯ, ЕГО ЛУЧШЕ БЕРЕЧЬ.
Dialogue: 0,0:03:03.66,0:03:05.79,Caption,,0,0,0,,НО ТУТ ПОЯВЛЯЕТСЯ НЕЛОВКИЙ ВОПРОС.
Dialogue: 0,0:03:05.79,0:03:07.90,Caption,,0,0,0,,ЕСЛИ ГОРЯЧЕЙ ВОЙНЫ НЕ ОЖИДАЕТСЯ,
Dialogue: 0,0:03:08.14,0:03:10.01,Caption,,0,0,0,,А ПРЕВОСХОДСТВО НАТО НЕ ВЫЗЫВАЕТ
Dialogue: 0,0:03:10.01,0:03:13.33,Caption,,0,0,0,,СОМНЕНИЙ, ПОЧЕМУ АНГАРЫ ВНЕЗАПНО СТАЛИ ТАКИМ
Dialogue: 0,0:03:13.33,0:03:15.98,Caption,,0,0,0,,ЦЕННЫМ ТОВАРОМ? СКОРО ВОЗЛЕ КАЖДОГО,
Dialogue: 0,0:03:16.22,0:03:20.14,Caption,,0,0,0,,ВИДИМО, ПОСТАВЯТ ЧАСОВОГО, КОТОРЫЙ БУДЕТ ЗАБОТЛИВО ПРОВЕРЯТЬ,
Dialogue: 0,0:03:20.38,0:03:22.42,Caption,,0,0,0,,ХОРОШО ЛИ САМОЛЁТ УКРЫТ НА НОЧЬ.
Dialogue: 0,0:03:22.42,0:03:26.29,Caption,,0,0,0,,ГЛАВНОКОМАНДУЮЩИЙ ВВС ХАРВ СМИТ ТРЕБУЕТ РАССРЕДОТОЧИВАТЬ
Dialogue: 0,0:03:26.29,0:03:29.20,Caption,,0,0,0,,АВИАЦИЮ ПО ТЕРРИТОРИИ СТРАНЫ. НЕЛЬЗЯ ОСТАВЛЯТЬ
Dialogue: 0,0:03:29.20,0:03:33.15,Caption,,0,0,0,,НЕСКОЛЬКО МАШИН ТАМ, ГДЕ ИХ СПОСОБЕН УНИЧТОЖИТЬ ОДИН УДАР.
Dialogue: 0,0:03:33.15,0:03:36.75,Caption,,0,0,0,,ОН ПРЯМО ОПИСЫВАЕТ УСЛОВИЯ, ПРИ КОТОРЫХ БЕЗОПАСНОГО МЕСТА НА
Dialogue: 0,0:03:36.75,0:03:40.83,Caption,,0,0,0,,БРИТАНСКОЙ ЗЕМЛЕ НЕ ОСТАЁТСЯ, БОЕВЫЕ ДЕЙСТВИЯ ВЕДУТСЯ С ТЕРРИТОРИИ
Dialogue: 0,0:03:40.83,0:03:44.70,Caption,,0,0,0,,САМОЙ ВЕЛИКОБРИТАНИИ, А САМОЛЁТЫ ПОСТОЯННО МЕНЯЮТ ПЛОЩАДКИ.
Dialogue: 0,0:03:46.97,0:03:48.72,Caption,,0,0,0,,ЭТОТ ВЫВОД БРИТАНЦЫ СДЕЛАЛИ ПО
Dialogue: 0,0:03:48.72,0:03:52.66,Caption,,0,0,0,,УКРАИНСКОМУ ОПЫТУ. РАССРЕДОТОЧЕНИЕ АВИАЦИИ И МОБИЛЬНЫХ
Dialogue: 0,0:03:52.66,0:03:55.24,Caption,,0,0,0,,СРЕДСТВ ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ ПОЗВОЛИЛО
Dialogue: 0,0:03:55.24,0:03:58.17,Caption,,0,0,0,,СОХРАНИТЬ ЧАСТЬ СИЛ В ПЕРВЫЕ ЧАСЫ БОЕВЫХ ДЕЙСТВИЙ.
Dialogue: 0,0:03:58.80,0:04:00.57,Caption,,0,0,0,,ПОКА БЫВШИЙ ПРЕМЬЕР РАССКАЗЫВАЕТ,
Dialogue: 0,0:04:00.72,0:04:03.93,Caption,,0,0,0,,ЧТО ОПАСАТЬСЯ НЕЧЕГО, ДЕЙСТВУЮЩИЙ ГЛАВКОМ ИЗУЧАЕТ,
Dialogue: 0,0:04:04.24,0:04:06.42,Caption,,0,0,0,,КАК НЕ ПОТЕРЯТЬ САМОЛЁТЫ НА СТОЯНКЕ.
Dialogue: 0,0:04:06.42,0:04:09.39,Caption,,0,0,0,,ВЕРОЯТНО, У НИХ ПРОСТО РАЗНЫЕ ПРОГНОЗЫ ПОГОДЫ.
Dialogue: 0,0:04:09.39,0:04:12.51,Caption,,0,0,0,,ОДНИМИ АНГАРАМИ ДЕЛО НЕ ОГРАНИЧИЛОСЬ. МИНИСТЕРСТВО
Dialogue: 0,0:04:12.51,0:04:15.49,Caption,,0,0,0,,ОБОРОНЫ ОТПРАВИЛО ОКОЛО СТА ТЫСЯЧ ПИСЕМ БЫВШИМ
Dialogue: 0,0:04:15.49,0:04:18.96,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИМ. ТАКОГО НЕ ПРОИСХОДИЛО СО ВРЕМЁН ХОЛОДНОЙ
Dialogue: 0,0:04:18.96,0:04:21.45,Caption,,0,0,0,,ВОЙНЫ. РЕЧЬ ИДЁТ О СТРАТЕГИЧЕСКОМ РЕЗЕРВЕ,
Dialogue: 0,0:04:21.61,0:04:24.49,Caption,,0,0,0,,КОТОРЫЙ ПРИ ЧРЕЗВЫЧАЙНЫХ ОБСТОЯТЕЛЬСТВАХ МОЖНО СНОВА
Dialogue: 0,0:04:24.49,0:04:28.45,Caption,,0,0,0,,ПОСТАВИТЬ В СТРОЙ. АДРЕСАТАМ ПРЕДЛАГАЮТ УТОЧНИТЬ ЛИЧНЫЕ
Dialogue: 0,0:04:28.45,0:04:31.23,Caption,,0,0,0,,ДАННЫЕ И ПРИНЯТЬ УЧАСТИЕ В УЧЕНИЯХ. СРЕДИ НИХ
Dialogue: 0,0:04:31.23,0:04:33.88,Caption,,0,0,0,,КРУПНЫЕ МАНЁВРЫ НАТО ВЕСНОЙ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:04:33.88,0:04:37.20,Caption,,0,0,0,,СЕДЬМОГО ГОДА. ОДНОВРЕМЕННО ЛОНДОН НАМЕРЕН ДОВЕСТИ
Dialogue: 0,0:04:37.20,0:04:39.66,Caption,,0,0,0,,АРМИЮ ДО ГОТОВНОСТИ К ВОЗМОЖНОЙ ВОЙНЕ К ДВЕ
Dialogue: 0,0:04:39.66,0:04:42.55,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТОМУ ГОДУ. ПОЛУЧАЕТСЯ ПРЕКРАСНАЯ
Dialogue: 0,0:04:42.55,0:04:45.37,Caption,,0,0,0,,КОМПОЗИЦИЯ. РУКОВОДИТЕЛИ УБЕЖДАЮТ ПУБЛИКУ,
Dialogue: 0,0:04:45.46,0:04:47.64,Caption,,0,0,0,,ЧТО ПРОТИВНИК СЛАБ И ПРЯМОЙ ВОЙНЫ НЕ
Dialogue: 0,0:04:47.64,0:04:50.37,Caption,,0,0,0,,БУДЕТ. АРМИЯ ТЕМ ВРЕМЕНЕМ ИЩЕТ СВОБОДНЫЕ
Dialogue: 0,0:04:50.37,0:04:52.89,Caption,,0,0,0,,АНГАРЫ, ЗАКАЗЫВАЕТ ЗАЩИТНЫЕ СЕТИ,
Dialogue: 0,0:04:53.04,0:04:55.12,Caption,,0,0,0,,РАЗБРАСЫВАЕТ САМОЛЁТЫ ПО СТРАНЕ И
Dialogue: 0,0:04:55.12,0:04:58.48,Caption,,0,0,0,,ВЫЯСНЯЕТ, КУДА ПЕРЕЕХАЛИ СТО ТЫСЯЧ РЕЗЕРВИСТОВ.
Dialogue: 0,0:04:58.48,0:05:03.84,Caption,,0,0,0,,НИКАКОЙ ТРЕВОГИ. ОБЫЧНАЯ БРИТАНСКАЯ ЛЮБОВЬ К ПЕРЕПИСКЕ
Dialogue: 0,0:05:03.84,0:05:06.88,Caption,,0,0,0,,И АККУРАТНОЙ ПАРКОВКЕ АВИАЦИИ. ТЕПЕРЬ ПОСМОТРИМ НА
Dialogue: 0,0:05:06.88,0:05:09.38,Caption,,0,0,0,,ПОЛЬШУ. ВАРШАВА ПРЕДЛОЖИЛА СОЮЗНИКАМ
Dialogue: 0,0:05:09.38,0:05:11.89,Caption,,0,0,0,,ПЕРЕХВАТЫВАТЬ РОССИЙСКИЕ РАКЕТЫ НАД УКРАИНОЙ,
Dialogue: 0,0:05:12.13,0:05:13.92,Caption,,0,0,0,,ЕСЛИ ИХ ТРАЕКТОРИЯ НАПРАВЛЕНА К
Dialogue: 0,0:05:13.92,0:05:17.72,Caption,,0,0,0,,ТЕРРИТОРИИ НАТО. НЕСКОЛЬКО ГОСУДАРСТВ ИДЕЮ ПОДДЕРЖАЛИ.
Dialogue: 0,0:05:17.72,0:05:20.93,Caption,,0,0,0,,ПОВОДОМ СТАЛИ СООБЩЕНИЯ О ТРЁХ КРЫЛАТЫХ РАКЕТАХ,
Dialogue: 0,0:05:21.25,0:05:23.29,Caption,,0,0,0,,КОТОРЫЕ ВОШЛИ В ПОЛЬСКОЕ ВОЗДУШНОЕ
Dialogue: 0,0:05:23.29,0:05:25.97,Caption,,0,0,0,,ПРОСТРАНСТВО И УПАЛИ ВОЗЛЕ НОВОГО ЛИПОВЦА,
Dialogue: 0,0:05:26.13,0:05:30.41,Caption,,0,0,0,,РУДНИКА И МОЛОДИЧА. ПОСЛЕ СРОЧНОГО ЗАСЕДАНИЯ АЛЬЯНС
Dialogue: 0,0:05:30.41,0:05:33.24,Caption,,0,0,0,,НАПРАВИЛ ПОЛЬШЕ САМОЛЁТ ДАЛЬНЕГО РАДИОЛОКАЦИОННОГО
Dialogue: 0,0:05:33.24,0:05:35.80,Caption,,0,0,0,,ОБНАРУЖЕНИЯ АВАКС. ИНИЦИАТИВУ ВЫНЕСЛИ НА
Dialogue: 0,0:05:35.80,0:05:39.26,Caption,,0,0,0,,ОБСУЖДЕНИЕ ПОСЛОВ В БРЮССЕЛЕ. ВСЛЕД ЗА ЭТИМ СИКОРСКИЙ УЖЕ
Dialogue: 0,0:05:39.26,0:05:41.62,Caption,,0,0,0,,ПУБЛИЧНО ПОТРЕБОВАЛ ПЕРЕХВАТЫВАТЬ РОССИЙСКИЕ
Dialogue: 0,0:05:41.62,0:05:43.96,Caption,,0,0,0,,ЦЕЛИ НАД УКРАИНСКОЙ ТЕРРИТОРИЕЙ. НО НАТО
Dialogue: 0,0:05:43.96,0:05:47.59,Caption,,0,0,0,,ОТВЕТИЛО ОТКАЗОМ. ЗАМЕСТИТЕЛЬ МИНИСТРА ОБОРОНЫ ПОЛЬШИ
Dialogue: 0,0:05:47.59,0:05:51.25,Caption,,0,0,0,,ЦЕЗАРИЙ ТОМЧИК ПРИЗНАЛ, ЧТО ПОДДЕРЖКИ У ПРЕДЛОЖЕНИЯ НЕТ.
Dialogue: 0,0:05:51.88,0:05:53.65,Caption,,0,0,0,,ПОДОБНЫЙ ВАРИАНТ СОЮЗНИКИ РАЗБИРАЛИ
Dialogue: 0,0:05:53.65,0:05:56.34,Caption,,0,0,0,,НЕСКОЛЬКИМИ МЕСЯЦАМИ РАНЕЕ И РЕШИЛИ ДАЖЕ НЕ
Dialogue: 0,0:05:56.34,0:05:59.57,Caption,,0,0,0,,ПЕРЕХОДИТЬ К СОЗДАНИЮ ПРОЦЕДУРЫ. ЧТОБЫ ИЗМЕНИТЬ
Dialogue: 0,0:05:59.57,0:06:02.23,Caption,,0,0,0,,ПОЗИЦИЮ, ПОНАДОБИТСЯ СОГЛАСИЕ КАЖДОГО
Dialogue: 0,0:06:02.23,0:06:05.39,Caption,,0,0,0,,ГОСУДАРСТВА АЛЬЯНСА. НА ТРИБУНЕ РОССИЯ НЕ В СОСТОЯНИИ
Dialogue: 0,0:06:05.39,0:06:07.98,Caption,,0,0,0,,СПРАВИТЬСЯ С ДОНБАССОМ. ЗА ЗАКРЫТЫМИ ДВЕРЯМИ
Dialogue: 0,0:06:07.98,0:06:11.32,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ СБИВАТЬ ЕЁ РАКЕТЫ СИЛАМИ НАТО ПОЧЕМУ ТО НЕ
Dialogue: 0,0:06:11.32,0:06:13.17,Caption,,0,0,0,,ВЫЗЫВАЕТ ПРАЗДНИЧНОГО ЭНТУЗИАЗМА.
Dialogue: 0,0:06:15.45,0:06:18.74,Caption,,0,0,0,,ТЕОРИЯ БЫЛА ВЕЛИКОЛЕПНОЙ, ПОКА НИКТО НЕ ПОПРОСИЛ ПРЕВРАТИТЬ ЕЁ В
Dialogue: 0,0:06:18.74,0:06:21.80,Caption,,0,0,0,,ПРИКАЗ ПИЛОТУ. ПОЛЬСКОЕ КОМАНДОВАНИЕ ДЕЙСТВУЕТ
Dialogue: 0,0:06:21.80,0:06:24.32,Caption,,0,0,0,,ОСТОРОЖНЕЕ СОБСТВЕННОГО МИНИСТРА. НА ВОСТОКЕ
Dialogue: 0,0:06:24.32,0:06:27.24,Caption,,0,0,0,,СТРАНЫ ХОТЯТ СОЗДАТЬ ОСОБУЮ ЗОНУ ОГРАНИЧЕНИЯ
Dialogue: 0,0:06:27.24,0:06:30.33,Caption,,0,0,0,,ПОЛЁТОВ В НЕСКОЛЬКИХ ДЕСЯТКАХ КИЛОМЕТРОВ ОТ ГРАНИЦЫ.
Dialogue: 0,0:06:30.89,0:06:32.54,Caption,,0,0,0,,РЕШЕНИЕ ПРЕДПОЛАГАЕТСЯ ПРИНЯТЬ В
Dialogue: 0,0:06:32.54,0:06:35.96,Caption,,0,0,0,,БЛИЖАЙШЕЕ ВРЕМЯ. ВОЕННЫЕ УЖЕ ИСПОЛЬЗУЮТ ПОЛОЖИТЕЛЬНУЮ
Dialogue: 0,0:06:35.96,0:06:39.12,Caption,,0,0,0,,ИДЕНТИФИКАЦИЮ ВОЗДУШНЫХ ЦЕЛЕЙ. ТЕПЕРЬ ЛЁТЧИКУ НЕ
Dialogue: 0,0:06:39.12,0:06:42.04,Caption,,0,0,0,,ВСЕГДА ТРЕБУЕТСЯ УВИДЕТЬ ОБЪЕКТ ГЛАЗАМИ. ЕГО
Dialogue: 0,0:06:42.04,0:06:45.00,Caption,,0,0,0,,ПРИНАДЛЕЖНОСТЬ УСТАНАВЛИВАЮТ ПО РАДИОЛОКАЦИОННЫМ
Dialogue: 0,0:06:45.00,0:06:47.69,Caption,,0,0,0,,ДАННЫМ И ДРУГИМ ПРИЗНАКАМ, А ЗАТЕМ РЕШАЮТ,
Dialogue: 0,0:06:47.85,0:06:52.14,Caption,,0,0,0,,СЛЕДУЕТ ЛИ ПРИМЕНЯТЬ ОРУЖИЕ. ВОТ ТАК И ВЫГЛЯДИТ РАССТОЯНИЕ МЕЖДУ
Dialogue: 0,0:06:52.14,0:06:54.89,Caption,,0,0,0,,БОДРЫМ ЗАЯВЛЕНИЕМ ПОЛИТИКА И ИНСТРУКЦИЕЙ,
Dialogue: 0,0:06:54.97,0:06:56.70,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ КТО ТО ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:06:56.70,0:06:59.21,Caption,,0,0,0,,МОЖЕТ ОТКРЫТЬ ОГОНЬ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:06:59.35,0:07:01.45,Caption,,0,0,0,,ЧЕМУ ВЫ ДОВЕРЯЕТЕ БОЛЬШЕ УВЕРЕННЫМ
Dialogue: 0,0:07:01.45,0:07:04.24,Caption,,0,0,0,,РЕЧАМ ИЛИ ДЕЙСТВИЯМ АРМИЙ ПОСЛЕ ЭТИХ РЕЧЕЙ. И
Dialogue: 0,0:07:04.24,0:07:07.29,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ, ЕСЛИ ЕЩЁ ЭТОГО НЕ СДЕЛАЛИ.
Dialogue: 0,0:07:08.16,0:07:10.47,Caption,,0,0,0,,А НАША СОВА СТРАТЕГ УЖЕ ПРИГОТОВИЛА
Dialogue: 0,0:07:10.47,0:07:15.09,Caption,,0,0,0,,СЛЕДУЮЩУЮ ВЫСОТУ ПОЛЁТА. ПРЕЗИДЕНТ ЛАТВИИ ЭДГАРС РИНКЕВИЧС
Dialogue: 0,0:07:15.09,0:07:18.14,Caption,,0,0,0,,СЧИТАЕТ, ЧТО ПЕРЕЛОМ В ВОЙНЕ ВОЗМОЖЕН ВЕСНОЙ
Dialogue: 0,0:07:18.14,0:07:20.41,Caption,,0,0,0,,ИЛИ ЛЕТОМ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА.
Dialogue: 0,0:07:22.69,0:07:24.84,Caption,,0,0,0,,В ПОЛЬЗУ ТАКОГО ПРОГНОЗА ОН НАЗВАЛ
Dialogue: 0,0:07:24.84,0:07:26.69,Caption,,0,0,0,,УХУДШЕНИЕ РОССИЙСКОЙ ЭКОНОМИКИ,
Dialogue: 0,0:07:26.92,0:07:31.58,Caption,,0,0,0,,РОСТ МЕЖДУНАРОДНОГО ДАВЛЕНИЯ, ПРОДОЛЖЕНИЕ ЕВРОПЕЙСКОЙ ПОМОЩИ УКРАИНЕ
Dialogue: 0,0:07:31.58,0:07:34.93,Caption,,0,0,0,,И УЧАСТИЕ ГОСУДАРСТВ ЗА ПРЕДЕЛАМИ ЕВРОПЫ. СЕЗОН
Dialogue: 0,0:07:34.93,0:07:37.49,Caption,,0,0,0,,УКАЗАН. ТЕПЕРЬ НУЖНА РАБОТАЮЩАЯ СХЕМА.
Dialogue: 0,0:07:38.04,0:07:39.68,Caption,,0,0,0,,ЗА НЕСКОЛЬКО МЕСЯЦЕВ РОССИЙСКАЯ
Dialogue: 0,0:07:39.68,0:07:42.66,Caption,,0,0,0,,ЭКОНОМИКА ДОЛЖНА ЛИШИТЬСЯ ВОЗМОЖНОСТИ ОПЛАЧИВАТЬ БОЕВЫЕ
Dialogue: 0,0:07:42.66,0:07:44.93,Caption,,0,0,0,,ДЕЙСТВИЯ? ОСТАНОВЯТСЯ ПРЕДПРИЯТИЯ?
Dialogue: 0,0:07:45.17,0:07:46.77,Caption,,0,0,0,,ИЗМЕНИТСЯ ПОЛОЖЕНИЕ НА ФРОНТЕ?
Dialogue: 0,0:07:47.07,0:07:48.74,Caption,,0,0,0,,ИСЧЕЗНУТ ЛЮДСКИЕ И МАТЕРИАЛЬНЫЕ
Dialogue: 0,0:07:48.74,0:07:51.98,Caption,,0,0,0,,РЕСУРСЫ? КАКОЙ ИМЕННО ПРОЦЕСС ОБЯЗАН ПРИВЕСТИ К
Dialogue: 0,0:07:51.98,0:07:54.61,Caption,,0,0,0,,ПЕРЕЛОМУ, КРОМЕ НАСТУПЛЕНИЯ ВЕСНЫ ПО КАЛЕНДАРЮ?
Dialogue: 0,0:07:55.39,0:07:59.34,Caption,,0,0,0,,САМ РИНКЕВИЧС ГОВОРИТ, ЧТО УКРАИНЕ ПРЕДСТОИТ КРАЙНЕ ТЯЖЁЛАЯ
Dialogue: 0,0:07:59.34,0:08:01.76,Caption,,0,0,0,,ЗИМА. ОН УПОМИНАЕТ УДАРЫ ПО ЭНЕРГЕТИЧЕСКОЙ
Dialogue: 0,0:08:01.76,0:08:04.64,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ, НЕОБХОДИМОСТЬ ВЫДЕРЖАТЬ ХОЛОДНЫЙ
Dialogue: 0,0:08:04.64,0:08:08.34,Caption,,0,0,0,,ПЕРИОД И СОХРАНИТЬ ВОЕННУЮ И ЭКОНОМИЧЕСКУЮ УСТОЙЧИВОСТЬ.
Dialogue: 0,0:08:08.34,0:08:10.45,Caption,,0,0,0,,ЕВРОПА, УВЕРЯЕТ ЛАТВИЙСКИЙ ПРЕЗИДЕНТ,
Dialogue: 0,0:08:10.76,0:08:14.66,Caption,,0,0,0,,ПРОДОЛЖИТ ПОСТАВЛЯТЬ ОРУЖИЕ, ДЕНЬГИ И ПОМОЩЬ ДЛЯ ВОССТАНОВЛЕНИЯ
Dialogue: 0,0:08:14.66,0:08:18.05,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ. ОДНОВРЕМЕННО РИНКЕВИЧС ПРИЗНАЁТ,
Dialogue: 0,0:08:18.36,0:08:20.45,Caption,,0,0,0,,ЧТО МОСКВА ПОКА НЕ СОВЕРШАЕТ ШАГОВ,
Dialogue: 0,0:08:20.68,0:08:22.77,Caption,,0,0,0,,СПОСОБНЫХ ПРИВЕСТИ В ДЕЙСТВИЕ ПЯТУЮ
Dialogue: 0,0:08:22.77,0:08:25.81,Caption,,0,0,0,,СТАТЬЮ НАТО. РИСКОВАТЬ ОНА, ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:08:25.97,0:08:29.97,Caption,,0,0,0,,ГОТОВА ВСЁ БОЛЬШЕ, НО ГРАНИЦУ ПРЯМОГО НАПАДЕНИЯ НА АЛЬЯНС
Dialogue: 0,0:08:29.97,0:08:32.77,Caption,,0,0,0,,ВСЁ ЕЩЁ НЕ ПЕРЕСЕКАЕТ. ТАК В КАКОМ МЕСТЕ ЭТОЙ
Dialogue: 0,0:08:32.77,0:08:34.93,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТИ СПРЯТАН ОБЕЩАННЫЙ
Dialogue: 0,0:08:34.93,0:08:37.41,Caption,,0,0,0,,ПЕРЕЛОМ? ЕСЛИ МЕХАНИЗМ СУЩЕСТВУЕТ,
Dialogue: 0,0:08:37.56,0:08:43.21,Caption,,0,0,0,,ЕГО СТОИЛО БЫ НАЗВАТЬ. ПОКА СТРАТЕГИЯ ПОХОЖА НА БУДИЛЬНИК,
Dialogue: 0,0:08:43.29,0:08:45.05,Caption,,0,0,0,,ПОСТАВЛЕННЫЙ НА ЛЕТО ПРОЗВЕНИТ,
Dialogue: 0,0:08:45.21,0:08:48.97,Caption,,0,0,0,,А ТАМ РАЗБЕРЁМСЯ. ЗАТЕМ В РАЗГОВОР ВСТУПАЕТ МАРК РЮТТЕ.
Dialogue: 0,0:08:49.73,0:08:51.35,Caption,,0,0,0,,ГЕНЕРАЛЬНЫЙ СЕКРЕТАРЬ НАТО ПЕРЕД
Dialogue: 0,0:08:51.35,0:08:54.04,Caption,,0,0,0,,ВСТРЕЧЕЙ С ДОНАЛЬДОМ ТРАМПОМ В МАР А ЛАГО ЗАЯВИЛ
Dialogue: 0,0:08:54.04,0:08:57.97,Caption,,0,0,0,,В ЭФИРЕ FOX NEWS, ЧТО РОССИЯ НИКОГДА НЕ НАПАДАЛА НИ НА
Dialogue: 0,0:08:57.97,0:09:00.33,Caption,,0,0,0,,ОДНО ГОСУДАРСТВО АЛЬЯНСА. ДА НУ В СМЫСЛЕ?
Dialogue: 0,0:09:00.79,0:09:02.90,Caption,,0,0,0,,КАЯ КАЛЛАС РЕГУЛЯРНО ГОВОРИТ ОБ УГРОЗЕ
Dialogue: 0,0:09:02.90,0:09:04.93,Caption,,0,0,0,,РОССИИ ДЛЯ ЕВРОПЫ. ВЛАДИМИР ЗЕЛЕНСКИЙ
Dialogue: 0,0:09:04.93,0:09:07.44,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ О РАСШИРЕНИИ ВОЙНЫ И РОССИЙСКОЙ
Dialogue: 0,0:09:07.44,0:09:10.33,Caption,,0,0,0,,АГРЕССИИ. ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОБСУЖДАЮТ ДИВЕРСИИ,
Dialogue: 0,0:09:10.51,0:09:13.30,Caption,,0,0,0,,БЕСПИЛОТНИКИ, КИБЕРАТАКИ И ПОДГОТОВКУ К
Dialogue: 0,0:09:13.30,0:09:17.14,Caption,,0,0,0,,СТОЛКНОВЕНИЮ. А ГЛАВА НАТО СПОКОЙНО ПРОИЗНОСИТ НАПАДЕНИЙ НА
Dialogue: 0,0:09:17.14,0:09:19.93,Caption,,0,0,0,,СТРАНЫ АЛЬЯНСА НЕ БЫЛО. ВЫ КАКУЮ ИСТОРИЮ ЧИТАЕТЕ?
Dialogue: 0,0:09:19.93,0:09:23.95,Caption,,0,0,0,,У ВАС ЧТО, РАЗНЫЕ КНИЖКИ? УКРАИНА ДЕЙСТВИТЕЛЬНО НЕ ВХОДИТ В
Dialogue: 0,0:09:23.95,0:09:27.42,Caption,,0,0,0,,НАТО. КИБЕРАТАКА, ПОДОЗРИТЕЛЬНЫЙ БЕСПИЛОТНИК И ПРЯМОЕ
Dialogue: 0,0:09:27.42,0:09:30.73,Caption,,0,0,0,,ВТОРЖЕНИЕ ТОЖЕ НЕ ОДНО И ТО ЖЕ. ИМЕННО ПОЭТОМУ СЛОВА
Dialogue: 0,0:09:30.73,0:09:33.35,Caption,,0,0,0,,РЮТТЕ ТАК ВАЖНЫ. ОН ПРОВОДИТ ЧЁТКУЮ
Dialogue: 0,0:09:33.35,0:09:36.47,Caption,,0,0,0,,ЧЕРТУ ТАМ, ГДЕ ДРУГИЕ ПРЕДПОЧИТАЮТ СМЕШИВАТЬ
Dialogue: 0,0:09:36.47,0:09:39.61,Caption,,0,0,0,,РАЗНЫЕ УРОВНИ УГРОЗЫ, ЧТОБЫ РЕЧЬ ЗВУЧАЛА СТРАШНЕЕ.
Dialogue: 0,0:09:40.37,0:09:42.45,Caption,,0,0,0,,СЛЕДУЮЩАЯ ОСТАНОВКА ЭТОГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:09:42.45,0:09:44.74,Caption,,0,0,0,,ПУТЕШЕСТВИЯ НАХОДИТСЯ В ГЕРМАНИИ. МИНИСТР
Dialogue: 0,0:09:44.74,0:09:47.84,Caption,,0,0,0,,ИНОСТРАННЫХ ДЕЛ ЙОХАНН ВАДЕФУЛЬ ОТВЕТИЛ НА РОССИЙСКОЕ
Dialogue: 0,0:09:47.84,0:09:50.49,Caption,,0,0,0,,ТРЕБОВАНИЕ ВЕРНУТЬСЯ К СИСТЕМЕ БЕЗОПАСНОСТИ,
Dialogue: 0,0:09:50.65,0:09:52.55,Caption,,0,0,0,,СУЩЕСТВОВАВШЕЙ ДО ТЫСЯЧА ДЕВЯТЬСОТ
Dialogue: 0,0:09:52.55,0:09:56.85,Caption,,0,0,0,,ДЕВЯНОСТО СЕДЬМОГО ГОДА. ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:09:57.06,0:09:59.20,Caption,,0,0,0,,ПРИ ТАКОМ ВОЗВРАЩЕНИИ РОССИЯ ДОЛЖНА
Dialogue: 0,0:09:59.20,0:10:02.28,Caption,,0,0,0,,ОТДАТЬ УКРАИНЕ КРЫМ И ВОСТОЧНЫЕ ТЕРРИТОРИИ. САМО
Dialogue: 0,0:10:02.28,0:10:05.62,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ МОСКВЫ ОН НАЗВАЛ НЕСЕРЬЁЗНЫМ. ВАДЕФУЛЬ
Dialogue: 0,0:10:05.62,0:10:07.99,Caption,,0,0,0,,СОСЛАЛСЯ НА ХЕЛЬСИНКСКИЙ АКТ ТЫСЯЧА ДЕВЯТЬСОТ
Dialogue: 0,0:10:07.99,0:10:11.20,Caption,,0,0,0,,СЕМЬДЕСЯТ ПЯТОГО ГОДА, ПАРИЖСКУЮ ХАРТИЮ И БУДАПЕШТСКИЙ
Dialogue: 0,0:10:11.20,0:10:14.61,Caption,,0,0,0,,МЕМОРАНДУМ. ЭТИ СОГЛАШЕНИЯ, УТВЕРЖДАЕТ МИНИСТР,
Dialogue: 0,0:10:14.78,0:10:16.73,Caption,,0,0,0,,УЖЕ СОЗДАЛИ ОСНОВУ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:10:16.73,0:10:19.84,Caption,,0,0,0,,БЕЗОПАСНОСТИ, И РОССИЯ ОБЯЗАНА ЕЁ СОБЛЮДАТЬ.
Dialogue: 0,0:10:19.84,0:10:23.40,Caption,,0,0,0,,СИКОРСКИЙ ДОБАВЛЯЕТ, ЧТО МОСКВА НАРУШИЛА ВСЕ ДЕСЯТЬ
Dialogue: 0,0:10:23.40,0:10:25.89,Caption,,0,0,0,,ПРИНЦИПОВ ОБСЕ. ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:10:26.13,0:10:28.57,Caption,,0,0,0,,ЧТО МОСКВА И ЗАПАДНЫЕ СТОЛИЦЫ ЧИТАЮТ
Dialogue: 0,0:10:28.57,0:10:31.25,Caption,,0,0,0,,ОДИН НАБОР ПРАВИЛ И ПОЛУЧАЮТ РАЗНЫЕ ОТВЕТЫ.
Dialogue: 0,0:10:31.80,0:10:33.92,Caption,,0,0,0,,ЗАПАД СВЯЗЫВАЕТ СУВЕРЕНИТЕТ С ПРАВОМ
Dialogue: 0,0:10:33.92,0:10:37.20,Caption,,0,0,0,,УКРАИНЫ И ГРУЗИИ САМОСТОЯТЕЛЬНО ВЫБИРАТЬ СОЮЗЫ.
Dialogue: 0,0:10:37.20,0:10:40.02,Caption,,0,0,0,,РОССИЯ УКАЗЫВАЕТ НА НЕДЕЛИМОСТЬ БЕЗОПАСНОСТИ
Dialogue: 0,0:10:40.02,0:10:43.22,Caption,,0,0,0,,И ПРОДВИЖЕНИЕ НАТО К СВОИМ ГРАНИЦАМ. ЗАПАД ОБВИНЯЕТ
Dialogue: 0,0:10:43.22,0:10:45.22,Caption,,0,0,0,,МОСКВУ В ПРИМЕНЕНИИ СИЛЫ И НАРУШЕНИИ
Dialogue: 0,0:10:45.22,0:10:48.29,Caption,,0,0,0,,МЕЖДУНАРОДНОГО ПРАВА. МОСКВА ГОВОРИТ О САМООБОРОНЕ,
Dialogue: 0,0:10:48.45,0:10:50.67,Caption,,0,0,0,,ЗАЩИТЕ РУССКОЯЗЫЧНЫХ И РОЛИ ЗАПАДНЫХ
Dialogue: 0,0:10:50.67,0:10:54.67,Caption,,0,0,0,,ГОСУДАРСТВ В ЭСКАЛАЦИИ. В ВОПРОСЕ ГРАНИЦ ПОЗИЦИИ РАСХОДЯТСЯ
Dialogue: 0,0:10:54.67,0:10:57.30,Caption,,0,0,0,,ТАК ЖЕ РЕЗКО. КРЫМ И ЧЕТЫРЕ РЕГИОНА ЗАПАД
Dialogue: 0,0:10:57.30,0:11:01.06,Caption,,0,0,0,,РОССИЙСКИМИ НЕ ПРИЗНАЁТ. МОСКВА ССЫЛАЕТСЯ НА РЕФЕРЕНДУМЫ И
Dialogue: 0,0:11:01.06,0:11:04.25,Caption,,0,0,0,,ПРАВО НАРОДОВ НА САМООПРЕДЕЛЕНИЕ. КАЖДЫЙ ОТКРЫВАЕТ
Dialogue: 0,0:11:04.25,0:11:07.81,Caption,,0,0,0,,НУЖНУЮ СТРАНИЦУ ДОГОВОРА, ЧИТАЕТ ВСЛУХ И УДИВЛЯЕТСЯ,
Dialogue: 0,0:11:07.91,0:11:09.97,Caption,,0,0,0,,ПОЧЕМУ СОБЕСЕДНИК НЕ АПЛОДИРУЕТ.
Dialogue: 0,0:11:12.25,0:11:14.32,Caption,,0,0,0,,СИКОРСКИЙ ПОСЛЕ ЭТОГО ЯЗВИТ РОССИЯ
Dialogue: 0,0:11:14.32,0:11:17.69,Caption,,0,0,0,,НАРУШИЛА ПРЕЖНИЕ ПРАВИЛА, А ТЕПЕРЬ ПРЕДЛАГАЕТ ПОВЕРИТЬ,
Dialogue: 0,0:11:17.77,0:11:20.24,Caption,,0,0,0,,ЧТО СТАНЕТ СОБЛЮДАТЬ НОВЫЕ. НО ЕСЛИ
Dialogue: 0,0:11:20.24,0:11:22.89,Caption,,0,0,0,,ПРЕЖНИЙ ПОРЯДОК ВСЕХ ПОЛНОСТЬЮ УСТРАИВАЛ,
Dialogue: 0,0:11:23.14,0:11:25.48,Caption,,0,0,0,,ПОЧЕМУ ЕВРОПА ДОШЛА ДО СПОРА О НОВОЙ
Dialogue: 0,0:11:25.48,0:11:28.65,Caption,,0,0,0,,СИСТЕМЕ БЕЗОПАСНОСТИ? ЕСЛИ ЖЕ ОН НЕ УСТРАИВАЛ,
Dialogue: 0,0:11:28.83,0:11:30.68,Caption,,0,0,0,,ОДНОЙ ССЫЛКОЙ НА СТАРЫЕ ДОКУМЕНТЫ
Dialogue: 0,0:11:30.68,0:11:32.85,Caption,,0,0,0,,РАЗГОВОР НЕ ЗАКРЫТЬ. ВСЁ РАВНО ПРИДЁТСЯ
Dialogue: 0,0:11:32.85,0:11:36.44,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ О ПРАВИЛАХ, КОТОРЫЕ БУДУТ ИСПОЛНЯТЬСЯ НЕ ТОЛЬКО НА
Dialogue: 0,0:11:36.44,0:11:39.40,Caption,,0,0,0,,ЦЕРЕМОНИИ ПОДПИСАНИЯ. ПРЕМЬЕР МИНИСТР КРИСТЕН
Dialogue: 0,0:11:39.40,0:11:42.41,Caption,,0,0,0,,МИХАЛ ЗАЯВИЛ, ЧТО УКРАИНЕ НЕЛЬЗЯ ИСПОЛЬЗОВАТЬ
Dialogue: 0,0:11:42.41,0:11:44.25,Caption,,0,0,0,,ЭСТОНСКОЕ ВОЗДУШНОЕ ПРОСТРАНСТВО,
Dialogue: 0,0:11:44.50,0:11:46.65,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ ВОДЫ И СУШУ ДЛЯ УДАРОВ
Dialogue: 0,0:11:46.65,0:11:49.21,Caption,,0,0,0,,ПО РОССИИ. ОН ТАКЖЕ ПРЕДУПРЕДИЛ ОБ УГРОЗЕ
Dialogue: 0,0:11:49.21,0:11:52.11,Caption,,0,0,0,,ЗАГРЯЗНЕНИЯ БАЛТИЙСКОГО МОРЯ НЕФТЬЮ В СЛУЧАЕ АТАК
Dialogue: 0,0:11:52.11,0:11:56.32,Caption,,0,0,0,,НА ТАНКЕРЫ. САМОЕ ЗАНЯТНОЕ, ЧТО НЕЗАДОЛГО ДО ЭТОГО МИХАЛ СОВЕТОВАЛ
Dialogue: 0,0:11:56.32,0:11:59.03,Caption,,0,0,0,,ПРИВЫКАТЬ К ГОРЯЩИМ РОССИЙСКИМ КОРАБЛЯМ ВОЗЛЕ
Dialogue: 0,0:11:59.03,0:12:01.48,Caption,,0,0,0,,ЭСТОНИИ. ТОГДА ОБСУЖДАЛИСЬ АТАКИ НА КОРВЕТ
Dialogue: 0,0:12:01.48,0:12:05.24,Caption,,0,0,0,,БАЛТИЙСКОГО ФЛОТА И СУДНО СПАРТА ДВА В ЭКОНОМИЧЕСКОЙ ЗОНЕ
Dialogue: 0,0:12:05.24,0:12:08.12,Caption,,0,0,0,,СТРАНЫ. ЧУЖОЕ СУДНО ГОРИТ ЭФФЕКТНО. СОБСТВЕННОЕ
Dialogue: 0,0:12:08.12,0:12:11.04,Caption,,0,0,0,,ПОБЕРЕЖЬЕ РЯДОМ С ВОЗМОЖНЫМ РАЗЛИВОМ НЕФТИ СРАЗУ
Dialogue: 0,0:12:11.04,0:12:14.81,Caption,,0,0,0,,ВОЗВРАЩАЕТ ЧЕЛОВЕКУ ПРАКТИЧЕСКИЙ СКЛАД УМА. РОССИЙСКИЙ МИД
Dialogue: 0,0:12:14.81,0:12:17.50,Caption,,0,0,0,,ВЫЗВАЛ ЭСТОНСКОГО ДИПЛОМАТА И ПЕРЕДАЛ НОТУ
Dialogue: 0,0:12:17.50,0:12:22.05,Caption,,0,0,0,,ПРОТЕСТА. МОСКВА ВЫСКАЗАЛА ПОДОЗРЕНИЯ В
Dialogue: 0,0:12:22.05,0:12:24.78,Caption,,0,0,0,,ПРЕДОСТАВЛЕНИИ ВОЗДУШНОГО ПРОСТРАНСТВА УКРАИНСКИМ
Dialogue: 0,0:12:24.78,0:12:28.18,Caption,,0,0,0,,БЕСПИЛОТНИКАМ, ОБВИНИЛА ТАЛЛИН В СОЗДАНИИ ПРЕПЯТСТВИЙ
Dialogue: 0,0:12:28.18,0:12:30.06,Caption,,0,0,0,,СУДОХОДСТВУ И ПЕРЕВОЗКЕ ЗЕРНА,
Dialogue: 0,0:12:30.38,0:12:33.10,Caption,,0,0,0,,А ТАКЖЕ ПОДНЯЛА ВОПРОСЫ О РУССКОЯЗЫЧНЫХ ЖИТЕЛЯХ,
Dialogue: 0,0:12:33.34,0:12:35.47,Caption,,0,0,0,,ДАВЛЕНИИ НА ПРАВОСЛАВНУЮ ЦЕРКОВЬ И
Dialogue: 0,0:12:35.47,0:12:37.26,Caption,,0,0,0,,ЗАКРЫТИИ АВТОМОБИЛЬНЫХ ПЕРЕХОДОВ.
Dialogue: 0,0:12:38.18,0:12:39.81,Caption,,0,0,0,,ПОСЛЕ РОССИЙСКОГО ПРЕДУПРЕЖДЕНИЯ
Dialogue: 0,0:12:39.81,0:12:43.64,Caption,,0,0,0,,МИНИСТР ИНОСТРАННЫХ ДЕЛ ЭСТОНИИ МАРГУС ЦАХКНА ОТПРАВИЛСЯ В
Dialogue: 0,0:12:43.64,0:12:46.43,Caption,,0,0,0,,КИЕВ. ПОХОЖИЙ ВОПРОС ВОЗНИК ВОКРУГ НИДЕРЛАНДСКОЙ
Dialogue: 0,0:12:46.43,0:12:49.12,Caption,,0,0,0,,КОМПАНИИ DESTINUS. ЕЁ РАКЕТЫ И БЕСПИЛОТНИКИ
Dialogue: 0,0:12:49.12,0:12:52.50,Caption,,0,0,0,,УПОМИНАЛИСЬ В СООБЩЕНИЯХ ОБ АТАКЕ НА КРЫМСКИЙ МОСТ.
Dialogue: 0,0:12:52.50,0:12:54.28,Caption,,0,0,0,,ЕСЛИ СПЕЦИАЛИСТЫ ЕВРОПЕЙСКОЙ ФИРМЫ
Dialogue: 0,0:12:54.28,0:12:56.54,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ПОМОГАЮТ ПРИМЕНЯТЬ ВООРУЖЕНИЕ,
Dialogue: 0,0:12:57.01,0:12:58.98,Caption,,0,0,0,,ТО ГДЕ ЗАКАНЧИВАЕТСЯ ТЕХНИЧЕСКАЯ
Dialogue: 0,0:12:58.98,0:13:01.72,Caption,,0,0,0,,ПОДДЕРЖКА И НАЧИНАЕТСЯ НЕПОСРЕДСТВЕННОЕ УЧАСТИЕ В
Dialogue: 0,0:13:01.72,0:13:04.89,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЯХ? ФРАНЦУЗСКИЕ ВОЕННОСЛУЖАЩИЕ ОБУЧАЮТ
Dialogue: 0,0:13:04.89,0:13:07.42,Caption,,0,0,0,,УКРАИНСКИХ ВОЕННЫХ И ОБСЛУЖИВАЮТ ПЕРЕДАННУЮ
Dialogue: 0,0:13:07.42,0:13:11.50,Caption,,0,0,0,,ТЕХНИКУ В РАМКАХ МИССИИ ВОЛЯ, КОТОРОЙ РУКОВОДИТ ФРАНЦУЗСКИЙ ГЕНЕРАЛ.
Dialogue: 0,0:13:12.20,0:13:14.75,Caption,,0,0,0,,ЗАМЕСТИТЕЛЯ МИНИСТРА ОБОРОНЫ АЛИС РУФО
Dialogue: 0,0:13:14.75,0:13:17.11,Caption,,0,0,0,,ВЫЗВАЛИ НА ЗАКРЫТЫЕ СЛУШАНИЯ В СЕНАТ.
Dialogue: 0,0:13:17.11,0:13:19.34,Caption,,0,0,0,,ОППОЗИЦИОННЫЕ ПОЛИТИКИ ОПАСАЮТСЯ,
Dialogue: 0,0:13:19.58,0:13:21.84,Caption,,0,0,0,,ЧТО ДАЖЕ ФОРМАЛЬНО НЕБОЕВЫЕ ЗАДАЧИ
Dialogue: 0,0:13:21.84,0:13:24.70,Caption,,0,0,0,,МОГУТ ПРИВЕСТИ ФРАНЦИЮ К ПРЯМОМУ СТОЛКНОВЕНИЮ С
Dialogue: 0,0:13:24.70,0:13:27.66,Caption,,0,0,0,,РОССИЕЙ. АДМИНИСТРАЦИЮ ПРЕЗИДЕНТА ОБВИНЯЮТ В
Dialogue: 0,0:13:27.66,0:13:30.26,Caption,,0,0,0,,ТОМ, ЧТО ПАРЛАМЕНТ ПОЛУЧАЕТ НЕДОСТАТОЧНО
Dialogue: 0,0:13:30.26,0:13:34.97,Caption,,0,0,0,,ИНФОРМАЦИИ. ПРАВИТЕЛЬСТВО ОТВЕЧАЕТ УВЕДОМЛЯТЬ
Dialogue: 0,0:13:34.97,0:13:37.58,Caption,,0,0,0,,ДЕПУТАТОВ ПО ТРИДЦАТЬ ПЯТОЙ СТАТЬЕ КОНСТИТУЦИИ В
Dialogue: 0,0:13:37.58,0:13:41.77,Caption,,0,0,0,,ДАННОМ СЛУЧАЕ НЕ ТРЕБУЕТСЯ. СПОР УЖЕ ДАВНО НЕ СВОДИТСЯ К ВОПРОСУ,
Dialogue: 0,0:13:42.00,0:13:44.05,Caption,,0,0,0,,НАХОДЯТСЯ ЛИ ФРАНЦУЗСКИЕ ВОЕННЫЕ РЯДОМ
Dialogue: 0,0:13:44.05,0:13:47.50,Caption,,0,0,0,,С УКРАИНОЙ. ОНИ ТАМ ЕСТЬ. ГЛАВНАЯ ГРАНИЦА ПРОХОДИТ
Dialogue: 0,0:13:47.50,0:13:51.21,Caption,,0,0,0,,МЕЖДУ ОБУЧЕНИЕМ, ОБСЛУЖИВАНИЕМ ТЕХНИКИ И ДЕЙСТВИЯМИ,
Dialogue: 0,0:13:51.45,0:13:53.26,Caption,,0,0,0,,ПОСЛЕ КОТОРЫХ РОССИЯ МОЖЕТ НАЗВАТЬ
Dialogue: 0,0:13:53.26,0:13:56.58,Caption,,0,0,0,,ФРАНЦУЗСКУЮ СТОРОНУ УЧАСТНИКОМ КОНФЛИКТА. ЛИНИЯ
Dialogue: 0,0:13:56.58,0:13:59.72,Caption,,0,0,0,,ТОНКАЯ, А ЖЕЛАЮЩИХ ПРОВЕРИТЬ ЕЁ САПОГОМ ПОЧЕМУ
Dialogue: 0,0:13:59.72,0:14:02.91,Caption,,0,0,0,,ТО НЕМНОГО. ПОЧТИ ОДНОВРЕМЕННО МИНИСТР ИНОСТРАННЫХ
Dialogue: 0,0:14:02.91,0:14:06.03,Caption,,0,0,0,,ДЕЛ ФРАНЦИИ ЖАН НОЭЛЬ БАРРО ВЫСКАЗАЛСЯ ОБ АТАКАХ
Dialogue: 0,0:14:06.03,0:14:08.73,Caption,,0,0,0,,УКРАИНЫ НА ДВА РОССИЙСКИХ СУДНА ВОЗЛЕ ЛИВИИ.
Dialogue: 0,0:14:09.35,0:14:12.65,Caption,,0,0,0,,ПО ОПУБЛИКОВАННЫМ СВЕДЕНИЯМ, ОДНО СУДНО БЫЛО ПОТОПЛЕНО,
Dialogue: 0,0:14:12.89,0:14:14.98,Caption,,0,0,0,,А КИЕВ ПРИЗНАЛ СВОЮ ОТВЕТСТВЕННОСТЬ.
Dialogue: 0,0:14:14.98,0:14:17.62,Caption,,0,0,0,,ПРИ ЭТОМ МИНИСТР НЕ ВИДИТ ЗДЕСЬ ПРИНЦИПИАЛЬНО
Dialogue: 0,0:14:17.62,0:14:20.33,Caption,,0,0,0,,НОВОЙ СТУПЕНИ ЭСКАЛАЦИИ. ОН УТВЕРЖДАЕТ,
Dialogue: 0,0:14:20.57,0:14:22.86,Caption,,0,0,0,,ЧТО МОСКВА УЖЕ НЕСКОЛЬКО ЛЕТ ОКАЗЫВАЕТ
Dialogue: 0,0:14:22.86,0:14:24.65,Caption,,0,0,0,,ДАВЛЕНИЕ НЕ ТОЛЬКО НА УКРАИНУ,
Dialogue: 0,0:14:24.94,0:14:26.65,Caption,,0,0,0,,НО И НА ЕВРОПЕЙСКИЕ ГОСУДАРСТВА,
Dialogue: 0,0:14:26.81,0:14:28.74,Caption,,0,0,0,,СТАРАЯСЬ РАЗРУШИТЬ ИХ ЕДИНСТВО.
Dialogue: 0,0:14:28.74,0:14:32.09,Caption,,0,0,0,,СИКОРСКИЙ ОБЪЯВЛЯЕТ РОССИЮ НЕСПОСОБНОЙ ПОБЕДИТЬ НА
Dialogue: 0,0:14:32.09,0:14:35.85,Caption,,0,0,0,,ДОНБАССЕ И ТЕМ БОЛЕЕ ОДОЛЕТЬ НАТО. ДЖОНСОН ОБЕЩАЕТ,
Dialogue: 0,0:14:36.09,0:14:38.40,Caption,,0,0,0,,ЧТО ИНОСТРАННЫЙ КОНТИНГЕНТ НА УКРАИНЕ
Dialogue: 0,0:14:38.40,0:14:41.49,Caption,,0,0,0,,НЕ ПРИВЕДЁТ К ГОРЯЧЕЙ ВОЙНЕ. РИНКЕВИЧС НАЗНАЧАЕТ
Dialogue: 0,0:14:41.49,0:14:45.00,Caption,,0,0,0,,ПЕРЕЛОМ НА ВЕСНУ ИЛИ ЛЕТО. ГЕРМАНИЯ ПОДНИМАЕТ СТАРЫЕ
Dialogue: 0,0:14:45.00,0:14:50.16,Caption,,0,0,0,,СОГЛАШЕНИЯ. ФРАНЦИЯ НАЗЫВАЕТ УДАРЫ ПО РОССИЙСКИМ
Dialogue: 0,0:14:50.16,0:14:53.41,Caption,,0,0,0,,СУДАМ У ЛИВИИ САМООБОРОНОЙ УКРАИНЫ. А ЛЮДИ,
Dialogue: 0,0:14:53.57,0:14:55.65,Caption,,0,0,0,,КОТОРЫМ ПРИДЁТСЯ ОТВЕЧАТЬ ЗА ПОСЛЕДСТВИЯ,
Dialogue: 0,0:14:55.81,0:14:58.17,Caption,,0,0,0,,ЗАНЯТЫ СОВСЕМ ДРУГИМ. ОНИ ЗАКРЫВАЮТ
Dialogue: 0,0:14:58.17,0:15:00.69,Caption,,0,0,0,,САМОЛЁТЫ СЕТЯМИ, ИЩУТ РЕЗЕРВИСТОВ,
Dialogue: 0,0:15:00.87,0:15:03.06,Caption,,0,0,0,,МЕНЯЮТ ПРАВИЛА РАСПОЗНАВАНИЯ ВОЗДУШНЫХ
Dialogue: 0,0:15:03.06,0:15:06.05,Caption,,0,0,0,,ЦЕЛЕЙ, ОБСУЖДАЮТ ПЕРЕХВАТ РОССИЙСКИХ РАКЕТ И
