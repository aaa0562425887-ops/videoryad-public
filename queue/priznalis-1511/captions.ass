Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,КАК ДУМАЕТЕ В ЕВРОПЕ ВООБЩЕ КТО НИБУДЬ ЗНАЕТ,
Dialogue: 0,0:00:02.77,0:00:05.64,Caption,,0,0,0,,ЧЕГО ОНИ САМИ ХОТЯТ? КАЛЛАС ГОВОРИТ ОДНО,
Dialogue: 0,0:00:05.80,0:00:08.52,Caption,,0,0,0,,МЕРЦ ДРУГОЕ, ФОН ДЕР ЛЯЙЕН ТРЕТЬЕ,
Dialogue: 0,0:00:08.72,0:00:11.64,Caption,,0,0,0,,КОШТА ВООБЩЕ СО СВОЕЙ ИСТОРИЕЙ. И ВСЕ СОБИРАЮТСЯ
Dialogue: 0,0:00:11.64,0:00:14.12,Caption,,0,0,0,,ОБСУЖДАТЬ БУДУЩЕЕ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:00:14.43,0:00:17.16,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНО. ВЫ ХОТЯ БЫ МЕЖДУ СОБОЙ ДОГОВОРИТЕСЬ,
Dialogue: 0,0:00:17.25,0:00:19.72,Caption,,0,0,0,,С ЧЕМ СОБИРАЕТЕСЬ ТУДА ИДТИ. ПОТОМУ ЧТО,
Dialogue: 0,0:00:19.81,0:00:22.12,Caption,,0,0,0,,ПОКА ОНИ ВЫЯСНЯЮТ, КТО ЗДЕСЬ ГЛАВНЫЙ,
Dialogue: 0,0:00:22.36,0:00:25.32,Caption,,0,0,0,,ПРОИЗОШЛО КОЕ ЧТО ГОРАЗДО ИНТЕРЕСНЕЕ. И ВОТ ТУТ
Dialogue: 0,0:00:25.32,0:00:28.20,Caption,,0,0,0,,ВОЗНИКАЕТ ВОПРОС А ВСЕХ ЛИ ВООБЩЕ СОБИРАЮТСЯ ЖДАТЬ?
Dialogue: 0,0:00:28.82,0:00:32.12,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ, КОГДА МЫ НЕ ПРОСТО ПЕРЕСКАЗЫВАЕМ ЗАЯВЛЕНИЯ,
Dialogue: 0,0:00:32.36,0:00:34.12,Caption,,0,0,0,,А СКЛАДЫВАЕМ ИХ ВМЕСТЕ И СМОТРИМ,
Dialogue: 0,0:00:34.36,0:00:36.20,Caption,,0,0,0,,ЧТО ИЗ ЭТОГО РЕАЛЬНО ПОЛУЧАЕТСЯ,
Dialogue: 0,0:00:36.30,0:00:39.56,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО СЕГОДНЯ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:39.80,0:00:42.76,Caption,,0,0,0,,КОГДА ОТДЕЛЬНЫЕ НОВОСТИ ПО ОДНОЙ ВЫГЛЯДЯТ ОБЫЧНО,
Dialogue: 0,0:00:43.03,0:00:46.04,Caption,,0,0,0,,А ВМЕСТЕ ДАЮТ СОВСЕМ ДРУГУЮ КАРТИНУ. РОССИЯ
Dialogue: 0,0:00:46.04,0:00:48.20,Caption,,0,0,0,,ПРЕДЛАГАЕТ СТРАНАМ НАТО ДОГОВАРИВАТЬСЯ ПО
Dialogue: 0,0:00:48.20,0:00:50.84,Caption,,0,0,0,,ОТДЕЛЬНОСТИ. НЕ ОДИН ОГРОМНЫЙ ДОГОВОР СО ВСЕМ
Dialogue: 0,0:00:50.84,0:00:54.20,Caption,,0,0,0,,АЛЬЯНСОМ, ГДЕ НУЖНО СОБРАТЬ ТРИДЦАТЬ С ЛИШНИМ ГОСУДАРСТВ,
Dialogue: 0,0:00:54.36,0:00:59.16,Caption,,0,0,0,,СОГЛАСОВАТЬ ПОЗИЦИИ, ВЫЧИСТИТЬ ПРОТИВОРЕЧИЯ И ПОТОМ ЕЩЁ ПОЛГОДА СПОРИТЬ О
Dialogue: 0,0:00:59.16,0:01:02.68,Caption,,0,0,0,,ЗАПЯТЫХ. А ДВУСТОРОННИЕ СОГЛАШЕНИЯ О НЕНАПАДЕНИИ. С
Dialogue: 0,0:01:02.68,0:01:05.32,Caption,,0,0,0,,КАЖДОЙ СТРАНОЙ ОТДЕЛЬНО. И ВОТ НА ФОНЕ ТОГО,
Dialogue: 0,0:01:05.56,0:01:07.16,Caption,,0,0,0,,ЧТО МЫ СЕЙЧАС НАБЛЮДАЕМ В ЕВРОПЕ,
Dialogue: 0,0:01:07.48,0:01:09.48,Caption,,0,0,0,,ЛОГИКА ЗДЕСЬ ЧИТАЕТСЯ ДОВОЛЬНО ПРОСТО.
Dialogue: 0,0:01:11.75,0:01:13.91,Caption,,0,0,0,,ЕСЛИ У ВАС ЗА ОДНИМ СТОЛОМ СИДЯТ ЛЮДИ,
Dialogue: 0,0:01:14.11,0:01:16.07,Caption,,0,0,0,,КОТОРЫЕ НЕ МОГУТ ДОГОВОРИТЬСЯ ДАЖЕ О ТОМ,
Dialogue: 0,0:01:16.31,0:01:17.99,Caption,,0,0,0,,КТО БУДЕТ ГОВОРИТЬ ОТ ИХ ИМЕНИ,
Dialogue: 0,0:01:18.39,0:01:21.03,Caption,,0,0,0,,ЗАЧЕМ ЖДАТЬ, ПОКА ОНИ РОДЯТ ЕДИНУЮ ЛИНИЮ?
Dialogue: 0,0:01:21.24,0:01:23.83,Caption,,0,0,0,,МОЖНО ИДТИ ПО ОДНОМУ. ЭТО НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:01:24.06,0:01:26.95,Caption,,0,0,0,,ЧТО ЗАВТРА МОСКВА ПОДПИШЕТ ПАЧКУ ОТДЕЛЬНЫХ ДОГОВОРОВ
Dialogue: 0,0:01:27.08,0:01:30.07,Caption,,0,0,0,,И НАТО РАССЫПЛЕТСЯ. НО САМА ПОСТАНОВКА ВОПРОСА
Dialogue: 0,0:01:30.07,0:01:33.11,Caption,,0,0,0,,ИНТЕРЕСНАЯ. ЕВРОПА СЕЙЧАС ПОКАЗЫВАЕТ РОВНО ОБРАТНОЕ
Dialogue: 0,0:01:33.11,0:01:36.87,Caption,,0,0,0,,ТОМУ, ЧТО ТРЕБУЕТСЯ ДЛЯ ЕДИНОЙ ПЕРЕГОВОРНОЙ ПОЗИЦИИ ОДИН
Dialogue: 0,0:01:36.87,0:01:39.11,Caption,,0,0,0,,ХОЧЕТ ОБСУЖДАТЬ АРХИТЕКТУРУ БЕЗОПАСНОСТИ,
Dialogue: 0,0:01:39.35,0:01:42.87,Caption,,0,0,0,,ВТОРОЙ НЕ ХОЧЕТ, ТРЕТИЙ ТРЕБУЕТ СНАЧАЛА ПРЕКРАЩЕНИЯ ОГНЯ,
Dialogue: 0,0:01:43.06,0:01:45.67,Caption,,0,0,0,,ЧЕТВЁРТЫЙ УЖЕ ДЕЛИТ МЕСТА ЗА СТОЛОМ. И ТУТ
Dialogue: 0,0:01:45.67,0:01:49.43,Caption,,0,0,0,,МОСКВА ПРЕДЛАГАЕТ ХОРОШО, РЕБЯТА. РАЗ ВЫ НЕ МОЖЕТЕ ВСЕ ВМЕСТЕ,
Dialogue: 0,0:01:49.57,0:01:52.23,Caption,,0,0,0,,ДАВАЙТЕ ПО ОДНОМУ. ПРИЧЁМ РАЗГОВОР ИДЁТ УЖЕ НЕ
Dialogue: 0,0:01:52.31,0:01:54.15,Caption,,0,0,0,,НА УРОВНЕ ГАЗЕТНЫХ ФАНТАЗИЙ О ТОМ,
Dialogue: 0,0:01:54.28,0:01:56.87,Caption,,0,0,0,,КТО КУДА СЯДЕТ. В АБУ ДАБИ НА ПЕРЕГОВОРАХ
Dialogue: 0,0:01:56.95,0:01:59.19,Caption,,0,0,0,,ПРИСУТСТВОВАЛ ГЛАВКОМ ОБЪЕДИНЁННЫХ СИЛ НАТО В
Dialogue: 0,0:01:59.19,0:02:03.03,Caption,,0,0,0,,ЕВРОПЕ, АМЕРИКАНСКИЙ ГЕНЕРАЛ АЛЕКСУС ГРИНКЕВИЧ. И СЕРГЕЙ
Dialogue: 0,0:02:03.03,0:02:07.19,Caption,,0,0,0,,РЯБКОВ ОТДЕЛЬНО ПОДЧЕРКНУЛ, ЧТО ЕГО ПРИСУТСТВИЕ ДОБАВИЛО ПРОФЕССИОНАЛИЗМА
Dialogue: 0,0:02:07.19,0:02:10.15,Caption,,0,0,0,,ОБСУЖДЕНИЮ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:02:10.15,0:02:12.87,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО РЯБКОВ ЗДЕСЬ НЕ СЛУЧАЙНЫЙ
Dialogue: 0,0:02:12.95,0:02:16.87,Caption,,0,0,0,,ЧИНОВНИК, КОТОРЫЙ ВЧЕРА ВПЕРВЫЕ УСЛЫШАЛ СЛОВО НАТО. ЭТО ТОТ
Dialogue: 0,0:02:16.95,0:02:20.15,Caption,,0,0,0,,САМЫЙ РЯБКОВ, КОТОРЫЙ ЕЩЁ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ ГОДУ
Dialogue: 0,0:02:20.15,0:02:22.47,Caption,,0,0,0,,ПРЕДСТАВЛЯЛ РОССИЙСКИЕ ТРЕБОВАНИЯ ПО ГАРАНТИЯМ
Dialogue: 0,0:02:22.47,0:02:28.18,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ТОГДА МОСКВА ВЫНЕСЛА НА СТОЛ ЦЕЛЫЙ НАБОР УСЛОВИЙ
Dialogue: 0,0:02:28.26,0:02:32.74,Caption,,0,0,0,,ПО НАТО, РАЗМЕЩЕНИЮ СИЛ, ВОЕННОЙ ИНФРАСТРУКТУРЕ И ДАЛЬНЕЙШЕМУ РАСШИРЕНИЮ
Dialogue: 0,0:02:32.74,0:02:35.70,Caption,,0,0,0,,АЛЬЯНСА. ПРОШЛО ПЯТЬ ЛЕТ. И ТЕПЕРЬ ТОТ ЖЕ
Dialogue: 0,0:02:35.70,0:02:39.38,Caption,,0,0,0,,РЯБКОВ ГОВОРИТ, ЧТО В АБУ ДАБИ ОБСУЖДАЛИ АРХИТЕКТУРУ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:02:39.38,0:02:43.22,Caption,,0,0,0,,БЕЗОПАСНОСТИ, А ЗА СТОЛОМ СИДЕЛ ВЫСШИЙ ВОЕННЫЙ КОМАНДУЮЩИЙ НАТО
Dialogue: 0,0:02:43.22,0:02:47.62,Caption,,0,0,0,,В ЕВРОПЕ. НУ СОГЛАСИТЕСЬ, ЭТО УЖЕ НЕ РАЗГОВОР ДВУХ РАЙОННЫХ ДЕПУТАТОВ О
Dialogue: 0,0:02:47.70,0:02:50.82,Caption,,0,0,0,,ТОМ, ГДЕ ПОСТАВИТЬ ЛАВОЧКУ. ЧЕЛОВЕК ТАКОГО УРОВНЯ НЕ
Dialogue: 0,0:02:50.82,0:02:52.90,Caption,,0,0,0,,ПРИЕЗЖАЕТ ДЛЯ ТОГО, ЧТОБЫ ПОСЛУШАТЬ,
Dialogue: 0,0:02:53.20,0:02:56.02,Caption,,0,0,0,,КАК СТОРОНЫ ОБСУЖДАЮТ ОБМЕН ДЕСЯТИ ПЛЕННЫХ НА ДЕСЯТЬ
Dialogue: 0,0:02:56.02,0:02:58.98,Caption,,0,0,0,,ПЛЕННЫХ. ЕСЛИ ЗА СТОЛОМ СИДИТ ГЛАВКОМ НАТО В
Dialogue: 0,0:02:58.98,0:03:02.34,Caption,,0,0,0,,ЕВРОПЕ, ЗНАЧИТ ВОПРОС НАТО ТАМ СУЩЕСТВУЕТ НЕ ГДЕ ТО
Dialogue: 0,0:03:02.34,0:03:05.38,Caption,,0,0,0,,В ПРИМЕЧАНИИ МЕЛКИМ ШРИФТОМ. ОН НАХОДИТСЯ ВНУТРИ
Dialogue: 0,0:03:05.38,0:03:08.26,Caption,,0,0,0,,САМОГО РАЗГОВОРА. И ЭТО ВОЗВРАЩАЕТ НАС К НАШЕЙ
Dialogue: 0,0:03:08.26,0:03:11.30,Caption,,0,0,0,,ПРЕЖНЕЙ МЫСЛИ. УКРАИНСКИЙ КОНФЛИКТ УЖЕ ОБСУЖДАЕТСЯ
Dialogue: 0,0:03:11.38,0:03:13.78,Caption,,0,0,0,,НЕ ТОЛЬКО КАК ВОПРОС ЛИНИИ ФРОНТА И ПРЕКРАЩЕНИЯ
Dialogue: 0,0:03:13.86,0:03:16.90,Caption,,0,0,0,,ОГНЯ. МОСКВА ТАЩИТ РАЗГОВОР НА УРОВЕНЬ ОТНОШЕНИЙ
Dialogue: 0,0:03:16.90,0:03:20.50,Caption,,0,0,0,,РОССИИ И НАТО, И ЭТА ТЕМА УЖЕ НАХОДИТСЯ ВНУТРИ ПЕРЕГОВОРНОГО
Dialogue: 0,0:03:20.50,0:03:23.70,Caption,,0,0,0,,ПРОЦЕССА. А ТЕПЕРЬ ВЕРНЁМСЯ В ЕВРОПУ. ПОТОМУ ЧТО
Dialogue: 0,0:03:23.78,0:03:27.38,Caption,,0,0,0,,ЗДЕСЬ НАЧИНАЕТСЯ НАСТОЯЩИЙ ЦИРК. КАЯ КАЛЛАС ГОВОРИТ,
Dialogue: 0,0:03:27.59,0:03:30.42,Caption,,0,0,0,,ЧТО ЕВРОПА УЖЕ ИМЕЕТ СИСТЕМУ БЕЗОПАСНОСТИ И ВООБЩЕ
Dialogue: 0,0:03:30.42,0:03:33.78,Caption,,0,0,0,,РОССИИ ГАРАНТИИ НЕ НУЖНЫ, ПОТОМУ ЧТО НА НЕЁ НИКТО НЕ НАПАДАЛ.
Dialogue: 0,0:03:36.07,0:03:37.99,Caption,,0,0,0,,В ДРУГОМ ЭПИЗОДЕ ОНА ЖЕ ОБЪЯСНЯЕТ,
Dialogue: 0,0:03:38.15,0:03:40.87,Caption,,0,0,0,,ЧТО СТРАНЫ ЕС СОГЛАСИЛИСЬ С ЕЁ ПОЛНОМОЧИЯМИ
Dialogue: 0,0:03:40.87,0:03:43.59,Caption,,0,0,0,,ПРЕДСТАВЛЯТЬ ЕВРОПУ ПО ВОПРОСАМ ВНЕШНЕЙ ПОЛИТИКИ И
Dialogue: 0,0:03:43.59,0:03:47.03,Caption,,0,0,0,,БЕЗОПАСНОСТИ. КРАСИВО. ТОЛЬКО ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:03:47.35,0:03:49.99,Caption,,0,0,0,,ЧТО ЕДИНОГО ПЕРЕГОВОРЩИКА С РОССИЕЙ ИЗ КАЛЛАС НЕ
Dialogue: 0,0:03:49.99,0:03:53.19,Caption,,0,0,0,,ПОЛУЧИЛОСЬ. КОШТА И ФОН ДЕР ЛЯЙЕН ЕЁ ЕДИНОЛИЧНОЕ
Dialogue: 0,0:03:53.19,0:03:56.15,Caption,,0,0,0,,РУКОВОДСТВО НЕ ПОДДЕРЖАЛИ. В ИТОГЕ ВЫБРАЛИ ШИРОКУЮ
Dialogue: 0,0:03:56.15,0:03:59.99,Caption,,0,0,0,,ГРУППУ. ГЕРМАНИЯ, ФРАНЦИЯ, ВЕЛИКОБРИТАНИЯ,
Dialogue: 0,0:04:00.15,0:04:04.63,Caption,,0,0,0,,ИТАЛИЯ, ПОЛЬША, ПРЕДСТАВИТЕЛИ ЕВРОПЕЙСКИХ ИНСТИТУТОВ. ТО ЕСТЬ
Dialogue: 0,0:04:04.64,0:04:08.87,Caption,,0,0,0,,СНАЧАЛА ВСЕ СОГЛАСНЫ, ЧТО ПРЕДСТАВЛЯЕТ КАЛЛАС. ПОТОМ ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:04:09.11,0:04:11.35,Caption,,0,0,0,,ЧТО ПРЕДСТАВЛЯТЬ БУДУТ СРАЗУ НЕСКОЛЬКО ЧЕЛОВЕК.
Dialogue: 0,0:04:11.51,0:04:14.07,Caption,,0,0,0,,НОРМАЛЬНО ДОГОВОРИЛИСЬ. И САМОЕ ИНТЕРЕСНОЕ,
Dialogue: 0,0:04:14.31,0:04:16.71,Caption,,0,0,0,,ЧТО У ЭТОЙ ГРУППЫ НЕТ МАНДАТА ОБСУЖДАТЬ САМУ
Dialogue: 0,0:04:16.71,0:04:19.99,Caption,,0,0,0,,АРХИТЕКТУРУ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ПОДОЖДИТЕ. А
Dialogue: 0,0:04:19.99,0:04:24.07,Caption,,0,0,0,,ЗАЧЕМ ТОГДА ВЫ ЕДЕТЕ? МОСКВА ГОВОРИТ ГЛАВНЫЙ ВОПРОС ДОЛГОСРОЧНОГО РЕШЕНИЯ
Dialogue: 0,0:04:24.15,0:04:26.79,Caption,,0,0,0,,ЭТО БЕЗОПАСНОСТЬ ЕВРОПЫ. РЯБКОВ ГОВОРИТ ЭТУ
Dialogue: 0,0:04:26.79,0:04:29.51,Caption,,0,0,0,,АРХИТЕКТУРУ ОБСУЖДАЛИ В АБУ ДАБИ. ТАМ ПРИСУТСТВОВАЛ
Dialogue: 0,0:04:29.59,0:04:33.03,Caption,,0,0,0,,ГЛАВКОМ НАТО. АМЕРИКАНЦЫ ОБСУЖДАЮТ УЧАСТИЕ ЕВРОПЫ. А
Dialogue: 0,0:04:33.03,0:04:35.19,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ГРУППА ПРИЕЗЖАЕТ БЕЗ ПОЛНОМОЧИЙ
Dialogue: 0,0:04:35.19,0:04:38.07,Caption,,0,0,0,,ОБСУЖДАТЬ ИМЕННО АРХИТЕКТУРУ БЕЗОПАСНОСТИ. ЗАТО
Dialogue: 0,0:04:38.07,0:04:41.03,Caption,,0,0,0,,СОСТАВ ДЕЛЕГАЦИИ СОГЛАСОВАЛИ. ВОТ ЭТО Я ПОНИМАЮ.
Dialogue: 0,0:04:41.29,0:04:44.07,Caption,,0,0,0,,ГЛАВНОЕ СТУЛЬЯ РАСПРЕДЕЛИТЬ. А О ЧЁМ ГОВОРИТЬ,
Dialogue: 0,0:04:44.22,0:04:47.43,Caption,,0,0,0,,ПОТОМ РАЗБЕРЁМСЯ. И ВЕДЬ ВНУТРИ САМОЙ ЕВРОПЫ НИКАКОЙ
Dialogue: 0,0:04:47.44,0:04:52.83,Caption,,0,0,0,,ОБЩЕЙ ЛИНИИ НЕ ВИДНО. МЕРЦ ТРЕБУЕТ УЧАСТИЯ ЕВРОПЫ,
Dialogue: 0,0:04:53.07,0:04:56.43,Caption,,0,0,0,,НО СЧИТАЕТ, ЧТО НОВУЮ АРХИТЕКТУРУ БЕЗОПАСНОСТИ С РОССИЕЙ
Dialogue: 0,0:04:56.43,0:04:59.31,Caption,,0,0,0,,ОБСУЖДАТЬ НЕ НУЖНО. КАЛЛАС НАСТАИВАЕТ СНАЧАЛА
Dialogue: 0,0:04:59.31,0:05:04.75,Caption,,0,0,0,,ПРЕКРАЩЕНИЕ ОГНЯ, ПОТОМ МИР, А БОЛЬШАЯ АРХИТЕКТУРА УЖЕ СУЩЕСТВУЕТ. ФРАНЦУЗСКИЙ
Dialogue: 0,0:05:04.83,0:05:09.63,Caption,,0,0,0,,ПОСОЛ В МОСКВЕ, НАОБОРОТ, НАЗЫВАЕТ РОССИЙСКОЕ ТРЕБОВАНИЕ ГАРАНТИЙ БЕЗОПАСНОСТИ
Dialogue: 0,0:05:09.68,0:05:12.83,Caption,,0,0,0,,ЗАКОННЫМ. ФОН ДЕР ЛЯЙЕН ДОПУСКАЕТ ПЕРЕГОВОРЫ О НОВОЙ
Dialogue: 0,0:05:12.83,0:05:15.39,Caption,,0,0,0,,АРХИТЕКТУРЕ И ОДНОВРЕМЕННО ПРЕДЛАГАЕТ ПРОДОЛЖАТЬ
Dialogue: 0,0:05:15.39,0:05:18.35,Caption,,0,0,0,,ПОДДЕРЖКУ УКРАИНЫ. МИХАЛ ИЗ ЭСТОНИИ ПРИЗНАЁТ,
Dialogue: 0,0:05:18.59,0:05:21.07,Caption,,0,0,0,,ЧТО НЕЙТРАЛЬНЫМ ПОСРЕДНИКОМ ЕВРОПА БЫТЬ НЕ МОЖЕТ.
Dialogue: 0,0:05:21.40,0:05:24.75,Caption,,0,0,0,,КОШТА ХОЧЕТ ОДНУ КОНСТРУКЦИЮ. КАЛЛАС ДРУГУЮ. МЕРЦ
Dialogue: 0,0:05:24.75,0:05:27.55,Caption,,0,0,0,,ТРЕТЬЮ. ФОН ДЕР ЛЯЙЕН ЧЕТВЁРТУЮ. ТАК ВЫ В
Dialogue: 0,0:05:27.63,0:05:31.71,Caption,,0,0,0,,КАКОЙ ЕВРОПЕ ЖИВЁТЕ? ЭТО ВООБЩЕ ОДИН ПОЛИТИЧЕСКИЙ ОРГАНИЗМ ИЛИ НЕСКОЛЬКО
Dialogue: 0,0:05:31.71,0:05:34.99,Caption,,0,0,0,,РАЗНЫХ ЕВРОП, КОТОРЫЕ ПРОСТО ПОЛЬЗУЮТСЯ ОДНИМ ЛОГОТИПОМ?
Dialogue: 0,0:05:35.29,0:05:38.11,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ГЛАВНОЕ ПРОТИВОРЕЧИЕ. ЧТОБЫ ПРОВОДИТЬ
Dialogue: 0,0:05:38.12,0:05:40.27,Caption,,0,0,0,,ОДНУ ЖЁСТКУЮ, ПОСЛЕДОВАТЕЛЬНУЮ,
Dialogue: 0,0:05:40.30,0:05:42.75,Caption,,0,0,0,,ВОИНСТВУЮЩУЮ ЛИНИЮ, НУЖЕН ЦЕНТР,
Dialogue: 0,0:05:42.99,0:05:45.79,Caption,,0,0,0,,КОТОРЫЙ СПОСОБЕН НАВЯЗАТЬ ЕЁ ОСТАЛЬНЫМ. ИСТОРИЯ
Dialogue: 0,0:05:45.79,0:05:48.75,Caption,,0,0,0,,ЕВРОПЫ ТАКИЕ ПРИМЕРЫ ЗНАЕТ. НАПОЛЕОН И ГИТЛЕР НЕ
Dialogue: 0,0:05:48.75,0:05:50.59,Caption,,0,0,0,,СОБИРАЛИ БЕСКОНЕЧНЫЕ СОВЕЩАНИЯ,
Dialogue: 0,0:05:50.83,0:05:54.11,Caption,,0,0,0,,ЧТОБЫ УЗНАТЬ МНЕНИЕ КАЖДОГО. ОНИ ПОДЧИНЯЛИ СТРАНЫ И
Dialogue: 0,0:05:54.19,0:05:56.59,Caption,,0,0,0,,ТОЛЬКО ПОСЛЕ ЭТОГО ИСПОЛЬЗОВАЛИ ИХ РЕСУРС ДЛЯ ОДНОЙ
Dialogue: 0,0:05:56.59,0:05:59.23,Caption,,0,0,0,,ЦЕЛИ. ДЛЯ ОБОИХ ЭТО ЗАКОНЧИЛОСЬ ПЛОХО,
Dialogue: 0,0:05:59.47,0:06:01.79,Caption,,0,0,0,,НО МЕХАНИЗМ БЫЛ ПОНЯТЕН ОДИН ЦЕНТР,
Dialogue: 0,0:06:02.03,0:06:05.87,Caption,,0,0,0,,ОДНА ВОЛЯ, ОСТАЛЬНЫЕ ВЫПОЛНЯЮТ. А СЕЙЧАС ТАКОГО ЦЕНТРА НЕТ.
Dialogue: 0,0:06:08.16,0:06:10.80,Caption,,0,0,0,,ФРАНЦИЯ НЕ БУДЕТ ПРОСТО ВЫПОЛНЯТЬ КОМАНДЫ ГЕРМАНИИ.
Dialogue: 0,0:06:11.20,0:06:14.32,Caption,,0,0,0,,ГЕРМАНИЯ НЕ БУДЕТ ВЫПОЛНЯТЬ КОМАНДЫ ПОЛЬШИ. ИТАЛИЯ
Dialogue: 0,0:06:14.40,0:06:16.40,Caption,,0,0,0,,НЕ СОБИРАЕТСЯ ЖИТЬ ПО УКАЗАНИЯМ КАЛЛАС.
Dialogue: 0,0:06:16.72,0:06:19.04,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЯ ВООБЩЕ НЕ ЧЛЕН ЕВРОСОЮЗА,
Dialogue: 0,0:06:19.28,0:06:21.76,Caption,,0,0,0,,НО ПРИ ЭТОМ СИДИТ В ЕВРОПЕЙСКОЙ ПЕРЕГОВОРНОЙ ГРУППЕ.
Dialogue: 0,0:06:21.99,0:06:25.68,Caption,,0,0,0,,ПОЛЬША ИМЕЕТ СВОИ ИНТЕРЕСЫ. ПРИБАЛТИКА СВОИ. ВЕНГРИЯ
Dialogue: 0,0:06:25.68,0:06:28.48,Caption,,0,0,0,,СВОИ. И ВСЁ ЭТО ДОЛЖНО ВНЕЗАПНО РОДИТЬ ОДНУ
Dialogue: 0,0:06:28.48,0:06:31.12,Caption,,0,0,0,,ЖЁСТКУЮ ПОЗИЦИЮ ПО РОССИИ. КАКИМ ОБРАЗОМ?
Dialogue: 0,0:06:31.18,0:06:35.12,Caption,,0,0,0,,ГОЛОСОВАНИЕМ? КОМПРОМИССОМ? ТОГДА ОНА УЖЕ НЕ БУДЕТ ТАКОЙ ЖЁСТКОЙ,
Dialogue: 0,0:06:35.44,0:06:37.76,Caption,,0,0,0,,ПОТОМУ ЧТО КОМПРОМИСС ЭТО КОГДА КАЖДЫЙ ЧТО ТО
Dialogue: 0,0:06:37.76,0:06:40.56,Caption,,0,0,0,,ОТДАЛ. А ЕСЛИ КАЖДЫЙ СОХРАНЯЕТ СВОЁ ПРАВО СКАЗАТЬ
Dialogue: 0,0:06:40.56,0:06:43.20,Caption,,0,0,0,,НЕТ, ЕДИНАЯ ЛИНИЯ ПРЕВРАЩАЕТСЯ В ТО,
Dialogue: 0,0:06:43.44,0:06:46.16,Caption,,0,0,0,,ЧТО МЫ СЕЙЧАС И ВИДИМ БЕСКОНЕЧНЫЙ ПОЛИТИЧЕСКИЙ ПИНГ
Dialogue: 0,0:06:46.24,0:06:49.12,Caption,,0,0,0,,ПОНГ. ОСОБЕННО СМЕШНО ЭТО ВЫГЛЯДИТ ВОКРУГ ФИНЛЯНДИИ
Dialogue: 0,0:06:49.20,0:06:52.16,Caption,,0,0,0,,И СТРАН БАЛТИИ. ТО РОССИЯ ЯКОБЫ ТРЕБУЕТ ВЫХОДА
Dialogue: 0,0:06:52.24,0:06:55.20,Caption,,0,0,0,,ФИНЛЯНДИИ ИЗ НАТО И ЛИКВИДАЦИИ БАЗ В ПРИБАЛТИКЕ,
Dialogue: 0,0:06:55.58,0:06:57.92,Caption,,0,0,0,,ТО ФИНЛЯНДИЯ УЖЕ ТОРЖЕСТВЕННО ВСЁ ОТВЕРГАЕТ,
Dialogue: 0,0:06:58.24,0:07:02.48,Caption,,0,0,0,,ТО НАЧИНАЕТСЯ СПОР, БЫЛО ТАКОЕ ТРЕБОВАНИЕ ИЛИ НЕТ. МЫ СКАЗАЛИ. МЫ
Dialogue: 0,0:07:02.48,0:07:05.12,Caption,,0,0,0,,НЕ СКАЗАЛИ. ВЫ ПОТРЕБОВАЛИ. МЫ ОТВЕРГЛИ.
Dialogue: 0,0:07:05.44,0:07:08.24,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ НАСТОЛЬНЫЙ ТЕННИС. ПОЭТОМУ СИЛЬНО
Dialogue: 0,0:07:08.24,0:07:10.96,Caption,,0,0,0,,ЗАВИСАТЬ НА КАЖДОЙ ТАКОЙ УТЕЧКЕ НЕТ НИКАКОГО СМЫСЛА.
Dialogue: 0,0:07:11.36,0:07:14.16,Caption,,0,0,0,,ВАЖНЕЕ ДРУГОЕ. САМ ВОПРОС ОГРАНИЧЕНИЯ ВОЕННОЙ
Dialogue: 0,0:07:14.16,0:07:18.80,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ НАТО, РАСШИРЕНИЯ АЛЬЯНСА И ПРАВИЛ РАЗМЕЩЕНИЯ СИЛ НИКУДА НЕ
Dialogue: 0,0:07:18.88,0:07:21.36,Caption,,0,0,0,,ДЕЛСЯ. ОН ВЕРНУЛСЯ В ПЕРЕГОВОРНЫЙ КОНТУР.
Dialogue: 0,0:07:23.63,0:07:26.27,Caption,,0,0,0,,ТЕМ БОЛЕЕ ЧТО ОТДЕЛЬНО ВСПЛЫЛО СТАРОЕ РОССИЙСКОЕ
Dialogue: 0,0:07:26.35,0:07:28.99,Caption,,0,0,0,,ТРЕБОВАНИЕ ВЕРНУТЬСЯ К КОНФИГУРАЦИИ НАТО ТЫСЯЧА
Dialogue: 0,0:07:29.07,0:07:30.51,Caption,,0,0,0,,ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОГО ГОДА.
Dialogue: 0,0:07:31.14,0:07:32.75,Caption,,0,0,0,,ТО ЕСТЬ СПОР ИДЁТ НЕ ТОЛЬКО О ТОМ,
Dialogue: 0,0:07:32.85,0:07:35.39,Caption,,0,0,0,,БУДЕТ УКРАИНА В НАТО ИЛИ НЕТ. РЕЧЬ ИДЁТ
Dialogue: 0,0:07:35.47,0:07:38.99,Caption,,0,0,0,,О ТОМ, ЧТО ПРОИСХОДИЛО С АЛЬЯНСОМ ПОСЛЕ ХОЛОДНОЙ ВОЙНЫ И
Dialogue: 0,0:07:39.07,0:07:41.79,Caption,,0,0,0,,ГДЕ ДОЛЖНА ПРОХОДИТЬ ГРАНИЦА ДОПУСТИМОГО ВОЕННОГО
Dialogue: 0,0:07:41.79,0:07:45.87,Caption,,0,0,0,,ПРИСУТСТВИЯ. ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ДАЛЬШЕ КАК
Dialogue: 0,0:07:45.95,0:07:47.71,Caption,,0,0,0,,РАЗ САМОЕ ИНТЕРЕСНОЕ ЧТО ПРОИСХОДИТ,
Dialogue: 0,0:07:48.03,0:07:50.51,Caption,,0,0,0,,КОГДА ОДИН ЛАГЕРЬ ХОЧЕТ ОБСУЖДАТЬ БОЛЬШУЮ СИСТЕМУ
Dialogue: 0,0:07:50.51,0:07:54.11,Caption,,0,0,0,,БЕЗОПАСНОСТИ, А ДРУГОЙ ПРИЕЗЖАЕТ НА ПЕРЕГОВОРЫ С СОВЕРШЕННО ДРУГИМ
Dialogue: 0,0:07:54.11,0:07:56.67,Caption,,0,0,0,,СПИСКОМ ЗАДАЧ. ЗЕЛЕНСКИЙ ТРЕБУЕТ,
Dialogue: 0,0:07:56.83,0:07:59.47,Caption,,0,0,0,,ЧТОБЫ ЕВРОСОЮЗ СЛЕДИЛ ЗА ПЕРЕГОВОРАМИ МОСКВЫ И
Dialogue: 0,0:07:59.47,0:08:01.63,Caption,,0,0,0,,ВАШИНГТОНА О БУДУЩЕЙ СИСТЕМЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:08:01.63,0:08:05.15,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ЛОГИЧНО. ЕСЛИ ДВЕ КРУПНЕЙШИЕ ВОЕННЫЕ
Dialogue: 0,0:08:05.23,0:08:08.43,Caption,,0,0,0,,ДЕРЖАВЫ ОБСУЖДАЮТ ПРАВИЛА, КОТОРЫЕ ЗАТРОНУТ ЕВРОПУ,
Dialogue: 0,0:08:08.66,0:08:10.43,Caption,,0,0,0,,КИЕВ И БРЮССЕЛЬ ХОТЯТ ПОНИМАТЬ,
Dialogue: 0,0:08:10.51,0:08:13.39,Caption,,0,0,0,,ЧТО ИМЕННО ТАМ ПРОИСХОДИТ. КУШНЕР ГОВОРИТ О
Dialogue: 0,0:08:13.39,0:08:15.79,Caption,,0,0,0,,НЕОБХОДИМОСТИ УЧАСТИЯ ЕВРОПЫ В БУДУЩЕМ МИРНОМ
Dialogue: 0,0:08:15.79,0:08:19.31,Caption,,0,0,0,,СОГЛАШЕНИИ. ЕВРОПЕЙЦЫ ТОЖЕ ТРЕБУЮТ ПРИСУТСТВИЯ. НО
Dialogue: 0,0:08:19.31,0:08:22.11,Caption,,0,0,0,,ДАЛЬШЕ СНОВА ВОЗНИКАЕТ ВОПРОС С ЧЕМ ИМЕННО ОНИ
Dialogue: 0,0:08:22.11,0:08:25.31,Caption,,0,0,0,,ПРИХОДЯТ? ФОН ДЕР ЛЯЙЕН ПЕРЕЧИСЛЯЕТ СВОИ ПРИОРИТЕТЫ.
Dialogue: 0,0:08:25.47,0:08:28.75,Caption,,0,0,0,,ПРЕКРАЩЕНИЕ ОГНЯ. ГАРАНТИИ БЕЗОПАСНОСТИ УКРАИНЕ.
Dialogue: 0,0:08:28.90,0:08:32.27,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ. КОНТРАКТЫ. ФИНАНСИРОВАНИЕ УКРАИНЫ В
Dialogue: 0,0:08:32.35,0:08:33.87,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ.
Dialogue: 0,0:08:36.14,0:08:39.02,Caption,,0,0,0,,РОССИЯ ГОВОРИТ О БОЛЬШОМ МИРНОМ СОГЛАШЕНИИ И ОБЩЕЙ
Dialogue: 0,0:08:39.02,0:08:41.90,Caption,,0,0,0,,АРХИТЕКТУРЕ БЕЗОПАСНОСТИ. ЭТО УЖЕ ДВА РАЗНЫХ
Dialogue: 0,0:08:41.90,0:08:45.10,Caption,,0,0,0,,МАСШТАБА РАЗГОВОРА. ОДНИ ОБСУЖДАЮТ ПРЕКРАЩЕНИЕ ОГНЯ,
Dialogue: 0,0:08:45.29,0:08:48.14,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ УКРАИНЫ И ВОССТАНОВЛЕНИЕ. ДРУГИЕ
Dialogue: 0,0:08:48.14,0:08:50.54,Caption,,0,0,0,,СТАВЯТ ВОПРОС ТАК КАКИЕ ПРАВИЛА ВООБЩЕ БУДУТ
Dialogue: 0,0:08:50.62,0:08:52.78,Caption,,0,0,0,,ДЕЙСТВОВАТЬ МЕЖДУ РОССИЕЙ И НАТО ПОСЛЕ ЭТОГО?
Dialogue: 0,0:08:53.26,0:08:56.14,Caption,,0,0,0,,НО ГАРАНТИИ БЕЗОПАСНОСТИ УКРАИНЕ САМИ ПО СЕБЕ НИЧЕГО
Dialogue: 0,0:08:56.22,0:08:59.18,Caption,,0,0,0,,НЕ ОБЪЯСНЯЮТ. КАКОЙ УКРАИНЕ? В КАКИХ ГРАНИЦАХ?
Dialogue: 0,0:08:59.40,0:09:01.82,Caption,,0,0,0,,С КАКОЙ АРМИЕЙ? С КАКОЙ ВНЕШНЕЙ ПОЛИТИКОЙ?
Dialogue: 0,0:09:01.90,0:09:03.66,Caption,,0,0,0,,С КАКИМ ПОЛИТИЧЕСКИМ РУКОВОДСТВОМ?
Dialogue: 0,0:09:04.06,0:09:06.22,Caption,,0,0,0,,ЕСЛИ ЗАВТРА ПОДПИСАТЬ БУМАГУ О ГАРАНТИЯХ,
Dialogue: 0,0:09:06.53,0:09:08.62,Caption,,0,0,0,,А ЧЕРЕЗ ПЯТЬ МИНУТ СНОВА НАЧАТЬ СПОРИТЬ О
Dialogue: 0,0:09:08.62,0:09:11.82,Caption,,0,0,0,,НАТО, ВООРУЖЕНИЯХ, ИНОСТРАННЫХ БАЗАХ,
Dialogue: 0,0:09:12.06,0:09:14.46,Caption,,0,0,0,,ЧИСЛЕННОСТИ АРМИИ И ВОЕННОЙ ИНФРАСТРУКТУРЕ,
Dialogue: 0,0:09:14.70,0:09:16.38,Caption,,0,0,0,,ТО ЧТО ИМЕННО ЭТА БУМАГА РЕШИЛА?
Dialogue: 0,0:09:16.52,0:09:19.50,Caption,,0,0,0,,НИЧЕГО. И ВОТ ПОЭТОМУ РОССИЙСКАЯ СТОРОНА ТАЩИТ
Dialogue: 0,0:09:19.50,0:09:22.46,Caption,,0,0,0,,РАЗГОВОР НА УРОВЕНЬ ВЫШЕ. НЕ ТОЛЬКО УКРАИНА. НЕ
Dialogue: 0,0:09:22.54,0:09:25.66,Caption,,0,0,0,,ТОЛЬКО ДОНБАСС. НЕ ТОЛЬКО ПРЕКРАЩЕНИЕ ОГНЯ. А
Dialogue: 0,0:09:25.66,0:09:28.70,Caption,,0,0,0,,ОТНОШЕНИЯ РОССИИ И НАТО ПОСЛЕ ВОЙНЫ. И ТУТ
Dialogue: 0,0:09:28.78,0:09:31.26,Caption,,0,0,0,,ОТДЕЛЬНЫЕ СОГЛАШЕНИЯ О НЕНАПАДЕНИИ ВЫГЛЯДЯТ УЖЕ
Dialogue: 0,0:09:31.26,0:09:34.38,Caption,,0,0,0,,СОВСЕМ ИНАЧЕ. ЭТО НЕ ПРОСТО КРАСИВАЯ ДИПЛОМАТИЧЕСКАЯ
Dialogue: 0,0:09:34.38,0:09:37.18,Caption,,0,0,0,,ИДЕЯ. ЭТО ПОТЕНЦИАЛЬНЫЙ СПОСОБ РАБОТАТЬ С ТЕМ,
Dialogue: 0,0:09:37.34,0:09:39.98,Caption,,0,0,0,,ЧТО ЕВРОПА СЕГОДНЯ ПРЕДСТАВЛЯЕТ СОБОЙ НА ПРАКТИКЕ
Dialogue: 0,0:09:40.06,0:09:42.30,Caption,,0,0,0,,МНОГО ГОСУДАРСТВ, МНОГО ИНТЕРЕСОВ,
Dialogue: 0,0:09:42.46,0:09:45.82,Caption,,0,0,0,,МНОГО РУКОВОДИТЕЛЕЙ И ОЧЕНЬ МАЛО ОБЩЕЙ ВОЛИ. НЕ
Dialogue: 0,0:09:45.82,0:09:47.18,Caption,,0,0,0,,МОЖЕТЕ ДОГОВОРИТЬСЯ ВСЕ ВМЕСТЕ?
Dialogue: 0,0:09:47.23,0:09:54.26,Caption,,0,0,0,,ХОРОШО. ПОЛЬША ОТДЕЛЬНО. ГЕРМАНИЯ ОТДЕЛЬНО. ИТАЛИЯ ОТДЕЛЬНО. ФРАНЦИЯ
Dialogue: 0,0:09:54.26,0:09:57.54,Caption,,0,0,0,,ОТДЕЛЬНО. ФИНЛЯНДИЯ ОТДЕЛЬНО. А ДАЛЬШЕ КАЖДЫЙ САМ
Dialogue: 0,0:09:57.54,0:10:00.26,Caption,,0,0,0,,ОТВЕЧАЕТ НА ПРОСТОЙ ВОПРОС ЧЕГО КОНКРЕТНО ВЫ ХОТИТЕ
Dialogue: 0,0:10:00.26,0:10:03.14,Caption,,0,0,0,,ОТ ОТНОШЕНИЙ С РОССИЕЙ И ЧТО ГОТОВЫ ГАРАНТИРОВАТЬ
Dialogue: 0,0:10:03.22,0:10:06.18,Caption,,0,0,0,,В ОТВЕТ? В ДВУСТОРОННЕМ ФОРМАТЕ ОТВЕТСТВЕННОСТЬ ТОЖЕ
Dialogue: 0,0:10:06.26,0:10:08.98,Caption,,0,0,0,,СТАНОВИТСЯ КОНКРЕТНЕЕ. УЖЕ СЛОЖНЕЕ СПРЯТАТЬСЯ ЗА
Dialogue: 0,0:10:08.98,0:10:11.14,Caption,,0,0,0,,СЛОВАМИ "ЭТО ОБЩЕЕ РЕШЕНИЕ БЛОКА".
Dialogue: 0,0:10:11.70,0:10:14.10,Caption,,0,0,0,,НО ЕСТЬ И ОБРАТНАЯ СТОРОНА. НАТО ЭТО ВСЁ
Dialogue: 0,0:10:14.18,0:10:17.30,Caption,,0,0,0,,ТАКИ СОЮЗ. У ГОСУДАРСТВ ЕСТЬ ОБЩИЕ ОБЯЗАТЕЛЬСТВА.
Dialogue: 0,0:10:17.46,0:10:20.58,Caption,,0,0,0,,АМЕРИКАНСКИЕ ВОЙСКА, ОБЩАЯ СИСТЕМА КОМАНДОВАНИЯ,
Dialogue: 0,0:10:20.75,0:10:25.30,Caption,,0,0,0,,ОБЩИЕ ПЛАНЫ ОБОРОНЫ, ИНФРАСТРУКТУРА АЛЬЯНСА НИКУДА НЕ ИСЧЕЗАЮТ ТОЛЬКО
Dialogue: 0,0:10:25.38,0:10:28.58,Caption,,0,0,0,,ПОТОМУ, ЧТО ОДНА СТРАНА ПОДПИСАЛА ОТДЕЛЬНУЮ БУМАГУ С
Dialogue: 0,0:10:28.66,0:10:31.70,Caption,,0,0,0,,МОСКВОЙ. ИМЕННО ПОЭТОМУ ПРИСУТСТВИЕ ГРИНКЕВИЧА В АБУ
Dialogue: 0,0:10:31.70,0:10:34.26,Caption,,0,0,0,,ДАБИ ТАК ВАЖНО. ПОТОМУ ЧТО ЕСЛИ РЕЧЬ ИДЁТ
Dialogue: 0,0:10:34.34,0:10:37.94,Caption,,0,0,0,,О ВОЕННОЙ АРХИТЕКТУРЕ ЕВРОПЫ, НЕЛЬЗЯ ВСЕРЬЁЗ ОБСУЖДАТЬ ЕЁ,
Dialogue: 0,0:10:38.02,0:10:41.38,Caption,,0,0,0,,ДЕЛАЯ ВИД, ЧТО НАТО СУЩЕСТВУЕТ ГДЕ ТО В СОСЕДНЕЙ КОМНАТЕ.
Dialogue: 0,0:10:41.74,0:10:44.42,Caption,,0,0,0,,ВОТ НАТО И ОКАЗАЛОСЬ ЗА СТОЛОМ. ПРИЧЁМ НЕ
Dialogue: 0,0:10:44.42,0:10:47.86,Caption,,0,0,0,,ПРЕСС СЕКРЕТАРЬ, НЕ СОВЕТНИК ТРЕТЬЕГО УРОВНЯ И НЕ ЧЕЛОВЕК С
Dialogue: 0,0:10:47.86,0:10:51.14,Caption,,0,0,0,,КРАСИВОЙ ПАПКОЙ. ГЛАВКОМ ОБЪЕДИНЁННЫХ СИЛ НАТО В
Dialogue: 0,0:10:51.14,0:10:53.94,Caption,,0,0,0,,ЕВРОПЕ. АМЕРИКАНСКИЙ ЧЕТЫРЁХЗВЁЗДНЫЙ ГЕНЕРАЛ.
Dialogue: 0,0:10:54.17,0:10:57.30,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫЙ НАХОДИТСЯ В САМОЙ ВЕРХУШКЕ ВОЕННОГО
Dialogue: 0,0:10:57.30,0:11:00.18,Caption,,0,0,0,,УПРАВЛЕНИЯ АЛЬЯНСА. ВЫШЕ, КАК ГОВОРИТСЯ,
Dialogue: 0,0:11:00.26,0:11:04.74,Caption,,0,0,0,,ТОЛЬКО БОГ. НУ И ПОЛИТИКИ, КОТОРЫЕ ПОТОМ ДОЛЖНЫ ВСЁ ЭТО УТВЕРДИТЬ. И ВОТ
Dialogue: 0,0:11:04.82,0:11:09.99,Caption,,0,0,0,,ТУТ КРУГ ЗАМЫКАЕТСЯ. ПОКА ЕВРОПЕЙСКИЕ ЛИДЕРЫ СПОРЯТ,
Dialogue: 0,0:11:10.23,0:11:14.23,Caption,,0,0,0,,КТО ПРЕДСТАВЛЯЕТ ЕВРОПУ, ВОЕННЫЕ РОССИИ И НАТО УЖЕ СИДЯТ ЗА ОДНИМ
Dialogue: 0,0:11:14.23,0:11:16.47,Caption,,0,0,0,,СТОЛОМ И ОБСУЖДАЮТ БЕЗОПАСНОСТЬ ЕВРОПЫ.
Dialogue: 0,0:11:17.10,0:11:20.95,Caption,,0,0,0,,ПОКА КАЛЛАС ОБЪЯСНЯЕТ, ЧТО НОВАЯ АРХИТЕКТУРА ВООБЩЕ НЕ НУЖНА,
Dialogue: 0,0:11:21.19,0:11:24.55,Caption,,0,0,0,,РЯБКОВ ГОВОРИТ, ЧТО ИМЕННО ОНА БЫЛА ОДНОЙ ИЗ ГЛАВНЫХ ТЕМ
Dialogue: 0,0:11:24.55,0:11:26.71,Caption,,0,0,0,,ПЕРЕГОВОРОВ. ПОКА МЕРЦ ГОВОРИТ,
Dialogue: 0,0:11:26.87,0:11:29.35,Caption,,0,0,0,,ЧТО ОБСУЖДАТЬ ЕЁ С РОССИЕЙ НЕТ НЕОБХОДИМОСТИ,
Dialogue: 0,0:11:29.68,0:11:32.39,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПЕРЕГОВОРЩИКИ УЖЕ ВЕДУТ ЭТОТ РАЗГОВОР.
Dialogue: 0,0:11:32.66,0:11:35.19,Caption,,0,0,0,,ПОКА ЕВРОСОЮЗ ФОРМИРУЕТ КОЛЛЕКТИВНУЮ ГРУППУ БЕЗ
Dialogue: 0,0:11:35.27,0:11:37.19,Caption,,0,0,0,,ЯСНОГО МАНДАТА НА ГЛАВНЫЙ ВОПРОС,
Dialogue: 0,0:11:37.50,0:11:39.91,Caption,,0,0,0,,МОСКВА ПРЕДЛАГАЕТ СТРАНАМ АЛЬЯНСА РАЗГОВАРИВАТЬ
Dialogue: 0,0:11:39.99,0:11:43.03,Caption,,0,0,0,,ОТДЕЛЬНО. ВОТ ПОЧЕМУ СЕЙЧАС БЕССМЫСЛЕННО СМОТРЕТЬ НА
Dialogue: 0,0:11:43.03,0:11:46.07,Caption,,0,0,0,,КАЖДОЕ ЗАЯВЛЕНИЕ КАК НА САМОСТОЯТЕЛЬНУЮ НОВОСТЬ. ИХ
Dialogue: 0,0:11:46.07,0:11:48.87,Caption,,0,0,0,,НУЖНО СКЛАДЫВАТЬ ВМЕСТЕ. А ВМЕСТЕ ПОЛУЧАЕТСЯ ОЧЕНЬ
Dialogue: 0,0:11:48.95,0:11:51.59,Caption,,0,0,0,,ПРОСТАЯ КАРТИНА. ЕВРОПА ХОЧЕТ УЧАСТВОВАТЬ В
Dialogue: 0,0:11:51.59,0:11:53.83,Caption,,0,0,0,,ОПРЕДЕЛЕНИИ БУДУЩЕЙ СИСТЕМЫ БЕЗОПАСНОСТИ,
Dialogue: 0,0:11:54.15,0:11:56.71,Caption,,0,0,0,,НО ЕДИНОЙ СИСТЕМЫ ТРЕБОВАНИЙ У НЕЁ САМОЙ ПОКА
Dialogue: 0,0:11:56.71,0:12:00.07,Caption,,0,0,0,,НЕТ. РОССИЯ ХОЧЕТ ОБСУЖДАТЬ ПРАВИЛА НА ДЕСЯТИЛЕТИЯ
Dialogue: 0,0:12:00.07,0:12:03.59,Caption,,0,0,0,,ВПЕРЁД. США ЭТИ РАЗГОВОРЫ НЕ БЛОКИРУЮТ. НАТО УЖЕ
Dialogue: 0,0:12:03.67,0:12:05.91,Caption,,0,0,0,,ФИЗИЧЕСКИ ПРИСУТСТВУЕТ НА ПЕРЕГОВОРАХ НА САМОМ
Dialogue: 0,0:12:05.99,0:12:08.63,Caption,,0,0,0,,ВЫСОКОМ ВОЕННОМ УРОВНЕ. А ЕВРОПЕЙСКИЕ СТОЛИЦЫ
Dialogue: 0,0:12:08.63,0:12:12.71,Caption,,0,0,0,,ПРОДОЛЖАЮТ ВЫЯСНЯТЬ, КТО ОТ КОГО УПОЛНОМОЧЕН И ЧТО ИМЕННО СЧИТАТЬ
Dialogue: 0,0:12:12.71,0:12:15.43,Caption,,0,0,0,,ПРЕДМЕТОМ ПЕРЕГОВОРОВ. И ЗДЕСЬ САМЫЙ ИНТЕРЕСНЫЙ
Dialogue: 0,0:12:15.43,0:12:19.91,Caption,,0,0,0,,ВОПРОС УЖЕ ДАЖЕ НЕ В ТОМ, КОГО ПРИГЛАСЯТ НА СЛЕДУЮЩИЙ РАУНД. ВОПРОС В ДРУГОМ.
Dialogue: 0,0:12:22.18,0:12:24.98,Caption,,0,0,0,,ЕСЛИ ОБЩЕГО ЕВРОПЕЙСКОГО ОТВЕТА ТАК И НЕ ПОЯВИТСЯ,
Dialogue: 0,0:12:25.38,0:12:29.70,Caption,,0,0,0,,НЕ ПОЛУЧИТСЯ ЛИ В ИТОГЕ ТАК, ЧТО НОВУЮ СИСТЕМУ БУДУТ СОБИРАТЬ НЕ ОДНИМ БОЛЬШИМ
Dialogue: 0,0:12:29.70,0:12:34.74,Caption,,0,0,0,,ДОГОВОРОМ, А КУСКАМИ? СТРАНА ЗА СТРАНОЙ. СОГЛАШЕНИЕ ЗА СОГЛАШЕНИЕМ. И
Dialogue: 0,0:12:34.82,0:12:36.58,Caption,,0,0,0,,ТОГДА ЕВРОПА ОДНАЖДЫ ОБНАРУЖИТ,
Dialogue: 0,0:12:36.80,0:12:38.90,Caption,,0,0,0,,ЧТО ВСЕ ЭТИ МЕСЯЦЫ СПОРИЛА О ТОМ,
Dialogue: 0,0:12:39.06,0:12:40.90,Caption,,0,0,0,,КТО БУДЕТ ГОВОРИТЬ ОТ ЕЁ ИМЕНИ,
Dialogue: 0,0:12:41.22,0:12:43.46,Caption,,0,0,0,,А РАЗГОВАРИВАТЬ С КАЖДЫМ УЖЕ НАЧАЛИ ОТДЕЛЬНО.
