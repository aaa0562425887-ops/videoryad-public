Dialogue: 0,0:00:00.12,0:00:04.12,Caption,,0,0,0,,У ЛЮБОЙ ВЛАСТИ ЕСТЬ МОМЕНТ, КОГДА ПРИВЫЧНАЯ НЕПРИКОСНОВЕННОСТЬ ВНЕЗАПНО
Dialogue: 0,0:00:04.12,0:00:07.08,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ. ПОТОМ В ИНФОРМАЦИОННОЕ ПОЛЕ
Dialogue: 0,0:00:07.08,0:00:09.80,Caption,,0,0,0,,ПРОСАЧИВАЕТСЯ СИГНАЛ ПРАВИЛА МОГЛИ ОТМЕНИТЬ.
Dialogue: 0,0:00:10.36,0:00:13.88,Caption,,0,0,0,,ИМЕННО ТАКОЙ СЛУХ ГУЛЯЕТ ВОКРУГ КРЕМЛЯ. РОССИЯ ЯКОБЫ
Dialogue: 0,0:00:13.88,0:00:16.92,Caption,,0,0,0,,СНЯЛА ПРЕЖНЕЕ ОГРАНИЧЕНИЕ НА ДЕЙСТВИЯ ПРОТИВ ВЫСШЕГО
Dialogue: 0,0:00:16.92,0:00:19.48,Caption,,0,0,0,,ГОСУДАРСТВЕННОГО И ВОЕННОГО РУКОВОДСТВА УКРАИНЫ,
Dialogue: 0,0:00:19.64,0:00:22.20,Caption,,0,0,0,,ВКЛЮЧАЯ ЗЕЛЕНСКОГО, ЧИНОВНИКОВ И ГЕНЕРАЛОВ.
Dialogue: 0,0:00:24.47,0:00:27.35,Caption,,0,0,0,,ЭТО НЕ ОФИЦИАЛЬНОЕ ОБЪЯВЛЕНИЕ С ПЕЧАТЬЮ И ОРКЕСТРОМ.
Dialogue: 0,0:00:27.59,0:00:30.23,Caption,,0,0,0,,ЗДЕСЬ ВАЖНЕЕ САМ СИГНАЛ И ВЫБРАННЫЙ АДРЕСАТ.
Dialogue: 0,0:00:30.61,0:00:34.79,Caption,,0,0,0,,УКРАИНСКОЙ ВЕРХУШКЕ СООБЩАЮТ, ЧТО ПРЕЖНИЙ ЗАЩИЩЁННЫЙ СТАТУС БОЛЬШЕ НЕ
Dialogue: 0,0:00:34.79,0:00:37.91,Caption,,0,0,0,,ГАРАНТИРОВАН. РАНЬШЕ ЛОГИКА МОСКВЫ БЫЛА ПОНЯТНОЙ
Dialogue: 0,0:00:37.91,0:00:40.55,Caption,,0,0,0,,РУКОВОДСТВО ПРОТИВНИКА ПОНАДОБИТСЯ ДЛЯ ПЕРЕГОВОРОВ,
Dialogue: 0,0:00:40.79,0:00:43.67,Caption,,0,0,0,,ПРИНЯТИЯ ОБЯЗАТЕЛЬСТВ И ПОДПИСАНИЯ СОГЛАШЕНИЙ.
Dialogue: 0,0:00:44.07,0:00:46.87,Caption,,0,0,0,,ТЕПЕРЬ ДО КИЕВА ДОВОДЯТ ДРУГУЮ МЫСЛЬ. ПОДПИСЫВАТЬ
Dialogue: 0,0:00:46.87,0:00:50.07,Caption,,0,0,0,,БУМАГИ, ВОЗМОЖНО, ПРИДЁТСЯ УЖЕ СОВСЕМ ДРУГИМ ЛЮДЯМ.
Dialogue: 0,0:00:52.34,0:00:55.86,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ХОТИТЕ ВИДЕТЬ НЕ РОССЫПЬ ГРОМКИХ ЗАЯВЛЕНИЙ,
Dialogue: 0,0:00:56.10,0:00:59.46,Caption,,0,0,0,,А ТО, КАК ИЗ НИХ СОБИРАЕТСЯ РЕАЛЬНАЯ РАССТАНОВКА СИЛ.
Dialogue: 0,0:00:59.86,0:01:02.34,Caption,,0,0,0,,ЗДЕСЬ ОДИН СЛУХ СПОСОБЕН ОБЪЯСНИТЬ БОЛЬШЕ,
Dialogue: 0,0:01:02.50,0:01:05.14,Caption,,0,0,0,,ЧЕМ ЦЕЛАЯ ОЧЕРЕДЬ БОДРЫХ ПРЕСС КОНФЕРЕНЦИЙ.
Dialogue: 0,0:01:07.33,0:01:09.65,Caption,,0,0,0,,ПРИЧИНА ДЛЯ ТАКОГО РАЗВОРОТА ТОЖЕ НЕ УПАЛА С
Dialogue: 0,0:01:09.65,0:01:12.37,Caption,,0,0,0,,ПОТОЛКА. В РОССИИ ВЗРЫВАЛИСЬ АВТОМОБИЛИ,
Dialogue: 0,0:01:12.62,0:01:17.57,Caption,,0,0,0,,ПОГИБАЛИ ВОЕННЫЕ И ЛЮДИ, СВЯЗАННЫЕ С ГОСУДАРСТВЕННЫМИ СТРУКТУРАМИ. УКРАИНСКАЯ
Dialogue: 0,0:01:17.57,0:01:20.13,Caption,,0,0,0,,СТОРОНА РАЗДВИГАЛА ГРАНИЦЫ ДОПУСТИМОГО И,
Dialogue: 0,0:01:20.23,0:01:25.01,Caption,,0,0,0,,ПОХОЖЕ, РАССЧИТЫВАЛА, ЧТО ОТВЕТ ОСТАНЕТСЯ ПРИВЫЧНЫМ. ПОЧТИ КАК ЗАТЕЯТЬ
Dialogue: 0,0:01:25.01,0:01:27.49,Caption,,0,0,0,,ДРАКУ В РЕСТОРАНЕ, А ПОТОМ ВОЗМУЩАТЬСЯ,
Dialogue: 0,0:01:27.65,0:01:29.81,Caption,,0,0,0,,ЧТО ОФИЦИАНТ ПЕРЕСТАЛ ПРИНОСИТЬ САЛФЕТКИ.
Dialogue: 0,0:01:32.02,0:01:35.14,Caption,,0,0,0,,ЕСТЬ И БОЛЕЕ РАСЧЁТЛИВАЯ ВЕРСИЯ. ЗЕЛЕНСКОМУ МОЖЕТ
Dialogue: 0,0:01:35.22,0:01:38.18,Caption,,0,0,0,,БЫТЬ ПОЛЕЗНА ЖЁСТКАЯ РЕАКЦИЯ МОСКВЫ. ЧЕМ СТРАШНЕЕ
Dialogue: 0,0:01:38.18,0:01:41.62,Caption,,0,0,0,,ОТВЕТ, ТЕМ ПРОЩЕ ЕХАТЬ К ЕВРОПЕЙСКИМ ПАРТНЁРАМ ЗА ОРУЖИЕМ,
Dialogue: 0,0:01:41.78,0:01:44.90,Caption,,0,0,0,,КРЕДИТАМИ И ОЧЕРЕДНЫМ ПАКЕТОМ ПОМОЩИ. СНАЧАЛА
Dialogue: 0,0:01:44.98,0:01:49.22,Caption,,0,0,0,,ПОДНЯТЬ ЦЕНУ КОНФЛИКТА, ЗАТЕМ ПРЕДЪЯВИТЬ СЧЁТ БРЮССЕЛЮ. НО ИНОГДА ОТВЕТ
Dialogue: 0,0:01:49.22,0:01:52.10,Caption,,0,0,0,,ПРИХОДИТ НЕ ПО ДЕКОРАЦИЯМ, ПРИГОТОВЛЕННЫМ ДЛЯ КАМЕРЫ,
Dialogue: 0,0:01:52.42,0:01:55.14,Caption,,0,0,0,,А ПО ТЕМ, КТО ЭТИ ДЕКОРАЦИИ РАССТАВЛЯЛ.
Dialogue: 0,0:01:57.41,0:01:59.89,Caption,,0,0,0,,ПОКА НАВЕРХУ ОСМЫСЛИВАЮТ НОВЫЙ УРОВЕНЬ ЛИЧНОГО
Dialogue: 0,0:01:59.97,0:02:03.25,Caption,,0,0,0,,РИСКА, В ВЕРХОВНОЙ РАДЕ УЖЕ ИЩУТ ЮРИДИЧЕСКИЙ ПРОХОД К
Dialogue: 0,0:02:03.25,0:02:05.97,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНОМУ КОМПРОМИССУ. ДЕПУТАТ ГЕОРГИЙ
Dialogue: 0,0:02:05.97,0:02:08.69,Caption,,0,0,0,,МАЗУРАШУ ДОПУСТИЛ ИЗМЕНЕНИЕ ГРАНИЦ ДОНЕЦКОЙ И
Dialogue: 0,0:02:08.69,0:02:11.33,Caption,,0,0,0,,ЛУГАНСКОЙ ОБЛАСТЕЙ ПО ФАКТИЧЕСКОЙ ЛИНИИ БОЕВЫХ
Dialogue: 0,0:02:11.41,0:02:15.17,Caption,,0,0,0,,ДЕЙСТВИЙ, ЕСЛИ ЭТО ОБЕСПЕЧИТ УСТОЙЧИВЫЙ МИР. КОНСТИТУЦИЮ ВО
Dialogue: 0,0:02:15.25,0:02:17.41,Caption,,0,0,0,,ВРЕМЯ ВОЕННОГО ПОЛОЖЕНИЯ МЕНЯТЬ НЕЛЬЗЯ,
Dialogue: 0,0:02:17.65,0:02:20.77,Caption,,0,0,0,,ОДНАКО ПОДРОБНАЯ КАРТА КАЖДОГО НАСЕЛЁННОГО ПУНКТА В
Dialogue: 0,0:02:20.85,0:02:25.17,Caption,,0,0,0,,НЕЙ НЕ ЗАПИСАНА. ЗНАЧИТ, ТЕХНИЧЕСКУЮ ФОРМУ ПРИ ЖЕЛАНИИ НАЙТИ МОЖНО.
Dialogue: 0,0:02:27.45,0:02:30.41,Caption,,0,0,0,,ДЛЯ УКРАИНСКОЙ ПОЛИТИКИ ЭТО СЕРЬЁЗНЫЙ СДВИГ. НЕДАВНО
Dialogue: 0,0:02:30.41,0:02:32.73,Caption,,0,0,0,,РАЗГОВОР О ТЕРРИТОРИЯХ ОЗНАЧАЛ БЫ МГНОВЕННОЕ
Dialogue: 0,0:02:32.73,0:02:35.53,Caption,,0,0,0,,УНИЧТОЖЕНИЕ КАРЬЕРЫ. ТЕПЕРЬ ДЕПУТАТ НЕ ПРОСТО
Dialogue: 0,0:02:35.53,0:02:38.01,Caption,,0,0,0,,ПРОИЗНОСИТ ЗАПРЕТНУЮ МЫСЛЬ, А ПРИКИДЫВАЕТ,
Dialogue: 0,0:02:38.25,0:02:41.61,Caption,,0,0,0,,ЧЕРЕЗ КАКУЮ ПРАВОВУЮ ДВЕРЬ ЕЁ ПРОВЕСТИ. ОДНАКО СЛОВО
Dialogue: 0,0:02:41.61,0:02:46.49,Caption,,0,0,0,,"ОБСУЖДАТЬ" НЕ ОЗНАЧАЕТ, ЧТО РОССИЯ СОБИРАЕТСЯ ЧТО ЛИБО ВОЗВРАЩАТЬ. СТОРОНЫ
Dialogue: 0,0:02:46.57,0:02:48.81,Caption,,0,0,0,,МОГУТ ОБСУЖДАТЬ ПЕРЕДАЧУ КОНТРОЛЯ КИЕВУ,
Dialogue: 0,0:02:49.05,0:02:53.45,Caption,,0,0,0,,А МОГУТ ФИКСИРОВАТЬ РУБЕЖ, ДАЛЬШЕ КОТОРОГО НИКТО НЕ ДВИЖЕТСЯ. ФОРМУЛИРОВКА
Dialogue: 0,0:02:53.45,0:02:56.57,Caption,,0,0,0,,ОДНА, РЕЗУЛЬТАТ ОТЛИЧАЕТСЯ ПРИМЕРНО КАК КВАРТИРА И
Dialogue: 0,0:02:56.57,0:02:59.13,Caption,,0,0,0,,ОБЕЩАНИЕ КОГДА НИБУДЬ ПОКАЗАТЬ ОТ НЕЁ КЛЮЧИ.
Dialogue: 0,0:03:01.41,0:03:03.49,Caption,,0,0,0,,СЛЕДОМ ТАРАС ЧМУТ ПРОИЗНЁС ВЕЩЬ,
Dialogue: 0,0:03:03.73,0:03:06.05,Caption,,0,0,0,,ОТ КОТОРОЙ В ЕВРОПЕЙСКИХ КАБИНЕТАХ НАВЕРНЯКА
Dialogue: 0,0:03:06.13,0:03:11.41,Caption,,0,0,0,,ЗАСКРИПЕЛИ КРЕСЛА. ЧЕЛОВЕК, МНОГО ЛЕТ СВЯЗАННЫЙ С ПОДДЕРЖКОЙ УКРАИНСКОЙ АРМИИ,
Dialogue: 0,0:03:11.65,0:03:14.61,Caption,,0,0,0,,ПОСТАВИЛ ВОПРОС РЕБРОМ ЕСЛИ ЗАПАД ЗАСТАВИТ КИЕВ
Dialogue: 0,0:03:14.61,0:03:19.01,Caption,,0,0,0,,УСТУПИТЬ ТЕРРИТОРИИ, ПОЧЕМУ УКРАИНА ДОЛЖНА СОХРАНЯТЬ ПРЕЖНИХ СОЮЗНИКОВ?
Dialogue: 0,0:03:19.31,0:03:22.37,Caption,,0,0,0,,ОН НАЗВАЛ КИТАЙ, ИРАН И СЕВЕРНУЮ КОРЕЮ,
Dialogue: 0,0:03:22.67,0:03:25.73,Caption,,0,0,0,,А ЗАТЕМ ДОШЁЛ ДО САМОГО НЕУДОБНОГО ВАРИАНТА. УКРАИНА
Dialogue: 0,0:03:25.73,0:03:28.69,Caption,,0,0,0,,СПОСОБНА СБЛИЗИТЬСЯ С РОССИЕЙ И ВЫСТУПИТЬ ВМЕСТЕ С
Dialogue: 0,0:03:28.69,0:03:34.64,Caption,,0,0,0,,НЕЙ ПРОТИВ ЕВРОПЫ. ЧМУТ НЕ СОБИРАЕТ ПОЛКИ ДЛЯ ПОХОДА НА БРЮССЕЛЬ.
Dialogue: 0,0:03:35.02,0:03:37.04,Caption,,0,0,0,,ОН ПОКАЗЫВАЕТ, КУДА ВЕДЁТ ПОРЯДОК,
Dialogue: 0,0:03:37.28,0:03:40.16,Caption,,0,0,0,,ОСНОВАННЫЙ ИСКЛЮЧИТЕЛЬНО НА СИЛЕ. НО СЛУЧАЙНОЙ
Dialogue: 0,0:03:40.16,0:03:43.36,Caption,,0,0,0,,ШУТКОЙ ЕГО СЛОВА НЕ НАЗОВЁШЬ. РОССИЯ И УКРАИНА
Dialogue: 0,0:03:43.36,0:03:46.00,Caption,,0,0,0,,СТОЛЕТИЯМИ СУЩЕСТВОВАЛИ В ОБЩИХ ГОСУДАРСТВАХ,
Dialogue: 0,0:03:46.32,0:03:48.00,Caption,,0,0,0,,СОЗДАВАЛИ СВЯЗАННУЮ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:03:48.24,0:03:51.04,Caption,,0,0,0,,СЛУЖИЛИ В ОДНИХ АРМИЯХ И ОБЗАВЕЛИСЬ МИЛЛИОНАМИ
Dialogue: 0,0:03:51.04,0:03:54.64,Caption,,0,0,0,,РОДСТВЕННЫХ СВЯЗЕЙ. ТЯЖЕЛЕЙШИЙ КОНФЛИКТ НЕ СТИРАЕТ
Dialogue: 0,0:03:54.64,0:03:57.44,Caption,,0,0,0,,ЭТУ ОСНОВУ ВОЛШЕБНЫМ ЛАСТИКОМ. ОН ЗАЛИВАЕТ ЕЁ
Dialogue: 0,0:03:57.44,0:04:01.12,Caption,,0,0,0,,КРОВЬЮ, НО ИСТОРИЯ УМЕЕТ ПЕРЕЖИВАТЬ ГРОМКИЕ ЧЕЛОВЕЧЕСКИЕ
Dialogue: 0,0:04:01.12,0:04:06.43,Caption,,0,0,0,,КЛЯТВЫ. СОЮЗ МОСКВЫ И КИЕВА ВЫГЛЯДИТ НЕМЫСЛИМЫМ,
Dialogue: 0,0:04:06.64,0:04:09.55,Caption,,0,0,0,,ПОКА ВСЁ ВОКРУГ КРИЧИТ О ВЕЧНОЙ ВРАЖДЕ. ОДНАКО
Dialogue: 0,0:04:09.63,0:04:12.83,Caption,,0,0,0,,ДЛЯ ЕВРОПЫ ТАКОЙ ПОВОРОТ БЫЛ БЫ КОШМАРОМ. РОССИЙСКИЕ
Dialogue: 0,0:04:12.83,0:04:15.39,Caption,,0,0,0,,РЕСУРСЫ, УКРАИНСКОЕ СЕЛЬСКОЕ ХОЗЯЙСТВО,
Dialogue: 0,0:04:15.63,0:04:21.15,Caption,,0,0,0,,ОБЩЕЕ ПРОМЫШЛЕННОЕ НАСЛЕДИЕ, ОГРОМНЫЕ ТЕРРИТОРИИ И ВОЕННЫЙ ОПЫТ СОЗДАЛИ БЫ СИЛУ,
Dialogue: 0,0:04:21.39,0:04:23.39,Caption,,0,0,0,,С КОТОРОЙ НЕ ПОЛУЧИТСЯ РАЗГОВАРИВАТЬ ЧЕРЕЗ
Dialogue: 0,0:04:23.39,0:04:26.11,Caption,,0,0,0,,ПРИОТКРЫТУЮ ДВЕРЬ. ЕВРОПЕЙСКИМ СТОЛИЦАМ ПРИШЛОСЬ БЫ
Dialogue: 0,0:04:26.19,0:04:29.07,Caption,,0,0,0,,ВСПОМНИТЬ, ЧТО ОБЕЩАНИЯ ИМЕЮТ СРОК ГОДНОСТИ,
Dialogue: 0,0:04:29.32,0:04:32.11,Caption,,0,0,0,,ОСОБЕННО КОГДА ИХ ГОДАМИ ВЫДАЮТ ВМЕСТО РЕЗУЛЬТАТА.
Dialogue: 0,0:04:34.38,0:04:38.38,Caption,,0,0,0,,НИКТО НЕ ЗНАЕТ, КАКАЯ ВЛАСТЬ ПОЯВИТСЯ ПОСЛЕ ЗЕЛЕНСКОГО. НОВОЕ
Dialogue: 0,0:04:38.46,0:04:42.46,Caption,,0,0,0,,РУКОВОДСТВО МОЖЕТ СПРОСИТЬ, ЧТО СТРАНА ПОЛУЧИЛА ЗА ЕВРОПЕЙСКИЙ КУРС,
Dialogue: 0,0:04:42.64,0:04:46.62,Caption,,0,0,0,,КРОМЕ УСЛОВИЙ, ОГРАНИЧЕНИЙ ДЛЯ ЗЕРНА И БЕСКОНЕЧНОГО ОЖИДАНИЯ.
Dialogue: 0,0:04:46.91,0:04:49.66,Caption,,0,0,0,,ПЕРСПЕКТИВА ЧЛЕНСТВА В ЕВРОСОЮЗЕ ОТОДВИГАЕТСЯ КАК
Dialogue: 0,0:04:49.66,0:04:53.74,Caption,,0,0,0,,МИНИМУМ НА ДЕСЯТЬ ЛЕТ, ДА И ПОСЛЕ ЭТОГО ГАРАНТИРОВАННОГО БИЛЕТА НИКТО НЕ
Dialogue: 0,0:04:53.74,0:04:56.06,Caption,,0,0,0,,ОБЕЩАЕТ. КИЕВ ЗОВУТ В ОБЩИЙ ДОМ,
Dialogue: 0,0:04:56.38,0:04:59.18,Caption,,0,0,0,,НО КЛЮЧИ ДЕРЖАТ ВНУТРИ И СОВЕТУЮТ ГОСТЮ СОХРАНЯТЬ
Dialogue: 0,0:04:59.18,0:05:01.26,Caption,,0,0,0,,ОПТИМИЗМ ВОЗЛЕ ЗАКРЫТОГО ПОДЪЕЗДА.
Dialogue: 0,0:05:03.53,0:05:07.69,Caption,,0,0,0,,ВЕНГРИЯ ПОКАЗЫВАЕТ, НАСКОЛЬКО НЕПРОЧНА СКАЗКА О СКОРОМ ВСТУПЛЕНИИ.
Dialogue: 0,0:05:08.00,0:05:10.81,Caption,,0,0,0,,УКРАИНСКОЕ ПРОДВИЖЕНИЕ БЛОКИРУЕТСЯ ВСЛЕДСТВИЕ СПОРА
Dialogue: 0,0:05:10.89,0:05:13.53,Caption,,0,0,0,,О ПРАВАХ ВЕНГРОВ ЗАКАРПАТЬЯ. ПОКАЗАТЕЛЬНО,
Dialogue: 0,0:05:13.77,0:05:16.65,Caption,,0,0,0,,ЧТО ЖЁСТКУЮ ОЦЕНКУ ГОТОВНОСТИ КИЕВА ОЗВУЧИВАЕТ УЖЕ
Dialogue: 0,0:05:16.65,0:05:19.37,Caption,,0,0,0,,ПЕТЕР МАДЬЯР. ВСЕ ПРОБЛЕМЫ ДОЛГО СВАЛИВАЛИ НА
Dialogue: 0,0:05:19.45,0:05:21.37,Caption,,0,0,0,,ВИКТОРА ОРБАНА СМЕНИТСЯ ФАМИЛИЯ,
Dialogue: 0,0:05:21.45,0:05:24.01,Caption,,0,0,0,,И ЗАИГРАЕТ МУЗЫКА. ФАМИЛИЯ СМЕНИЛАСЬ,
Dialogue: 0,0:05:24.21,0:05:27.37,Caption,,0,0,0,,МУЗЫКА НЕ ЗАИГРАЛА. НАЦИОНАЛЬНЫЕ ИНТЕРЕСЫ НЕ ВЫНОСЯТ
Dialogue: 0,0:05:27.45,0:05:29.93,Caption,,0,0,0,,ИЗ КАБИНЕТА ВМЕСТЕ СО СТАРЫМ ПИСЬМЕННЫМ СТОЛОМ.
Dialogue: 0,0:05:32.22,0:05:34.62,Caption,,0,0,0,,ИЗ ПОДОБНЫХ ПРЕТЕНЗИЙ И МОЖЕТ ВЫРАСТИ НОВЫЙ
Dialogue: 0,0:05:34.62,0:05:37.66,Caption,,0,0,0,,УКРАИНСКИЙ КУРС. ПОЛЬСКИЕ ОГРАНИЧЕНИЯ НА ЗЕРНО,
Dialogue: 0,0:05:37.90,0:05:39.98,Caption,,0,0,0,,ДАВЛЕНИЕ РАДИ ТЕРРИТОРИАЛЬНЫХ УСТУПОК,
Dialogue: 0,0:05:40.29,0:05:44.46,Caption,,0,0,0,,ВЕНГЕРСКОЕ СОПРОТИВЛЕНИЕ, НЕОПРЕДЕЛЁННОЕ ЧЛЕНСТВО И ОЩУЩЕНИЕ,
Dialogue: 0,0:05:44.62,0:05:48.86,Caption,,0,0,0,,ЧТО СТРАНУ ИСПОЛЬЗОВАЛИ, А ПОСЛЕДСТВИЯ ОСТАВИЛИ ЕЙ. КОГДА ИЗБИРАТЕЛЬ
Dialogue: 0,0:05:48.86,0:05:50.86,Caption,,0,0,0,,ПОТРЕБУЕТ НАЗВАТЬ ПОЛУЧЕННУЮ ВЫГОДУ,
Dialogue: 0,0:05:51.10,0:05:54.06,Caption,,0,0,0,,ОТВЕТ "ЗАТО ВАС ДОЛГО ХВАЛИЛИ" ВРЯД ЛИ ПРОИЗВЕДЁТ
Dialogue: 0,0:05:54.06,0:05:57.10,Caption,,0,0,0,,ФУРОР. ТОГДА СЛОВА ЧМУТА О ПЕРЕСМОТРЕ СОЮЗОВ
Dialogue: 0,0:05:57.10,0:05:59.98,Caption,,0,0,0,,ПЕРЕСТАНУТ ЗВУЧАТЬ КАК НАРОЧНО БРОШЕННАЯ ДЕРЗОСТЬ.
Dialogue: 0,0:06:02.26,0:06:04.42,Caption,,0,0,0,,НО БУДУЩИЕ СОЮЗЫ ОБСУЖДАЮТ ЛЮДИ,
Dialogue: 0,0:06:04.65,0:06:07.38,Caption,,0,0,0,,А С ЛЮДЬМИ У УКРАИНЫ ПОЯВЛЯЕТСЯ ПРОБЛЕМА СТРАШНЕЕ
Dialogue: 0,0:06:07.38,0:06:10.26,Caption,,0,0,0,,ЛЮБОЙ ЗАКРЫТОЙ ДВЕРИ. ВОЛОНТЁР ГЕННАДИЙ ДРУЗЕНКО
Dialogue: 0,0:06:10.26,0:06:12.98,Caption,,0,0,0,,ПОПРОБОВАЛ ОЦЕНИТЬ БЕЗВОЗВРАТНЫЕ ВОЕННЫЕ ПОТЕРИ
Dialogue: 0,0:06:13.06,0:06:15.86,Caption,,0,0,0,,ЧЕРЕЗ ЛОЗОВУЮ В ХАРЬКОВСКОЙ ОБЛАСТИ. ДО БОЕВЫХ
Dialogue: 0,0:06:15.86,0:06:18.26,Caption,,0,0,0,,ДЕЙСТВИЙ ТАМ ПРОЖИВАЛИ ОКОЛО ПЯТИДЕСЯТИ ЧЕТЫРЁХ
Dialogue: 0,0:06:18.26,0:06:20.98,Caption,,0,0,0,,ТЫСЯЧ ЧЕЛОВЕК. ГОРОДСКОЙ МЕМОРИАЛЬНЫЙ СПИСОК
Dialogue: 0,0:06:20.98,0:06:23.46,Caption,,0,0,0,,СОДЕРЖИТ ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ ИМЁН ПОГИБШИХ
Dialogue: 0,0:06:23.46,0:06:26.58,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. С УЧЁТОМ ЕЩЁ НЕ ВНЕСЁННЫХ ПОГИБШИХ И
Dialogue: 0,0:06:26.66,0:06:29.70,Caption,,0,0,0,,ПРОПАВШИХ БЕЗ ВЕСТИ ДРУЗЕНКО ОЦЕНИВАЕТ ПОТЕРИ ГОРОДА
Dialogue: 0,0:06:29.78,0:06:31.30,Caption,,0,0,0,,НЕ МЕНЕЕ ЧЕМ В ТРИСТА ЧЕЛОВЕК.
Dialogue: 0,0:06:33.58,0:06:36.06,Caption,,0,0,0,,ЕСЛИ РАСПРОСТРАНИТЬ ТАКУЮ ДОЛЮ НА ДОВОЕННОЕ
Dialogue: 0,0:06:36.06,0:06:40.06,Caption,,0,0,0,,НАСЕЛЕНИЕ УКРАИНЫ, СОСТАВЛЯВШЕЕ ПРИМЕРНО СОРОК ОДИН С ПОЛОВИНОЙ МИЛЛИОН
Dialogue: 0,0:06:40.06,0:06:43.74,Caption,,0,0,0,,ЧЕЛОВЕК, ПОЛУЧИТСЯ ОКОЛО ДВУХСОТ ТЫСЯЧ ПОГИБШИХ ВОЕННЫХ.
Dialogue: 0,0:06:44.38,0:06:47.50,Caption,,0,0,0,,ВМЕСТЕ С ПРОПАВШИМИ БЕЗ ВЕСТИ ОЦЕНКА БЕЗВОЗВРАТНЫХ
Dialogue: 0,0:06:47.50,0:06:50.62,Caption,,0,0,0,,ПОТЕРЬ ПОДНИМАЕТСЯ К ДИАПАЗОНУ ОТ ДВУХСОТ ДО ТРЁХСОТ
Dialogue: 0,0:06:50.62,0:06:53.66,Caption,,0,0,0,,ТЫСЯЧ. ЭТО НЕ АКАДЕМИЧЕСКОЕ ИССЛЕДОВАНИЕ И НЕ
Dialogue: 0,0:06:53.66,0:06:58.38,Caption,,0,0,0,,ГОСУДАРСТВЕННАЯ СТАТИСТИКА, А РАСЧЁТ С ДОПУЩЕНИЯМИ. ТОЛЬКО ИМЕНА НА МЕМОРИАЛЕ
Dialogue: 0,0:06:58.46,0:07:00.46,Caption,,0,0,0,,ОТ СЛОВА "ДОПУЩЕНИЕ" НЕ ИСЧЕЗАЮТ.
Dialogue: 0,0:07:02.65,0:07:05.85,Caption,,0,0,0,,БОЛЬШИЕ ЧИСЛА БЫСТРО ПРЕВРАЩАЮТСЯ В ГУЛ. ДВЕСТИ
Dialogue: 0,0:07:05.93,0:07:10.97,Caption,,0,0,0,,ТЫСЯЧ ЗВУЧИТ СТРАШНО, НО МОЗГ ЗАЩИЩАЕТСЯ И УБИРАЕТ ЦИФРУ ПОДАЛЬШЕ. ДВЕСТИ
Dialogue: 0,0:07:10.97,0:07:13.53,Caption,,0,0,0,,СЕМЬДЕСЯТ СЕМЬ ИМЁН В ОДНОМ ГОРОДЕ УЖЕ ИМЕЮТ
Dialogue: 0,0:07:13.53,0:07:17.45,Caption,,0,0,0,,АДРЕС, ЗНАКОМЫЕ ЛИЦА И ПУСТЫЕ МЕСТА ЗА СТОЛОМ. ОДИН
Dialogue: 0,0:07:17.45,0:07:19.77,Caption,,0,0,0,,ГОРОД НЕ МОЖЕТ ИДЕАЛЬНО ОПИСАТЬ ВСЮ СТРАНУ,
Dialogue: 0,0:07:19.94,0:07:23.21,Caption,,0,0,0,,ЗАТО СНИМАЕТ УДОБНУЮ ДИСТАНЦИЮ. ПОБЕДА ОСТАЁТСЯ
Dialogue: 0,0:07:23.21,0:07:26.33,Caption,,0,0,0,,ГРОМКИМ СЛОВОМ, НО РЯДОМ С НЕЙ ПОЯВЛЯЕТСЯ ЦЕННИК,
Dialogue: 0,0:07:26.57,0:07:28.49,Caption,,0,0,0,,КОТОРЫЙ РАНЬШЕ ДЕРЖАЛИ ПОД ПРИЛАВКОМ.
Dialogue: 0,0:07:30.76,0:07:33.32,Caption,,0,0,0,,ВОЕННЫЕ ПОТЕРИ НАКЛАДЫВАЮТСЯ НА ДЕМОГРАФИЧЕСКИЙ
Dialogue: 0,0:07:33.40,0:07:36.12,Caption,,0,0,0,,ПРОВАЛ. ПО ОЦЕНКЕ ЖУРНАЛИСТА ДМИТРИЯ ГНАПА,
Dialogue: 0,0:07:36.36,0:07:38.92,Caption,,0,0,0,,В ПЕРВОЙ ПОЛОВИНЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОГО ГОДА
Dialogue: 0,0:07:38.92,0:07:41.56,Caption,,0,0,0,,ЧИСЛО УМЕРШИХ ОКАЗАЛОСЬ СВЫШЕ ЧЕМ В ТРИ РАЗА
Dialogue: 0,0:07:41.64,0:07:44.36,Caption,,0,0,0,,БОЛЬШЕ ЧИСЛА РОДИВШИХСЯ. ОДНОВРЕМЕННО МИЛЛИОНЫ
Dialogue: 0,0:07:44.36,0:07:47.48,Caption,,0,0,0,,УКРАИНЦЕВ ЗАКРЕПЛЯЮТСЯ ЗА ГРАНИЦЕЙ. У НИХ ПОЯВЛЯЮТСЯ
Dialogue: 0,0:07:47.48,0:07:52.60,Caption,,0,0,0,,РАБОТА, ЖИЛЬЁ, ШКОЛЫ ДЛЯ ДЕТЕЙ И НОВАЯ ПРИВЫЧНАЯ СРЕДА. ВОЗВРАЩАТЬ
Dialogue: 0,0:07:52.60,0:07:55.24,Caption,,0,0,0,,ПРИДЁТСЯ НЕ ПАССАЖИРОВ С ЧЕМОДАНАМИ НА ПЛАТФОРМЕ,
Dialogue: 0,0:07:55.51,0:07:58.20,Caption,,0,0,0,,А ЛЮДЕЙ, КОТОРЫЕ УЖЕ ВЫБРАЛИ ДРУГУЮ ЖИЗНЬ.
Dialogue: 0,0:08:00.48,0:08:03.45,Caption,,0,0,0,,КИЕВСКИЙ ИНСТИТУТ ДЕМОГРАФИИ НАЗЫВАЕТ ПРОИСХОДЯЩЕЕ
Dialogue: 0,0:08:03.45,0:08:07.21,Caption,,0,0,0,,УГРОЗОЙ БУДУЩЕМУ СТРАНЫ. ВЛАСТИ ОТВЕЧАЮТ СОЗДАНИЕМ
Dialogue: 0,0:08:07.21,0:08:10.09,Caption,,0,0,0,,КООРДИНАЦИОННОГО ШТАБА НА СЛУЧАЙ МАССОВОГО ПРИБЫТИЯ
Dialogue: 0,0:08:10.09,0:08:12.89,Caption,,0,0,0,,ИНОСТРАНЦЕВ. ГНАП ВИДИТ В ЭТОМ ПОДГОТОВКУ К
Dialogue: 0,0:08:12.89,0:08:15.53,Caption,,0,0,0,,ЗАПОЛНЕНИЮ ДЕМОГРАФИЧЕСКИХ И ТРУДОВЫХ ПРОВАЛОВ
Dialogue: 0,0:08:15.53,0:08:18.41,Caption,,0,0,0,,ПРИЕЗЖИМИ. ПОЛУЧАЕТСЯ ПОЧТИ ИДЕАЛЬНАЯ РАБОТА
Dialogue: 0,0:08:18.41,0:08:20.81,Caption,,0,0,0,,ГОСУДАРСТВЕННОЙ МАШИНЫ. СОБСТВЕННЫХ ГРАЖДАН
Dialogue: 0,0:08:20.81,0:08:24.73,Caption,,0,0,0,,СТАНОВИТСЯ МЕНЬШЕ, ЗАТО СОВЕЩАНИЕ О ЗАМЕНЕ УЖЕ МОЖНО ОТКРЫТЬ ПО
Dialogue: 0,0:08:24.73,0:08:29.29,Caption,,0,0,0,,РЕГЛАМЕНТУ. ЛЮДЕЙ ПОКА НЕТ, НО ПАПКА ДЛЯ ПРОТОКОЛА НАВЕРНЯКА НАЙДЁТСЯ.
Dialogue: 0,0:08:31.57,0:08:34.29,Caption,,0,0,0,,ИРИНА ВЕРЕЩУК ДОБАВЛЯЕТ ПРЕДУПРЕЖДЕНИЕ БЫСТРОГО
Dialogue: 0,0:08:34.29,0:08:37.25,Caption,,0,0,0,,ОКОНЧАНИЯ КОНФЛИКТА ЖДАТЬ НЕ СЛЕДУЕТ. РОССИЯ
Dialogue: 0,0:08:37.25,0:08:39.81,Caption,,0,0,0,,УВЕЛИЧИВАЕТ ПРОИЗВОДСТВО РАКЕТ И БЕСПИЛОТНИКОВ,
Dialogue: 0,0:08:40.07,0:08:42.45,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКАЯ ИНФРАСТРУКТУРА ПОВРЕЖДЕНА,
Dialogue: 0,0:08:42.70,0:08:47.81,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ УСЛОЖНЯЕТСЯ, НАСЕЛЕНИЮ РЕКОМЕНДУЮТ ИМЕТЬ ЗАПАС ВОДЫ И НЕОБХОДИМЫХ
Dialogue: 0,0:08:47.81,0:08:51.17,Caption,,0,0,0,,ВЕЩЕЙ. ПОТЕРИ ПРОДОЛЖАЮТСЯ, РОЖДЕНИЙ МАЛО,
Dialogue: 0,0:08:51.41,0:08:54.13,Caption,,0,0,0,,УЕХАВШИЕ ВСЁ ПРОЧНЕЕ УСТРАИВАЮТСЯ ЗА РУБЕЖОМ,
Dialogue: 0,0:08:54.37,0:08:57.57,Caption,,0,0,0,,А ГОРИЗОНТ ОБЛЕГЧЕНИЯ ОТОДВИГАЕТСЯ. ПРИ ЭТОМ РЕЧИ О
Dialogue: 0,0:08:57.57,0:09:01.01,Caption,,0,0,0,,ВЕЛИЧИИ ЗВУЧАТ ИСПРАВНО. СЛОВА УДИВИТЕЛЬНО ЖИВУЧИЕ,
Dialogue: 0,0:09:01.25,0:09:03.81,Caption,,0,0,0,,ИМ НИ ОТОПЛЕНИЕ, НИ ЛЮДИ НЕ ТРЕБУЮТСЯ.
Dialogue: 0,0:09:06.08,0:09:08.48,Caption,,0,0,0,,ХОЗЯЙСТВЕННЫЕ ПОКАЗАТЕЛИ ДЕЛАЮТ КАРТИНУ ЕЩЁ
Dialogue: 0,0:09:08.48,0:09:10.88,Caption,,0,0,0,,ВЫРАЗИТЕЛЬНЕЕ. ПРОМЫШЛЕННОЕ ПОТРЕБЛЕНИЕ
Dialogue: 0,0:09:10.96,0:09:13.60,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА СОКРАТИЛОСЬ НА ДВАДЦАТЬ ТРИ ПРОЦЕНТА,
Dialogue: 0,0:09:13.84,0:09:16.72,Caption,,0,0,0,,А ДЕВЯНОСТО ПРОЦЕНТОВ МЕТАЛЛУРГИЧЕСКИХ МОЩНОСТЕЙ
Dialogue: 0,0:09:16.80,0:09:20.56,Caption,,0,0,0,,ОСТАНОВЛЕНЫ ЛИБО ПОВРЕЖДЕНЫ. СПРОС ПРЕДПРИЯТИЙ УПАЛ
Dialogue: 0,0:09:20.56,0:09:23.60,Caption,,0,0,0,,ПРИБЛИЗИТЕЛЬНО НА ПОЛТОРА ГИГАВАТТА. ЭНЕРГОСИСТЕМЕ
Dialogue: 0,0:09:23.68,0:09:27.44,Caption,,0,0,0,,БУДТО СТАЛО ЛЕГЧЕ, ТОЛЬКО ПРИЧИНА НАПОМИНАЕТ ЛЕЧЕНИЕ ГОЛОВНОЙ БОЛИ
Dialogue: 0,0:09:27.44,0:09:30.40,Caption,,0,0,0,,СНЯТИЕМ ГОЛОВЫ. ЭЛЕКТРИЧЕСТВА ТРЕБУЕТСЯ МЕНЬШЕ,
Dialogue: 0,0:09:30.64,0:09:33.28,Caption,,0,0,0,,ПОСКОЛЬКУ ЗАВОДЫ НЕ РАБОТАЮТ. ЕСЛИ ЗАКРЫТЬ
Dialogue: 0,0:09:33.28,0:09:37.36,Caption,,0,0,0,,ОСТАВШИЕСЯ ПРЕДПРИЯТИЯ, ЭКОНОМИЯ ВЫЙДЕТ ОБРАЗЦОВАЯ. ПРАВДА,
Dialogue: 0,0:09:37.45,0:09:40.24,Caption,,0,0,0,,ИСЧЕЗНУТ ПРОИЗВОДСТВО, ЗАРПЛАТЫ И НАЛОГИ,
Dialogue: 0,0:09:40.56,0:09:43.20,Caption,,0,0,0,,НО КАЛЬКУЛЯТОР ТАКИМИ МЕЛОЧАМИ НЕ РАССТРАИВАЕТСЯ.
Dialogue: 0,0:09:45.47,0:09:48.43,Caption,,0,0,0,,ЗАЩИТА ЭНЕРГЕТИЧЕСКИХ ОБЪЕКТОВ В КИЕВСКОЙ ОБЛАСТИ
Dialogue: 0,0:09:48.50,0:09:51.79,Caption,,0,0,0,,ВЫГЛЯДИТ ЕЩЁ ВЕСЕЛЕЕ. РАБОТЫ ОХВАТЫВАЮТ ДВАДЦАТЬ
Dialogue: 0,0:09:51.79,0:09:54.43,Caption,,0,0,0,,ШЕСТЬ ПЛОЩАДОК, А ЗАВЕРШЁННЫХ СООРУЖЕНИЙ,
Dialogue: 0,0:09:54.59,0:09:56.67,Caption,,0,0,0,,ПО СЛОВАМ ДЕПУТАТА АЛЕКСЕЯ КУЧЕРЕНКО,
Dialogue: 0,0:09:56.83,0:10:00.19,Caption,,0,0,0,,НЕТ НИ ОДНОГО. ОБЩАЯ СТОИМОСТЬ СОСТАВЛЯЕТ МИЛЛИАРД
Dialogue: 0,0:10:00.27,0:10:03.15,Caption,,0,0,0,,ВОСЕМЬСОТ МИЛЛИОНОВ ГРИВЕН. ПОДРЯДЧИКИ ПОЛУЧИЛИ
Dialogue: 0,0:10:03.15,0:10:06.51,Caption,,0,0,0,,СЕМЬСОТ ПЯТЬДЕСЯТ МИЛЛИОНОВ АВАНСА И ЗАПРОСИЛИ ЕЩЁ
Dialogue: 0,0:10:06.59,0:10:09.39,Caption,,0,0,0,,ЧЕТЫРЕСТА МИЛЛИОНОВ. ПРЕКРАСНЫЙ СЕРВИС ЗАКАЗ НЕ
Dialogue: 0,0:10:09.39,0:10:14.51,Caption,,0,0,0,,ПРИНЕСЛИ, КУХНЯ ЗАКРЫТА, ЗАТО СЧЁТ ОБНОВИЛИ И ВЕЖЛИВО ПРОСЯТ ДОБАВИТЬ НА
Dialogue: 0,0:10:14.51,0:10:18.86,Caption,,0,0,0,,ЧАЙ. ЕСТЬ ДВАДЦАТЬ ШЕСТЬ ОБЪЕКТОВ,
Dialogue: 0,0:10:19.02,0:10:22.46,Caption,,0,0,0,,НОЛЬ ГОТОВОЙ ЗАЩИТЫ И ТРИ ЧЕТВЕРТИ МИЛЛИАРДА ГРИВЕН,
Dialogue: 0,0:10:22.55,0:10:25.10,Caption,,0,0,0,,ПОКИНУВШИЕ ГОСУДАРСТВЕННЫЙ СЧЁТ. ПРЕЖДЕ ЧЕМ
Dialogue: 0,0:10:25.10,0:10:27.82,Caption,,0,0,0,,ОБЪЯСНЯТЬ УЯЗВИМОСТЬ ЭНЕРГЕТИКИ ИСКЛЮЧИТЕЛЬНО СИЛОЙ
Dialogue: 0,0:10:27.82,0:10:31.74,Caption,,0,0,0,,РОССИЙСКИХ УДАРОВ, НЕПЛОХО БЫЛО БЫ ЗАКОНЧИТЬ ХОТЯ БЫ ОДНО СООРУЖЕНИЕ.
Dialogue: 0,0:10:32.14,0:10:34.46,Caption,,0,0,0,,ИНОГДА ВНЕШНЕМУ ПРОТИВНИКУ ОСТАЁТСЯ ПРОСТО НЕ
Dialogue: 0,0:10:34.46,0:10:37.66,Caption,,0,0,0,,МЕШАТЬ. ВНУТРЕННИЕ СПЕЦИАЛИСТЫ ПО ПРЕВРАЩЕНИЮ ДЕНЕГ
Dialogue: 0,0:10:37.74,0:10:44.33,Caption,,0,0,0,,В ОБЕЩАНИЯ СПРАВЛЯЮТСЯ САМИ. КИЕВ ТЕМ ВРЕМЕНЕМ ОТКЛЮЧАЕТ НАРУЖНОЕ ОСВЕЩЕНИЕ И
Dialogue: 0,0:10:44.33,0:10:47.13,Caption,,0,0,0,,НАПРАВЛЯЕТ ДОСТУПНУЮ МОЩНОСТЬ НА КРИТИЧЕСКИ ВАЖНЫЕ
Dialogue: 0,0:10:47.13,0:10:50.01,Caption,,0,0,0,,ОБЪЕКТЫ. ВОДИТЕЛЕЙ ПРОСЯТ СНИЖАТЬ СКОРОСТЬ,
Dialogue: 0,0:10:50.25,0:10:53.29,Caption,,0,0,0,,ПЕШЕХОДОВ ПОЛЬЗОВАТЬСЯ ФОНАРЯМИ И СВЕТОВОЗВРАЩАЮЩИМИ
Dialogue: 0,0:10:53.29,0:10:56.25,Caption,,0,0,0,,ЭЛЕМЕНТАМИ. ТЕМНОТА СТАНОВИТСЯ ИТОГОВОЙ ИЛЛЮСТРАЦИЕЙ
Dialogue: 0,0:10:56.25,0:10:59.21,Caption,,0,0,0,,ВСЕЙ АРИФМЕТИКИ ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ ИМЁН В ОДНОМ
Dialogue: 0,0:10:59.21,0:11:02.65,Caption,,0,0,0,,ГОРОДЕ, ДО ТРЁХСОТ ТЫСЯЧ БЕЗВОЗВРАТНЫХ ПОТЕРЬ ПО ОЦЕНКЕ
Dialogue: 0,0:11:02.65,0:11:05.53,Caption,,0,0,0,,ДРУЗЕНКО, ТРЁХКРАТНЫЙ ДЕМОГРАФИЧЕСКИЙ РАЗРЫВ,
Dialogue: 0,0:11:05.85,0:11:10.89,Caption,,0,0,0,,ОСТАНОВЛЕННАЯ МЕТАЛЛУРГИЯ, ДВАДЦАТЬ ШЕСТЬ ПЛОЩАДОК БЕЗ ГОТОВОЙ ЗАЩИТЫ И СОТНИ
Dialogue: 0,0:11:10.89,0:11:12.57,Caption,,0,0,0,,МИЛЛИОНОВ ВЫПЛАЧЕННОГО АВАНСА.
Dialogue: 0,0:11:14.84,0:11:17.64,Caption,,0,0,0,,ТРАНСФОРМАТОР МОЖНО ЗАМЕНИТЬ, ФОНАРИ ВКЛЮЧИТЬ,
Dialogue: 0,0:11:17.88,0:11:19.72,Caption,,0,0,0,,БЕТОННОЕ СООРУЖЕНИЕ ДОСТРОИТЬ,
Dialogue: 0,0:11:19.96,0:11:22.36,Caption,,0,0,0,,ЕСЛИ ДЕНЬГИ ОДНАЖДЫ ПОЗНАКОМЯТСЯ СО СТРОЙКОЙ.
Dialogue: 0,0:11:22.76,0:11:25.24,Caption,,0,0,0,,ПОГИБШЕГО ЧЕЛОВЕКА НЕ ВЕРНЁТ НИ ПОДРЯДЧИК,
Dialogue: 0,0:11:25.48,0:11:28.52,Caption,,0,0,0,,НИ МЕЖДУНАРОДНЫЙ ТРАНШ. УЕХАВШУЮ СЕМЬЮ ТОЖЕ НЕ
Dialogue: 0,0:11:28.60,0:11:31.64,Caption,,0,0,0,,ЗАМАНИШЬ НАЗАД ТОРЖЕСТВЕННОЙ РЕЧЬЮ. СТРАНЕ МАЛО
Dialogue: 0,0:11:31.64,0:11:34.52,Caption,,0,0,0,,ДОЖДАТЬСЯ ПОБЕДНОГО ВЫСТУПЛЕНИЯ. НУЖНЫ ЛЮДИ,
Dialogue: 0,0:11:34.68,0:11:36.60,Caption,,0,0,0,,КОТОРЫЕ СМОГУТ ЕГО УСЛЫШАТЬ ДОМА,
Dialogue: 0,0:11:36.76,0:11:38.76,Caption,,0,0,0,,А НЕ ИЗ ЧУЖОЙ СТРАНЫ ИЛИ С ФОТОГРАФИИ
Dialogue: 0,0:11:38.84,0:11:43.90,Caption,,0,0,0,,НА МЕМОРИАЛЕ. И НА ЭТОМ ФОНЕ НАЧИНАЕТСЯ СПОР О ТОМ,
Dialogue: 0,0:11:43.99,0:11:46.70,Caption,,0,0,0,,КТО БУДЕТ ОПРЕДЕЛЯТЬ ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ.
Dialogue: 0,0:11:46.98,0:11:49.42,Caption,,0,0,0,,МОСКВА ПРЕДЛАГАЕТ ГОСУДАРСТВАМ НАТО ЗАКЛЮЧАТЬ
Dialogue: 0,0:11:49.42,0:11:52.30,Caption,,0,0,0,,СОГЛАШЕНИЯ О НЕНАПАДЕНИИ ОТДЕЛЬНО. НЕ СОБИРАТЬ
Dialogue: 0,0:11:52.30,0:11:54.62,Caption,,0,0,0,,БОЛЬШЕ ТРИДЦАТИ СТРАН ВОКРУГ ОДНОГО СТОЛА,
Dialogue: 0,0:11:54.86,0:11:57.50,Caption,,0,0,0,,ГДЕ КАЖДАЯ СТОЛИЦА ПРИНОСИТ СОБСТВЕННЫЕ СТРАХИ И
Dialogue: 0,0:11:57.50,0:11:59.98,Caption,,0,0,0,,ТРЕБОВАНИЯ, А РАЗГОВАРИВАТЬ С ГЕРМАНИЕЙ,
Dialogue: 0,0:12:00.14,0:12:05.18,Caption,,0,0,0,,ФРАНЦИЕЙ, ИТАЛИЕЙ, ПОЛЬШЕЙ И ОСТАЛЬНЫМИ ПО ОЧЕРЕДИ. ЕВРОПА ТРЕБУЕТ
Dialogue: 0,0:12:05.18,0:12:08.22,Caption,,0,0,0,,ЕДИНОГО МЕСТА НА ПЕРЕГОВОРАХ, НО САМА НЕ ВЫЯСНИЛА,
Dialogue: 0,0:12:08.38,0:12:10.70,Caption,,0,0,0,,КТО ЗАЙМЁТ ЭТОТ СТУЛ И С КАКОЙ ПАПКОЙ
Dialogue: 0,0:12:10.78,0:12:16.58,Caption,,0,0,0,,ПРИДЁТ. КАЯ КАЛЛАС СЧИТАЕТ СУЩЕСТВУЮЩУЮ СИСТЕМУ ДОСТАТОЧНОЙ
Dialogue: 0,0:12:16.58,0:12:20.50,Caption,,0,0,0,,И УВЕРЯЕТ, ЧТО РОССИИ ГАРАНТИИ НЕ НУЖНЫ. ФРИДРИХ МЕРЦ ХОЧЕТ
Dialogue: 0,0:12:20.50,0:12:24.66,Caption,,0,0,0,,ЕВРОПЕЙСКОГО УЧАСТИЯ, ОДНАКО НОВУЮ КОНСТРУКЦИЮ БЕЗОПАСНОСТИ С МОСКВОЙ
Dialogue: 0,0:12:24.74,0:12:27.62,Caption,,0,0,0,,ОБСУЖДАТЬ НЕ ЖЕЛАЕТ. УРСУЛА ФОН ДЕР ЛЯЙЕН ДОПУСКАЕТ
Dialogue: 0,0:12:27.62,0:12:30.50,Caption,,0,0,0,,БОЛЕЕ ШИРОКИЙ РАЗГОВОР И НАСТАИВАЕТ НА ПОДДЕРЖКЕ
Dialogue: 0,0:12:30.50,0:12:33.38,Caption,,0,0,0,,КИЕВА. АНТОНИУ КОШТА ПРЕДЛАГАЕТ СВОЙ ФОРМАТ.
Dialogue: 0,0:12:33.62,0:12:36.34,Caption,,0,0,0,,ФРАНЦУЗСКИЙ ПОСОЛ ПРИЗНАЁТ ЗАКОННОСТЬ РОССИЙСКОГО
Dialogue: 0,0:12:36.34,0:12:39.30,Caption,,0,0,0,,ТРЕБОВАНИЯ ГАРАНТИЙ. ЭСТОНСКИЙ ПРЕМЬЕР ПРИЗНАЁТ,
Dialogue: 0,0:12:39.53,0:12:42.26,Caption,,0,0,0,,ЧТО НЕЙТРАЛЬНОГО ПОСРЕДНИКА ИЗ ЕВРОПЫ НЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:12:42.57,0:12:45.14,Caption,,0,0,0,,ЭТО НЕ ЕДИНЫЙ ГОЛОС. ЭТО СЕМЕЙНЫЙ СОВЕТ,
Dialogue: 0,0:12:45.38,0:12:47.86,Caption,,0,0,0,,ГДЕ СПОР О НАСЛЕДСТВЕ НАЧАЛСЯ РАНЬШЕ ПОХОРОН.
Dialogue: 0,0:12:50.13,0:12:53.33,Caption,,0,0,0,,ЕДИНЫМ ПРЕДСТАВИТЕЛЕМ КАЛЛАС ТОЖЕ НЕ СТАЛА. ВМЕСТО
Dialogue: 0,0:12:53.33,0:12:56.53,Caption,,0,0,0,,НЕЁ СФОРМИРОВАЛИ ШИРОКУЮ ГРУППУ С УЧАСТИЕМ ГЕРМАНИИ,
Dialogue: 0,0:12:56.61,0:12:59.57,Caption,,0,0,0,,ФРАНЦИИ, ВЕЛИКОБРИТАНИИ, ИТАЛИИ,
Dialogue: 0,0:12:59.68,0:13:03.41,Caption,,0,0,0,,ПОЛЬШИ И ЕВРОПЕЙСКИХ УЧРЕЖДЕНИЙ. ОСОБЕННО ИЗЯЩНО
Dialogue: 0,0:13:03.41,0:13:05.25,Caption,,0,0,0,,ВЫГЛЯДИТ ПРИСУТСТВИЕ ВЕЛИКОБРИТАНИИ,
Dialogue: 0,0:13:05.49,0:13:09.89,Caption,,0,0,0,,КОТОРАЯ ПОКИНУЛА ЕВРОСОЮЗ, НО ПРОДОЛЖАЕТ ПОМОГАТЬ ЕМУ ИЗОБРАЖАТЬ ЕДИНСТВО.
Dialogue: 0,0:13:10.19,0:13:12.85,Caption,,0,0,0,,ДЕЛЕГАЦИЮ СОБРАЛИ, ФАМИЛИИ РАСПРЕДЕЛИЛИ,
Dialogue: 0,0:13:13.09,0:13:15.41,Caption,,0,0,0,,КАМЕРЫ МОЖНО СТАВИТЬ. ОСТАЛОСЬ РЕШИТЬ,
Dialogue: 0,0:13:15.61,0:13:17.65,Caption,,0,0,0,,ЧТО УЧАСТНИКАМ РАЗРЕШЕНО ОБСУЖДАТЬ.
Dialogue: 0,0:13:19.86,0:13:23.38,Caption,,0,0,0,,НЕ ЗАБУДЬТЕ ПОДПИСАТЬСЯ, ЕСЛИ ВАМ ИНТЕРЕСЕН РАЗБОР РЕШЕНИЙ,
Dialogue: 0,0:13:23.62,0:13:26.18,Caption,,0,0,0,,А НЕ СОРЕВНОВАНИЕ ЧИНОВНИКОВ ЗА НАИБОЛЕЕ СЕРЬЁЗНОЕ
Dialogue: 0,0:13:26.18,0:13:29.46,Caption,,0,0,0,,ВЫРАЖЕНИЕ ЛИЦА. ЗДЕСЬ СПИСОК ПРИГЛАШЁННЫХ ВАЖЕН
Dialogue: 0,0:13:29.46,0:13:32.82,Caption,,0,0,0,,МЕНЬШЕ, ЧЕМ ПОЛНОМОЧИЯ, С КОТОРЫМИ ОНИ ВХОДЯТ В ЗАЛ.
Dialogue: 0,0:13:35.01,0:13:37.41,Caption,,0,0,0,,ПОКА ЕВРОПЕЙСКИЕ СТОЛИЦЫ ДЕЛЯТ МИКРОФОН,
Dialogue: 0,0:13:37.57,0:13:40.53,Caption,,0,0,0,,РАЗГОВОР УЖЕ ИДЁТ НА ДРУГОМ УРОВНЕ. НА ПЕРЕГОВОРАХ
Dialogue: 0,0:13:40.61,0:13:42.93,Caption,,0,0,0,,В АБУ ДАБИ ПРИСУТСТВОВАЛ АМЕРИКАНСКИЙ ГЕНЕРАЛ
Dialogue: 0,0:13:42.93,0:13:46.77,Caption,,0,0,0,,АЛЕКСУС ГРИНКЕВИЧ, ГЛАВНОКОМАНДУЮЩИЙ ОБЪЕДИНЁННЫМИ СИЛАМИ НАТО В
Dialogue: 0,0:13:46.77,0:13:49.09,Caption,,0,0,0,,ЕВРОПЕ. СЕРГЕЙ РЯБКОВ ОТМЕТИЛ,
Dialogue: 0,0:13:49.25,0:13:52.21,Caption,,0,0,0,,ЧТО УЧАСТИЕ ТАКОГО ВОЕННОГО СДЕЛАЛО ОБСУЖДЕНИЕ
Dialogue: 0,0:13:52.21,0:13:55.25,Caption,,0,0,0,,БЕЗОПАСНОСТИ ПРОФЕССИОНАЛЬНЕЕ. ЧЕТЫРЁХЗВЁЗДОЧНОГО
Dialogue: 0,0:13:55.25,0:13:58.21,Caption,,0,0,0,,ГЕНЕРАЛА НЕ ВОЗЯТ ЧЕРЕЗ ПОЛМИРА РАДИ УТОЧНЕНИЯ ПАРЫ
Dialogue: 0,0:13:58.29,0:14:01.33,Caption,,0,0,0,,СТРОК В СПИСКЕ ОБМЕНА. ЕГО ПОЯВЛЕНИЕ ОЗНАЧАЕТ,
Dialogue: 0,0:14:01.64,0:14:04.05,Caption,,0,0,0,,ЧТО ОТНОШЕНИЯ РОССИИ И НАТО НАХОДЯТСЯ ВНУТРИ
Dialogue: 0,0:14:04.05,0:14:07.09,Caption,,0,0,0,,ПЕРЕГОВОРОВ, А НЕ ЛЕЖАТ ПРИЛОЖЕНИЕМ В КОНЦЕ ПАПКИ.
Dialogue: 0,0:14:09.36,0:14:11.60,Caption,,0,0,0,,РЯБКОВ ПРЕДСТАВЛЯЛ РОССИЙСКИЕ ПРЕДЛОЖЕНИЯ ПО
Dialogue: 0,0:14:11.60,0:14:14.08,Caption,,0,0,0,,ГАРАНТИЯМ БЕЗОПАСНОСТИ ЕЩЁ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:14:14.16,0:14:16.88,Caption,,0,0,0,,ПЕРВОМ ГОДУ. ТОГДА МОСКВА СТАВИЛА ВОПРОСЫ О
Dialogue: 0,0:14:16.88,0:14:21.36,Caption,,0,0,0,,РАСШИРЕНИИ НАТО, РАЗМЕЩЕНИИ ВОЙСК И ИНФРАСТРУКТУРЫ АЛЬЯНСА. ТЕПЕРЬ
Dialogue: 0,0:14:21.44,0:14:23.92,Caption,,0,0,0,,ТОТ ЖЕ ДИПЛОМАТ ОБСУЖДАЕТ УСТРОЙСТВО ЕВРОПЕЙСКОЙ
Dialogue: 0,0:14:23.92,0:14:27.12,Caption,,0,0,0,,БЕЗОПАСНОСТИ РЯДОМ С ВЫСШИМ ВОЕННЫМ КОМАНДОВАНИЕМ
Dialogue: 0,0:14:27.20,0:14:30.08,Caption,,0,0,0,,НАТО. УКРАИНСКИЙ КОНФЛИКТ ПОДНИМАЕТСЯ С УРОВНЯ ЛИНИИ
Dialogue: 0,0:14:30.16,0:14:34.40,Caption,,0,0,0,,ФРОНТА НА УРОВЕНЬ ПРАВИЛ, ПО КОТОРЫМ РОССИЯ И СЕВЕРОАТЛАНТИЧЕСКИЙ АЛЬЯНС
Dialogue: 0,0:14:34.55,0:14:36.56,Caption,,0,0,0,,СОБИРАЮТСЯ СУЩЕСТВОВАТЬ ПОСЛЕ НЕГО.
Dialogue: 0,0:14:38.83,0:14:41.63,Caption,,0,0,0,,ВЕРНУЛОСЬ И ТРЕБОВАНИЕ РАССМОТРЕТЬ КОНФИГУРАЦИЮ НАТО
Dialogue: 0,0:14:41.71,0:14:44.67,Caption,,0,0,0,,НА ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОЙ ГОД. ЗНАЧИТ,
Dialogue: 0,0:14:44.82,0:14:47.87,Caption,,0,0,0,,СПОР КАСАЕТСЯ НЕ ТОЛЬКО ВОЗМОЖНОГО ЧЛЕНСТВА УКРАИНЫ.
Dialogue: 0,0:14:48.26,0:14:51.87,Caption,,0,0,0,,РЕЧЬ ИДЁТ О ВОЕННЫХ ОБЪЕКТАХ, СИЛАХ И СИСТЕМЕ КОМАНДОВАНИЯ,
Dialogue: 0,0:14:52.16,0:14:54.83,Caption,,0,0,0,,ПОЯВИВШИХСЯ ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ ПОСЛЕ ХОЛОДНОЙ
Dialogue: 0,0:14:54.91,0:14:58.91,Caption,,0,0,0,,ВОЙНЫ. НА ЭТОМ ФОНЕ СУЕТА ВОКРУГ ФИНЛЯНДИИ И ПРИБАЛТИКИ
Dialogue: 0,0:14:59.07,0:15:01.87,Caption,,0,0,0,,ВЫГЛЯДИТ ВТОРОСТЕПЕННЫМ СПЕКТАКЛЕМ. СНАЧАЛА
Dialogue: 0,0:15:01.87,0:15:04.03,Caption,,0,0,0,,ПУБЛИКУЮТ ЯКОБЫ РОССИЙСКОЕ ТРЕБОВАНИЕ,
Dialogue: 0,0:15:04.35,0:15:06.35,Caption,,0,0,0,,ЗАТЕМ ЕГО ТОРЖЕСТВЕННО ОТВЕРГАЮТ,
Dialogue: 0,0:15:06.58,0:15:10.51,Caption,,0,0,0,,ПОТОМ СПОРЯТ, СУЩЕСТВОВАЛО ЛИ ОНО. ПОБЕДА НАД УСЛОВИЕМ,
Dialogue: 0,0:15:10.75,0:15:14.99,Caption,,0,0,0,,КОТОРОЕ ЕЩЁ ТОЛКОМ НЕ НАШЛИ, ЭТО ВЫСШИЙ РАЗРЯД ЕВРОПЕЙСКОГО УПРАВЛЕНИЯ.
Dialogue: 0,0:15:17.25,0:15:20.21,Caption,,0,0,0,,ФОН ДЕР ЛЯЙЕН ПРИНОСИТ НА СТОЛ ПРЕКРАЩЕНИЕ ОГНЯ,
Dialogue: 0,0:15:20.37,0:15:22.85,Caption,,0,0,0,,ГАРАНТИИ УКРАИНЕ, ВОССТАНОВЛЕНИЕ,
Dialogue: 0,0:15:23.01,0:15:25.65,Caption,,0,0,0,,КОНТРАКТЫ И ФИНАНСИРОВАНИЕ КИЕВА В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:15:25.73,0:15:28.21,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОМ ГОДУ. МОСКВА СТАВИТ ВОПРОС О
Dialogue: 0,0:15:28.21,0:15:31.65,Caption,,0,0,0,,БУДУЩЕМ ВЗАИМОДЕЙСТВИИ ДВУХ ВОЕННЫХ СИСТЕМ. БРЮССЕЛЬ
Dialogue: 0,0:15:31.73,0:15:33.97,Caption,,0,0,0,,ОБСУЖДАЕТ БЛИЖАЙШИЕ УКРАИНСКИЕ РАСХОДЫ,
Dialogue: 0,0:15:34.29,0:15:37.41,Caption,,0,0,0,,А РОССИЯ ПЫТАЕТСЯ ОПРЕДЕЛИТЬ ПРАВИЛА НА ГОДЫ. МЕСТО
Dialogue: 0,0:15:37.41,0:15:40.21,Caption,,0,0,0,,ЗА СТОЛОМ НЕ ЗАМЕНЯЕТ ПОЗИЦИИ. МОЖНО ПОЛУЧИТЬ
Dialogue: 0,0:15:40.29,0:15:42.93,Caption,,0,0,0,,КРАСИВУЮ ТАБЛИЧКУ С ФАМИЛИЕЙ И ВСЁ ЗАСЕДАНИЕ
Dialogue: 0,0:15:43.01,0:15:49.62,Caption,,0,0,0,,ВЫЯСНЯТЬ, ЗАЧЕМ ВАС ПОЗВАЛИ. ГАРАНТИИ УКРАИНЕ ОСТАЮТСЯ ПУСТОЙ ОБОЛОЧКОЙ БЕЗ
Dialogue: 0,0:15:49.70,0:15:52.74,Caption,,0,0,0,,ОТВЕТОВ. В КАКИХ ГРАНИЦАХ БУДЕТ СУЩЕСТВОВАТЬ СТРАНА?
Dialogue: 0,0:15:53.06,0:15:55.30,Caption,,0,0,0,,КАКОЙ ЧИСЛЕННОСТИ ДОСТИГНЕТ ЕЁ АРМИЯ?
Dialogue: 0,0:15:55.54,0:15:59.06,Caption,,0,0,0,,СОХРАНИТСЯ ЛИ КУРС НА НАТО? ПОЯВЯТСЯ ЛИ ИНОСТРАННЫЕ БАЗЫ?
Dialogue: 0,0:15:59.30,0:16:01.70,Caption,,0,0,0,,КТО ПРИДЁТ К ВЛАСТИ ПОСЛЕ ЗЕЛЕНСКОГО И КАКИЕ
Dialogue: 0,0:16:01.70,0:16:05.86,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ПРИЗНАЕТ? ДОБАВЬТЕ СЮДА СЛУХ О СНЯТИИ НЕПРИКОСНОВЕННОСТИ С
Dialogue: 0,0:16:05.86,0:16:09.78,Caption,,0,0,0,,ВЫСШЕГО РУКОВОДСТВА, И БОДРЫЕ ФОРМУЛИРОВКИ НАЧИНАЮТ ЗВУЧАТЬ ТИШЕ.
Dialogue: 0,0:16:09.94,0:16:13.38,Caption,,0,0,0,,ГАРАНТИЯ УБЕДИТЕЛЬНА, КОГДА СТОРОНЫ ОДИНАКОВО ПОНИМАЮТ,
Dialogue: 0,0:16:13.54,0:16:17.54,Caption,,0,0,0,,КОМУ, ЧТО И ОТ КОГО ОНА ГАРАНТИРУЕТ. ЗДЕСЬ ОБЩЕГО
Dialogue: 0,0:16:17.54,0:16:23.42,Caption,,0,0,0,,ПОНИМАНИЯ НЕТ. ДВУСТОРОННИЕ СОГЛАШЕНИЯ ПОЗВОЛЯЮТ МОСКВЕ РАБОТАТЬ С
Dialogue: 0,0:16:23.42,0:16:26.78,Caption,,0,0,0,,ЕВРОПОЙ ТАКОЙ, КАКАЯ ОНА ЕСТЬ МНОЖЕСТВО ГОСУДАРСТВ,
Dialogue: 0,0:16:27.02,0:16:29.58,Caption,,0,0,0,,РАЗНЫЕ ИНТЕРЕСЫ И ОТСУТСТВИЕ ЦЕНТРА,
Dialogue: 0,0:16:29.72,0:16:32.94,Caption,,0,0,0,,СПОСОБНОГО ЗАСТАВИТЬ ВСЕХ ИДТИ ОДНИМ СТРОЕМ. ФРАНЦИЯ
Dialogue: 0,0:16:32.94,0:16:35.10,Caption,,0,0,0,,НЕ СТАНЕТ ВЫПОЛНЯТЬ КОМАНДЫ ГЕРМАНИИ,
Dialogue: 0,0:16:35.34,0:16:37.26,Caption,,0,0,0,,ГЕРМАНИЯ НЕ ПОДЧИНИТСЯ ПОЛЬШЕ,
Dialogue: 0,0:16:37.50,0:16:39.66,Caption,,0,0,0,,ИТАЛИЯ НЕ ОТДАСТ СВОЙ КУРС КАЛЛАС,
Dialogue: 0,0:16:39.90,0:16:42.86,Caption,,0,0,0,,ВЕНГРИЯ СОХРАНИТ СОБСТВЕННЫЕ ТРЕБОВАНИЯ. ОБЩАЯ
Dialogue: 0,0:16:42.86,0:16:45.74,Caption,,0,0,0,,ЖЁСТКАЯ ЛИНИЯ ХОРОШО ВЫГЛЯДИТ НА ГРУППОВОМ СНИМКЕ.
Dialogue: 0,0:16:46.12,0:16:48.54,Caption,,0,0,0,,НА СОВЕЩАНИИ ОНА ПРЕВРАЩАЕТСЯ В ТОРГ,
Dialogue: 0,0:16:48.78,0:16:50.94,Caption,,0,0,0,,ГДЕ КАЖДЫЙ БЕРЕЖЁТ ПРАВО СКАЗАТЬ "НЕТ".
Dialogue: 0,0:16:53.23,0:16:56.27,Caption,,0,0,0,,ОТДЕЛЬНЫЙ ДОГОВОР НЕ ОТМЕНЯЕТ НАТО. У АЛЬЯНСА
Dialogue: 0,0:16:56.27,0:16:58.11,Caption,,0,0,0,,ОСТАНУТСЯ АМЕРИКАНСКИЕ ВОЙСКА,
Dialogue: 0,0:16:58.26,0:17:03.55,Caption,,0,0,0,,ЕДИНОЕ КОМАНДОВАНИЕ, ПЛАНЫ ОБОРОНЫ И ОБЩАЯ ИНФРАСТРУКТУРА. ИМЕННО ПОЭТОМУ
Dialogue: 0,0:17:03.55,0:17:06.75,Caption,,0,0,0,,ПРИСУТСТВИЕ ГРИНКЕВИЧА СТОЛЬ ВАЖНО. НЕЛЬЗЯ ОБСУЖДАТЬ
Dialogue: 0,0:17:06.75,0:17:08.43,Caption,,0,0,0,,ВОЕННОЕ УСТРОЙСТВО КОНТИНЕНТА,
Dialogue: 0,0:17:08.67,0:17:12.35,Caption,,0,0,0,,ДЕЛАЯ ВИД, БУДТО НАТО ВЫШЛО ЗА КОФЕ. АЛЬЯНС УЖЕ СИДИТ
Dialogue: 0,0:17:12.43,0:17:15.15,Caption,,0,0,0,,ЗА СТОЛОМ В ЛИЦЕ ЧЕЛОВЕКА С РЕАЛЬНЫМИ ПОЛНОМОЧИЯМИ,
Dialogue: 0,0:17:15.34,0:17:17.47,Caption,,0,0,0,,ПОКА ЕВРОПЕЙСКИЕ УЧРЕЖДЕНИЯ РЕШАЮТ,
Dialogue: 0,0:17:17.70,0:17:20.27,Caption,,0,0,0,,КТО ИМЕЕТ ПРАВО ПРОИЗНЕСТИ ВСТУПИТЕЛЬНУЮ РЕЧЬ.
Dialogue: 0,0:17:22.54,0:17:25.26,Caption,,0,0,0,,ТРИ ИСТОРИИ СКЛАДЫВАЮТСЯ В ОДИН НЕПРИЯТНЫЙ ВЫВОД.
Dialogue: 0,0:17:25.60,0:17:27.66,Caption,,0,0,0,,УКРАИНСКОМУ РУКОВОДСТВУ ДАЮТ ПОНЯТЬ,
Dialogue: 0,0:17:27.90,0:17:30.54,Caption,,0,0,0,,ЧТО ЛИЧНАЯ БЕЗОПАСНОСТЬ БОЛЬШЕ НЕ ВХОДИТ В ПРЕЖНИЙ
Dialogue: 0,0:17:30.54,0:17:33.50,Caption,,0,0,0,,КОМПЛЕКТ. ВНУТРИ СТРАНЫ ОБСУЖДАЮТ ТЕРРИТОРИАЛЬНЫЙ
Dialogue: 0,0:17:33.50,0:17:37.66,Caption,,0,0,0,,КОМПРОМИСС, ВОЗМОЖНУЮ СМЕНУ СОЮЗОВ И ВЛАСТЬ ПОСЛЕ ЗЕЛЕНСКОГО.
Dialogue: 0,0:17:37.97,0:17:41.90,Caption,,0,0,0,,ПОТЕРИ, ДЕМОГРАФИЯ И РАЗРУШЕННАЯ ЭКОНОМИКА СОКРАЩАЮТ
Dialogue: 0,0:17:41.90,0:17:44.86,Caption,,0,0,0,,ПРОСТРАНСТВО ДЛЯ ГРОМКИХ ОБЕЩАНИЙ. ЕВРОПА ТРЕБУЕТ
Dialogue: 0,0:17:44.94,0:17:48.78,Caption,,0,0,0,,ВЛИЯТЬ НА ИТОГ, ХОТЯ НЕ МОЖЕТ СФОРМУЛИРОВАТЬ ЕДИНЫЙ ИТОГ ДЛЯ САМОЙ
Dialogue: 0,0:17:48.78,0:17:53.77,Caption,,0,0,0,,СЕБЯ. МОСКВА ПОЛУЧАЕТ ВОЗМОЖНОСТЬ РАЗГОВАРИВАТЬ НА
Dialogue: 0,0:17:53.77,0:17:57.13,Caption,,0,0,0,,НЕСКОЛЬКИХ УРОВНЯХ. С КИЕВОМ О ГРАНИЦАХ И ВЛАСТИ.
Dialogue: 0,0:17:57.53,0:18:00.09,Caption,,0,0,0,,С ВАШИНГТОНОМ И ВОЕННЫМ КОМАНДОВАНИЕМ НАТО О
Dialogue: 0,0:18:00.09,0:18:03.29,Caption,,0,0,0,,ПРАВИЛАХ БЕЗОПАСНОСТИ. С ЕВРОПЕЙСКИМИ СТОЛИЦАМИ ОБ
Dialogue: 0,0:18:03.29,0:18:06.09,Caption,,0,0,0,,ОТДЕЛЬНЫХ ОБЯЗАТЕЛЬСТВАХ. А БРЮССЕЛЬ РИСКУЕТ
Dialogue: 0,0:18:06.17,0:18:08.33,Caption,,0,0,0,,ОСТАТЬСЯ В РОЛИ АДМИНИСТРАТОРА РЕСТОРАНА,
Dialogue: 0,0:18:08.57,0:18:11.29,Caption,,0,0,0,,КОТОРЫЙ ДОЛГО РАССАЖИВАЛ ГОСТЕЙ И ЛИШЬ ПОТОМ
Dialogue: 0,0:18:11.29,0:18:14.33,Caption,,0,0,0,,ЗАМЕТИЛ, ЧТО ЗАКАЗ ОНИ СДЕЛАЛИ НАПРЯМУЮ ПОВАРУ.
Dialogue: 0,0:18:16.61,0:18:19.65,Caption,,0,0,0,,САМОЕ ВАЖНОЕ ЗДЕСЬ НЕ БУДУЩАЯ ПОДПИСЬ ПОД КОНКРЕТНЫМ
Dialogue: 0,0:18:19.65,0:18:21.89,Caption,,0,0,0,,СОГЛАШЕНИЕМ. МЕНЯЕТСЯ КРУГ ТЕХ,
Dialogue: 0,0:18:22.20,0:18:25.25,Caption,,0,0,0,,КТО СПОСОБЕН ПРИНИМАТЬ РЕШЕНИЯ. ЗЕЛЕНСКИЙ РИСКУЕТ
Dialogue: 0,0:18:25.25,0:18:27.49,Caption,,0,0,0,,ПОТЕРЯТЬ НЕ ТОЛЬКО ТЕРРИТОРИИ И ПОДДЕРЖКУ,
Dialogue: 0,0:18:27.69,0:18:31.09,Caption,,0,0,0,,НО И ПРЕЖНИЙ СТАТУС ОБЯЗАТЕЛЬНОГО УЧАСТНИКА. ЕВРОПА
Dialogue: 0,0:18:31.33,0:18:34.21,Caption,,0,0,0,,РИСКУЕТ ПОТЕРЯТЬ ПРАВО ГОВОРИТЬ ЗА ВСЕ СВОИ СТОЛИЦЫ.
Dialogue: 0,0:18:34.52,0:18:37.09,Caption,,0,0,0,,УКРАИНА РИСКУЕТ ПОДОЙТИ К НОВОМУ УСТРОЙСТВУ С
Dialogue: 0,0:18:37.09,0:18:41.25,Caption,,0,0,0,,МЕНЬШИМ НАСЕЛЕНИЕМ, РАЗРУШЕННОЙ ПРОМЫШЛЕННОСТЬЮ И ТЯЖЁЛЫМ СЧЁТОМ К
Dialogue: 0,0:18:41.25,0:18:46.88,Caption,,0,0,0,,БЫВШИМ ПАРТНЁРАМ. ЕСЛИ ОБЩИЙ ЕВРОПЕЙСКИЙ ОТВЕТ НЕ ПОЯВИТСЯ,
Dialogue: 0,0:18:47.20,0:18:50.08,Caption,,0,0,0,,НОВУЮ СИСТЕМУ НАЧНУТ СОБИРАТЬ ЧАСТЯМИ. ОДНО
Dialogue: 0,0:18:50.16,0:18:52.96,Caption,,0,0,0,,СОГЛАШЕНИЕ С ОДНОЙ СТОЛИЦЕЙ, ВТОРОЕ С ДРУГОЙ,
Dialogue: 0,0:18:53.12,0:18:55.92,Caption,,0,0,0,,ОТДЕЛЬНЫЕ УСЛОВИЯ ДЛЯ ТРЕТЬЕЙ. УКРАИНА БУДЕТ
Dialogue: 0,0:18:56.00,0:18:58.32,Caption,,0,0,0,,ВЫБИРАТЬ СОЮЗНИКОВ НЕ ПО СТАРЫМ ОБЕЩАНИЯМ,
Dialogue: 0,0:18:58.64,0:19:01.12,Caption,,0,0,0,,А ПО ТОМУ, КТО ПРЕДЛОЖИТ ЕЙ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:19:01.20,0:19:05.04,Caption,,0,0,0,,РЫНОК, ЭНЕРГИЮ И ВОЗМОЖНОСТЬ СОХРАНИТЬ ЛЮДЕЙ. САМЫЙ
Dialogue: 0,0:19:05.04,0:19:07.36,Caption,,0,0,0,,НЕУДОБНЫЙ ВАРИАНТ ДЛЯ ЕВРОПЫ СОСТОИТ В ТОМ,
Dialogue: 0,0:19:07.53,0:19:09.92,Caption,,0,0,0,,ЧТО КИЕВ ОДНАЖДЫ ПОСМОТРИТ НЕ НА ЗАПАД,
Dialogue: 0,0:19:10.26,0:19:13.20,Caption,,0,0,0,,А ТУДА, КУДА СМОТРЕТЬ ЕМУ МНОГО ЛЕТ ЗАПРЕЩАЛИ.
Dialogue: 0,0:19:15.49,0:19:18.13,Caption,,0,0,0,,ИСТОРИЯ РЕДКО СПРАШИВАЕТ РАЗРЕШЕНИЯ У АВТОРОВ
Dialogue: 0,0:19:18.13,0:19:20.93,Caption,,0,0,0,,ТОРЖЕСТВЕННЫХ РЕЧЕЙ. ОНА СВЕРЯЕТ РЕСУРСЫ,
Dialogue: 0,0:19:21.09,0:19:25.09,Caption,,0,0,0,,ПОТЕРИ, ИНТЕРЕСЫ И СПОСОБНОСТЬ ДОГОВАРИВАТЬСЯ. КОГДА ЭТИ
Dialogue: 0,0:19:25.09,0:19:29.97,Caption,,0,0,0,,ЧИСЛА СКЛАДЫВАЮТСЯ, НЕМЫСЛИМАЯ ИДЕЯ СТАНОВИТСЯ РАБОЧИМ ВАРИАНТОМ. А ТЕ,
Dialogue: 0,0:19:30.29,0:19:32.45,Caption,,0,0,0,,КТО ДОЛЬШЕ ВСЕХ ВЫБИРАЛ ЕДИНЫЙ МИКРОФОН,
Dialogue: 0,0:19:32.67,0:19:36.21,Caption,,0,0,0,,ОБНАРУЖИВАЮТ, ЧТО РАЗГОВОР УЖЕ ЗАКОНЧИЛСЯ. ПРОСТО С НИМИ ЕГО
Dialogue: 0,0:19:36.21,0:19:37.01,Caption,,0,0,0,,НИКТО НЕ ВЁЛ.
