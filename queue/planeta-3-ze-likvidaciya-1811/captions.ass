Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ВОКРУГ ЗЕЛЕНСКОГО ВНЕЗАПНО СТАЛО ТЕСНО ДАЖЕ ТАМ,
Dialogue: 0,0:00:03.32,0:00:06.04,Caption,,0,0,0,,ГДЕ РАНЬШЕ ОСТАВЛЯЛИ ЗАПАС ДЛЯ ЛИЧНОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:00:06.51,0:00:10.84,Caption,,0,0,0,,ИЗ МОСКВЫ ПРИШЁЛ СИГНАЛ, ЧТО НЕГЛАСНОЕ ОГРАНИЧЕНИЕ НА ЕГО УСТРАНЕНИЕ БОЛЬШЕ
Dialogue: 0,0:00:10.84,0:00:13.24,Caption,,0,0,0,,НЕ ДЕЙСТВУЕТ. ПРИЧЁМ РЕЧЬ ИДЁТ НЕ ТОЛЬКО О
Dialogue: 0,0:00:13.24,0:00:16.04,Caption,,0,0,0,,НЁМ, НО И О ЛЮДЯХ ИЗ ВЕРХУШКИ УКРАИНСКОЙ ВЛАСТИ.
Dialogue: 0,0:00:16.42,0:00:18.44,Caption,,0,0,0,,И ПОЧТИ В ТОТ ЖЕ МОМЕНТ ГЕНЕРАЛ СБУ
Dialogue: 0,0:00:18.44,0:00:21.80,Caption,,0,0,0,,ОБЪЯВЛЯЕТ, ЧТО ПРОТИВ РУКОВОДСТВА УКРАИНЫ ДЕЙСТВУЕТ ЦЕЛАЯ
Dialogue: 0,0:00:21.80,0:00:24.28,Caption,,0,0,0,,ОПЕРАЦИЯ. ТОЛЬКО ИСПОЛНИТЕЛЕЙ ОН НАХОДИТ НЕ В
Dialogue: 0,0:00:24.28,0:00:27.00,Caption,,0,0,0,,МОСКВЕ, А СРЕДИ УКРАИНСКИХ БОРЦОВ С КОРРУПЦИЕЙ.
Dialogue: 0,0:00:27.68,0:00:30.20,Caption,,0,0,0,,СОВПАДЕНИЕ ДЛЯ ЗЕЛЕНСКОГО ПОЛУЧАЕТСЯ РОСКОШНОЕ
Dialogue: 0,0:00:30.28,0:00:32.36,Caption,,0,0,0,,СНАРУЖИ ОБСУЖДАЮТ ЕГО ЛИКВИДАЦИЮ,
Dialogue: 0,0:00:32.52,0:00:34.60,Caption,,0,0,0,,ВНУТРИ ВЫЯСНЯЮТ, КТО ПРЕДАТЕЛЬ,
Dialogue: 0,0:00:34.76,0:00:39.00,Caption,,0,0,0,,А СОЮЗНИКИ ПРОВЕРЯЮТ, НАСКОЛЬКО КРЕПКО ОН ДЕРЖИТСЯ ЗА КРЕСЛО. ЕСЛИ ВАМ
Dialogue: 0,0:00:39.00,0:00:41.08,Caption,,0,0,0,,НРАВЯТСЯ РАЗБОРЫ БЕЗ КАЗЁННОЙ ЖВАЧКИ,
Dialogue: 0,0:00:41.21,0:00:43.32,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПО ПОЯВИВШЕЙСЯ ВЕРСИИ,
Dialogue: 0,0:00:43.57,0:00:46.20,Caption,,0,0,0,,ПРЕЖНЕЕ ОГРАНИЧЕНИЕ УБРАЛИ ПОСЛЕ ОБСУЖДЕНИЯ В
Dialogue: 0,0:00:46.28,0:00:49.08,Caption,,0,0,0,,МОСКВЕ. ПРЕДСТАВИТЕЛИ СИЛОВОГО БЛОКА ПОТРЕБОВАЛИ
Dialogue: 0,0:00:49.08,0:00:51.88,Caption,,0,0,0,,ИЗМЕНИТЬ ПОДХОД К ЗЕЛЕНСКОМУ И ЧАСТИ УКРАИНСКОГО
Dialogue: 0,0:00:51.88,0:00:55.96,Caption,,0,0,0,,РУКОВОДСТВА. ОДНИМ ИЗ ПОВОДОВ НАЗЫВАЮТ ПРОДОЛЖАЮЩИЕСЯ АТАКИ ПО
Dialogue: 0,0:00:55.96,0:01:00.68,Caption,,0,0,0,,РОССИЙСКОЙ ТЕРРИТОРИИ, ВКЛЮЧАЯ ЛЕНИНГРАДСКУЮ ОБЛАСТЬ. САМО РАСПРОСТРАНЕНИЕ
Dialogue: 0,0:01:00.76,0:01:04.12,Caption,,0,0,0,,ЭТОЙ ИНФОРМАЦИИ УЖЕ МЕНЯЕТ ОБСТАНОВКУ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:01:04.20,0:01:06.36,Caption,,0,0,0,,МОЖЕТ СЧИТАТЬ ЕЁ ПОПЫТКОЙ ЗАПУГИВАНИЯ,
Dialogue: 0,0:01:06.76,0:01:09.48,Caption,,0,0,0,,НО ОХРАНЕ ОТ ТАКОГО РАССУЖДЕНИЯ ЛЕГЧЕ НЕ СТАНЕТ.
Dialogue: 0,0:01:11.75,0:01:14.07,Caption,,0,0,0,,ЛЮДЯМ, ОТВЕЧАЮЩИМ ЗА МАРШРУТЫ,
Dialogue: 0,0:01:14.15,0:01:17.99,Caption,,0,0,0,,ВСТРЕЧИ И РЕЖИМ БЕЗОПАСНОСТИ, ТЕПЕРЬ ПРИХОДИТСЯ УЧИТЫВАТЬ,
Dialogue: 0,0:01:18.12,0:01:19.99,Caption,,0,0,0,,ЧТО ПРЕЖНЕЙ ГРАНИЦЫ БОЛЬШЕ НЕТ.
Dialogue: 0,0:01:20.71,0:01:22.87,Caption,,0,0,0,,ДО СИХ ПОР БОЕВЫЕ ДЕЙСТВИЯ ШЛИ ПО СВОИМ
Dialogue: 0,0:01:22.87,0:01:25.67,Caption,,0,0,0,,ЖЕСТОКИМ ПРАВИЛАМ. РОССИЯ ПОРАЖАЛА УКРАИНСКИЕ
Dialogue: 0,0:01:25.67,0:01:27.91,Caption,,0,0,0,,ВОЕННЫЕ И ИНФРАСТРУКТУРНЫЕ ОБЪЕКТЫ,
Dialogue: 0,0:01:28.22,0:01:31.35,Caption,,0,0,0,,УКРАИНА АТАКОВАЛА ЦЕЛИ НА РОССИЙСКОЙ ТЕРРИТОРИИ. ПРИ
Dialogue: 0,0:01:31.43,0:01:33.75,Caption,,0,0,0,,ЭТОМ ДЕЙСТВУЮЩЕЕ РУКОВОДСТВО В КИЕВЕ ОСТАВАЛОСЬ
Dialogue: 0,0:01:33.76,0:01:36.39,Caption,,0,0,0,,ОСОБОЙ КАТЕГОРИЕЙ. ПО НЕМУ МОЖНО БЫЛО ДАВИТЬ
Dialogue: 0,0:01:36.39,0:01:39.83,Caption,,0,0,0,,ЗАЯВЛЕНИЯМИ, ПЕРЕГОВОРАМИ И ВОЕННЫМИ ПОРАЖЕНИЯМИ,
Dialogue: 0,0:01:40.07,0:01:42.71,Caption,,0,0,0,,НО ВОПРОС ФИЗИЧЕСКОГО УСТРАНЕНИЯ ДЕРЖАЛИ ОТДЕЛЬНО.
Dialogue: 0,0:01:43.09,0:01:45.75,Caption,,0,0,0,,ТЕПЕРЬ ЭТОТ ВОПРОС ПОЛОЖИЛИ ПРЯМО НА СТОЛ. ОН
Dialogue: 0,0:01:45.75,0:01:48.23,Caption,,0,0,0,,ВОЗНИК ВО ВРЕМЯ ПЕРЕГОВОРОВ ОБ УСЛОВИЯХ ВОЗМОЖНОГО
Dialogue: 0,0:01:48.23,0:01:50.95,Caption,,0,0,0,,УРЕГУЛИРОВАНИЯ. В ТАКОЙ МОМЕНТ ДАЖЕ СЛУХ ВЕСИТ
Dialogue: 0,0:01:50.95,0:01:53.91,Caption,,0,0,0,,БОЛЬШЕ ОБЫЧНОГО. СТОРОНЫ ОБСУЖДАЮТ ТЕРРИТОРИЮ,
Dialogue: 0,0:01:54.07,0:01:56.63,Caption,,0,0,0,,БЕЗОПАСНОСТЬ, ВОЙСКА И ГАРАНТИИ,
Dialogue: 0,0:01:57.00,0:01:58.95,Caption,,0,0,0,,А ЗЕЛЕНСКОМУ ОДНОВРЕМЕННО НАПОМИНАЮТ,
Dialogue: 0,0:01:59.11,0:02:01.91,Caption,,0,0,0,,ЧТО ЕГО ЛИЧНОЕ БУДУЩЕЕ ТОЖЕ МОЖЕТ БЫТЬ ЧАСТЬЮ
Dialogue: 0,0:02:01.99,0:02:06.31,Caption,,0,0,0,,РАСЧЁТА. ПОЛУЧАЕТСЯ БЕСЕДА, НА КОТОРУЮ ОДИН УЧАСТНИК ПРИШЁЛ С ПЕРЕЧНЕМ
Dialogue: 0,0:02:06.31,0:02:10.47,Caption,,0,0,0,,ТРЕБОВАНИЙ, А ЕМУ ВМЕСТО МЕНЮ ПРИНЕСЛИ СЧЁТ. ЗДЕСЬ ВОЗМОЖНЫ
Dialogue: 0,0:02:10.55,0:02:15.03,Caption,,0,0,0,,ДВА ВАРИАНТА, И ОБА ДЛЯ КИЕВА СКВЕРНЫЕ. МОСКВА МОГЛА ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:02:15.03,0:02:18.39,Caption,,0,0,0,,СНЯТЬ ПРЕЖНЕЕ ОГРАНИЧЕНИЕ. ЛИБО СООБЩЕНИЕ ЗАПУСТИЛИ,
Dialogue: 0,0:02:18.55,0:02:21.19,Caption,,0,0,0,,ЧТОБЫ УКРАИНСКОЕ РУКОВОДСТВО НАЧАЛО ДЕЙСТВОВАТЬ ТАК,
Dialogue: 0,0:02:21.42,0:02:28.02,Caption,,0,0,0,,СЛОВНО ОГРАНИЧЕНИЕ УЖЕ СНЯТО. ВО ВТОРОМ СЛУЧАЕ НЕ ТРЕБУЕТСЯ НИ ПРИКАЗА,
Dialogue: 0,0:02:28.17,0:02:30.90,Caption,,0,0,0,,НИ ПОДГОТОВКИ КОНКРЕТНОЙ ОПЕРАЦИИ. ДОСТАТОЧНО
Dialogue: 0,0:02:30.90,0:02:32.98,Caption,,0,0,0,,ПОСЕЛИТЬ СОМНЕНИЕ В ГОЛОВЕ ТОГО,
Dialogue: 0,0:02:33.22,0:02:37.86,Caption,,0,0,0,,КТО ПРИНИМАЕТ РЕШЕНИЯ. РЕАЛЬНАЯ УГРОЗА ЗАСТАВЛЯЕТ УСИЛИВАТЬ ОХРАНУ.
Dialogue: 0,0:02:38.35,0:02:41.30,Caption,,0,0,0,,СВЕДЕНИЯ ОБ УГРОЗЕ МЕНЯЮТ ПОВЕДЕНИЕ ГОРАЗДО БОЛЬШЕГО
Dialogue: 0,0:02:41.38,0:02:43.94,Caption,,0,0,0,,КРУГА ЛЮДЕЙ. НАЧИНАЮТСЯ НОВЫЕ ПРОВЕРКИ,
Dialogue: 0,0:02:44.10,0:02:46.98,Caption,,0,0,0,,СОКРАЩАЮТСЯ МАРШРУТЫ, ОТМЕНЯЮТСЯ ВСТРЕЧИ,
Dialogue: 0,0:02:47.20,0:02:50.18,Caption,,0,0,0,,РАСТЁТ ПОДОЗРИТЕЛЬНОСТЬ. НО ГЛАВНЫМ АДРЕСАТОМ
Dialogue: 0,0:02:50.18,0:02:53.06,Caption,,0,0,0,,СИГНАЛА МОЖЕТ БЫТЬ НЕ САМ ЗЕЛЕНСКИЙ. ЕГО ОХРАНА
Dialogue: 0,0:02:53.10,0:02:56.10,Caption,,0,0,0,,ОБЯЗАНА ГОТОВИТЬСЯ К ХУДШЕМУ ПО ДОЛЖНОСТИ. НАМНОГО
Dialogue: 0,0:02:56.10,0:03:01.30,Caption,,0,0,0,,ИНТЕРЕСНЕЕ РЕАКЦИЯ ОКРУЖЕНИЯ, ВОЕННОГО КОМАНДОВАНИЯ И РУКОВОДИТЕЛЕЙ ВЕДОМСТВ. ЭТИ
Dialogue: 0,0:03:01.38,0:03:03.86,Caption,,0,0,0,,ЛЮДИ СВЯЗЫВАЮТ СВОЁ НАСТОЯЩЕЕ С ПРЕЗИДЕНТОМ,
Dialogue: 0,0:03:04.10,0:03:06.18,Caption,,0,0,0,,НО СОВСЕМ НЕ ОБЯЗАНЫ СВЯЗЫВАТЬ С НИМ ВСЁ
Dialogue: 0,0:03:06.18,0:03:09.14,Caption,,0,0,0,,ДАЛЬНЕЙШЕЕ СУЩЕСТВОВАНИЕ. ДЛЯ ТАКОГО ДВИЖЕНИЯ НЕ
Dialogue: 0,0:03:09.22,0:03:11.30,Caption,,0,0,0,,НУЖЕН ГОТОВЫЙ ЗАГОВОР. ДОСТАТОЧНО,
Dialogue: 0,0:03:11.53,0:03:14.18,Caption,,0,0,0,,ЧТОБЫ НЕСКОЛЬКО ВЛИЯТЕЛЬНЫХ ЛЮДЕЙ РЕШИЛИ ПОБЕРЕЧЬ
Dialogue: 0,0:03:14.18,0:03:17.62,Caption,,0,0,0,,СЕБЯ. ОДИН СТАНЕТ МЕДЛЕННЕЕ ВЫПОЛНЯТЬ ПОРУЧЕНИЯ.
Dialogue: 0,0:03:17.86,0:03:20.10,Caption,,0,0,0,,ДРУГОЙ ОБНАРУЖИТ УВАЖЕНИЕ К ПРОЦЕДУРАМ,
Dialogue: 0,0:03:20.33,0:03:22.66,Caption,,0,0,0,,ХОТЯ ЕЩЁ НА ДНЯХ ПОДПИСЫВАЛ ВСЁ НЕ ЧИТАЯ.
Dialogue: 0,0:03:23.22,0:03:26.18,Caption,,0,0,0,,ОСОБУЮ ТЯЖЕСТЬ ЭТОЙ ИСТОРИИ ПРИДАЁТ ЕЁ ПЕРЕГОВОРНЫЙ
Dialogue: 0,0:03:26.18,0:03:28.98,Caption,,0,0,0,,ФОН. МОСКВА И ВАШИНГТОН ПРОДОЛЖАЮТ ОБСУЖДАТЬ
Dialogue: 0,0:03:28.98,0:03:33.46,Caption,,0,0,0,,ВАРИАНТЫ УРЕГУЛИРОВАНИЯ, ПОЭТОМУ СИГНАЛ ОБ ИЗМЕНЕНИИ ОТНОШЕНИЯ К ЗЕЛЕНСКОМУ
Dialogue: 0,0:03:33.46,0:03:35.94,Caption,,0,0,0,,ВЫГЛЯДИТ СВЯЗАННЫМ С АМЕРИКАНСКИМ ДАВЛЕНИЕМ.
Dialogue: 0,0:03:36.39,0:03:38.34,Caption,,0,0,0,,АМЕРИКАНЦАМ НЕ ТРЕБУЕТСЯ УЧАСТВОВАТЬ В
Dialogue: 0,0:03:38.34,0:03:39.94,Caption,,0,0,0,,РАСПРОСТРАНЕНИИ ТАКИХ СВЕДЕНИЙ.
Dialogue: 0,0:03:42.13,0:03:45.50,Caption,,0,0,0,,ДОСТАТОЧНО, ЧТОБЫ В КИЕВЕ ДВЕ ЛИНИИ УВИДЕЛИ КАК ОДНУ.
Dialogue: 0,0:03:46.05,0:03:47.98,Caption,,0,0,0,,ДЛЯ УКРАИНСКОГО РУКОВОДСТВА РАЗНИЦА МЕЖДУ
Dialogue: 0,0:03:47.98,0:03:50.78,Caption,,0,0,0,,СОГЛАСОВАННЫМИ ДЕЙСТВИЯМИ И УДАЧНО СОВПАВШИМИ
Dialogue: 0,0:03:50.78,0:03:53.26,Caption,,0,0,0,,ДЕЙСТВИЯМИ БЫСТРО СТАНОВИТСЯ ТЕОРЕТИЧЕСКОЙ.
Dialogue: 0,0:03:53.82,0:03:56.30,Caption,,0,0,0,,РЕЗУЛЬТАТ ОДИНАКОВ ЗЕЛЕНСКОМУ ПРИХОДИТСЯ ПРОВЕРЯТЬ,
Dialogue: 0,0:03:56.53,0:03:59.18,Caption,,0,0,0,,НАСКОЛЬКО ПРОЧНЫ ОБЕЩАНИЯ ПАРТНЁРОВ И НЕ
Dialogue: 0,0:03:59.18,0:04:01.90,Caption,,0,0,0,,ПРЕВРАТИЛИСЬ ЛИ ГАРАНТИИ В СТАРУЮ БАНКОВСКУЮ КАРТУ.
Dialogue: 0,0:04:02.27,0:04:04.94,Caption,,0,0,0,,НА ВИД НАСТОЯЩАЯ, А ПРИЛОЖИШЬ К ТЕРМИНАЛУ,
Dialogue: 0,0:04:05.09,0:04:08.14,Caption,,0,0,0,,И НАЧИНАЕТСЯ НЕЛОВКОСТЬ. ОДНАКО ВНЕШНИЙ СИГНАЛ
Dialogue: 0,0:04:08.42,0:04:11.34,Caption,,0,0,0,,ОКАЗАЛСЯ ЛИШЬ ПЕРВОЙ ЧАСТЬЮ ДАВЛЕНИЯ. ПОЧТИ
Dialogue: 0,0:04:11.34,0:04:15.18,Caption,,0,0,0,,ОДНОВРЕМЕННО ГЕНЕРАЛ МАЙОР СБУ СЕРГЕЙ ДУКА ЗАЯВИЛ О
Dialogue: 0,0:04:15.26,0:04:17.82,Caption,,0,0,0,,СПЕЦИАЛЬНОЙ ОПЕРАЦИИ ПРОТИВ ВЫСШЕГО РУКОВОДСТВА
Dialogue: 0,0:04:17.82,0:04:21.58,Caption,,0,0,0,,УКРАИНЫ. КАЗАЛОСЬ БЫ, СЕЙЧАС ОН НАЗОВЁТ РОССИЙСКИХ ВОЕННЫХ,
Dialogue: 0,0:04:21.77,0:04:26.77,Caption,,0,0,0,,РАЗВЕДЧИКОВ ИЛИ ТАЙНУЮ СЕТЬ, ЗАБРОШЕННУЮ ЧЕРЕЗ ГРАНИЦУ. НО ГЕНЕРАЛ ПОВЕРНУЛ
Dialogue: 0,0:04:26.86,0:04:29.42,Caption,,0,0,0,,УКАЗКУ ВНУТРЬ СТРАНЫ И ПОКАЗАЛ НА НАБУ И
Dialogue: 0,0:04:29.42,0:04:33.58,Caption,,0,0,0,,САП. ПО ЕГО ВЕРСИИ, УКРАИНСКОЕ ИНФОРМАЦИОННОЕ ПРОСТРАНСТВО ИСПОЛЬЗУЮТ
Dialogue: 0,0:04:33.58,0:04:35.90,Caption,,0,0,0,,ДЛЯ ЗАРАНЕЕ ПОДГОТОВЛЕННОЙ КАМПАНИИ ПРОТИВ
Dialogue: 0,0:04:35.90,0:04:40.77,Caption,,0,0,0,,РУКОВОДСТВА И ОРГАНОВ, ОТВЕЧАЮЩИХ ЗА БЕЗОПАСНОСТЬ. ЦЕЛЬЮ ОН СЧИТАЕТ ПОДРЫВ
Dialogue: 0,0:04:40.77,0:04:43.65,Caption,,0,0,0,,ДОВЕРИЯ К ГОСУДАРСТВУ ВО ВРЕМЯ БОЕВЫХ ДЕЙСТВИЙ И
Dialogue: 0,0:04:43.65,0:04:46.62,Caption,,0,0,0,,ПЕРЕГОВОРОВ. ДАЛЬШЕ ПРОЗВУЧАЛО ГЛАВНОЕ.
Dialogue: 0,0:04:48.90,0:04:52.50,Caption,,0,0,0,,ДУКА ДОПУСТИЛ, ЧТО СОТРУДНИКИ АНТИКОРРУПЦИОННЫХ ОРГАНОВ ЛИБО
Dialogue: 0,0:04:52.50,0:04:54.74,Caption,,0,0,0,,СОЗНАТЕЛЬНО УЧАСТВУЮТ В ДЕЯТЕЛЬНОСТИ,
Dialogue: 0,0:04:54.82,0:04:58.90,Caption,,0,0,0,,ВЫГОДНОЙ МОСКВЕ, ЛИБО ДЕЛАЮТ ЭТО ИЗ ЗА СОБСТВЕННОЙ ПРОФЕССИОНАЛЬНОЙ
Dialogue: 0,0:04:58.90,0:05:02.34,Caption,,0,0,0,,БЕСПОМОЩНОСТИ. ВЫБОР БОГАТЫЙ АГЕНТ ИЛИ ЧЕЛОВЕК,
Dialogue: 0,0:05:02.58,0:05:04.42,Caption,,0,0,0,,КОТОРОМУ НЕЛЬЗЯ ДОВЕРИТЬ ДАЖЕ ПАПКУ.
Dialogue: 0,0:05:04.99,0:05:07.78,Caption,,0,0,0,,ДЛЯ ОБВИНЯЕМОГО ВЕДОМСТВА ОБА ВАРИАНТА ЗВУЧАТ
Dialogue: 0,0:05:07.91,0:05:10.98,Caption,,0,0,0,,ОДИНАКОВО БОДРЯЩЕ. ТАК ВНУТРИ УКРАИНЫ ВОЗНИКЛА
Dialogue: 0,0:05:10.98,0:05:14.42,Caption,,0,0,0,,ВТОРАЯ ЛИНИЯ ВОЗМОЖНОЙ ЛИКВИДАЦИИ ЗЕЛЕНСКОГО. ПЕРВАЯ
Dialogue: 0,0:05:14.42,0:05:17.70,Caption,,0,0,0,,КАСАЕТСЯ ФИЗИЧЕСКОЙ УГРОЗЫ И СООБЩЕНИЯ О СНЯТОМ
Dialogue: 0,0:05:17.70,0:05:21.22,Caption,,0,0,0,,ОГРАНИЧЕНИИ. ВТОРАЯ БЬЁТ ПО СПОСОБНОСТИ ПРЕЗИДЕНТА
Dialogue: 0,0:05:21.22,0:05:25.38,Caption,,0,0,0,,УПРАВЛЯТЬ СИЛОВЫМ АППАРАТОМ. ЕСЛИ СЛУЖБЫ НАЧИНАЮТ ОБЪЯВЛЯТЬ ДРУГ ДРУГА
Dialogue: 0,0:05:25.38,0:05:29.30,Caption,,0,0,0,,ИНСТРУМЕНТАМИ ПРОТИВНИКА, ГЛАВА ГОСУДАРСТВА ПОЛУЧАЕТ НЕ ЩИТ,
Dialogue: 0,0:05:29.46,0:05:33.62,Caption,,0,0,0,,А ДРАКУ ЛЮДЕЙ, КОТОРЫЕ ЭТОТ ЩИТ ДОЛЖНЫ ДЕРЖАТЬ. НАБУ И САП
Dialogue: 0,0:05:33.80,0:05:36.10,Caption,,0,0,0,,РАССЛЕДУЮТ КОРРУПЦИЮ В СИЛОВЫХ СТРУКТУРАХ.
Dialogue: 0,0:05:36.27,0:05:38.50,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЬ СБУ ОТВЕЧАЕТ ОБВИНЕНИЕМ,
Dialogue: 0,0:05:38.66,0:05:41.70,Caption,,0,0,0,,ЧТО САМИ РАССЛЕДОВАТЕЛИ ИГРАЮТ НА ПОЛЬЗУ РОССИИ. ВО
Dialogue: 0,0:05:41.70,0:05:43.54,Caption,,0,0,0,,ВРЕМЯ ВОЙНЫ СПОР ИДЁТ УЖЕ О ТОМ,
Dialogue: 0,0:05:43.78,0:05:48.26,Caption,,0,0,0,,КТО СЛУЖИТ ГОСУДАРСТВУ, А КТО ПРИКРЫВАЕТСЯ ГОСУДАРСТВОМ. ДУКА ПОТРЕБОВАЛ ОТ
Dialogue: 0,0:05:48.26,0:05:52.74,Caption,,0,0,0,,ПРЕЗИДЕНТА, ВЕРХОВНОЙ РАДЫ И РУКОВОДСТВА СБУ ДАТЬ ПРОИСХОДЯЩЕМУ
Dialogue: 0,0:05:52.74,0:05:56.26,Caption,,0,0,0,,ПОЛИТИЧЕСКУЮ И ПРАВОВУЮ ОЦЕНКУ. ОН ПРЕДЛОЖИЛ СОЗДАТЬ
Dialogue: 0,0:05:56.26,0:05:58.18,Caption,,0,0,0,,ПАРЛАМЕНТСКУЮ СЛЕДСТВЕННУЮ КОМИССИЮ,
Dialogue: 0,0:05:58.42,0:06:01.38,Caption,,0,0,0,,ПРОВЕРИТЬ ДЕЯТЕЛЬНОСТЬ АНТИКОРРУПЦИОННЫХ ОРГАНОВ И
Dialogue: 0,0:06:01.46,0:06:04.26,Caption,,0,0,0,,ВЫРАЗИЛ ГОТОВНОСТЬ ПУБЛИЧНО ВЫСТУПИТЬ С ПОКАЗАНИЯМИ.
Dialogue: 0,0:06:06.54,0:06:09.10,Caption,,0,0,0,,ТО ЕСТЬ ГЕНЕРАЛ ПРЕДЛОЖИЛ ЗАПУСТИТЬ РАССЛЕДОВАНИЕ
Dialogue: 0,0:06:09.10,0:06:11.50,Caption,,0,0,0,,ПРОТИВ ТЕХ, КТО УЖЕ ВЕДЁТ РАССЛЕДОВАНИЯ.
Dialogue: 0,0:06:12.13,0:06:15.18,Caption,,0,0,0,,УКРАИНСКАЯ СИСТЕМА ДОБРАЛАСЬ ДО РЕДКОЙ ФОРМЫ ПОРЯДКА
Dialogue: 0,0:06:15.18,0:06:16.94,Caption,,0,0,0,,СЛЕДОВАТЕЛЬ ПРОВЕРЯЕТ СИЛОВИКА,
Dialogue: 0,0:06:17.18,0:06:19.26,Caption,,0,0,0,,СИЛОВИК ТРЕБУЕТ ПРОВЕРИТЬ СЛЕДОВАТЕЛЯ,
Dialogue: 0,0:06:19.43,0:06:21.18,Caption,,0,0,0,,А ПРЕЗИДЕНТУ ОСТАЁТСЯ ОПРЕДЕЛИТЬ,
Dialogue: 0,0:06:21.42,0:06:23.58,Caption,,0,0,0,,КОМУ ИЗ НИХ ПОРУЧИТЬ ПРОВЕРКУ ПРОВЕРКИ.
Dialogue: 0,0:06:24.44,0:06:28.46,Caption,,0,0,0,,ЕСТЬ ОБСТОЯТЕЛЬСТВО, КОТОРОЕ ДЕЛАЕТ ВЫСТУПЛЕНИЕ ДУКИ ЕЩЁ ВЫРАЗИТЕЛЬНЕЕ.
Dialogue: 0,0:06:28.68,0:06:31.58,Caption,,0,0,0,,САМ ОН ОКАЗАЛСЯ ФИГУРАНТОМ ДЕЛА О ПРЕДПОЛАГАЕМОМ
Dialogue: 0,0:06:31.58,0:06:34.46,Caption,,0,0,0,,ПОКРОВИТЕЛЬСТВЕ МОШЕННИЧЕСКИМ КОЛЛ ЦЕНТРАМ И ПОСЛЕ
Dialogue: 0,0:06:34.46,0:06:37.50,Caption,,0,0,0,,ЗАДЕРЖАНИЯ ВЫШЕЛ ПОД ЗАЛОГ. ТЕПЕРЬ ЧЕЛОВЕК,
Dialogue: 0,0:06:37.66,0:06:39.66,Caption,,0,0,0,,К КОТОРОМУ ПОЯВИЛИСЬ ВОПРОСЫ У СЛЕДСТВИЯ,
Dialogue: 0,0:06:39.98,0:06:41.90,Caption,,0,0,0,,ТРЕБУЕТ ИЗУЧИТЬ ДЕЯТЕЛЬНОСТЬ ТЕХ,
Dialogue: 0,0:06:42.15,0:06:45.26,Caption,,0,0,0,,КТО ЭТИ ВОПРОСЫ ЗАДАЁТ. САМО УГОЛОВНОЕ ДЕЛО НЕ
Dialogue: 0,0:06:45.26,0:06:47.26,Caption,,0,0,0,,ПРЕВРАЩАЕТ КАЖДОЕ ЕГО СЛОВО В ЛОЖЬ.
Dialogue: 0,0:06:47.82,0:06:50.54,Caption,,0,0,0,,НО И ГРОМКАЯ ССЫЛКА НА БЕЗОПАСНОСТЬ СТРАНЫ НЕ
Dialogue: 0,0:06:50.54,0:06:54.38,Caption,,0,0,0,,ВЫДАЁТ ОБВИНЕНИЮ УДОСТОВЕРЕНИЕ ИСТИНЫ. ИНАЧЕ ЛЮБОМУ
Dialogue: 0,0:06:54.38,0:06:57.34,Caption,,0,0,0,,ПОДОЗРЕВАЕМОМУ ДОСТАТОЧНО ПРОИЗНЕСТИ СЛОВО МОСКВА,
Dialogue: 0,0:06:57.66,0:07:00.30,Caption,,0,0,0,,ПОСЛЕ ЧЕГО ПАПКА С МАТЕРИАЛАМИ ДОЛЖНА ИСПУГАННО
Dialogue: 0,0:07:00.38,0:07:03.26,Caption,,0,0,0,,ЗАКРЫТЬСЯ САМА. ЕСЛИ ЭТОТ ПОДХОД ПРИМУТ,
Dialogue: 0,0:07:03.58,0:07:06.46,Caption,,0,0,0,,ЛЮБОЕ НЕУДОБНОЕ РАССЛЕДОВАНИЕ МОЖНО БУДЕТ ПЕРЕВЕСТИ
Dialogue: 0,0:07:06.54,0:07:09.02,Caption,,0,0,0,,ИЗ УГОЛОВНОЙ ПЛОСКОСТИ В ВОПРОС ГОСУДАРСТВЕННОЙ
Dialogue: 0,0:07:09.02,0:07:12.06,Caption,,0,0,0,,ЛОЯЛЬНОСТИ. УЖЕ НЕ ТРЕБУЕТСЯ ОБЪЯСНЯТЬ ПРОИСХОЖДЕНИЕ
Dialogue: 0,0:07:12.06,0:07:14.94,Caption,,0,0,0,,ДЕНЕГ ИЛИ СВЯЗИ С ПРЕСТУПНЫМ БИЗНЕСОМ. ДОСТАТОЧНО
Dialogue: 0,0:07:15.02,0:07:17.34,Caption,,0,0,0,,СПРОСИТЬ, КОМУ ВЫГОДНО РАССЛЕДОВАНИЕ.
Dialogue: 0,0:07:19.63,0:07:21.87,Caption,,0,0,0,,ОТВЕТ МОСКВА В ТАКИХ СЛУЧАЯХ РАБОТАЕТ КАК
Dialogue: 0,0:07:21.87,0:07:25.95,Caption,,0,0,0,,УНИВЕРСАЛЬНЫЙ КЛЮЧ, ОСОБЕННО КОГДА СТАРЫЙ КЛЮЧ ОКАЗАЛСЯ В МАТЕРИАЛАХ
Dialogue: 0,0:07:25.95,0:07:30.03,Caption,,0,0,0,,ДЕЛА. КОРРУПЦИОННАЯ ЛИНИЯ ЗДЕСЬ НЕ ЗАМЕНЯЕТ ГЛАВНУЮ ТЕМУ,
Dialogue: 0,0:07:30.19,0:07:32.43,Caption,,0,0,0,,А УСИЛИВАЕТ ДАВЛЕНИЕ НА ЗЕЛЕНСКОГО.
Dialogue: 0,0:07:33.07,0:07:35.23,Caption,,0,0,0,,В МАТЕРИАЛАХ ПОЯВЛЯЕТСЯ ЧЕЛОВЕК ПО ПРОЗВИЩУ
Dialogue: 0,0:07:35.23,0:07:39.15,Caption,,0,0,0,,МЕКСИКАНЕЦ, СВЯЗАННЫЙ С НАРКОСИНДИКАТОМ ХИМПРОМ. СОГЛАСНО
Dialogue: 0,0:07:39.15,0:07:44.51,Caption,,0,0,0,,РАСПРОСТРАНЁННЫМ СВЕДЕНИЯМ, ОН ПОДТВЕРДИЛ ПОДЛИННОСТЬ ОПЕРАТИВНЫХ ЗАПИСЕЙ НАБУ И
Dialogue: 0,0:07:44.51,0:07:47.79,Caption,,0,0,0,,РАССКАЗАЛ О ЕЖЕМЕСЯЧНЫХ ВЫПЛАТАХ ПРЕДСТАВИТЕЛЯМ СБУ,
Dialogue: 0,0:07:47.87,0:07:51.31,Caption,,0,0,0,,ПОЛИЦИИ И ПРОКУРАТУРЫ. РЕЧЬ ШЛА О МИЛЛИОНАХ,
Dialogue: 0,0:07:51.48,0:07:53.87,Caption,,0,0,0,,КОТОРЫЕ ПОДНИМАЛИСЬ ДО ВЕРХНИХ ЭТАЖЕЙ СИСТЕМЫ.
Dialogue: 0,0:07:54.43,0:07:56.83,Caption,,0,0,0,,ЕСЛИ НЕСКОЛЬКИМ ВЕДОМСТВАМ РЕГУЛЯРНО ПЕРЕДАВАЛИ
Dialogue: 0,0:07:56.83,0:08:00.75,Caption,,0,0,0,,ТАКИЕ СУММЫ, ИСТОРИЯ УЖЕ НЕ ПОМЕЩАЕТСЯ В КАРМАН ОДНОГО ПРОДАЖНОГО
Dialogue: 0,0:08:00.75,0:08:03.23,Caption,,0,0,0,,СОТРУДНИКА. КТО ОБЕСПЕЧИВАЛ ЗАЩИТУ?
Dialogue: 0,0:08:03.51,0:08:07.47,Caption,,0,0,0,,КТО ДЕЛАЛ ВИД, ЧТО МОШЕННИЧЕСКИЕ ЦЕНТРЫ КАКИМ ТО ЧУДОМ КАЖДЫЙ РАЗ
Dialogue: 0,0:08:07.55,0:08:09.87,Caption,,0,0,0,,ЗАКРЫТЫ ИМЕННО В ДЕНЬ ВИЗИТА ПОЛИЦИИ?
Dialogue: 0,0:08:10.37,0:08:12.99,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ КОНФЛИКТ ДУКИ С НАБУ И САП
Dialogue: 0,0:08:13.16,0:08:15.07,Caption,,0,0,0,,СТАНОВИТСЯ ОПАСНЫМ ДЛЯ ПРЕЗИДЕНТА.
Dialogue: 0,0:08:15.63,0:08:18.19,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ ОРГАНЫ ИЩУТ СВЯЗИ ПРЕСТУПНОГО
Dialogue: 0,0:08:18.19,0:08:21.15,Caption,,0,0,0,,БИЗНЕСА С СИЛОВИКАМИ. ГЕНЕРАЛ СБУ ПРЕДЛАГАЕТ
Dialogue: 0,0:08:21.15,0:08:23.79,Caption,,0,0,0,,ПРОВЕРИТЬ АНТИКОРРУПЦИОННЫЕ ОРГАНЫ КАК ВОЗМОЖНЫЙ
Dialogue: 0,0:08:23.79,0:08:26.75,Caption,,0,0,0,,ИНСТРУМЕНТ МОСКВЫ. ЗЕЛЕНСКОМУ ПРИХОДИТСЯ ВЫБИРАТЬ НЕ
Dialogue: 0,0:08:26.75,0:08:28.91,Caption,,0,0,0,,МЕЖДУ ПРИЯТНЫМ И НЕПРИЯТНЫМ ДОКЛАДОМ,
Dialogue: 0,0:08:29.15,0:08:33.63,Caption,,0,0,0,,А МЕЖДУ ВЕРСИЯМИ, КАЖДАЯ ИЗ КОТОРЫХ ОЗНАЧАЕТ СЕРЬЁЗНУЮ ПОЛОМКУ ЕГО
Dialogue: 0,0:08:33.63,0:08:38.62,Caption,,0,0,0,,АППАРАТА. К УКРАИНСКИМ ОБВИНЕНИЯМ ДОБАВИЛИСЬ ВОПРОСЫ ИЗ
Dialogue: 0,0:08:38.62,0:08:41.34,Caption,,0,0,0,,ЭСТОНИИ. РУКОВОДИТЕЛЬ МЕСТНОГО ЦЕНТРА БОРЬБЫ С
Dialogue: 0,0:08:41.34,0:08:44.06,Caption,,0,0,0,,МОШЕННИЧЕСТВОМ ЯАГУП ТООМПУУ РАССКАЗАЛ,
Dialogue: 0,0:08:44.30,0:08:47.02,Caption,,0,0,0,,ЧТО ПОЛИЦИЯ НЕОДНОКРАТНО ПЕРЕДАВАЛА УКРАИНСКИМ
Dialogue: 0,0:08:47.02,0:08:49.90,Caption,,0,0,0,,КОЛЛЕГАМ СВЕДЕНИЯ ОБ АДРЕСАХ ПОДОЗРИТЕЛЬНЫХ КОЛЛ
Dialogue: 0,0:08:49.90,0:08:52.78,Caption,,0,0,0,,ЦЕНТРОВ. КОГДА СОТРУДНИКИ ПРИЕЗЖАЛИ НА МЕСТО,
Dialogue: 0,0:08:52.93,0:08:55.98,Caption,,0,0,0,,ПОМЕЩЕНИЯ УЖЕ ПУСТОВАЛИ. ПРИ ЭТОМ БЫЛИ И УДАЧНЫЕ
Dialogue: 0,0:08:55.98,0:09:00.38,Caption,,0,0,0,,СОВМЕСТНЫЕ ОПЕРАЦИИ, НО ИСЧЕЗНОВЕНИЕ ПОДОЗРЕВАЕМЫХ ДО ВИЗИТА ОСТАЛОСЬ
Dialogue: 0,0:09:00.38,0:09:04.70,Caption,,0,0,0,,СЛИШКОМ УДОБНОЙ ПРИВЫЧКОЙ. ПОХОЖИЕ ВОПРОСЫ ВОЗНИКАЛИ И ВОКРУГ МАТЕРИАЛОВ
Dialogue: 0,0:09:04.70,0:09:06.70,Caption,,0,0,0,,АВСТРИЙСКОЙ ПОЛИЦИИ ПО ДЕЛУ КАРФАГЕН.
Dialogue: 0,0:09:07.42,0:09:10.30,Caption,,0,0,0,,ЕСЛИ ЗАРУБЕЖНЫЙ ПАРТНЁР СООБЩАЕТ ТОЧНЫЙ АДРЕС,
Dialogue: 0,0:09:10.54,0:09:12.86,Caption,,0,0,0,,А НУЖНЫЕ ЛЮДИ УСПЕВАЮТ ВЫНЕСТИ КОМПЬЮТЕРЫ И
Dialogue: 0,0:09:12.86,0:09:16.94,Caption,,0,0,0,,РАСТВОРИТЬСЯ, ПРОБЛЕМА ЯВНО НЕ В МЕДЛЕННОЙ РАБОТЕ ЛИФТА. СУММЫ
Dialogue: 0,0:09:16.94,0:09:19.98,Caption,,0,0,0,,ПОКАЗЫВАЮТ МАСШТАБ. ЭСТОНСКАЯ СТОРОНА ОЦЕНИВАЛА
Dialogue: 0,0:09:19.98,0:09:22.70,Caption,,0,0,0,,УЩЕРБ В ПЯТНАДЦАТЬ МИЛЛИОНОВ ЕВРО ЗА ДВЕ ТЫСЯЧИ
Dialogue: 0,0:09:22.70,0:09:25.74,Caption,,0,0,0,,ДВАДЦАТЬ ЧЕТВЁРТЫЙ ГОД И В ТРИДЦАТЬ ЧЕТЫРЕ МИЛЛИОНА
Dialogue: 0,0:09:25.82,0:09:28.62,Caption,,0,0,0,,ЗА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТЫЙ. ПОЧТИ ПЯТЬДЕСЯТ
Dialogue: 0,0:09:28.62,0:09:31.18,Caption,,0,0,0,,МИЛЛИОНОВ ЗА ДВА ГОДА ДЛЯ СТРАНЫ С НАСЕЛЕНИЕМ
Dialogue: 0,0:09:31.40,0:09:34.86,Caption,,0,0,0,,ОКОЛО ОДНОГО МИЛЛИОНА ТРЁХСОТ ТЫСЯЧ ЧЕЛОВЕК. ЭТО УЖЕ
Dialogue: 0,0:09:34.86,0:09:36.62,Caption,,0,0,0,,НЕ НЕСКОЛЬКО ЛОВКИХ ЗВОНИЛЬЩИКОВ,
Dialogue: 0,0:09:36.86,0:09:39.98,Caption,,0,0,0,,КОТОРЫЕ СЛУЧАЙНО НАШЛИ ЧУЖУЮ БАНКОВСКУЮ КАРТУ. ПОСЛЕ
Dialogue: 0,0:09:40.06,0:09:42.62,Caption,,0,0,0,,КРУПНЫХ РАССЛЕДОВАНИЙ МОШЕННИЧЕСКИЕ ЗВОНКИ ИСЧЕЗЛИ
Dialogue: 0,0:09:42.70,0:09:45.34,Caption,,0,0,0,,ПРИМЕРНО НА ШЕСТЬ НЕДЕЛЬ. ЗАТЕМ СЕТЬ СНОВА
Dialogue: 0,0:09:45.42,0:09:48.78,Caption,,0,0,0,,ЗАРАБОТАЛА, А К ОСЕНИ ВЕРНУЛАСЬ ПОЧТИ К ПРЕЖНЕМУ РАЗМАХУ.
Dialogue: 0,0:09:51.06,0:09:53.54,Caption,,0,0,0,,ОФИСЫ МОЖНО ЗАКРЫТЬ, ТЕХНИКУ ИЗЪЯТЬ,
Dialogue: 0,0:09:53.70,0:09:56.82,Caption,,0,0,0,,СОТРУДНИКОВ ЗАДЕРЖАТЬ. НО ЕСЛИ ВНУТРИ СИСТЕМЫ
Dialogue: 0,0:09:56.82,0:09:59.94,Caption,,0,0,0,,ОСТАЮТСЯ ЛЮДИ, КОТОРЫЕ ПРЕДУПРЕЖДАЮТ ОБ ОПАСНОСТИ,
Dialogue: 0,0:10:00.32,0:10:02.90,Caption,,0,0,0,,ПРЕСТУПНЫЙ БИЗНЕС ПРОСТО ПЕРЕЖИДАЕТ ОБЫСК,
Dialogue: 0,0:10:03.06,0:10:05.94,Caption,,0,0,0,,КАК ДОЖДЬ ПОД КОЗЫРЬКОМ. ДЛЯ ЗЕЛЕНСКОГО ЭТА ЛИНИЯ
Dialogue: 0,0:10:05.94,0:10:07.86,Caption,,0,0,0,,ОЗНАЧАЕТ НОВЫЙ КРИЗИС ДОВЕРИЯ.
Dialogue: 0,0:10:08.49,0:10:10.98,Caption,,0,0,0,,СБУ ПОДОЗРЕВАЕТ АНТИКОРРУПЦИОННЫЕ ОРГАНЫ.
Dialogue: 0,0:10:11.39,0:10:13.78,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ ОРГАНЫ ИЗУЧАЮТ ВОЗМОЖНОЕ
Dialogue: 0,0:10:13.78,0:10:16.74,Caption,,0,0,0,,ПОКРОВИТЕЛЬСТВО СО СТОРОНЫ СИЛОВИКОВ. ЕВРОПЕЙСКИЕ
Dialogue: 0,0:10:16.82,0:10:21.06,Caption,,0,0,0,,ПОЛИЦЕЙСКИЕ ПЫТАЮТСЯ ПОНЯТЬ, ПОЧЕМУ ПЕРЕДАННАЯ ИНФОРМАЦИЯ ДОБИРАЕТСЯ ДО
Dialogue: 0,0:10:21.06,0:10:24.02,Caption,,0,0,0,,ПОДОЗРЕВАЕМЫХ БЫСТРЕЕ, ЧЕМ ОПЕРАТИВНАЯ ГРУППА.
Dialogue: 0,0:10:24.66,0:10:29.62,Caption,,0,0,0,,ПРЕЗИДЕНТУ УЖЕ МАЛО ВЫЯСНИТЬ, ЧЬЯ ВЕРСИЯ УБЕДИТЕЛЬНЕЕ. ЕМУ НЕОБХОДИМО ПОНИМАТЬ,
Dialogue: 0,0:10:29.94,0:10:32.98,Caption,,0,0,0,,КОМУ МОЖНО СООБЩИТЬ О ГОТОВЯЩЕЙСЯ ОПЕРАЦИИ ТАК,
Dialogue: 0,0:10:33.19,0:10:36.10,Caption,,0,0,0,,ЧТОБЫ УЧАСТНИКИ ПРЕСТУПНОЙ СЕТИ НЕ УЗНАЛИ ОБ ЭТОМ
Dialogue: 0,0:10:36.10,0:10:38.34,Caption,,0,0,0,,РАНЬШЕ НЕГО. ЗЕЛЕНСКИЙ РАССКАЗАЛ,
Dialogue: 0,0:10:38.58,0:10:40.74,Caption,,0,0,0,,ЧТО АМЕРИКАНСКИЕ ПРЕДСТАВИТЕЛИ СПРАШИВАЛИ О
Dialogue: 0,0:10:40.74,0:10:44.34,Caption,,0,0,0,,ГОТОВНОСТИ УКРАИНЫ ВЫВЕСТИ ВОЙСКА ИЗ ДОНБАССА В
Dialogue: 0,0:10:44.34,0:10:47.38,Caption,,0,0,0,,ОБМЕН НА ПЕРСПЕКТИВУ ЧЛЕНСТВА В НАТО. ПРЕДЛОЖЕНИЕ
Dialogue: 0,0:10:47.46,0:10:49.30,Caption,,0,0,0,,ВЫГЛЯДИТ СТРАННЫМ ТОЛЬКО ДО ТЕХ ПОР,
Dialogue: 0,0:10:49.52,0:10:53.30,Caption,,0,0,0,,ПОКА СЧИТАТЬ, ЧТО ВАШИНГТОН НЕПРЕМЕННО ХОТЕЛ УСЛЫШАТЬ СОГЛАСИЕ.
Dialogue: 0,0:10:53.88,0:10:56.82,Caption,,0,0,0,,МОСКВА ДАВНО ВЫСТУПАЕТ ПРОТИВ ВСТУПЛЕНИЯ УКРАИНЫ В
Dialogue: 0,0:10:56.90,0:11:00.02,Caption,,0,0,0,,АЛЬЯНС И ПОЯВЛЕНИЯ НАТОВСКОЙ ВОЕННОЙ ИНФРАСТРУКТУРЫ
Dialogue: 0,0:11:00.12,0:11:03.14,Caption,,0,0,0,,НА УКРАИНСКОЙ ТЕРРИТОРИИ. ПОЭТОМУ ОБМЕН ДОНБАССА НА
Dialogue: 0,0:11:03.14,0:11:06.42,Caption,,0,0,0,,ПЕРСПЕКТИВУ ЧЛЕНСТВА ЗАРАНЕЕ УПИРАЕТСЯ В РОССИЙСКУЮ
Dialogue: 0,0:11:06.42,0:11:10.23,Caption,,0,0,0,,ПОЗИЦИЮ. ВОЗНИКАЕТ ВОПРОС,
Dialogue: 0,0:11:10.32,0:11:13.19,Caption,,0,0,0,,ЗАЧЕМ АМЕРИКАНЦАМ ПОНАДОБИЛСЯ ОТВЕТ ЗЕЛЕНСКОГО НА
Dialogue: 0,0:11:13.19,0:11:16.95,Caption,,0,0,0,,КОНСТРУКЦИЮ, КОТОРАЯ САМА ПО СЕБЕ СОЗДАЁТ НОВОЕ ПРОТИВОРЕЧИЕ.
Dialogue: 0,0:11:17.24,0:11:21.67,Caption,,0,0,0,,ВОЗМОЖНО, ИМ БЫЛ НУЖЕН ИМЕННО ОТКАЗ. ВАШИНГТОН МОГ ПРОВЕРЯТЬ
Dialogue: 0,0:11:21.67,0:11:23.67,Caption,,0,0,0,,ПРЕДЕЛ УСТУПОК УКРАИНСКОГО РУКОВОДСТВА.
Dialogue: 0,0:11:24.39,0:11:26.55,Caption,,0,0,0,,ГОТОВ ЛИ ЗЕЛЕНСКИЙ ОБСУЖДАТЬ ТЕРРИТОРИАЛЬНЫЙ
Dialogue: 0,0:11:26.55,0:11:30.07,Caption,,0,0,0,,КОМПРОМИСС, ЕСЛИ ПЕРЕД НИМ ПОЛОЖАТ МАКСИМАЛЬНО ПРИВЛЕКАТЕЛЬНОЕ
Dialogue: 0,0:11:30.07,0:11:31.75,Caption,,0,0,0,,ОБЕЩАНИЕ В СФЕРЕ БЕЗОПАСНОСТИ?
Dialogue: 0,0:11:32.05,0:11:34.23,Caption,,0,0,0,,КАКИЕ ДОПОЛНИТЕЛЬНЫЕ УСЛОВИЯ ОН НАЗОВЁТ?
Dialogue: 0,0:11:34.51,0:11:38.07,Caption,,0,0,0,,ГДЕ ПРОВЕДЁТ ЛИНИЮ, ЧЕРЕЗ КОТОРУЮ НЕ СОБИРАЕТСЯ ПЕРЕСТУПАТЬ?
Dialogue: 0,0:11:38.78,0:11:43.19,Caption,,0,0,0,,ПОЛУЧИВ ПОДРОБНЫЙ ОТВЕТ, АМЕРИКАНСКАЯ СТОРОНА УЖЕ РАСПОЛАГАЕТ НЕ ВПЕЧАТЛЕНИЕМ
Dialogue: 0,0:11:43.28,0:11:45.75,Caption,,0,0,0,,И НЕ ОЧЕРЕДНОЙ РЕЧЬЮ ДЛЯ КАМЕР. У НЕЁ
Dialogue: 0,0:11:45.83,0:11:48.71,Caption,,0,0,0,,ЕСТЬ КОНКРЕТНАЯ ПОЗИЦИЯ ЗЕЛЕНСКОГО ПО КОНКРЕТНОМУ
Dialogue: 0,0:11:48.71,0:11:51.35,Caption,,0,0,0,,ПРЕДЛОЖЕНИЮ. ТАКОЙ ОТВЕТ МОЖНО ИСПОЛЬЗОВАТЬ В
Dialogue: 0,0:11:51.35,0:11:55.51,Caption,,0,0,0,,ДАЛЬНЕЙШИХ ПЕРЕГОВОРАХ, ПРИ ПОДГОТОВКЕ НОВОГО ВАРИАНТА СОГЛАШЕНИЯ ИЛИ ПРИ
Dialogue: 0,0:11:55.51,0:11:59.59,Caption,,0,0,0,,ОЦЕНКЕ ТОГО, ОСТАЁТСЯ ЛИ НЫНЕШНИЙ УКРАИНСКИЙ РУКОВОДИТЕЛЬ УДОБНЫМ
Dialogue: 0,0:11:59.59,0:12:02.79,Caption,,0,0,0,,УЧАСТНИКОМ ПРОЦЕССА. ЭТО НЕ ИСТОРИЯ ПРО ТО,
Dialogue: 0,0:12:03.03,0:12:05.99,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ ПРОСТО СКАЗАЛ ДА ИЛИ НЕТ. ИДЁТ
Dialogue: 0,0:12:05.99,0:12:09.27,Caption,,0,0,0,,ВОЙНА, И У НЕГО НЕТ РОСКОШИ СПОКОЙНО ВЫБИРАТЬ МЕЖДУ
Dialogue: 0,0:12:09.27,0:12:11.43,Caption,,0,0,0,,ВАРИАНТАМИ. ОН НАЗЫВАЕТ УСЛОВИЯ,
Dialogue: 0,0:12:11.58,0:12:14.71,Caption,,0,0,0,,ЗНАЯ, ЧТО ЛЮБАЯ УСТУПКА МЕНЯЕТ РАСКЛАД СИЛ,
Dialogue: 0,0:12:14.87,0:12:17.11,Caption,,0,0,0,,А ЛЮБОЙ ОТКАЗ БУДЕТ СТОИТЬ ЕМУ ДОРОГО.
Dialogue: 0,0:12:19.38,0:12:21.38,Caption,,0,0,0,,ПО ИЗЛОЖЕННОЙ ПОЗИЦИИ ЗЕЛЕНСКОГО,
Dialogue: 0,0:12:21.54,0:12:24.18,Caption,,0,0,0,,ВЫВОД ВОЙСК ДОЛЖЕН СОПРОВОЖДАТЬСЯ ГАРАНТИЯМИ
Dialogue: 0,0:12:24.18,0:12:26.82,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ФИНАНСИРОВАНИЕМ АРМИИ,
Dialogue: 0,0:12:27.06,0:12:29.46,Caption,,0,0,0,,ПОСТАВКАМИ ВООРУЖЕНИЙ И СРЕДСТВАМИ НА
Dialogue: 0,0:12:29.46,0:12:32.42,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ. НЕЙТРАЛЬНЫЙ СТАТУС ОН ОТВЕРГАЕТ,
Dialogue: 0,0:12:32.61,0:12:35.14,Caption,,0,0,0,,КАК И ПРИЗНАНИЕ ПОТЕРЯННЫХ ТЕРРИТОРИЙ РОССИЙСКИМИ.
Dialogue: 0,0:12:35.36,0:12:38.26,Caption,,0,0,0,,ПЕРЕД НАМИ НЕ ПРОСТОЕ НЕТ. ЭТО СПИСОК УСЛОВИЙ,
Dialogue: 0,0:12:38.43,0:12:42.26,Caption,,0,0,0,,ПОКАЗЫВАЮЩИЙ, НАСКОЛЬКО ДОРОГО ЗЕЛЕНСКИЙ ОЦЕНИВАЕТ ИЗМЕНЕНИЕ
Dialogue: 0,0:12:42.26,0:12:45.46,Caption,,0,0,0,,СВОЕГО КУРСА. АМЕРИКАНЦЫ ТЕПЕРЬ ЗНАЮТ ЭТУ ЦЕНУ.
Dialogue: 0,0:12:45.86,0:12:49.70,Caption,,0,0,0,,МОСКВА ВИДИТ, ЧТО КИЕВ ПРОДОЛЖАЕТ ДЕРЖАТЬСЯ ЗА ПРЕЖНИЕ ТРЕБОВАНИЯ.
Dialogue: 0,0:12:50.02,0:12:52.26,Caption,,0,0,0,,ЛЮДИ РЯДОМ С ПРЕЗИДЕНТОМ МОГУТ ПРИКИНУТЬ,
Dialogue: 0,0:12:52.34,0:12:55.30,Caption,,0,0,0,,ЧТО ПРОИЗОЙДЁТ, ЕСЛИ ВНЕШНИЕ УЧАСТНИКИ РЕШАТ,
Dialogue: 0,0:12:55.39,0:12:58.18,Caption,,0,0,0,,ЧТО ТОРГ ЗАТЯНУЛСЯ. ПЕРЕГОВОРЫ ИДУТ СРАЗУ НА
Dialogue: 0,0:12:58.18,0:13:01.06,Caption,,0,0,0,,НЕСКОЛЬКИХ УРОВНЯХ. РОССИЯ ПРОДВИГАЕТ СОБСТВЕННЫЕ
Dialogue: 0,0:13:01.06,0:13:03.86,Caption,,0,0,0,,УСЛОВИЯ. СОЕДИНЁННЫЕ ШТАТЫ ИЩУТ КОНСТРУКЦИЮ
Dialogue: 0,0:13:03.86,0:13:07.06,Caption,,0,0,0,,СОГЛАШЕНИЯ. ЕВРОПЕЙСКИЕ ГОСУДАРСТВА ЗАЩИЩАЮТ СВОИ
Dialogue: 0,0:13:07.06,0:13:10.02,Caption,,0,0,0,,ИНТЕРЕСЫ. КИЕВ СТАРАЕТСЯ СОХРАНИТЬ ГАРАНТИИ,
Dialogue: 0,0:13:10.13,0:13:13.70,Caption,,0,0,0,,АРМИЮ, ФИНАНСИРОВАНИЕ И ВОЗМОЖНОСТЬ НЕ ПРИЗНАВАТЬ ИТОГ
Dialogue: 0,0:13:13.70,0:13:16.42,Caption,,0,0,0,,ВОЙНЫ. К ЭТОМУ НАБОРУ ДОБАВИЛСЯ СЛУХ О СНЯТОМ
Dialogue: 0,0:13:16.42,0:13:19.46,Caption,,0,0,0,,ОГРАНИЧЕНИИ НА УСТРАНЕНИЕ ЗЕЛЕНСКОГО. ВНУТРИ СТРАНЫ
Dialogue: 0,0:13:19.54,0:13:22.26,Caption,,0,0,0,,ГЕНЕРАЛ СБУ ОБВИНЯЕТ НАБУ И САП В ДЕЙСТВИЯХ
Dialogue: 0,0:13:22.34,0:13:24.98,Caption,,0,0,0,,НА ПОЛЬЗУ РОССИИ. КОРРУПЦИОННЫЕ МАТЕРИАЛЫ ВЕДУТ К
Dialogue: 0,0:13:24.98,0:13:27.94,Caption,,0,0,0,,СИЛОВЫМ ВЕДОМСТВАМ. ЕВРОПЕЙСКИЕ ПАРТНЁРЫ СПРАШИВАЮТ
Dialogue: 0,0:13:28.02,0:13:33.34,Caption,,0,0,0,,ОБ УТЕЧКАХ. ЭТО УЖЕ ТРОЙНОЙ УДАР ПО ЛИЧНОЙ БЕЗОПАСНОСТИ
Dialogue: 0,0:13:33.34,0:13:37.10,Caption,,0,0,0,,ПРЕЗИДЕНТА, ПО УПРАВЛЯЕМОСТИ ЕГО АППАРАТА И ПО ЕГО ПОЗИЦИИ
Dialogue: 0,0:13:37.18,0:13:39.98,Caption,,0,0,0,,НА ПЕРЕГОВОРАХ. САМ ЗЕЛЕНСКИЙ МОЖЕТ ПРОДОЛЖАТЬ
Dialogue: 0,0:13:39.98,0:13:43.74,Caption,,0,0,0,,ВЫСТУПАТЬ, ОТВЕРГАТЬ ПРЕДЛОЖЕНИЯ И ТРЕБОВАТЬ ГАРАНТИЙ. НО
Dialogue: 0,0:13:43.74,0:13:46.30,Caption,,0,0,0,,УСТОЙЧИВОСТЬ ВЛАСТИ ЗАВИСИТ НЕ ТОЛЬКО ОТ ЧЕЛОВЕКА У
Dialogue: 0,0:13:46.30,0:13:48.62,Caption,,0,0,0,,МИКРОФОНА. ЗА НИМ СТОЯТ ОХРАНА,
Dialogue: 0,0:13:48.74,0:13:51.66,Caption,,0,0,0,,ЧИНОВНИКИ, ВОЕННЫЕ, РУКОВОДИТЕЛИ СЛУЖБ,
Dialogue: 0,0:13:51.81,0:13:55.18,Caption,,0,0,0,,ФИНАНСИСТЫ И ИСПОЛНИТЕЛИ РЕШЕНИЙ. У КАЖДОГО ЕСТЬ
Dialogue: 0,0:13:55.26,0:13:58.30,Caption,,0,0,0,,СОБСТВЕННОЕ ПРЕДСТАВЛЕНИЕ О ДОПУСТИМОМ РИСКЕ. ПОКА
Dialogue: 0,0:13:58.38,0:14:02.06,Caption,,0,0,0,,КУРС ВЫГЛЯДИТ ПРОЧНЫМ, АППАРАТ СПОСОБЕН ДВИГАТЬСЯ В ОДНОМ НАПРАВЛЕНИИ.
Dialogue: 0,0:14:02.49,0:14:04.62,Caption,,0,0,0,,КОГДА ОДНОВРЕМЕННО РАСТЁТ ВНЕШНЯЯ УГРОЗА,
Dialogue: 0,0:14:04.85,0:14:06.70,Caption,,0,0,0,,СЛЕДОВАТЕЛИ ПРИХОДЯТ К СИЛОВИКАМ,
Dialogue: 0,0:14:06.82,0:14:09.66,Caption,,0,0,0,,СИЛОВИКИ ОБЪЯВЛЯЮТ СЛЕДОВАТЕЛЕЙ ПОМОЩНИКАМИ МОСКВЫ,
Dialogue: 0,0:14:09.81,0:14:12.62,Caption,,0,0,0,,А СОЮЗНИКИ ПРОВЕРЯЮТ ГОТОВНОСТЬ ПРЕЗИДЕНТА УСТУПАТЬ,
Dialogue: 0,0:14:13.03,0:14:16.14,Caption,,0,0,0,,ПРЕЖНЕЕ ЕДИНСТВО НАЧИНАЕТ СТОИТЬ СЛИШКОМ ДОРОГО. ВОТ
Dialogue: 0,0:14:16.14,0:14:19.02,Caption,,0,0,0,,ПОЧЕМУ СВЕДЕНИЯ О ВОЗМОЖНОМ УСТРАНЕНИИ АДРЕСОВАНЫ НЕ
Dialogue: 0,0:14:19.02,0:14:22.22,Caption,,0,0,0,,ОДНОМУ ЗЕЛЕНСКОМУ. ОНИ ОБРАЩЕНЫ КО ВСЕЙ СИСТЕМЕ
Dialogue: 0,0:14:22.22,0:14:24.94,Caption,,0,0,0,,ВОКРУГ НЕГО. КАЖДОМУ ПРЕДЛАГАЕТСЯ РЕШИТЬ,
Dialogue: 0,0:14:25.10,0:14:28.14,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО ОН ГОТОВ ИДТИ ВМЕСТЕ С ЧЕЛОВЕКОМ,
Dialogue: 0,0:14:28.30,0:14:32.22,Caption,,0,0,0,,ЧЬЯ БЕЗОПАСНОСТЬ, ПЕРЕГОВОРНАЯ РОЛЬ И КОНТРОЛЬ НАД ВЕДОМСТВАМИ
Dialogue: 0,0:14:32.45,0:14:35.42,Caption,,0,0,0,,ОКАЗАЛИСЬ ПОД ВОПРОСОМ ОДНОВРЕМЕННО. ДВЕ ЛИНИИ
Dialogue: 0,0:14:35.42,0:14:38.70,Caption,,0,0,0,,ДАВЛЕНИЯ СХОДЯТСЯ ИМЕННО ЗДЕСЬ. СНАРУЖИ ЗЕЛЕНСКОМУ
Dialogue: 0,0:14:38.70,0:14:41.74,Caption,,0,0,0,,СООБЩАЮТ, ЧТО ПРЕЖНЕГО ОГРАНИЧЕНИЯ БОЛЬШЕ НЕТ.
Dialogue: 0,0:14:44.02,0:14:47.06,Caption,,0,0,0,,ИЗНУТРИ ЕМУ ПОКАЗЫВАЮТ КОНФЛИКТ МЕЖДУ СТРУКТУРАМИ,
Dialogue: 0,0:14:47.31,0:14:50.50,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ ЗАЩИЩАТЬ ГОСУДАРСТВО И ОЧИЩАТЬ ЕГО ОТ
Dialogue: 0,0:14:50.58,0:14:54.98,Caption,,0,0,0,,КОРРУПЦИИ. ДАЖЕ БЕЗ ЕДИНОГО ОБЩЕГО ПЛАНА ПОСЛЕДСТВИЯ ПОЛУЧАЮТСЯ
Dialogue: 0,0:14:55.06,0:14:58.18,Caption,,0,0,0,,ВПОЛНЕ ОБЩИМИ. ВАШИНГТОН ПРОВЕРЯЕТ ЕГО ПРЕДЕЛЫ.
Dialogue: 0,0:14:58.50,0:15:01.94,Caption,,0,0,0,,МОСКВА УСИЛИВАЕТ РИСК. НАБУ И САП ЗАТРАГИВАЮТ
Dialogue: 0,0:15:01.94,0:15:04.98,Caption,,0,0,0,,ИНТЕРЕСЫ СИЛОВИКОВ. ПРЕДСТАВИТЕЛЬ СБУ ОТВЕЧАЕТ
Dialogue: 0,0:15:05.06,0:15:07.70,Caption,,0,0,0,,ОБВИНЕНИЕМ В РАБОТЕ НА ПРОТИВНИКА. ЕВРОПЕЙСКАЯ
Dialogue: 0,0:15:07.78,0:15:11.94,Caption,,0,0,0,,ПОЛИЦИЯ ОБНАРУЖИВАЕТ, ЧТО ПОДОЗРЕВАЕМЫЕ УМЕЮТ ИСЧЕЗАТЬ РАНЬШЕ ВИЗИТА
Dialogue: 0,0:15:11.94,0:15:14.98,Caption,,0,0,0,,ОПЕРАТИВНИКОВ. ПОПРОБУЙТЕ РУКОВОДИТЬ ТАКИМ АППАРАТОМ
Dialogue: 0,0:15:15.15,0:15:17.94,Caption,,0,0,0,,И НЕ ОБОРАЧИВАТЬСЯ НА КАЖДОМ СОВЕЩАНИИ. ВНЕШНЕГО
Dialogue: 0,0:15:17.94,0:15:20.50,Caption,,0,0,0,,ПРОТИВНИКА ХОТЯ БЫ ВИДНО. НАМНОГО ХУЖЕ,
Dialogue: 0,0:15:20.70,0:15:23.38,Caption,,0,0,0,,КОГДА ЛЮДИ С ОДИНАКОВЫМИ УДОСТОВЕРЕНИЯМИ УЖЕ НЕ
Dialogue: 0,0:15:23.46,0:15:26.50,Caption,,0,0,0,,МОГУТ ДОГОВОРИТЬСЯ, КТО ИЗ НИХ ЗАЩИЩАЕТ СТРАНУ,
Dialogue: 0,0:15:26.74,0:15:29.38,Caption,,0,0,0,,А КТО ЗАЩИЩАЕТ СОБСТВЕННУЮ КАССУ. СИСТЕМА
Dialogue: 0,0:15:29.38,0:15:31.14,Caption,,0,0,0,,ВЫДЕРЖИВАЕТ ОГРОМНОЕ ДАВЛЕНИЕ,
Dialogue: 0,0:15:31.39,0:15:34.50,Caption,,0,0,0,,ПОКА ЕЁ УЧАСТНИКИ ДОВЕРЯЮТ ДРУГ ДРУГУ. КОГДА ЭТО
Dialogue: 0,0:15:34.50,0:15:36.74,Caption,,0,0,0,,ДОВЕРИЕ ЗАМЕНЯЮТ ВЗАИМНЫЕ ОБВИНЕНИЯ,
Dialogue: 0,0:15:37.00,0:15:40.34,Caption,,0,0,0,,ЛЮБОЙ ВНЕШНИЙ СИГНАЛ СТАНОВИТСЯ ВДВОЕ СИЛЬНЕЕ. И
Dialogue: 0,0:15:40.34,0:15:43.06,Caption,,0,0,0,,ТОГДА БУДУЩЕЕ ЗЕЛЕНСКОГО ОПРЕДЕЛЯЮТ УЖЕ НЕ ТОЛЬКО
Dialogue: 0,0:15:43.06,0:15:46.50,Caption,,0,0,0,,ТРЕБОВАНИЯ МОСКВЫ ИЛИ ПРЕДЛОЖЕНИЯ ВАШИНГТОНА. ЕГО
Dialogue: 0,0:15:46.50,0:15:48.90,Caption,,0,0,0,,ОПРЕДЕЛЯЕТ ГОТОВНОСТЬ СОБСТВЕННОГО ОКРУЖЕНИЯ
Dialogue: 0,0:15:48.90,0:15:53.38,Caption,,0,0,0,,ВЫПОЛНЯТЬ РЕШЕНИЯ ЧЕЛОВЕКА, РЯДОМ С КОТОРЫМ ВНЕЗАПНО СТАЛО СЛИШКОМ ОПАСНО
Dialogue: 0,0:15:53.38,0:15:56.02,Caption,,0,0,0,,СТОЯТЬ. ЕСЛИ ВАМ ВАЖНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:15:56.23,0:15:57.30,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ.
