Dialogue: 0,0:00:00.12,0:00:04.36,Caption,,0,0,0,,ПРЕДСТАВЬТЕ ЛОДКУ, В КОТОРОЙ УЖЕ ХЛЮПАЕТ ПОД НОГАМИ. ВОДА ПРИБЫВАЕТ,
Dialogue: 0,0:00:04.51,0:00:07.80,Caption,,0,0,0,,БОРТА ВСЁ НИЖЕ, А ЛЮДИ НАВЕРХУ ДЕЛОВИТО ОБСУЖДАЮТ,
Dialogue: 0,0:00:08.03,0:00:11.16,Caption,,0,0,0,,ГДЕ РАЗДОБЫТЬ ЕЩЁ ОДНО ВЕДРО. ИХ ИНТЕРЕСУЕТ ТОЛЬКО
Dialogue: 0,0:00:11.24,0:00:14.20,Caption,,0,0,0,,ВЕДРО ПОКРЕПЧЕ. И ЧЕМ БЛИЖЕ ВОДА К ПОДБОРОДКУ,
Dialogue: 0,0:00:14.44,0:00:17.64,Caption,,0,0,0,,ТЕМ УВЕРЕННЕЕ ЗВУЧИТ КОМАНДА ГРЕБЁМ ДАЛЬШЕ. ВОТ МНЕ
Dialogue: 0,0:00:17.64,0:00:21.48,Caption,,0,0,0,,И ЛЮБОПЫТНО, КАКОЕ СОБЫТИЕ ВСЁ ТАКИ СПОСОБНО ПРЕРВАТЬ ЭТОТ
Dialogue: 0,0:00:21.48,0:00:25.08,Caption,,0,0,0,,УДИВИТЕЛЬНЫЙ ЗАПЛЫВ? ЕСЛИ ВАМ НРАВЯТСЯ РАЗГОВОРЫ БЕЗ ПОЛИТИЧЕСКОГО
Dialogue: 0,0:00:25.08,0:00:28.44,Caption,,0,0,0,,СИРОПА, ПОДПИШИТЕСЬ. СЕЙЧАС КИЕВ УЖЕ ПЛАНИРУЕТ ПОМОЩЬ,
Dialogue: 0,0:00:28.68,0:00:31.72,Caption,,0,0,0,,КОТОРУЮ, ВОЗМОЖНО, БУДУТ ОБСУЖДАТЬ ЛЮДИ,
Dialogue: 0,0:00:31.95,0:00:35.00,Caption,,0,0,0,,ЕЩЁ ТОЛКОМ НЕ ВОШЕДШИЕ В СВОИ КАБИНЕТЫ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:00:35.08,0:00:37.64,Caption,,0,0,0,,ГОВОРИТ О КОНТАКТАХ С ДЕМОКРАТАМИ В БУДУЩЕМ СОСТАВЕ
Dialogue: 0,0:00:37.72,0:00:39.64,Caption,,0,0,0,,АМЕРИКАНСКОГО КОНГРЕССА И РАССЧИТЫВАЕТ,
Dialogue: 0,0:00:39.88,0:00:42.84,Caption,,0,0,0,,ЧТО ОТ НИХ ПОДДЕРЖКИ БУДЕТ БОЛЬШЕ. ЛОГИКА ПОНЯТНАЯ.
Dialogue: 0,0:00:43.24,0:00:46.20,Caption,,0,0,0,,ЕСЛИ НЫНЕШНЯЯ КАССА ВЫДАЁТ МЕНЬШЕ ЖЕЛАЕМОГО,
Dialogue: 0,0:00:46.43,0:00:48.68,Caption,,0,0,0,,НАДО ЗАРАНЕЕ ЗАНЯТЬ ОЧЕРЕДЬ К СЛЕДУЮЩЕЙ.
Dialogue: 0,0:00:48.91,0:00:51.64,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПОЛИТИКИ ПОКА ПРИМЕРЯЮТСЯ К КРЕСЛАМ,
Dialogue: 0,0:00:51.88,0:00:54.04,Caption,,0,0,0,,А ВОЗЛЕ ДВЕРИ УЖЕ СТОИТ ЧЕЛОВЕК С ТЕЛЕЖКОЙ
Dialogue: 0,0:00:54.12,0:00:58.20,Caption,,0,0,0,,И СПРАШИВАЕТ, КОГДА ОТКРОЕТСЯ СКЛАД. ТОЛЬКО У ЭТОГО РАСЧЁТА ЕСТЬ
Dialogue: 0,0:00:58.20,0:01:02.68,Caption,,0,0,0,,МАЛЕНЬКАЯ, ПОЧТИ НЕВЕЖЛИВАЯ ПОДРОБНОСТЬ. БУДУЩАЯ ПОЛИТИЧЕСКАЯ
Dialogue: 0,0:01:02.68,0:01:06.36,Caption,,0,0,0,,КОНФИГУРАЦИЯ НАХОДИТСЯ В БУДУЩЕМ. А РАКЕТЫ ЛЕТЯТ,
Dialogue: 0,0:01:06.52,0:01:08.52,Caption,,0,0,0,,ЭНЕРГОСИСТЕМА РАБОТАЕТ НА ИЗНОС,
Dialogue: 0,0:01:08.76,0:01:11.40,Caption,,0,0,0,,ЛЮДЯМ НУЖНЫ СВЕТ И ВОДА В НАСТОЯЩЕМ. ДО
Dialogue: 0,0:01:11.40,0:01:14.20,Caption,,0,0,0,,РАСШИРЕНИЯ ПРОИЗВОДСТВА НАДО ДОЖИТЬ. ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:01:14.28,0:01:15.80,Caption,,0,0,0,,КАЛЕНДАРЬ МОЖНО ЛИСТАТЬ ПАЛЬЦЕМ.
Dialogue: 0,0:01:18.07,0:01:20.95,Caption,,0,0,0,,СТРАНА ТЕМ ВРЕМЕНЕМ ПРОЖИВАЕТ КАЖДЫЙ ЕГО ДЕНЬ ПО
Dialogue: 0,0:01:20.95,0:01:24.07,Caption,,0,0,0,,НАСТОЯЩЕМУ. ОСОБЕННО ХОРОШО ЭТО ВИДНО НА ИСТОРИИ С
Dialogue: 0,0:01:24.07,0:01:26.63,Caption,,0,0,0,,КОМПЛЕКСАМИ ПЭТРИОТ. КИЕВ ГОВОРИТ,
Dialogue: 0,0:01:26.79,0:01:29.35,Caption,,0,0,0,,ЧТО СИСТЕМ НЕ ХВАТАЕТ. БЕРЛИН ОТВЕЧАЕТ,
Dialogue: 0,0:01:29.57,0:01:31.99,Caption,,0,0,0,,ЧТО НОВЫХ КОМПЛЕКСОВ ПЕРЕДАВАТЬ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:01:32.30,0:01:35.19,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ ГЕРМАНИИ БОРИС ПИСТОРИУС ОБЪЯСНЯЕТ
Dialogue: 0,0:01:35.19,0:01:37.91,Caption,,0,0,0,,ПРИЧИНУ БЕЗ ОСОБОЙ ПОЭЗИИ ГЕРМАНИЯ УЖЕ ОТДАЛА
Dialogue: 0,0:01:37.99,0:01:39.91,Caption,,0,0,0,,НЕСКОЛЬКО СИСТЕМ И МНОЖЕСТВО РАКЕТ,
Dialogue: 0,0:01:40.28,0:01:43.03,Caption,,0,0,0,,А ДАЛЬШЕ НАЧИНАЕТ ОГОЛЯТЬСЯ ЕЁ СОБСТВЕННАЯ ОБОРОНА.
Dialogue: 0,0:01:43.33,0:01:45.91,Caption,,0,0,0,,ВОТ ТАК МЕЖДУНАРОДНАЯ СОЛИДАРНОСТЬ ВСТРЕЧАЕТСЯ С
Dialogue: 0,0:01:45.91,0:01:48.63,Caption,,0,0,0,,ИНВЕНТАРИЗАЦИЕЙ. ПОКА В КЛАДОВКЕ МНОГО КОРОБОК,
Dialogue: 0,0:01:48.87,0:01:51.27,Caption,,0,0,0,,ХОЗЯИН ЩЕДРЫЙ. ОН ВЫНОСИТ ОДНУ,
Dialogue: 0,0:01:51.36,0:01:54.79,Caption,,0,0,0,,ВТОРУЮ И ДАЖЕ КРАСИВО ФОТОГРАФИРУЕТСЯ ВОЗЛЕ ТРЕТЬЕЙ.
Dialogue: 0,0:01:55.14,0:01:58.39,Caption,,0,0,0,,НО КОГДА ОСТАЁТСЯ ПОСЛЕДНЯЯ, ВНЕЗАПНО ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:01:58.63,0:02:01.59,Caption,,0,0,0,,ЧТО ХОЗЯИНУ ОНА ТОЖЕ ЗАЧЕМ ТО НУЖНА. КАКАЯ
Dialogue: 0,0:02:01.59,0:02:05.99,Caption,,0,0,0,,НЕОЖИДАННОСТЬ. ОКАЗЫВАЕТСЯ, У ГЕРМАНИИ ИМЕЕТСЯ НЕ ТОЛЬКО ДОБРАЯ ВОЛЯ,
Dialogue: 0,0:02:06.23,0:02:08.95,Caption,,0,0,0,,НО И СОБСТВЕННАЯ СТРАНА. ЭТО НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:02:09.11,0:02:12.39,Caption,,0,0,0,,ЧТО БЕРЛИН ПЕРЕСТАЛ ПОДДЕРЖИВАТЬ КИЕВ. СМЫСЛ ЖЁСТЧЕ.
Dialogue: 0,0:02:12.78,0:02:15.99,Caption,,0,0,0,,ЗАПАС, КОТОРЫЙ РАНЬШЕ МОЖНО БЫЛО ПЕРЕДВИГАТЬ ДАЛЬШЕ,
Dialogue: 0,0:02:16.15,0:02:19.67,Caption,,0,0,0,,УПЁРСЯ В ПРЕДЕЛ. ЕВРОПЕЙЦАМ ТОЖЕ ТРЕБУЕТСЯ ЗАЩИЩАТЬ
Dialogue: 0,0:02:19.67,0:02:23.67,Caption,,0,0,0,,СЕБЯ, И НИЖНЯЯ ПОЛКА УЖЕ ПОКАЗАЛАСЬ. А ПОТРЕБНОСТЬ УКРАИНЫ
Dialogue: 0,0:02:23.67,0:02:27.11,Caption,,0,0,0,,ИМЕННО СЕЙЧАС НЕ УМЕНЬШАЕТСЯ. ЗЕЛЕНСКИЙ ЗАЯВЛЯЛ,
Dialogue: 0,0:02:27.34,0:02:30.07,Caption,,0,0,0,,ЧТО ВО ВРЕМЯ ОДНОГО МАССИРОВАННОГО УДАРА ПО КИЕВУ
Dialogue: 0,0:02:30.38,0:02:33.19,Caption,,0,0,0,,И ОБЛАСТИ ПРИМЕНИЛИ ТРИДЦАТЬ ШЕСТЬ БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:02:33.27,0:02:38.82,Caption,,0,0,0,,РАКЕТ. УКРАИНСКАЯ СТОРОНА СООБЩИЛА О ЧЕТЫРЁХ ПЕРЕХВАТАХ.
Dialogue: 0,0:02:39.04,0:02:44.02,Caption,,0,0,0,,ЧЕТЫРЕ ИЗ ТРИДЦАТИ ШЕСТИ. ЕСЛИ ПОЛЬЗОВАТЬСЯ ИМЕННО КИЕВСКИМИ ЧИСЛАМИ,
Dialogue: 0,0:02:44.26,0:02:47.22,Caption,,0,0,0,,ТРИДЦАТЬ ДВЕ РАКЕТЫ В ЗАЯВЛЕННЫЙ РЕЗУЛЬТАТ ПЕРЕХВАТА
Dialogue: 0,0:02:47.37,0:02:50.82,Caption,,0,0,0,,НЕ ВОШЛИ. ТУТ НЕ ТРЕБУЕТСЯ НИ АНАЛИТИЧЕСКИЙ ЦЕНТР,
Dialogue: 0,0:02:51.06,0:02:54.34,Caption,,0,0,0,,НИ ЧЕЛОВЕК В ДОРОГИХ ОЧКАХ. ДОСТАТОЧНО АРИФМЕТИКИ ИЗ
Dialogue: 0,0:02:54.34,0:02:57.86,Caption,,0,0,0,,НАЧАЛЬНОЙ ШКОЛЫ, КОТОРАЯ В ДАННОМ СЛУЧАЕ ЗВУЧИТ ДОВОЛЬНО МРАЧНО.
Dialogue: 0,0:02:58.17,0:03:01.46,Caption,,0,0,0,,ОТДЕЛЬНО БЫЛА НАЗВАНА СЕВЕРОКОРЕЙСКАЯ РАКЕТА КА ЭН
Dialogue: 0,0:03:01.46,0:03:03.62,Caption,,0,0,0,,ДВАДЦАТЬ ТРИ. ПО СЛОВАМ ЗЕЛЕНСКОГО,
Dialogue: 0,0:03:03.86,0:03:07.46,Caption,,0,0,0,,ОДНА ТАКАЯ РАКЕТА УДАРИЛА ПО ВАЖНОМУ ЭНЕРГЕТИЧЕСКОМУ
Dialogue: 0,0:03:07.46,0:03:10.02,Caption,,0,0,0,,ОБЪЕКТУ. ЗНАЧИТ, ВОПРОС УЖЕ НЕ В ТОМ,
Dialogue: 0,0:03:10.26,0:03:12.34,Caption,,0,0,0,,НЕПЛОХО ЛИ БЫЛО БЫ ПОЛУЧИТЬ ДОПОЛНИТЕЛЬНУЮ
Dialogue: 0,0:03:12.34,0:03:14.98,Caption,,0,0,0,,УСТАНОВКУ. ПЕРЕХВАТЫВАТЬ БАЛЛИСТИКУ ТРЕБУЕТСЯ НЕ
Dialogue: 0,0:03:15.06,0:03:17.14,Caption,,0,0,0,,ПОСЛЕ ПОЯВЛЕНИЯ НОВЫХ КОНГРЕССМЕНОВ,
Dialogue: 0,0:03:17.39,0:03:20.02,Caption,,0,0,0,,НЕ ПОСЛЕ ПОДПИСАНИЯ БУДУЩИХ КОНТРАКТОВ И НЕ ПОСЛЕ
Dialogue: 0,0:03:20.02,0:03:23.38,Caption,,0,0,0,,ТОГО, КАК ОЧЕРЕДНОЙ ЗАВОД ТОРЖЕСТВЕННО НАРИСУЕТ ПЛАН
Dialogue: 0,0:03:23.38,0:03:27.06,Caption,,0,0,0,,РАСШИРЕНИЯ. ЭТО ТРЕБУЕТСЯ СЕЙЧАС. А В ОТВЕТ СЛЫШНО
Dialogue: 0,0:03:27.14,0:03:28.82,Caption,,0,0,0,,У НАС САМИХ ШКАФ НЕ РЕЗИНОВЫЙ,
Dialogue: 0,0:03:29.22,0:03:31.70,Caption,,0,0,0,,И НАЗВАНИЕ ЭТИХ СИСТЕМ ЗВУЧИТ ОСОБЕННО ГОРЬКО,
Dialogue: 0,0:03:31.94,0:03:34.10,Caption,,0,0,0,,ВЕДЬ ПЭТРИОТ ПО РУССКИ ЗНАЧИТ ПАТРИОТ,
Dialogue: 0,0:03:34.40,0:03:36.82,Caption,,0,0,0,,А ПАТРИОТОВ, ГОТОВЫХ СКАЗАТЬ ХВАТИТ,
Dialogue: 0,0:03:36.98,0:03:39.38,Caption,,0,0,0,,СРЕДИ ВСЕХ УЧАСТНИКОВ КАК РАЗ И НЕ НАХОДИТСЯ.
Dialogue: 0,0:03:39.67,0:03:42.50,Caption,,0,0,0,,ОЧЕНЬ БОДРАЯ ПОЛУЧАЕТСЯ КОНСТРУКЦИЯ. УГРОЗА
Dialogue: 0,0:03:42.50,0:03:46.34,Caption,,0,0,0,,СЕГОДНЯШНЯЯ, А НАДЕЖДА ЗАВТРАШНЯЯ. СЧЁТ УЖЕ ПРИНЕСЛИ,
Dialogue: 0,0:03:46.66,0:03:49.22,Caption,,0,0,0,,НО РАСПЛАТИТЬСЯ ПРЕДЛАГАЮТ ДЕНЬГАМИ ИЗ ЗАРПЛАТЫ,
Dialogue: 0,0:03:49.32,0:03:52.34,Caption,,0,0,0,,КОТОРУЮ, МОЖЕТ БЫТЬ, ВЫДАДУТ ЧЕРЕЗ ПАРУ ЛЕТ.
Dialogue: 0,0:03:54.62,0:03:56.70,Caption,,0,0,0,,НА ЭТОМ ФОНЕ КИЕВ СТАЛКИВАЕТСЯ ЕЩЁ И С
Dialogue: 0,0:03:56.78,0:03:59.50,Caption,,0,0,0,,БЫТОВЫМ УЗЛОМ ПРОБЛЕМ. АВАРИЙНЫЕ ОТКЛЮЧЕНИЯ
Dialogue: 0,0:03:59.50,0:04:01.58,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА, ПЕРЕБОИ С ВОДОЙ,
Dialogue: 0,0:04:01.82,0:04:04.38,Caption,,0,0,0,,ЗАВИСИМОСТЬ ЧАСТИ ИНФРАСТРУКТУРЫ ОТ ГЕНЕРАТОРОВ,
Dialogue: 0,0:04:04.61,0:04:06.86,Caption,,0,0,0,,НЕОБХОДИМОСТЬ ТОПЛИВА И СПОРЫ О ТОМ,
Dialogue: 0,0:04:07.02,0:04:10.30,Caption,,0,0,0,,КТО ПОДГОТОВИЛСЯ ХУЖЕ. ЗЕЛЕНСКИЙ КРИТИКУЕТ ГОРОДСКУЮ
Dialogue: 0,0:04:10.30,0:04:13.82,Caption,,0,0,0,,ПОДГОТОВКУ, В ТОМ ЧИСЛЕ АЛЬТЕРНАТИВНОЕ ОБЕСПЕЧЕНИЕ ВОДОКАНАЛА.
Dialogue: 0,0:04:14.13,0:04:18.14,Caption,,0,0,0,,КЛИЧКО ОТВЕЧАЕТ, ЧТО МАСШТАБЫ ПОТРЕБНОСТЕЙ СЛИШКОМ ВЕЛИКИ И ОДНИМИ
Dialogue: 0,0:04:18.14,0:04:21.26,Caption,,0,0,0,,ГЕНЕРАТОРАМИ ИХ ФИЗИЧЕСКИ НЕ ЗАКРЫТЬ. СОБСТВЕННО,
Dialogue: 0,0:04:21.39,0:04:23.90,Caption,,0,0,0,,ЭТИМ ВСЁ И СКАЗАНО. НЕТ ЭЛЕКТРИЧЕСТВА,
Dialogue: 0,0:04:24.06,0:04:27.26,Caption,,0,0,0,,ВСТАЁТ НАСОС. ДЛЯ НАСОСА ИЩУТ ГЕНЕРАТОР. ДЛЯ
Dialogue: 0,0:04:27.26,0:04:30.62,Caption,,0,0,0,,ГЕНЕРАТОРА ИЩУТ ТОПЛИВО. ДЛЯ ТОПЛИВА НУЖЕН ПОДВОЗ.
Dialogue: 0,0:04:30.79,0:04:35.74,Caption,,0,0,0,,ДЛЯ ПОДВОЗА НУЖНЫ ДОРОГИ, ТЕХНИКА И ЛЮДИ. ОДИН ВЫКЛЮЧАТЕЛЬ ПОТЯНУЛ ЗА СОБОЙ
Dialogue: 0,0:04:35.74,0:04:39.98,Caption,,0,0,0,,ЦЕЛУЮ ВЕРЕНИЦУ, СЛОВНО ВЫ ДЁРНУЛИ НИТКУ НА СВИТЕРЕ И ВНЕЗАПНО
Dialogue: 0,0:04:39.98,0:04:42.38,Caption,,0,0,0,,ОСТАЛИСЬ С ВОРОТНИКОМ В РУКАХ. И ЭТО ЛИШЬ
Dialogue: 0,0:04:42.38,0:04:45.10,Caption,,0,0,0,,СТОЛИЦА. УКРАИНСКАЯ РАЗВЕДКА,
Dialogue: 0,0:04:45.26,0:04:49.50,Caption,,0,0,0,,КАК ГОВОРИЛ ЗЕЛЕНСКИЙ, РАСПОЛАГАЕТ СВЕДЕНИЯМИ О ПОДГОТОВКЕ НОВЫХ УДАРОВ ПО
Dialogue: 0,0:04:49.50,0:04:51.42,Caption,,0,0,0,,ЭНЕРГЕТИКЕ И МОСТАМ ЧЕРЕЗ ДНЕПР.
Dialogue: 0,0:04:51.98,0:04:54.38,Caption,,0,0,0,,МОСТ В ТАКОЙ СИТУАЦИИ ЯВЛЯЕТСЯ НЕ КРАСИВОЙ
Dialogue: 0,0:04:54.46,0:04:56.94,Caption,,0,0,0,,ДЕКОРАЦИЕЙ ДЛЯ ВЕЧЕРНЕГО ВЫПУСКА. ЧЕРЕЗ НЕГО
Dialogue: 0,0:04:56.94,0:04:59.98,Caption,,0,0,0,,ДВИЖУТСЯ ЛЮДИ, ГРУЗЫ, АВТОМОБИЛИ,
Dialogue: 0,0:05:00.14,0:05:05.58,Caption,,0,0,0,,ПОЕЗДА, ТЕХНИКА, РЕМОНТНЫЕ БРИГАДЫ И ВСЁ НЕОБХОДИМОЕ ДЛЯ СВЯЗИ ДВУХ
Dialogue: 0,0:05:05.66,0:05:11.79,Caption,,0,0,0,,ОГРОМНЫХ ЧАСТЕЙ СТРАНЫ. НО КАЖДОЕ СЛОВО "МОЖНО" ОЗНАЧАЕТ,
Dialogue: 0,0:05:11.93,0:05:14.75,Caption,,0,0,0,,ЧТО КТО ТО ДОЛЖЕН ПРИЕХАТЬ, РАЗГРУЗИТЬ,
Dialogue: 0,0:05:14.83,0:05:17.71,Caption,,0,0,0,,СВАРИТЬ, ПОДНЯТЬ, ПОДКЛЮЧИТЬ И ПРОВЕРИТЬ.
Dialogue: 0,0:05:18.30,0:05:20.91,Caption,,0,0,0,,ТАБЛИЦА В КАБИНЕТЕ НЕ НАДЕВАЕТ КАСКУ. ПЛАН
Dialogue: 0,0:05:20.91,0:05:23.47,Caption,,0,0,0,,ВОССТАНОВЛЕНИЯ НЕ БЕРЁТ КЛЮЧ И НЕ ВЫХОДИТ ПОД
Dialogue: 0,0:05:23.47,0:05:26.67,Caption,,0,0,0,,ВОЗДУШНУЮ ТРЕВОГУ. ЧИНОВНИЧЬЯ БУМАГА ВООБЩЕ ОЧЕНЬ
Dialogue: 0,0:05:26.75,0:05:29.71,Caption,,0,0,0,,ХРАБРАЯ. ОСОБЕННО ПОКА ЛЕЖИТ В ТЁПЛОЙ ПАПКЕ. В
Dialogue: 0,0:05:29.79,0:05:31.79,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ ГОДУ НА УКРАИНЕ
Dialogue: 0,0:05:31.79,0:05:34.35,Caption,,0,0,0,,ЗАРЕГИСТРИРОВАЛИ ПРИМЕРНО ДВЕСТИ СЕМЬДЕСЯТ ЧЕТЫРЕ
Dialogue: 0,0:05:34.43,0:05:37.31,Caption,,0,0,0,,ТЫСЯЧИ РОЖДЕНИЙ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ ГОДУ
Dialogue: 0,0:05:37.39,0:05:40.11,Caption,,0,0,0,,ИХ БЫЛО УЖЕ ОКОЛО СТА ШЕСТИДЕСЯТИ ДЕВЯТИ ТЫСЯЧ.
Dialogue: 0,0:05:40.55,0:05:43.23,Caption,,0,0,0,,ПАДЕНИЕ СОСТАВИЛО ТРИДЦАТЬ ВОСЕМЬ ЦЕЛЫХ ЧЕТЫРЕ
Dialogue: 0,0:05:43.23,0:05:46.43,Caption,,0,0,0,,ДЕСЯТЫХ ПРОЦЕНТА. РАЗНИЦА МЕЖДУ ЭТИМИ ГОДАМИ РАВНА
Dialogue: 0,0:05:46.43,0:05:50.11,Caption,,0,0,0,,ПРИМЕРНО СТА ПЯТИ ТЫСЯЧАМ ДЕТЕЙ. ВСЛУШАЙТЕСЬ СТО
Dialogue: 0,0:05:50.19,0:05:54.99,Caption,,0,0,0,,ПЯТЬ ТЫСЯЧ. НЕ УЕХАВШИХ, КОТОРЫХ МОЖНО УГОВОРИТЬ ВЕРНУТЬСЯ. НЕ ВРЕМЕННО
Dialogue: 0,0:05:55.07,0:05:57.47,Caption,,0,0,0,,ПОТЕРЯННЫХ ДЛЯ СТАТИСТИКИ. НЕ ЛЮДЕЙ,
Dialogue: 0,0:05:57.71,0:06:00.91,Caption,,0,0,0,,ОЖИДАЮЩИХ ПОДХОДЯЩЕГО РЕЙСА ДОМОЙ. ЭТИ ДЕТИ ПРОСТО
Dialogue: 0,0:06:00.99,0:06:03.71,Caption,,0,0,0,,НЕ РОДИЛИСЬ. СЕГОДНЯ ЭТО ВЫГЛЯДИТ КАК СТРОЧКА В
Dialogue: 0,0:06:03.71,0:06:06.91,Caption,,0,0,0,,ОТЧЁТЕ. ЧЕРЕЗ СЕМЬ ЛЕТ ЭТО БУДУТ ПУСТУЮЩИЕ МЕСТА
Dialogue: 0,0:06:06.99,0:06:09.71,Caption,,0,0,0,,В ШКОЛАХ. ЧЕРЕЗ ПЯТНАДЦАТЬ ЛЕТ НЕ ПОЯВЯТСЯ
Dialogue: 0,0:06:09.71,0:06:13.23,Caption,,0,0,0,,ПОДРОСТКИ, КОТОРЫМ ПРЕДСТОЯЛО БЫ ВЫБИРАТЬ ПРОФЕССИЮ. ЧЕРЕЗ
Dialogue: 0,0:06:13.31,0:06:16.11,Caption,,0,0,0,,ДВАДЦАТЬ ЛЕТ СТРАНА НЕ ПОЛУЧИТ ВЗРОСЛЫХ РАБОТНИКОВ,
Dialogue: 0,0:06:16.27,0:06:20.35,Caption,,0,0,0,,РОДИТЕЛЕЙ, НАЛОГОПЛАТЕЛЬЩИКОВ И СПЕЦИАЛИСТОВ. А ВЗРОСЛОГО
Dialogue: 0,0:06:20.35,0:06:22.35,Caption,,0,0,0,,ЧЕЛОВЕКА НЕЛЬЗЯ ОФОРМИТЬ ПО НАКЛАДНОЙ.
Dialogue: 0,0:06:24.62,0:06:27.10,Caption,,0,0,0,,ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ НЕ ПРИЕДЕТ ГРУЗОВИК С ТАБЛИЧКОЙ
Dialogue: 0,0:06:27.10,0:06:31.74,Caption,,0,0,0,,"НЕДОСТАЮЩИЕ ГРАЖДАНЕ, СТО ПЯТЬ ТЫСЯЧ ШТУК". ХОТЯ ПРИ НЫНЕШНЕЙ ЛЮБВИ
Dialogue: 0,0:06:31.82,0:06:34.38,Caption,,0,0,0,,К ЛОГИСТИЧЕСКИМ РЕШЕНИЯМ КТО НИБУДЬ НАВЕРНЯКА УЖЕ
Dialogue: 0,0:06:34.38,0:06:39.18,Caption,,0,0,0,,ИЩЕТ НОМЕР ПОСТАВЩИКА. ДЕМОГРАФИЧЕСКИЙ ПРОВАЛ ПРОИСХОДИТ НЕ САМ ПО СЕБЕ.
Dialogue: 0,0:06:39.55,0:06:42.30,Caption,,0,0,0,,МИЛЛИОНЫ УКРАИНЦЕВ НАХОДЯТСЯ ЗА ПРЕДЕЛАМИ СТРАНЫ,
Dialogue: 0,0:06:42.55,0:06:45.34,Caption,,0,0,0,,ПРЕЖДЕ ВСЕГО ЖЕНЩИНЫ И ДЕТИ. ЧЕМ ДОЛЬШЕ ДЛИТСЯ
Dialogue: 0,0:06:45.42,0:06:49.34,Caption,,0,0,0,,ИХ ЖИЗНЬ ЗА ГРАНИЦЕЙ, ТЕМ СЛАБЕЕ РАБОТАЕТ ПРОСТАЯ ФРАЗА ПОТОМ ОНИ
Dialogue: 0,0:06:49.34,0:06:52.38,Caption,,0,0,0,,ВЕРНУТСЯ. СНАЧАЛА ОТЪЕЗД КАЖЕТСЯ КОРОТКОЙ ПАУЗОЙ.
Dialogue: 0,0:06:52.78,0:06:55.82,Caption,,0,0,0,,ПОТОМ РЕБЁНОК ИДЁТ В МЕСТНУЮ ШКОЛУ. РОДИТЕЛИ НАХОДЯТ
Dialogue: 0,0:06:55.82,0:06:58.94,Caption,,0,0,0,,РАБОТУ. СЕМЬЯ УЧИТ ЯЗЫК, ЗАВОДИТ ЗНАКОМЫХ,
Dialogue: 0,0:06:59.10,0:07:01.26,Caption,,0,0,0,,ОБЖИВАЕТ КВАРТИРУ, СТРОИТ ПЛАНЫ.
Dialogue: 0,0:07:01.81,0:07:04.30,Caption,,0,0,0,,ПОСТЕПЕННО ВРЕМЕННОЕ МЕСТО СТАНОВИТСЯ ОБЫЧНОЙ
Dialogue: 0,0:07:04.38,0:07:07.18,Caption,,0,0,0,,ЖИЗНЬЮ. ВОЗВРАЩЕНИЕ ПОСЛЕ ЭТОГО ОЗНАЧАЕТ УЖЕ НЕ
Dialogue: 0,0:07:07.26,0:07:09.98,Caption,,0,0,0,,ПРОСТО КУПИТЬ БИЛЕТ ДОМОЙ. ОНО ОЗНАЧАЕТ СНОВА
Dialogue: 0,0:07:09.98,0:07:13.18,Caption,,0,0,0,,СОРВАТЬ РЕБЁНКА СО ШКОЛЫ, ОТКАЗАТЬСЯ ОТ РАБОТЫ,
Dialogue: 0,0:07:13.34,0:07:15.66,Caption,,0,0,0,,ПОКИНУТЬ ПРИВЫЧНЫЙ БЫТ И ЕЩЁ РАЗ НАЧАТЬ С
Dialogue: 0,0:07:15.66,0:07:19.34,Caption,,0,0,0,,ПУСТОГО МЕСТА. ЧЕЛОВЕК НЕ ЧЕМОДАН. ЕГО НЕЛЬЗЯ ГОДАМИ
Dialogue: 0,0:07:19.34,0:07:23.02,Caption,,0,0,0,,ХРАНИТЬ В ДРУГОЙ СТРАНЕ, А ПОТОМ СНЯТЬ С ПОЛКИ И ПОСТАВИТЬ ОБРАТНО,
Dialogue: 0,0:07:23.22,0:07:24.78,Caption,,0,0,0,,КОГДА ГОСУДАРСТВУ СТАЛО УДОБНО.
Dialogue: 0,0:07:25.34,0:07:28.06,Caption,,0,0,0,,ПОКА ПОЛИТИКИ РАССЧИТЫВАЮТ БУДУЩИЕ КОАЛИЦИИ,
Dialogue: 0,0:07:28.21,0:07:30.94,Caption,,0,0,0,,ДЕТИ РАСТУТ. ПОКА ЖДУТ НОВОГО ПАКЕТА,
Dialogue: 0,0:07:31.11,0:07:34.46,Caption,,0,0,0,,СЕМЬИ УКОРЕНЯЮТСЯ. ПОКА ОБСУЖДАЮТ СЛЕДУЮЩИЙ БЮДЖЕТ,
Dialogue: 0,0:07:34.62,0:07:37.58,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ СТАНОВИТСЯ ВСЁ МЕНЕЕ ПРИВЛЕКАТЕЛЬНЫМ.
Dialogue: 0,0:07:39.85,0:07:42.25,Caption,,0,0,0,,КАЛЕНДАРЬ РАБОТАЕТ БЕЗ ВЫХОДНЫХ И НИ У КОГО
Dialogue: 0,0:07:42.33,0:07:44.73,Caption,,0,0,0,,НЕ СПРАШИВАЕТ РАЗРЕШЕНИЯ. И ЧТО ЖЕ ОТВЕЧАЕТ
Dialogue: 0,0:07:44.73,0:07:46.41,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ СИСТЕМА НА ВСЁ ЭТО?
Dialogue: 0,0:07:46.82,0:07:49.37,Caption,,0,0,0,,ПРОДОЛЖАТЬ. ПОВРЕЖДЕНА ИНФРАСТРУКТУРА,
Dialogue: 0,0:07:49.58,0:07:51.85,Caption,,0,0,0,,ВОССТАНОВИМ. НЕ ХВАТАЕТ ГЕНЕРАТОРОВ,
Dialogue: 0,0:07:52.06,0:07:56.09,Caption,,0,0,0,,КУПИМ. УЕХАЛИ ЛЮДИ, КОГО НИБУДЬ ВЕРНЁМ. МАЛО ЛЮДЕЙ,
Dialogue: 0,0:07:56.19,0:07:59.29,Caption,,0,0,0,,КОГО НИБУДЬ НАЙДЁМ. ДЛЯ КАЖДОЙ ПРОБОИНЫ ПРЕДЛАГАЕТСЯ
Dialogue: 0,0:07:59.29,0:08:01.69,Caption,,0,0,0,,НОВАЯ ЗАПЛАТКА, НО НИКТО НЕ СПРАШИВАЕТ,
Dialogue: 0,0:08:01.85,0:08:04.09,Caption,,0,0,0,,ПОЧЕМУ КОРПУС ПРОДОЛЖАЮТ ВЕСТИ ТУДА,
Dialogue: 0,0:08:04.33,0:08:06.65,Caption,,0,0,0,,ГДЕ ЕГО СНОВА ПРОБЬЮТ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:08:06.89,0:08:09.53,Caption,,0,0,0,,ЕСЛИ ЦЕНИТЕ ТАКИЕ РАЗБОРЫ БЕЗ ЦЕРЕМОНИАЛЬНЫХ
Dialogue: 0,0:08:09.53,0:08:12.49,Caption,,0,0,0,,РЕВЕРАНСОВ. ОТДЕЛЬНО КАЖДАЯ ПРОБЛЕМА ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:08:12.57,0:08:15.77,Caption,,0,0,0,,КАЖЕТСЯ РЕШАЕМОЙ. ГЕРМАНИЯ НЕ ДАЛА НОВЫЙ ПЭТРИОТ,
Dialogue: 0,0:08:16.01,0:08:18.41,Caption,,0,0,0,,МОЖНО ПРОСИТЬ ДРУГУЮ СТРАНУ. ВЫКЛЮЧИЛИ
Dialogue: 0,0:08:18.41,0:08:22.09,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО, МОЖНО ПОСТАВИТЬ ГЕНЕРАТОР. ПОВРЕДИЛИ МОСТ,
Dialogue: 0,0:08:22.25,0:08:24.73,Caption,,0,0,0,,МОЖНО НАЧАТЬ РЕМОНТ. УЕХАЛ СПЕЦИАЛИСТ,
Dialogue: 0,0:08:24.87,0:08:27.45,Caption,,0,0,0,,МОЖНО ИСКАТЬ ДРУГОГО. СНИЗИЛАСЬ РОЖДАЕМОСТЬ,
Dialogue: 0,0:08:27.69,0:08:30.25,Caption,,0,0,0,,МОЖНО ПРОИЗНЕСТИ РЕЧЬ О ПОДДЕРЖКЕ СЕМЕЙ И
Dialogue: 0,0:08:30.25,0:08:33.45,Caption,,0,0,0,,ТОРЖЕСТВЕННО РАЗОЙТИСЬ ДО СЛЕДУЮЩЕГО ОТЧЁТА. ТОЛЬКО
Dialogue: 0,0:08:33.45,0:08:35.45,Caption,,0,0,0,,ЖИЗНЬ НЕ ВЫДАЁТ ТРУДНОСТИ ПО ОДНОЙ,
Dialogue: 0,0:08:35.61,0:08:38.57,Caption,,0,0,0,,АККУРАТНО ЗАВЕРНУВ КАЖДУЮ В ОТДЕЛЬНЫЙ ПАКЕТ. ОНИ
Dialogue: 0,0:08:38.57,0:08:42.09,Caption,,0,0,0,,ПРИХОДЯТ ВМЕСТЕ. НЕХВАТКА ПВО СОВПАДАЕТ С УДАРАМИ ПО
Dialogue: 0,0:08:42.17,0:08:44.97,Caption,,0,0,0,,ЭНЕРГЕТИКЕ. ЭНЕРГЕТИЧЕСКИЕ ПРОБЛЕМЫ СОВПАДАЮТ С
Dialogue: 0,0:08:44.97,0:08:48.01,Caption,,0,0,0,,НАГРУЗКОЙ НА ГОРОДСКОЕ ХОЗЯЙСТВО. УГРОЗА МОСТАМ
Dialogue: 0,0:08:48.01,0:08:50.73,Caption,,0,0,0,,СОВПАДАЕТ С ПОТРЕБНОСТЬЮ ПОСТОЯННО РЕМОНТИРОВАТЬ
Dialogue: 0,0:08:50.73,0:08:53.77,Caption,,0,0,0,,ИНФРАСТРУКТУРУ. ЭМИГРАЦИЯ СОВПАДАЕТ С ПАДЕНИЕМ
Dialogue: 0,0:08:53.77,0:08:59.42,Caption,,0,0,0,,РОЖДАЕМОСТИ. А ВСЁ ЭТО СОВПАДАЕТ С ПРОДОЛЖЕНИЕМ КОНФЛИКТА,
Dialogue: 0,0:08:59.62,0:09:01.66,Caption,,0,0,0,,КОТОРЫЙ ТРЕБУЕТ ЕЩЁ БОЛЬШЕ ДЕНЕГ,
Dialogue: 0,0:09:01.81,0:09:05.02,Caption,,0,0,0,,ТЕХНИКИ И ЛЮДЕЙ. ЭТО НЕ СЕМЬ РАЗНЫХ ИСТОРИЙ.
Dialogue: 0,0:09:05.18,0:09:09.66,Caption,,0,0,0,,ЭТО ОДНА СИСТЕМА, КОТОРАЯ С КАЖДЫМ КРУГОМ ТРЕБУЕТ ВСЁ БОЛЬШЕ РЕСУРСОВ
Dialogue: 0,0:09:09.66,0:09:12.86,Caption,,0,0,0,,ТОЛЬКО РАДИ СОХРАНЕНИЯ ПРЕЖНЕГО ДВИЖЕНИЯ. САМОЕ
Dialogue: 0,0:09:12.94,0:09:16.14,Caption,,0,0,0,,УДОБНОЕ ДЛЯ НЕЁ СЛОВО ЗВУЧИТ ТАК "ЕЩЁ". ЕЩЁ
Dialogue: 0,0:09:16.14,0:09:19.74,Caption,,0,0,0,,ОДИН ПАКЕТ. ЕЩЁ НЕСКОЛЬКО РАКЕТ. ЕЩЁ НЕМНОГО ДЕНЕГ.
Dialogue: 0,0:09:20.04,0:09:23.82,Caption,,0,0,0,,ЕЩЁ ГОД ПОТЕРПЕТЬ. ЕЩЁ ЛЮДЕЙ НАЙТИ. ЕЩЁ СПЕЦИАЛИСТОВ
Dialogue: 0,0:09:23.82,0:09:27.18,Caption,,0,0,0,,ПРИВЛЕЧЬ. ЕЩЁ КОГО ТО МОБИЛИЗОВАТЬ. ЕЩЁ ОДИН МОСТ
Dialogue: 0,0:09:27.18,0:09:30.70,Caption,,0,0,0,,ПОЧИНИТЬ. ЕЩЁ ОДНУ ЗИМУ ПЕРЕЖИТЬ. У СЛОВА "ЕЩЁ"
Dialogue: 0,0:09:30.78,0:09:33.18,Caption,,0,0,0,,ПРЕКРАСНОЕ СВОЙСТВО. ОНО НЕ СООБЩАЕТ,
Dialogue: 0,0:09:33.33,0:09:36.30,Caption,,0,0,0,,СКОЛЬКО ОСТАЛОСЬ. ОНО ПРОСТО ОТОДВИГАЕТ НЕПРИЯТНЫЙ
Dialogue: 0,0:09:36.30,0:09:39.26,Caption,,0,0,0,,РАЗГОВОР НА СЛЕДУЮЩИЙ РАЗ. А ПРЕДЕЛ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:09:39.34,0:09:42.54,Caption,,0,0,0,,НИКУДА НЕ ИСЧЕЗАЕТ. У ЛЮБОЙ СИСТЕМЫ ИМЕЕТСЯ ДНО.
Dialogue: 0,0:09:42.90,0:09:45.74,Caption,,0,0,0,,У СКЛАДА, БЮДЖЕТА, ЭНЕРГОСЕТИ,
Dialogue: 0,0:09:45.85,0:09:49.90,Caption,,0,0,0,,АРМИИ, ДЕМОГРАФИИ И ЧЕЛОВЕЧЕСКОГО ТЕРПЕНИЯ. МОЖНО ДЕЛАТЬ
Dialogue: 0,0:09:49.98,0:09:53.26,Caption,,0,0,0,,ВИД, ЧТО ОЧЕРЕДНАЯ ПОСТАВКА ОТМЕНЯЕТ ЭТОТ ЗАКОН. НЕ
Dialogue: 0,0:09:53.26,0:09:56.38,Caption,,0,0,0,,ОТМЕНЯЕТ. ОНА ЛИШЬ ПОЗВОЛЯЕТ ЧУТЬ ПОЗЖЕ УСЛЫШАТЬ
Dialogue: 0,0:09:56.46,0:09:59.98,Caption,,0,0,0,,ГЛУХОЙ СТУК СОВКА О ПУСТОЙ ПОЛ. ОСОБЕННО СТРАШНО,
Dialogue: 0,0:10:00.32,0:10:03.34,Caption,,0,0,0,,КОГДА САМЫМ ДОСТУПНЫМ РАСХОДНЫМ МАТЕРИАЛОМ НАЧИНАЮТ
Dialogue: 0,0:10:03.34,0:10:07.90,Caption,,0,0,0,,СЧИТАТЬ ЧЕЛОВЕКА. РАКЕТА ИМЕЕТ ЦЕНУ. КОМПЛЕКС ПВО ПРОХОДИТ ПО
Dialogue: 0,0:10:07.90,0:10:11.42,Caption,,0,0,0,,КОНТРАКТУ. РЕМОНТ МОСТА ПОПАДАЕТ В СМЕТУ. ГЕНЕРАТОР
Dialogue: 0,0:10:11.42,0:10:14.22,Caption,,0,0,0,,УЧИТЫВАЕТСЯ В ЗАКУПКЕ. ЧЕЛОВЕЧЕСКАЯ ЖИЗНЬ В ТАКОЙ
Dialogue: 0,0:10:14.22,0:10:15.98,Caption,,0,0,0,,АРИФМЕТИКЕ РАСТВОРЯЕТСЯ УДОБНЕЕ.
Dialogue: 0,0:10:18.25,0:10:22.82,Caption,,0,0,0,,ПОКА ЛЮДИ ЕЩЁ ЕСТЬ, ЧИНОВНИК СТАВИТ ГАЛОЧКУ РЕСУРС ИМЕЕТСЯ. СКОЛЬКО ОНИ
Dialogue: 0,0:10:22.82,0:10:25.46,Caption,,0,0,0,,УЖЕ ВЫНЕСЛИ, СКОЛЬКО СЕМЕЙ УЕХАЛО,
Dialogue: 0,0:10:25.62,0:10:29.78,Caption,,0,0,0,,СКОЛЬКО ДЕТЕЙ НЕ РОДИЛОСЬ, ВСЁ ЭТО МОЖНО ВЫНЕСТИ В СОСЕДНЮЮ ТАБЛИЦУ И
Dialogue: 0,0:10:29.78,0:10:32.82,Caption,,0,0,0,,НЕ ПОРТИТЬ ОСНОВНОЙ ДОКЛАД. ЗАКОНЧИЛИСЬ ДЕНЬГИ,
Dialogue: 0,0:10:32.90,0:10:35.14,Caption,,0,0,0,,ПОПРОСИМ ДЕНЬГИ. ЗАКОНЧИЛИСЬ РАКЕТЫ,
Dialogue: 0,0:10:35.32,0:10:37.62,Caption,,0,0,0,,ПОПРОСИМ РАКЕТЫ. ЗАКОНЧИЛИСЬ ЛЮДИ,
Dialogue: 0,0:10:37.74,0:10:40.02,Caption,,0,0,0,,ПОПРОСИТЬ УЖЕ НЕ У КОГО. ВОТ ЗДЕСЬ И
Dialogue: 0,0:10:40.10,0:10:42.74,Caption,,0,0,0,,ДОЛЖНА БЫЛА БЫ МЕНЯТЬСЯ СТРАТЕГИЯ. НО ВМЕСТО
Dialogue: 0,0:10:42.74,0:10:45.86,Caption,,0,0,0,,РАЗГОВОРА О ПРЕДЕЛЕ СНОВА ИДЁТ ПОИСК НОВОЙ ПОЛКИ,
Dialogue: 0,0:10:46.09,0:10:49.54,Caption,,0,0,0,,НОВОГО БЮДЖЕТА И НОВОГО ПОКРОВИТЕЛЯ. ЧЕМ ВЫШЕ
Dialogue: 0,0:10:49.54,0:10:54.02,Caption,,0,0,0,,СТАНОВИТСЯ ЦЕНА ПРОДОЛЖЕНИЯ, ТЕМ СТРАННЕЕ ВЕДЁТ СЕБЯ ПОЛИТИЧЕСКАЯ ЛОГИКА.
Dialogue: 0,0:10:54.33,0:10:57.54,Caption,,0,0,0,,КАЗАЛОСЬ БЫ, ТЯЖЁЛЫЕ ПОТЕРИ ДОЛЖНЫ ЗАСТАВЛЯТЬ ПЕРЕСМОТРЕТЬ
Dialogue: 0,0:10:57.62,0:11:00.42,Caption,,0,0,0,,ДОРОГУ. НА ДЕЛЕ ОНИ ПРЕВРАЩАЮТСЯ В ДОВОД,
Dialogue: 0,0:11:00.58,0:11:03.46,Caption,,0,0,0,,ПОЧЕМУ СВОРАЧИВАТЬ УЖЕ ПОЗДНО. СЛИШКОМ МНОГО
Dialogue: 0,0:11:03.46,0:11:07.38,Caption,,0,0,0,,ВЛОЖИЛИ. СЛИШКОМ МНОГО ПОТЕРЯЛИ. СЛИШКОМ ДОЛГО ШЛИ.
Dialogue: 0,0:11:07.67,0:11:10.42,Caption,,0,0,0,,ТЕПЕРЬ НАДО ИДТИ ДАЛЬШЕ, ИНАЧЕ ВСЁ БЫЛО НАПРАСНО.
Dialogue: 0,0:11:11.08,0:11:14.74,Caption,,0,0,0,,ЭТО ЗНАКОМАЯ БЫТОВАЯ ЛОВУШКА. ЧЕЛОВЕК ЗАТЕЯЛ РЕМОНТ,
Dialogue: 0,0:11:14.82,0:11:17.62,Caption,,0,0,0,,СНЁС СТЕНУ, ЗАЛЕЗ В ДОЛГИ И ОБНАРУЖИЛ,
Dialogue: 0,0:11:17.86,0:11:20.42,Caption,,0,0,0,,ЧТО КВАРТИРА МЕДЛЕННО ПРЕВРАЩАЕТСЯ В БЕТОННУЮ
Dialogue: 0,0:11:20.42,0:11:25.54,Caption,,0,0,0,,ПЕЩЕРУ. НОРМАЛЬНЫЙ ВЫХОД, ОСТАНОВИТЬСЯ И ПЕРЕСЧИТАТЬ ВОЗМОЖНОСТИ. НО ОН БЕРЁТ
Dialogue: 0,0:11:25.54,0:11:29.22,Caption,,0,0,0,,НОВЫЙ КРЕДИТ, ПОТОМУ ЧТО ПРЕЖНИЙ УЖЕ ПОТРАЧЕН. ПОТОМ ЕЩЁ ОДИН.
Dialogue: 0,0:11:29.38,0:11:32.18,Caption,,0,0,0,,В ИТОГЕ У НЕГО НЕТ СТЕНЫ, ДЕНЕГ И СНА,
Dialogue: 0,0:11:32.63,0:11:36.34,Caption,,0,0,0,,ЗАТО ЕСТЬ ТВЁРДАЯ ВЕРА, ЧТО БРОСАТЬ СЕЙЧАС ТОЧНО НЕЛЬЗЯ.
Dialogue: 0,0:11:38.61,0:11:43.33,Caption,,0,0,0,,ГОСУДАРСТВО НЕ КВАРТИРА, А ВОЙНА НЕ РЕМОНТ. ЦЕНА ТАКОЙ ЛОГИКИ ИЗМЕРЯЕТСЯ
Dialogue: 0,0:11:43.41,0:11:46.21,Caption,,0,0,0,,НЕ РУЛОНАМИ ОБОЕВ. ОНА ИЗМЕРЯЕТСЯ ЛЮДЬМИ,
Dialogue: 0,0:11:46.36,0:11:49.33,Caption,,0,0,0,,ГОРОДАМИ, ЭНЕРГЕТИКОЙ, ЭКОНОМИКОЙ,
Dialogue: 0,0:11:49.48,0:11:51.89,Caption,,0,0,0,,ТЕРРИТОРИЯМИ И БУДУЩИМИ ПОКОЛЕНИЯМИ.
Dialogue: 0,0:11:52.44,0:11:55.17,Caption,,0,0,0,,БЮРОКРАТИИ ЭТА СХЕМА ОСОБЕННО УДОБНА. ЛЮБОЕ
Dialogue: 0,0:11:55.17,0:11:57.33,Caption,,0,0,0,,УХУДШЕНИЕ ПРЕВРАЩАЕТСЯ В ДОКАЗАТЕЛЬСТВО
Dialogue: 0,0:11:57.33,0:11:59.89,Caption,,0,0,0,,НЕОБХОДИМОСТИ ПРОДОЛЖАТЬ. СТАЛО ТЯЖЕЛЕЕ,
Dialogue: 0,0:12:00.19,0:12:02.77,Caption,,0,0,0,,ЗНАЧИТ НУЖНО СОБРАТЬСЯ. РЕСУРСОВ МЕНЬШЕ,
Dialogue: 0,0:12:02.93,0:12:05.97,Caption,,0,0,0,,ЗНАЧИТ НАДО ПРИЛОЖИТЬ БОЛЬШЕ УСИЛИЙ. ЦЕНА ВЫРОСЛА,
Dialogue: 0,0:12:06.18,0:12:08.85,Caption,,0,0,0,,ЗНАЧИТ ОТСТУПИТЬ ТЕПЕРЬ ОСОБЕННО НЕЛЬЗЯ. ПОТЕРИ
Dialogue: 0,0:12:08.85,0:12:11.33,Caption,,0,0,0,,НАКОПИЛИСЬ, ЗНАЧИТ НАДО ДОБАВИТЬ НОВЫЕ,
Dialogue: 0,0:12:11.49,0:12:13.89,Caption,,0,0,0,,ЧТОБЫ ПРЕДЫДУЩИЕ ОДНАЖДЫ ПОЛУЧИЛИ КРАСИВОЕ
Dialogue: 0,0:12:13.89,0:12:17.33,Caption,,0,0,0,,ОБЪЯСНЕНИЕ. ТАК МЕХАНИЗМ НАЧИНАЕТ КОРМИТЬ САМ СЕБЯ.
Dialogue: 0,0:12:17.62,0:12:20.53,Caption,,0,0,0,,ПРОБЛЕМА, КОТОРАЯ ДОЛЖНА ЗАСТАВИТЬ ЕГО ОСТАНОВИТЬСЯ,
Dialogue: 0,0:12:20.77,0:12:23.97,Caption,,0,0,0,,ОБЪЯВЛЯЕТСЯ ПРИЧИНОЙ НАЖАТЬ СИЛЬНЕЕ. ИМЕННО ПОЭТОМУ
Dialogue: 0,0:12:23.97,0:12:27.09,Caption,,0,0,0,,КОНТАКТЫ С БУДУЩИМИ АМЕРИКАНСКИМИ ДЕМОКРАТАМИ ВАЖНЫ
Dialogue: 0,0:12:27.17,0:12:30.13,Caption,,0,0,0,,НЕ КАК ОБЫЧНАЯ ДИПЛОМАТИЧЕСКАЯ СУЕТА. ВСТРЕЧИ
Dialogue: 0,0:12:30.13,0:12:32.77,Caption,,0,0,0,,ПОЛИТИКОВ САМИ ПО СЕБЕ НИКОГО НЕ УДИВЛЯЮТ. ОНИ
Dialogue: 0,0:12:32.85,0:12:35.49,Caption,,0,0,0,,ДЛЯ ТОГО И НОСЯТ КОСТЮМЫ, ЧТОБЫ ВСТРЕЧАТЬСЯ,
Dialogue: 0,0:12:35.58,0:12:40.53,Caption,,0,0,0,,УЛЫБАТЬСЯ И СООБЩАТЬ, ЧТО БЕСЕДА БЫЛА СОДЕРЖАТЕЛЬНОЙ. СМЫСЛ ПОЯВЛЯЕТСЯ,
Dialogue: 0,0:12:40.80,0:12:43.09,Caption,,0,0,0,,КОГДА ЭТУ СТАВКУ СТАВИШЬ РЯДОМ С ОСТАЛЬНЫМИ
Dialogue: 0,0:12:43.09,0:12:46.53,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВАМИ. И НА ЭТОМ ФОНЕ КИЕВ ИЩЕТ СЛЕДУЮЩИЙ
Dialogue: 0,0:12:46.53,0:12:49.65,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ЦИКЛ В СОЕДИНЁННЫХ ШТАТАХ. НЕ РЕШЕНИЕ
Dialogue: 0,0:12:49.73,0:12:53.41,Caption,,0,0,0,,ПРЕДЕЛА, А ВОЗМОЖНОСТЬ ЕЩЁ РАЗ ПРОДЛИТЬ РЕСУРСНУЮ ЛИНИЮ.
Dialogue: 0,0:12:53.73,0:12:56.05,Caption,,0,0,0,,СЛЕДУЮЩИЙ КОНГРЕСС. СЛЕДУЮЩИЙ ПАКЕТ.
Dialogue: 0,0:12:58.33,0:13:01.85,Caption,,0,0,0,,СЛЕДУЮЩИЙ БЮДЖЕТ. СЛЕДУЮЩАЯ ПОСТАВКА. СЛЕДУЮЩАЯ
Dialogue: 0,0:13:01.85,0:13:05.53,Caption,,0,0,0,,НАДЕЖДА. ВСЁ ПРЕКРАСНОЕ НАХОДИТСЯ В СЛЕДУЮЩЕМ ВАГОНЕ.
Dialogue: 0,0:13:05.99,0:13:09.05,Caption,,0,0,0,,ОСТАЛОСЬ ТОЛЬКО НЕПОНЯТНО, НА ЧЁМ ДО НЕГО ЕХАТЬ,
Dialogue: 0,0:13:09.21,0:13:11.61,Caption,,0,0,0,,ЕСЛИ НЫНЕШНИЙ УЖЕ СКРИПИТ ВСЕМИ КОЛЁСАМИ.
Dialogue: 0,0:13:12.51,0:13:15.85,Caption,,0,0,0,,У ПОЛИТИКОВ И ДЕМОГРАФИИ РАЗНЫЕ ЧАСЫ. ПОЛИТИК
Dialogue: 0,0:13:15.93,0:13:19.05,Caption,,0,0,0,,ДУМАЕТ, КАК ПРОТЯНУТЬ ДО НОВОГО РЕШЕНИЯ ЧЕРЕЗ ГОД.
Dialogue: 0,0:13:19.45,0:13:22.33,Caption,,0,0,0,,ДЕМОГРАФИЯ ЗА ЭТОТ ГОД ОТВЕЧАЕТ УМЕНЬШЕНИЕМ ЧИСЛА
Dialogue: 0,0:13:22.33,0:13:25.13,Caption,,0,0,0,,РОЖДЕНИЙ. ПОЛИТИК ЖДЁТ ПЕРЕМЕНЫ НАСТРОЕНИЙ В
Dialogue: 0,0:13:25.13,0:13:28.57,Caption,,0,0,0,,ВАШИНГТОНЕ. ЗА ЭТО ВРЕМЯ ЕЩЁ ОДНА СЕМЬЯ УСТРАИВАЕТСЯ
Dialogue: 0,0:13:28.65,0:13:32.01,Caption,,0,0,0,,ЗА ГРАНИЦЕЙ И ПЕРЕСТАЁТ ВОСПРИНИМАТЬ ВОЗВРАЩЕНИЕ КАК
Dialogue: 0,0:13:32.01,0:13:34.81,Caption,,0,0,0,,ОЧЕВИДНЫЙ ВЫБОР. ПОЛИТИК ОБЕЩАЕТ ВОССТАНОВИТЬ
Dialogue: 0,0:13:34.81,0:13:37.85,Caption,,0,0,0,,ИНФРАСТРУКТУРУ. ИНФРАСТРУКТУРА ПРОСИТ МАТЕРИАЛЫ,
Dialogue: 0,0:13:38.01,0:13:43.05,Caption,,0,0,0,,ДЕНЬГИ, ВРЕМЯ И ЛЮДЕЙ, КОТОРЫХ НАДО ОТКУДА ТО ВЗЯТЬ. ПОЛИТИК ГОВОРИТ,
Dialogue: 0,0:13:43.29,0:13:46.33,Caption,,0,0,0,,ЧТО НЕОБХОДИМО ВЫДЕРЖАТЬ. А СТРАНА ПЛАТИТ ЗА КАЖДЫЙ
Dialogue: 0,0:13:46.41,0:13:49.61,Caption,,0,0,0,,МЕСЯЦ ОЖИДАНИЯ НЕ ТОЛЬКО СЕГОДНЯШНИМИ РАЗРУШЕНИЯМИ.
Dialogue: 0,0:13:50.01,0:13:54.49,Caption,,0,0,0,,ОНА РАСПЛАЧИВАЕТСЯ ТЕМ, ЧЕГО НЕ БУДЕТ СПУСТЯ ДЕСЯТИЛЕТИЯ. ПОЭТОМУ ПАДЕНИЕ
Dialogue: 0,0:13:54.49,0:13:57.21,Caption,,0,0,0,,РОЖДАЕМОСТИ НА ТРИДЦАТЬ ВОСЕМЬ ЦЕЛЫХ ЧЕТЫРЕ ДЕСЯТЫХ
Dialogue: 0,0:13:57.21,0:13:59.93,Caption,,0,0,0,,ПРОЦЕНТА ЗВУЧИТ ТИШЕ РАКЕТНОГО УДАРА,
Dialogue: 0,0:14:00.09,0:14:02.89,Caption,,0,0,0,,НО БЬЁТ ДАЛЬШЕ. ПОГАСШИЙ РАЙОН ВИДЕН СРАЗУ.
Dialogue: 0,0:14:03.13,0:14:06.41,Caption,,0,0,0,,ОТСУТСТВИЕ ВОДЫ ОЩУЩАЕТСЯ СРАЗУ. ПОВРЕЖДЁННЫЙ МОСТ
Dialogue: 0,0:14:06.41,0:14:09.29,Caption,,0,0,0,,ПОПАДАЕТ В НОВОСТИ СРАЗУ. НЕПЕРЕХВАЧЕННАЯ РАКЕТА
Dialogue: 0,0:14:09.29,0:14:12.33,Caption,,0,0,0,,ОСТАВЛЯЕТ ПОСЛЕДСТВИЯ СРАЗУ. А НЕРОЖДЁННЫЙ РЕБЁНОК
Dialogue: 0,0:14:12.41,0:14:14.25,Caption,,0,0,0,,НЕ ОСТАВЛЯЕТ ФОТОГРАФИИ РАЗРУШЕНИЙ.
Dialogue: 0,0:14:16.54,0:14:21.74,Caption,,0,0,0,,НЕТ КАДРА, НЕТ СИРЕНЫ, НЕТ СРОЧНОГО СОВЕЩАНИЯ. ЕСТЬ ЛИШЬ ПУСТОТА,
Dialogue: 0,0:14:22.06,0:14:24.46,Caption,,0,0,0,,КОТОРУЮ ГОСУДАРСТВО ЗАМЕТИТ ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ,
Dialogue: 0,0:14:24.70,0:14:27.50,Caption,,0,0,0,,КОГДА ЕМУ ПОНАДОБИТСЯ ВЗРОСЛЫЙ ЧЕЛОВЕК. ТОГДА
Dialogue: 0,0:14:27.50,0:14:29.58,Caption,,0,0,0,,ВЫЯСНИТСЯ, ЧТО НЕКОМУ РАБОТАТЬ,
Dialogue: 0,0:14:29.74,0:14:32.14,Caption,,0,0,0,,СТРОИТЬ, ОБСЛУЖИВАТЬ ИНФРАСТРУКТУРУ,
Dialogue: 0,0:14:32.23,0:14:35.58,Caption,,0,0,0,,СОЗДАВАТЬ СЕМЬИ И РАСТИТЬ СЛЕДУЮЩЕЕ ПОКОЛЕНИЕ. И
Dialogue: 0,0:14:35.58,0:14:39.02,Caption,,0,0,0,,НИКАКОЕ БОДРОЕ "ЕЩЁ НЕМНОГО ПРОТЯНЕМ" НЕ ЗАПОЛНИТ
Dialogue: 0,0:14:39.10,0:14:42.14,Caption,,0,0,0,,ЭТО МЕСТО. МОЖНО ЗАНЯТЬ ДЕНЬГИ. МОЖНО СМЕНИТЬ
Dialogue: 0,0:14:42.14,0:14:44.94,Caption,,0,0,0,,ПОСТАВЩИКА. МОЖНО НАЙТИ ПОЛИТИЧЕСКОГО СОЮЗНИКА.
Dialogue: 0,0:14:45.18,0:14:48.06,Caption,,0,0,0,,МОЖНО ЗАКЛЮЧИТЬ НОВЫЙ КОНТРАКТ. МОЖНО ВОССТАНОВИТЬ
Dialogue: 0,0:14:48.06,0:14:51.18,Caption,,0,0,0,,ЛИНИЮ И СНОВА ОТКРЫТЬ МОСТ. НО НЕЛЬЗЯ ВЕРНУТЬСЯ
Dialogue: 0,0:14:51.26,0:14:53.18,Caption,,0,0,0,,НА ДВАДЦАТЬ ЛЕТ НАЗАД И РОДИТЬ ТЕХ,
Dialogue: 0,0:14:53.48,0:14:55.82,Caption,,0,0,0,,КОГО ТОГДА НЕ РОДИЛИ. В ЭТОМ И ЗАКЛЮЧАЕТСЯ
Dialogue: 0,0:14:55.82,0:14:58.78,Caption,,0,0,0,,НАСТОЯЩИЙ СЧЁТ. ОН ПРИХОДИТ ПОЗЖЕ ОСТАЛЬНЫХ,
Dialogue: 0,0:14:59.03,0:15:01.66,Caption,,0,0,0,,ЗАТО СПОРИТЬ С НИМ УЖЕ БЕССМЫСЛЕННО. НАПИШИТЕ В
Dialogue: 0,0:15:01.66,0:15:04.14,Caption,,0,0,0,,КОММЕНТАРИЯХ, ЧТО, ПО ВАШЕМУ МНЕНИЮ,
Dialogue: 0,0:15:04.38,0:15:07.26,Caption,,0,0,0,,ВООБЩЕ СПОСОБНО ИЗМЕНИТЬ ТАКУЮ СТРАТЕГИЮ. ПОТОМУ ЧТО
Dialogue: 0,0:15:07.26,0:15:10.06,Caption,,0,0,0,,ПОКА КАРТИНА ВЫГЛЯДИТ ПРЕДЕЛЬНО ЯСНО ДЕМОГРАФИЯ
Dialogue: 0,0:15:10.06,0:15:13.82,Caption,,0,0,0,,ПАДАЕТ, ЛЮДИ УЕЗЖАЮТ, ИНФРАСТРУКТУРА ИЗНАШИВАЕТСЯ,
Dialogue: 0,0:15:13.98,0:15:18.70,Caption,,0,0,0,,СИСТЕМ ПВО НЕ ХВАТАЕТ, ЕВРОПЕЙСКИЕ ЗАПАСЫ УПИРАЮТСЯ В СОБСТВЕННЫЕ ГРАНИЦЫ,
Dialogue: 0,0:15:19.01,0:15:22.22,Caption,,0,0,0,,А ПОЛИТИЧЕСКИЙ ОТВЕТ ОСТАЁТСЯ ПРЕЖНИМ. НАЙТИ ЕЩЁ.
Dialogue: 0,0:15:22.61,0:15:26.22,Caption,,0,0,0,,ПОПРОСИТЬ ЕЩЁ. ПОДОЖДАТЬ ЕЩЁ. ПРОДОЛЖАТЬ ЕЩЁ.
Dialogue: 0,0:15:26.86,0:15:29.18,Caption,,0,0,0,,ЛЮДЕЙ В ЭТОЙ КОНСТРУКЦИИ ВСЁ ЗАМЕТНЕЕ СЧИТАЮТ
Dialogue: 0,0:15:29.26,0:15:34.43,Caption,,0,0,0,,ОБЫЧНЫМ РАСХОДНИКОМ. БУДТО ИХ ЗАПАС ЛЕЖИТ ГДЕ ТО В ГЛУБИНЕ
Dialogue: 0,0:15:34.43,0:15:38.67,Caption,,0,0,0,,СКЛАДА, ПРОСТО КЛАДОВЩИК ПОКА ПЛОХО ИСКАЛ. НО СКЛАДА НЕТ.
Dialogue: 0,0:15:39.14,0:15:42.43,Caption,,0,0,0,,И ЕСЛИ ДАЖЕ ИСЧЕЗАЮЩЕЕ БУДУЩЕЕ НЕ ЗАСТАВЛЯЕТ УБРАТЬ
Dialogue: 0,0:15:42.43,0:15:46.35,Caption,,0,0,0,,РУКУ С РЫЧАГА, ТО ЧТО ТОГДА ВООБЩЕ СПОСОБНО ОСТАНОВИТЬ ЭТУ МАШИНУ?
