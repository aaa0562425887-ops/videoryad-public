Dialogue: 0,0:00:00.12,0:00:02.04,Caption,,0,0,0,,У ЕВРОПЫ ДЛЯ УКРАИНЫ ЕСТЬ ТОВАР,
Dialogue: 0,0:00:02.12,0:00:04.66,Caption,,0,0,0,,КОТОРЫЙ НИКОГДА НЕ ЗАКАНЧИВАЕТСЯ. ЭТО
Dialogue: 0,0:00:04.66,0:00:07.28,Caption,,0,0,0,,ОБЕЩАНИЯ. ИХ МОЖНО ВЫДАВАТЬ ВАГОНАМИ И ВРУЧАТЬ
Dialogue: 0,0:00:07.28,0:00:10.64,Caption,,0,0,0,,КИЕВУ ХОТЬ КАЖДУЮ НЕДЕЛЮ. С ЛЮДЬМИ СЛОЖНЕЕ. ИХ НЕЛЬЗЯ
Dialogue: 0,0:00:10.64,0:00:14.25,Caption,,0,0,0,,НАПЕЧАТАТЬ В БРЮССЕЛЕ, ЗАНЯТЬ У МЕЖДУНАРОДНОГО ВАЛЮТНОГО
Dialogue: 0,0:00:14.25,0:00:17.50,Caption,,0,0,0,,ФОНДА ИЛИ ВЫНУТЬ ИЗ ПАКЕТА ПОМОЩИ. А ИМЕННО ЛЮДИ НА
Dialogue: 0,0:00:17.50,0:00:19.80,Caption,,0,0,0,,УКРАИНЕ ЗАКАНЧИВАЮТСЯ БЫСТРЕЕ ВСЕГО.
Dialogue: 0,0:00:19.80,0:00:22.25,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ ПРИ ВСТРЕЧЕ С ЗЕЛЕНСКИМ
Dialogue: 0,0:00:22.25,0:00:26.40,Caption,,0,0,0,,ГОВОРЯТ О ПОДДЕРЖКЕ, ОБЩЕЙ СУДЬБЕ И БУДУЩЕМ ЧЛЕНСТВЕ. НО
Dialogue: 0,0:00:26.40,0:00:29.27,Caption,,0,0,0,,БЕЗ ЗЕЛЕНСКОГО РАЗГОВОР БЫСТРО ПЕРЕКЛЮЧАЕТСЯ НА
Dialogue: 0,0:00:29.27,0:00:31.48,Caption,,0,0,0,,СОБСТВЕННЫХ ФЕРМЕРОВ, ПЕРЕВОЗЧИКОВ,
Dialogue: 0,0:00:31.64,0:00:36.50,Caption,,0,0,0,,ВЫБОРЫ, ТАРИФЫ И ВОПРОС, КТО ОПЛАТИТ БАНКЕТ. ДЛЯ КИЕВА ОН КУДА
Dialogue: 0,0:00:36.50,0:00:38.87,Caption,,0,0,0,,ЧЕСТНЕЕ ПАРАДНЫХ РУКОПОЖАТИЙ. ЕСЛИ ВАМ
Dialogue: 0,0:00:38.87,0:00:41.40,Caption,,0,0,0,,ИНТЕРЕСЕН РАЗБОР БЕЗ ЦЕРЕМОНИАЛЬНЫХ ПОКЛОНОВ,
Dialogue: 0,0:00:41.56,0:00:43.64,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДАЛЬШЕ ЦИФРЫ БУДУТ
Dialogue: 0,0:00:43.64,0:00:47.02,Caption,,0,0,0,,НЕПРИЯТНЫМИ, ЗАТО РАЗГОВОРЧИВЫМИ. АНАЛИТИКИ BNE
Dialogue: 0,0:00:47.02,0:00:50.39,Caption,,0,0,0,,INTELLINEWS СЧИТАЮТ, ЧТО УКРАИНА МОЖЕТ СТОЛКНУТЬСЯ С
Dialogue: 0,0:00:50.39,0:00:52.93,Caption,,0,0,0,,КРИТИЧЕСКОЙ НЕХВАТКОЙ ЛЮДЕЙ УЖЕ К ДВЕ ТЫСЯЧИ
Dialogue: 0,0:00:52.93,0:00:56.30,Caption,,0,0,0,,ДВАДЦАТЬ ВОСЬМОМУ ГОДУ. В НАИБОЛЕЕ ТЯЖЁЛОМ СЦЕНАРИИ ОНИ
Dialogue: 0,0:00:56.30,0:01:00.76,Caption,,0,0,0,,СОПОСТАВИЛИ БОЕВЫЕ ПОТЕРИ, МОБИЛИЗАЦИЮ И ДЕЗЕРТИРСТВО. ПО ЭТИМ
Dialogue: 0,0:01:00.76,0:01:04.55,Caption,,0,0,0,,РАСЧЁТАМ, КАЖДЫЙ МЕСЯЦ УКРАИНА ТЕРЯЕТ УБИТЫМИ ОТ
Dialogue: 0,0:01:04.55,0:01:07.58,Caption,,0,0,0,,ТРЁХ ДО ДЕВЯТИ ТЫСЯЧ ЧЕЛОВЕК. ЕЩЁ ОТ ШЕСТИ С
Dialogue: 0,0:01:07.58,0:01:10.24,Caption,,0,0,0,,ПОЛОВИНОЙ ДО ПЯТНАДЦАТИ ТЫСЯЧ ВОЕННОСЛУЖАЩИХ
Dialogue: 0,0:01:10.24,0:01:13.39,Caption,,0,0,0,,САМОВОЛЬНО ОСТАВЛЯЮТ ЧАСТИ. ДАЖЕ НИЖНЯЯ ГРАНИЦА
Dialogue: 0,0:01:13.39,0:01:15.82,Caption,,0,0,0,,ОЗНАЧАЕТ ЕЖЕМЕСЯЧНУЮ ПОТЕРЮ НАСЕЛЕНИЯ
Dialogue: 0,0:01:15.82,0:01:21.11,Caption,,0,0,0,,НЕБОЛЬШОГО ГОРОДА. НО АРМЕЙСКАЯ СТАТИСТИКА ПОКАЗЫВАЕТ
Dialogue: 0,0:01:21.11,0:01:24.07,Caption,,0,0,0,,ЛИШЬ ЧАСТЬ ПРОБЛЕМЫ. ЛЮДИ ПРОДОЛЖАЮТ УЕЗЖАТЬ,
Dialogue: 0,0:01:24.40,0:01:26.47,Caption,,0,0,0,,ДЕМОГРАФИЧЕСКИЙ ПРОВАЛ УГЛУБЛЯЕТСЯ,
Dialogue: 0,0:01:26.71,0:01:29.19,Caption,,0,0,0,,А ЧИСЛО МУЖЧИН, КОТОРЫХ МОЖНО МОБИЛИЗОВАТЬ,
Dialogue: 0,0:01:29.35,0:01:32.83,Caption,,0,0,0,,СОКРАЩАЕТСЯ. ОДИН И ТОТ ЖЕ РЕСУРС РАСХОДУЕТСЯ
Dialogue: 0,0:01:32.83,0:01:35.53,Caption,,0,0,0,,ВОЙНОЙ, ЭМИГРАЦИЕЙ И ВОЗРАСТНОЙ СТРУКТУРОЙ
Dialogue: 0,0:01:35.53,0:01:38.57,Caption,,0,0,0,,НАСЕЛЕНИЯ. ДОСТУПНЫЙ МОБИЛИЗАЦИОННЫЙ РЕЗЕРВ
Dialogue: 0,0:01:38.57,0:01:42.04,Caption,,0,0,0,,УКРАИНЫ ОЦЕНИВАЮТ С ОГРОМНЫМ РАЗБРОСОМ ОТ ОДНОГО ДО ПЯТИ
Dialogue: 0,0:01:42.04,0:01:44.73,Caption,,0,0,0,,МИЛЛИОНОВ МУЖЧИН. ДЛЯ РОССИИ В ТЕХ ЖЕ РАСЧЁТАХ
Dialogue: 0,0:01:44.73,0:01:47.20,Caption,,0,0,0,,НАЗЫВАЮТ ОКОЛО ТРИДЦАТИ ТРЁХ МИЛЛИОНОВ МУЖЧИН
Dialogue: 0,0:01:47.20,0:01:50.39,Caption,,0,0,0,,ПРИЗЫВНОГО ВОЗРАСТА. РАЗНИЦА НАСТОЛЬКО ВЕЛИКА,
Dialogue: 0,0:01:50.71,0:01:53.51,Caption,,0,0,0,,ЧТО СПОР О КРАСИВОЙ СТРАТЕГИИ НАПОМИНАЕТ ОБСУЖДЕНИЕ
Dialogue: 0,0:01:53.51,0:01:56.39,Caption,,0,0,0,,ЦВЕТА ЗАНАВЕСОК В ДОМЕ, ГДЕ УЖЕ СНИМАЮТ КРЫШУ.
Dialogue: 0,0:01:56.96,0:01:59.48,Caption,,0,0,0,,ГЛАВНЫЙ ВОПРОС ЗВУЧИТ ПРЕДЕЛЬНО ГРУБО.
Dialogue: 0,0:01:59.48,0:02:02.79,Caption,,0,0,0,,КТО БУДЕТ ВОЕВАТЬ ДАЛЬШЕ? МОЖНО ПРОВОДИТЬ КОНФЕРЕНЦИИ,
Dialogue: 0,0:02:03.03,0:02:04.82,Caption,,0,0,0,,РИСОВАТЬ ПЛАНЫ ВОССТАНОВЛЕНИЯ И
Dialogue: 0,0:02:04.82,0:02:08.46,Caption,,0,0,0,,ОБЕЩАТЬ ЕВРОПЕЙСКУЮ ПЕРСПЕКТИВУ. НО ОБЕЩАНИЕ НЕ ЗАМЕНИТ
Dialogue: 0,0:02:08.46,0:02:11.47,Caption,,0,0,0,,ЧЕЛОВЕКА В ПОДРАЗДЕЛЕНИИ. ЕСЛИ НЫНЕШНЯЯ ДИНАМИКА
Dialogue: 0,0:02:11.47,0:02:14.71,Caption,,0,0,0,,СОХРАНИТСЯ, СНАЧАЛА СТАНЕТ НЕКЕМ УДЕРЖИВАТЬ ФРОНТ,
Dialogue: 0,0:02:15.03,0:02:17.04,Caption,,0,0,0,,А ЗАТЕМ НЕКОМУ БУДЕТ УЧАСТВОВАТЬ В
Dialogue: 0,0:02:17.04,0:02:20.22,Caption,,0,0,0,,БУДУЩЕМ, КОТОРОЕ ТАК ОХОТНО ПРОДАЮТ УКРАИНЦАМ.
Dialogue: 0,0:02:20.22,0:02:23.54,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ ПЕРЕД СОЛДАТОМ ПРОДОЛЖАЕТ ПОКАЧИВАТЬСЯ
Dialogue: 0,0:02:23.54,0:02:27.35,Caption,,0,0,0,,ГЛАВНЫЙ ПРИЗ. ЧЛЕНСТВО В ЕВРОСОЮЗЕ. НАДО ЕЩЁ НЕМНОГО
Dialogue: 0,0:02:27.35,0:02:31.80,Caption,,0,0,0,,ВЫДЕРЖАТЬ, ПРОВЕСТИ РЕФОРМЫ, ЗАКРЫТЬ ОЧЕРЕДНОЙ ПЕРЕГОВОРНЫЙ РАЗДЕЛ
Dialogue: 0,0:02:31.80,0:02:34.15,Caption,,0,0,0,,И ВЫПОЛНИТЬ ДОПОЛНИТЕЛЬНЫЙ СПИСОК ТРЕБОВАНИЙ.
Dialogue: 0,0:02:36.43,0:02:39.92,Caption,,0,0,0,,ПОСЛЕ ЭТОГО, ВОЗМОЖНО, ОТКРОЕТСЯ СЛЕДУЮЩИЙ СПИСОК.
Dialogue: 0,0:02:39.92,0:02:42.04,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ДВЕРЬ ВРОДЕ БЫ РЯДОМ,
Dialogue: 0,0:02:42.28,0:02:44.11,Caption,,0,0,0,,НО КОРИДОР К НЕЙ УДЛИНЯЕТСЯ ПОСЛЕ
Dialogue: 0,0:02:44.11,0:02:47.24,Caption,,0,0,0,,КАЖДОГО ШАГА. ОСОБЕННО ЗАНЯТНО ВЕДУТ СЕБЯ СТРАНЫ,
Dialogue: 0,0:02:47.48,0:02:49.16,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ ЭТУ ДВЕРЬ ОТКРЫТЬ.
Dialogue: 0,0:02:49.80,0:02:51.83,Caption,,0,0,0,,ПОЛЬША ЕЩЁ ДО УКРАИНСКОГО ВСТУПЛЕНИЯ
Dialogue: 0,0:02:51.83,0:02:54.17,Caption,,0,0,0,,ДОБИЛАСЬ ПЕРЕСМОТРА ПЕРЕГОВОРНЫХ УСЛОВИЙ ПО
Dialogue: 0,0:02:54.17,0:02:56.68,Caption,,0,0,0,,СЕЛЬСКОМУ ХОЗЯЙСТВУ И ТРАНСПОРТУ. ВАРШАВА
Dialogue: 0,0:02:56.68,0:02:59.64,Caption,,0,0,0,,ЗАРАНЕЕ ЗАЩИЩАЕТ СВОИХ ФЕРМЕРОВ И ПЕРЕВОЗЧИКОВ ОТ
Dialogue: 0,0:02:59.64,0:03:02.19,Caption,,0,0,0,,БУДУЩЕГО УКРАИНСКОГО КОНКУРЕНТА. ПОЛЬСКИЕ
Dialogue: 0,0:03:02.19,0:03:05.24,Caption,,0,0,0,,ВЛАСТИ СЧИТАЮТ, ЧТО ЧАСТЬ ИХ ТРЕБОВАНИЙ УЧТЕНА,
Dialogue: 0,0:03:05.48,0:03:07.55,Caption,,0,0,0,,НО ХОТЯТ ДОПОЛНИТЕЛЬНЫХ ГАРАНТИЙ.
Dialogue: 0,0:03:07.55,0:03:10.43,Caption,,0,0,0,,ФРАНЦИЯ ПО ВОПРОСУ ЗАЩИТЫ СОБСТВЕННОГО СЕЛЬСКОГО
Dialogue: 0,0:03:10.43,0:03:12.44,Caption,,0,0,0,,ХОЗЯЙСТВА РАССУЖДАЕТ ПРИМЕРНО ТАК ЖЕ.
Dialogue: 0,0:03:12.99,0:03:14.84,Caption,,0,0,0,,КОГДА ЗВУЧИТ СЛОВО СОЛИДАРНОСТЬ,
Dialogue: 0,0:03:14.98,0:03:17.80,Caption,,0,0,0,,ВСЕ УЛЫБАЮТСЯ. КОГДА НА РЫНОК ПРИЕЗЖАЕТ ДЕШЁВАЯ
Dialogue: 0,0:03:17.80,0:03:20.60,Caption,,0,0,0,,ПРОДУКЦИЯ, НАЧИНАЕТСЯ ТАМОЖЕННЫЙ РАСЧЁТ.
Dialogue: 0,0:03:20.60,0:03:23.28,Caption,,0,0,0,,ПОЛУЧАЕТСЯ СВОЕОБРАЗНОЕ ПРИГЛАШЕНИЕ В СЕМЬЮ.
Dialogue: 0,0:03:23.28,0:03:27.47,Caption,,0,0,0,,НЕВЕСТУ ЗОВУТ ЗА СТОЛ, НО ЗАРАНЕЕ ПЕРЕСЧИТЫВАЮТ ЛОЖКИ И ДЕЛЯТ
Dialogue: 0,0:03:27.47,0:03:30.28,Caption,,0,0,0,,ПРОДУКТЫ В ХОЛОДИЛЬНИКЕ. НОВЫЕ ЭТАПЫ ПЕРЕГОВОРОВ
Dialogue: 0,0:03:30.28,0:03:33.36,Caption,,0,0,0,,ОТКРЫВАЮТСЯ ПРИ СОГЛАСИИ ВСЕХ СТРАН ЕВРОСОЮЗА.
Dialogue: 0,0:03:33.36,0:03:35.48,Caption,,0,0,0,,ПОЛЬША СПОСОБНА ЗАДЕРЖАТЬ ПРОЦЕСС,
Dialogue: 0,0:03:35.71,0:03:38.02,Caption,,0,0,0,,ЕСЛИ СОЧТЁТ ГАРАНТИИ НЕДОСТАТОЧНЫМИ.
Dialogue: 0,0:03:38.02,0:03:40.53,Caption,,0,0,0,,БРЮССЕЛЬ ХОЧЕТ СКОРЕЕ ОТКРЫТЬ ДВА СЛЕДУЮЩИХ
Dialogue: 0,0:03:40.53,0:03:43.56,Caption,,0,0,0,,ПЕРЕГОВОРНЫХ КЛАСТЕРА, А ВАРШАВА ХОЧЕТ УБЕДИТЬСЯ,
Dialogue: 0,0:03:43.78,0:03:45.89,Caption,,0,0,0,,ЧТО ЗА ЕВРОПЕЙСКУЮ МЕЧТУ НЕ ЗАПЛАТЯТ
Dialogue: 0,0:03:45.89,0:03:48.20,Caption,,0,0,0,,ПОЛЬСКИЕ ХОЗЯЙСТВА И ТРАНСПОРТНЫЕ КОМПАНИИ.
Dialogue: 0,0:03:50.46,0:03:52.07,Caption,,0,0,0,,И ПОЛЯКОВ ТРУДНО УПРЕКНУТЬ ОНИ
Dialogue: 0,0:03:52.07,0:03:54.71,Caption,,0,0,0,,ТОРГУЮТСЯ ЗА СВОИХ ГРАЖДАН. ВОПРОС ЛИШЬ В ТОМ,
Dialogue: 0,0:03:55.03,0:03:57.12,Caption,,0,0,0,,ПОЧЕМУ УКРАИНЦАМ ПРОДОЛЖАЮТ ПРОДАВАТЬ
Dialogue: 0,0:03:57.12,0:04:00.33,Caption,,0,0,0,,ВСТУПЛЕНИЕ КАК ПОЧТИ РЕШЁННОЕ ДЕЛО. С ВЕНГРИЕЙ
Dialogue: 0,0:04:00.33,0:04:02.87,Caption,,0,0,0,,ИСТОРИЯ ЕЩЁ НАГЛЯДНЕЕ. ОРБАН УШЁЛ,
Dialogue: 0,0:04:03.19,0:04:04.95,Caption,,0,0,0,,И СТОРОННИКИ БЫСТРОГО УКРАИНСКОГО
Dialogue: 0,0:04:04.95,0:04:07.60,Caption,,0,0,0,,ЧЛЕНСТВА МОГЛИ УЖЕ ВЫБИРАТЬ ЦВЕТ ОБЛОЖКИ ДЛЯ НОВЫХ
Dialogue: 0,0:04:07.60,0:04:10.83,Caption,,0,0,0,,ПАСПОРТОВ. НО ВЕНГЕРСКИЕ ИНТЕРЕСЫ НЕ УШЛИ ВСЛЕД
Dialogue: 0,0:04:10.83,0:04:13.61,Caption,,0,0,0,,ЗА ОДНИМ ПОЛИТИКОМ. ПАКЕТ УСТУПОК ПОЛУЧИЛСЯ
Dialogue: 0,0:04:13.61,0:04:16.07,Caption,,0,0,0,,СОЛИДНЫЙ. ОДНАКО ПЕТЕР МАДЬЯР ЗАЯВИЛ,
Dialogue: 0,0:04:16.23,0:04:18.39,Caption,,0,0,0,,ЧТО УСКОРЕННОГО ВСТУПЛЕНИЯ ВСЁ РАВНО
Dialogue: 0,0:04:18.39,0:04:22.48,Caption,,0,0,0,,НЕ БУДЕТ. ПО ЕГО СЛОВАМ, ЧЛЕНСТВО НЕОБХОДИМО ЗАСЛУЖИТЬ. ТО ЕСТЬ
Dialogue: 0,0:04:22.48,0:04:26.63,Caption,,0,0,0,,УКРАИНА РАССЧИТАЛАСЬ ВПЕРЁД, А ТОВАР ЕЙ ПОКА НЕ ОТДАЛИ. В ПРИЛИЧНОМ
Dialogue: 0,0:04:26.63,0:04:28.93,Caption,,0,0,0,,МАГАЗИНЕ ПОСЛЕ ТАКОГО ХОТЯ БЫ ЧЕК
Dialogue: 0,0:04:28.93,0:04:32.13,Caption,,0,0,0,,ВЫДАЮТ. ПОЛЬША ТРЕБУЕТ ЗАЩИТИТЬ СВОЙ РЫНОК. ВЕНГРИЯ
Dialogue: 0,0:04:32.13,0:04:35.81,Caption,,0,0,0,,ПОЛУЧАЕТ УСТУПКИ, НО НЕ ОБЕЩАЕТ БЫСТРЫЙ ПРОПУСК. ФРАНЦИЯ
Dialogue: 0,0:04:35.81,0:04:38.52,Caption,,0,0,0,,ДУМАЕТ О СОБСТВЕННЫХ АГРАРИЯХ. ВСЁ ЭТО МАЛО
Dialogue: 0,0:04:38.52,0:04:41.60,Caption,,0,0,0,,ПОХОЖЕ НА ПОДГОТОВКУ УКРАИНЫ К СКОРОМУ ЧЛЕНСТВУ.
Dialogue: 0,0:04:41.60,0:04:44.15,Caption,,0,0,0,,БЫСТРО ПРИНИМАТЬ ЕЁ НЕ ПЛАНИРОВАЛИ И СЕЙЧАС,
Dialogue: 0,0:04:44.30,0:04:47.88,Caption,,0,0,0,,СУДЯ ПО ДЕЙСТВИЯМ, ТОЖЕ НЕ СОБИРАЮТСЯ. ОДНАКО СОЛДАТУ
Dialogue: 0,0:04:47.88,0:04:50.71,Caption,,0,0,0,,ПРОДОЛЖАЮТ ПОВТОРЯТЬ, ЧТО НАДО ЕЩЁ ПОТЕРПЕТЬ,
Dialogue: 0,0:04:50.87,0:04:53.68,Caption,,0,0,0,,ПРОДОЛЖИТЬ ВОЕВАТЬ, ПЕРЕЖИТЬ ОТКЛЮЧЕНИЯ И РОСТ
Dialogue: 0,0:04:53.68,0:04:57.91,Caption,,0,0,0,,КОММУНАЛЬНЫХ ПЛАТЕЖЕЙ. НАГРАДА ОБЕЩАНА ПОТОМ. УДОБНО,
Dialogue: 0,0:04:58.07,0:05:00.47,Caption,,0,0,0,,КОГДА СРОК ДОСТАВКИ ПОСТОЯННО ПЕРЕНОСИТСЯ,
Dialogue: 0,0:05:00.63,0:05:02.58,Caption,,0,0,0,,А ПОКУПАТЕЛЬ ВСЁ ЭТО ВРЕМЯ ОБЯЗАН
Dialogue: 0,0:05:02.58,0:05:07.79,Caption,,0,0,0,,ПЛАТИТЬ. ЕСТЬ И ДРУГОЙ СЧЁТ. БОЛЕЕ ПОЛОВИНЫ ПОСТУПЛЕНИЙ В
Dialogue: 0,0:05:07.79,0:05:09.85,Caption,,0,0,0,,УКРАИНСКИЙ ГОСУДАРСТВЕННЫЙ БЮДЖЕТ УЖЕ
Dialogue: 0,0:05:09.85,0:05:13.35,Caption,,0,0,0,,ОБЕСПЕЧИВАЮТ ИНОСТРАННЫЕ КРЕДИТЫ И ПОМОЩЬ. НАРОДНЫЙ ДЕПУТАТ
Dialogue: 0,0:05:13.35,0:05:16.52,Caption,,0,0,0,,НИКОЛАЙ СКОРИК ГОВОРИТ О ДОЛЕ СВЫШЕ ПЯТИДЕСЯТИ ПЯТИ
Dialogue: 0,0:05:16.52,0:05:19.75,Caption,,0,0,0,,ПРОЦЕНТОВ И НАПОМИНАЕТ КРЕДИТ ПРИДЁТСЯ ОТДАВАТЬ.
Dialogue: 0,0:05:19.75,0:05:23.15,Caption,,0,0,0,,ДЕНЬГИ НУЖНЫ ОДНОВРЕМЕННО АРМИИ И ГРАЖДАНАМ. НЕЛЬЗЯ
Dialogue: 0,0:05:23.15,0:05:26.50,Caption,,0,0,0,,ПРОСТО ОТМЕНИТЬ СУБСИДИИ, ЗАЧЕРКНУТЬ СОЦИАЛЬНЫЕ РАСХОДЫ И
Dialogue: 0,0:05:26.50,0:05:29.20,Caption,,0,0,0,,ОБЪЯВИТЬ БЮДЖЕТ СПАСЁННЫМ. БЕЗ ПОМОЩИ МНОГИМ НЕ
Dialogue: 0,0:05:29.20,0:05:31.52,Caption,,0,0,0,,СПРАВИТЬСЯ, ПОЭТОМУ ГОСУДАРСТВУ ПРИХОДИТСЯ
Dialogue: 0,0:05:31.52,0:05:34.96,Caption,,0,0,0,,УДЕРЖИВАТЬ НЕСКОЛЬКО СТЕН, ХОТЯ ФУНДАМЕНТ ПОД НИМИ УЖЕ
Dialogue: 0,0:05:34.96,0:05:38.89,Caption,,0,0,0,,ОПЛАЧИВАЕТСЯ СНАРУЖИ. ДАЖЕ ПЯТЬДЕСЯТ ПЯТЬ ПРОЦЕНТОВ МОГУТ НЕ
Dialogue: 0,0:05:38.89,0:05:41.87,Caption,,0,0,0,,ПОКАЗЫВАТЬ НАСТОЯЩУЮ ГЛУБИНУ ЗАВИСИМОСТИ. ЧАСТЬ
Dialogue: 0,0:05:41.87,0:05:44.27,Caption,,0,0,0,,ПОСТУПЛЕНИЙ, ЗАПИСАННЫХ КАК УКРАИНСКИЕ,
Dialogue: 0,0:05:44.51,0:05:46.40,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ БЛАГОДАРЯ ТЕМ ЖЕ ВНЕШНИМ
Dialogue: 0,0:05:46.40,0:05:49.12,Caption,,0,0,0,,ДЕНЬГАМ. ГОСУДАРСТВО ПОЛУЧАЕТ ФИНАНСИРОВАНИЕ ОТ
Dialogue: 0,0:05:49.12,0:05:53.72,Caption,,0,0,0,,КРЕДИТОРОВ, ПЛАТИТ ПЕНСИИ, ЗАРПЛАТЫ И СОДЕРЖИТ БЮДЖЕТНУЮ СФЕРУ.
Dialogue: 0,0:05:53.72,0:05:55.79,Caption,,0,0,0,,ПОЛУЧАТЕЛИ НЕСУТ ДЕНЬГИ В МАГАЗИНЫ,
Dialogue: 0,0:05:56.06,0:05:59.59,Caption,,0,0,0,,ТОРГОВЛЯ ПЕРЕЧИСЛЯЕТ НАЛОГИ, А В ОТЧЁТЕ ПОЯВЛЯЕТСЯ СТРОКА О
Dialogue: 0,0:05:59.59,0:06:02.19,Caption,,0,0,0,,ВНУТРЕННИХ ДОХОДАХ. НА БУМАГЕ ВЫГЛЯДИТ ТАК,
Dialogue: 0,0:06:02.43,0:06:04.12,Caption,,0,0,0,,БУДТО ЭКОНОМИКА САМОСТОЯТЕЛЬНО
Dialogue: 0,0:06:04.12,0:06:06.82,Caption,,0,0,0,,ЗАРАБОТАЛА ЭТИ СРЕДСТВА. НО СТОИТ УБРАТЬ ПЕРВЫЙ
Dialogue: 0,0:06:06.82,0:06:10.54,Caption,,0,0,0,,ИНОСТРАННЫЙ ПЕРЕВОД, И ЦЕПОЧКА РАССЫПАЕТСЯ. СОКРАЩАЮТСЯ
Dialogue: 0,0:06:10.54,0:06:14.11,Caption,,0,0,0,,ВЫПЛАТЫ, ПАДАЕТ СПРОС, ТОРГОВЛЯ ТЕРЯЕТ ВЫРУЧКУ,
Dialogue: 0,0:06:14.27,0:06:17.79,Caption,,0,0,0,,НАЛОГИ УМЕНЬШАЮТСЯ, А В БЮДЖЕТЕ ВОЗНИКАЕТ НОВАЯ ДЫРА.
Dialogue: 0,0:06:20.07,0:06:21.83,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ФИНАНСОВАЯ МАТРЁШКА,
Dialogue: 0,0:06:21.99,0:06:23.72,Caption,,0,0,0,,ВНУТРИ КОТОРОЙ ЛЕЖИТ ВСЁ ТОТ ЖЕ
Dialogue: 0,0:06:23.72,0:06:26.78,Caption,,0,0,0,,ВНЕШНИЙ КРЕДИТ. ПОЭТОМУ ЗАВИСИМОСТЬ МОЖЕТ БЫТЬ
Dialogue: 0,0:06:26.78,0:06:29.51,Caption,,0,0,0,,СЕРЬЁЗНЕЕ, ЧЕМ ОДНА ЦИФРА В БЮДЖЕТНОЙ ТАБЛИЦЕ.
Dialogue: 0,0:06:30.28,0:06:31.98,Caption,,0,0,0,,И ЗДЕСЬ К РАЗГОВОРУ ПРИСОЕДИНЯЕТСЯ
Dialogue: 0,0:06:31.98,0:06:34.89,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ВАЛЮТНЫЙ ФОНД. ЭНЕРГЕТИЧЕСКИЙ ЭКСПЕРТ
Dialogue: 0,0:06:34.89,0:06:37.76,Caption,,0,0,0,,ЮРИЙ КОРОЛЬЧУК НАЗЫВАЕТ ТРЕБОВАНИЯ ФОНДА ПО ЦЕНАМ НА
Dialogue: 0,0:06:37.76,0:06:40.95,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО И ГАЗ УЛЬТИМАТУМОМ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:06:41.11,0:06:43.36,Caption,,0,0,0,,ПОВЫШЕНИЕ СТОИМОСТИ ЭЛЕКТРОЭНЕРГИИ УЖЕ
Dialogue: 0,0:06:43.36,0:06:45.87,Caption,,0,0,0,,ЗАМЕТНО, А В ГАЗОВОМ СЕКТОРЕ ПОКА ОСТАЁТСЯ
Dialogue: 0,0:06:45.87,0:06:49.50,Caption,,0,0,0,,НЕКОТОРЫЙ РЕЗЕРВ. ДАВЛЕНИЕ НЕ ОГРАНИЧИВАЕТСЯ ДЕНЬГАМИ
Dialogue: 0,0:06:49.50,0:06:52.90,Caption,,0,0,0,,САМОГО ФОНДА. МВФ ВЛИЯЕТ НА РЕКОМЕНДАЦИИ ДРУГИМ
Dialogue: 0,0:06:52.90,0:06:55.60,Caption,,0,0,0,,КРЕДИТОРАМ. КИЕВ МОЖЕТ НЕ БРАТЬ ОЧЕРЕДНУЮ СУММУ
Dialogue: 0,0:06:55.60,0:06:58.93,Caption,,0,0,0,,НЕПОСРЕДСТВЕННО У ФОНДА, НО РЕШЕНИЕ ОСТАЛЬНЫХ ВЛАДЕЛЬЦЕВ
Dialogue: 0,0:06:58.93,0:07:01.89,Caption,,0,0,0,,КОШЕЛЬКОВ ВСЁ РАВНО БУДЕТ ЗАВИСЕТЬ ОТ ВЫПОЛНЕНИЯ ЕГО
Dialogue: 0,0:07:01.89,0:07:05.23,Caption,,0,0,0,,УСЛОВИЙ. КОРОЛЬЧУК СВЯЗЫВАЕТ ТАРИФНЫЕ РЕШЕНИЯ С БУДУЩИМ
Dialogue: 0,0:07:05.23,0:07:08.30,Caption,,0,0,0,,КРУПНЫХ ГОСУДАРСТВЕННЫХ КОМПАНИЙ. ОТ ПОВЫШЕНИЯ
Dialogue: 0,0:07:08.30,0:07:10.71,Caption,,0,0,0,,ЦЕН НА ЭЛЕКТРИЧЕСТВО И ГАЗ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:07:10.87,0:07:13.41,Caption,,0,0,0,,ЗАВИСИТ, ПОЗВОЛЯТ ЛИ ДАЛЬШЕ РАБОТАТЬ
Dialogue: 0,0:07:13.41,0:07:16.83,Caption,,0,0,0,,"УКРЗАЛІЗНИЦІ" ИЛИ ПОДТОЛКНУТ ЕЁ К БАНКРОТСТВУ. ПОХОЖИЙ
Dialogue: 0,0:07:16.83,0:07:18.55,Caption,,0,0,0,,ВОПРОС СТОИТ ПЕРЕД "УКРЭНЕРГО".
Dialogue: 0,0:07:19.19,0:07:21.23,Caption,,0,0,0,,РАЗГОВОРЫ О РОСТЕ ТАРИФОВ ЗВУЧАЛИ ЕЩЁ
Dialogue: 0,0:07:21.23,0:07:23.73,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ ГОДУ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:07:23.73,0:07:27.38,Caption,,0,0,0,,ПУБЛИЧНО ИХ ОПРОВЕРГАЛ, ХОТЯ ОДНОВРЕМЕННО ПОЯВЛЯЛИСЬ СООБЩЕНИЯ
Dialogue: 0,0:07:27.38,0:07:32.99,Caption,,0,0,0,,ОБ ОТСРОЧКЕ РЕШЕНИЯ. ВОЗВРАЩЕНИЕ ТЕМЫ ВМЕСТЕ С ТРЕБОВАНИЯМИ
Dialogue: 0,0:07:32.99,0:07:35.90,Caption,,0,0,0,,КРЕДИТОРОВ ОЗНАЧАЕТ ДЛЯ ГРАЖДАН НОВЫЕ СУММЫ В
Dialogue: 0,0:07:35.90,0:07:39.78,Caption,,0,0,0,,ПЛАТЁЖНЫХ ДОКУМЕНТАХ, А ДЛЯ "УКРЗАЛІЗНИЦІ" И "УКРЭНЕРГО" ЭТО
Dialogue: 0,0:07:39.78,0:07:43.32,Caption,,0,0,0,,РИСК БАНКРОТСТВА. ОБЫЧНОМУ ЧЕЛОВЕКУ НЕТ БОЛЬШОЙ РАЗНИЦЫ,
Dialogue: 0,0:07:43.56,0:07:46.12,Caption,,0,0,0,,КАКОЙ СРОК ЧИНОВНИКИ ДЕРЖАЛИ В УМЕ. ОН
Dialogue: 0,0:07:46.12,0:07:49.32,Caption,,0,0,0,,СМОТРИТ В ПЛАТЁЖНЫЙ ДОКУМЕНТ, ГДЕ РАЗГОВОР О ЕВРОПЕ,
Dialogue: 0,0:07:49.48,0:07:51.26,Caption,,0,0,0,,ФОНДАХ И МЕЖДУНАРОДНОЙ ПОДДЕРЖКЕ
Dialogue: 0,0:07:51.26,0:07:54.29,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В СУММУ К ОПЛАТЕ. ЕСТЬ И БОЛЕЕ ТЯЖЁЛОЕ
Dialogue: 0,0:07:54.29,0:07:56.62,Caption,,0,0,0,,ОБЪЯСНЕНИЕ ПРОИСХОДЯЩЕГО. ПРОДОЛЖЕНИЕ ВОЙНЫ
Dialogue: 0,0:07:56.62,0:07:59.16,Caption,,0,0,0,,СВЯЗЫВАЮТ НЕ ТОЛЬКО С ГОСУДАРСТВЕННЫМИ ИНТЕРЕСАМИ,
Dialogue: 0,0:07:59.42,0:08:01.44,Caption,,0,0,0,,НО И С ЖЕЛАНИЕМ ОПРЕДЕЛЁННОЙ ГРУППЫ
Dialogue: 0,0:08:01.44,0:08:04.21,Caption,,0,0,0,,СОХРАНИТЬ ВЛАСТЬ. ИЗ ЭТОЙ ВЕРСИИ СЛЕДУЕТ МРАЧНЫЙ
Dialogue: 0,0:08:04.21,0:08:06.20,Caption,,0,0,0,,ПРОГНОЗ ЕСЛИ КОНФЛИКТ НЕ ОСТАНОВИТЬ,
Dialogue: 0,0:08:06.52,0:08:08.44,Caption,,0,0,0,,УКРАИНА МОЖЕТ ДОЙТИ ДО СОСТОЯНИЯ,
Dialogue: 0,0:08:08.60,0:08:11.00,Caption,,0,0,0,,В КОТОРОМ НОРМАЛЬНАЯ РАБОТА ГОСУДАРСТВА СТАНЕТ
Dialogue: 0,0:08:11.00,0:08:13.40,Caption,,0,0,0,,НЕВОЗМОЖНОЙ. ЭТО ВЕРСИЯ И ПРОГНОЗ,
Dialogue: 0,0:08:13.55,0:08:15.67,Caption,,0,0,0,,А НЕ УСТАНОВЛЕННЫЙ ФАКТ. НО ПУБЛИЧНОЕ
Dialogue: 0,0:08:15.67,0:08:18.22,Caption,,0,0,0,,ОПРОВЕРЖЕНИЕ РОСТА ТАРИФОВ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:08:18.22,0:08:21.26,Caption,,0,0,0,,ПЯТОМ ГОДУ УЖЕ СМЕНИЛОСЬ ТРЕБОВАНИЯМИ КРЕДИТОРОВ
Dialogue: 0,0:08:21.26,0:08:24.24,Caption,,0,0,0,,И РИСКОМ НОВЫХ ПЛАТЕЖЕЙ. ДЛЯ ГРАЖДАН ПОСЛЕДСТВИЕМ
Dialogue: 0,0:08:24.24,0:08:28.21,Caption,,0,0,0,,СТАНЕТ ПОВЫШЕНИЕ РАСХОДОВ, А ДЛЯ ГОСУДАРСТВЕННЫХ КОМПАНИЙ ЭТО
Dialogue: 0,0:08:28.21,0:08:31.56,Caption,,0,0,0,,УГРОЗА БАНКРОТСТВА. ЕСЛИ ВАМ БЛИЗОК РАЗГОВОР О ТОМ,
Dialogue: 0,0:08:31.77,0:08:33.80,Caption,,0,0,0,,КТО ОПЛАЧИВАЕТ ГРОМКИЕ РЕШЕНИЯ,
Dialogue: 0,0:08:33.93,0:08:36.12,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ТЕПЕРЬ НА СТОЛ
Dialogue: 0,0:08:36.12,0:08:40.01,Caption,,0,0,0,,ВЫКЛАДЫВАЮТ СУММУ, РЯДОМ С КОТОРОЙ ПРЕЖНИЕ СЧЕТА ВЫГЛЯДЯТ
Dialogue: 0,0:08:40.01,0:08:42.90,Caption,,0,0,0,,КАРМАННОЙ МЕЛОЧЬЮ. СТО МИЛЛИАРДОВ ЕВРО ДЛЯ
Dialogue: 0,0:08:42.90,0:08:47.45,Caption,,0,0,0,,УКРАИНЫ. ЧЕЛОВЕЧЕСКИЙ МОЗГ ПЛОХО ДРУЖИТ С
Dialogue: 0,0:08:47.45,0:08:50.90,Caption,,0,0,0,,ТАКИМИ ВЕЛИЧИНАМИ. ДЕСЯТЬ ТЫСЯЧ ЕЩЁ МОЖНО СООТНЕСТИ С
Dialogue: 0,0:08:50.90,0:08:54.20,Caption,,0,0,0,,АВТОМОБИЛЕМ ИЛИ РЕМОНТОМ. СТО ТЫСЯЧ НАПОМИНАЮТ ЦЕНУ
Dialogue: 0,0:08:54.20,0:08:57.35,Caption,,0,0,0,,КВАРТИРЫ ИЛИ ИПОТЕКУ. СТО МИЛЛИАРДОВ ВЫГЛЯДЯТ КАК
Dialogue: 0,0:08:57.35,0:08:59.60,Caption,,0,0,0,,КОЛИЧЕСТВО ПЕСКА НА ПЛЯЖЕ ВРОДЕ МНОГО,
Dialogue: 0,0:08:59.84,0:09:02.20,Caption,,0,0,0,,НО СЧИТАТЬ НИКТО НЕ СОБИРАЕТСЯ. ИМЕННО
Dialogue: 0,0:09:02.20,0:09:04.92,Caption,,0,0,0,,ПОЭТОМУ ГИГАНТСКИЕ СУММЫ УДОБНО ПРОИЗНОСИТЬ СО
Dialogue: 0,0:09:04.92,0:09:08.07,Caption,,0,0,0,,СЦЕНЫ. ЕВРОСОЮЗ ВЫДЕЛИТ УКРАИНЕ СТО
Dialogue: 0,0:09:08.07,0:09:11.91,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. ЗВУЧИТ ПОЧТИ КАК БЛАГОТВОРИТЕЛЬНЫЙ ЖЕСТ
Dialogue: 0,0:09:11.91,0:09:14.80,Caption,,0,0,0,,ОГРОМНОГО КОНТИНЕНТА. НО ФРАЗА МЕНЯЕТСЯ,
Dialogue: 0,0:09:14.88,0:09:17.26,Caption,,0,0,0,,ЕСЛИ СКАЗАТЬ ПРОЩЕ. ЭТИ ДЕНЬГИ ВОЗЬМУТ
Dialogue: 0,0:09:17.26,0:09:19.91,Caption,,0,0,0,,У ЕВРОПЕЙСКИХ НАЛОГОПЛАТЕЛЬЩИКОВ И ПЕРЕДАДУТ
Dialogue: 0,0:09:19.91,0:09:22.80,Caption,,0,0,0,,УКРАИНЕ. У БЛАГОРОДНОГО ЖЕСТА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:09:22.80,0:09:25.28,Caption,,0,0,0,,ПЛАТЕЛЬЩИК, И ОН НАЧИНАЕТ ЗАДАВАТЬ ВОПРОСЫ.
Dialogue: 0,0:09:25.91,0:09:28.02,Caption,,0,0,0,,ПРЕМЬЕР ЧЕХИИ АНДРЕЙ БАБИШ ВЫСТУПИЛ
Dialogue: 0,0:09:28.02,0:09:31.46,Caption,,0,0,0,,ПРОТИВ НОВОГО ПРОЕКТА СЕМИЛЕТНЕГО БЮДЖЕТА ЕВРОСОЮЗА.
Dialogue: 0,0:09:31.46,0:09:33.92,Caption,,0,0,0,,ОН СЧИТАЕТ ЕГО НЕПРИЕМЛЕМЫМ ДЛЯ ПРАГИ,
Dialogue: 0,0:09:34.08,0:09:35.97,Caption,,0,0,0,,ПОТОМУ ЧТО ЧЕХИЯ ДОЛЖНА ВНОСИТЬ
Dialogue: 0,0:09:35.97,0:09:40.12,Caption,,0,0,0,,БОЛЬШЕ, А ПОЛУЧАТЬ МЕНЬШЕ. БАБИШ ТАКЖЕ РАСКРИТИКОВАЛ РАСХОДЫ НА
Dialogue: 0,0:09:40.12,0:09:43.21,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ УЧРЕЖДЕНИЯ И ОТВЕРГ ВЫДЕЛЕНИЕ УКРАИНЕ
Dialogue: 0,0:09:43.21,0:09:47.02,Caption,,0,0,0,,СТА МИЛЛИАРДОВ ЕВРО ИЗ ОБЩЕГО БЮДЖЕТА. ЕГО ПОЗИЦИЯ
Dialogue: 0,0:09:47.02,0:09:49.44,Caption,,0,0,0,,ЯСНА. ПОМОЩЬ УКРАИНЕ ОБСУЖДАТЬ МОЖНО,
Dialogue: 0,0:09:49.74,0:09:51.76,Caption,,0,0,0,,НО ОБЩИЙ ЕВРОПЕЙСКИЙ КОШЕЛЁК ДЛЯ ЭТОГО
Dialogue: 0,0:09:51.76,0:09:54.37,Caption,,0,0,0,,ИСПОЛЬЗОВАТЬ НЕ СЛЕДУЕТ. А ЕСЛИ НЕЛЬЗЯ БРАТЬ
Dialogue: 0,0:09:54.37,0:09:56.98,Caption,,0,0,0,,ОТТУДА, ПРИДЁТСЯ НАЗВАТЬ ДРУГИЕ КАРМАНЫ.
Dialogue: 0,0:09:56.98,0:10:00.24,Caption,,0,0,0,,ИМЕННО НА ЭТОМ МЕСТЕ ВЕЛИКОДУШИЕ ОБЫЧНО ПРОСИТ ПАУЗУ.
Dialogue: 0,0:10:02.50,0:10:04.38,Caption,,0,0,0,,ПОКА СТО МИЛЛИАРДОВ СУЩЕСТВУЮТ КАК
Dialogue: 0,0:10:04.38,0:10:06.18,Caption,,0,0,0,,АБСТРАКТНАЯ ЕВРОПЕЙСКАЯ СУММА,
Dialogue: 0,0:10:06.49,0:10:09.94,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ ИХ ЛЕГКО. КАК ТОЛЬКО ПОЯВЛЯЕТСЯ ВОПРОС О
Dialogue: 0,0:10:09.94,0:10:13.34,Caption,,0,0,0,,НАЦИОНАЛЬНОМ ВЗНОСЕ, КАЖДЫЙ ВСПОМИНАЕТ СОБСТВЕННЫЕ
Dialogue: 0,0:10:13.34,0:10:17.44,Caption,,0,0,0,,БОЛЬНИЦЫ, ДОРОГИ, ПЕНСИИ И ВЫБОРЫ. КАЛЬКУЛЯТОР ХОРОШО
Dialogue: 0,0:10:17.44,0:10:22.10,Caption,,0,0,0,,ОХЛАЖДАЕТ ГОРЯЧИЕ РЕЧИ. ТЕПЕРЬ О МАРИН ЛЕ ПЕН. ВОКРУГ НЕЁ
Dialogue: 0,0:10:22.10,0:10:24.02,Caption,,0,0,0,,СТРОЯТ ДАЛЕКО ИДУЩИЕ ОЖИДАНИЯ,
Dialogue: 0,0:10:24.26,0:10:26.57,Caption,,0,0,0,,ХОТЯ ПРЕЗИДЕНТОМ ФРАНЦИИ ОНА ПОКА НЕ
Dialogue: 0,0:10:26.57,0:10:28.98,Caption,,0,0,0,,СТАЛА. СНАЧАЛА НЕОБХОДИМО ВЫИГРАТЬ ВЫБОРЫ,
Dialogue: 0,0:10:29.22,0:10:32.34,Caption,,0,0,0,,А УЖЕ ПОТОМ ДЕЛИТЬ КАБИНЕТЫ И ПЕРЕСТАВЛЯТЬ КРЕСЛА.
Dialogue: 0,0:10:33.12,0:10:36.80,Caption,,0,0,0,,ЛЕ ПЕН ПРЯМО ЗАЯВЛЯЕТ, ЧТО УКРАИНА НЕ ДОЛЖНА СТАНОВИТЬСЯ
Dialogue: 0,0:10:36.80,0:10:40.58,Caption,,0,0,0,,ЧЛЕНОМ ЕВРОСОЮЗА. ЕЁ ПАРТИЯ ТРЕБУЕТ СООБЩИТЬ ФРАНЦУЗАМ,
Dialogue: 0,0:10:40.83,0:10:43.32,Caption,,0,0,0,,КАКАЯ ДОЛЯ НОВОГО ЕВРОПЕЙСКОГО КРЕДИТА
Dialogue: 0,0:10:43.32,0:10:46.69,Caption,,0,0,0,,УКРАИНЕ ПРИДЁТСЯ НА ФРАНЦИЮ. ОБСУЖДАЕТСЯ СУММА
Dialogue: 0,0:10:46.69,0:10:49.62,Caption,,0,0,0,,ДО СОРОКА ПЯТИ МИЛЛИАРДОВ ЕВРО. ОТ ФРАНЦУЗСКИХ
Dialogue: 0,0:10:49.62,0:10:53.38,Caption,,0,0,0,,ВЛАСТЕЙ ТАКЖЕ ХОТЯТ ОТВЕТА, КАКИЕ РАСХОДЫ БУДУТ УРЕЗАНЫ,
Dialogue: 0,0:10:53.60,0:10:55.88,Caption,,0,0,0,,ЕСЛИ РОССИЙСКИЕ РЕПАРАЦИИ НЕ ПОСТУПЯТ
Dialogue: 0,0:10:55.88,0:10:57.95,Caption,,0,0,0,,И ОБЯЗАТЕЛЬСТВА ПЕРЕЙДУТ НА БЮДЖЕТ
Dialogue: 0,0:10:57.95,0:11:01.95,Caption,,0,0,0,,ЕВРОСОЮЗА. ЭТО ВОПРОС О ТОМ, КАКУЮ СТРОКУ НАЦИОНАЛЬНОГО БЮДЖЕТА
Dialogue: 0,0:11:01.95,0:11:05.17,Caption,,0,0,0,,ПОДВИНУТ РАДИ УКРАИНСКОГО КРЕДИТА. ДЛЯ КИЕВА СОРОК
Dialogue: 0,0:11:05.17,0:11:08.48,Caption,,0,0,0,,ПЯТЬ МИЛЛИАРДОВ НАЗЫВАЮТСЯ ПОМОЩЬЮ. ДЛЯ ФРАНЦУЗСКОГО
Dialogue: 0,0:11:08.48,0:11:11.63,Caption,,0,0,0,,ИЗБИРАТЕЛЯ ТА ЖЕ СУММА РАСКЛАДЫВАЕТСЯ ИНАЧЕ. СКОЛЬКО
Dialogue: 0,0:11:11.63,0:11:14.58,Caption,,0,0,0,,ЗАБЕРУТ ЧЕРЕЗ НАЛОГИ? КАКУЮ ВЫПЛАТУ ЗАМОРОЗЯТ?
Dialogue: 0,0:11:14.66,0:11:17.78,Caption,,0,0,0,,НА ЧЁМ СЭКОНОМЯТ? МЕЖДУНАРОДНАЯ ПОВЕСТКА БЫСТРО
Dialogue: 0,0:11:17.78,0:11:19.78,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В СЕМЕЙНЫЕ КВИТАНЦИИ.
Dialogue: 0,0:11:22.07,0:11:23.94,Caption,,0,0,0,,РАБОТОЙ ЭММАНУЭЛЯ МАКРОНА ДОВОЛЬНЫ
Dialogue: 0,0:11:23.94,0:11:27.28,Caption,,0,0,0,,ЛИШЬ ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ ОПРОШЕННЫХ. ОДИН ИЗ ОПРОСОВ
Dialogue: 0,0:11:27.28,0:11:29.86,Caption,,0,0,0,,ДАЁТ ЛЕ ПЕН ВО ВТОРОМ ТУРЕ ПРОТИВ ЖАН ЛЮКА
Dialogue: 0,0:11:29.86,0:11:33.53,Caption,,0,0,0,,МЕЛАНШОНА ШЕСТЬДЕСЯТ ПЯТЬ ПРОЦЕНТОВ ПРОТИВ ТРИДЦАТИ ПЯТИ.
Dialogue: 0,0:11:33.53,0:11:36.78,Caption,,0,0,0,,ЕСТЬ И ОЦЕНКА, СОГЛАСНО КОТОРОЙ ВЕРОЯТНОСТЬ ЕЁ ПОБЕДЫ
Dialogue: 0,0:11:36.78,0:11:39.95,Caption,,0,0,0,,ПРИБЛИЖАЕТСЯ К ДЕВЯНОСТА ПРОЦЕНТАМ. ОДНАКО ПРОГНОЗ
Dialogue: 0,0:11:39.95,0:11:42.79,Caption,,0,0,0,,ОСТАЁТСЯ ПРОГНОЗОМ. РЕЗУЛЬТАТ ПОЯВИТСЯ ТОЛЬКО
Dialogue: 0,0:11:42.79,0:11:44.80,Caption,,0,0,0,,ПОСЛЕ ГОЛОСОВАНИЯ. ПОЭТОМУ ЗАРАНЕЕ
Dialogue: 0,0:11:44.80,0:11:48.84,Caption,,0,0,0,,ЗАКАЗЫВАТЬ ДЛЯ ЛЕ ПЕН ТАБЛИЧКУ НА ДВЕРИ ЕЛИСЕЙСКОГО ДВОРЦА
Dialogue: 0,0:11:48.84,0:11:51.94,Caption,,0,0,0,,РАНО. ДАЖЕ ЕЁ ВОЗМОЖНАЯ ПОБЕДА НЕ ОЗНАЧАЕТ РЕЗКОГО
Dialogue: 0,0:11:51.94,0:11:54.42,Caption,,0,0,0,,РАЗВОРОТА ФРАНЦИИ К РОССИИ. ПРЕЗИДЕНТЫ И
Dialogue: 0,0:11:54.42,0:11:56.79,Caption,,0,0,0,,КАБИНЕТЫ МИНИСТРОВ МЕНЯЮТСЯ БЫСТРЕЕ,
Dialogue: 0,0:11:56.87,0:11:59.31,Caption,,0,0,0,,ЧЕМ ГОСУДАРСТВЕННЫЙ КУРС. НАДЕЖДА НА
Dialogue: 0,0:11:59.31,0:12:01.57,Caption,,0,0,0,,ТО, ЧТО ОДНА ФАМИЛИЯ ПЕРЕВЕРНЁТ ВСЮ
Dialogue: 0,0:12:01.57,0:12:05.53,Caption,,0,0,0,,ФРАНЦУЗСКУЮ СИСТЕМУ, НАПОМИНАЕТ ВЕРУ В ВОЛШЕБНУЮ КНОПКУ. ЛЕ
Dialogue: 0,0:12:05.53,0:12:07.67,Caption,,0,0,0,,ПЕН УЖЕ СООБЩИЛА УКРАИНСКОМУ ПОСЛУ,
Dialogue: 0,0:12:07.83,0:12:10.39,Caption,,0,0,0,,ГДЕ ПРОВЕДЁТ ГРАНИЦУ. ФРАНЦИЯ ВЫПОЛНИТ
Dialogue: 0,0:12:10.39,0:12:14.10,Caption,,0,0,0,,СУЩЕСТВУЮЩИЕ ОБЯЗАТЕЛЬСТВА, НО НОВЫХ ДЕНЕЖНЫХ ПАКЕТОВ ПРИ ЕЁ
Dialogue: 0,0:12:14.10,0:12:17.28,Caption,,0,0,0,,ПРЕЗИДЕНТСТВЕ НЕ БУДЕТ. ЭТО НЕ ОБЕЩАНИЕ ДРУЖБЫ С
Dialogue: 0,0:12:17.28,0:12:20.39,Caption,,0,0,0,,МОСКВОЙ. ЭТО ОБЕЩАНИЕ СЧИТАТЬ ФРАНЦУЗСКИЕ ДЕНЬГИ.
Dialogue: 0,0:12:21.00,0:12:23.55,Caption,,0,0,0,,ОСОБЕННО ВАЖНЫ ПРИОРИТЕТЫ ИЗБИРАТЕЛЕЙ.
Dialogue: 0,0:12:23.55,0:12:25.73,Caption,,0,0,0,,ДЛЯ ПЯТИДЕСЯТИ ДЕВЯТИ ПРОЦЕНТОВ ФРАНЦУЗОВ
Dialogue: 0,0:12:25.73,0:12:27.83,Caption,,0,0,0,,ОДНОЙ ИЗ ГЛАВНЫХ ПРИЧИН ВЫБОРА ЯВЛЯЕТСЯ
Dialogue: 0,0:12:27.83,0:12:30.52,Caption,,0,0,0,,ПОКУПАТЕЛЬНАЯ СПОСОБНОСТЬ. МИГРАЦИЮ НАЗЫВАЮТ
Dialogue: 0,0:12:30.52,0:12:33.89,Caption,,0,0,0,,ТРИДЦАТЬ ШЕСТЬ ПРОЦЕНТОВ. ВОЙНУ НА УКРАИНЕ СЧИТАЮТ
Dialogue: 0,0:12:33.89,0:12:39.94,Caption,,0,0,0,,ВАЖНОЙ ДВЕНАДЦАТЬ ПРОЦЕНТОВ. ЛЕ ПЕН СВЯЗЫВАЕТ ПОМОЩЬ КИЕВУ НЕ С
Dialogue: 0,0:12:39.94,0:12:43.58,Caption,,0,0,0,,ВОЕННЫМИ КАРТАМИ, А С ПОВСЕДНЕВНЫМИ РАСХОДАМИ ФРАНЦУЗОВ.
Dialogue: 0,0:12:43.58,0:12:46.20,Caption,,0,0,0,,ЛЮБОЙ НОВЫЙ МИЛЛИАРД МОЖНО ПЕРЕВЕСТИ В ЦЕНЫ,
Dialogue: 0,0:12:46.29,0:12:50.40,Caption,,0,0,0,,НАЛОГИ И ПЕНСИИ. ТАКОЙ ПЕРЕВОД ВЛАСТЯМ ОПАСНЕЕ ГРОМКОЙ
Dialogue: 0,0:12:50.40,0:12:52.65,Caption,,0,0,0,,РЕЧИ, ПОТОМУ ЧТО ЕГО ПОНИМАЮТ БЕЗ
Dialogue: 0,0:12:52.65,0:12:56.22,Caption,,0,0,0,,ПЕРЕВОДЧИКА. УКРАИНА НЕ ОБЯЗАНА СТАНОВИТЬСЯ ЦЕНТРАЛЬНОЙ ТЕМОЙ
Dialogue: 0,0:12:56.22,0:12:58.36,Caption,,0,0,0,,ФРАНЦУЗСКИХ ВЫБОРОВ. ДОСТАТОЧНО,
Dialogue: 0,0:12:58.52,0:13:00.64,Caption,,0,0,0,,ЧТОБЫ РАСХОДЫ НА НЕЁ НАЧАЛИ СЧИТАТЬ
Dialogue: 0,0:13:00.64,0:13:03.90,Caption,,0,0,0,,ЧАСТЬЮ ПАДЕНИЯ УРОВНЯ ЖИЗНИ. ТОГДА КАЖДЫЙ НОВЫЙ ТРАНШ
Dialogue: 0,0:13:03.90,0:13:06.19,Caption,,0,0,0,,ПРЕВРАТИТСЯ ВО ВНУТРЕННИЙ АРГУМЕНТ ПРОТИВ
Dialogue: 0,0:13:06.19,0:13:09.81,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА. В ГЕРМАНИИ РАЗВИВАЕТСЯ ПОХОЖАЯ ЛОГИКА.
Dialogue: 0,0:13:09.81,0:13:13.13,Caption,,0,0,0,,ПО ПРИВОДИМЫМ ОЦЕНКАМ, СОРОК ДЕВЯТЬ ПРОЦЕНТОВ НЕМЦЕВ
Dialogue: 0,0:13:13.13,0:13:16.14,Caption,,0,0,0,,ВЫСТУПАЮТ ЗА СОКРАЩЕНИЕ ПОМОЩИ УКРАИНЕ ИЛИ ЕЁ
Dialogue: 0,0:13:16.14,0:13:20.04,Caption,,0,0,0,,ПОЛНОЕ ПРЕКРАЩЕНИЕ. СОВЕТ ЭКОНОМИЧЕСКИХ ЭКСПЕРТОВ ОЖИДАЕТ,
Dialogue: 0,0:13:20.28,0:13:23.32,Caption,,0,0,0,,ЧТО РОСТ ГЕРМАНСКОЙ ЭКОНОМИКИ ЗАМЕДЛИТСЯ ДО ОДНОГО
Dialogue: 0,0:13:23.32,0:13:25.17,Caption,,0,0,0,,ПРОЦЕНТА. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:13:25.17,0:13:27.97,Caption,,0,0,0,,СЕДЬМОМ ГОДУ СОСТОЯТСЯ ЗЕМЕЛЬНЫЕ ВЫБОРЫ. ЕСЛИ
Dialogue: 0,0:13:27.97,0:13:30.47,Caption,,0,0,0,,ХРИСТИАНСКО ДЕМОКРАТИЧЕСКИЙ СОЮЗ И СОЦИАЛ
Dialogue: 0,0:13:30.47,0:13:32.52,Caption,,0,0,0,,ДЕМОКРАТЫ СНОВА ПОТЕРЯЮТ ПОДДЕРЖКУ,
Dialogue: 0,0:13:32.80,0:13:34.92,Caption,,0,0,0,,УЧАСТНИКИ КОАЛИЦИИ НАЧНУТ ВЫЯСНЯТЬ,
Dialogue: 0,0:13:35.16,0:13:37.46,Caption,,0,0,0,,КТО ДОВЁЛ ИХ ДО ТАКОГО РЕЗУЛЬТАТА И
Dialogue: 0,0:13:37.46,0:13:39.91,Caption,,0,0,0,,ЧЬИМ КРЕСЛОМ ПОЖЕРТВОВАТЬ. В ОДНОМ ИЗ
Dialogue: 0,0:13:39.91,0:13:42.32,Caption,,0,0,0,,ПРОГНОЗОВ КРИТИЧЕСКИМ ВРЕМЕНЕМ ДЛЯ ФРИДРИХА
Dialogue: 0,0:13:42.32,0:13:45.03,Caption,,0,0,0,,МЕРЦА НАЗЫВАЮТ ЛЕТО ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО
Dialogue: 0,0:13:45.03,0:13:47.34,Caption,,0,0,0,,ГОДА. ПРИ НЕБЛАГОПРИЯТНОМ РАЗВИТИИ СОБЫТИЙ
Dialogue: 0,0:13:47.34,0:13:50.51,Caption,,0,0,0,,КОАЛИЦИЯ МОЖЕТ НЕ ПРОДЕРЖАТЬСЯ ДО КОНЦА ТОГО ЖЕ ГОДА. НО
Dialogue: 0,0:13:50.51,0:13:55.53,Caption,,0,0,0,,ЭТО ЛИШЬ РАСЧЁТ. МЕРЦ ОСТАЁТСЯ КАНЦЛЕРОМ,
Dialogue: 0,0:13:55.68,0:13:57.77,Caption,,0,0,0,,КАК ЛЕ ПЕН ОСТАЁТСЯ ПРЕТЕНДЕНТОМ,
Dialogue: 0,0:13:57.84,0:14:01.25,Caption,,0,0,0,,А НЕ ПРЕЗИДЕНТОМ. СТРОИТЬ УКРАИНСКУЮ СТРАТЕГИЮ НА
Dialogue: 0,0:14:01.25,0:14:04.26,Caption,,0,0,0,,БУДУЩЕЙ ПОБЕДЕ ОДНОГО ПОЛИТИКА И ПОРАЖЕНИИ ДРУГОГО
Dialogue: 0,0:14:04.26,0:14:07.46,Caption,,0,0,0,,РИСКОВАННО. КИЕВ МОЖЕТ ГОДАМИ ЖДАТЬ УДОБНОГО
Dialogue: 0,0:14:07.46,0:14:10.84,Caption,,0,0,0,,СОСТАВА ПРАВИТЕЛЬСТВ, НО ЕВРОПЕЙСКИЙ ИЗБИРАТЕЛЬ ГОЛОСУЕТ НЕ
Dialogue: 0,0:14:10.84,0:14:13.60,Caption,,0,0,0,,ПО УКРАИНСКОМУ РАСПИСАНИЮ. В ВАШИНГТОНЕ РАСЧЁТ
Dialogue: 0,0:14:13.60,0:14:16.65,Caption,,0,0,0,,УСТРОЕН ПОХОЖИМ ОБРАЗОМ. НА БАНКОВОЙ НАДЕЮТСЯ,
Dialogue: 0,0:14:16.86,0:14:18.63,Caption,,0,0,0,,ЧТО ДЕМОКРАТЫ ДОБЬЮТСЯ УСПЕХА НА
Dialogue: 0,0:14:18.63,0:14:22.02,Caption,,0,0,0,,ВЫБОРАХ В КОНГРЕСС. ТОЛЬКО КОНТРОЛЬ НАД КОНГРЕССОМ НЕ
Dialogue: 0,0:14:22.02,0:14:24.93,Caption,,0,0,0,,ВЫСЕЛЯЕТ ДЕЙСТВУЮЩЕГО ПРЕЗИДЕНТА ИЗ БЕЛОГО ДОМА
Dialogue: 0,0:14:24.93,0:14:28.81,Caption,,0,0,0,,И НЕ ОТМЕНЯЕТ ЕГО ПРАВО ВЕТО. ПО ДАННЫМ FINANCIAL TIMES,
Dialogue: 0,0:14:29.13,0:14:31.09,Caption,,0,0,0,,ДЕМОКРАТЫ ОБСУЖДАЮТ ПАКЕТ ВОЕННОЙ
Dialogue: 0,0:14:31.09,0:14:34.05,Caption,,0,0,0,,ПОМОЩИ УКРАИНЕ ПРИМЕРНО НА ПЯТНАДЦАТЬ МИЛЛИАРДОВ
Dialogue: 0,0:14:34.05,0:14:37.02,Caption,,0,0,0,,ДОЛЛАРОВ. НО ПЕРЕД ВЫБОРАМИ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО
Dialogue: 0,0:14:37.02,0:14:39.18,Caption,,0,0,0,,ГОДА ИМ ПРИДЁТСЯ РАЗГОВАРИВАТЬ С АМЕРИКАНЦАМИ
Dialogue: 0,0:14:39.18,0:14:42.17,Caption,,0,0,0,,НЕ ТОЛЬКО ОБ УКРАИНЕ. ИЗБИРАТЕЛИ СПРОСЯТ О ЦЕНАХ,
Dialogue: 0,0:14:42.41,0:14:44.40,Caption,,0,0,0,,МЕДИЦИНСКИХ СТРАХОВКАХ И РАСХОДАХ
Dialogue: 0,0:14:44.40,0:14:47.40,Caption,,0,0,0,,СВОИХ СЕМЕЙ. ПОРАЖЕНИЕ ДЕМОКРАТОВ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:14:47.40,0:14:49.53,Caption,,0,0,0,,ДВАДЦАТЬ ЧЕТВЁРТОМ ГОДУ УЖЕ ПОКАЗАЛО,
Dialogue: 0,0:14:49.77,0:14:52.17,Caption,,0,0,0,,ЧТО МЕЖДУНАРОДНЫЕ ОБЕЩАНИЯ НЕ ЗАМЕНЯЮТ
Dialogue: 0,0:14:52.17,0:14:55.16,Caption,,0,0,0,,ОТВЕТОВ НА ВНУТРЕННИЕ ВОПРОСЫ. ПОЭТОМУ ВАШИНГТОН
Dialogue: 0,0:14:55.16,0:14:57.69,Caption,,0,0,0,,МОЖЕТ ВЫДАТЬ КИЕВУ ОТДЕЛЬНЫЙ ВОЕННЫЙ ПАКЕТ,
Dialogue: 0,0:14:58.01,0:15:00.12,Caption,,0,0,0,,А ОСНОВНУЮ ФИНАНСОВУЮ ТЯЖЕСТЬ СНОВА
Dialogue: 0,0:15:00.12,0:15:03.03,Caption,,0,0,0,,ПРЕДЛОЖИТЬ ЕВРОПЕ. ЗА ОКЕАНОМ ПОМОГУТ ЧАСТЬЮ
Dialogue: 0,0:15:03.03,0:15:05.93,Caption,,0,0,0,,ДЕНЕГ, А СЧЁТ ОСТАВЯТ НА ЕВРОПЕЙСКОМ СТОЛЕ.
Dialogue: 0,0:15:08.22,0:15:09.96,Caption,,0,0,0,,В ИТОГЕ СКЛАДЫВАЕТСЯ ВЫРАЗИТЕЛЬНАЯ
Dialogue: 0,0:15:09.96,0:15:13.53,Caption,,0,0,0,,КАРТИНА. СОЕДИНЁННЫЕ ШТАТЫ ВЫДЕЛЯЮТ ОДИН ПАКЕТ.
Dialogue: 0,0:15:13.53,0:15:16.11,Caption,,0,0,0,,ФРАНЦИЯ ЗАКРЫВАЕТ СТАРЫЕ ОБЯЗАТЕЛЬСТВА И НЕ
Dialogue: 0,0:15:16.11,0:15:19.45,Caption,,0,0,0,,ОБЕЩАЕТ НОВЫХ. ГЕРМАНИЯ ПОГРУЖАЕТСЯ В БОРЬБУ ЗА
Dialogue: 0,0:15:19.45,0:15:22.65,Caption,,0,0,0,,ВЛАСТЬ. ПОЛЬША ЗАЩИЩАЕТ ФЕРМЕРОВ И ПЕРЕВОЗЧИКОВ.
Dialogue: 0,0:15:22.65,0:15:26.11,Caption,,0,0,0,,ВЕНГРИЯ ПОЛУЧАЕТ УСТУПКИ. ЧЕХИЯ ОТКАЗЫВАЕТСЯ ОПЛАЧИВАТЬ
Dialogue: 0,0:15:26.11,0:15:27.93,Caption,,0,0,0,,СТО МИЛЛИАРДОВ ИЗ ОБЩЕГО БЮДЖЕТА.
Dialogue: 0,0:15:27.93,0:15:31.28,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ВАЛЮТНЫЙ ФОНД ТРЕБУЕТ ТАРИФНЫХ РЕШЕНИЙ. А
Dialogue: 0,0:15:31.28,0:15:34.66,Caption,,0,0,0,,УКРАИНСКОМУ СОЛДАТУ ВСЁ ЕЩЁ ПОКАЗЫВАЮТ ЧЛЕНСТВО В
Dialogue: 0,0:15:34.66,0:15:37.40,Caption,,0,0,0,,ЕВРОСОЮЗЕ. ТОЛЬКО ЧЕЛОВЕК НЕ ЯВЛЯЕТСЯ БЕСКОНЕЧНОЙ
Dialogue: 0,0:15:37.40,0:15:39.82,Caption,,0,0,0,,СТРОКОЙ БЮДЖЕТА. ДЕНЬГИ МОЖНО ЗАНЯТЬ,
Dialogue: 0,0:15:39.97,0:15:42.54,Caption,,0,0,0,,НАПЕЧАТАТЬ, ПЕРЕБРОСИТЬ МЕЖДУ ПРОГРАММАМИ,
Dialogue: 0,0:15:42.62,0:15:47.43,Caption,,0,0,0,,НАЗВАТЬ ГАРАНТИЕЙ, ФОНДОМ, КРЕДИТОМ ИЛИ БЕЗВОЗВРАТНОЙ ПОДДЕРЖКОЙ.
Dialogue: 0,0:15:47.43,0:15:50.81,Caption,,0,0,0,,СТАРУЮ СУММУ МОЖНО УПАКОВАТЬ В НОВУЮ КОРОБКУ И ЕЩЁ
Dialogue: 0,0:15:50.81,0:15:53.26,Caption,,0,0,0,,РАЗ ТОРЖЕСТВЕННО ВРУЧИТЬ. С ЧЕЛОВЕКОМ ЭТОТ
Dialogue: 0,0:15:53.26,0:15:56.04,Caption,,0,0,0,,НОМЕР НЕ ПРОХОДИТ. ИСЧЕЗНУВШЕГО СОЛДАТА НЕЛЬЗЯ
Dialogue: 0,0:15:56.04,0:15:58.94,Caption,,0,0,0,,ПЕРЕИМЕНОВАТЬ В НОВЫЙ МЕХАНИЗМ ФИНАНСИРОВАНИЯ.
Dialogue: 0,0:15:58.94,0:16:02.16,Caption,,0,0,0,,УЕХАВШУЮ СЕМЬЮ НЕ ВЕРНЁШЬ СМЕНОЙ НАЗВАНИЯ ПРОГРАММЫ.
Dialogue: 0,0:16:02.16,0:16:05.04,Caption,,0,0,0,,ДЕМОГРАФИЧЕСКУЮ ЯМУ НЕ ЗАКРОЕШЬ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:16:05.04,0:16:08.45,Caption,,0,0,0,,РЕЗОЛЮЦИЕЙ. ЕСЛИ ПРОГНОЗ О КРИТИЧЕСКОМ ИСТОЩЕНИИ ЛЮДСКОГО
Dialogue: 0,0:16:08.45,0:16:11.00,Caption,,0,0,0,,РЕСУРСА К ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМУ ГОДУ ХОТЯ БЫ
Dialogue: 0,0:16:11.00,0:16:14.56,Caption,,0,0,0,,ЧАСТИЧНО СБУДЕТСЯ, ВСЕ ОБЕЩАНИЯ О БУДУЩЕМ УПРУТСЯ В САМЫЙ
Dialogue: 0,0:16:14.56,0:16:17.18,Caption,,0,0,0,,ПРОСТОЙ ВОПРОС. КТО ИМЕННО ДОЛЖЕН ДО НЕГО
Dialogue: 0,0:16:17.18,0:16:21.12,Caption,,0,0,0,,ДОЖИТЬ? НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:16:21.28,0:16:24.81,Caption,,0,0,0,,КАК ВЫ СЧИТАЕТЕ, УКРАИНА ДЕЙСТВИТЕЛЬНО ПРИБЛИЖАЕТСЯ К
Dialogue: 0,0:16:24.81,0:16:28.04,Caption,,0,0,0,,ЕВРОСОЮЗУ ИЛИ ЕЙ КАЖДЫЙ РАЗ ПОКАЗЫВАЮТ СЛЕДУЮЩУЮ
Dialogue: 0,0:16:28.04,0:16:30.00,Caption,,0,0,0,,ДВЕРЬ В ТОМ ЖЕ БЕСКОНЕЧНОМ КОРИДОРЕ?
