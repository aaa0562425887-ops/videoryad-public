Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,МУЖЧИНА ЕЩЁ НЕ УСПЕЛ ОФОРМИТЬ ПОСТОЯННОЕ ПРОЖИВАНИЕ
Dialogue: 0,0:00:02.92,0:00:06.11,Caption,,0,0,0,,ЗА ГРАНИЦЕЙ, А УКРАИНСКОЕ МИНИСТЕРСТВО ОБОРОНЫ УЖЕ
Dialogue: 0,0:00:06.11,0:00:08.52,Caption,,0,0,0,,ХОЧЕТ ПОЛУЧИТЬ ЕГО ДАННЫЕ И ФОТОГРАФИЮ.
Dialogue: 0,0:00:09.16,0:00:11.40,Caption,,0,0,0,,МИГРАЦИОННАЯ СЛУЖБА ТЕПЕРЬ, ПОХОЖЕ,
Dialogue: 0,0:00:11.72,0:00:13.48,Caption,,0,0,0,,РАБОТАЕТ НЕ ТОЛЬКО С ПАСПОРТАМИ,
Dialogue: 0,0:00:13.74,0:00:16.18,Caption,,0,0,0,,НО И ПОСТАВЛЯЕТ ВОЕННЫМ СВЕЖИЙ СПИСОК
Dialogue: 0,0:00:16.18,0:00:17.99,Caption,,0,0,0,,ТЕХ, КТО СОБИРАЛСЯ ИСЧЕЗНУТЬ С
Dialogue: 0,0:00:17.99,0:00:22.24,Caption,,0,0,0,,ГОСУДАРСТВЕННОГО РАДАРА. ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. ЗАЧЕМ АРМИИ
Dialogue: 0,0:00:22.24,0:00:24.75,Caption,,0,0,0,,ЛЮДИ, КОТОРЫЕ ГОТОВЯТ ДОКУМЕНТЫ ДЛЯ ЖИЗНИ В
Dialogue: 0,0:00:24.75,0:00:27.91,Caption,,0,0,0,,ДРУГОЙ СТРАНЕ? СНАЧАЛА СООБЩАЛОСЬ О МУЖЧИНАХ ОТ
Dialogue: 0,0:00:27.91,0:00:30.95,Caption,,0,0,0,,ВОСЕМНАДЦАТИ ДО ШЕСТИДЕСЯТИ ЛЕТ. В ПОСТАНОВЛЕНИИ
Dialogue: 0,0:00:30.95,0:00:33.16,Caption,,0,0,0,,НИЖНЯЯ ГРАНИЦА ОКАЗАЛАСЬ ЕЩЁ НИЖЕ,
Dialogue: 0,0:00:33.30,0:00:36.86,Caption,,0,0,0,,ОТ СЕМНАДЦАТИ. ОФИЦИАЛЬНО БАЗЫ ПРИВОДЯТ В ПОРЯДОК И
Dialogue: 0,0:00:36.86,0:00:39.65,Caption,,0,0,0,,УСТРАНЯЮТ ОШИБКИ. ТОЛЬКО ПРИ НЫНЕШНЕЙ НЕХВАТКЕ
Dialogue: 0,0:00:39.65,0:00:42.23,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ ТАКОЙ ПОРЯДОК ПРИОБРЕТАЕТ ВПОЛНЕ
Dialogue: 0,0:00:42.23,0:00:44.96,Caption,,0,0,0,,ПРИКЛАДНОЕ НАЗНАЧЕНИЕ. ЧЕМ ТОЧНЕЕ ГОСУДАРСТВО
Dialogue: 0,0:00:44.96,0:00:48.40,Caption,,0,0,0,,ВИДИТ КАЖДОГО МУЖЧИНУ, ТЕМ МЕНЬШЕ У НЕГО ШАНСОВ ЗАТЕРЯТЬСЯ
Dialogue: 0,0:00:48.40,0:00:50.87,Caption,,0,0,0,,МЕЖДУ РАЗНЫМИ ВЕДОМСТВАМИ. ПОЛУЧАЕТСЯ НОВАЯ
Dialogue: 0,0:00:50.87,0:00:53.96,Caption,,0,0,0,,ГОСУДАРСТВЕННАЯ УСЛУГА. ВАС АККУРАТНО НАЙДУТ,
Dialogue: 0,0:00:54.21,0:00:56.36,Caption,,0,0,0,,ПРАВИЛЬНО ИДЕНТИФИЦИРУЮТ И ПРОСЛЕДЯТ,
Dialogue: 0,0:00:56.60,0:00:58.85,Caption,,0,0,0,,ЧТОБЫ ЦЕННЫЙ МОБИЛИЗАЦИОННЫЙ РЕСУРС НЕ
Dialogue: 0,0:00:58.85,0:01:01.56,Caption,,0,0,0,,ВЫПАЛ ИЗ ОТЧЁТНОСТИ. ЕСЛИ ГОВОРИТЬ ПРОЩЕ,
Dialogue: 0,0:01:01.80,0:01:03.80,Caption,,0,0,0,,ВЛАСТЬ СОБИРАЕТСЯ ЗНАТЬ ОБО ВСЕХ,
Dialogue: 0,0:01:04.00,0:01:06.23,Caption,,0,0,0,,КОГО ЕЩЁ МОЖНО БУСИФИЦИРОВАТЬ. ДАЖЕ
Dialogue: 0,0:01:06.23,0:01:09.08,Caption,,0,0,0,,ЕСЛИ ЧЕЛОВЕК УЖЕ ОДНОЙ НОГОЙ В ДРУГОЙ СТРАНЕ,
Dialogue: 0,0:01:09.25,0:01:11.26,Caption,,0,0,0,,ВТОРУЮ НОГУ РЕШИЛИ НА ВСЯКИЙ СЛУЧАЙ
Dialogue: 0,0:01:11.26,0:01:16.74,Caption,,0,0,0,,ВНЕСТИ В РЕЕСТР. ЕСЛИ ВАМ НРАВИТСЯ РАЗБОР БЕЗ СКУЧНОГО
Dialogue: 0,0:01:16.74,0:01:20.19,Caption,,0,0,0,,ПЕРЕЧИСЛЕНИЯ ЗАЯВЛЕНИЙ, ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ ИНТЕРЕСНЕЕ
Dialogue: 0,0:01:20.19,0:01:22.25,Caption,,0,0,0,,СМОТРЕТЬ НЕ НА ОТДЕЛЬНУЮ БУМАГУ,
Dialogue: 0,0:01:22.48,0:01:25.93,Caption,,0,0,0,,А НА ТО, ЗАЧЕМ ОНА ПОНАДОБИЛАСЬ ИМЕННО СЕЙЧАС.
Dialogue: 0,0:01:26.53,0:01:28.48,Caption,,0,0,0,,ПОЧТИ ОДНОВРЕМЕННО ДЕПУТАТ АЛЕКСЕЙ
Dialogue: 0,0:01:28.48,0:01:30.94,Caption,,0,0,0,,ГОНЧАРЕНКО СООБЩИЛ О РЕГУЛЯРНЫХ ОБСУЖДЕНИЯХ В
Dialogue: 0,0:01:30.94,0:01:34.59,Caption,,0,0,0,,МИНИСТЕРСТВЕ ЭКОНОМИКИ. ТАМ ИЩУТ ВОЗМОЖНОСТЬ ЛИШИТЬ
Dialogue: 0,0:01:34.59,0:01:37.81,Caption,,0,0,0,,БРОНИ ОТ СТА ДО ТРЁХСОТ ТЫСЯЧ МУЖЧИН. ПО ЕГО
Dialogue: 0,0:01:37.81,0:01:40.88,Caption,,0,0,0,,СЛОВАМ, МИНИСТР ЭКОНОМИКИ КРАВЧЕНКО НАЗВАЛ ЭТУ
Dialogue: 0,0:01:40.88,0:01:44.16,Caption,,0,0,0,,ЗАДАЧУ ОДНОЙ ИЗ ПРИОРИТЕТНЫХ. ВЕЛИКОЛЕПНАЯ ЗАБОТА О
Dialogue: 0,0:01:44.16,0:01:47.55,Caption,,0,0,0,,ХОЗЯЙСТВЕ. ВЕДОМСТВО, КОТОРОЕ ДОЛЖНО ПОДДЕРЖИВАТЬ
Dialogue: 0,0:01:47.55,0:01:51.34,Caption,,0,0,0,,ПРЕДПРИЯТИЯ, ОБСУЖДАЕТ, КАК ЗАБРАТЬ У НИХ СОТНИ ТЫСЯЧ
Dialogue: 0,0:01:51.34,0:01:55.25,Caption,,0,0,0,,РАБОТНИКОВ. КРИТИЧЕСКИ ВАЖНЫМ КОМПАНИЯМ РАЗРЕШИЛИ БРОНИРОВАТЬ
Dialogue: 0,0:01:55.25,0:01:58.74,Caption,,0,0,0,,ПЕРСОНАЛ ИМЕННО ПОТОМУ, ЧТО БЕЗ СПЕЦИАЛИСТОВ ПРОИЗВОДСТВО
Dialogue: 0,0:01:58.74,0:02:01.60,Caption,,0,0,0,,ОСТАНАВЛИВАЕТСЯ. ТЕПЕРЬ ТЕМ ЖЕ КОМПАНИЯМ МОГУТ
Dialogue: 0,0:02:01.60,0:02:04.01,Caption,,0,0,0,,СООБЩИТЬ, ЧТО СПЕЦИАЛИСТЫ БЫЛИ ВАЖНЫМИ,
Dialogue: 0,0:02:04.17,0:02:06.65,Caption,,0,0,0,,НО АРМИЯ ОКАЗАЛАСЬ ВАЖНЕЕ. ЭКОНОМИКЕ
Dialogue: 0,0:02:06.65,0:02:09.46,Caption,,0,0,0,,ОСТАНЕТСЯ БОДРО КИВНУТЬ И ПРОДОЛЖИТЬ РАБОТАТЬ
Dialogue: 0,0:02:09.46,0:02:12.98,Caption,,0,0,0,,ОТСУТСТВУЮЩИМИ РУКАМИ. ЧЕЛОВЕКА ОКОНЧАТЕЛЬНО ПРЕВРАТИЛИ В
Dialogue: 0,0:02:12.98,0:02:15.61,Caption,,0,0,0,,ЕДИНИЦУ УЧЁТА. СЕЙЧАС ОН НУЖЕН У СТАНКА,
Dialogue: 0,0:02:15.85,0:02:19.37,Caption,,0,0,0,,ПОТОМ В ПОДРАЗДЕЛЕНИИ, ЗАТЕМ СНОВА ПОНАДОБИТСЯ НАЛОГОВОЙ.
Dialogue: 0,0:02:19.37,0:02:22.53,Caption,,0,0,0,,УНИВЕРСАЛЬНЫЙ РЕСУРС, ТОЛЬКО ЗАПАСНЫХ ДЕТАЛЕЙ К НЕМУ НЕ
Dialogue: 0,0:02:22.53,0:02:25.34,Caption,,0,0,0,,ВЫПУСКАЮТ. ПЕРЕСМОТР УЖЕ КАСАЕТСЯ ДЕЙСТВУЮЩИХ
Dialogue: 0,0:02:25.34,0:02:28.73,Caption,,0,0,0,,ОТСРОЧЕК И БРОНИРОВАНИЙ, ВКЛЮЧАЯ СОТРУДНИКОВ ПРЕДПРИЯТИЙ,
Dialogue: 0,0:02:28.96,0:02:30.65,Caption,,0,0,0,,ОТ КОТОРЫХ ЗАВИСИТ РАБОТА СТРАНЫ.
Dialogue: 0,0:02:32.94,0:02:34.95,Caption,,0,0,0,,ПРЕЖНЕЕ ПРАВИЛО ПОСТЕПЕННО ТЕРЯЕТ
Dialogue: 0,0:02:34.95,0:02:37.38,Caption,,0,0,0,,СИЛУ. СТРАТЕГИЧЕСКАЯ ДОЛЖНОСТЬ БОЛЬШЕ НЕ
Dialogue: 0,0:02:37.38,0:02:40.20,Caption,,0,0,0,,ГАРАНТИРУЕТ ЧЕЛОВЕКУ ЗАЩИТЫ ОТ МОБИЛИЗАЦИИ.
Dialogue: 0,0:02:40.20,0:02:43.50,Caption,,0,0,0,,ДОКУМЕНТ ОСТАЁТСЯ, А УВЕРЕННОСТЬ В НЁМ ИСПАРЯЕТСЯ
Dialogue: 0,0:02:43.50,0:02:46.06,Caption,,0,0,0,,БЫСТРЕЕ, ЧЕМ ПОДПИСЬ УСПЕВАЕТ ВЫСОХНУТЬ.
Dialogue: 0,0:02:46.06,0:02:49.72,Caption,,0,0,0,,ПРЕДПРИЯТИЮ ПРИ ЭТОМ ВЫДАЮТ ЗАМЕЧАТЕЛЬНОЕ ПОРУЧЕНИЕ. ОНО
Dialogue: 0,0:02:49.72,0:02:52.06,Caption,,0,0,0,,ОБЯЗАНО ПРОИЗВОДИТЬ, РЕМОНТИРОВАТЬ,
Dialogue: 0,0:02:52.21,0:02:54.83,Caption,,0,0,0,,ПЛАТИТЬ НАЛОГИ И УДЕРЖИВАТЬ ЭКОНОМИКУ.
Dialogue: 0,0:02:54.83,0:02:57.87,Caption,,0,0,0,,ОДНОВРЕМЕННО ЕМУ ПРЕДЛАГАЮТ ОТДАТЬ РАБОТНИКОВ И
Dialogue: 0,0:02:57.87,0:03:00.94,Caption,,0,0,0,,САМОСТОЯТЕЛЬНО РЕШИТЬ, БЕЗ КАКОГО ИНЖЕНЕРА,
Dialogue: 0,0:03:01.09,0:03:03.68,Caption,,0,0,0,,ЭНЕРГЕТИКА ИЛИ МЕХАНИКА ОНО РАЗВАЛИТСЯ
Dialogue: 0,0:03:03.68,0:03:08.18,Caption,,0,0,0,,НЕ СРАЗУ, А НЕМНОГО ПОЗЖЕ. НЕХВАТКА ЛЮДЕЙ УЖЕ ОДНОВРЕМЕННО
Dialogue: 0,0:03:08.18,0:03:11.34,Caption,,0,0,0,,КАСАЕТСЯ ФРОНТА И ТЫЛА. СКОРО МОЖЕТ ОКАЗАТЬСЯ,
Dialogue: 0,0:03:11.50,0:03:14.22,Caption,,0,0,0,,ЧТО ВОЕВАТЬ БУДЕТ НЕЧЕМ, ТОЧНЕЕ НЕКЕМ,
Dialogue: 0,0:03:14.52,0:03:16.70,Caption,,0,0,0,,А ТЫЛ НАЧНЁТ РАЗВАЛИВАТЬСЯ БЕЗ РУК,
Dialogue: 0,0:03:16.86,0:03:19.39,Caption,,0,0,0,,КОТОРЫЕ ЕГО ДЕРЖАТ. НОВЫЕ РАСПОРЯЖЕНИЯ
Dialogue: 0,0:03:19.39,0:03:23.03,Caption,,0,0,0,,ЛИШЬ ПОКАЗЫВАЮТ, НАСКОЛЬКО СУЗИЛСЯ ВЫБОР. ОДИН ЧЕЛОВЕК
Dialogue: 0,0:03:23.03,0:03:25.50,Caption,,0,0,0,,ТРЕБУЕТСЯ АРМИИ, ПРОИЗВОДСТВУ,
Dialogue: 0,0:03:25.58,0:03:28.54,Caption,,0,0,0,,ЭНЕРГЕТИКЕ, ТРАНСПОРТУ И СОБСТВЕННОЙ СЕМЬЕ.
Dialogue: 0,0:03:29.09,0:03:31.03,Caption,,0,0,0,,РАЗМНОЖИТЬСЯ ПО ТРЕБОВАНИЮ КАБМИНА ОН
Dialogue: 0,0:03:31.03,0:03:34.19,Caption,,0,0,0,,ПОЧЕМУ ТО НЕ УМЕЕТ. ДАВЛЕНИЕ ДАВНО ВЫШЛО ЗА ПРЕДЕЛЫ
Dialogue: 0,0:03:34.19,0:03:38.77,Caption,,0,0,0,,ТЕХ, У КОГО НЕТ НИ ОТСРОЧКИ, НИ ВАЖНОЙ РАБОТЫ. ПРЕДСТАВИТЕЛИ ТЦК
Dialogue: 0,0:03:38.77,0:03:41.02,Caption,,0,0,0,,ЗАДЕРЖИВАЛИ СОТРУДНИКОВ ПРЕДПРИЯТИЙ,
Dialogue: 0,0:03:41.17,0:03:43.09,Caption,,0,0,0,,ПОСТРАДАВШИХ ПОСЛЕ УДАРОВ. ПОД
Dialogue: 0,0:03:43.09,0:03:46.73,Caption,,0,0,0,,МОБИЛИЗАЦИОННЫЕ МЕРЫ ПОПАДАЮТ СТУДЕНТЫ. В ЗАКАРПАТЬЕ ОДНОГО
Dialogue: 0,0:03:46.73,0:03:48.59,Caption,,0,0,0,,ИЗ НИХ УДАЛОСЬ ОСВОБОДИТЬ ЛИШЬ ПОСЛЕ
Dialogue: 0,0:03:48.59,0:03:50.38,Caption,,0,0,0,,ВМЕШАТЕЛЬСТВА ЖУРНАЛИСТОВ И СУДА.
Dialogue: 0,0:03:52.66,0:03:55.38,Caption,,0,0,0,,ГРАНИЦЫ, КОТОРЫЕ ПРЕЖДЕ СЧИТАЛИСЬ ПОНЯТНЫМИ,
Dialogue: 0,0:03:55.54,0:03:59.46,Caption,,0,0,0,,ТЕПЕРЬ СДВИГАЮТСЯ ВСЯКИЙ РАЗ, КОГДА ТРЕБУЕТСЯ НОВАЯ ПАРТИЯ ЛЮДЕЙ.
Dialogue: 0,0:04:00.18,0:04:01.90,Caption,,0,0,0,,РЯДОМ ВЫРОС И СВОЙ ПРЕЙСКУРАНТ
Dialogue: 0,0:04:01.90,0:04:04.79,Caption,,0,0,0,,СПАСЕНИЯ. ПО СООБЩЕНИЯМ О НЕОФИЦИАЛЬНЫХ
Dialogue: 0,0:04:04.79,0:04:07.57,Caption,,0,0,0,,РАСЦЕНКАХ, РЕШИТЬ ПРОБЛЕМУ НЕПОСРЕДСТВЕННО НА
Dialogue: 0,0:04:07.57,0:04:10.26,Caption,,0,0,0,,МЕСТЕ МОЖНО ПРИМЕРНО ЗА ТРИ ТЫСЯЧИ ДОЛЛАРОВ.
Dialogue: 0,0:04:10.90,0:04:13.14,Caption,,0,0,0,,ПОЛНОЦЕННАЯ БРОНЬ НАЧИНАЕТСЯ ОТ
Dialogue: 0,0:04:13.14,0:04:16.18,Caption,,0,0,0,,ДВАДЦАТИ ТЫСЯЧ. ЕСЛИ СУММЫ БЛИЗКИ К ДЕЙСТВИТЕЛЬНОСТИ,
Dialogue: 0,0:04:16.50,0:04:18.92,Caption,,0,0,0,,РАВЕНСТВО ВЫГЛЯДИТ ПРЕДЕЛЬНО НАГЛЯДНО.
Dialogue: 0,0:04:18.92,0:04:21.59,Caption,,0,0,0,,ОДНОГО ПРИКРЫВАЕТ ЗАКОННЫЙ ДОКУМЕНТ. ВТОРОГО
Dialogue: 0,0:04:21.59,0:04:24.36,Caption,,0,0,0,,СПАСАЕТ ТОЛСТЫЙ КОШЕЛЁК. ТРЕТЬЕГО ВЫТАСКИВАЕТ
Dialogue: 0,0:04:24.36,0:04:26.65,Caption,,0,0,0,,НУЖНЫЙ ЗНАКОМЫЙ. ЧЕТВЁРТОМУ ОСТАЁТСЯ
Dialogue: 0,0:04:26.65,0:04:29.92,Caption,,0,0,0,,НАДЕЯТЬСЯ, ЧТО МИКРОАВТОБУС ПРОЕДЕТ МИМО. ОЧЕНЬ
Dialogue: 0,0:04:29.92,0:04:32.50,Caption,,0,0,0,,СПРАВЕДЛИВАЯ СИСТЕМА, ОСОБЕННО ДЛЯ ТЕХ,
Dialogue: 0,0:04:32.66,0:04:34.86,Caption,,0,0,0,,У КОГО НЕТ ЛИШНИХ ДВАДЦАТИ ТЫСЯЧ.
Dialogue: 0,0:04:34.86,0:04:37.84,Caption,,0,0,0,,МОБИЛИЗАЦИОННЫЙ ПОРЯДОК ВСЁ ЗАМЕТНЕЕ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:04:37.84,0:04:40.47,Caption,,0,0,0,,РЫНОК, ГДЕ ПРОДАЁТСЯ ВОЗМОЖНОСТЬ НЕ СТАТЬ
Dialogue: 0,0:04:40.47,0:04:43.70,Caption,,0,0,0,,СЛЕДУЮЩИМ. ОБЯЗАННОСТЬ, УСТАНОВЛЕННАЯ ЗАКОНОМ,
Dialogue: 0,0:04:44.01,0:04:46.10,Caption,,0,0,0,,МЕНЯЕТСЯ НА ПРИНУДИТЕЛЬНОЕ ИЗЪЯТИЕ
Dialogue: 0,0:04:46.10,0:04:49.59,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКОГО РЕСУРСА. ОТСЮДА СЛЕДУЕТ САМЫЙ ЖЁСТКИЙ
Dialogue: 0,0:04:49.59,0:04:52.92,Caption,,0,0,0,,ВЫВОД. ЕДИНСТВЕННЫЙ СПОСОБ ВЫЖИТЬ ЗАКЛЮЧАЕТСЯ
Dialogue: 0,0:04:52.92,0:04:55.79,Caption,,0,0,0,,В ТОМ, ЧТОБЫ УЕХАТЬ ИЗ УКРАИНЫ КАК МОЖНО
Dialogue: 0,0:04:55.79,0:04:58.58,Caption,,0,0,0,,СКОРЕЕ, ПОКА ВЫЕЗД ВООБЩЕ ОСТАЁТСЯ ВОЗМОЖНЫМ.
Dialogue: 0,0:04:59.27,0:05:01.50,Caption,,0,0,0,,В ИНФОРМАЦИОННОМ ПОЛЕ ПРИ ЭТОМ ЗВУЧАТ
Dialogue: 0,0:05:01.50,0:05:04.52,Caption,,0,0,0,,ОЦЕНКИ ПОТЕРЬ, ПРЕВЫШАЮЩИХ ТРИДЦАТЬ ПЯТЬ ТЫСЯЧ
Dialogue: 0,0:05:04.52,0:05:06.90,Caption,,0,0,0,,ЧЕЛОВЕК ЕЖЕМЕСЯЧНО. ЭТО ОЦЕНКА,
Dialogue: 0,0:05:07.06,0:05:12.55,Caption,,0,0,0,,А НЕ ОФИЦИАЛЬНАЯ ЦИФРА. НО САМ МАСШТАБ ТАКИХ РАЗГОВОРОВ
Dialogue: 0,0:05:12.55,0:05:15.38,Caption,,0,0,0,,ОБЪЯСНЯЕТ, ПОЧЕМУ ГОСУДАРСТВО ТАК СТАРАТЕЛЬНО
Dialogue: 0,0:05:15.38,0:05:19.52,Caption,,0,0,0,,ЗАГЛЯДЫВАЕТ В РЕЕСТРЫ, БРОНИ И МИГРАЦИОННЫЕ БАЗЫ. КРЕДИТ
Dialogue: 0,0:05:19.52,0:05:23.26,Caption,,0,0,0,,МОЖНО ОФОРМИТЬ. СНАРЯДЫ МОЖНО ЗАКАЗАТЬ. МАШИНЫ МОЖНО
Dialogue: 0,0:05:23.26,0:05:25.85,Caption,,0,0,0,,ПОЛУЧИТЬ ОТ ПАРТНЁРОВ. ПОГИБШЕГО ЧЕЛОВЕКА
Dialogue: 0,0:05:25.85,0:05:28.91,Caption,,0,0,0,,НЕВОЗМОЖНО ВЕРНУТЬ РАСПОРЯЖЕНИЕМ И СНОВА ПОСТАВИТЬ
Dialogue: 0,0:05:28.91,0:05:32.80,Caption,,0,0,0,,НАПРОТИВ ЕГО ФАМИЛИИ ОТМЕТКУ ГОДЕН. ПОЭТОМУ ОСОБОЕ ВНИМАНИЕ
Dialogue: 0,0:05:32.80,0:05:35.77,Caption,,0,0,0,,К МУЖЧИНАМ, ОФОРМЛЯЮЩИМ ПОСТОЯННОЕ ПРОЖИВАНИЕ ЗА
Dialogue: 0,0:05:35.77,0:05:38.66,Caption,,0,0,0,,РУБЕЖОМ, ВЫГЛЯДИТ ВПОЛНЕ ЛОГИЧНО. ГОСУДАРСТВО
Dialogue: 0,0:05:38.66,0:05:41.89,Caption,,0,0,0,,СОБИРАЕТ ИХ АДРЕСА, ДОКУМЕНТЫ И ФОТОГРАФИИ,
Dialogue: 0,0:05:42.12,0:05:44.11,Caption,,0,0,0,,ХОТЯ ОНИ ГОТОВЯТСЯ СТРОИТЬ ЖИЗНЬ УЖЕ
Dialogue: 0,0:05:44.11,0:05:47.44,Caption,,0,0,0,,ЗА ПРЕДЕЛАМИ СТРАНЫ. ТАКАЯ ПРОВЕРКА САМА ПО СЕБЕ НЕ
Dialogue: 0,0:05:47.44,0:05:50.48,Caption,,0,0,0,,ОЗНАЧАЕТ НЕМЕДЛЕННОГО РАЗВОРОТА НА ГРАНИЦЕ И ОТПРАВКИ В
Dialogue: 0,0:05:50.48,0:05:53.55,Caption,,0,0,0,,ЧАСТЬ. ОДНАКО ЕЁ ПРАКТИЧЕСКИЙ СМЫСЛ ПОНЯТЕН. ВЛАСТЬ
Dialogue: 0,0:05:53.55,0:05:57.18,Caption,,0,0,0,,ХОЧЕТ ВИДЕТЬ ДАЖЕ ТЕХ, КТО НАМЕРЕВАЛСЯ ВЫЙТИ ИЗ ЕЁ ПОЛЯ
Dialogue: 0,0:05:57.18,0:06:00.29,Caption,,0,0,0,,ДОСЯГАЕМОСТИ. СЛЕДОМ ВОЗНИКАЕТ ВОПРОС ОБ УКРАИНСКИХ
Dialogue: 0,0:06:00.29,0:06:02.37,Caption,,0,0,0,,МУЖЧИНАХ, УЖЕ НАХОДЯЩИХСЯ В ЕВРОПЕ.
Dialogue: 0,0:06:03.01,0:06:04.45,Caption,,0,0,0,,ЕСЛИ ЕВРОПЕЙСКИЕ ПРАВИТЕЛЬСТВА
Dialogue: 0,0:06:04.45,0:06:06.37,Caption,,0,0,0,,РАССЧИТЫВАЮТ НА ПРОДОЛЖЕНИЕ ВОЙНЫ,
Dialogue: 0,0:06:06.70,0:06:08.69,Caption,,0,0,0,,ТЕМА ИХ ВОЗВРАЩЕНИЯ БУДЕТ ЗВУЧАТЬ ВСЁ
Dialogue: 0,0:06:08.69,0:06:11.97,Caption,,0,0,0,,НАСТОЙЧИВЕЕ. СНАЧАЛА ВЕЖЛИВО, ЗАТЕМ ПРЕДМЕТНО,
Dialogue: 0,0:06:12.21,0:06:13.96,Caption,,0,0,0,,А ПОТОМ ВЕЖЛИВОСТЬ МОГУТ ОСТАВИТЬ ДЛЯ
Dialogue: 0,0:06:13.96,0:06:16.45,Caption,,0,0,0,,ПРОТОКОЛЬНОЙ ФОТОГРАФИИ. ПОДПИСЫВАЙТЕСЬ,
Dialogue: 0,0:06:16.66,0:06:19.97,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ЗАРАНЕЕ ПОНИМАТЬ, К ЧЕМУ ВЕДУТ РЕШЕНИЯ,
Dialogue: 0,0:06:20.13,0:06:22.35,Caption,,0,0,0,,КОТОРЫЕ ПОКА ВЫГЛЯДЯТ ОБЫЧНОЙ СВЕРКОЙ
Dialogue: 0,0:06:22.35,0:06:26.95,Caption,,0,0,0,,ДАННЫХ. САМЫЕ НЕПРИЯТНЫЕ ПОСЛЕДСТВИЯ ЧАСТО
Dialogue: 0,0:06:26.95,0:06:29.93,Caption,,0,0,0,,НАЧИНАЮТСЯ С БЕЗОБИДНОГО СЛОВА В ПОСТАНОВЛЕНИИ.
Dialogue: 0,0:06:29.93,0:06:32.02,Caption,,0,0,0,,ОБЩЕСТВО ТЕМ ВРЕМЕНЕМ ГОТОВЯТ К ТОМУ,
Dialogue: 0,0:06:32.33,0:06:34.69,Caption,,0,0,0,,ЧТО ВОЙНА СПОСОБНА ПРОДЛИТЬСЯ ВЕСЬ ДВЕ
Dialogue: 0,0:06:34.69,0:06:38.18,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД. ОДИН ИЗ ВЫСТУПАВШИХ ЗАЯВИЛ,
Dialogue: 0,0:06:38.46,0:06:40.92,Caption,,0,0,0,,ЧТО НЫНЕШНЕЕ ПОЛОЖЕНИЕ НЕ ПОЗВОЛЯЕТ ЕЁ
Dialogue: 0,0:06:40.92,0:06:43.41,Caption,,0,0,0,,ОСТАНОВИТЬ И ЧТО ОН ГОВОРИТ ОБ ЭТОМ С САМОГО
Dialogue: 0,0:06:43.41,0:06:46.02,Caption,,0,0,0,,НАЧАЛА. ВЕРОЯТНОСТЬ ПРЕКРАЩЕНИЯ ОГНЯ В
Dialogue: 0,0:06:46.02,0:06:49.45,Caption,,0,0,0,,СЛЕДУЮЩЕМ ГОДУ ОН ОЦЕНИЛ МАКСИМУМ В ДЕСЯТЬ ПРОЦЕНТОВ. ОН
Dialogue: 0,0:06:49.45,0:06:52.70,Caption,,0,0,0,,ПОНИМАЕТ, ЧТО ЛЮДЯМ ХОЧЕТСЯ ДРУГОГО ПРОГНОЗА.
Dialogue: 0,0:06:52.70,0:06:57.19,Caption,,0,0,0,,ХОЧЕТСЯ УСЛЫШАТЬ ПРИЯТНОЕ, ОБНЯТЬ ГОВОРЯЩЕГО И ИДТИ ЗА НИМ ПОЧТИ
Dialogue: 0,0:06:57.19,0:07:00.76,Caption,,0,0,0,,КАК ЗА ИКОНОЙ. ВМЕСТО УТЕШЕНИЯ ГРАЖДАНАМ ПРЕДЛАГАЮТ
Dialogue: 0,0:07:00.76,0:07:03.92,Caption,,0,0,0,,ОСВОИТЬСЯ С МЫСЛЬЮ О ЕЩЁ ОДНОМ ПОЛНОМ ВОЕННОМ
Dialogue: 0,0:07:03.92,0:07:07.26,Caption,,0,0,0,,ГОДЕ. ПОЗДРАВЛЕНИЕ ОТ ОФИСА ПРЕЗИДЕНТА ПОЛУЧИЛОСЬ
Dialogue: 0,0:07:07.26,0:07:11.46,Caption,,0,0,0,,СУРОВОЕ. ЁЛКА, ВИДИМО, БУДЕТ, А ХОРОШИХ НОВОСТЕЙ К НЕЙ НЕ ОБЕЩАЛИ.
Dialogue: 0,0:07:12.18,0:07:14.61,Caption,,0,0,0,,НАСЕЛЕНИЮ ОДНОВРЕМЕННО СООБЩАЮТ ДВЕ
Dialogue: 0,0:07:14.61,0:07:17.74,Caption,,0,0,0,,ВЕЩИ. ВОЙНА БЫСТРО НЕ ЗАКОНЧИТСЯ. ГОСУДАРСТВЕННЫЙ
Dialogue: 0,0:07:17.74,0:07:20.70,Caption,,0,0,0,,УЧЁТ КАЖДОГО ПОТЕНЦИАЛЬНОГО ВОЕННООБЯЗАННОГО ДОЛЖЕН
Dialogue: 0,0:07:20.70,0:07:23.75,Caption,,0,0,0,,СТАТЬ ЕЩЁ ТОЧНЕЕ. И ТОГДА ВОПРОС ЗВУЧИТ УЖЕ НЕ
Dialogue: 0,0:07:23.75,0:07:26.98,Caption,,0,0,0,,ТЕОРЕТИЧЕСКИ. КТО БУДЕТ ВОЕВАТЬ ВЕСЬ СЛЕДУЮЩИЙ ГОД?
Dialogue: 0,0:07:27.78,0:07:29.65,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО БАНКОВАЯ СНОВА ДОСТАЁТ
Dialogue: 0,0:07:29.65,0:07:32.83,Caption,,0,0,0,,ЗАГАДОЧНОГО ПАВЛЮЧЕНКО, КОГДА ОЧЕРЕДНОЙ ВЕРСИИ ТРЕБУЕТСЯ
Dialogue: 0,0:07:32.83,0:07:36.33,Caption,,0,0,0,,ПРИДАТЬ СОЛИДНОСТЬ. ТЕПЕРЬ ПУБЛИКЕ ПРЕДЛАГАЮТ ИСТОРИЮ О
Dialogue: 0,0:07:36.33,0:07:38.42,Caption,,0,0,0,,БУДУЩЕМ УКРАИНСКОМ КОНТРНАСТУПЛЕНИИ.
Dialogue: 0,0:07:40.71,0:07:44.33,Caption,,0,0,0,,СОГЛАСНО ЭТОЙ ВЕРСИИ, ПУТИН НАСТОЛЬКО ОПАСАЕТСЯ УКРАИНСКОГО
Dialogue: 0,0:07:44.33,0:07:47.56,Caption,,0,0,0,,ФОРСИРОВАНИЯ ДНЕПРА, ЧТО ПРОСИТ ТРАМПА ВОЗДЕЙСТВОВАТЬ НА
Dialogue: 0,0:07:47.56,0:07:50.85,Caption,,0,0,0,,ЗЕЛЕНСКОГО. ОПЫТ ПОДОБНЫХ ОПЕРАЦИЙ УЖЕ БЫЛ.
Dialogue: 0,0:07:50.85,0:07:54.11,Caption,,0,0,0,,ПОПЫТКИ ВЫСАДКИ ВОЗЛЕ ЭНЕРГОДАРА И ПОВТОРНЫЕ ДЕЙСТВИЯ
Dialogue: 0,0:07:54.11,0:07:56.39,Caption,,0,0,0,,НА КОСЕ ОБЕРНУЛИСЬ ТЯЖЁЛЫМИ ПОТЕРЯМИ,
Dialogue: 0,0:07:56.61,0:07:59.83,Caption,,0,0,0,,ХОТЯ ТАМ УЧАСТВОВАЛИ ЛУЧШИЕ ПОДРАЗДЕЛЕНИЯ. НО СТАРЫЙ
Dialogue: 0,0:07:59.83,0:08:03.91,Caption,,0,0,0,,СЧЁТ ЕЩЁ НЕ ЗАКРЫТ, А ЗРИТЕЛЯМ УЖЕ НЕСУТ НОВОЕ МЕНЮ С ТЕМ
Dialogue: 0,0:08:03.91,0:08:06.39,Caption,,0,0,0,,ЖЕ ГЛАВНЫМ БЛЮДОМ. КОМАНДИРАМ БРИГАД,
Dialogue: 0,0:08:06.48,0:08:09.52,Caption,,0,0,0,,ВЕРОЯТНО, ОСТАЁТСЯ ЗАНЯТЬ ОЧЕРЕДЬ ЗА ПОЧЁТНЫМ
Dialogue: 0,0:08:09.52,0:08:12.42,Caption,,0,0,0,,ПРАВОМ ПЕРВЫМИ ПОВЕСТИ ЛЮДЕЙ В КОНТРНАСТУПЛЕНИЕ ДВЕ
Dialogue: 0,0:08:12.42,0:08:13.99,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА.
Dialogue: 0,0:08:14.62,0:08:18.17,Caption,,0,0,0,,ЖЕЛАЮЩИХ ДОЛЖНО БЫТЬ СТОЛЬКО, ЧТО ПРИДЁТСЯ ВЫДАВАТЬ ТАЛОНЧИКИ.
Dialogue: 0,0:08:18.17,0:08:21.11,Caption,,0,0,0,,ЗАДАЧА ВЕДЬ НА СЛОВАХ ЭЛЕМЕНТАРНАЯ. НУЖНО ВСЕГО ЛИШЬ
Dialogue: 0,0:08:21.11,0:08:23.93,Caption,,0,0,0,,ФОРСИРОВАТЬ ДНЕПР. НА СХЕМЕ ВСЁ ВООБЩЕ ПОЛУЧАЕТСЯ
Dialogue: 0,0:08:23.93,0:08:26.39,Caption,,0,0,0,,ЗА НЕСКОЛЬКО СЕКУНД. ЗДЕСЬ ОДИН БЕРЕГ,
Dialogue: 0,0:08:26.55,0:08:29.36,Caption,,0,0,0,,ТАМ ДРУГОЙ, МЕЖДУ НИМИ ПРОВОДИТСЯ СТРЕЛКА.
Dialogue: 0,0:08:29.36,0:08:32.75,Caption,,0,0,0,,ПРОБЛЕМЫ НАЧИНАЮТСЯ, КОГДА СТРЕЛКЕ ВНЕЗАПНО ТРЕБУЮТСЯ
Dialogue: 0,0:08:32.75,0:08:35.43,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИЕ, ТЕХНИКА, ПЕРЕПРАВЫ,
Dialogue: 0,0:08:35.59,0:08:40.07,Caption,,0,0,0,,ПРИКРЫТИЕ, РЕЗЕРВЫ, БОЕПРИПАСЫ И ПОСТОЯННОЕ СНАБЖЕНИЕ. У
Dialogue: 0,0:08:40.07,0:08:43.30,Caption,,0,0,0,,КАРТЫ С ЭТИМ ПРОЩЕ. ОНА ПОТЕРЬ НЕ НЕСЁТ И ТОПЛИВА
Dialogue: 0,0:08:43.30,0:08:45.41,Caption,,0,0,0,,НЕ ПРОСИТ. ИМЕННО ПОЭТОМУ РАЗГОВОР О
Dialogue: 0,0:08:45.41,0:08:48.45,Caption,,0,0,0,,НАСТУПЛЕНИИ ТАК ВЫРАЗИТЕЛЬНО СОСЕДСТВУЕТ С ПОПЫТКОЙ
Dialogue: 0,0:08:48.45,0:08:51.59,Caption,,0,0,0,,НАЙТИ ДО ТРЁХСОТ ТЫСЯЧ МУЖЧИН ЗА СЧЁТ ОТМЕНЫ БРОНИ.
Dialogue: 0,0:08:52.15,0:08:54.13,Caption,,0,0,0,,В ГРОМКОМ ДОКЛАДЕ ПОДРАЗДЕЛЕНИЯ УЖЕ
Dialogue: 0,0:08:54.13,0:08:59.16,Caption,,0,0,0,,ДВИЖУТСЯ К ЦЕЛИ. В КАБИНЕТЕ МИНИСТЕРСТВА ЭКОНОМИКИ
Dialogue: 0,0:08:59.16,0:09:01.38,Caption,,0,0,0,,ОТКРЫВАЮТ СПИСОК РАБОТНИКОВ И РЕШАЮТ,
Dialogue: 0,0:09:01.65,0:09:03.94,Caption,,0,0,0,,КОГО МОЖНО ВЫНУТЬ ИЗ ПРОИЗВОДСТВА. ТАК
Dialogue: 0,0:09:03.94,0:09:06.71,Caption,,0,0,0,,ВЫГЛЯДИТ РАССТОЯНИЕ МЕЖДУ КРАСИВЫМ ЗАМЫСЛОМ И
Dialogue: 0,0:09:06.71,0:09:11.08,Caption,,0,0,0,,РЕАЛЬНЫМ НАЛИЧИЕМ ЛЮДЕЙ. СЛЕДУЮЩИЙ УЗЕЛ ЭТОЙ ИСТОРИИ НАХОДИТСЯ
Dialogue: 0,0:09:11.08,0:09:13.61,Caption,,0,0,0,,В КИЕВЕ. ОТВЕЧАЯ НА ВОПРОС О ВОЗМОЖНОЙ
Dialogue: 0,0:09:13.61,0:09:16.50,Caption,,0,0,0,,ЭВАКУАЦИИ ГОРОДОВ ЗИМОЙ, ЗЕЛЕНСКИЙ СКАЗАЛ,
Dialogue: 0,0:09:16.66,0:09:19.22,Caption,,0,0,0,,ЧТО БЕЗ СТОЛИЦЫ НЕ БУДЕТ СТРАНЫ И КИЕВ
Dialogue: 0,0:09:19.22,0:09:21.52,Caption,,0,0,0,,СТАНУТ ЗАЩИЩАТЬ ВСЕМИ ДОСТУПНЫМИ
Dialogue: 0,0:09:21.52,0:09:24.02,Caption,,0,0,0,,СПОСОБАМИ. УЕХАТЬ ГРАЖДАНАМ НЕ ЗАПРЕЩАЮТ,
Dialogue: 0,0:09:24.26,0:09:26.67,Caption,,0,0,0,,НО СТОЛИЦУ НАМЕРЕНЫ УДЕРЖИВАТЬ. ФРАЗА
Dialogue: 0,0:09:26.67,0:09:29.99,Caption,,0,0,0,,ЗВУЧИТ РЕШИТЕЛЬНО, ПОКА НЕ ПОЯВЛЯЕТСЯ ПРАКТИЧЕСКИЙ
Dialogue: 0,0:09:29.99,0:09:33.33,Caption,,0,0,0,,ВОПРОС. КАКИЕ СИЛЫ И СРЕДСТВА СТОЯТ ЗА СЛОВАМИ ОБО ВСЕХ
Dialogue: 0,0:09:33.33,0:09:36.18,Caption,,0,0,0,,СПОСОБАХ? ЗЕЛЕНСКИЙ ОДНОВРЕМЕННО УТВЕРЖДАЕТ,
Dialogue: 0,0:09:36.42,0:09:39.06,Caption,,0,0,0,,ЧТО РОССИЯ НАМЕРЕНА ОТДЕЛИТЬ ЛЕВОБЕРЕЖНУЮ ЧАСТЬ
Dialogue: 0,0:09:39.06,0:09:41.14,Caption,,0,0,0,,СТРАНЫ ОТ ПРАВОБЕРЕЖНОЙ. ЭТО УЖЕ
Dialogue: 0,0:09:41.14,0:09:44.80,Caption,,0,0,0,,УГРОЗА НЕ ОДНОМУ РАЙОНУ И НЕ ОДНОМУ ОБЪЕКТУ. ПОД УДАРОМ
Dialogue: 0,0:09:44.80,0:09:46.86,Caption,,0,0,0,,МОЖЕТ ОКАЗАТЬСЯ СВЯЗНОСТЬ ОГРОМНОЙ
Dialogue: 0,0:09:46.86,0:09:50.10,Caption,,0,0,0,,ТЕРРИТОРИИ. В ТАКОЙ ВОЙНЕ ЦЕЛЯМИ СТАНОВЯТСЯ ДОРОГИ,
Dialogue: 0,0:09:50.18,0:09:52.50,Caption,,0,0,0,,МОСТЫ, ЭНЕРГЕТИЧЕСКИЕ ОБЪЕКТЫ,
Dialogue: 0,0:09:52.66,0:09:55.15,Caption,,0,0,0,,СВЯЗЬ И ЛИНИИ СНАБЖЕНИЯ. ПРОТИВНИК
Dialogue: 0,0:09:55.15,0:09:58.74,Caption,,0,0,0,,БУДЕТ БИТЬ ПО ТОМУ, БЕЗ ЧЕГО СТРАНА И АРМИЯ НЕ МОГУТ
Dialogue: 0,0:09:58.74,0:10:02.31,Caption,,0,0,0,,ДЕЙСТВОВАТЬ. КИЕВ ЭТО ПОНИМАЕТ. ГОРАЗДО СЛОЖНЕЕ
Dialogue: 0,0:10:02.31,0:10:05.59,Caption,,0,0,0,,ДРУГОЕ. ХВАТИТ ЛИ РЕСУРСОВ ЗАКРЫТЬ ВСЕ УЯЗВИМЫЕ
Dialogue: 0,0:10:05.59,0:10:10.87,Caption,,0,0,0,,НАПРАВЛЕНИЯ ОДНОВРЕМЕННО? НУЖНО ОБОРОНЯТЬ СТОЛИЦУ,
Dialogue: 0,0:10:10.95,0:10:13.59,Caption,,0,0,0,,ПРИКРЫВАТЬ ЭНЕРГЕТИКУ, СОХРАНЯТЬ ПЕРЕПРАВЫ,
Dialogue: 0,0:10:13.76,0:10:17.50,Caption,,0,0,0,,ОБЕСПЕЧИВАТЬ ПРЕДПРИЯТИЯ, ПОПОЛНЯТЬ ПОДРАЗДЕЛЕНИЯ И НЕ ДАТЬ
Dialogue: 0,0:10:17.50,0:10:20.33,Caption,,0,0,0,,ЭКОНОМИКЕ ОКОНЧАТЕЛЬНО ВСТАТЬ. ПРИ ЭТОМ КАДРОВЫЙ
Dialogue: 0,0:10:20.33,0:10:22.95,Caption,,0,0,0,,ГОЛОД УЖЕ ДОШЁЛ ДО ОБСУЖДЕНИЯ ОТМЕНЫ БРОНИ ДЛЯ
Dialogue: 0,0:10:22.95,0:10:25.99,Caption,,0,0,0,,СОТЕН ТЫСЯЧ РАБОТНИКОВ. А ГДЕ ТО РЯДОМ ПРОДОЛЖАЕТ
Dialogue: 0,0:10:25.99,0:10:28.79,Caption,,0,0,0,,ЛЕЖАТЬ ПЛАН НОВОГО НАСТУПЛЕНИЯ. ВЕРОЯТНО,
Dialogue: 0,0:10:28.93,0:10:31.92,Caption,,0,0,0,,ЖДЁТ, КОГДА У РЕАЛЬНОСТИ ОСВОБОДИТСЯ ОКНО В
Dialogue: 0,0:10:31.92,0:10:34.54,Caption,,0,0,0,,РАСПИСАНИИ. В ТОМ ЖЕ РЯДУ ЗАЯВЛЕНИЙ ЗЕЛЕНСКИЙ
Dialogue: 0,0:10:34.54,0:10:37.84,Caption,,0,0,0,,СРАВНИЛ ОБРАЩЕНИЕ К ПУТИНУ КАК К ДРУГУ С ОТНОШЕНИЕМ К
Dialogue: 0,0:10:37.84,0:10:39.91,Caption,,0,0,0,,ГИТЛЕРУ ВО ВРЕМЯ ВТОРОЙ МИРОВОЙ ВОЙНЫ.
Dialogue: 0,0:10:40.46,0:10:42.39,Caption,,0,0,0,,ЭТО МАКСИМАЛЬНО ЖЁСТКАЯ ПОЗИЦИЯ,
Dialogue: 0,0:10:42.63,0:10:45.03,Caption,,0,0,0,,КОТОРАЯ НЕ ОСТАВЛЯЕТ БОЛЬШОГО ПРОСТРАНСТВА ДЛЯ
Dialogue: 0,0:10:45.03,0:10:48.23,Caption,,0,0,0,,БУДУЩЕГО КОМПРОМИССА. ОДНОВРЕМЕННО ГОТОВЯТСЯ ВСТРЕЧИ,
Dialogue: 0,0:10:48.47,0:10:50.68,Caption,,0,0,0,,ПОСВЯЩЁННЫЕ ГАРАНТИЯМ БЕЗОПАСНОСТИ.
Dialogue: 0,0:10:50.68,0:10:53.59,Caption,,0,0,0,,КОНТАКТЫ СОХРАНЯЮТСЯ, УСЛОВИЯ ОБСУЖДАЮТСЯ,
Dialogue: 0,0:10:53.83,0:10:55.92,Caption,,0,0,0,,ПЕРЕГОВОРНЫЕ КАНАЛЫ ДЕЙСТВУЮТ. НО
Dialogue: 0,0:10:55.92,0:10:58.23,Caption,,0,0,0,,ПУБЛИЧНЫЕ СЛОВА ЗАРАНЕЕ ДЕЛАЮТ ВОЗМОЖНУЮ
Dialogue: 0,0:10:58.23,0:11:00.15,Caption,,0,0,0,,ДОГОВОРЁННОСТЬ НАСТОЛЬКО УЗКОЙ,
Dialogue: 0,0:11:00.38,0:11:02.20,Caption,,0,0,0,,ЧТО ПРОХОДИТЬ ЧЕРЕЗ НЕЁ ПРИДЁТСЯ
Dialogue: 0,0:11:02.20,0:11:05.34,Caption,,0,0,0,,БОКОМ. ЕЩЁ ОДНО ЗАЯВЛЕНИЕ КАСАЕТСЯ АТАКИ НА
Dialogue: 0,0:11:05.34,0:11:08.15,Caption,,0,0,0,,РОССИЙСКИЙ КОРАБЛЬ В ЛИВИИ. ЗЕЛЕНСКИЙ СКАЗАЛ,
Dialogue: 0,0:11:08.31,0:11:10.23,Caption,,0,0,0,,ЧТО УКРАИНА НЕ ПРОВОДИТ ПОДОБНЫХ
Dialogue: 0,0:11:10.23,0:11:12.31,Caption,,0,0,0,,ОПЕРАЦИЙ БЕЗ КООРДИНАЦИИ С ПАРТНЁРАМИ.
Dialogue: 0,0:11:12.86,0:11:14.87,Caption,,0,0,0,,ЛИВИЙСКИЙ ЭПИЗОД ПОКАЗЫВАЕТ СТЕПЕНЬ
Dialogue: 0,0:11:14.87,0:11:17.19,Caption,,0,0,0,,ЗАВИСИМОСТИ УКРАИНСКИХ ВОЕННЫХ ДЕЙСТВИЙ ОТ
Dialogue: 0,0:11:17.19,0:11:20.56,Caption,,0,0,0,,ВНЕШНЕГО СОДЕЙСТВИЯ. ПОДДЕРЖКА ТРЕБУЕТСЯ НЕ ТОЛЬКО В ВИДЕ
Dialogue: 0,0:11:20.56,0:11:25.87,Caption,,0,0,0,,ДЕНЕГ ИЛИ ПОСТАВОК. НУЖНЫ РАЗВЕДЫВАТЕЛЬНЫЕ ВОЗМОЖНОСТИ,
Dialogue: 0,0:11:25.95,0:11:29.63,Caption,,0,0,0,,СОГЛАСОВАНИЕ И ПОСТОЯННОЕ ВЗАИМОДЕЙСТВИЕ. ЗАПАДНЫЕ
Dialogue: 0,0:11:29.63,0:11:31.63,Caption,,0,0,0,,ПАРТНЁРЫ СПОСОБНЫ ПЕРЕДАТЬ ОРУЖИЕ,
Dialogue: 0,0:11:31.80,0:11:35.23,Caption,,0,0,0,,СВЕДЕНИЯ, ФИНАНСИРОВАНИЕ И ПУБЛИЧНУЮ ПОДДЕРЖКУ.
Dialogue: 0,0:11:35.79,0:11:38.09,Caption,,0,0,0,,ЕДИНСТВЕННОЕ, ЧЕГО БРЮССЕЛЬ НЕ ПОЛОЖИТ В
Dialogue: 0,0:11:38.09,0:11:41.42,Caption,,0,0,0,,ТРАНСПОРТНЫЙ КОНТЕЙНЕР, ЭТО УКРАИНСКИЙ ПЕХОТИНЕЦ. ЕГО
Dialogue: 0,0:11:41.42,0:11:43.47,Caption,,0,0,0,,ПРИХОДИТСЯ ИСКАТЬ ВНУТРИ СТРАНЫ,
Dialogue: 0,0:11:43.63,0:11:45.43,Caption,,0,0,0,,СНИМАТЬ С БРОНИ ИЛИ ЗАМЕЧАТЬ В
Dialogue: 0,0:11:45.43,0:11:48.76,Caption,,0,0,0,,МИГРАЦИОННОЙ БАЗЕ. ЭТО НЕ ДОКУМЕНТ С ЕДИНЫМ НАЗВАНИЕМ И
Dialogue: 0,0:11:48.76,0:11:51.19,Caption,,0,0,0,,ПЕЧАТЬЮ ОДНОГО КАБИНЕТА. ЗАТО ПРИЧИНА У
Dialogue: 0,0:11:51.19,0:11:54.48,Caption,,0,0,0,,РЕШЕНИЙ ОДНА И ОЧЕНЬ МАТЕРИАЛЬНАЯ. ЛЮДЕЙ НЕ ХВАТАЕТ.
Dialogue: 0,0:11:54.48,0:11:57.72,Caption,,0,0,0,,ПРИЧЁМ КАЖДЫЙ ЖЕЛАЮЩИЙ СЧИТАЕТ ИМЕННО СВОИХ ЛЮДЕЙ
Dialogue: 0,0:11:57.72,0:12:01.15,Caption,,0,0,0,,ГЛАВНЫМИ. АРМИИ НУЖНЫ ПОПОЛНЕНИЯ. ПРЕДПРИЯТИЯМ НУЖНЫ
Dialogue: 0,0:12:01.15,0:12:03.98,Caption,,0,0,0,,СПЕЦИАЛИСТЫ. ЭНЕРГЕТИКЕ НУЖНЫ РЕМОНТНИКИ.
Dialogue: 0,0:12:03.98,0:12:07.39,Caption,,0,0,0,,ТРАНСПОРТУ НУЖНЫ МАШИНИСТЫ И ВОДИТЕЛИ. БЮДЖЕТУ НУЖНЫ
Dialogue: 0,0:12:07.39,0:12:10.03,Caption,,0,0,0,,НАЛОГОПЛАТЕЛЬЩИКИ. СЕМЬЕ НУЖНЫ МУЖЬЯ,
Dialogue: 0,0:12:10.15,0:12:12.87,Caption,,0,0,0,,ОТЦЫ И СЫНОВЬЯ. ЕВРОПЕЙСКОЙ ЭКОНОМИКЕ
Dialogue: 0,0:12:12.87,0:12:15.33,Caption,,0,0,0,,НУЖНЫ СОТРУДНИКИ И ПОКУПАТЕЛИ. ТОЛЬКО
Dialogue: 0,0:12:15.33,0:12:18.99,Caption,,0,0,0,,МУЖЧИНА, ВНЕСЁННЫЙ В РЕЕСТР, ОСТАЁТСЯ ОДНИМ ЧЕЛОВЕКОМ,
Dialogue: 0,0:12:19.15,0:12:21.32,Caption,,0,0,0,,А НЕ КОМПЛЕКТОМ ИЗ ПЯТИ ЭКЗЕМПЛЯРОВ. В
Dialogue: 0,0:12:21.32,0:12:25.20,Caption,,0,0,0,,ЭТОМ И СОСТОИТ КОНФЛИКТ, КОТОРЫЙ НЕВОЗМОЖНО УБРАТЬ НОВОЙ ФОРМОЙ
Dialogue: 0,0:12:25.20,0:12:27.71,Caption,,0,0,0,,ОТЧЁТНОСТИ. ЧЕМ ТОЧНЕЕ СТАНОВИТСЯ УЧЁТ,
Dialogue: 0,0:12:28.03,0:12:31.34,Caption,,0,0,0,,ТЕМ НАГЛЯДНЕЕ ВИДНО, ЧТО УЧИТЫВАТЬ УЖЕ ПОЧТИ НЕЧЕГО.
Dialogue: 0,0:12:31.34,0:12:34.92,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ БАЗЫ СОПОСТАВЯТ И ДОБАВЯТ К ЗАПИСИ СВЕЖУЮ
Dialogue: 0,0:12:34.92,0:12:40.03,Caption,,0,0,0,,ФОТОГРАФИЮ. ОТСРОЧКУ ОТМЕНЯТ, БРОНЬ ПЕРЕПРОВЕРЯТ. НЕОФИЦИАЛЬНУЮ ЦЕНУ
Dialogue: 0,0:12:40.03,0:12:46.26,Caption,,0,0,0,,СПАСЕНИЯ ПОДНИМУТ ЕЩЁ ВЫШЕ. О ТЯЖЁЛОМ СЛЕДУЮЩЕМ ГОДЕ ПРЕДУПРЕДЯТ И
Dialogue: 0,0:12:46.26,0:12:49.47,Caption,,0,0,0,,СНОВА ПООБЕЩАЮТ НАСТУПЛЕНИЕ. НИ ОДНО ИЗ ЭТИХ
Dialogue: 0,0:12:49.47,0:12:52.27,Caption,,0,0,0,,ДЕЙСТВИЙ НЕ СОЗДАСТ ДОПОЛНИТЕЛЬНЫХ РАБОТНИКОВ И
Dialogue: 0,0:12:52.27,0:12:55.00,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. ПРОДОЛЖЕНИЕ ВОЙНЫ ЗАСТАВЛЯЕТ
Dialogue: 0,0:12:55.00,0:12:58.46,Caption,,0,0,0,,ГОСУДАРСТВО ВЫБИРАТЬ УЖЕ НЕ ХОРОШИЙ ВАРИАНТ СРЕДИ ПЛОХИХ.
Dialogue: 0,0:12:58.46,0:13:01.76,Caption,,0,0,0,,ОНО РЕШАЕТ, В КАКОМ МЕСТЕ СЕЙЧАС ОБРАЗОВАТЬ НОВУЮ
Dialogue: 0,0:13:01.76,0:13:04.19,Caption,,0,0,0,,ДЫРУ, ЧТОБЫ ВРЕМЕННО ЗАТКНУТЬ ПРЕЖНЮЮ.
Dialogue: 0,0:13:04.19,0:13:06.15,Caption,,0,0,0,,РАБОТНИКА ЗАБЕРУТ С ПРЕДПРИЯТИЯ,
Dialogue: 0,0:13:06.31,0:13:08.43,Caption,,0,0,0,,КОТОРОМУ ВЕЛЕЛИ НАРАЩИВАТЬ ВЫПУСК.
Dialogue: 0,0:13:08.43,0:13:11.64,Caption,,0,0,0,,МУЖЧИНУ ВЫДЕРНУТ ИЗ СЕМЬИ. УЕХАВШЕГО ПОСТАРАЮТСЯ
Dialogue: 0,0:13:11.64,0:13:15.40,Caption,,0,0,0,,ВЕРНУТЬ. БРОНЬ ПЕРЕСМОТРЯТ. КОНТРОЛЬ УСИЛЯТ. РЕЕСТР
Dialogue: 0,0:13:15.40,0:13:18.51,Caption,,0,0,0,,РАСШИРЯТ. ПОСЛЕ ЭТОГО КТО НИБУДЬ ОТКРОЕТ КАРТУ И
Dialogue: 0,0:13:18.51,0:13:21.93,Caption,,0,0,0,,УВЕРЕННОЙ РУКОЙ ПРОВЕДЁТ МАРШРУТ ЧЕРЕЗ ДНЕПР. НАПИШИТЕ
Dialogue: 0,0:13:21.93,0:13:24.31,Caption,,0,0,0,,В КОММЕНТАРИЯХ, КОГО, ПО ВАШЕМУ МНЕНИЮ,
Dialogue: 0,0:13:24.55,0:13:26.63,Caption,,0,0,0,,ГОСУДАРСТВО НАЧНЁТ ИСКАТЬ СЛЕДУЮЩИМ,
Dialogue: 0,0:13:26.81,0:13:29.91,Caption,,0,0,0,,КОГДА РЕЕСТРЫ, ПРЕДПРИЯТИЯ И ЗАГРАНИЦА УЖЕ БУДУТ
Dialogue: 0,0:13:29.91,0:13:32.92,Caption,,0,0,0,,ПРОСМОТРЕНЫ. БУМАЖНАЯ КАРТА СПОРИТЬ НЕ СТАНЕТ. НА
Dialogue: 0,0:13:32.92,0:13:34.84,Caption,,0,0,0,,НЕЙ МОЖНО НАРИСОВАТЬ СКОЛЬКО УГОДНО
Dialogue: 0,0:13:34.84,0:13:37.51,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЙ. ЖИВЫХ ЛЮДЕЙ СНАЧАЛА НАДО НАЙТИ.
