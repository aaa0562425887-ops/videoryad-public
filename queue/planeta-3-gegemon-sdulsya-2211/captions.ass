Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,АМЕРИКА ЕЩЁ СОХРАНЯЕТ САМЫЙ ТЯЖЁЛЫЙ КУЛАК В КОМНАТЕ,
Dialogue: 0,0:00:03.32,0:00:05.64,Caption,,0,0,0,,НО РАСПОРЯЖАТЬСЯ ВСЕМИ СТУЛЬЯМИ УЖЕ НЕ МОЖЕТ.
Dialogue: 0,0:00:06.20,0:00:08.36,Caption,,0,0,0,,ТРАМП ВСТРЕТИЛСЯ С ПУТИНЫМ И СИ ЦЗИНЬПИНОМ,
Dialogue: 0,0:00:08.60,0:00:12.92,Caption,,0,0,0,,А ЗАТЕМ ПРИЗНАЛ ТО, ЧТО ВАШИНГТОН ДОЛГО НЕ ЗАМЕЧАЛ. НА ПЛАНЕТЕ ЕСТЬ
Dialogue: 0,0:00:12.92,0:00:17.16,Caption,,0,0,0,,ЕЩЁ ДВЕ ДЕРЖАВЫ, БЕЗ КОТОРЫХ КРУПНЫЕ ВОПРОСЫ НЕ РЕШАЮТСЯ. СОЮЗНИКИ
Dialogue: 0,0:00:17.16,0:00:19.72,Caption,,0,0,0,,ВСЁ ЕЩЁ ЖДУТ КОМАНД ОТ ПРЕЖНЕГО НАЧАЛЬНИКА,
Dialogue: 0,0:00:20.04,0:00:22.44,Caption,,0,0,0,,А ТОТ УЖЕ ОБСУЖДАЕТ НОВЫЕ ПРАВИЛА С ТЕМИ,
Dialogue: 0,0:00:22.76,0:00:25.56,Caption,,0,0,0,,КОГО ЕЩЁ НЕДАВНО ТРЕБОВАЛ ИЗОЛИРОВАТЬ И СДЕРЖИВАТЬ.
Dialogue: 0,0:00:26.03,0:00:29.64,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ, В КОТОРЫХ СМОТРЯТ НЕ НА ГРОМКОСТЬ ЗАЯВЛЕНИЯ,
Dialogue: 0,0:00:29.88,0:00:34.36,Caption,,0,0,0,,А НА ЕГО ПОСЛЕДСТВИЯ, ПОДПИШИТЕСЬ НА КАНАЛ. СОЕДИНЁННЫЕ ШТАТЫ НЕ ЛИШИЛИСЬ
Dialogue: 0,0:00:34.38,0:00:39.00,Caption,,0,0,0,,АРМИИ, ФЛОТА ИЛИ ДЕНЕГ. АМЕРИКА ОСТАЁТСЯ КОЛОССАЛЬНОЙ
Dialogue: 0,0:00:39.08,0:00:41.96,Caption,,0,0,0,,СИЛОЙ. ЗАКОНЧИЛАСЬ ДРУГАЯ ПРИВИЛЕГИЯ ВАШИНГТОН
Dialogue: 0,0:00:42.04,0:00:44.60,Caption,,0,0,0,,БОЛЬШЕ НЕ МОЖЕТ ЕДИНОЛИЧНО РАЗДАВАТЬ ИНСТРУКЦИИ,
Dialogue: 0,0:00:44.76,0:00:46.60,Caption,,0,0,0,,НАЗНАЧАТЬ ВИНОВАТЫХ И ОПРЕДЕЛЯТЬ,
Dialogue: 0,0:00:46.76,0:00:50.20,Caption,,0,0,0,,ЧЬИ ИНТЕРЕСЫ ЗАСЛУЖИВАЮТ ВНИМАНИЯ. ПРИЧЁМ МАСКИРОВКУ
Dialogue: 0,0:00:50.28,0:00:52.92,Caption,,0,0,0,,ПОЧТИ СНЯЛИ. ПОСЛЕ РАЗГОВОРОВ С РОССИЙСКИМ И
Dialogue: 0,0:00:52.92,0:00:55.64,Caption,,0,0,0,,КИТАЙСКИМ ЛИДЕРАМИ ТРАМП ЗАГОВОРИЛ О ВЗАИМНОЙ
Dialogue: 0,0:00:55.64,0:00:59.00,Caption,,0,0,0,,СИМПАТИИ И ПЕРСПЕКТИВАХ ДРУЖБЫ. ЗАТЕМ ПРЯМО ПОСТАВИЛ
Dialogue: 0,0:00:59.00,0:01:01.88,Caption,,0,0,0,,США, РОССИЮ И КИТАЙ В ОДИН РЯД,
Dialogue: 0,0:01:02.12,0:01:05.16,Caption,,0,0,0,,НАЗВАВ ИХ ТРЕМЯ СИЛЬНЕЙШИМИ ДЕРЖАВАМИ. СОВСЕМ
Dialogue: 0,0:01:05.16,0:01:07.72,Caption,,0,0,0,,НЕДАВНО МОСКВУ ПОЛАГАЛОСЬ ЗАГНАТЬ В ОДИНОЧЕСТВО,
Dialogue: 0,0:01:07.87,0:01:10.04,Caption,,0,0,0,,ПЕКИН НАЗНАЧИЛИ ГЛАВНЫМ СОПЕРНИКОМ,
Dialogue: 0,0:01:10.28,0:01:12.52,Caption,,0,0,0,,А ВАШИНГТОН ОСТАВИЛ СЕБЕ КРЕСЛО АРБИТРА.
Dialogue: 0,0:01:14.80,0:01:17.68,Caption,,0,0,0,,ТЕПЕРЬ АРБИТР САДИТСЯ РЯДОМ С ОБОИМИ И ВЫЯСНЯЕТ,
Dialogue: 0,0:01:17.84,0:01:19.92,Caption,,0,0,0,,ПО КАКИМ ПРАВИЛАМ ПРОЙДЁТ СЛЕДУЮЩИЙ РАУНД.
Dialogue: 0,0:01:20.48,0:01:25.20,Caption,,0,0,0,,СТАРЫЙ ПОРЯДОК ЕЩЁ СТОИТ, НО ТАБЛИЧКА НА ДВЕРИ УЖЕ ПЕРЕКОШЕНА. НИКТО НЕ
Dialogue: 0,0:01:25.20,0:01:30.00,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО ПУТИН, ТРАМП И СИ ЦЗИНЬПИН ПРЕВРАТИЛИСЬ В НЕРАЗЛУЧНУЮ
Dialogue: 0,0:01:30.00,0:01:33.20,Caption,,0,0,0,,КОМПАНИЮ. ПРОТИВОРЕЧИЙ ХВАТИТ НА НЕСКОЛЬКО ПОКОЛЕНИЙ
Dialogue: 0,0:01:33.20,0:01:36.16,Caption,,0,0,0,,ПЕРЕГОВОРЩИКОВ. ЗНАЧЕНИЕ ВСТРЕЧИ В ДРУГОМ БЫВШИЙ
Dialogue: 0,0:01:36.16,0:01:38.08,Caption,,0,0,0,,ЕДИНСТВЕННЫЙ РАСПОРЯДИТЕЛЬ ПРИЗНАЛ,
Dialogue: 0,0:01:38.48,0:01:40.72,Caption,,0,0,0,,ЧТО ДВА ДРУГИХ УЧАСТНИКА СЛИШКОМ ВЕЛИКИ,
Dialogue: 0,0:01:40.88,0:01:42.88,Caption,,0,0,0,,ЧТОБЫ РАЗГОВАРИВАТЬ С НИМИ ЧЕРЕЗ СЕКРЕТАРЯ.
Dialogue: 0,0:01:43.51,0:01:46.64,Caption,,0,0,0,,ОТМЕНИТЬ ЭТО ПРИЗНАНИЕ УЖЕ НЕ ПОЛУЧИТСЯ. ГОТОВОЙ
Dialogue: 0,0:01:46.72,0:01:49.76,Caption,,0,0,0,,ЗАМЕНЫ ПРЕЖНЕЙ СИСТЕМЕ ПОКА НЕТ. СТАРЫЕ ПРАВИЛА
Dialogue: 0,0:01:49.84,0:01:54.40,Caption,,0,0,0,,ПЕРЕСТАЛИ БЫТЬ ОБЯЗАТЕЛЬНЫМИ, А НОВЫЕ СУЩЕСТВУЮТ ЛИШЬ В НАБРОСКАХ. ПЕРЕД НАМИ
Dialogue: 0,0:01:54.48,0:01:57.44,Caption,,0,0,0,,РЕМОНТ ЗДАНИЯ, В КОТОРОМ ЛЮДИ ПРОДОЛЖАЮТ ЖИТЬ,
Dialogue: 0,0:01:57.55,0:02:00.16,Caption,,0,0,0,,СПОРИТЬ И ОТКЛЮЧАТЬ ДРУГ ДРУГУ ЭЛЕКТРИЧЕСТВО.
Dialogue: 0,0:02:00.33,0:02:03.52,Caption,,0,0,0,,ПОЭТОМУ ВПЕРЕДИ НЕИЗБЕЖНЫ ТОЛЧКИ. КОНСТРУКЦИЯ ИЩЕТ
Dialogue: 0,0:02:03.52,0:02:07.36,Caption,,0,0,0,,НОВУЮ ОПОРУ, А КАЖДЫЙ УЧАСТНИК СТАРАЕТСЯ ПОДЛОЖИТЬ ЕЁ ПОД СВОЮ
Dialogue: 0,0:02:07.36,0:02:10.48,Caption,,0,0,0,,ПОЛОВИНУ ДОМА. ГЛАВНЫЙ ВОПРОС СТАНЕТ ЛИ ВСТРЕЧА
Dialogue: 0,0:02:10.48,0:02:13.92,Caption,,0,0,0,,НАЧАЛОМ ПОСТОЯННОГО ФОРМАТА. ОДИН САММИТ МОЖНО
Dialogue: 0,0:02:13.92,0:02:16.72,Caption,,0,0,0,,ПРОДАТЬ КАК ЭФФЕКТНЫЙ НОМЕР. ВТОРОЙ СОЗДАЁТ
Dialogue: 0,0:02:16.72,0:02:19.44,Caption,,0,0,0,,ПРИВЫЧКУ. ПОСЛЕ ТРЕТЬЕГО ПРИДЁТСЯ ПРИНОСИТЬ НА СТОЛ
Dialogue: 0,0:02:19.44,0:02:21.76,Caption,,0,0,0,,НЕ ТОЛЬКО КОМПЛИМЕНТЫ, НО И РЕШЕНИЯ.
Dialogue: 0,0:02:22.32,0:02:24.96,Caption,,0,0,0,,РЕГУЛЯРНЫЕ ВСТРЕЧИ ПРЕВРАЩАЮТ ФОТОГРАФИЮ В РАБОЧИЙ
Dialogue: 0,0:02:24.96,0:02:27.60,Caption,,0,0,0,,МЕХАНИЗМ. ПЕРВЫЕ ДЕТАЛИ УЖЕ ВИДНЫ.
Dialogue: 0,0:02:29.88,0:02:33.56,Caption,,0,0,0,,НАПРИМЕР, ПРЕДЛОЖЕНИЕ ИЗМЕНИТЬ ОРГАНИЗАЦИЮ ОБЪЕДИНЁННЫХ НАЦИЙ.
Dialogue: 0,0:02:33.93,0:02:38.04,Caption,,0,0,0,,РОССИЯ, КИТАЙ И СОЕДИНЁННЫЕ ШТАТЫ ЯВЛЯЮТСЯ ПОСТОЯННЫМИ
Dialogue: 0,0:02:38.04,0:02:40.36,Caption,,0,0,0,,ЧЛЕНАМИ СОВЕТА БЕЗОПАСНОСТИ И СЧИТАЮТ,
Dialogue: 0,0:02:40.64,0:02:43.24,Caption,,0,0,0,,ЧТО ОРГАНИЗАЦИЮ ПОРА ПЕРЕСТРАИВАТЬ. ПРАВДА,
Dialogue: 0,0:02:43.48,0:02:46.68,Caption,,0,0,0,,ПОСТОЯННЫХ ЧЛЕНОВ С ПРАВОМ ВЕТО ПЯТЬ. ФРАНЦИЮ
Dialogue: 0,0:02:46.68,0:02:49.72,Caption,,0,0,0,,ПРИГЛАСИТЬ ЗАБЫЛИ? А ВЕЛИКОБРИТАНИЯ ПОТЕРЯЛА АДРЕС?
Dialogue: 0,0:02:50.27,0:02:53.00,Caption,,0,0,0,,ТРИ ГОСУДАРСТВА ОБСУЖДАЮТ УСТРОЙСТВО УЧРЕЖДЕНИЯ,
Dialogue: 0,0:02:53.18,0:02:56.12,Caption,,0,0,0,,РУКОВОДЯЩИЙ СТОЛ КОТОРОГО РАССЧИТАН НА ПЯТЕРЫХ. ДВА
Dialogue: 0,0:02:56.12,0:03:00.36,Caption,,0,0,0,,КРЕСЛА СУЩЕСТВУЮТ, НО СЛОВНО УЖЕ СТОЯТ В СОСЕДНЕМ ПОМЕЩЕНИИ. НА
Dialogue: 0,0:03:00.36,0:03:03.48,Caption,,0,0,0,,ЭТОМ ФОНЕ КОМИЧНО ЗВУЧАТ ЕВРОПЕЙСКИЕ РАССУЖДЕНИЯ О
Dialogue: 0,0:03:03.56,0:03:06.04,Caption,,0,0,0,,ГИГАНТАХ И КАРЛИКАХ. ГОСУДАРСТВО,
Dialogue: 0,0:03:06.28,0:03:08.60,Caption,,0,0,0,,КОТОРОЕ В ЕВРОПЕ ЛЮБЯТ ИЗМЕРЯТЬ СНИСХОДИТЕЛЬНОЙ
Dialogue: 0,0:03:08.60,0:03:13.00,Caption,,0,0,0,,ЛИНЕЙКОЙ, УЧАСТВУЕТ В ОБСУЖДЕНИИ БУДУЩЕГО ООН. А ДВЕ БЫВШИЕ
Dialogue: 0,0:03:13.08,0:03:16.60,Caption,,0,0,0,,ИМПЕРИИ, ПРИВЫКШИЕ СЧИТАТЬ СЕБЯ ОБЯЗАТЕЛЬНОЙ ЧАСТЬЮ ЛЮБОГО
Dialogue: 0,0:03:16.60,0:03:20.76,Caption,,0,0,0,,МИРОВОГО РЕШЕНИЯ, ПОЛУЧАЮТ НОВОСТИ ПОСЛЕ ЗАСЕДАНИЯ. МОЖЕТ,
Dialogue: 0,0:03:20.88,0:03:24.52,Caption,,0,0,0,,МЕРИЛИ НЕ ТЕХ? ПЕРЕПИСАТЬ УСТАВ ОРГАНИЗАЦИИ СИЛАМИ ТРОИХ НЕ
Dialogue: 0,0:03:24.52,0:03:27.56,Caption,,0,0,0,,ПОЛУЧИТСЯ. ПРАВО ВЕТО НЕ ИСПАРЯЕТСЯ ОТ УВЕРЕННОГО
Dialogue: 0,0:03:27.56,0:03:30.60,Caption,,0,0,0,,ВЫРАЖЕНИЯ ЛИЦА. ОДНАКО ВАЖЕН ВЫБОР УЧАСТНИКОВ.
Dialogue: 0,0:03:31.31,0:03:34.04,Caption,,0,0,0,,БУДУЩЕЕ МЕЖДУНАРОДНОЙ СИСТЕМЫ НАЧАЛИ ОБСУЖДАТЬ БЕЗ
Dialogue: 0,0:03:34.04,0:03:38.36,Caption,,0,0,0,,ПАРИЖА И ЛОНДОНА, ХОТЯ ФОРМАЛЬНО ИХ СТАТУС НЕ НИЖЕ. НОВОГО РАЗДЕЛА
Dialogue: 0,0:03:38.44,0:03:40.68,Caption,,0,0,0,,МИРА С ЛИНЕЙКОЙ И КАРАНДАШАМИ ПОКА НЕТ.
Dialogue: 0,0:03:41.24,0:03:44.12,Caption,,0,0,0,,НО КОНТУРЫ СДЕЛКИ УЖЕ ПРОСТУПИЛИ. И ОРГАНИЗАЦИЕЙ
Dialogue: 0,0:03:44.12,0:03:46.44,Caption,,0,0,0,,ОБЪЕДИНЁННЫХ НАЦИЙ ДЕЛО НЕ ОГРАНИЧИВАЕТСЯ.
Dialogue: 0,0:03:48.72,0:03:51.04,Caption,,0,0,0,,В ОБЩЕЙ ДЕКЛАРАЦИИ УПОМЯНУТА ЭНЕРГЕТИКА.
Dialogue: 0,0:03:51.33,0:03:54.64,Caption,,0,0,0,,ПЕРЕРАБОТКА, ПОСТАВКИ, УСТОЙЧИВОСТЬ РЫНКА,
Dialogue: 0,0:03:54.78,0:03:57.68,Caption,,0,0,0,,ПРОИЗВОДСТВЕННЫЕ ВОЗМОЖНОСТИ. ОБЫЧНЫЙ НАБОР СЛОВ ДЛЯ
Dialogue: 0,0:03:57.76,0:04:00.40,Caption,,0,0,0,,ЧИНОВНИЧЬЕЙ ПАПКИ. СТОИТ, ОДНАКО,
Dialogue: 0,0:04:00.56,0:04:04.96,Caption,,0,0,0,,ПОСМОТРЕТЬ НА УЧАСТНИКОВ. КИТАЙ РАСПОЛАГАЕТ ОГРОМНЫМИ ПЕРЕРАБАТЫВАЮЩИМИ
Dialogue: 0,0:04:04.96,0:04:08.08,Caption,,0,0,0,,МОЩНОСТЯМИ. РОССИЯ СПОСОБНА НАРАЩИВАТЬ ПОСТАВКИ
Dialogue: 0,0:04:08.08,0:04:12.24,Caption,,0,0,0,,СЫРЬЯ. РЯДОМ НАХОДЯТСЯ ИРАН И ВЕНЕСУЭЛА. У США
Dialogue: 0,0:04:12.24,0:04:15.36,Caption,,0,0,0,,ЕСТЬ СОБСТВЕННАЯ ДОБЫЧА И ЭКСПОРТ. ПОСЛЕ ЭТОГО
Dialogue: 0,0:04:15.44,0:04:17.60,Caption,,0,0,0,,СКУЧНЫЙ ПУНКТ УПИРАЕТСЯ В САНКЦИИ,
Dialogue: 0,0:04:17.68,0:04:23.04,Caption,,0,0,0,,РАСЧЁТЫ, СТРАХОВКУ, ЛОГИСТИКУ И ДОСТУП ТАНКЕРОВ В ПОРТЫ. ВОТ ТАМ
Dialogue: 0,0:04:23.12,0:04:25.92,Caption,,0,0,0,,И НАЧИНАЕТСЯ ПОЛИТИКА БОЛЬШИХ ДЕРЖАВ БЕЗ ПРАЗДНИЧНЫХ
Dialogue: 0,0:04:25.92,0:04:29.20,Caption,,0,0,0,,САЛФЕТОК. НЕ МЕНЕЕ ПОКАЗАТЕЛЕН ПУНКТ ОБ ИММУНИТЕТЕ
Dialogue: 0,0:04:29.20,0:04:32.16,Caption,,0,0,0,,РУКОВОДИТЕЛЕЙ ГОСУДАРСТВ И ПОЛНОМОЧИЯХ МЕЖДУНАРОДНЫХ
Dialogue: 0,0:04:32.24,0:04:35.84,Caption,,0,0,0,,СУДОВ. ПОЗИЦИЯ ТРЁХ СТРАН ЯСНА. ВНЕШНИЕ СТРУКТУРЫ
Dialogue: 0,0:04:35.84,0:04:38.00,Caption,,0,0,0,,МОГУТ ВЫПУСКАТЬ РЕШЕНИЯ И ОРДЕРА,
Dialogue: 0,0:04:38.25,0:04:40.56,Caption,,0,0,0,,НО АВТОМАТИЧЕСКИ ПРИЗНАВАТЬ ИХ ПРАВО СУДИТЬ
Dialogue: 0,0:04:40.56,0:04:43.92,Caption,,0,0,0,,НАЦИОНАЛЬНЫХ ЛИДЕРОВ ЭТИ ДЕРЖАВЫ НЕ НАМЕРЕНЫ. ЗДЕСЬ
Dialogue: 0,0:04:43.92,0:04:46.64,Caption,,0,0,0,,РАЗГОВОР ВЫХОДИТ ДАЛЕКО ЗА ПРЕДЕЛЫ ОДНОЙ СУДЕБНОЙ
Dialogue: 0,0:04:46.64,0:04:49.52,Caption,,0,0,0,,ИСТОРИИ. ЗА ПОСЛЕДНИЕ ДЕСЯТИЛЕТИЯ ГОСУДАРСТВА
Dialogue: 0,0:04:49.60,0:04:51.92,Caption,,0,0,0,,ОБРОСЛИ КОМИССИЯМИ, АГЕНТСТВАМИ,
Dialogue: 0,0:04:52.00,0:04:55.68,Caption,,0,0,0,,ТРИБУНАЛАМИ И НАДНАЦИОНАЛЬНЫМИ ОРГАНАМИ. ПОСТЕПЕННО
Dialogue: 0,0:04:55.76,0:04:58.64,Caption,,0,0,0,,ЭТА НАДСТРОЙКА РЕШИЛА, ЧТО НАХОДИТСЯ ВЫШЕ ТЕХ,
Dialogue: 0,0:04:58.73,0:05:01.84,Caption,,0,0,0,,КТО ЕЁ СОЗДАВАЛ. ДЛЯ ЛЮБОГО ПРАВИТЕЛЬСТВА БУДТО БЫ
Dialogue: 0,0:05:01.84,0:05:04.64,Caption,,0,0,0,,НАШЁЛСЯ КАБИНЕТ ЭТАЖОМ ВЫШЕ, ГДЕ ЗНАЮТ,
Dialogue: 0,0:05:04.95,0:05:06.72,Caption,,0,0,0,,КОГО НАКАЗАТЬ И ЧТО ЗАПРЕТИТЬ.
Dialogue: 0,0:05:08.99,0:05:12.03,Caption,,0,0,0,,ТЕПЕРЬ ТРИ КРУПНЕЙШИХ ЦЕНТРА СИЛЫ НАПОМИНАЮТ ЭТОМУ
Dialogue: 0,0:05:12.03,0:05:16.11,Caption,,0,0,0,,ЭТАЖУ, ЧТО ФУНДАМЕНТ РАСПОЛОЖЕН ВНИЗУ. СУВЕРЕНИТЕТ НЕ
Dialogue: 0,0:05:16.11,0:05:20.19,Caption,,0,0,0,,ОТМЕНЁН ТОЛЬКО ПОТОМУ, ЧТО КОМУ ТО НРАВИТСЯ ПОДПИСЫВАТЬ РЕШЕНИЯ ОТ ИМЕНИ
Dialogue: 0,0:05:20.19,0:05:23.79,Caption,,0,0,0,,ЧЕЛОВЕЧЕСТВА. ЕВРОПЕ ТАКОЙ РАЗВОРОТ ОСОБЕННО НЕВЫГОДЕН.
Dialogue: 0,0:05:24.17,0:05:27.15,Caption,,0,0,0,,ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ЕЁ ВЛИЯНИЯ ДЕРЖИТСЯ НЕ НА ВОЕННОЙ
Dialogue: 0,0:05:27.15,0:05:31.95,Caption,,0,0,0,,МОЩИ, А НА ПРАВИЛАХ, СУДЕБНЫХ ПРОЦЕДУРАХ И ИНСТИТУТАХ. БРЮССЕЛЬ ПРИВЫК
Dialogue: 0,0:05:31.95,0:05:34.59,Caption,,0,0,0,,ПРЕВРАЩАТЬ НОРМАТИВНЫЙ ДОКУМЕНТ В ИНСТРУМЕНТ,
Dialogue: 0,0:05:34.82,0:05:37.15,Caption,,0,0,0,,КОТОРЫЙ ДОТЯГИВАЕТСЯ ЗА ПРЕДЕЛЫ ЕВРОСОЮЗА.
Dialogue: 0,0:05:37.71,0:05:41.87,Caption,,0,0,0,,ЕСЛИ МОСКВА, ПЕКИН И ВАШИНГТОН НАЧНУТ СОВМЕСТНО УКОРАЧИВАТЬ ЭТУ
Dialogue: 0,0:05:41.95,0:05:45.31,Caption,,0,0,0,,РУКУ, МНОГИЕ ПРИВЫЧНЫЕ РЫЧАГИ ПЕРЕСТАНУТ ДОСТАВАТЬ ДО
Dialogue: 0,0:05:45.31,0:05:48.35,Caption,,0,0,0,,ЦЕЛИ. ВПРОЧЕМ, ТЁПЛЫЕ СЛОВА ТЁПЛЫМИ СЛОВАМИ,
Dialogue: 0,0:05:48.67,0:05:51.39,Caption,,0,0,0,,А КЛЮЧ ОТ ЯДЕРНОГО АРСЕНАЛА НИКТО СОСЕДУ НЕ
Dialogue: 0,0:05:51.39,0:05:54.67,Caption,,0,0,0,,ОТДАСТ. КИТАЙ ПРЕДЛОЖИЛ ПОЛНЫЙ ЗАПРЕТ И ПОСЛЕДУЮЩЕЕ
Dialogue: 0,0:05:54.67,0:05:57.79,Caption,,0,0,0,,УНИЧТОЖЕНИЕ ЯДЕРНОГО ОРУЖИЯ. ЗАМЫСЕЛ ВЫГЛЯДИТ
Dialogue: 0,0:05:57.79,0:06:00.19,Caption,,0,0,0,,ГУМАННЫМ. ОСОБЕННО С ПОЗИЦИИ СТРАНЫ,
Dialogue: 0,0:06:00.35,0:06:03.15,Caption,,0,0,0,,ЧЕЙ АРСЕНАЛ УСТУПАЕТ ЗАПАСАМ ДВУХ СОБЕСЕДНИКОВ.
Dialogue: 0,0:06:03.70,0:06:06.43,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ПОЧТИ ТРОГАТЕЛЬНОЕ ДАВАЙТЕ ОДНОВРЕМЕННО
Dialogue: 0,0:06:06.43,0:06:10.03,Caption,,0,0,0,,УБЕРЁМ КОЗЫРЬ, ГДЕ ВЫ СИЛЬНЕЕ МЕНЯ. ПОСЛЕ ЭТОГО У МЕНЯ
Dialogue: 0,0:06:10.03,0:06:13.31,Caption,,0,0,0,,ОСТАНУТСЯ ПРОМЫШЛЕННАЯ БАЗА, МАССОВОЕ ПРОИЗВОДСТВО,
Dialogue: 0,0:06:13.41,0:06:16.91,Caption,,0,0,0,,ТЕХНОЛОГИИ, ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ И ОДНА ИЗ КРУПНЕЙШИХ
Dialogue: 0,0:06:16.91,0:06:19.87,Caption,,0,0,0,,ЭКОНОМИК МИРА. ТАК ДРУЗЬЯ ОБЫЧНО И ДЕЛЯТ ПИРОГ.
Dialogue: 0,0:06:20.16,0:06:22.91,Caption,,0,0,0,,СНАЧАЛА ПРЕДЛАГАЮТ ВЫБРОСИТЬ ЧУЖОЙ НОЖ. В
Dialogue: 0,0:06:22.91,0:06:25.55,Caption,,0,0,0,,ОКОНЧАТЕЛЬНОМ ТЕКСТЕ ПОЛНОГО УНИЧТОЖЕНИЯ НЕ
Dialogue: 0,0:06:25.55,0:06:30.96,Caption,,0,0,0,,ОКАЗАЛОСЬ. СТОРОНЫ ОГРАНИЧИЛИСЬ СНИЖЕНИЕМ УГРОЗ И
Dialogue: 0,0:06:30.96,0:06:33.44,Caption,,0,0,0,,НЕРАСПРОСТРАНЕНИЕМ. ПЕКИН ПРОВЕРИЛ ДВЕРЬ,
Dialogue: 0,0:06:33.68,0:06:36.64,Caption,,0,0,0,,НО ЗАМОК НЕ ПОДДАЛСЯ. ЭТО НАПОМИНАНИЕ О ЦЕНЕ
Dialogue: 0,0:06:36.64,0:06:39.60,Caption,,0,0,0,,НОВОЙ БЛИЗОСТИ. ТРИ ДЕРЖАВЫ СОТРУДНИЧАЮТ ТАМ,
Dialogue: 0,0:06:39.84,0:06:42.24,Caption,,0,0,0,,ГДЕ ИХ ИНТЕРЕСЫ СХОДЯТСЯ. КАК ТОЛЬКО ВЫГОДА
Dialogue: 0,0:06:42.24,0:06:44.80,Caption,,0,0,0,,РАСХОДИТСЯ, УЛЫБКИ ОСТАЮТСЯ ФОТОГРАФАМ,
Dialogue: 0,0:06:45.04,0:06:47.92,Caption,,0,0,0,,А РАСЧЁТЫ СНОВА ВЕДУТСЯ КАЖДЫМ В СВОЕЙ ТЕТРАДИ.
Dialogue: 0,0:06:48.36,0:06:51.28,Caption,,0,0,0,,НА ЭТОМ ФОНЕ ОСОБЕННО ЛЮБОПЫТЕН ЭПИЗОД С ПОЛЬШЕЙ.
Dialogue: 0,0:06:51.59,0:06:53.68,Caption,,0,0,0,,ИМЕННО РЕАКЦИЯ ВАШИНГТОНА ПОКАЗАЛА,
Dialogue: 0,0:06:53.85,0:06:56.72,Caption,,0,0,0,,КАК НОВАЯ РАССТАНОВКА СИЛ РАБОТАЕТ В КОНКРЕТНОЙ
Dialogue: 0,0:06:56.72,0:06:59.44,Caption,,0,0,0,,СИТУАЦИИ. В ПОЛЬСКОМ ВОЗДУШНОМ ПРОСТРАНСТВЕ
Dialogue: 0,0:06:59.52,0:07:02.56,Caption,,0,0,0,,ПОЯВИЛИСЬ РОССИЙСКИЕ РАКЕТЫ И БЕСПИЛОТНИК. ВАРШАВА
Dialogue: 0,0:07:02.56,0:07:05.04,Caption,,0,0,0,,ПОДНЯЛА ТРЕВОГУ. ДОНАЛЬД ТУСК ЗАЯВИЛ,
Dialogue: 0,0:07:05.35,0:07:07.52,Caption,,0,0,0,,ЧТО ПРОИСШЕСТВИЕ НЕЛЬЗЯ СЧИТАТЬ ПУСТЯКОМ,
Dialogue: 0,0:07:07.84,0:07:10.64,Caption,,0,0,0,,И ПОТРЕБОВАЛ СЕРЬЁЗНОГО ОТВЕТА. ТРАМП НЕ СТАЛ
Dialogue: 0,0:07:10.64,0:07:13.12,Caption,,0,0,0,,ИЗОБРАЖАТЬ БАРАБАННУЮ ДРОБЬ. РОССИЙСКИЕ?
Dialogue: 0,0:07:13.41,0:07:16.80,Caption,,0,0,0,,ДА. ОКАЗАЛИСЬ НАД ПОЛЬШЕЙ? ДА. ВЕРОЯТНО,
Dialogue: 0,0:07:16.96,0:07:19.52,Caption,,0,0,0,,ПО ОШИБКЕ. И ЧТО ТЕПЕРЬ ПРЕДЛАГАЕТСЯ СДЕЛАТЬ?
Dialogue: 0,0:07:19.67,0:07:22.32,Caption,,0,0,0,,ВОТ И ВСЯ ГРОЗА. ТУСК ОТВЕТИЛ СЛОВАМИ О
Dialogue: 0,0:07:22.32,0:07:25.52,Caption,,0,0,0,,ТОМ, ЧТОБЫ БОГ УБЕРЁГ ПОЛЬШУ ОТ ПОДОБНЫХ ДРУЗЕЙ.
Dialogue: 0,0:07:26.08,0:07:29.12,Caption,,0,0,0,,НО ВАРШАВА МНОГО ЛЕТ ДОБИВАЛАСЬ ИМЕННО ТАКОГО ДРУГА
Dialogue: 0,0:07:29.12,0:07:33.28,Caption,,0,0,0,,ОГРОМНОГО, ВООРУЖЁННОГО И ГОТОВОГО ПРИ ПЕРВОЙ ОПАСНОСТИ УДАРИТЬ
Dialogue: 0,0:07:33.36,0:07:38.08,Caption,,0,0,0,,ЛАДОНЬЮ ПО СТОЛУ ТАК, ЧТОБЫ ДРОГНУЛИ СТАКАНЫ В МОСКВЕ. ОПАСНОСТЬ ПРИШЛА.
Dialogue: 0,0:07:38.38,0:07:41.28,Caption,,0,0,0,,СТАКАНЫ НЕ ДРОГНУЛИ. АМЕРИКАНСКИЙ ПРЕЗИДЕНТ ТОЛЬКО
Dialogue: 0,0:07:41.36,0:07:43.44,Caption,,0,0,0,,ЧТО ГОВОРИЛ С ПУТИНЫМ И СИ ЦЗИНЬПИНОМ.
Dialogue: 0,0:07:45.65,0:07:48.05,Caption,,0,0,0,,НАЧИНАТЬ ОБОСТРЕНИЕ РАДИ ДУШЕВНОГО КОМФОРТА
Dialogue: 0,0:07:48.05,0:07:51.01,Caption,,0,0,0,,ПОЛЬСКОГО ПРЕМЬЕРА ОН НЕ СОБИРАЛСЯ. У ВАШИНГТОНА
Dialogue: 0,0:07:51.09,0:07:53.97,Caption,,0,0,0,,БЫЛИ ВОПРОСЫ ПОКРУПНЕЕ, А ВАРШАВА ОБНАРУЖИЛА,
Dialogue: 0,0:07:54.13,0:07:56.77,Caption,,0,0,0,,ЧТО ЕЁ ТРЕВОГА БОЛЬШЕ НЕ ВКЛЮЧАЕТ АМЕРИКАНСКУЮ
Dialogue: 0,0:07:56.85,0:08:00.29,Caption,,0,0,0,,СИРЕНУ АВТОМАТИЧЕСКИ. ЭТО ЕЩЁ ОДИН СИМПТОМ ОКОНЧАНИЯ
Dialogue: 0,0:08:00.29,0:08:03.81,Caption,,0,0,0,,ПРЕЖНЕЙ ЭПОХИ. ОСЛАБЛА НЕ АМЕРИКА. ИСЧЕЗЛА
Dialogue: 0,0:08:03.81,0:08:06.53,Caption,,0,0,0,,ОБЯЗАННОСТЬ СОЕДИНЁННЫХ ШТАТОВ ПРИНИМАТЬ ЕВРОПЕЙСКУЮ
Dialogue: 0,0:08:06.53,0:08:09.41,Caption,,0,0,0,,ВЕРСИЮ ЛЮБОГО ПРОИСШЕСТВИЯ И ПРЕВРАЩАТЬ ЕЁ В
Dialogue: 0,0:08:09.41,0:08:12.45,Caption,,0,0,0,,СОБСТВЕННУЮ ЛИНИЮ ПОВЕДЕНИЯ. ПОЛЬСКАЯ СТОРОНА
Dialogue: 0,0:08:12.53,0:08:15.65,Caption,,0,0,0,,ТРЕБУЕТ ОТВЕТА. БЕЛЫЙ ДОМ ПРЕДЛАГАЕТ НЕ РАЗГОНЯТЬ
Dialogue: 0,0:08:15.65,0:08:19.65,Caption,,0,0,0,,СИТУАЦИЮ. ВАРШАВА ВОЗРАЖАЕТ. ВАШИНГТОН ПОЖИМАЕТ
Dialogue: 0,0:08:19.65,0:08:22.85,Caption,,0,0,0,,ПЛЕЧАМИ. ОТДЕЛЬНОГО МЕСТА В ЭТОЙ КОМЕДИИ ЗАСЛУЖИВАЮТ
Dialogue: 0,0:08:22.85,0:08:25.97,Caption,,0,0,0,,ПОЛЬСКИЕ КОМПЛЕКСЫ ПЭТРИОТ. КОГДА КИЕВУ ТРЕБОВАЛИСЬ
Dialogue: 0,0:08:26.05,0:08:28.45,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ РАКЕТЫ, ВАРШАВА ОБЪЯСНЯЛА,
Dialogue: 0,0:08:28.77,0:08:31.73,Caption,,0,0,0,,ЧТО ДЕЛИТЬСЯ НЕЛЬЗЯ БОЕПРИПАСЫ НУЖНЫ САМОЙ ПОЛЬШЕ.
Dialogue: 0,0:08:32.01,0:08:34.61,Caption,,0,0,0,,АРГУМЕНТ ПОНЯТНЫЙ. ПО СОСЕДСТВУ ИДУТ БОЕВЫЕ
Dialogue: 0,0:08:34.61,0:08:38.45,Caption,,0,0,0,,ДЕЙСТВИЯ, И ЗАПАС ПРИГОДИТСЯ ПРИ УГРОЗЕ. УГРОЗА ПОЯВИЛАСЬ.
Dialogue: 0,0:08:38.73,0:08:41.81,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ПЭТРИОТЫ СРОЧНО ПЕРЕВЕЛИ В ПОЛНУЮ БОЕВУЮ
Dialogue: 0,0:08:41.81,0:08:44.69,Caption,,0,0,0,,ГОТОВНОСТЬ. ЕСЛИ РАКЕТЫ БЕРЕГЛИ ДЛЯ ПОДОБНОГО
Dialogue: 0,0:08:44.69,0:08:47.01,Caption,,0,0,0,,СЛУЧАЯ, ЧЕГО ЖДАЛИ САМИ КОМПЛЕКСЫ?
Dialogue: 0,0:08:47.38,0:08:51.97,Caption,,0,0,0,,СИСТЕМА СТОИТ ОГРОМНЫХ ДЕНЕГ, ПРЕДНАЗНАЧЕНА ДЛЯ ПЕРЕХВАТА ВОЗДУШНЫХ ЦЕЛЕЙ И
Dialogue: 0,0:08:51.97,0:08:55.49,Caption,,0,0,0,,СЧИТАЕТСЯ ОПОРОЙ ОБОРОНЫ. ОДНАКО ВЫСШУЮ ГОТОВНОСТЬ
Dialogue: 0,0:08:55.49,0:08:59.73,Caption,,0,0,0,,ОБЪЯВЛЯЮТ ПОСЛЕ ТОГО, КАК ДВЕ РАКЕТЫ И БЕСПИЛОТНИК УЖЕ ПОБЫВАЛИ НА
Dialogue: 0,0:08:59.73,0:09:04.73,Caption,,0,0,0,,ПОЛЬСКОЙ ТЕРРИТОРИИ. ЭТО КАК НАДЕВАТЬ СПАСАТЕЛЬНЫЙ ЖИЛЕТ,
Dialogue: 0,0:09:04.88,0:09:10.09,Caption,,0,0,0,,ВЫБРАВШИСЬ ИЗ ВОДЫ. АВИАЦИЯ ТОЖЕ НЕ СКУЧАЛА. ШВЕДСКИЙ ГРИПЕН СОПРОВОЖДАЛ
Dialogue: 0,0:09:10.09,0:09:12.97,Caption,,0,0,0,,Х СТО ОДИН. ЛЁТЧИК ВИДЕЛ ЦЕЛЬ НА ПРИБОРАХ
Dialogue: 0,0:09:13.05,0:09:14.81,Caption,,0,0,0,,И ИМЕЛ РАЗРЕШЕНИЕ ПРИМЕНИТЬ ОРУЖИЕ.
Dialogue: 0,0:09:15.37,0:09:18.17,Caption,,0,0,0,,ПЛОХАЯ ПОГОДА ПОМЕШАЛА ПОДТВЕРДИТЬ ЕЁ ВИЗУАЛЬНО И
Dialogue: 0,0:09:18.17,0:09:21.29,Caption,,0,0,0,,ОПТИЧЕСКИМИ СРЕДСТВАМИ, ПОЭТОМУ ВЫСТРЕЛА НЕ ПОСЛЕДОВАЛО.
Dialogue: 0,0:09:22.01,0:09:24.41,Caption,,0,0,0,,ПОЛЬСКИЕ ЭФ ШЕСТНАДЦАТЬ НАХОДИЛИСЬ В ВОЗДУХЕ,
Dialogue: 0,0:09:24.65,0:09:27.61,Caption,,0,0,0,,НО ТАКЖЕ НЕ ОТКРЫЛИ ОГОНЬ. РАБОТАЛ САМОЛЁТ ДАЛЬНЕГО
Dialogue: 0,0:09:27.61,0:09:30.33,Caption,,0,0,0,,РАДИОЛОКАЦИОННОГО ОБНАРУЖЕНИЯ. В НЕБЕ НАХОДИЛСЯ
Dialogue: 0,0:09:30.33,0:09:33.61,Caption,,0,0,0,,ЗАПРАВЩИК. ДЕЖУРИЛИ ИСТРЕБИТЕЛИ. НА ЗЕМЛЕ ИМЕЛИСЬ
Dialogue: 0,0:09:33.61,0:09:35.85,Caption,,0,0,0,,ПЭТРИОТЫ. РАКЕТА ВСЁ РАВНО ДОЛЕТЕЛА.
Dialogue: 0,0:09:36.41,0:09:39.13,Caption,,0,0,0,,ВОЕННАЯ РЕКЛАМА ТАКИЕ СЮЖЕТЫ НЕ ЛЮБИТ. НАРИСОВАННЫЙ
Dialogue: 0,0:09:39.13,0:09:41.53,Caption,,0,0,0,,КУПОЛ ПРЕВРАЩАЕТСЯ В НАБОР ЛЮДЕЙ И МАШИН,
Dialogue: 0,0:09:41.77,0:09:44.57,Caption,,0,0,0,,ГДЕ КАЖДЫЙ ЖДЁТ ПОДТВЕРЖДЕНИЯ. А РАКЕТА ЖДАТЬ НЕ
Dialogue: 0,0:09:44.57,0:09:47.13,Caption,,0,0,0,,ОБЯЗАНА. ЕСЛИ ВАМ НУЖНЫ ТАКИЕ РАЗБОРЫ ВМЕСТО
Dialogue: 0,0:09:47.13,0:09:51.13,Caption,,0,0,0,,ПЕРЕСКАЗА ЗАГОЛОВКОВ, ПОДПИШИТЕСЬ НА КАНАЛ. И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:09:51.22,0:09:54.01,Caption,,0,0,0,,ЧТО ОКАЗАЛОСЬ ВАЖНЕЕ САМ ПРОЛЁТ РАКЕТ ИЛИ
Dialogue: 0,0:09:54.01,0:09:57.53,Caption,,0,0,0,,СПОКОЙСТВИЕ, С КОТОРЫМ ВАШИНГТОН ОТОДВИНУЛ ПОЛЬСКУЮ ТРЕВОГУ В
Dialogue: 0,0:09:57.53,0:10:00.89,Caption,,0,0,0,,СТОРОНУ? ЕСТЬ У ПРОИСШЕСТВИЯ ЕЩЁ ОДИН НЕПРИЯТНЫЙ СЛОЙ.
Dialogue: 0,0:10:01.53,0:10:04.17,Caption,,0,0,0,,РАКЕТЫ ПОЯВИЛИСЬ РЯДОМ С УЧЕНИЯМИ В НОВОЙ ДЕМБЕ.
Dialogue: 0,0:10:04.65,0:10:07.53,Caption,,0,0,0,,ТАМ НЕСКОЛЬКО ТЫСЯЧ ВОЕННЫХ ИЗ ОДИННАДЦАТИ СТРАН
Dialogue: 0,0:10:07.77,0:10:09.93,Caption,,0,0,0,,ОТРАБАТЫВАЛИ ПЕРЕБРОСКУ ПОДРАЗДЕЛЕНИЙ,
Dialogue: 0,0:10:10.01,0:10:13.37,Caption,,0,0,0,,СНАБЖЕНИЕ, РУКОВОДСТВО КОНТИНГЕНТОМ И ПРОТИВОДЕЙСТВИЕ
Dialogue: 0,0:10:13.37,0:10:17.10,Caption,,0,0,0,,БЕСПИЛОТНИКАМ. ПО СУЩЕСТВУ,
Dialogue: 0,0:10:17.42,0:10:19.74,Caption,,0,0,0,,ОНИ ГОТОВИЛИСЬ К БУДУЩЕЙ ЕВРОПЕЙСКОЙ МИССИИ НА
Dialogue: 0,0:10:19.82,0:10:23.10,Caption,,0,0,0,,УКРАИНЕ ПОСЛЕ ПРЕКРАЩЕНИЯ БОЕВЫХ ДЕЙСТВИЙ. РЕПЕТИЦИЯ
Dialogue: 0,0:10:23.17,0:10:26.62,Caption,,0,0,0,,ШЛА ПО ПЛАНУ. ПОТОМ В ДЕКОРАЦИЮ ПРИЛЕТЕЛА НАСТОЯЩАЯ
Dialogue: 0,0:10:26.62,0:10:29.98,Caption,,0,0,0,,РАКЕТА. ОБСУЖДАЮТСЯ ДВЕ ВЕРСИИ. СОГЛАСНО ПЕРВОЙ,
Dialogue: 0,0:10:30.21,0:10:33.42,Caption,,0,0,0,,МОСКВА ПРОВЕРЯЛА ПОЛЬСКУЮ СИСТЕМУ ПВО И СКОРОСТЬ
Dialogue: 0,0:10:33.42,0:10:36.29,Caption,,0,0,0,,РЕАКЦИИ НАТО. ТАКОЕ ОБЪЯСНЕНИЕ НАЧАЛИ ПРОДВИГАТЬ
Dialogue: 0,0:10:36.29,0:10:38.78,Caption,,0,0,0,,ЗАПАДНЫЕ СПЕЦИАЛИСТЫ. ПО ВТОРОЙ ВЕРСИИ,
Dialogue: 0,0:10:39.02,0:10:41.82,Caption,,0,0,0,,ТРАЕКТОРИЯ ОДНОЙ РАКЕТЫ ИЗМЕНИЛАСЬ ПОСЛЕ ДЕЙСТВИЙ
Dialogue: 0,0:10:41.82,0:10:44.14,Caption,,0,0,0,,УКРАИНСКОЙ ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ. ТОГДА
Dialogue: 0,0:10:44.14,0:10:47.02,Caption,,0,0,0,,НАМЕРЕННОГО УДАРА ПО ПОЛЬШЕ НЕ БЫЛО. ДЛЯ ЕВРОПЕЙСКИХ
Dialogue: 0,0:10:47.02,0:10:50.54,Caption,,0,0,0,,СТОЛИЦ ВЫБОР РОСКОШНЫЙ ПЛОХОЙ ВАРИАНТ ИЛИ ВТОРОЙ
Dialogue: 0,0:10:50.54,0:10:53.42,Caption,,0,0,0,,ПЛОХОЙ ВАРИАНТ. ЕСЛИ ВЕРНА ПЕРВАЯ ВЕРСИЯ,
Dialogue: 0,0:10:53.65,0:10:56.78,Caption,,0,0,0,,БУДУЩУЮ МИССИЮ ЗАРАНЕЕ ПРОЩУПЫВАЮТ И ВЫЯСНЯЮТ,
Dialogue: 0,0:10:56.94,0:10:59.18,Caption,,0,0,0,,НАСКОЛЬКО БЫСТРО ОНА УВИДИТ УГРОЗУ,
Dialogue: 0,0:10:59.27,0:11:03.18,Caption,,0,0,0,,РАСПОЗНАЕТ ЕЁ И РЕШИТСЯ СТРЕЛЯТЬ. ЕСЛИ ВЕРНА ВТОРАЯ,
Dialogue: 0,0:11:03.37,0:11:05.98,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ВОЕННЫЕ СОБИРАЮТСЯ ВОЙТИ ТУДА,
Dialogue: 0,0:11:06.29,0:11:09.26,Caption,,0,0,0,,ГДЕ РАБОТА СОСЕДНЕЙ ПВО СПОСОБНА ОТПРАВИТЬ БОЕВУЮ
Dialogue: 0,0:11:09.34,0:11:12.62,Caption,,0,0,0,,ЧАСТЬ ВЕСОМ ОКОЛО ВОСЬМИСОТ КИЛОГРАММОВ ЧЕРЕЗ ЧУЖУЮ
Dialogue: 0,0:11:12.62,0:11:15.50,Caption,,0,0,0,,ГРАНИЦУ. ПОСЛЕ ТАКОЙ ТРЕНИРОВКИ ОСТАЁТСЯ
Dialogue: 0,0:11:15.50,0:11:18.54,Caption,,0,0,0,,ПОБЛАГОДАРИТЬ ОРГАНИЗАТОРОВ ЗА РЕАЛИЗМ. ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:11:18.77,0:11:21.74,Caption,,0,0,0,,ГЛАВНАЯ ДИСТАНЦИЯ УВЕЛИЧИВАЕТСЯ УЖЕ НЕ МЕЖДУ РАКЕТОЙ
Dialogue: 0,0:11:21.82,0:11:25.74,Caption,,0,0,0,,И ПЕРЕХВАТЧИКОМ, А МЕЖДУ ВАШИНГТОНОМ И ЕВРОПОЙ. ПОСЛЕ ВСТРЕЧИ С
Dialogue: 0,0:11:25.82,0:11:28.70,Caption,,0,0,0,,ПУТИНЫМ И СИ ЦЗИНЬПИНОМ ТРАМП ПРЯМО С САМОЛЁТА
Dialogue: 0,0:11:28.70,0:11:31.34,Caption,,0,0,0,,ПОДКЛЮЧИЛСЯ К СОВЕЩАНИЮ ЕВРОПЕЙСКИХ РУКОВОДИТЕЛЕЙ В
Dialogue: 0,0:11:31.34,0:11:37.05,Caption,,0,0,0,,БЕРЛИНЕ. ОН ПОЗВОНИЛ ДЖАРЕДУ КУШНЕРУ. ТОТ ВКЛЮЧИЛ ГРОМКУЮ
Dialogue: 0,0:11:37.13,0:11:39.61,Caption,,0,0,0,,СВЯЗЬ. В КОМНАТЕ ОБСУЖДАЛИ ВЫДЕЛЕНИЕ УКРАИНЕ
Dialogue: 0,0:11:39.61,0:11:42.89,Caption,,0,0,0,,ОЧЕРЕДНЫХ СЕМИДЕСЯТИ МИЛЛИАРДОВ ЕВРО. ТРАМП ВЫСЛУШАЛ
Dialogue: 0,0:11:42.89,0:11:45.29,Caption,,0,0,0,,УЧАСТНИКОВ И СПРОСИЛ, ЧТО БУДЕТ ПОТОМ.
Dialogue: 0,0:11:45.84,0:11:49.37,Caption,,0,0,0,,ПРЕЗИДЕНТ США ЗАЯВИЛ, ЧТО ПУТИН НАСТРОЕН НА СОГЛАШЕНИЕ,
Dialogue: 0,0:11:49.61,0:11:52.25,Caption,,0,0,0,,И ПРЕДЛОЖИЛ СОСРЕДОТОЧИТЬСЯ НА ЗАВЕРШЕНИИ КОНФЛИКТА.
Dialogue: 0,0:11:52.98,0:11:55.77,Caption,,0,0,0,,ИДЕЯ ПРИНЕСТИ КИЕВУ ЕЩЁ ОДНУ ПАЧКУ ДЕНЕГ ЕГО
Dialogue: 0,0:11:55.85,0:11:58.81,Caption,,0,0,0,,НЕ ВООДУШЕВИЛА. ОДНИ УЧАСТНИКИ ПОЗДНЕЕ ОПИСЫВАЛИ
Dialogue: 0,0:11:58.81,0:12:01.61,Caption,,0,0,0,,ТРАМПА КАК РЕЗКОГО И РАЗДРАЖЁННОГО. ДРУГИЕ
Dialogue: 0,0:12:01.61,0:12:04.09,Caption,,0,0,0,,УТВЕРЖДАЛИ, ЧТО БЕСЕДА ПРОХОДИЛА СПОКОЙНЕЕ.
Dialogue: 0,0:12:04.86,0:12:06.89,Caption,,0,0,0,,ИНТОНАЦИЮ МОЖНО ВСПОМИНАТЬ ПО РАЗНОМУ,
Dialogue: 0,0:12:07.06,0:12:10.41,Caption,,0,0,0,,НО ВОПРОС ОСТАЁТСЯ. ЕВРОПА ПРЕДЛАГАЕТ НОВЫЙ ПЛАТЁЖ.
Dialogue: 0,0:12:10.65,0:12:13.21,Caption,,0,0,0,,ТРАМП СПРАШИВАЕТ О ПЕРЕГОВОРАХ. ДОПУСТИМ,
Dialogue: 0,0:12:13.37,0:12:16.09,Caption,,0,0,0,,СЕМЬДЕСЯТ МИЛЛИАРДОВ БУДУТ ВЫДЕЛЕНЫ. ЗАТЕМ
Dialogue: 0,0:12:16.17,0:12:19.53,Caption,,0,0,0,,ПОНАДОБИТСЯ СЛЕДУЮЩАЯ СУММА. ЗА НЕЙ ЕЩЁ ОДНА. ГДЕ
Dialogue: 0,0:12:19.53,0:12:22.49,Caption,,0,0,0,,КОНЕЧНАЯ ОСТАНОВКА? В МОСКВЕ? ЗА УРАЛОМ?
Dialogue: 0,0:12:22.69,0:12:24.97,Caption,,0,0,0,,В КАКОЙ МОМЕНТ ЕВРОПЕЙСКИЕ ЛИДЕРЫ ОБЪЯСНЯТ
Dialogue: 0,0:12:24.97,0:12:27.21,Caption,,0,0,0,,ИЗБИРАТЕЛЯМ, ЧТО ЦЕЛЬ ДОСТИГНУТА,
Dialogue: 0,0:12:27.37,0:12:30.17,Caption,,0,0,0,,ПОБЕДА ОФОРМЛЕНА, А НОВЫЕ СЧЕТА БОЛЬШЕ НЕ ПРИДУТ?
Dialogue: 0,0:12:30.53,0:12:33.13,Caption,,0,0,0,,ДВИГАТЬСЯ ДАЛЬШЕ МОЖНО ДОЛГО. ОСОБЕННО КОГДА
Dialogue: 0,0:12:33.13,0:12:36.09,Caption,,0,0,0,,НАПРАВЛЕНИЕ ВЫБИРАЕТ ОДИН, ДЕНЬГИ СОБИРАЕТ ВТОРОЙ,
Dialogue: 0,0:12:36.33,0:12:39.45,Caption,,0,0,0,,ОРУЖИЕ ПРОДАЁТ ТРЕТИЙ, А ПОСЛЕДСТВИЯ ДОСТАЮТСЯ ВСЕМ.
Dialogue: 0,0:12:40.04,0:12:42.81,Caption,,0,0,0,,КУШНЕР ДОБАВИЛ ЕЩЁ ОДНУ ДЕТАЛЬ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:12:43.05,0:12:45.13,Caption,,0,0,0,,ТРАМП С УДОВОЛЬСТВИЕМ ПРЕКРАТИЛ БЫ ПОСТАВКИ
Dialogue: 0,0:12:45.13,0:12:49.29,Caption,,0,0,0,,АМЕРИКАНСКОГО ОРУЖИЯ УКРАИНЕ, ЕСЛИ БЫ ЭТО ПОМОГЛО ОСТАНОВИТЬ КОНФЛИКТ.
Dialogue: 0,0:12:51.57,0:12:54.21,Caption,,0,0,0,,ПОТЕРЯ ДОХОДОВ ОБОРОННЫХ КОМПАНИЙ ЯКОБЫ НЕ СТАНЕТ
Dialogue: 0,0:12:54.29,0:12:57.41,Caption,,0,0,0,,БЕДСТВИЕМ ДЛЯ ЭКОНОМИКИ США. СРЕДСТВА НАЙДУТ ДРУГОЕ
Dialogue: 0,0:12:57.41,0:12:59.41,Caption,,0,0,0,,ПРИМЕНЕНИЕ. ЗВУЧИТ РЕШИТЕЛЬНО.
Dialogue: 0,0:12:59.96,0:13:01.81,Caption,,0,0,0,,ТОГДА ПОЧЕМУ ПРОДАЖИ ПРОДОЛЖАЮТСЯ?
Dialogue: 0,0:13:02.42,0:13:05.25,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ МИРНЫЕ НАМЕРЕНИЯ ВСТРЕЧАЮТСЯ С КАССОЙ.
Dialogue: 0,0:13:05.65,0:13:07.81,Caption,,0,0,0,,ВАШИНГТОН ХОЧЕТ ЗАВЕРШЕНИЯ КОНФЛИКТА,
Dialogue: 0,0:13:08.05,0:13:10.69,Caption,,0,0,0,,НО АМЕРИКАНСКОЕ ОРУЖИЕ ВСЁ ЕЩЁ УХОДИТ ПОКУПАТЕЛЮ.
Dialogue: 0,0:13:10.94,0:13:13.81,Caption,,0,0,0,,ЕВРОПА ОПЛАЧИВАЕТ ЗАКАЗЫ. ОДНОВРЕМЕННО ТРАМП
Dialogue: 0,0:13:13.81,0:13:17.41,Caption,,0,0,0,,УДИВЛЯЕТСЯ, ЗАЧЕМ ЕВРОПЕЙЦЫ ГОТОВЯТ КИЕВУ ОЧЕРЕДНЫЕ ДЕСЯТКИ
Dialogue: 0,0:13:17.41,0:13:20.77,Caption,,0,0,0,,МИЛЛИАРДОВ. КАЖДАЯ ФРАЗА ПО ОТДЕЛЬНОСТИ УБЕДИТЕЛЬНА.
Dialogue: 0,0:13:21.12,0:13:22.85,Caption,,0,0,0,,ВМЕСТЕ ОНИ НАПОМИНАЮТ МАГАЗИН,
Dialogue: 0,0:13:23.09,0:13:25.81,Caption,,0,0,0,,ВЛАДЕЛЕЦ КОТОРОГО ПРИЗЫВАЕТ ПОКУПАТЕЛЕЙ ЭКОНОМИТЬ,
Dialogue: 0,0:13:26.05,0:13:30.77,Caption,,0,0,0,,НЕ ОТХОДЯ ОТ ТЕРМИНАЛА. ПОЭТОМУ ПРОИСХОДЯЩЕЕ ДАВНО ШИРЕ УКРАИНСКОГО ВОПРОСА.
Dialogue: 0,0:13:31.20,0:13:33.97,Caption,,0,0,0,,УКРАИНА ВСЁ ЗАМЕТНЕЕ СТАНОВИТСЯ НЕ ЦЕНТРОМ МИРОВОГО
Dialogue: 0,0:13:33.97,0:13:37.89,Caption,,0,0,0,,УСТРОЙСТВА, А ОДНИМ ИЗ ПУНКТОВ КРУПНОЙ СДЕЛКИ. МОСКВА,
Dialogue: 0,0:13:38.10,0:13:41.33,Caption,,0,0,0,,ПЕКИН И ВАШИНГТОН ГОВОРЯТ О ПЕРЕУСТРОЙСТВЕ ООН.
Dialogue: 0,0:13:41.64,0:13:44.93,Caption,,0,0,0,,ОБСУЖДАЮТ ЭНЕРГЕТИЧЕСКИЕ ПОТОКИ. ОПРЕДЕЛЯЮТ ПРЕДЕЛЫ
Dialogue: 0,0:13:44.93,0:13:47.73,Caption,,0,0,0,,МЕЖДУНАРОДНЫХ СУДОВ. ВОЗВРАЩАЮТ ГОСУДАРСТВЕННЫЙ
Dialogue: 0,0:13:47.73,0:13:50.77,Caption,,0,0,0,,СУВЕРЕНИТЕТ В ЦЕНТР СИСТЕМЫ. ТОРГУЮТСЯ О ЯДЕРНЫХ
Dialogue: 0,0:13:50.77,0:13:53.81,Caption,,0,0,0,,РИСКАХ. ЕВРОПЕЙСКИЕ СТОЛИЦЫ В ЭТО ВРЕМЯ ВЫЯСНЯЮТ,
Dialogue: 0,0:13:54.06,0:13:57.33,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ ДЕНЕГ ОТПРАВИТЬ КИЕВУ И НАСКОЛЬКО ГРОМКО
Dialogue: 0,0:13:57.33,0:13:59.73,Caption,,0,0,0,,АМЕРИКАНСКИЙ ПРЕЗИДЕНТ ОБЯЗАН ВОЗМУЩАТЬСЯ
Dialogue: 0,0:13:59.73,0:14:04.61,Caption,,0,0,0,,ПРОИСШЕСТВИЕМ В ПОЛЬШЕ. УРОВНИ РАЗГОВОРА РАЗНЫЕ. ПРЕДМЕТ БУДУЩЕЙ СДЕЛКИ
Dialogue: 0,0:14:04.61,0:14:11.14,Caption,,0,0,0,,ГОРАЗДО БОЛЬШЕ ОДНОЙ СТРАНЫ. ЕСЛИ ТРИ ДЕРЖАВЫ ПЕРЕЙДУТ К КРУПНЫМ СОГЛАШЕНИЯМ,
Dialogue: 0,0:14:11.37,0:14:14.02,Caption,,0,0,0,,ДЕЛИТЬ ОНИ БУДУТ НЕ УКРАИНСКУЮ ТЕРРИТОРИЮ. ОНИ
Dialogue: 0,0:14:14.10,0:14:17.94,Caption,,0,0,0,,СТАНУТ СОГЛАСОВЫВАТЬ РАМКИ, ВНУТРИ КОТОРЫХ ПРИДЁТСЯ ЖИТЬ ОСТАЛЬНЫМ.
Dialogue: 0,0:14:18.53,0:14:20.18,Caption,,0,0,0,,НА СТОЛЕ ЛЕЖИТ НЕ КУСОК ПИРОГА,
Dialogue: 0,0:14:20.40,0:14:23.94,Caption,,0,0,0,,А МЕНЮ ЦЕЛИКОМ. ЕВРОПА ПОКА ОСТАЁТСЯ РЯДОМ. ЭТО
Dialogue: 0,0:14:23.94,0:14:28.58,Caption,,0,0,0,,ОГРОМНЫЙ РЫНОК, ВАЖНЫЙ СОЮЗНИК США И КРУПНЫЙ ЭКОНОМИЧЕСКИЙ ЦЕНТР.
Dialogue: 0,0:14:28.81,0:14:32.34,Caption,,0,0,0,,СПИСЫВАТЬ ЕЁ НЕЛЕПО. НО ВЛИЯНИЕ НЕ ВЫДАЁТСЯ НАВЕЧНО
Dialogue: 0,0:14:32.42,0:14:35.06,Caption,,0,0,0,,ВМЕСТЕ С КРАСИВЫМ ЗДАНИЕМ И МЕСТОМ НА ФОТОГРАФИИ.
Dialogue: 0,0:14:35.38,0:14:39.54,Caption,,0,0,0,,ОНО СУЩЕСТВУЕТ, ПОКА ДРУГИЕ СИЛЬНЫЕ ИГРОКИ СЧИТАЮТ УЧАСТИЕ ЕВРОПЫ
Dialogue: 0,0:14:39.54,0:14:43.62,Caption,,0,0,0,,НЕОБХОДИМЫМ. ЕСЛИ ЕВРОПЕЙСКИЕ СТОЛИЦЫ ПРОДОЛЖАТ ДЕЙСТВОВАТЬ ТАК,
Dialogue: 0,0:14:43.86,0:14:46.02,Caption,,0,0,0,,БУДТО ПРЕЖНИЙ РАСПОРЯДОК НИКУДА НЕ ДЕЛСЯ,
Dialogue: 0,0:14:46.41,0:14:49.46,Caption,,0,0,0,,ОДНАЖДЫ ИХ ПРОСТО УВЕДОМЯТ О РЕЗУЛЬТАТЕ. НЕ ВЫГОНЯТ
Dialogue: 0,0:14:49.46,0:14:51.78,Caption,,0,0,0,,И НЕ СОТРУТ С КАРТЫ. ОСТАВЯТ В КОРИДОРЕ
Dialogue: 0,0:14:51.78,0:14:54.90,Caption,,0,0,0,,ЖДАТЬ, ПОКА В КАБИНЕТЕ ЗАКОНЧАТ РАЗГОВОР. В ЭТОМ И
Dialogue: 0,0:14:54.90,0:14:58.42,Caption,,0,0,0,,СОСТОИТ ГЛАВНЫЙ ИТОГ. СОЕДИНЁННЫЕ ШТАТЫ НЕ РУХНУЛИ И
Dialogue: 0,0:14:58.50,0:15:01.30,Caption,,0,0,0,,НЕ УТРАТИЛИ МОЩЬ. ОНИ ПЕРЕСТАЛИ БЫТЬ ЕДИНСТВЕННЫМ
Dialogue: 0,0:15:01.30,0:15:04.10,Caption,,0,0,0,,УЧАСТНИКОМ, КОТОРЫЙ НАЗНАЧАЕТ ВРЕМЯ ВСТРЕЧИ,
Dialogue: 0,0:15:04.25,0:15:09.38,Caption,,0,0,0,,УТВЕРЖДАЕТ ПОВЕСТКУ И РЕШАЕТ, КОМУ ПОЗВОЛЕНО ГОВОРИТЬ. ТЕПЕРЬ ГЛАВНЫХ СОБЕСЕДНИКОВ
Dialogue: 0,0:15:09.46,0:15:13.06,Caption,,0,0,0,,ТРОЕ. ДОВЕРИЯ МЕЖДУ НИМИ ПОЧТИ НЕТ. КАЖДЫЙ БУДЕТ
Dialogue: 0,0:15:13.06,0:15:17.46,Caption,,0,0,0,,ТОРГОВАТЬСЯ, ДАВИТЬ И ИСКАТЬ СЛАБОЕ МЕСТО ОСТАЛЬНЫХ. ПЕКИН УЖЕ
Dialogue: 0,0:15:17.46,0:15:21.14,Caption,,0,0,0,,ПРЕДЛОЖИЛ УБРАТЬ ОРУЖИЕ, В КОТОРОМ УСТУПАЕТ РОССИИ И США.
Dialogue: 0,0:15:21.69,0:15:24.02,Caption,,0,0,0,,ВАШИНГТОН ПОСТАРАЕТСЯ СОХРАНИТЬ МАКСИМУМ
Dialogue: 0,0:15:24.02,0:15:30.46,Caption,,0,0,0,,ПРЕИМУЩЕСТВ. МОСКВА БУДЕТ ПРОДВИГАТЬ СОБСТВЕННЫЕ УСЛОВИЯ. НО САМО
Dialogue: 0,0:15:30.46,0:15:33.90,Caption,,0,0,0,,ПОЯВЛЕНИЕ ТАКОГО ФОРМАТА МЕНЯЕТ ПРИВЫЧНУЮ ИЕРАРХИЮ.
Dialogue: 0,0:15:34.46,0:15:36.86,Caption,,0,0,0,,РАКЕТЫ НАД ПОЛЬШЕЙ СТАЛИ НЕБОЛЬШИМ ИНДИКАТОРОМ
Dialogue: 0,0:15:36.86,0:15:39.66,Caption,,0,0,0,,ПЕРЕМЕНЫ. ВАРШАВА ОБРАТИЛАСЬ К ТОЙ АМЕРИКЕ,
Dialogue: 0,0:15:39.98,0:15:42.62,Caption,,0,0,0,,КОТОРАЯ ПРЕЖДЕ ДОЛЖНА БЫЛА БЕЗ ПАУЗЫ ПОДДЕРЖАТЬ
Dialogue: 0,0:15:42.62,0:15:45.58,Caption,,0,0,0,,СОЮЗНИКА И ПОВЫСИТЬ СТАВКИ. ОТВЕТ ПРИШЁЛ УЖЕ ОТ
Dialogue: 0,0:15:45.58,0:15:47.66,Caption,,0,0,0,,ДРУГОЙ АМЕРИКИ. ОНА ВЫСЛУШАЛА,
